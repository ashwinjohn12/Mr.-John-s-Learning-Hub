---
import '../styles/global.css';
import JabberwockyDeviceTools from '../components/JabberwockyDeviceTools.astro';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
}

const {
  title = "Mr. John’s Learning Hub",
  description = 'Interactive mathematics and science learning for middle school students.',
  themeColor = '#174ea6'
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Mr. John’s Learning Hub home">
        <span class="brand-mark" aria-hidden="true">MJ</span>
        <span><strong>Mr. John’s</strong><small>Learning Hub</small></span>
      </a>
      <nav aria-label="Main navigation">
        <a href={base}>Home</a>
        <a href={`${base}#courses`}>Courses</a>
        <a href={`${base}#how-to-use`}>How to use</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <p><strong>Mr. John’s Learning Hub</strong></p>
      <p>Learn it. Try it. Explain it.</p>
    </footer>
    <JabberwockyDeviceTools />
  </body>
</html>
