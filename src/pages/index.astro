---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses } from '../data/courses';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="home-intro">
    <div>
      <p class="eyebrow">WELCOME TO YOUR LEARNING HUB</p>
      <h1>Choose a course.<br /><span>Start making sense of it.</span></h1>
      <p class="lead">Clear explanations, interactive tools, purposeful practice, and review—organized for the whole year.</p>
    </div>
    <aside class="today-card" aria-label="How learning works here">
      <p class="eyebrow">THE LEARNING LOOP</p>
      <ol>
        <li><span>01</span>Understand the big idea</li>
        <li><span>02</span>Explore and make connections</li>
        <li><span>03</span>Practise with feedback</li>
        <li><span>04</span>Review what needs attention</li>
      </ol>
    </aside>
  </section>

  <section class="course-section" id="courses">
    <div class="section-heading"><div><p class="eyebrow">COURSES</p><h2>Where are you learning today?</h2></div><p>Six middle-school learning spaces, one clear and consistent experience.</p></div>
    <div class="course-grid">
      {courses.map((course) => (
        <a class="course-card" href={`${base}courses/${course.slug}/`} style={`--course:${course.color};--course-soft:${course.accent}`}>
          <span class="course-number">{course.grade.replace('Grade ', '')}</span>
          <span class="subject-tag">{course.shortSubject}</span>
          <h3>{course.grade} {course.shortSubject}</h3>
          <p>{course.description}</p>
          <span class="course-link">View course <span aria-hidden="true">→</span></span>
        </a>
      ))}
      <a class="course-card futuretech-card" href={`${base}courses/futuretech-lab/`} style="--course:#5b21b6;--course-soft:#ede9fe">
        <span class="course-number">8/9</span>
        <span class="subject-tag">FutureTech</span>
        <h3>FutureTech Lab</h3>
        <p>Code, build robots, design games, and create 3D models through self-paced missions that grow with your skills.</p>
        <span class="course-link">Enter the lab <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="how-section" id="how-to-use">
    <div><p class="eyebrow">HOW TO USE EACH TOPIC</p><h2>One rhythm, every time.</h2></div>
    <div class="rhythm-grid">
      <span>🌎<b>Big Ideas</b><small>See the purpose</small></span><span>📘<b>Understand</b><small>Learn the concepts</small></span><span>🧠<b>Vocabulary</b><small>Build the language</small></span><span>🔬<b>Explore</b><small>Investigate</small></span><span>✏️<b>Practise</b><small>Get feedback</small></span><span>🎮<b>Apply</b><small>Use what you know</small></span><span>✅<b>Review</b><small>Check readiness</small></span>
    </div>
  </section>
</BaseLayout>

<style>
.futuretech-card{grid-column:1/-1;min-height:230px;position:relative;overflow:hidden;background:radial-gradient(circle at 92% 10%,rgba(34,211,238,.17),transparent 34%),linear-gradient(150deg,#fff,#f5f3ff)}
.futuretech-card h3{font-size:clamp(1.8rem,3vw,2.35rem)}
.futuretech-card p{max-width:760px}
.futuretech-card:after{content:"";position:absolute;right:-18px;bottom:-22px;width:150px;height:150px;border:1px solid rgba(91,33,182,.13);border-radius:28px;transform:rotate(20deg);pointer-events:none}
@media(max-width:700px){.futuretech-card{grid-column:1/-1;min-height:280px}}
</style>
