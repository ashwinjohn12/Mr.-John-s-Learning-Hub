---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import LearningSection from'../../../../components/LearningSection.astro';import Grade7Unit3Practice from'../../../../components/Grade7Unit3Practice.astro';import Grade7Unit5Check from'../../../../components/Grade7Unit5Check.astro';import Grade7Unit5Arcade from'../../../../components/Grade7Unit5Arcade.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit5UnitCheckBank}from'../../../../data/grade7Unit5UnitCheck';import type{Unit5Question}from'../../../../data/grade7Unit5';
const course=findCourse('grade-7-math')!,base=import.meta.env.BASE_URL,slugs=['models-add-fractions','other-models-add-fractions','symbols-add-fractions','models-subtract-fractions','symbols-subtract-fractions','adding-mixed-numbers','subtracting-mixed-numbers'],names=['Equal-part addition models','Number-line and set addition','Symbolic fraction addition','Take-away and difference models','Symbolic fraction subtraction','Mixed-number addition','Mixed-number subtraction and regrouping'],concepts=['Related denominators','Compare representations','Add and simplify','Comparison model','Inverse check','Compose a whole','Regroup one whole'];
const make=(id:string,p:string,a:string,d:string[],lesson:number,anchor:number):Unit5Question=>{const choices=[a,...d],k=Number(id.replace(/\D/g,''))%4;return{id,prompt:p,choices:[...choices.slice(-k),...choices.slice(0,-k)],answer:k,feedback:`Correct: ${a}. The model, common unit, operation, and simplest form agree.`,hint:`Represent the quantities in “${p}” on one consistent whole.`,hint2:`Rename the fractional parts with a common denominator, complete the operation, and simplify.`,category:`Lesson 5.${lesson+1}`,route:`../${slugs[lesson]}/#understand-${anchor}`}};
const modelNames=['linked fraction strips with equal-sized parts','scaled number line and a 12-object set','equivalence table showing denominator scale factors','take-away strip and labelled difference jump','symbolic board with an inverse-addition check','whole-and-part tray that composes a new whole','mixed-number blocks decomposing one whole'];
const finder=modelNames.map((m,i)=>make(`rf5${i+1}`,`Which model best supports ${names[i].toLowerCase()}?`,m,['unequal pieces labelled as equal','two different-sized wholes','an unscaled decorative bar'],i,2));
const md=[['2/7+3/7','5/7',0,1],['1/2+1/6','2/3',0,2],['1/4+1/3','7/12',1,1],['2/5+1/10','1/2',1,3],['3/4+5/6','1 7/12',2,3],['2/5+3/7','29/35',2,2],['5/8−1/4','3/8',3,2],['3/4−2/5','7/20',3,3],['7/8−1/6','17/24',4,3],['11/12−1/3','7/12',4,2],['2 1/4+1 1/2','3 3/4',5,2],['1 5/6+2 2/3','4 1/2',5,2],['2 1/5+1 3/4','3 19/20',5,3],['5 1/4−2 3/4','2 1/2',6,2],['6 1/3−2 3/4','3 7/12',6,3],['7 3/5−2 1/5','5 2/5',6,1],['1/3+1/4','7/12',1,1],['5/6−1/4','7/12',4,4],['3 3/8+2 1/4','5 5/8',5,2],['9 1/2−3 3/4','5 3/4',6,2]] as any[];
const mixed=md.map((x,i)=>make(`mr5${i+1}`,`Find ${x[0]}.`,x[1],[i%2?'2/7':'1/2',i%3?'3/5':'2 1/4','add or subtract denominators'],x[2],x[3]));
const rd=[['A student adds 2/7+3/7 as 5/14.','Keep the denominator 7 because the parts already match.',0,1],['A number line uses uneven spaces for twelfths.','Redraw twelve equal intervals before making jumps.',1,1],['A student renames 3/4 as 3/12.','Multiply numerator and denominator by 3: 9/12.',2,2],['A student subtracts 5/8−1/4 without renaming.','Rename 1/4 as 2/8 before removing.',3,2],['A student finds 7/8−1/6 as 6/2.','Use a common denominator of 24, then subtract numerators.',4,1],['A difference is not checked.','Add the difference to the removed amount to rebuild the start.',4,4],['A student adds 1 5/6+2 2/3 but forgets a new whole.','Compose 9/6 as 1 1/2.',5,2],['A student subtracts 5 1/4−2 3/4 directly.','Regroup 5 1/4 as 4 5/4.',6,2],['A model uses two differently sized wholes.','Redraw both fractions on equal-sized wholes.',0,1],['An answer is 8/12 but is called final.','Simplify 8/12 to 2/3.',2,3]] as any[];
const repairs=rd.map((x,i)=>make(`rp5${i+1}`,x[0],x[1],['Change only the colours.','Add the denominators.','Ignore the model scale.'],x[2],x[3]));
const stationText=['1/2+1/4 → 2/4+1/4=3/4','1/3+1/4 lands at 7/12 on a twelve-part line','3/4+5/6 → 9/12+10/12=19/12','3/4−2/5 is the 7/20 gap','7/8−1/6=17/24; 17/24+1/6=7/8','1 5/6+2 2/3 composes to 4 1/2','5 1/4 becomes 4 5/4 before subtracting 2 3/4'];
---
<BaseLayout title="Unit 5 Review & Fraction Fair Planner | Grade 7 Math" description="Review operations with fractions and complete the Fraction Fair Planner." themeColor={course.color}><div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Operations with Fractions',href:`${base}courses/grade-7-math/operations-fractions/`},{label:'Unit Review'}]}/><header class="hero"><p class="eyebrow">GRADE 7 MATH · UNIT 5</p><h1>Review & <span>Fraction Fair Planner</span></h1><p>Find a repair route, revisit seven accurate models, practise mixed connections, complete a balanced Unit Check, and synthesize the unit.</p></header>
<LearningSection id="route" eyebrow="QUICK ROUTE FINDER" title="Where should you begin?" icon="🧭" tone="idea"><div class="route" data-route>{finder.map((q,i)=><fieldset data-item data-answer={q.answer} data-station={`station-${i+1}`} data-label={`Lesson 5.${i+1} — ${concepts[i]}`}><legend>{q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`rf-${i}`} value={j}/>{c}</label>)}</fieldset>)}<button type="button" data-check>Build my route</button><p data-status role="status" tabindex="-1">Answer all seven.</p></div></LearningSection>
<LearningSection id="stations" eyebrow="TARGETED REVIEW" title="Seven model stations" icon="🧩" tone="learn"><div class="stations">{stationText.map((t,i)=><details id={`station-${i+1}`}><summary>Lesson 5.{i+1} · {names[i]}</summary><div class="model" role="img" aria-label={`Model transcript: ${t}`}><div class={`visual v${i}`} aria-hidden="true">{Array.from({length:12},()=> <i></i>)}</div><p><b>Model transcript:</b> {t}</p></div><a href={`../${slugs[i]}/#understand-2`}>Lesson 5.{i+1} — Understand: {concepts[i]}</a></details>)}</div></LearningSection>
<LearningSection id="practice" eyebrow="20 SUPPORTED QUESTIONS" title="Mixed review" icon="✏️" tone="practice"><Grade7Unit3Practice questions={mixed} lesson="unit-5-review"/></LearningSection><LearningSection id="repair" eyebrow="MISCONCEPTION REPAIR" title="Ten authentic repairs" icon="🛠️" tone="learn"><Grade7Unit3Practice questions={repairs} lesson="unit-5-repair"/></LearningSection><LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the unit?" icon="✅" tone="review"><p>A separate 40-question bank creates ten-question attempts with every lesson once and three different lessons twice.</p><Grade7Unit5Check bank={grade7Unit5UnitCheckBank} lesson="unit-5-check" count={10} balancedUnit={true}/></LearningSection><LearningSection id="arcade" eyebrow="MATH ARCADE" title="Fraction Fair Planner" icon="🎮" tone="play"><Grade7Unit5Arcade/></LearningSection><LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 5" icon="🏁" tone="review"><p>You are ready when you can model, calculate, simplify, estimate, and verify positive fraction and mixed-number sums and differences.</p><span class="coming" aria-disabled="true">Unit 6 · next approved destination (coming later)</span></LearningSection></div></BaseLayout>
<script>document.querySelectorAll<HTMLElement>('[data-route]').forEach(r=>{const out=r.querySelector<HTMLElement>('[data-status]');r.querySelector('[data-check]')?.addEventListener('click',()=>{const items=[...r.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){if(out)out.textContent='Answer all seven first.';missing.querySelector<HTMLInputElement>('input')?.focus();return}const missed=items.filter(x=>Number(x.querySelector<HTMLInputElement>('input:checked')?.value)!==Number(x.dataset.answer));if(out){out.innerHTML=missed.length?`<strong>Begin with:</strong> ${missed.map(x=>`<a href="#${x.dataset.station}">${x.dataset.label}</a>`).join(' ')}`:'<strong>All seven strands secure.</strong> Begin mixed review.';out.focus()}})})</script>
<style>.hero{padding:2rem 0}.hero h1{font-size:clamp(2.4rem,7vw,5rem);line-height:.95}.hero span{color:var(--course)}.route,.stations{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.route fieldset,.stations details{padding:.8rem;border:1px solid #dce4ed;border-radius:12px;background:#fff}.route label{display:flex;gap:.45rem;min-height:44px;align-items:center}.route button{min-height:44px;border:0;border-radius:8px;background:var(--course);color:#fff;padding:.65rem;font-weight:800}.route [data-status]{grid-column:1/-1}.model{padding:.7rem;background:#eef5ff}.visual{display:grid;grid-template-columns:repeat(12,1fr);height:60px;border:2px solid #24415f}.visual i{border-right:1px solid #60758a}.visual i:nth-child(-n+7){background:#6aa7e8}.v5 i:nth-child(-n+9),.v6 i:nth-child(-n+8){background:#f4c95d}.coming{display:inline-flex;padding:.7rem;background:#e8edf4}@media(max-width:700px){.route,.stations{grid-template-columns:1fr}.route [data-status]{grid-column:1}}@media(max-width:390px){.route,.stations{overflow-wrap:anywhere}.visual{min-width:260px}.model{overflow-x:auto}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style>
