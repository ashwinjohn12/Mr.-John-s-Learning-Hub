---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import LearningSection from'../../../../components/LearningSection.astro';import Grade7Unit3Practice from'../../../../components/Grade7Unit3Practice.astro';import Grade7Unit3Check from'../../../../components/Grade7Unit3Check.astro';import Grade7Unit3Arcade from'../../../../components/Grade7Unit3Arcade.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit3UnitCheckBank}from'../../../../data/grade7Unit3UnitCheck';import type{Unit3Question}from'../../../../data/grade7Unit3';
const course=findCourse('grade-7-math')!,base=import.meta.env.BASE_URL;const slugs=['fractions-to-decimals','compare-order-rational','decimal-add-subtract','multiplying-decimals','dividing-decimals','decimal-order-operations','relating-fractions-decimals-percents','solving-percent-problems'];const names=['Convert fractions','Compare and order','Add and subtract decimals','Multiply decimals','Divide decimals','Order of operations','Connect three forms','Solve percent problems'];const models=['3/4 → 3÷4 → 0.75','5/8=0.625 > 0.61','12.45+3.80=16.25','3.6×2.5=9','8.4÷0.7=84÷7=12','2.5+3×1.2=2.5+3.6=6.1','3/5=0.6=60%','35% of 80=28'];
const question=(id:string,prompt:string,answer:string,distractors:string[],category:string,route:string,i:number,feedback:string):Unit3Question=>{const choices=[answer,...distractors],k=i%4;return{id,prompt,choices:[...choices.slice(-k),...choices.slice(0,-k)],answer:k,feedback,hint:'Choose the representation and identify the first operation.',hint2:'Complete the decisive intermediate calculation, then compare its size with the choices.',category,route};};
const routeDistractors=[['3/4 → 4÷3 → 1.333','3/4 → 3+4 → 7','3/4 → 34'],['Compare only the number of digits','Compare numerators without denominators','Round every value to a whole'],['Align the final digits','Remove every decimal point','Round before deciding the operation'],['Add the factors','Use only one partial product','Place the decimal without estimating'],['Scale only the divisor','Assume division always makes smaller','Reverse dividend and divisor'],['Work strictly left to right','Add before multiplying','Drop unchanged terms'],['Move the decimal one place for every percent','Attach % without changing value','Use the numerator as the percent'],['Multiply by the whole percent number','Reverse part and whole','Subtract the percent from the whole']];
const routeFinder=names.map((n,i)=>question(`rf${i+1}`,`Which representation or strategy best supports ${n.toLowerCase()}?`,models[i],routeDistractors[i],`Lesson 3.${i+1}`,`station-${i+1}`,i,`Use ${models[i]} because it preserves the quantities and relationship.`));
const mixed:[string,string,string[]][]=[['Convert 11/20.','0.55',['0.11','0.22','0.205']],['Which is greater: 7/8 or 0.86?','7/8',['0.86','equal','cannot tell']],['Calculate 18.4−7.65.','10.75',['11.75','10.85','107.5']],['Calculate 2.8×1.4.','3.92',['39.2','4.2','2.14']],['Calculate 9.45÷0.35.','27',['2.7','270','9.1']],['Evaluate 3.4+2×1.25.','5.9',['6.75','8','4.65']],['Convert 7/20 to a percent.','35%',['7%','20%','0.35%']],['Find 32% of 125.','40',['32','93','400']],['Order 0.62,3/5,0.605 least to greatest.','3/5, 0.605, 0.62',['0.62, 0.605, 3/5','0.605, 3/5, 0.62','3/5, 0.62, 0.605']],['Calculate 7.08+3.925.','11.005',['10.905','110.05','11.95']],['Calculate 0.65×2.4.','1.56',['15.6','2.05','0.156']],['Calculate 7.2÷0.24.','30',['3','300','7.44']],['Evaluate 12−3.5+1.25.','9.75',['7.25','10.75','15.5']],['Convert 0.875 to a percent.','87.5%',['8.75%','0.875%','875%']],['$18 is 30% of what amount?','$60',['$54','$6','$600']],['Convert 13/25.','0.52',['0.13','0.325','5.2']],['Which is least: 0.709,0.71,7/10?','7/10',['0.709','0.71','all equal']],['Calculate 20−8.765.','11.235',['12.235','112.35','11.335']],['Calculate 3.25×0.6.','1.95',['19.5','3.85','0.195']],['A $80 item is 15% off. Find its sale price.','$68',['$12','$65','$92']]];
const practice=mixed.map((x,i)=>question(`mr${i+1}`,x[0],x[1],x[2],`Set ${Math.floor(i/4)+1}`,`../${slugs[i%8]}/#examples`,i,`The correct result is ${x[1]}. Use the displayed operation and check its size.`));
const repairData:[string,string,string[]][]=[['A student writes 3/8=0.38. What is the first repair?','Use 3÷8=0.375',['Place 3 and 8 side by side','Use 8÷3','Round before dividing']],['A student says 0.9<0.85 because 9<85.','Write 0.90>0.85',['Count digits','Write 0.09>0.85','Ignore place value']],['A student aligns 4.8+0.36 by the final digits.','Write 4.80 over 0.36',['Remove decimals','Write 48 over 0.36','Round both to zero']],['A student says 1.2×0.5=6.','Use one-half of 1.2=0.6',['Multiply by 5','Move decimal right','Add the factors']],['A student changes 6.3÷0.9 to 6.3÷9.','Scale both: 63÷9',['Scale only divisor','Add 6.3+0.9','Use 63÷0.9']],['A student evaluates 8−2.5+1.5 as 8−4.','Work left to right: 8−2.5 first',['Add 2.5+1.5 first','Multiply first','Drop 1.5']],['A student writes 7%=0.7.','Use 7/100=0.07',['Use 7/10','Multiply by 100','Write 7.0']],['A student finds 35% of 80 as 35×80.','Use 0.35×80',['Use 35+80','Use 80÷35','Ignore percent']],['A student orders 0.6 before 0.59 as though 6<59.','Write 0.60>0.59',['Count digits','Write 0.06>0.59','Round both to zero']],['A student reports 3.2×2.1=67.2.','Estimate near 6, then place decimal: 6.72',['Use 672','Use 0.672','Add factors']]];
const repairHints=[['Use the fraction bar as division.','Calculate 3÷8 far enough to see 0.375 before comparing.'],['Align both decimals to hundredths.','Rewrite 0.9 as 0.90, then compare tenths and hundredths.'],['Create columns headed ones, tenths, and hundredths.','Rewrite 4.8 as 4.80 before adding.'],['Use one-half as a multiplication benchmark.','Half of 1.2 must be less than 1.2.'],['Make the divisor a whole number without changing the quotient.','Multiply both 6.3 and 0.9 by 10.'],['Treat subtraction and addition as equal-priority operations.','Calculate 8−2.5 before adding 1.5.'],['Percent means out of 100.','Write 7% as 7÷100 before placing the decimal.'],['Change the percent to a decimal multiplier.','Use 0.35×80, not 35×80.'],['Align both values to hundredths.','Rewrite 0.6 as 0.60 before comparing.'],['Estimate the product before placing the decimal.','Since 3.2×2.1 is near 6, use the placement close to 6.']];
const repairs=repairData.map((x,i)=>{const item=question(`rp${i+1}`,x[0],x[1],x[2],`Repair ${i+1}`,`../${slugs[i%8]}/#understand-${i%4+1}`,i+1,`${x[1]}. This fixes the first mathematical error.`);item.hint=repairHints[i][0];item.hint2=repairHints[i][1];return item;});
---
<BaseLayout title="Unit 3 Review & Market Day Mission | Grade 7 Math" description="Review fractions, decimals, operations, and percents, then complete Market Day Mission." themeColor={course.color}><div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Fractions, Decimals, and Percents',href:`${base}courses/grade-7-math/fractions-decimals-percents/`},{label:'Unit Review'}]}/><header class="review-hero"><p class="eyebrow">GRADE 7 MATH · UNIT 3</p><h1>Review & <span>Market Day Mission</span></h1><p>Choose a focused repair route, practise the connections, complete a balanced Unit Check, and use the mathematics in one final market plan.</p></header>
<LearningSection id="route" eyebrow="QUICK ROUTE FINDER" title="Where should you begin?" icon="🧭" tone="idea"><div class="route" data-route>{routeFinder.map((q,i)=><fieldset data-item data-answer={q.answer} data-station={q.route} data-label={`Lesson 3.${i+1} — ${names[i]}`}><legend>{q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`route-${i}`} value={j}/>{c}</label>)}</fieldset>)}<button type="button" data-check>Build my route</button><p data-status role="status" tabindex="-1">Answer all eight to build a route.</p></div></LearningSection>
<LearningSection id="stations" eyebrow="TARGETED REVIEW" title="Eight concept stations" icon="🧩" tone="learn"><div class="stations">{names.map((n,i)=><details id={`station-${i+1}`}><summary><span>LESSON 3.{i+1}</span>{n}</summary><div class={`model model-${i+1}`} role="img" aria-label={`Model transcript: ${models[i]}`}><b>{models[i]}</b><div class={`actual-model station-visual-${i+1}`}>{i===0?Array.from({length:4},(_,j)=><i class={j<3?'on':''}></i>):i===1?<><b>0</b><i class="point"></i><b>0.625</b><i class="point"></i><b>1</b></>:i===2?<table><tr><th>ones</th><th>tenths</th><th>hundredths</th></tr><tr><td>12</td><td>4</td><td>5</td></tr><tr><td>3</td><td>8</td><td>0</td></tr></table>:i===3?Array.from({length:4},(_,j)=><i><b>{[6,1.5,1.2,.3][j]}</b></i>):i===4?Array.from({length:12},(_,j)=><i><b>{j+1}</b></i>):i===5?<><b>2.5 + 3 × 1.2</b><i>3 × 1.2 = 3.6</i><strong>2.5 + 3.6 = 6.1</strong></>:i===6?Array.from({length:100},(_,j)=><i class={j<60?'on':''}></i>):<><div class="percent-fill"></div><span>0% — 35% — 100%<br/>0 — 28 — 80</span></>}</div></div><p><b>Remember:</b> Represent first, calculate, check reasonableness, and interpret.</p><fieldset data-station data-answer="0"><legend>Which model matches this station?</legend><label><input type="radio" name={`station-${i}`} value="0"/>{models[i]}</label><label><input type="radio" name={`station-${i}`} value="1"/>A model that ignores the quantities or place value</label><button type="button">Check station</button><p role="status">Not checked.</p></fieldset><p class="misconception"><b>Misconception comparison:</b> The incorrect model changes a quantity or place value; the displayed model preserves both.</p><a href={`../${slugs[i]}/#understand-2`}>Lesson 3.{i+1} — Understand: {['Equivalent hundredths','Convert strategically','Use placeholder zeros','Combine partial products','Grouping division','Multiply and divide','Percent to decimal','Find the percent'][i]}</a></details>)}</div></LearningSection>
<LearningSection id="practice" eyebrow="20 SUPPORTED QUESTIONS" title="Mixed practice" icon="✏️" tone="practice"><Grade7Unit3Practice questions={practice} lesson="unit-3-review"/></LearningSection>
<LearningSection id="repair" eyebrow="MISCONCEPTION REPAIR" title="Ten repairs" icon="🛠️" tone="learn"><Grade7Unit3Practice questions={repairs} lesson="unit-3-repair"/></LearningSection>
<LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the unit?" icon="✅" tone="review"><p>Every ten-question attempt contains at least one question from each lesson; two lessons contribute one additional randomized question. Results and lesson scores remain hidden until submission.</p><Grade7Unit3Check bank={grade7Unit3UnitCheckBank} lesson="unit-3-check" count={10} balancedUnit={true}/></LearningSection>
<LearningSection id="arcade" eyebrow="MATH ARCADE" title="Market Day Mission" icon="🎮" tone="play"><Grade7Unit3Arcade/></LearningSection>
<LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 3" icon="🏁" tone="review"><p>You are ready to move forward when you can connect fractions and decimals, operate accurately with decimals, relate percents, and support a percent decision. The next approved course-map destination is shown without linking to unfinished content.</p><span class="coming" aria-disabled="true">Unit 4 · next approved destination</span></LearningSection></div></BaseLayout>
<script>document.querySelectorAll<HTMLElement>('[data-route]').forEach(root=>{const out=root.querySelector<HTMLElement>('[data-status]');root.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{if(out)out.textContent='Answer changed. Build the route again.'}));root.querySelector('[data-check]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){if(out)out.textContent='Answer all eight first.';missing.querySelector<HTMLInputElement>('input')?.focus();return}const missed=items.filter(x=>Number(x.querySelector<HTMLInputElement>('input:checked')?.value)!==Number(x.dataset.answer));if(out){out.innerHTML=missed.length?`<strong>Begin with:</strong> ${missed.map(x=>`<a href="#${x.dataset.station}">${x.dataset.label}</a>`).join(' ')}`:'<strong>All strands secure.</strong> Begin mixed practice or the Unit Check.';out.focus();}});});document.querySelectorAll<HTMLElement>('[data-station]').forEach(f=>{const p=f.querySelector<HTMLElement>('[role=status]');f.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{if(p)p.textContent='Answer changed. Check again.'}));f.querySelector('button')?.addEventListener('click',()=>{const x=f.querySelector<HTMLInputElement>('input:checked');if(!x){if(p)p.textContent='Choose an answer first.';return}const correct=f.querySelectorAll('label')[0]?.textContent?.trim();if(p)p.innerHTML=Number(x.value)===0?'<strong>Secure.</strong> The response matches the displayed model.':`<strong>Repair.</strong> Correct model: ${correct}. It preserves the displayed quantities and relationship.`;});});</script>
<style>.review-hero{padding:2rem 0}.review-hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:.95}.review-hero span{color:var(--course)}.route,.stations{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.route fieldset,.stations details{padding:.8rem;border:1px solid #dce4ed;border-radius:12px;background:#fff}.route label,.stations label{display:flex;gap:.45rem;min-height:44px;align-items:center}.route button,.stations button{min-height:44px;border:0;border-radius:8px;background:var(--course);color:#fff;padding:.65rem;font-weight:800}.route [data-status]{grid-column:1/-1;padding:.7rem;background:var(--course-soft)}.stations summary{display:grid;font-weight:850}.stations summary span{font-size:.75rem;color:var(--course)}.model{padding:.7rem;margin:.7rem 0;background:#eef5ff;border-radius:9px}.actual-model{display:grid;grid-template-columns:repeat(4,1fr);gap:.2rem;margin-top:.5rem}.actual-model i{height:32px;border:1px solid #60758a;background:var(--course)}.actual-model span{grid-column:1/-1;font-weight:750}.model-2 .actual-model,.model-5 .actual-model,.model-6 .actual-model,.model-8 .actual-model{border-bottom:3px solid #20344a}.model-3 .actual-model{grid-template-columns:repeat(3,1fr)}.model-3 .actual-model i{background:#fff}.model-7 .actual-model{grid-template-columns:repeat(10,1fr)}.model-7 .actual-model i{height:18px}.misconception{padding:.6rem;background:#fff6df}.coming{display:inline-flex;padding:.7rem;border-radius:8px;background:#e8edf4;color:#526174}@media(max-width:700px){.route,.stations{grid-template-columns:1fr}.route [data-status]{grid-column:1}}@media(max-width:390px){.route,.stations{overflow-wrap:anywhere}.actual-model{min-width:260px}.model{overflow-x:auto}}</style>

<style>.actual-model .on{background:var(--course)}.station-visual-2{display:flex;align-items:end;justify-content:space-between;min-height:54px}.station-visual-2 .point{width:13px;height:13px;margin-bottom:-8px;border-radius:50%}.station-visual-3 table{grid-column:1/-1;width:100%;border-collapse:collapse;text-align:center}.station-visual-3 th,.station-visual-3 td{border:1px solid #60758a;padding:.35rem}.station-visual-4{grid-template-rows:1fr 1fr;min-height:110px}.station-visual-4 i{display:grid;place-items:center;height:auto}.station-visual-5{grid-template-columns:repeat(6,1fr)}.station-visual-5 i{display:grid;place-items:center;border-radius:7px}.station-visual-6{display:grid;grid-template-columns:1fr!important;place-items:center;border:0!important}.station-visual-6 i{height:auto;padding:.35rem}.station-visual-7{grid-template-columns:repeat(10,1fr)}.station-visual-7 i{height:auto;aspect-ratio:1}.station-visual-8{display:grid;grid-template-columns:1fr!important;border:0!important}.percent-fill{height:34px;border:2px solid #20344a;background:linear-gradient(90deg,var(--course) 35%,#fff 35%)}</style>
