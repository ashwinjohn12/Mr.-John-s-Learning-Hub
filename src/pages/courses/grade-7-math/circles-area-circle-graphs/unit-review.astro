---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import LearningSection from'../../../../components/LearningSection.astro';import Grade7Unit3Practice from'../../../../components/Grade7Unit3Practice.astro';import Grade7Unit4Check from'../../../../components/Grade7Unit4Check.astro';import Grade7Unit4Arcade from'../../../../components/Grade7Unit4Arcade.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit4UnitCheckBank}from'../../../../data/grade7Unit4UnitCheck';import type{Unit4Question}from'../../../../data/grade7Unit4';
const course=findCourse('grade-7-math')!,base=import.meta.env.BASE_URL,slugs=['investigating-circles','circumference-circle','area-parallelogram','area-triangle','area-circle','interpreting-circle-graphs','drawing-circle-graphs'],names=['Circle parts and construction','Circumference and π','Parallelogram area','Triangle area','Circle area','Interpret circle graphs','Draw circle graphs'],concepts=['Radius and diameter','Choose a circumference formula','Base and perpendicular height','Triangle as half a parallelogram','Sector rearrangement and r²','Percent, angle, and count','Data, sectors, labels, and totals'];
const make=(id:string,prompt:string,answer:string,distractors:string[],category:string,route:string,shift:number,feedback:string,hint='Choose the model that shows the relationship.',hint2='Complete the decisive intermediate calculation before comparing choices.'):Unit4Question=>{const choices=[answer,...distractors],k=shift%4;return{id,prompt,choices:[...choices.slice(-k),...choices.slice(0,-k)],answer:k,feedback,hint,hint2,category,route}};
const routeModels=['a labelled centre with radius and diameter','a diameter with an unwrapped circumference and C÷d ratio','a cut-and-slide parallelogram with perpendicular height','two congruent triangles forming one parallelogram','alternating circle sectors approaching πr by r','a sector labelled with percent, angle, count, and total','a data table linked to proportional sectors, title, labels, 100%, and 360°'];
const routeDistractors=[
 ['a chord labelled as a diameter even though it misses the centre','a radius drawn from one edge to another','central angles that total 180°'],
 ['an area grid covering the inside of the circle','a radius used directly in C=πd without doubling','a circumference string compared with a slanted chord'],
 ['a parallelogram using its slanted side as height','a perimeter calculation that adds all four sides','a rectangle whose base no longer matches the parallelogram'],
 ['one triangle treated as the whole related parallelogram','a triangle using a slanted side instead of perpendicular height','a perimeter model with three side lengths'],
 ['a circumference wrap using 2πr','a sector rearrangement with diameter used as r','a ring model that subtracts radii before squaring'],
 ['a 35% sector drawn as 35°','a sector with angle but no total for finding a count','a graph whose labelled shares total 95%'],
 ['sector angles copied directly from percentages','a graph built before the category total is found','four equal sectors for unequal category counts']
];
const routeFinder=names.map((n,i)=>make(`rf4${i+1}`,`Which model would best help you ${n.toLowerCase()}?`,routeModels[i],routeDistractors[i],`Lesson 4.${i+1}`,`station-${i+1}`,i,`Begin with Lesson 4.${i+1} — ${n}: ${routeModels[i]}.`));
const mixedData:[string,string,string[],number,number][]=[
 ['Find d when r=9 cm.','18 cm',['9 cm','4.5 cm','27 cm'],0,1],['Angles 105°,85°, and x total 360°. Find x.','170°',['190°','150°','360°'],0,3],['Find C when d=18 m using π≈3.14.','56.52 m',['28.26 m','101.74 m','56.52 m²'],1,2],['A wheel with r=5 cm turns once. Find distance using π≈3.14.','31.4 cm',['15.7 cm','78.5 cm','10 cm'],1,3],['Find parallelogram area: b=11 m,h=7 m.','77 m²',['36 m²','77 m','121 m²'],2,3],['Find h when parallelogram A=96 cm²,b=12 cm.','8 cm',['12 cm','84 cm','1152 cm'],2,4],['Find triangle area: b=14 cm,h=5 cm.','35 cm²',['70 cm²','19 cm²','35 cm'],3,2],['Find b when triangle A=48 m²,h=8 m.','12 m',['6 m','384 m','24 m'],3,4],['Find circle area for r=4 m using π≈3.14.','50.24 m²',['25.12 m²','12.56 m²','50.24 m'],4,3],['Find circle area for d=14 cm using π≈3.14.','153.86 cm²',['615.44 cm²','43.96 cm²','153.86 cm'],4,3],['Find ring area for R=7,r=5 using π≈3.14.','75.36 units²',['37.68 units²','150.72 units²','24 units²'],4,4],['A 30% sector has total 90. Find count.','27',['30','60','3'],5,3],['A 54° sector is what percent?','15%',['54%','20%','6.67%'],5,2],['A 45% sector has total 160. Find count.','72',['45','115','7.2'],5,3],['Find the angle for 35%.','126°',['35°','108°','225°'],6,2],['Counts 16,12,8,4 total what?','40',['36','32','44'],6,1],['Find the percent for 12 of 40.','30%',['12%','40%','48%'],6,2],['Find the angle for 8 of 40.','72°',['80°','45°','144°'],6,3],['Do angles 144°,108°,72°,36° form a complete graph?','Yes; they total 360°',['No; they total 100°','No; they total 350°','Cannot tell'],6,4],['Which area is greater: parallelogram b=8,h=6 or triangle with same b,h?','Parallelogram by 24 units²',['Triangle by 24 units²','They are equal','Parallelogram by 48 units²'],3,2]
];
const mixed=mixedData.map((x,i)=>make(`mr4${i+1}`,x[0],x[1],x[2],`Lesson 4.${x[3]+1}`,`../${slugs[x[3]]}/#understand-${x[4]}`,i,`Correct: ${x[1]}. The model, calculation, and unit agree.`,i%2?'Identify the required formula and unit.':'Sketch or picture the lesson model first.',`For this exact task, calculate the relationship shown before selecting ${x[1]}.`));
const repairData:[string,string,string[],number,number,string,string][]=[
 ['A student calls every chord a diameter. What is the first repair?','A diameter must pass through the centre.',['Every chord passes through the centre.','A radius joins two circle points.','Circumference is a chord.'],0,1,'Locate the centre before naming the segment.','Check whether the chord crosses the centre.'],['A student uses C=πr for r=6 cm.','Use C=2πr because a diameter is two radii.',['Use A=πr².','Use C=π÷r.','Remove π.'],1,3,'Translate radius to diameter.','Use d=2r before C=πd.'],['A student uses the 9 cm slanted side instead of h=5 cm.','Use the 5 cm perpendicular height.',['Multiply both side lengths.','Add base and slant.','Use the longest side.'],2,2,'Find the segment at 90° to the base.','Area uses shortest perpendicular distance between bases.'],['A student calculates triangle area as 12×7=84 cm².','Divide the related parallelogram area by 2.',['Double 84.','Add 12+7.','Use a slanted side.'],3,2,'Build the second congruent triangle.','Two congruent triangles share the parallelogram area equally.'],['A student finds circle area with 2πr.','Use A=πr²; 2πr is circumference.',['Use πd.','Use bh.','Use π+r².'],4,3,'Decide whether the question asks inside or around.','Area covers the inside and uses square radius.'],['A student finds a ring using π(R−r)².','Subtract πr² from πR².',['Add both areas.','Use circumference difference.','Subtract diameters only.'],4,4,'Draw separate outer and inner circles.','Find each full area before subtracting.'],['A student treats 25% as a 25° sector.','Use 0.25×360°=90°.',['Use 25×360°.','Use 360÷25°.','Use 100°.'],5,2,'Percent and degrees use different wholes.','Convert the percent of 100 to the same fraction of 360°.'],['A student finds 35% of 200 as 35×200.','Use 0.35×200=70.',['Use 35+200.','Use 200÷35.','Use 3.5×200.'],5,3,'Write percent as a decimal.','Thirty-five percent is 0.35, not 35.'],['A graph totals 95%. What must be repaired?','Find or correct the missing 5% before approving it.',['Change the title only.','Accept the gap.','Add 5° instead.'],6,4,'Check the percent whole.','All categories must total exactly 100%.'],['A graph relies only on four colours.','Add direct text labels or an accessible legend.',['Use brighter colours only.','Remove the category names.','Change every sector to 25%.'],6,4,'Ask how a non-colour reader identifies sectors.','Text must communicate the same category information.']
];
const repairs=repairData.map((x,i)=>make(`rp4${i+1}`,x[0],x[1],x[2],`Lesson 4.${x[3]+1}`,`../${slugs[x[3]]}/#understand-${x[4]}`,i+1,`${x[1]} This repairs the first mathematical or accessibility error.`,x[5],x[6]));
const stationModels=[{label:'Circle r=5 cm, d=10 cm; central angles total 360°',kind:'circle'},{label:'d=10 cm, C≈31.4 cm, C÷d≈3.14',kind:'wrap'},{label:'Parallelogram b=9,h=4 rearranges to a 9×4 rectangle',kind:'para'},{label:'Two b=10,h=6 triangles make a 60-unit² parallelogram; each is 30',kind:'tri'},{label:'Circle r=4 sectors rearrange to base≈πr and height r; A≈50.27',kind:'sector'},{label:'35% of 200 = 70 and central angle =126°',kind:'pie'},{label:'Counts 12,9,6,3 → 40%,30%,20%,10% → 144°,108°,72°,36°',kind:'graph'}];
---
<BaseLayout title="Unit 4 Review & Water Park Designer | Grade 7 Math" description="Review circles, area, and circle graphs, then complete Water Park Designer." themeColor={course.color}><div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Circles, Area, and Circle Graphs',href:`${base}courses/grade-7-math/circles-area-circle-graphs/`},{label:'Unit Review'}]}/><header class="review-hero"><p class="eyebrow">GRADE 7 MATH · UNIT 4</p><h1>Review & <span>Water Park Designer</span></h1><p>Find the right repair route, revisit seven accurate models, practise mixed connections, complete a balanced Unit Check, and synthesize the unit in one design mission.</p></header>
<LearningSection id="route" eyebrow="QUICK ROUTE FINDER" title="Where should you begin?" icon="🧭" tone="idea"><div class="route" data-route>{routeFinder.map((q,i)=><fieldset data-item data-answer={q.answer} data-station={q.route} data-label={`Lesson 4.${i+1} — ${names[i]}`}><legend>{q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`route4-${i}`} value={j}/>{c}</label>)}</fieldset>)}<button type="button" data-check>Build my route</button><p data-status role="status" tabindex="-1">Answer all seven to build a route.</p></div></LearningSection>
<LearningSection id="stations" eyebrow="TARGETED REVIEW" title="Seven model stations" icon="🧩" tone="learn"><div class="stations">{stationModels.map((m,i)=><details id={`station-${i+1}`}><summary><span>LESSON 4.{i+1}</span>{names[i]}</summary><div class={`model ${m.kind}`} role="img" aria-label={`Model transcript: ${m.label}`}><b>{m.label}</b><div class="visual">{m.kind==='circle'?<><i class="round"></i><span>r=5 · d=10 · 360°</span></>:m.kind==='wrap'?<><i class="line short"></i><i class="line long"></i><span>31.4÷10≈3.14</span></>:m.kind==='para'?<><i class="slant"></i><i class="rect"></i><span>9×4=36</span></>:m.kind==='tri'?<><i class="triangle"></i><i class="triangle flip"></i><span>60÷2=30</span></>:m.kind==='sector'?<><i class="round sliced"></i><i class="sectors"></i><span>π·4²≈50.27</span></>:m.kind==='pie'?<><i class="round thirtyfive"></i><span>35% · 126° · 70/200</span></>:<><i class="round four"></i><span>40+30+20+10=100%<br/>144+108+72+36=360°</span></>}</div><p>Model transcript: {m.label}</p></div><fieldset data-station><legend>Which statement matches this model?</legend><label><input type="radio" name={`station4-${i}`} value="0"/>{concepts[i]}</label><label><input type="radio" name={`station4-${i}`} value="1"/>Ignore the displayed quantities or relationship</label><button type="button">Check station</button><p role="status">Not checked.</p></fieldset><a href={`../${slugs[i]}/#understand-2`}>Lesson 4.{i+1} — Understand: {concepts[i]}</a></details>)}</div></LearningSection>
<LearningSection id="practice" eyebrow="20 SUPPORTED QUESTIONS" title="Mixed review" icon="✏️" tone="practice"><Grade7Unit3Practice questions={mixed} lesson="unit-4-review"/></LearningSection>
<LearningSection id="repair" eyebrow="MISCONCEPTION REPAIR" title="Ten repair activities" icon="🛠️" tone="learn"><Grade7Unit3Practice questions={repairs} lesson="unit-4-repair"/></LearningSection>
<LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the whole unit?" icon="✅" tone="review"><p>A separate 40-question bank creates balanced ten-question attempts: every lesson appears at least once, three distinct lessons appear twice, and no question repeats. Results remain hidden until submission.</p><Grade7Unit4Check bank={grade7Unit4UnitCheckBank} lesson="unit-4-check" count={10} balancedUnit={true}/></LearningSection>
<LearningSection id="arcade" eyebrow="MATH ARCADE" title="Water Park Designer" icon="🎮" tone="play"><Grade7Unit4Arcade/></LearningSection>
<LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 4" icon="🏁" tone="review"><p>You are ready when you can connect circle measures, derive and apply three area formulas, and construct and interpret a complete circle graph. Unit 5 remains unavailable until its approved experience is finished.</p><span class="coming" aria-disabled="true">Unit 5 · next approved destination (coming later)</span></LearningSection></div></BaseLayout>
<script>document.querySelectorAll<HTMLElement>('[data-route]').forEach(root=>{const out=root.querySelector<HTMLElement>('[data-status]');root.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{if(out)out.textContent='Answer changed. Build the route again.'}));root.querySelector('[data-check]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){if(out)out.textContent='Answer all seven first.';missing.querySelector<HTMLInputElement>('input')?.focus();return}const missed=items.filter(x=>Number(x.querySelector<HTMLInputElement>('input:checked')?.value)!==Number(x.dataset.answer));if(out){out.innerHTML=missed.length?`<strong>Begin with:</strong> ${missed.map(x=>`<a href="#${x.dataset.station}">${x.dataset.label}</a>`).join(' ')}`:'<strong>All seven strands secure.</strong> Begin mixed review or the Unit Check.';out.focus()}})});document.querySelectorAll<HTMLElement>('[data-station]').forEach(f=>{const p=f.querySelector<HTMLElement>('[role=status]');f.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{if(p)p.textContent='Answer changed. Check again.'}));f.querySelector('button')?.addEventListener('click',()=>{const x=f.querySelector<HTMLInputElement>('input:checked');if(!x){if(p)p.textContent='Choose an answer first.';x?.focus();return}if(p)p.innerHTML=x.value==='0'?'<strong>Secure.</strong> The statement matches the represented mathematics.':'<strong>Repair.</strong> Use the displayed labels and transcript; the model must preserve every quantity and relationship.'})});</script>
<style>.review-hero{padding:2rem 0}.review-hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:.95}.review-hero span{color:var(--course)}.route,.stations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.route fieldset,.stations details{padding:.8rem;border:1px solid #dce4ed;border-radius:12px;background:#fff}.route label,.stations label{display:flex;gap:.45rem;min-height:44px;align-items:center}.route button,.stations button{min-height:44px;border:0;border-radius:8px;background:var(--course);color:#fff;padding:.65rem;font-weight:800}.route [data-status]{grid-column:1/-1;padding:.7rem;background:var(--course-soft)}.stations summary{display:grid;font-weight:850}.stations summary span{font-size:.75rem;color:var(--course)}.model{padding:.7rem;margin:.7rem 0;background:#eef5ff;border-radius:9px}.visual{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;align-items:center;min-height:110px;margin-top:.5rem}.visual i{display:block;min-height:42px;border:2px solid #2457c5}.round{width:90px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at center,#17243a 0 3px,transparent 4px),linear-gradient(90deg,transparent 49%,#17243a 50%,transparent 51%),#dbeafe}.line.short{width:35%}.line.long{width:100%}.slant{transform:skew(-20deg);background:#dbeafe}.rect{background:#fef3c7}.triangle{clip-path:polygon(50% 0,100% 100%,0 100%);background:#dbeafe}.triangle.flip{transform:rotate(180deg);background:#fef3c7}.sliced{background:repeating-conic-gradient(#2457c5 0 22.5deg,#dbeafe 22.5deg 45deg)}.sectors{background:repeating-linear-gradient(135deg,#2457c5 0 12px,#dbeafe 12px 24px)}.thirtyfive{background:conic-gradient(#2457c5 0 126deg,#dbeafe 126deg)}.four{background:conic-gradient(#2457c5 0 144deg,#f4c95d 144deg 252deg,#5da271 252deg 324deg,#dbeafe 324deg)}.coming{display:inline-flex;padding:.7rem;border-radius:8px;background:#e8edf4;color:#526174}@media(max-width:700px){.route,.stations{grid-template-columns:1fr}.route [data-status]{grid-column:1}}@media(max-width:390px){.route,.stations{overflow-wrap:anywhere}.visual{grid-template-columns:1fr;min-width:260px}.model{overflow-x:auto}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>
