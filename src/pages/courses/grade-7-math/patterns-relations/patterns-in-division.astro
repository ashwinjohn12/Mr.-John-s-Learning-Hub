---
import Grade7LessonFrame from '../../../../components/Grade7LessonFrame.astro';
import LearningSection from '../../../../components/LearningSection.astro';
import VocabularyExplorer from '../../../../components/VocabularyExplorer.astro';
import DivisibilityPatternLab from '../../../../components/DivisibilityPatternLab.astro';
import DivisibilityPractice from '../../../../components/DivisibilityPractice.astro';
import DivisibilityCheck from '../../../../components/DivisibilityCheck.astro';
import { findCourse } from '../../../../data/courses';

const course=findCourse('grade-7-math')!;
const unit=course.units.find(item=>item.slug==='patterns-relations')!;
const topic=unit.topics.find(item=>item.slug==='patterns-in-division')!;
const vocabulary=[
 {term:'Divisible',definition:'A number is divisible by another number when the quotient is a whole number with no remainder.',example:'48 is divisible by 8 because 48 ÷ 8 = 6.'},
 {term:'Divisibility rule',definition:'A shortcut that uses number patterns to decide whether division will have a remainder.',example:'A number ending in 0 or 5 is divisible by 5.'},
 {term:'Multiple',definition:'A product of a given number and a whole number.',example:'40 is a multiple of 8 because 8 × 5 = 40.'},
 {term:'Factor',definition:'A number that divides evenly into another number.',example:'8 is a factor of 56.'},
 {term:'Quotient',definition:'The result of division.',example:'In 56 ÷ 8 = 7, the quotient is 7.'},
 {term:'Remainder',definition:'The amount left after making equal groups.',example:'19 ÷ 4 is 4 remainder 3.'},
 {term:'Ones digit',definition:'The digit in the ones place, at the far right of a whole number.',example:'The ones digit of 3,728 is 8.'},
 {term:'Venn diagram',definition:'Overlapping regions used to show how categories are related.',example:'The divisible-by-8 region fits inside the divisible-by-4 region.'}
];
---

<Grade7LessonFrame {course} {unit} {topic}>
 <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
  <div class="two-grid"><div class="card"><p class="mini-label">BEFORE YOU START</p><ul><li>Recall multiplication facts for 2, 4, 5, 8, and 10.</li><li>Know the ones, tens, hundreds, and thousands places.</li><li>Be ready to explain how you know.</li></ul></div><div class="card"><p class="mini-label">BY THE END, I CAN…</p><ul><li>Test divisibility by 2, 4, 5, 8, and 10.</li><li>Identify which final digits contain the evidence.</li><li>Explain why the rules for 4 and 8 work.</li><li>Classify and construct numbers using overlapping rules.</li></ul></div></div>
  <div class="lesson-meta"><span><strong>Time:</strong> 45–60 minutes</span><span><strong>Materials:</strong> optional paper · pencil</span></div>
  <div class="warmup" data-warmup><p class="mini-label">QUICK PREDICTION</p><h3>Which numbers divide evenly?</h3><p>Choose a divisor, then select every number you predict will work.</p><div class="warm-rules" aria-label="Choose a divisor"><button class="active" type="button" data-warm-rule="2" aria-pressed="true">÷ 2</button><button type="button" data-warm-rule="5" aria-pressed="false">÷ 5</button><button type="button" data-warm-rule="10" aria-pressed="false">÷ 10</button></div><div class="warm-numbers" aria-label="Choose every number that divides evenly">{[126,245,732,1090].map(n=><button type="button" data-warm-number={n} aria-pressed="false">{n.toLocaleString()}</button>)}</div><button class="button" type="button" data-warm-check>Check my prediction</button><p data-warm-feedback role="status">Look only at the ones digit. What do you notice?</p></div>
  <details class="success-box"><summary>How will I know I understand it?</summary><p>You can name the relevant digits, state the rule, and connect evidence to a conclusion—for example, “The last three digits are 352. Since 352 = 8 × 44, 1,352 is divisible by 8.”</p></details>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big ideas" icon="🌎" tone="idea">
  <p class="big-statement">Divisibility rules are place-value patterns, not magic tricks.</p>
  <div class="three-grid"><article><strong>Divisible means no remainder</strong><p>Equal groups use every item, so the quotient is a whole number.</p></article><article><strong>Only an ending may matter</strong><p>Use one digit for 2, 5, 10; two for 4; three for 8.</p></article><article><strong>Some rules are nested</strong><p>8 → 4 → 2, while 10 → 5 and 2.</p></article></div>
  <div class="reasoning-frame"><strong>Explain with precision</strong><span><b>Rule</b> → which ending?</span><span><b>Evidence</b> → why does it work?</span><span><b>Conclusion</b> → what is true?</span></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
  <p class="table-cue" aria-hidden="true">Swipe table →</p><div class="rule-table" role="table" aria-label="Divisibility rules"><div class="rule-row head"><strong>Divisor</strong><strong>Inspect</strong><strong>Rule</strong><strong>Why it works</strong></div><div class="rule-row"><b>2</b><span>ones digit</span><span>0, 2, 4, 6, or 8</span><span>Every ten already divides by 2.</span></div><div class="rule-row"><b>5</b><span>ones digit</span><span>0 or 5</span><span>Every ten already divides by 5.</span></div><div class="rule-row"><b>10</b><span>ones digit</span><span>0</span><span>A complete ten is one group of 10.</span></div><div class="rule-row"><b>4</b><span>last 2 digits</span><span>That number divides by 4</span><span>100 is divisible by 4.</span></div><div class="rule-row"><b>8</b><span>last 3 digits</span><span>That number divides by 8</span><span>1,000 is divisible by 8.</span></div></div>
  <div class="proof"><div><p class="eyebrow">PLACE-VALUE PROOF</p><h3>Why can you ignore the front?</h3><p><b>46,728 = 46,000 + 728.</b> Each thousand is divisible by 8 because 1,000 = 8 × 125. Only 728 can create a remainder.</p></div><div class="proof-parts"><span>46 × 1,000<small>already divides by 8</small></span><b>+</b><span>728<small>test this part</small></span></div></div>
  <div class="sets"><div class="set two">Divisible by 2<div class="set four">Divisible by 4<div class="set eight">Divisible by 8</div></div></div><div class="set five">Divisible by 5<div class="set ten">Divisible by 10<br/><small>also overlaps with 2</small></div></div></div>
  <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p><details class="misconception"><summary>“It ends in 8, so it must be divisible by 8.”</summary><p>No. For 8, test the last three digits. For example, 138 ends in 8 but is not divisible by 8.</p></details><details class="misconception"><summary>“Every even number is divisible by 4.”</summary><p>Even proves divisibility by 2. The number 14 is even but is not a multiple of 4.</p></details></div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <div class="examples"><article><p class="eyebrow">EXAMPLE 1 · TEST ALL FIVE</p><h3>Which rules work for 46,728?</h3><ol><li><b>2:</b> 8 is even → yes.</li><li><b>4:</b> 28 = 4 × 7 → yes.</li><li><b>8:</b> 728 = 8 × 91 → yes.</li><li><b>5 and 10:</b> it ends in neither 0 nor 5 → no.</li></ol><p class="answer"><strong>Conclusion:</strong> divisible by 2, 4, and 8.</p></article>
  <article><p class="eyebrow">EXAMPLE 2 · SORT</p><h3>Use the strongest rule</h3><div class="sort-model"><div><b>2 only</b><span>314 · 1,278</span></div><div><b>4, not 8</b><span>756</span></div><div><b>8 (also 4 and 2)</b><span>520 · 1,024 · 2,312</span></div></div><p>Nested categories prevent a number from being counted three times.</p></article>
  <article><p class="eyebrow">EXAMPLE 3 · MISSING DIGIT</p><h3>Complete 73□ for divisibility by 4, then 8</h3><ol><li>Test the last two digits: 32 and 36 are multiples of 4.</li><li>So <b>732 and 736</b> are divisible by 4.</li><li>For 8, test each whole three-digit number: only 736 = 8 × 92.</li></ol></article>
  <article class="error"><p class="eyebrow">EXAMPLE 4 · REPAIR</p><h3>Ari uses 64 to test 7,642 for divisibility by 4.</h3><p>The relevant last two digits are <b>42</b>, not 64. Since 42 is not divisible by 4, neither is 7,642.</p></article></div>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={vocabulary}/><p class="use-it"><strong>Use it:</strong> Say a complete sentence connecting one term to a divisibility rule.</p></LearningSection>
 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Divisibility Pattern Lab" icon="🔬" tone="explore"><p class="lead">Uncover relationships, control the important digits, and explain why each classification works.</p><DivisibilityPatternLab/></LearningSection>
 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>Work through digit selection, multi-rule classification, number building, and error analysis. Support buttons teach the mathematics whenever you need them.</p><DivisibilityPractice/></LearningSection>
 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>This separate bank builds a fresh mixed-difficulty set. You will not see correctness until all five answers are submitted.</p><DivisibilityCheck/></LearningSection>

 <LearningSection id="apply" eyebrow="PLAY & APPLY" title="Community Supply Packing Plan" icon="🎮" tone="play">
  <div class="application" data-application><div class="apply-intro"><div><p class="eyebrow">REAL-LIFE DECISION</p><h3>Choose efficient packing sizes</h3><p>Volunteers can use equal boxes of 2, 4, 5, 8, or 10. Justify choices using ending rules—not full division.</p></div><div class="shipments"><span>1,248</span><span>1,350</span><span>2,400</span><span>975</span></div></div>
  <div class="shipment-table">{[1248,1350,2400,975].map(n=><fieldset data-shipment={n}><legend>{n.toLocaleString()}</legend><div class="box-options">{[2,4,5,8,10].map(d=><label><input type="checkbox" value={d}/> {d}</label>)}</div><span class="shipment-status" data-shipment-status aria-live="polite">Not checked</span></fieldset>)}</div>
  <div class="written"><label>Repair: “Every even shipment can be packed in boxes of 4.” Give a counterexample.<textarea data-counter rows="3" placeholder="The claim is false because…"></textarea><small data-counter-feedback aria-live="polite">Include a specific even number and show why the last two digits fail the rule for 4.</small></label><label>Add no more than 3 items to 1,350 so boxes of 8 work. Explain.<textarea data-adjust rows="3" placeholder="Add… because the last three digits…"></textarea><small data-adjust-feedback aria-live="polite">Name the amount added, the new total, and evidence from its last three digits.</small></label><label>Recommend one box size for 2,400 and justify why it is efficient.<textarea data-recommend rows="3" placeholder="I recommend… The evidence is…"></textarea><small data-recommend-feedback aria-live="polite">State a box size and connect it to a divisibility rule.</small></label></div>
  <button class="apply-button" type="button" data-apply-check>Check the mathematical evidence</button><p class="apply-feedback" data-apply-feedback role="status"></p></div>
 </LearningSection>

 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
  <div class="two-grid"><div class="card"><p class="mini-label">RULE RELAY</p><ul><li>ones digit: 2, 5, 10</li><li>last two digits: 4</li><li>last three digits: 8</li></ul></div><div class="card"><p class="mini-label">RELATIONSHIPS</p><ul><li>8 → 4 → 2</li><li>10 → 5 and 2</li><li>Rule → Evidence → Conclusion</li></ul></div></div>
  <div class="exit" data-exit><p class="eyebrow">3-QUESTION EXIT TICKET</p><fieldset><legend>1. Which rules work for 27,640?</legend><label><input type="radio" name="exit1" value="all"/> all five</label><label><input type="radio" name="exit1" value="some"/> 2, 4, 5, and 10 only</label></fieldset><fieldset><legend>2. Which digit completes 51□ so it is divisible by 4 but not 8?</legend><label><input type="radio" name="exit2" value="6"/> 6</label><label><input type="radio" name="exit2" value="2"/> 2</label></fieldset><label class="exit-write">3. Why can you ignore digits before the last three when testing divisibility by 8?<textarea rows="3" data-exit-text placeholder="Complete thousands can be ignored because…"></textarea></label><button type="button" data-exit-check>Check readiness</button><p data-exit-feedback role="status"></p></div>
  <div class="readiness"><strong>Move forward when:</strong><ul><li>Check Yourself is at least 4 / 5.</li><li>A reasoning item is correct.</li><li>The exit ticket is at least 2 / 3 with an explanation.</li></ul><p>If not yet, revisit the Pattern Lab or supported practice. Nothing is locked.</p></div>
  <div class="next-step"><div><p class="eyebrow">COMING NEXT</p><strong>Lesson 1.2 · More Patterns in Division</strong><span>Add rules for 3, 6, and 9, then explain why division by zero is undefined.</span></div><span class="coming">Coming next</span></div>
 </LearningSection>
</Grade7LessonFrame>

<script>
 document.querySelectorAll<HTMLElement>('[data-warmup]').forEach(w=>{let rule=2;const chosen=new Set<number>();w.querySelectorAll<HTMLButtonElement>('[data-warm-rule]').forEach(b=>b.addEventListener('click',()=>{rule=Number(b.dataset.warmRule);chosen.clear();w.querySelectorAll<HTMLButtonElement>('[data-warm-rule]').forEach(x=>{const selected=x===b;x.classList.toggle('active',selected);x.setAttribute('aria-pressed',String(selected))});w.querySelectorAll<HTMLButtonElement>('[data-warm-number]').forEach(x=>{x.classList.remove('selected');x.setAttribute('aria-pressed','false')})}));w.querySelectorAll<HTMLButtonElement>('[data-warm-number]').forEach(b=>b.addEventListener('click',()=>{const n=Number(b.dataset.warmNumber);chosen.has(n)?chosen.delete(n):chosen.add(n);const selected=chosen.has(n);b.classList.toggle('selected',selected);b.setAttribute('aria-pressed',String(selected))}));w.querySelector('[data-warm-check]')?.addEventListener('click',()=>{const nums=[126,245,732,1090],correct=nums.filter(n=>n%rule===0),ok=nums.every(n=>chosen.has(n)===correct.includes(n)),f=w.querySelector('[data-warm-feedback]');if(f)f.innerHTML=`<strong>${ok?'Pattern found.':'Check the ending again.'}</strong> Divisible by ${rule}: ${correct.map(n=>n.toLocaleString()).join(', ')}. ${rule===2?'Each ends in an even digit.':rule===5?'Each ends in 0 or 5.':'Each ends in 0.'}`})});
 document.querySelectorAll<HTMLElement>('[data-application]').forEach(w=>w.querySelector('[data-apply-check]')?.addEventListener('click',()=>{const expected:{[key:string]:number[]}={'1248':[2,4,8],'1350':[2,5,10],'2400':[2,4,5,8,10],'975':[5]};let rows=0;w.querySelectorAll<HTMLFieldSetElement>('[data-shipment]').forEach(f=>{const got=[...f.querySelectorAll<HTMLInputElement>('input:checked')].map(x=>Number(x.value)),want=expected[f.dataset.shipment||''];const ok=got.length===want.length&&want.every(x=>got.includes(x));f.classList.toggle('correct',ok);f.classList.toggle('incorrect',!ok);const status=f.querySelector('[data-shipment-status]');if(status)status.textContent=ok?'✓ Correct':'Needs another look';if(ok)rows++});const c=(w.querySelector<HTMLTextAreaElement>('[data-counter]')?.value||'').toLowerCase(),a=(w.querySelector<HTMLTextAreaElement>('[data-adjust]')?.value||'').toLowerCase(),r=(w.querySelector<HTMLTextAreaElement>('[data-recommend]')?.value||'').toLowerCase();const counterNumber=Number((c.replaceAll(',','').match(/\d+/)||['0'])[0]),counterValid=counterNumber>0&&counterNumber%2===0&&counterNumber%4!==0&&(c.includes('4')||c.includes('last two'));const adjustValid=(a.includes('add 2')||a.includes('+2'))&&(a.includes('1352')||a.includes('1,352')||a.includes('352'))&&(a.includes('8')||a.includes('last three'));const recommended=[2,4,5,8,10].find(d=>new RegExp(`(?:box(?:es)?(?: of| size)?\\s*${d}|recommend\\s*${d}|÷\\s*${d})`).test(r)),recommendValid=Boolean(recommended)&&r.length>=20&&(r.includes('end')||r.includes('last')||r.includes('divis')||r.includes('multiple'));const setFeedback=(selector:string,ok:boolean,success:string,support:string)=>{const node=w.querySelector(selector);if(node)node.innerHTML=`<strong>${ok?'Evidence found.':'Keep revising.'}</strong> ${ok?success:support}`};setFeedback('[data-counter-feedback]',counterValid,`${counterNumber.toLocaleString()} is even but is not divisible by 4.`,'Use an even number whose last two digits are not a multiple of 4.');setFeedback('[data-adjust-feedback]',adjustValid,'Adding 2 gives 1,352, and 352 = 8 × 44.','State “add 2,” name 1,352, and connect 352 to the rule for 8.');setFeedback('[data-recommend-feedback]',recommendValid,`Your recommendation names box size ${recommended} and includes rule evidence.`,'Name one box size—2, 4, 5, 8, or 10—and explain which ending proves it works.');const writing=[counterValid,adjustValid,recommendValid].filter(Boolean).length,f=w.querySelector('[data-apply-feedback]');if(f)f.innerHTML=`<strong>${rows}/4 packing rows correct · ${writing}/3 explanations include the needed evidence.</strong> ${rows===4&&writing===3?'Your packing plan is fully justified.':'Use the row labels and the writing notes to revise, then check again.'}`}));
 document.querySelectorAll<HTMLElement>('[data-exit]').forEach(w=>w.querySelector('[data-exit-check]')?.addEventListener('click',()=>{let score=0;if(w.querySelector<HTMLInputElement>('input[name="exit1"]:checked')?.value==='all')score++;if(w.querySelector<HTMLInputElement>('input[name="exit2"]:checked')?.value==='6')score++;const t=(w.querySelector<HTMLTextAreaElement>('[data-exit-text]')?.value||'').toLowerCase();if((t.includes('1000')||t.includes('thousand'))&&(t.includes('8')||t.includes('divis')))score++;const f=w.querySelector('[data-exit-feedback]');if(f)f.innerHTML=`<strong>${score} / 3.</strong> ${score>=2?'Your exit evidence is ready. Use your Check Yourself result too.':'Review the rule table, then try again. Connect 1,000 = 8 × 125 to question 3.'}`}));
</script>

<style>
 .two-grid,.three-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.three-grid{grid-template-columns:repeat(3,1fr)}.card,.three-grid article{border:1px solid #e1e7ee;border-radius:14px;padding:1rem;background:#fff}.three-grid article{border-top:4px solid #9a6700;background:#fffaf0}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.card ul,.examples ol,.readiness ul{padding-left:1.2rem}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.8rem 1rem;border-radius:12px;background:#f5f7fa}.success-box{margin-top:1rem}.warmup{margin-top:1rem;padding:1rem;border:1px solid #e6d99f;border-radius:15px;background:#fffdf5}.warmup h3{margin:.15rem 0}.warm-rules,.warm-numbers{display:flex;gap:.55rem;flex-wrap:wrap;margin:.7rem 0}.warmup button{border:1px solid #d8d0ad;border-radius:9px;background:#fff;padding:.6rem .85rem;font-weight:800;cursor:pointer}.warmup button.active,.warmup button.selected{background:#9a6700;color:#fff}.warm-numbers button.selected::after{content:' ✓';font-weight:900}.warmup button:focus-visible,.apply-button:focus-visible,.exit button:focus-visible,.application input:focus-visible,.application textarea:focus-visible,.exit input:focus-visible,.exit textarea:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}.reasoning-frame{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:.5rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:13px;background:#fff7d6}.reasoning-frame span{display:grid}.table-cue{display:none;text-align:right;margin:.2rem 0;color:#526174;font-size:.86rem;font-weight:750}.rule-table{border:1px solid #dbe4ef;border-radius:14px;overflow:hidden}.rule-row{display:grid;grid-template-columns:70px 120px 1.2fr 1.5fr;gap:.7rem;padding:.7rem .9rem;border-top:1px solid #e5eaf0;align-items:center}.rule-row:nth-child(even){background:#f8fbff}.rule-row>b{font-size:1.3rem;color:#2457c5}.rule-row.head{border:0;background:#174ea6;color:#fff}.proof{display:grid;grid-template-columns:1.3fr 1fr;gap:1rem;margin-top:1rem;padding:1rem;border-radius:15px;background:#eef6ff}.proof h3{margin:.15rem 0}.proof-parts{display:flex;align-items:center;gap:.4rem;text-align:center}.proof-parts span{display:grid;padding:.7rem;border-radius:10px;background:#fff;font-weight:900}.proof-parts small{color:#526174;font-weight:500}.sets{display:grid;grid-template-columns:1.3fr 1fr;gap:1rem;margin-top:1rem}.set{padding:.8rem;border:2px solid #2563eb;border-radius:15px;font-weight:800}.set .set{margin-top:.55rem}.four{border-color:#7c3aed}.eight{border-color:#b7791f;background:#fff9e8}.five{border-color:#059669}.ten{border-color:#0f766e;background:#eefcf8}.mixups{margin-top:1rem}.examples{display:grid;gap:1rem}.examples article{border:1px solid #dce4ed;border-radius:15px;padding:1rem}.examples h3{margin:.2rem 0}.examples .error{background:#fff8f1}.answer{padding:.7rem;border-radius:10px;background:#f0fdf4}.sort-model{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.sort-model div{display:grid;padding:.7rem;border-radius:10px;background:#eef6ff}.use-it{padding:.8rem;border-radius:10px;background:#f8f5ff}.lead{font-size:1.06rem}.application{border-radius:15px;overflow:hidden;background:#21133d;color:#fff}.apply-intro{display:grid;grid-template-columns:1.3fr 1fr;gap:1rem;padding:1.2rem}.apply-intro h3{font-size:1.5rem;margin:.15rem 0}.shipments{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}.shipments span{display:grid;place-items:center;padding:.7rem;border-radius:10px;background:#ffffff17;font-weight:900}.shipment-table{margin:0 1.2rem;background:#fff;color:#152238;border-radius:12px;overflow:hidden}.shipment-table fieldset{display:grid;grid-template-columns:110px 1fr auto;align-items:center;border:0;border-bottom:1px solid #e2e8f0;padding:.7rem;margin:0}.shipment-table legend{float:left;font-weight:900}.box-options{display:flex;gap:.7rem;flex-wrap:wrap}.shipment-table label{margin-right:.25rem}.shipment-status{font-size:.84rem;font-weight:850}.shipment-table fieldset.correct{background:#edf9f0}.shipment-table fieldset.correct .shipment-status{color:#176235}.shipment-table fieldset.incorrect{background:#fff5f5}.shipment-table fieldset.incorrect .shipment-status{color:#a32727}.written{display:grid;gap:.9rem;padding:1.2rem}.written label{display:grid;gap:.35rem;font-weight:700}.written small{font-weight:500;color:#e3dcf2}.written small strong{color:#fff}.written textarea,.exit textarea{font:inherit;border:1px solid #d6dde6;border-radius:9px;padding:.7rem;resize:vertical}.apply-button{margin:0 1.2rem;border:0;border-radius:9px;background:#f4c95d;color:#21133d;padding:.7rem 1rem;font-weight:900}.apply-feedback{margin:1rem 1.2rem;padding:.7rem;border-radius:9px;background:#ffffff17}.exit{margin:1rem 0;padding:1rem;border:1px solid #c8e7d0;border-radius:14px;background:#f7fcf8}.exit fieldset{border:0;border-bottom:1px solid #dce9df;padding:.7rem 0}.exit legend,.exit-write{font-weight:800}.exit label{margin-right:1rem}.exit-write{display:grid;gap:.35rem;margin:.7rem 0}.exit button{border:0;border-radius:9px;background:#2b6e3f;color:#fff;padding:.65rem .9rem;font-weight:800}.exit [data-exit-feedback]{padding:.6rem;background:#edf9f0}.readiness{padding:1rem;border-radius:12px;background:#edf9f0}.next-step>div{display:grid}.next-step>div span{color:#526174}.coming{padding:.45rem .7rem;border-radius:99px;background:#eef3f9;white-space:nowrap}
 @media(max-width:760px){.two-grid,.three-grid,.proof,.sets,.sort-model,.apply-intro{grid-template-columns:1fr}.reasoning-frame{grid-template-columns:1fr}.table-cue{display:block}.rule-table{overflow:auto}.rule-row{min-width:650px}.shipment-table fieldset{grid-template-columns:1fr;gap:.5rem}.shipment-table legend{float:none}.shipment-status{justify-self:start}.proof-parts{justify-content:center}.next-step{align-items:start}}
</style>
