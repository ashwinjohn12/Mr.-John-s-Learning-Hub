---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import LearningSection from '../../../../components/LearningSection.astro';
import Grade7Unit1Practice from '../../../../components/Grade7Unit1Practice.astro';
import Grade7Unit1Check from '../../../../components/Grade7Unit1Check.astro';
import Grade7Unit1Arcade from '../../../../components/Grade7Unit1Arcade.astro';
import { findCourse } from '../../../../data/courses';
import { grade7Unit1Lessons } from '../../../../data/grade7Unit1';
import { grade7Unit1UnitCheckBank } from '../../../../data/grade7Unit1UnitCheck';
const course=findCourse('grade-7-math')!;const unit=course.units.find(x=>x.slug==='patterns-relations')!;const base=import.meta.env.BASE_URL;
const lesson11Practice={prompt:'Which rules work for 1,240?',choices:['2,4,5,8,10','2,5,10','2,4,8','all rules'],answer:0,feedback:'The ending 0 proves 2,5,10; 40 proves 4; 240 proves 8.',hint:'Inspect the last digit, two digits, and three digits.',category:'Lesson 1.1'};
const lesson11Mixed=[lesson11Practice,
 {prompt:'Which number is divisible by 8?',choices:['1,212','1,216','1,218','1,222'],answer:1,feedback:'216=8×27.',hint:'Test the final three digits.',category:'Lesson 1.1'},
 {prompt:'Which rules must a number ending in 0 pass?',choices:['2,5,10','4,8','3,9','only 10'],answer:0,feedback:'An ending of 0 is even and is divisible by 5 and 10.',hint:'Use the final digit.',category:'Lesson 1.1'},
 {prompt:'Is 3,124 divisible by 4?',choices:['Yes','No'],answer:0,feedback:'The final two digits, 24, are divisible by 4.',hint:'Test only the final two digits.',category:'Lesson 1.1'},
 {prompt:'Is 6,342 divisible by 5?',choices:['Yes','No'],answer:1,feedback:'A multiple of 5 ends in 0 or 5.',hint:'Inspect the final digit.',category:'Lesson 1.1'},
 {prompt:'Which is divisible by 4 but not 8?',choices:['128','132','144','160'],answer:1,feedback:'132÷4=33, but 132 is not divisible by 8.',hint:'Test the final two and three digits.',category:'Lesson 1.1'}
];
const mixedPractice=[...lesson11Mixed,...grade7Unit1Lessons.flatMap(lesson=>lesson.practice.slice(0,2).map(item=>({...item,category:`Lesson ${lesson.number}`})))];
const unitBank=grade7Unit1UnitCheckBank;
const stations=[
 {title:'Divisibility and factor reasoning',lessons:'1.1–1.2',prompt:'Can I justify rules, combine conditions, organize factors, and explain division by zero?',remember:'Use the relevant ending for 2, 4, 5, 8, and 10; use the digit sum for 3 and 9; use both 2 and 3 for 6.',example:'For 1,368: digit sum 18 proves 3 and 9; evenness plus 3 proves 6; 368 proves 8, so 4 and 2 also work.'},
 {title:'Expressions and substitution',lessons:'1.3',prompt:'Can I translate, identify expression parts, substitute, and interpret a value?',remember:'An expression names a value. Keep order-sensitive language and use parentheses when an entire result is multiplied.',example:'“Subtract 3, then double” is 2(n−3). At n=8, its value is 10.'},
 {title:'Patterns, relations, and tables',lessons:'1.4–1.5',prompt:'Can I connect growth, rules, inputs, outputs, and predictions?',remember:'The constant change becomes the coefficient. Use a known input-output pair to find the fixed part, then test every row.',example:'Outputs 6, 10, 14 change by 4. For inputs 1, 2, 3, the rule is y=4x+2.'},
 {title:'Graphing relations',lessons:'1.6',prompt:'Can I move accurately between table rows, ordered pairs, and graphs?',remember:'Write input first, choose equal scale intervals, label both axes, and connect points only when the context permits every in-between value.',example:'The row x=3, y=11 becomes the point (3,11).'},
 {title:'Equations and equality',lessons:'1.7–1.8',prompt:'Can I translate, model, solve, and verify while preserving equality?',remember:'An equation claims equal values. Apply the same operation to both sides, then substitute the solution into the original equation.',example:'x+5=13 → subtract 5 from both sides → x=8; check 8+5=13.'}
];
---
<BaseLayout title="Unit 1 Review & Math Arcade | Grade 7 Math" description="Review patterns, relations, expressions, graphs, and equations." themeColor={course.color}>
 <div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}>
  <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:unit.title,href:`${base}courses/grade-7-math/patterns-relations/`},{label:'Unit Review'}]}/>
  <header class="review-hero"><p class="eyebrow">UNIT 1 · PATTERNS AND RELATIONS</p><h1>Unit 1 Review<br/><span>& Math Arcade</span></h1><p>Repair one idea at a time, connect every representation, then prove your readiness with an independent check and a whole-unit mission.</p></header>
  <LearningSection id="overview" eyebrow="START SMART" title="Choose your review route" icon="🎯" tone="idea"><p>Check a statement only if you could prove it without opening the reminder. An unchecked statement shows where to begin.</p><div class="station-grid">{stations.map(station=><article><p class="eyebrow">LESSONS {station.lessons}</p><h3>{station.title}</h3><label><input type="checkbox"/> {station.prompt}</label></article>)}</div><p class="route-note"><strong>Route:</strong> Begin with any unchecked station. If all five are checked, start with mixed practice.</p></LearningSection>
  <LearningSection id="targeted-review" eyebrow="TARGET YOUR REVIEW" title="Five concept stations" icon="🗺️" tone="learn"><p>Open the station you selected. Retrieve the idea first, then compare your thinking with the example.</p><div class="concept-stations">{stations.map(station=><details><summary><span>Lessons {station.lessons}</span><strong>{station.title}</strong></summary><p><b>Remember:</b> {station.remember}</p><p class="station-example"><b>Example:</b> {station.example}</p></details>)}</div><h3 class="lesson-route-title">Need the complete lesson?</h3><div class="lesson-map">{unit.topics.map(topic=><a href={`${base}courses/grade-7-math/patterns-relations/${topic.slug}/`}><span>{topic.number}</span><div><strong>{topic.title}</strong><small>{topic.summary}</small></div><b>Review →</b></a>)}</div></LearningSection>
  <LearningSection id="practice" eyebrow="PRACTISE WITH SUPPORT" title="Supported mixed practice" icon="✏️" tone="practice"><p>These questions mix the unit on purpose. Immediate feedback helps you decide which representation to review.</p><Grade7Unit1Practice questions={mixedPractice} lesson="unit-1-review"/></LearningSection>
  <LearningSection id="repair" eyebrow="COMMON-MISTAKE REPAIR" title="Repair Shop" icon="🛠️" tone="learn"><p>Choose the repair that fixes the reasoning—not only the final answer.</p><div class="repair-grid">
   <details><summary>“A digit sum of 12 proves divisibility by 9.”</summary><p><strong>Repair:</strong> 12 proves divisibility by 3, not 9. A digit sum must itself be a multiple of 9.</p><a href={`${base}courses/grade-7-math/patterns-relations/more-patterns-in-division/#understand`}>Review Lesson 1.2 →</a></details>
   <details><summary>“A number ending in 8 must be divisible by 8.”</summary><p><strong>Repair:</strong> An even final digit proves divisibility by 2. For 8, test the entire final three-digit number.</p><a href={`${base}courses/grade-7-math/patterns-relations/patterns-in-division/#understand`}>Review Lesson 1.1 →</a></details>
   <details><summary>“Three less than twice n is 2(n−3).”</summary><p><strong>Repair:</strong> “Twice n, then subtract 3” is 2n−3. The parentheses would double both n and −3.</p><a href={`${base}courses/grade-7-math/patterns-relations/algebraic-expressions/#understand`}>Review Lesson 1.3 →</a></details>
   <details><summary>“The +4 change means the rule is n+4.”</summary><p><strong>Repair:</strong> A constant change of 4 gives coefficient 4. Use one pair to find the fixed part.</p><a href={`${base}courses/grade-7-math/patterns-relations/relationships-in-patterns/#understand`}>Review Lesson 1.4 →</a></details>
   <details><summary>“A rule works because it matches one table row.”</summary><p><strong>Repair:</strong> Different rules can share one pair. Test the proposed rule against every known row.</p><a href={`${base}courses/grade-7-math/patterns-relations/patterns-tables/#understand`}>Review Lesson 1.5 →</a></details>
   <details><summary>“Table row x=3, y=11 becomes (11,3).”</summary><p><strong>Repair:</strong> Ordered pairs use input first: (3,11).</p><a href={`${base}courses/grade-7-math/patterns-relations/graphing-relations/#understand`}>Review Lesson 1.6 →</a></details>
   <details><summary>“n+8 is the equation for a number plus 8 equals 25.”</summary><p><strong>Repair:</strong> n+8 is only an expression. The complete equality claim is n+8=25.</p><a href={`${base}courses/grade-7-math/patterns-relations/reading-writing-equations/#understand`}>Review Lesson 1.7 →</a></details>
   <details><summary>“To solve 4x=28, subtract 4.”</summary><p><strong>Repair:</strong> Division undoes multiplication. Divide both sides by 4, then verify x=7.</p><a href={`${base}courses/grade-7-math/patterns-relations/equations-algebra-tiles/#understand`}>Review Lesson 1.8 →</a></details>
   <details><summary>“0÷0=0 because zero shared equally is zero.”</summary><p><strong>Repair:</strong> Every value q makes 0×q=0, so division cannot select one unique quotient. That makes 0÷0 undefined.</p><a href={`${base}courses/grade-7-math/patterns-relations/more-patterns-in-division/#understand-4`}>Review Lesson 1.2 →</a></details>
   <details><summary>“The point is (3,12), so each grid square must equal 1.”</summary><p><strong>Repair:</strong> Read the numbered scale. Equal grid intervals may represent 1, 2, 5, or another consistent amount.</p><a href={`${base}courses/grade-7-math/patterns-relations/graphing-relations/#understand-2`}>Review Lesson 1.6 →</a></details>
  </div></LearningSection>
  <LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the whole unit?" icon="✅" tone="review"><p>A fresh 12-question set is drawn from a separate 40-item unit bank. Feedback is withheld until the full set is submitted.</p><Grade7Unit1Check bank={unitBank} lesson="unit-1-check" count={12}/><div class="score-routes"><strong>What to do with your result</strong><span>10–12: ready for the Arcade and final Unit 1 reflection</span><span>8–9: review the linked missed ideas</span><span>5–7: complete the matching station and practice</span><span>0–4: rebuild through Lessons 1.1–1.8 in sequence</span></div></LearningSection>
  <LearningSection id="arcade" eyebrow="MATH ARCADE" title="Pattern Machine Mission" icon="🎮" tone="play"><Grade7Unit1Arcade/></LearningSection>
  <LearningSection id="spiral" eyebrow="SPIRALLING BACK" title="Keep earlier number skills active" icon="🌀" tone="practice"><div class="spiral-grid"><article><h3>Order of operations</h3><p>Evaluate 4(6+3)−8.</p><details><summary>Check</summary><p>28. Parentheses first, then multiplication, then subtraction.</p></details></article><article><h3>Factors</h3><p>List the factor pairs of 48.</p><details><summary>Check</summary><p>1×48, 2×24, 3×16, 4×12, 6×8.</p></details></article><article><h3>Coordinates</h3><p>Describe how to plot (4,7).</p><details><summary>Check</summary><p>Move 4 along the horizontal axis, then 7 up the vertical axis.</p></details></article></div></LearningSection>
  <LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 1" icon="🏁" tone="review"><p>Move forward when your Unit Check is at least 10/12, the Arcade recommendation connects three representations, and you can explain one mistake repair without help.</p><div class="final-links"><a class="button secondary" href={`${base}courses/grade-7-math/patterns-relations/`}>Return to Unit 1</a><span class="button coming-next" aria-disabled="true">Unit 2 · Integers — coming next</span></div></LearningSection>
 </div>
</BaseLayout>
<style>
.review-hero{padding:2rem 0 1rem}.review-hero h1{font-size:clamp(2.4rem,7vw,5rem);line-height:.94;margin:.35rem 0}.review-hero h1 span{color:var(--course)}.review-hero>p:last-child{max-width:780px;font-size:1.08rem;color:#526174}.station-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem}.station-grid article,.repair-grid details,.spiral-grid article{padding:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#fff}.station-grid h3{font-size:1rem}.route-note,.score-routes{display:grid;gap:.4rem;margin-top:1rem;padding:.8rem;border-radius:10px;background:var(--course-soft)}.lesson-map{display:grid;gap:.6rem}.lesson-map a{display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;padding:.8rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff;color:inherit;text-decoration:none}.lesson-map a>span{display:grid;place-items:center;width:42px;height:42px;border-radius:99px;background:var(--course-soft);font-weight:900}.lesson-map small{display:block;color:#617086}.repair-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.repair-grid summary{font-weight:850;cursor:pointer}.repair-grid a{color:var(--course);font-weight:750}.spiral-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.final-links{display:flex;gap:.6rem;flex-wrap:wrap}.final-links a{text-decoration:none}@media(max-width:900px){.station-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.station-grid,.repair-grid,.spiral-grid{grid-template-columns:1fr}.lesson-map a{grid-template-columns:auto 1fr}.lesson-map b{grid-column:2}.review-hero{padding-top:1rem}}
.concept-stations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.concept-stations details{border:1px solid #dfe5ee;border-radius:14px;background:#fff;overflow:hidden}.concept-stations summary{display:grid;gap:.2rem;padding:1rem;cursor:pointer}.concept-stations summary span{font-size:.78rem;font-weight:900;letter-spacing:.06em;color:var(--course)}.concept-stations details>p{margin:.7rem 1rem}.station-example{padding:.7rem;border-radius:9px;background:var(--course-soft)}.lesson-route-title{margin-top:1.4rem}.coming-next{background:#e8edf4;color:#526174;cursor:not-allowed}.final-links .button{display:inline-flex;align-items:center}@media(max-width:650px){.concept-stations{grid-template-columns:1fr}}
</style>
