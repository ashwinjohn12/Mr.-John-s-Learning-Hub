---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import LearningSection from'../../../../components/LearningSection.astro';import Grade7Unit3Practice from'../../../../components/Grade7Unit3Practice.astro';import Grade7Unit7Check from'../../../../components/Grade7Unit7Check.astro';import Grade7Unit7Arcade from'../../../../components/Grade7Unit7Arcade.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit7Lessons,grade7Unit7Slugs,grade7Unit7ConceptNames,type Unit7Question}from'../../../../data/grade7Unit7';import{grade7Unit7UnitCheckBank}from'../../../../data/grade7Unit7UnitCheck';
const course=findCourse('grade-7-math')!,base=import.meta.env.BASE_URL,names=['Mean and mode','Median and range','Outlier effects','Choosing and auditing averages','Probability representations','Two-event experiments'];
const repair=(q:Unit7Question,l:number):Unit7Question=>({...q,id:`review-${l}-${q.id}`,route:`../${grade7Unit7Slugs[l]}/${q.route.startsWith('#')?q.route:'#understand-1'}`,category:`Lesson 7.${l+1}`,repairLabel:`Lesson 7.${l+1} — Understand: ${grade7Unit7ConceptNames[l][Number((q.route.match(/\d+/)||['1'])[0])-1]||grade7Unit7ConceptNames[l][0]}`});
const mixed:Unit7Question[]=[...grade7Unit7Lessons.flatMap((l,i)=>l.practice.slice(0,3).map(q=>repair(q,i))),repair(grade7Unit7Lessons[0].practice[4],0),repair(grade7Unit7Lessons[5].practice[4],5)];
const mk=(id:string,prompt:string,correct:string,wrong:string[],l:number,a:number,feedback:string,h1:string,h2:string):Unit7Question=>{const choices=[correct,...wrong],k=Number(id.replace(/\D/g,''))%4,rot=k?[...choices.slice(-k),...choices.slice(0,-k)]:choices;return{id,prompt,choices:rot,answer:k,responseType:'choice',feedback,hint:h1,hint2:h2,category:`Lesson 7.${l+1}`,route:`../${grade7Unit7Slugs[l]}/#understand-${a}`,repairLabel:`Lesson 7.${l+1} — Understand: ${grade7Unit7ConceptNames[l][a-1]}`}};
const repairData=[
 ['Mean is found by dividing the total by the largest data value.','Divide the total by the number of data values.',0,1,'Mean is fair share across the count.'],
 ['The largest number in a list is labelled the mode.','Count frequencies; the most frequent value is the mode.',0,2,'Mode is a frequency measure.'],
 ['The median is taken from the middle of the list as originally written.','Order the values first, then locate the middle position(s).',1,1,'Ordering is a dependency for median.'],
 ['For four ordered values, the lower middle value alone is the median.','Average the two central values.',1,2,'Even-sized datasets have two central positions.'],
 ['Every maximum is called an outlier.','Judge unusual separation relative to the distribution and context.',2,1,'Outlier status is contextual, not a maximum rule.'],
 ['A high outlier is removed without telling the reader.','State the reporting purpose and disclose whether the outlier is included.',2,4,'Outlier treatment must be transparent.'],
 ['A correct mean is shown on a bar graph whose axis starts just below the smallest value to exaggerate differences.','Use an appropriate scale and audit the visual claim separately from the arithmetic.',3,3,'Correct arithmetic cannot rescue a misleading representation.'],
 ['A mean is reported as proof that every person has that value.','Describe the mean as a dataset summary, not an individual guarantee.',3,2,'A summary statistic does not replace individual observations.'],
 ['A spinner has 3 favourable and 9 unfavourable equal sectors, so probability is written 3/9.','Use 3 favourable out of 12 total: 3/12.',4,1,'Probability uses favourable over total.'],
 ['An event with probability 0% is rejected as “not a probability.”','Recognize 0% as the valid probability of an impossible event.',4,3,'Probability includes endpoints 0 and 1.'],
 ['A tree for coin then 4-sector spinner shows only winning branches.','Show all 2×4=8 ordered outcomes before marking the winners.',5,2,'Sample space must be complete.'],
 ['An experiment gets 28% wins while theory is 25%, so the model is declared wrong immediately.','Compare relative frequency with theory and allow random variation, especially in finite samples.',5,4,'Experimental probability need not equal theory exactly.']
] as const;
const repairs=repairData.map((x,i)=>mk(`repair7-${i+1}`,x[0],x[1],['keep the original work','change only the colours','ignore the representation'],x[2],x[3],x[4],`Name the first mathematical dependency violated in this work.`,`Repair the calculation or representation before interpreting the result.`));
const finder=[
 ['“The biggest value must be the mode.”','Count frequencies; mode means most frequent.',0,2],
 ['“I can find the median before sorting.”','Order the data before locating the middle.',1,1],
 ['“Delete every outlier automatically.”','Use context and report inclusion/exclusion transparently.',2,4],
 ['“The arithmetic is correct, so a cropped graph is fine.”','Audit scale and visual impression separately from calculation.',3,3],
 ['“3 winning sectors and 9 losing sectors means P(win)=3/9.”','Use favourable/total: 3/12.',4,1],
 ['“Only winning branches belong in a two-event sample space.”','Build every ordered pair before identifying favourable outcomes.',5,2]
] as const;
const station=[
 ['Scores 6, 8, 8, 10, 13','Total 45 ÷ 5 = mean 9; 8 occurs twice, so mode 8.'],
 ['Ordered 4, 6, 9, 13','Median = (6+9)÷2 = 7.5; range = 13−4 = 9.'],
 ['Waits 9, 10, 10, 11, 12, 35','35 is separated from the cluster; mean 14.5, median 10.5.'],
 ['Attendance 18, 19, 20, 20, 21, 52','Mean 25, median 20, mode 20, range 34; the showcase outlier changes the reporting choice.'],
 ['3 prize sectors of 12 equal sectors','3:12 = 3/12 = 1/4 = 25%; 0% impossible, 100% certain.'],
 ['Coin {H,T} × spinner {A,B,C,D}','2×4=8 ordered pairs; H with A or B gives 2/8=25% theoretical probability.']
] as const;
---
<BaseLayout title="Unit 7 Review & Board Game Fairness Lab | Grade 7 Math" description="Review data analysis and probability, then complete the Board Game Fairness Lab." themeColor={course.color}><div class="page" style={`--course:${course.color};--soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Data Analysis and Probability',href:`${base}courses/grade-7-math/data-probability/`},{label:'Unit Review'}]}/><header class="hero"><p>GRADE 7 MATH · UNIT 7</p><h1>Review & <span>Board Game Fairness Lab</span></h1><p>Repair authentic misconceptions, revisit six accurate models, complete a balanced Unit Check, and synthesize data and probability evidence.</p></header>
<LearningSection id="route" eyebrow="QUICK ROUTE FINDER" title="Where should you begin?" icon="🧭" tone="idea"><div class="route" data-route>{finder.map((x,i)=>{const q=mk(`finder7-${i+1}`,x[0],x[1],['accept the original claim','change only the formatting','skip the model'],x[2],x[3],'This repair targets the first mathematical misconception.','Ask what definition or dependency is being violated.','Use the exact lesson model before recalculating.');return <fieldset data-item data-answer={q.answer} data-station={`station-${i+1}`} data-label={`Lesson 7.${i+1} — ${grade7Unit7ConceptNames[i][x[3]-1]}`}><legend>{q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`finder-${i}`} value={j}/><span>{c}</span></label>)}</fieldset>})}<button type="button" data-check>Build my repair route</button><p data-status role="status" tabindex="-1">Answer all six.</p></div></LearningSection>
<LearningSection id="stations" eyebrow="TARGETED REVIEW" title="Six accessible model stations" icon="📊" tone="learn"><div class="stations">{station.map((x,i)=><details id={`station-${i+1}`}><summary>Lesson 7.{i+1} · {names[i]}</summary><div class="model" role="img" aria-label={`${x[0]}. ${x[1]}`}><strong>{x[0]}</strong><div aria-hidden="true" class="model-line"><span>data/model</span><b>→</b><span>calculation</span><b>→</b><span>interpretation</span></div><p><b>Model transcript:</b> {x[1]}</p></div><a href={`../${grade7Unit7Slugs[i]}/#understand-${i===0?1:Math.min(i,4)}`}>Repair in Lesson 7.{i+1}</a></details>)}</div></LearningSection>
<LearningSection id="practice" eyebrow="20 SUPPORTED QUESTIONS" title="Mixed review" icon="✏️" tone="practice"><Grade7Unit3Practice questions={mixed} lesson="unit-7-review"/></LearningSection>
<LearningSection id="repair" eyebrow="MISCONCEPTION REPAIR" title="Twelve authentic repairs" icon="🛠️" tone="learn"><Grade7Unit3Practice questions={repairs} lesson="unit-7-repair"/></LearningSection>
<LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the whole unit?" icon="✅" tone="review"><p>The separate 40-question bank creates randomized ten-question attempts. Every attempt includes all six lessons; four lessons receive a second question, and those extra slots rotate across regenerations.</p><Grade7Unit7Check bank={grade7Unit7UnitCheckBank} lesson="unit-7-check" count={10} balancedUnit={true}/></LearningSection>
<LearningSection id="arcade" eyebrow="MATH ARCADE" title="Board Game Fairness Lab" icon="🎮" tone="play"><Grade7Unit7Arcade/></LearningSection>
<LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 7" icon="🏁" tone="review"><p>You are ready when you can calculate and interpret averages and probabilities, audit tables/graphs/scales/labels/models, and make evidence-based predictions and decisions without overstating what the data prove.</p><p class="coming" aria-disabled="true">Unit 8 · Geometry and Transformations — coming later. No unfinished Unit 8 link is provided.</p><a class="back" href="../">← Return to Unit 7 overview</a></LearningSection></div></BaseLayout>
<script>document.querySelectorAll<HTMLElement>('[data-route]').forEach(root=>{const out=root.querySelector<HTMLElement>('[data-status]')!;root.querySelector('[data-check]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){out.textContent='Answer all six before building the route.';missing.querySelector<HTMLInputElement>('input')?.focus();return}const missed=items.filter(x=>Number(x.querySelector<HTMLInputElement>('input:checked')?.value)!==Number(x.dataset.answer));out.innerHTML=missed.length?`<strong>Start with these exact repair stations:</strong> ${missed.map(x=>`<a href="#${x.dataset.station}">${x.dataset.label}</a>`).join(' ')}`:'<strong>All six entry misconceptions are secure.</strong> Begin mixed review.';out.focus({preventScroll:true})})})</script>
<style>.page{max-width:1180px;margin:auto;padding:1rem}.hero{padding:2.5rem 0}.hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:.95}.hero h1 span{color:var(--course)}.route,.stations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.route fieldset,.stations details{padding:.8rem;border:1px solid #dce4ed;border-radius:12px;background:#fff}.route label{display:flex;gap:.45rem;min-height:44px;align-items:center}.route button{min-height:44px;border:0;border-radius:8px;background:var(--course);color:#fff;padding:.65rem;font-weight:850}.route [data-status]{grid-column:1/-1}.model{padding:.75rem;background:#eef5ff}.model-line{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;margin:.7rem 0}.model-line span{padding:.4rem;background:#fff;border:1px solid #718196}.coming{display:block;padding:.75rem;background:#e8edf4}.back{display:inline-block;margin-top:.7rem;padding:.7rem;background:var(--course);color:#fff;text-decoration:none;border-radius:8px;font-weight:850}.page :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:700px){.route,.stations{grid-template-columns:1fr}.route [data-status]{grid-column:1}}@media(max-width:390px){.page{padding:.75rem}.route,.stations{overflow-wrap:anywhere}.model{overflow-x:auto}}@media(max-width:375px){.page{padding:.65rem}}@media(max-width:320px){.page{padding:.5rem}.route fieldset,.stations details{padding:.65rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>