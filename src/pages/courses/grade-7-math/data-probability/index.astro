---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit7Topics}from'../../../../data/grade7Unit7';const course=findCourse('grade-7-math')!,unit=course.units.find(x=>x.slug==='data-probability')!,base=import.meta.env.BASE_URL;
---
<BaseLayout title="Unit 7 · Data Analysis and Probability | Grade 7 Math" description="Analyze averages, outliers, probability representations, and two-event experiments." themeColor={course.color}><div class="page" style={`--course:${course.color};--soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Unit 7 · Data Analysis and Probability'}]}/><header><p class="eyebrow">GRADE 7 MATH · UNIT 7</p><h1>Data Analysis <span>& Probability</span></h1><p>Read the story behind data, challenge misleading representations, and test whether probability models match evidence.</p></header><section aria-labelledby="lessons"><h2 id="lessons">Lessons</h2><div class="grid">{grade7Unit7Topics.map((t,i)=><a href={`./${t.slug}/`}><b>{t.number}</b><h3>{t.title}</h3><p>{t.summary}</p><span>Start lesson →</span></a>)}</div></section><section class="review"><div><p class="eyebrow">UNIT REVIEW</p><h2>Board Game Fairness Lab</h2><p>Use all six lessons to repair misconceptions, complete a balanced Unit Check, and audit a five-stage real-life game system.</p></div><a href="./unit-review/">Open Unit Review & Math Arcade →</a></section><section class="readiness"><h2>How to know you are ready</h2><p>You can calculate accurately <em>and</em> judge whether the dataset, graph/table, scale, labels, probability model, interpretation, prediction, and decision support one another. Unit 8 is not required for this unit and is not linked from this private build.</p></section></div></BaseLayout>
<style>.page{max-width:1180px;margin:auto;padding:1rem}.page header{padding:3rem 0}.page h1{font-size:clamp(2.7rem,8vw,5.6rem);line-height:.92;margin:.3rem 0}.page h1 span{color:var(--course)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}.grid a{display:block;padding:1.1rem;border:1px solid #dbe4ed;border-radius:16px;background:#fff;color:#17243a;text-decoration:none}.grid a b{color:var(--course)}.grid a span{font-weight:850;color:var(--course)}.review,.readiness{margin-top:1.3rem;padding:1.2rem;border-radius:16px;background:var(--soft)}.review{display:flex;justify-content:space-between;gap:1rem;align-items:center}.review>a{padding:.75rem;border-radius:9px;background:var(--course);color:#fff;font-weight:850;text-decoration:none}.page a:focus-visible{outline:3px solid #ea8c00;outline-offset:3px}@media(max-width:700px){.grid{grid-template-columns:1fr}.review{align-items:stretch;flex-direction:column}.review>a{text-align:center}}@media(max-width:390px){.page{padding:.75rem}.page header{padding:2rem 0}}@media(max-width:320px){.page{padding:.55rem}.grid a{padding:.85rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style>