---
import BaseLayout from'../../../../layouts/BaseLayout.astro';import Breadcrumbs from'../../../../components/Breadcrumbs.astro';import LearningSection from'../../../../components/LearningSection.astro';import Grade7Unit3Practice from'../../../../components/Grade7Unit3Practice.astro';import Grade7Unit6Check from'../../../../components/Grade7Unit6Check.astro';import Grade7Unit6Arcade from'../../../../components/Grade7Unit6Arcade.astro';import{findCourse}from'../../../../data/courses';import{grade7Unit6UnitCheckBank}from'../../../../data/grade7Unit6UnitCheck';import type{Unit6Question}from'../../../../data/grade7Unit6';
const course=findCourse('grade-7-math')!,base=import.meta.env.BASE_URL,slugs=['solving-equations','model-solving-equations','equations-involving-integers','solving-equations-algebraically','different-methods-equations'],names=['Trial, inspection, and verification','Balance and tile models','Signed equations and zero pairs','Algebraic inverse operations','Strategy selection and comparison'],concepts=['Verify in the original','Remove equally','Remove zero pairs','Plan from structure','Detect invalid methods'];
const make=(id:string,p:string,a:string,d:string[],lesson:number,anchor:number):Unit6Question=>{const choices=[a,...d],k=Number(id.replace(/\D/g,''))%4;return{id,prompt:p,choices:[...choices.slice(-k),...choices.slice(0,-k)],answer:k,feedback:`Correct: ${a}. The equation, equality move, solution, and substitution check agree.`,hint:`Identify every operation and quantity in “${p}”.`,hint2:'Preserve equality, isolate the variable, then substitute into the original equation.',category:`Lesson 6.${lesson+1}`,route:`../${slugs[lesson]}/#understand-${anchor}`}};
const finder=[['2x+3=17; guesses jump randomly','use systematic trial and compare whether each result is high or low',0],['3x+5=20; 5 is removed only on the left','remove 5 from both balance pans',1],['x+5=−2; all tiles are positive','represent −2 and use signed zero pairs',2],['5x−4=26; divide by 5 first without preserving the form','undo −4 on both sides before dividing',3],['2x+1=9; a correct answer follows invalid one-sided moves','reject the method and use a valid equality-preserving strategy',4]] as const;
const routeQuestions=finder.map((x,i)=>make(`rf6${i+1}`,`What repairs this work: ${x[0]}?`,x[1],['change the colours','erase the equal sign','accept the answer without checking'],x[2],2));
const equations=['2x+3=17','3x+5=20','x+5=−2','5x−4=26','2x+1=9','4x=28','x−6=−10','x/8=5','6x+12=54','12x+40=136','x−(−3)=8','7x=56','x+9=17','9x−5=58','x/7=6','3x+2=23','x−4=−9','5x−5=20','x/6=9','4x+7=31'];
const answers=[7,5,-7,6,4,7,-4,40,7,8,5,8,8,7,42,7,-5,5,54,6];const mixed=equations.map((e,i)=>make(`mr6${i+1}`,`Solve and verify ${e}.`,String(answers[i]),[String(answers[i]+1),String(answers[i]-1),String(-answers[i])],i%5,i%4+1));
const repairData=[['2x+3=17 becomes 2x=17−3 only on the left.','Subtract 3 from both sides and show the equivalent equation.'],['A trial table lists guesses but never evaluates either side.','Evaluate LHS and compare it with RHS for every trial.'],['A balance model omits the +5 in 3x+5=20.','Build all three x-groups and the five unit tiles.'],['A student removes 5 from just one pan.','Remove the same five units from both pans.'],['x+5=−2 is drawn with two positive tiles.','Represent the right side with two negative tiles.'],['A zero pair is two positive tiles.','A zero pair contains one positive and one negative tile.'],['5x−4=26 is divided by 5 before the −4 is undone.','Add 4 to both sides first, then divide by 5.'],['The line 7x=56 becomes x=49.','Divide both sides by 7 to obtain x=8.'],['Two methods are compared only by their final answers.','Compare their actual equality-preserving moves and checks.'],['x=7 is accepted without substitution.','Evaluate the original LHS at 7 and compare it with the RHS.']] as const;const repairs=repairData.map((x,i)=>make(`rp6${i+1}`,x[0],x[1],['change only one side','ignore the sign','skip verification'],i%5,i%4+1));
const transcripts=['Trial table: x=6 gives 15; x=7 gives 17, so x=7.','Balance: 3x+5=20 → 3x=15 → x=5.','Signed tiles: x+5=−2 → x=−7; −7+5=−2.','Algebra: 5x−4=26 → 5x=30 → x=6.','Inspection and algebra both give x=4 for 2x+1=9.'];
---
<BaseLayout title="Unit 6 Review & Equation Rescue | Grade 7 Math" description="Review equations and complete Equation Rescue." themeColor={course.color}><div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:'Equations',href:`${base}courses/grade-7-math/equations/`},{label:'Unit Review'}]}/><header class="hero"><p>GRADE 7 MATH · UNIT 6</p><h1>Review & <span>Equation Rescue</span></h1><p>Repair authentic misconceptions, revisit five accurate models, complete a balanced Unit Check, and synthesize the unit.</p></header>
<LearningSection id="route" eyebrow="QUICK ROUTE FINDER" title="Where should you begin?" icon="🧭" tone="idea"><div class="route" data-route>{routeQuestions.map((q,i)=><fieldset data-item data-answer={q.answer} data-station={`station-${i+1}`} data-label={`Lesson 6.${i+1} — ${concepts[i]}`}><legend>{q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`rf-${i}`} value={j}/>{c}</label>)}</fieldset>)}<button type="button" data-check>Build my route</button><p data-status role="status" tabindex="-1">Answer all five.</p></div></LearningSection>
<LearningSection id="stations" eyebrow="TARGETED REVIEW" title="Five model stations" icon="⚖️" tone="learn"><div class="stations">{transcripts.map((t,i)=><details id={`station-${i+1}`}><summary>Lesson 6.{i+1} · {names[i]}</summary><div class="model" role="img" aria-label={`Equation model transcript: ${t}`}><div class="balance" aria-hidden="true"><span>LHS</span><b>=</b><span>RHS</span></div><p><b>Model transcript:</b> {t}</p></div><a href={`../${slugs[i]}/#understand-2`}>Lesson 6.{i+1} — Understand: {concepts[i]}</a></details>)}</div></LearningSection>
<LearningSection id="practice" eyebrow="20 SUPPORTED QUESTIONS" title="Mixed review" icon="✏️" tone="practice"><Grade7Unit3Practice questions={mixed} lesson="unit-6-review"/></LearningSection><LearningSection id="repair" eyebrow="MISCONCEPTION REPAIR" title="Ten authentic repairs" icon="🛠️" tone="learn"><Grade7Unit3Practice questions={repairs} lesson="unit-6-repair"/></LearningSection><LearningSection id="check" eyebrow="INDEPENDENT UNIT CHECK" title="Can you connect the unit?" icon="✅" tone="review"><p>A separate 40-question bank creates ten-question attempts with two distinct questions from every lesson.</p><Grade7Unit6Check bank={grade7Unit6UnitCheckBank} lesson="unit-6-check" count={10} balancedUnit={true}/></LearningSection><LearningSection id="arcade" eyebrow="MATH ARCADE" title="Equation Rescue" icon="🎮" tone="play"><Grade7Unit6Arcade/></LearningSection><LearningSection id="finish" eyebrow="READY FOR WHAT'S NEXT?" title="Finish Unit 6" icon="🏁" tone="review"><p>You are ready when you can represent, solve, verify, and compare methods while preserving equality.</p><span class="coming" aria-disabled="true">Unit 7 · next approved destination (coming later)</span></LearningSection></div></BaseLayout>
<script>document.querySelectorAll<HTMLElement>('[data-route]').forEach(r=>{const out=r.querySelector<HTMLElement>('[data-status]');r.querySelector('[data-check]')?.addEventListener('click',()=>{const items=[...r.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){if(out)out.textContent='Answer all five first.';missing.querySelector<HTMLInputElement>('input')?.focus();return}const missed=items.filter(x=>Number(x.querySelector<HTMLInputElement>('input:checked')?.value)!==Number(x.dataset.answer));if(out){out.innerHTML=missed.length?`<strong>Begin with:</strong> ${missed.map(x=>`<a href="#${x.dataset.station}">${x.dataset.label}</a>`).join(' ')}`:'<strong>All five strands secure.</strong> Begin mixed review.';out.focus()}})})</script>
<style>.hero{padding:2rem 0}.hero h1{font-size:clamp(2.4rem,7vw,5rem);line-height:.95}.hero span{color:var(--course)}.route,.stations{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.route fieldset,.stations details{padding:.8rem;border:1px solid #dce4ed;border-radius:12px;background:#fff}.route label{display:flex;gap:.45rem;min-height:44px;align-items:center}.route button{min-height:44px;border:0;border-radius:8px;background:var(--course);color:#fff;padding:.65rem;font-weight:800}.route [data-status]{grid-column:1/-1}.model{padding:.7rem;background:#eef5ff}.balance{display:grid;grid-template-columns:1fr 50px 1fr;align-items:center;text-align:center;min-height:60px;border:2px solid #24415f}.coming{display:inline-flex;padding:.7rem;background:#e8edf4}@media(max-width:700px){.route,.stations{grid-template-columns:1fr}.route [data-status]{grid-column:1}}@media(max-width:390px){.route,.stations{overflow-wrap:anywhere}.model{overflow-x:auto}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style>
