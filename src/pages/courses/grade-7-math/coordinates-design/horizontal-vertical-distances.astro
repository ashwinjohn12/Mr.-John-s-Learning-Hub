---
import Grade7RebuildLessonFrame from '../../../../components/Grade7RebuildLessonFrame.astro';
import LearningSection from '../../../../components/LearningSection.astro';
import VocabularyExplorer from '../../../../components/VocabularyExplorer.astro';
import Grade7CoordinateGrid from '../../../../components/Grade7CoordinateGrid.astro';
import Grade7GridNavigator from '../../../../components/Grade7GridNavigator.astro';
import Grade7DistanceCheck from '../../../../components/Grade7DistanceCheck.astro';
const title='Horizontal and Vertical Distances';
const summary='Describe horizontal and vertical positional change, determine horizontal or vertical distance, and track corresponding vertices through successive transformations.';
const vocabulary=[
 {term:'horizontal movement',definition:'A left or right change in position, described with both an amount and a direction.',example:'From x = −4 to x = 2 is 6 units right.'},
 {term:'vertical movement',definition:'An up or down change in position, described with both an amount and a direction.',example:'From y = 5 to y = −1 is 6 units down.'},
 {term:'horizontal distance',definition:'The non-negative number of horizontal units between two points.',example:'The horizontal distance from x = −4 to x = 2 is 6 units.'},
 {term:'vertical distance',definition:'The non-negative number of vertical units between two points.',example:'The vertical distance from y = 5 to y = −1 is 6 units.'},
 {term:'positional change',definition:'How a point or vertex moves horizontally and vertically from one position to another.',example:'A moved 7 right and 3 down.'},
 {term:'corresponding vertices',definition:'Vertices that match before and after a transformation.',example:'A corresponds to A′ and then A″.'},
 {term:'successive transformations',definition:'Two or more transformations performed one after another.',example:'A reflection followed by a translation.'},
 {term:'double prime',definition:'The notation used for the image of a point after a second transformation.',example:'A″ is read “A double prime.”'},
 {term:'net movement',definition:'The overall directional change from the starting point to the finishing point.',example:'A detour can still have a net movement of 7 units right.'},
 {term:'distance travelled',definition:'The total non-negative amount moved along a direction, including any backtracking.',example:'8 right, 3 left, then 2 right travels 13 horizontal units.'}
];
const practice=[
 {level:'A · Movement',prompt:'Point P moves from (−5, 3) to (2, 3). What is the horizontal movement?',choices:['7 units right','7 units left','2 units right','5 units right'],answer:0,feedback:'Compare x-coordinates: −5 to 2 is 7 units right. The y-coordinate does not change.'},
 {level:'B · Distance',prompt:'What is the horizontal distance between (−5, 3) and (2, 3)?',choices:['−7 units','7 units','2 units','5 units'],answer:1,feedback:'Distance is a non-negative magnitude, so the horizontal distance is 7 units.'},
 {level:'C · Cross Zero',prompt:'A moves from (4, −6) to (−3, 2). Describe the net positional change.',choices:['7 left; 8 up','7 right; 8 down','3 left; 2 up','1 left; 4 up'],answer:0,feedback:'x changes from 4 to −3: 7 left. y changes from −6 to 2: 8 up.'},
 {level:'D · Correspondence',prompt:'A(−2, 5) becomes A″(4, −1). Which comparison answers the question?',choices:['Compare A with any image vertex','Compare A directly with A″','Compare only A′ with A″','Compare the centres of the shapes'],answer:1,feedback:'Correspondence matters: compare original A with its final image A″.'},
 {level:'E · Successive Images',prompt:'A → A′ → A″ is (−4, 2) → (3, 2) → (1, −5). What is the net change from A to A″?',choices:['5 right; 7 down','7 right; 0 vertical','2 left; 7 down','5 left; 7 up'],answer:0,feedback:'Ignore the route when finding final positional change: compare (−4, 2) directly with (1, −5).'},
 {level:'F · Movement vs Distance',prompt:'Which statement uses the word distance correctly?',choices:['The distance is 6 units left.','The horizontal distance is 6 units.','The distance is −6 units.','The vertical distance tells whether to move left or right.'],answer:1,feedback:'Distance tells how far and is non-negative. Direction belongs to a movement description.'},
 {level:'G · Route Reasoning',prompt:'A route goes 8 right, 3 left, then 2 right. What are the horizontal distance travelled and net movement?',choices:['13 units travelled; 7 units right net','7 units travelled; 13 units right net','13 units travelled; 13 units right net','7 units travelled; 7 units left net'],answer:0,feedback:'Distance adds 8 + 3 + 2 = 13. Net movement combines direction: 8 − 3 + 2 = 7 right.'},
 {level:'H · Same Finish',prompt:'Two transformation sequences start and finish at the same coordinates. What must be the same?',choices:['Their number of steps','Their total horizontal and vertical distances travelled','Their net horizontal and vertical positional change','Their transformation types'],answer:2,feedback:'Start and finish determine net positional change. A detour can change total distance travelled.'}
];
---
<Grade7RebuildLessonFrame {title} {summary} lesson="1.4" unitTitle="Unit 1 · Coordinates and Design">
 <LearningSection id="overview" eyebrow="GET READY" title="How far—and which way?" icon="🎯" tone="idea">
  <div class="two-grid"><article><p class="mini-label">BRING FORWARD FROM 1.3</p><ul><li>Track original and image vertices using A, A′, A″.</li><li>Use translations, reflections, and rotations as known motions.</li><li>Read every ordered pair x first, then y.</li><li>Keep corresponding vertices matched.</li></ul></article><article><p class="mini-label">BY THE END, I CAN…</p><ul><li>describe horizontal and vertical movement between points;</li><li>determine horizontal or vertical distance;</li><li>describe the positional change of corresponding vertices;</li><li>compare different routes that reach the same final location.</li></ul></article></div>
  <p class="curriculum"><strong>Alberta Grade 7 · Shape & Space SS5:</strong> Lesson 1.4 develops the remaining movement-and-distance indicators: describe the horizontal and vertical movement required to move from one point to another; describe the positional change from vertices to corresponding image vertices after a transformation or successive transformations; and determine distance between points along horizontal and vertical lines. Performing transformations and identifying image coordinates were developed in Lesson 1.3 and are used here only as prior knowledge.</p>
  <div class="readiness"><strong>Quick start:</strong><span>Point A moves from (−4, 3) to (2, 3). The movement is <strong>6 units right</strong>. The horizontal distance is <strong>6 units</strong>. Why does only one statement include a direction?</span><details><summary>Check</summary><p><strong>Movement includes direction.</strong> Distance describes how far and is non-negative.</p></details></div>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="Movement and distance answer different questions" icon="🌎" tone="idea">
  <p class="big-statement">Compare <strong>x with x</strong> for horizontal change and <strong>y with y</strong> for vertical change.</p>
  <div class="idea-grid"><article><h3>Movement = amount + direction</h3><p><strong>6 units left</strong> tells both how far and which way the point changed position.</p></article><article><h3>Distance = how far</h3><p><strong>6 units</strong> is a non-negative magnitude. Distance itself is not “negative 6.”</p></article><article><h3>Correspondence matters</h3><p>Track A → A′ → A″. Compare each original vertex with its own image—not whichever point happens to be closest.</p></article><article><h3>Same finish, different route</h3><p>Two routes can have the same net movement but different total horizontal or vertical distance travelled because one route may backtrack.</p></article></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="A reliable horizontal–vertical routine" icon="📘" tone="learn">
  <div class="understand-cards">
   <details open><summary>1. Start and finish: read coordinates carefully</summary><p>Write the starting point and finishing point. Keep the order <strong>(x, y)</strong>. The x-values tell the horizontal story; the y-values tell the vertical story.</p><p class="memory"><strong>Routine:</strong> x → horizontal, y → vertical.</p></details>
   <details><summary>2. Describe horizontal movement</summary><p>Compare the starting x-coordinate with the finishing x-coordinate. State the number of units and a direction: <strong>right</strong> if the final x-value is greater, <strong>left</strong> if it is smaller, and no horizontal movement if they match.</p><p class="mistake"><strong>Common error:</strong> using the sign of the final coordinate as the direction. Crossing zero does not change the routine.</p></details>
   <details><summary>3. Describe vertical movement</summary><p>Compare the starting y-coordinate with the finishing y-coordinate. State the number of units and <strong>up</strong> or <strong>down</strong>. If the y-values match, the vertical movement is 0 units.</p></details>
   <details><summary>4. Determine horizontal or vertical distance</summary><p>If two points lie on the same horizontal line, compare their x-coordinates to find the horizontal distance. If two points lie on the same vertical line, compare their y-coordinates to find the vertical distance. Report a <strong>non-negative number of units</strong>.</p><p class="memory"><strong>Movement:</strong> 6 units left. <strong>Distance:</strong> 6 units.</p></details>
   <details><summary>5. Track corresponding vertices through successive transformations</summary><p>After one transformation, A becomes A′. After a second transformation, A′ becomes A″. To describe the overall positional change, compare the original A with the final A″. Repeat for B → B′ → B″ and every other corresponding vertex.</p></details>
   <details><summary>6. Separate net movement from distance travelled</summary><p>Net movement compares only the starting and finishing positions. Total distance travelled adds the non-negative horizontal or vertical amount from <strong>every step</strong>. If a route backtracks, total distance travelled can be larger than the net movement.</p><p class="mistake"><strong>Scope boundary:</strong> this lesson does not calculate diagonal distance, slope, vector magnitude, or Pythagorean distance.</p></details>
  </div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <div class="example-grid">
   <article><h3>Example 1 · Same horizontal line</h3><p>P(−6, 3) and Q(4, 3) share y = 3.</p><Grade7CoordinateGrid mode="static" scale={1} points={[{x:-6,y:3,label:'P'},{x:4,y:3,label:'Q'}]} title="Horizontal distance example"/><p>Movement P → Q: <strong>10 units right</strong>. Horizontal distance: <strong>10 units</strong>.</p></article>
   <article><h3>Example 2 · Cross zero in both directions</h3><p>A(5, −4) becomes A′(−2, 3).</p><Grade7CoordinateGrid mode="static" scale={1} points={[{x:5,y:-4,label:'A'},{x:-2,y:3,label:'A′'}]} title="Cross-zero positional change"/><p>x: 5 → −2 gives <strong>7 left</strong>. y: −4 → 3 gives <strong>7 up</strong>. Horizontal and vertical distances are each 7 units.</p></article>
   <article><h3>Example 3 · Successive images</h3><p>A → A′ → A″: (−4, 2) → (3, 2) → (1, −5).</p><p>Step 1: 7 right, 0 vertical. Step 2: 2 left, 7 down. Overall A → A″: <strong>5 right and 7 down</strong>. Horizontal distance travelled along the route is 9 units, while the net horizontal movement is only 5 units right.</p></article>
   <article><h3>Example 4 · Corresponding vertices can change differently</h3><p>After a rotation followed by a translation, A → A″ may move 4 left and 6 up while B → B″ moves 4 left and 12 up. A transformation sequence acts on the whole shape, but different original vertices can have different overall positional changes.</p></article>
   <article><h3>Example 5 · Same finish, two routes</h3><p>Route A and Route B both start at (−5, 4) and finish at (4, −3). Both therefore have the same net change: <strong>9 right, 7 down</strong>. If Route B detours farther before returning, its total distance travelled can be larger.</p></article>
  </div>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Movement and distance vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={vocabulary}/></LearningSection>

 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Grid Navigator" icon="🔬" tone="explore">
  <p>Run more than one transformation route to the same final point. Track A → A′ → A″, compare the start and finish, and then compare the total horizontal and vertical distance travelled along each route.</p>
  <Grade7GridNavigator title="Choose a route, track the coordinates, report the change"/>
  <div class="discovery"><h3>What to notice</h3><ol><li>Use the transformation steps only to create successive positions.</li><li>For <strong>net positional change</strong>, compare the start directly with the finish.</li><li>For <strong>distance travelled</strong>, add each non-negative step amount.</li><li>Try both routes in each mission. Decide what stays the same and what can change.</li></ol></div>
 </LearningSection>

 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build movement-and-distance fluency" icon="✏️" tone="practice">
  <p>Work from direct movement to distance, correspondence, successive images, and route reasoning. Each item gives immediate repair feedback.</p>
  <div class="practice-stack" data-distance-practice>{practice.map((item,i)=><fieldset data-item data-answer={item.answer} data-feedback={item.feedback}><legend><span>{item.level}</span>{item.prompt}</legend><div class="practice-choices">{item.choices.map((c,j)=><label><input type="radio" name={`distance-practice-${i}`} value={j}/>{c}</label>)}</div><button type="button" data-check>Check</button><p data-status role="status">Choose an answer.</p></fieldset>)}</div>
 </LearningSection>

 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you describe movement and distance independently?" icon="✅" tone="review">
  <p>The bank mixes movement, horizontal/vertical distance, corresponding vertices, successive transformations, route comparison, and reverse reasoning. Diagonal distance and higher-grade coordinate methods are intentionally excluded.</p><Grade7DistanceCheck/>
 </LearningSection>

 <LearningSection id="apply" eyebrow="PLAY & APPLY" title="Emergency Dispatcher · Grid Route Mission" icon="🚓" tone="play">
  <div class="dispatcher" data-dispatcher>
   <div class="dispatch-head"><div><p class="mini-label">AUTHENTIC ROUTE DECISION</p><h3>Send the best available car</h3></div><span>Roads follow grid lines</span></div>
   <p>The accident is at <strong>(6, 4)</strong>. The river is the y-axis. Any car west of the river must cross at the only open bridge, <strong>(0, 1)</strong>. Cars may travel only horizontally or vertically.</p>
   <div class="dispatch-grid">
    <div class="dispatch-map" role="img" aria-label="Dispatcher map: accident at 6,4; bridge at 0,1; Car A at negative 6, negative 4; Car B at negative 3,2; Car C at 9, negative 8.">
     <svg viewBox="0 0 520 520"><rect x="40" y="40" width="440" height="440" rx="12" fill="#f8fbff" stroke="#b9c8da" stroke-width="2"/><path d="M40 260H480M260 40V480" stroke="#1d3557" stroke-width="3"/><path d="M260 40V480" stroke="#2b6cb0" stroke-width="12" opacity=".25"/><g fill="#2457c5" font-family="system-ui" font-weight="900"><circle cx="128" cy="348" r="10"/><text x="142" y="344">A (−6, −4)</text><circle cx="194" cy="216" r="10"/><text x="208" y="212">B (−3, 2)</text><circle cx="458" cy="436" r="10"/><text x="330" y="462">C (9, −8)</text></g><g fill="#b76e00" font-family="system-ui" font-weight="900"><circle cx="392" cy="172" r="11"/><text x="334" y="151">Accident (6, 4)</text></g><g fill="#6d28d9" font-family="system-ui" font-weight="900"><rect x="248" y="228" width="24" height="16" rx="3"/><text x="278" y="241">Bridge (0, 1)</text></g></svg>
    </div>
    <div class="dispatch-controls"><fieldset><legend>Which car should you send?</legend><label><input type="radio" name="dispatch-car" value="A"/>Car A</label><label><input type="radio" name="dispatch-car" value="B"/>Car B</label><label><input type="radio" name="dispatch-car" value="C"/>Car C</label></fieldset><button type="button" data-check-dispatch>Check route decision</button><p data-dispatch-status role="status">Compare legal horizontal and vertical route distances before deciding.</p><div data-dispatch-evidence hidden><h4>Route evidence</h4><table><thead><tr><th>Car</th><th>Legal route</th><th>Total grid distance</th><th>Net movement</th></tr></thead><tbody><tr><th>A</th><td>via bridge: 12 horizontal + 8 vertical</td><td>20 units</td><td>12 right, 8 up</td></tr><tr><th>B</th><td>via bridge: 9 horizontal + 4 vertical</td><td>13 units</td><td>9 right, 2 up</td></tr><tr><th>C</th><td>same side: 3 horizontal + 12 vertical</td><td>15 units</td><td>3 left, 12 up</td></tr></tbody></table><p><strong>Precise dispatch directions for B:</strong> move 3 units right and 1 unit down to the bridge; then move 6 units right and 3 units up to the accident. The route travels 9 horizontal units and 4 vertical units, but the net movement from B to the accident is 9 right and 2 up.</p></div></div>
   </div>
  </div>
 </LearningSection>

 <LearningSection id="review" eyebrow="WRAP UP" title="Unit 1 instructional lessons complete" icon="🏁" tone="review">
  <div class="two-grid"><article><h3>I can retrieve…</h3><ul><li>x controls horizontal change</li><li>y controls vertical change</li><li>movement includes direction</li><li>distance is non-negative</li><li>A → A′ → A″ preserves correspondence</li></ul></article><article><h3>I can demonstrate…</h3><ul><li>horizontal and vertical movement between points</li><li>horizontal or vertical distance on aligned points</li><li>overall vertex change after successive transformations</li><li>why two routes can share a finish but travel different distances</li></ul></article></div>
  <div class="exit-ticket" data-distance-exit><h3>Three-question readiness check</h3>
   <fieldset data-answer="1"><legend>1. From (5, 2) to (−3, 2), what is the horizontal distance?</legend><label><input type="radio" name="exit-d1" value="0"/>−8 units</label><label><input type="radio" name="exit-d1" value="1"/>8 units</label><label><input type="radio" name="exit-d1" value="2"/>3 units</label></fieldset>
   <fieldset data-answer="2"><legend>2. A(−4, −1) becomes A″(2, 5). What is the net positional change?</legend><label><input type="radio" name="exit-d2" value="0"/>2 right, 5 up</label><label><input type="radio" name="exit-d2" value="1"/>6 left, 6 down</label><label><input type="radio" name="exit-d2" value="2"/>6 right, 6 up</label></fieldset>
   <fieldset data-answer="0"><legend>3. Two routes have the same start and finish. What must match?</legend><label><input type="radio" name="exit-d3" value="0"/>Net horizontal and vertical positional change</label><label><input type="radio" name="exit-d3" value="1"/>Total distance travelled</label><label><input type="radio" name="exit-d3" value="2"/>Number of transformations</label></fieldset>
   <button type="button" data-submit>Check readiness</button><p data-status role="status">Complete all three.</p>
  </div>
  <div class="unit-ready"><strong>Four instructional lessons verified in sequence:</strong><span>1.1 The Cartesian Plane → 1.2 Create Designs → 1.3 Transformations → 1.4 Horizontal and Vertical Distances.</span><p><strong>Next:</strong> Unit 1 Review, independent Unit Check, and Math Arcade. This lesson does not build those resources yet.</p></div>
 </LearningSection>
</Grade7RebuildLessonFrame>
<script>
document.querySelectorAll<HTMLElement>('[data-distance-practice]').forEach(root=>root.querySelectorAll<HTMLElement>('[data-item]').forEach(item=>item.querySelector('[data-check]')?.addEventListener('click',()=>{const chosen=item.querySelector<HTMLInputElement>('input:checked'),status=item.querySelector<HTMLElement>('[data-status]')!;if(!chosen){status.textContent='Choose an answer first.';return}const ok=Number(chosen.value)===Number(item.dataset.answer);status.textContent=ok?`Correct. ${item.dataset.feedback}`:`Repair: ${item.dataset.feedback}`})));
document.querySelectorAll<HTMLElement>('[data-dispatcher]').forEach(root=>root.querySelector('[data-check-dispatch]')?.addEventListener('click',()=>{const chosen=root.querySelector<HTMLInputElement>('input[name="dispatch-car"]:checked'),status=root.querySelector<HTMLElement>('[data-dispatch-status]')!,evidence=root.querySelector<HTMLElement>('[data-dispatch-evidence]')!;if(!chosen){status.textContent='Choose a car before checking.';return}evidence.hidden=false;status.textContent=chosen.value==='B'?'Correct. Car B has the shortest legal grid route: 13 units total.':'Repair: account for the bridge constraint and add horizontal plus vertical route distance. Car B has the shortest legal route.'}));
document.querySelectorAll<HTMLElement>('[data-distance-exit]').forEach(root=>root.querySelector('[data-submit]')?.addEventListener('click',()=>{const sets=[...root.querySelectorAll<HTMLElement>('fieldset')],missing=sets.find(x=>!x.querySelector('input:checked')),status=root.querySelector<HTMLElement>('[data-status]')!;if(missing){status.textContent='Complete all three questions.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;sets.forEach(s=>{if(Number(s.querySelector<HTMLInputElement>('input:checked')!.value)===Number(s.dataset.answer))score++});status.textContent=`${score}/3. ${score===3?'Ready for the Unit 1 Review.':score===2?'Nearly ready—repair the missed idea, then retry.':'Revisit Understand and Explore before the Unit 1 Review.'}`}));
</script>
<style>
.two-grid,.idea-grid,.example-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.two-grid article,.idea-grid article,.example-grid article{padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.curriculum,.readiness,.discovery,.unit-ready{padding:1rem;border-radius:14px;background:#eef6ff}.readiness{display:grid;gap:.5rem;background:#fff7d6}.big-statement{font-size:1.15rem}.understand-cards{display:grid;gap:.65rem}.understand-cards details{border:1px solid #d7e1ee;border-radius:12px;padding:.8rem;background:#fff}.understand-cards summary{font-weight:850;cursor:pointer}.memory,.mistake{padding:.65rem;border-radius:9px;background:#eef6ff}.mistake{background:#fff1f0}.practice-stack{display:grid;gap:.8rem}.practice-stack fieldset,.exit-ticket fieldset,.dispatch-controls fieldset{margin:0;padding:1rem;border:1px solid #d7e1ee;border-radius:12px}.practice-stack legend,.exit-ticket legend,.dispatch-controls legend{font-weight:850}.practice-stack legend span{display:block;color:#5a6a80;font-size:.78rem}.practice-choices,.exit-ticket fieldset,.dispatch-controls fieldset{display:grid;gap:.45rem}.practice-choices label,.exit-ticket label,.dispatch-controls label{display:flex;align-items:center;gap:.5rem;min-height:44px}.practice-stack button,.exit-ticket button,.dispatch-controls button{min-height:44px;border:0;border-radius:9px;padding:.6rem .8rem;background:#2457c5;color:#fff;font-weight:850;cursor:pointer}.practice-stack button:focus-visible,.exit-ticket button:focus-visible,.dispatch-controls button:focus-visible,input:focus-visible{outline:3px solid #ffbf47;outline-offset:2px}.practice-stack [data-status],.exit-ticket [data-status],.dispatch-controls [data-dispatch-status]{padding:.6rem;border-radius:9px;background:#eef6ff}.dispatcher{border:1px solid #d7e1ee;border-radius:18px;padding:1rem;background:#fff}.dispatch-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.dispatch-head h3{margin:.1rem 0}.dispatch-head span{padding:.4rem .65rem;border-radius:999px;background:#eef6ff;font-weight:800}.dispatch-grid{display:grid;grid-template-columns:minmax(320px,1.1fr) minmax(280px,.9fr);gap:1rem}.dispatch-map svg{display:block;width:100%;aspect-ratio:1;border-radius:14px}.dispatch-controls{display:grid;gap:.7rem}.dispatch-controls [data-dispatch-evidence]{overflow-x:auto;padding:.8rem;border-radius:12px;background:#fff7d6}.dispatch-controls table{width:100%;border-collapse:collapse}.dispatch-controls th,.dispatch-controls td{padding:.45rem;text-align:left;border-bottom:1px solid #e4d9a8}.exit-ticket{display:grid;gap:.75rem;margin-top:1rem}.unit-ready{display:grid;gap:.35rem;margin-top:1rem}.unit-ready p{margin:.25rem 0 0}@media(max-width:760px){.two-grid,.idea-grid,.example-grid,.dispatch-grid{grid-template-columns:1fr}.dispatch-head{display:grid}.dispatch-head span{justify-self:start}}@media(max-width:390px){.dispatcher{padding:.72rem}.two-grid article,.idea-grid article,.example-grid article{padding:.8rem}.dispatch-controls th,.dispatch-controls td{font-size:.88rem;padding:.35rem}}
</style>