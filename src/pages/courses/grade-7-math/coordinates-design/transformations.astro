---
import Grade7RebuildLessonFrame from '../../../../components/Grade7RebuildLessonFrame.astro';
import LearningSection from '../../../../components/LearningSection.astro';
import VocabularyExplorer from '../../../../components/VocabularyExplorer.astro';
import Grade7CoordinateGrid from '../../../../components/Grade7CoordinateGrid.astro';
import Grade7TransformationLab from '../../../../components/Grade7TransformationLab.astro';
import Grade7TransformationCheck from '../../../../components/Grade7TransformationCheck.astro';
const title='Transformations';
const summary='Translate, reflect, and rotate 2-D shapes on the Cartesian plane, then describe each image precisely using integral vertex coordinates.';
const vocabulary=[
 {term:'transformation',definition:'A movement that changes the position or orientation of a geometric figure.',example:'Translations, reflections, and rotations are transformations.'},
 {term:'translation',definition:'A slide along a straight path.',example:'Move every vertex 4 units left and 2 units up.'},
 {term:'reflection',definition:'A mirror image created across a line of reflection.',example:'A point and its image are equal perpendicular distances from the mirror line.'},
 {term:'line of reflection',definition:'The mirror line used to create a reflection image.',example:'The y-axis can be a line of reflection.'},
 {term:'rotation',definition:'A turn around a fixed point.',example:'Rotate a triangle 90° clockwise.'},
 {term:'centre of rotation',definition:'The fixed point about which a figure turns.',example:'A rotation may use the origin or another integral point as its centre.'},
 {term:'clockwise',definition:'The direction the hands of a clock turn.',example:'A 90° clockwise rotation is a quarter-turn to the right.'},
 {term:'counterclockwise',definition:'The direction opposite the hands of a clock.',example:'A 90° counterclockwise rotation is a quarter-turn to the left.'},
 {term:'image',definition:'The figure after a transformation.',example:'A′B′C′ is the image of ABC.'},
 {term:'prime notation',definition:'A mark used to label a transformed point or vertex.',example:'A becomes A′ after one transformation.'}
];
const practice=[
 {level:'A · Identify',prompt:'Which transformation is a slide?',choices:['Translation','Reflection','Rotation','Scale change'],answer:0,feedback:'A translation slides a figure without changing its size or shape.'},
 {level:'B · Translate',prompt:'A(−3, 4) is translated 5 units right and 2 units down. Where is A′?',choices:['(2, 2)','(−8, 2)','(2, 6)','(1, −1)'],answer:0,feedback:'Apply the same translation to the point: −3 + 5 = 2 and 4 − 2 = 2.'},
 {level:'C · Reflect',prompt:'P(4, −3) is reflected in the y-axis. Where is P′?',choices:['(4, 3)','(−4, −3)','(−3, 4)','(3, −4)'],answer:1,feedback:'A y-axis reflection keeps the vertical position while placing the point the same perpendicular distance on the other side.'},
 {level:'D · Rotation Language',prompt:'Which description is precise enough for a rotation?',choices:['Turn it','Rotate 90°','Rotate 90° clockwise about (0, 0)','Move it around the origin'],answer:2,feedback:'A precise rotation needs a centre, angle, and direction.'},
 {level:'E · Reflection Check',prompt:'What must be true for a correct reflection?',choices:['The image must be in Quadrant I','Corresponding points are equal perpendicular distances from the reflection line','All signs change','The image is larger'],answer:1,feedback:'Equal perpendicular distance from the mirror line is the key reflection check.'},
 {level:'F · Prime Notation',prompt:'What does B′ represent?',choices:['The original point B','The transformed image of B','The centre of rotation','A second coordinate axis'],answer:1,feedback:'Prime notation identifies the image corresponding to the original vertex.'},
 {level:'G · Error Repair',prompt:'A student translates one vertex 4 right, 2 up but another vertex 3 right, 2 up. What is wrong?',choices:['Nothing','Each vertex must move the same distance and direction','Translations require a centre','The shape should be reflected instead'],answer:1,feedback:'Every point in one translation follows the same slide.'},
 {level:'H · Verify',prompt:'What is the strongest way to check a transformed polygon?',choices:['Check one vertex only','Judge the picture by eye','Check every corresponding vertex against the transformation description','Count how many quadrants are used'],answer:2,feedback:'A transformation applies consistently to every vertex, so verify all corresponding pairs.'}
];
---
<Grade7RebuildLessonFrame {title} {summary} lesson="1.3" unitTitle="Unit 1 · Coordinates and Design">
 <LearningSection id="overview" eyebrow="GET READY" title="Move an entire design precisely" icon="🎯" tone="idea">
  <div class="two-grid"><article><p class="mini-label">BRING FORWARD FROM 1.2</p><ul><li>Plot and label integral-coordinate vertices.</li><li>Read coordinates x first, then y.</li><li>Connect corresponding vertices carefully.</li><li>Use labels to communicate a design precisely.</li></ul></article><article><p class="mini-label">BY THE END, I CAN…</p><ul><li>translate, reflect, and rotate a 2-D shape;</li><li>identify the coordinates of image vertices;</li><li>describe a transformation precisely;</li><li>check whether an image fits the stated transformation.</li></ul></article></div>
  <p class="curriculum"><strong>Alberta Grade 7 · Shape & Space SS5:</strong> Lesson 1.3 focuses on performing and describing translations, reflections, and rotations of 2-D shapes with integral-coordinate vertices, then identifying and describing the image by its vertex coordinates. Horizontal/vertical movement and distance analysis are intentionally reserved for Lesson 1.4.</p>
  <div class="readiness"><strong>Quick start:</strong><span>Triangle ABC has vertices A(−4, 1), B(−1, 4), C(2, 1). If every vertex slides 3 units right, what kind of transformation is happening?</span><details><summary>Check</summary><p><strong>A translation.</strong> Every point follows the same slide.</p></details></div>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="Three motions, one coordinate language" icon="🌎" tone="idea">
  <p class="big-statement">A transformation changes a figure's <strong>position or orientation</strong> while keeping corresponding vertices connected to the same figure.</p>
  <div class="idea-grid"><article><h3>Translation = slide</h3><p>Every vertex moves the same amount in the same directions.</p></article><article><h3>Reflection = mirror</h3><p>Each image point lands on the opposite side of a line of reflection at the same perpendicular distance.</p></article><article><h3>Rotation = turn</h3><p>Every vertex turns through the same angle around one fixed centre of rotation.</p></article><article><h3>Coordinates verify the image</h3><p>Prime-labelled vertices such as A′, B′, C′ let us match each image point to its original point.</p></article></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="How to perform and describe transformations" icon="📘" tone="learn">
  <div class="understand-cards">
   <details open><summary>1. Original figure and image</summary><p>Start with the original vertices A, B, C. After one transformation, the matching image vertices are labelled <strong>A′, B′, C′</strong>, read “A prime,” “B prime,” and “C prime.” The labels show correspondence: A ↔ A′, B ↔ B′, C ↔ C′.</p><p class="memory"><strong>Do not relabel randomly:</strong> A′ must be the image of A.</p></details>
   <details><summary>2. Translation: every point follows the same slide</summary><p>A translation is described by how far the whole figure slides left/right and up/down. Apply that exact slide to <strong>every</strong> vertex, plot the prime points, then reconnect them in the original vertex order.</p><p class="mistake"><strong>Common error:</strong> moving different vertices different amounts changes the figure instead of translating it.</p></details>
   <details><summary>3. Reflection: use the mirror line</summary><p>For each original vertex, measure the shortest path to the line of reflection. That path is perpendicular to the line. Plot the image vertex the same perpendicular distance on the opposite side, then reconnect corresponding image vertices.</p><p class="memory"><strong>Reflection check:</strong> original point → mirror line → image point forms a perpendicular path with equal distance on both sides.</p></details>
   <details><summary>4. Rotation: centre + angle + direction</summary><p>A rotation turns the figure around a fixed <strong>centre of rotation</strong>. A complete description includes the centre, the angle, and whether the turn is clockwise or counterclockwise. Common quarter-turn angles are 90°, 180°, and 270°.</p><p class="mistake"><strong>Common error:</strong> assuming every rotation is about the origin. Use the centre that is actually given.</p></details>
   <details><summary>5. Verify the image with coordinates</summary><p>After transforming, list the coordinates of A′, B′, C′ and compare each image vertex with the transformation description. The whole shape should still have the same side lengths and angle sizes.</p></details>
   <details><summary>6. Successive transformations</summary><p>A figure can undergo more than one transformation. Finish the first image accurately before using it as the starting figure for the next transformation. Keep the transformation descriptions separate and preserve vertex correspondence throughout.</p><p class="memory"><strong>Scope note:</strong> today we track the image coordinates and transformation sequence. Lesson 1.4 will analyze horizontal and vertical changes between positions.</p></details>
  </div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <div class="example-grid">
   <article><h3>Example 1 · Translation</h3><p>Start with A(−4, 1), B(−1, 4), C(2, 1). Translate <strong>5 units right and 3 units down</strong>.</p><Grade7CoordinateGrid mode="static" scale={1} points={[{x:1,y:-2,label:'A′'},{x:4,y:1,label:'B′'},{x:7,y:-2,label:'C′'}]} title="Translation image vertices"/><p>Image coordinates: <strong>A′(1, −2), B′(4, 1), C′(7, −2)</strong>. Each vertex followed the same slide.</p></article>
   <article><h3>Example 2 · Reflection</h3><p>Reflect P(−5, 3), Q(−2, 6), R(−1, 2) across the <strong>y-axis</strong>.</p><Grade7CoordinateGrid mode="static" scale={1} points={[{x:5,y:3,label:'P′'},{x:2,y:6,label:'Q′'},{x:1,y:2,label:'R′'}]} title="Reflection image across the y-axis"/><p>Each image point is the same perpendicular distance from the y-axis on the opposite side.</p></article>
   <article><h3>Example 3 · Rotation</h3><p>Rotate triangle JKL with J(2, 1), K(5, 1), L(5, 4) <strong>90° counterclockwise about (0, 0)</strong>.</p><Grade7CoordinateGrid mode="static" scale={1} points={[{x:-1,y:2,label:'J′'},{x:-1,y:5,label:'K′'},{x:-4,y:5,label:'L′'}]} title="Rotation image about the origin"/><p>The centre, angle, and direction fully describe the turn.</p></article>
   <article><h3>Example 4 · Identify the transformation</h3><p>If every original vertex has an image directly across the line x = 2 at the same perpendicular distance, the transformation is a <strong>reflection in x = 2</strong>. Coordinates provide the evidence; the picture alone is not enough.</p></article>
  </div>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key transformation vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={vocabulary}/></LearningSection>

 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Transformation Lab" icon="🔬" tone="explore">
  <p>Change the transformation settings and predict the image before revealing it. Compare original and image coordinates, then use the generated description to check your mathematical language.</p>
  <Grade7TransformationLab mode="explore" title="Predict, transform, explain"/>
  <div class="discovery"><h3>Investigate deliberately</h3><ol><li>Try the same triangle under all three transformation types.</li><li>For reflections, change the mirror line from vertical to horizontal.</li><li>For rotations, compare 90°, 180°, and 270° and move the centre away from the origin.</li><li>For every image, identify which vertex corresponds to A, B, and C.</li></ol><p><strong>Key conclusion:</strong> the transformation description must explain how the whole figure moves, not just where one point ends.</p></div>
 </LearningSection>

 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build transformation fluency" icon="✏️" tone="practice">
  <p>Work from identification to coordinate images to reasoning. Each question provides immediate repair feedback.</p>
  <div class="practice-stack" data-transform-practice>{practice.map((item,i)=><fieldset data-item data-answer={item.answer} data-feedback={item.feedback}><legend><span>{item.level}</span>{item.prompt}</legend><div class="practice-choices">{item.choices.map((c,j)=><label><input type="radio" name={`transform-practice-${i}`} value={j}/>{c}</label>)}</div><button type="button" data-check>Check</button><p data-status role="status">Choose an answer.</p></fieldset>)}</div>
 </LearningSection>

 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you perform and describe transformations independently?" icon="✅" tone="review">
  <p>The bank mixes vocabulary, image coordinates, transformation identification, error analysis, and precise reasoning. Horizontal/vertical distance questions are intentionally excluded until Lesson 1.4.</p><Grade7TransformationCheck/>
 </LearningSection>

 <LearningSection id="apply" eyebrow="PLAY & APPLY" title="Animation Director" icon="🎮" tone="play">
  <div class="apply-intro"><div><h3>Your animation brief</h3><p>Create a three-step transformation sequence for the triangle. Your sequence must use a <strong>translation, reflection, and rotation</strong> exactly once each. After every step, read the new image coordinates before choosing the next transformation.</p></div><strong>Describe each motion mathematically—not just visually.</strong></div>
  <Grade7TransformationLab mode="apply" title="Build a three-transformation animation"/>
  <div class="apply-checklist"><h3>Director's checklist</h3><label><input type="checkbox"/> I used all three transformation types.</label><label><input type="checkbox"/> Every step kept the figure on integral-coordinate vertices.</label><label><input type="checkbox"/> My reflection names its line.</label><label><input type="checkbox"/> My rotation names centre, angle, and direction.</label><label><input type="checkbox"/> I can list the final image vertices.</label></div>
 </LearningSection>

 <LearningSection id="review" eyebrow="WRAP UP" title="Ready for 1.4?" icon="🏁" tone="review">
  <div class="two-grid"><article><h3>I can retrieve…</h3><ul><li>translation = slide</li><li>reflection = mirror image</li><li>rotation = turn around a centre</li><li>prime notation for image vertices</li></ul></article><article><h3>I can demonstrate…</h3><ul><li>perform each transformation on a coordinate grid</li><li>identify image vertex coordinates</li><li>describe a reflection precisely</li><li>describe a rotation using centre, angle, and direction</li></ul></article></div>
  <div class="exit-ticket" data-transform-exit><h3>Three-question readiness check</h3>
   <fieldset data-answer="2"><legend>1. Which information completely describes a rotation?</legend><label><input type="radio" name="exit-t1" value="0"/>Final quadrant only</label><label><input type="radio" name="exit-t1" value="1"/>Angle only</label><label><input type="radio" name="exit-t1" value="2"/>Centre, angle, and direction</label></fieldset>
   <fieldset data-answer="1"><legend>2. What is the best check for a reflection?</legend><label><input type="radio" name="exit-t2" value="0"/>Image is larger</label><label><input type="radio" name="exit-t2" value="1"/>Corresponding points are equal perpendicular distances from the mirror line</label><label><input type="radio" name="exit-t2" value="2"/>Every coordinate sign changes</label></fieldset>
   <fieldset data-answer="0"><legend>3. What does A′ mean?</legend><label><input type="radio" name="exit-t3" value="0"/>The transformed image of A</label><label><input type="radio" name="exit-t3" value="1"/>The centre of rotation</label><label><input type="radio" name="exit-t3" value="2"/>A horizontal distance</label></fieldset>
   <button type="button" data-submit>Check readiness</button><p data-status role="status" tabindex="-1">Answer all three questions.</p>
  </div>
  <div class="next-lesson"><strong>Next: Lesson 1.4 — Horizontal and Vertical Distances</strong><span>Now that you can create transformation images, the next lesson will analyze how positions change horizontally and vertically.</span></div>
 </LearningSection>
</Grade7RebuildLessonFrame>
<script>
document.querySelectorAll<HTMLElement>('[data-transform-practice] [data-item]').forEach(item=>item.querySelector('[data-check]')?.addEventListener('click',()=>{const chosen=item.querySelector<HTMLInputElement>('input:checked'),status=item.querySelector<HTMLElement>('[data-status]')!;if(!chosen){status.textContent='Choose an answer first.';return}status.textContent=Number(chosen.value)===Number(item.dataset.answer)?`Correct. ${item.dataset.feedback}`:`Repair: ${item.dataset.feedback}`}));
document.querySelectorAll<HTMLElement>('[data-transform-exit]').forEach(root=>root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('fieldset')],status=root.querySelector<HTMLElement>('[data-status]')!;if(items.some(i=>!i.querySelector('input:checked'))){status.textContent='Answer all three questions before checking.';return}const score=items.reduce((n,i)=>n+(Number(i.querySelector<HTMLInputElement>('input:checked')!.value)===Number(i.dataset.answer)?1:0),0);status.textContent=score===3?'3/3. Ready for Lesson 1.4.':score===2?'2/3. Repair the missed idea, then try again.':'Return to Transformation Lab and Practise before moving on.';status.focus()}));
</script>
<style>
.two-grid,.idea-grid,.example-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.two-grid article,.idea-grid article,.example-grid>article{border:1px solid #dce4ee;border-radius:14px;padding:1rem;background:#fff;min-width:0}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.curriculum{padding:1rem;border-left:5px solid #2457c5;background:#eef6ff;border-radius:0 12px 12px 0}.readiness{display:grid;gap:.45rem;margin-top:1rem;padding:1rem;border:1px solid #e3cf8b;border-radius:12px;background:#fff9dc}.readiness summary{cursor:pointer;font-weight:800}.idea-grid h3,.example-grid h3{margin:.1rem 0 .65rem}.understand-cards{display:grid;gap:.7rem}.understand-cards details{border:1px solid #d9e2ec;border-radius:12px;padding:.9rem 1rem;background:#fff}.understand-cards summary{cursor:pointer;font-weight:850}.memory,.mistake{margin-top:.7rem;padding:.75rem;border-radius:10px;background:#eef6ff}.mistake{background:#fff7d6}.discovery{margin-top:1rem;padding:1rem;border-radius:14px;background:#eaf8f2}.discovery h3{margin:.1rem 0}.practice-stack{display:grid;gap:.8rem}.practice-stack fieldset{min-width:0;margin:0;border:1px solid #d9e2ec;border-radius:12px;padding:1rem}.practice-stack legend{display:grid;gap:.2rem;font-weight:850}.practice-stack legend span{font-size:.78rem;color:#b44d12}.practice-choices{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin:.7rem 0}.practice-choices label{display:flex;gap:.5rem;align-items:flex-start;min-height:44px;padding:.55rem;border:1px solid #e0e6ed;border-radius:9px}.practice-stack button,.exit-ticket button{min-height:44px;border:0;border-radius:9px;padding:.65rem .85rem;background:#2457c5;color:#fff;font-weight:850}.practice-stack [data-status],.exit-ticket [data-status]{padding:.65rem;border-radius:9px;background:#f5f7fa;font-weight:700}.apply-intro{display:grid;grid-template-columns:1fr minmax(180px,.35fr);gap:1rem;align-items:start;margin-bottom:1rem;padding:1rem;border-radius:14px;background:#fff0f5}.apply-intro h3{margin:.1rem 0}.apply-checklist{display:grid;gap:.45rem;margin-top:1rem;padding:1rem;border:1px solid #e1d2da;border-radius:14px;background:#fff}.apply-checklist h3{margin:.1rem 0}.apply-checklist label{display:flex;gap:.55rem;min-height:44px}.apply-checklist input{width:20px;height:20px}.exit-ticket{display:grid;gap:.7rem;margin-top:1rem;padding:1rem;border:1px solid #d9e2ec;border-radius:14px}.exit-ticket h3{margin:.1rem 0}.exit-ticket fieldset{display:grid;gap:.4rem;border:0;border-top:1px solid #e2e8f0;padding:.8rem 0 0}.exit-ticket label{display:flex;gap:.5rem;min-height:40px;align-items:center}.next-lesson{display:grid;gap:.2rem;margin-top:1rem;padding:1rem;border-radius:12px;background:#edf9f0}.next-lesson span{color:#526174}@media(max-width:760px){.two-grid,.idea-grid,.example-grid,.apply-intro{grid-template-columns:1fr}.practice-choices{grid-template-columns:1fr}}@media(max-width:390px){.two-grid article,.idea-grid article,.example-grid>article,.practice-stack fieldset{padding:.8rem}.curriculum{overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
