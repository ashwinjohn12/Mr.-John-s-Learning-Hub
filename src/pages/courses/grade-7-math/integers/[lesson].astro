---
import Grade7Unit2LessonPage from '../../../../components/Grade7Unit2LessonPage.astro';
import { findCourse } from '../../../../data/courses';
import { grade7Unit2Lessons } from '../../../../data/grade7Unit2';
export function getStaticPaths(){return grade7Unit2Lessons.map(lesson=>({params:{lesson:lesson.slug},props:{lesson}}));}
const {lesson}=Astro.props;
const course=findCourse('grade-7-math')!;
const unit=course.units.find(item=>item.slug==='integers')!;
const topic=unit.topics.find(item=>item.slug===lesson.slug)!;
---
<Grade7Unit2LessonPage {course} {unit} {topic} {lesson}/>
