---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;
const levels = [
  {number:'01',name:'Creator Foundations',tagline:'Learn the tools',summary:'Start with coding, micro:bits, robotics, game design, and 3D design. Build confidence through short guided missions.',href:`${base}courses/futuretech-lab/creator-foundations/`,status:'active'},
  {number:'02',name:'Builder',tagline:'Build with the tools',summary:'Apply your foundation skills to structured coding, robotics, and design challenges.',status:'planned'},
  {number:'03',name:'Designer',tagline:'Combine the tools',summary:'Make design choices and connect multiple technologies in larger creations.',status:'planned'},
  {number:'04',name:'Engineer',tagline:'Solve with the tools',summary:'Use integrated systems to solve more complex real-world design problems.',status:'planned'},
  {number:'05',name:'Innovator',tagline:'Invent with the tools',summary:'Plan and develop an original long-term project using the technologies that fit your idea.',status:'planned'}
];
---
<BaseLayout title="FutureTech Lab | Mr. John’s Learning Hub" description="Grades 8–9 Coding, Robotics, Game Design, and 3D Design through self-paced maker missions." themeColor="#5b21b6">
  <div class="futuretech-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'FutureTech Lab'}]} />
    <header class="lab-hero">
      <div class="hero-copy">
        <p class="lab-code">FUTURETECH // LAB ONLINE</p>
        <h1>FutureTech <span>Lab</span></h1>
        <p class="hero-lead">Code it. Build it. Test it. Improve it.</p>
        <p class="hero-description">A self-paced Grades 8–9 maker lab for coding, robotics, game design, and 3D design. Start where you are, complete missions, and level up as your skills grow.</p>
        <div class="hero-actions"><a class="primary-action" href={`${base}courses/futuretech-lab/creator-foundations/`}>Start Level 1 →</a><a class="secondary-action" href="#pathway">See the pathway</a></div>
      </div>
      <div class="lab-panel" aria-label="FutureTech Lab learning cycle"><div class="panel-top"><span>STATUS</span><strong>● READY</strong></div><div class="cycle"><span><b>01</b>CODE</span><span><b>02</b>BUILD</span><span><b>03</b>TEST</span><span><b>04</b>DEBUG</span><span><b>05</b>LEVEL UP</span></div></div>
    </header>
    <section class="lab-section" aria-labelledby="tools-heading">
      <div class="section-heading"><div><p class="eyebrow">YOUR TOOLKIT</p><h2 id="tools-heading">What will you create with?</h2></div><p>You will use different tools depending on the mission. You do not need experience before you begin.</p></div>
      <div class="tool-grid"><article><span>⌨</span><strong>MakeCode</strong><p>Build programs with blocks and grow into more advanced coding.</p></article><article><span>▦</span><strong>micro:bit</strong><p>Turn code into buttons, lights, motion, games, and physical interactions.</p></article><article><span>⚙</span><strong>Robotics</strong><p>Use Hummingbird kits, sensors, LEDs, and servos to make machines react.</p></article><article><span>🎮</span><strong>Game Design</strong><p>Create playable experiences using micro:bit controls and your own rules.</p></article><article><span>⬡</span><strong>3D Design</strong><p>Design accurate digital objects and prepare useful creations for printing.</p></article></div>
    </section>
    <section id="pathway" class="lab-section pathway" aria-labelledby="path-heading">
      <div class="section-heading"><div><p class="eyebrow">YOUR PATHWAY</p><h2 id="path-heading">Five levels. One growing set of skills.</h2></div><p><strong>New students start at Level 1.</strong> Returning students continue from where they left off. Levels are mastery-based, not tied to a term.</p></div>
      <div class="level-stack">
        {levels.map((level) => level.status === 'active' ? <a class="level-card active" href={level.href}><span class="level-number">{level.number}</span><span class="level-copy"><small>{level.tagline}</small><strong>{level.name}</strong><p>{level.summary}</p></span><span class="level-status">OPEN LEVEL →</span></a> : <article class="level-card planned" aria-label={`${level.name} — coming later`}><span class="level-number">{level.number}</span><span class="level-copy"><small>{level.tagline}</small><strong>{level.name}</strong><p>{level.summary}</p></span><span class="level-status">COMING LATER</span></article>)}
      </div>
    </section>
    <section class="lab-section how-lab" aria-labelledby="how-heading"><div><p class="eyebrow">HOW FUTURETECH WORKS</p><h2 id="how-heading">Your mission tells you what to do next.</h2></div><div class="workflow-grid"><span><b>1</b><strong>Set Up</strong><small>Get your tools ready</small></span><span><b>2</b><strong>Learn & Try</strong><small>Build one new skill</small></span><span><b>3</b><strong>Build It</strong><small>Create your version</small></span><span><b>4</b><strong>Troubleshoot</strong><small>Test before asking</small></span><span><b>5</b><strong>Checkpoint</strong><small>Show what you know</small></span><span><b>6</b><strong>Level Up</strong><small>Keep building</small></span></div></section>
  </div>
</BaseLayout>
<style>
.futuretech-shell{--ink:#172033;--muted:#61708a;--purple:#5b21b6;--violet:#7c3aed;--cyan:#06b6d4;--soft:#f5f3ff;max-width:1180px;margin:auto;padding:1rem}.lab-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:2rem;align-items:center;margin:1rem 0 2.5rem;padding:clamp(1.5rem,4vw,3rem);border-radius:28px;background:radial-gradient(circle at 86% 12%,rgba(34,211,238,.22),transparent 26%),radial-gradient(circle at 12% 88%,rgba(124,58,237,.3),transparent 28%),linear-gradient(140deg,#111827,#2e1065 65%,#164e63);color:white;box-shadow:0 22px 60px rgba(30,20,70,.24)}.lab-hero:before{content:"";position:absolute;inset:0;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.16) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to right,transparent,#000)}.hero-copy,.lab-panel{position:relative;z-index:1}.lab-code{margin:0;color:#67e8f9;font:800 .76rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em}.lab-hero h1{margin:.4rem 0 .45rem;font-size:clamp(3rem,8vw,6.2rem);line-height:.9;letter-spacing:-.055em}.lab-hero h1 span{color:#67e8f9}.hero-lead{margin:.7rem 0;font-size:clamp(1.2rem,2.5vw,1.55rem);font-weight:850}.hero-description{max-width:720px;margin:.6rem 0 1.25rem;color:#d8def0;line-height:1.65;font-size:1rem}.hero-actions{display:flex;gap:.65rem;flex-wrap:wrap}.primary-action,.secondary-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.75rem 1rem;border-radius:12px;text-decoration:none;font-weight:900}.primary-action{background:#67e8f9;color:#082f49}.secondary-action{border:1px solid rgba(255,255,255,.28);color:#fff;background:rgba(255,255,255,.06)}.lab-panel{padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:20px;background:rgba(7,13,30,.42);backdrop-filter:blur(10px)}.panel-top{display:flex;justify-content:space-between;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.12);font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em;color:#b8c7da}.panel-top strong{color:#67e8f9}.cycle{display:grid;gap:.5rem;padding-top:.75rem}.cycle span{display:grid;grid-template-columns:2rem 1fr;align-items:center;padding:.65rem .7rem;border-radius:10px;background:rgba(255,255,255,.06);font-weight:850}.cycle b{color:#67e8f9;font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.lab-section{margin:2.2rem 0}.section-heading{display:grid;grid-template-columns:1fr minmax(260px,.55fr);gap:1rem;align-items:end;margin-bottom:1rem}.section-heading h2,.how-lab h2{margin:.15rem 0;font-size:clamp(1.7rem,4vw,2.5rem);letter-spacing:-.025em}.section-heading>p{color:var(--muted);line-height:1.55}.eyebrow{margin:0;color:var(--purple);font-size:.72rem;font-weight:900;letter-spacing:.12em}.tool-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem}.tool-grid article{min-height:190px;padding:1rem;border:1px solid #dde4ee;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.05)}.tool-grid article>span{display:grid;place-items:center;width:44px;height:44px;margin-bottom:.8rem;border-radius:12px;background:var(--soft);color:var(--purple);font-size:1.35rem;font-weight:900}.tool-grid strong{display:block;font-size:1.05rem;color:var(--ink)}.tool-grid p{margin:.45rem 0 0;color:var(--muted);line-height:1.5;font-size:.9rem}.level-stack{display:grid;gap:.7rem}.level-card{display:grid;grid-template-columns:72px 1fr auto;gap:1rem;align-items:center;padding:1rem 1.1rem;border:1px solid #dce3ed;border-radius:18px;background:#fff;color:inherit;text-decoration:none}.level-card.active{border-color:#8b5cf6;background:linear-gradient(135deg,#fff,#f5f3ff);box-shadow:0 10px 26px rgba(91,33,182,.09)}.level-card.planned{opacity:.64;border-style:dashed}.level-number{display:grid;place-items:center;width:58px;height:58px;border-radius:16px;background:#f1f5f9;color:#64748b;font:900 1.05rem ui-monospace,SFMono-Regular,Menlo,monospace}.active .level-number{background:#5b21b6;color:#fff}.level-copy{display:grid}.level-copy small{color:#7c3aed;font-size:.73rem;font-weight:900;text-transform:uppercase;letter-spacing:.07em}.level-copy strong{margin:.12rem 0;font-size:1.18rem;color:var(--ink)}.level-copy p{margin:.15rem 0;color:var(--muted);line-height:1.45}.level-status{font-size:.76rem;font-weight:900;color:#7c3aed;white-space:nowrap}.planned .level-status{color:#7b8798}.active:hover{transform:translateY(-1px);border-color:#6d28d9}.how-lab{padding:1.25rem;border-radius:22px;background:linear-gradient(135deg,#f8fafc,#f5f3ff)}.workflow-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:.55rem;margin-top:1rem}.workflow-grid span{display:grid;gap:.18rem;padding:.85rem;border-radius:14px;background:#fff;border:1px solid #e4e8ef}.workflow-grid b{color:#7c3aed;font:900 .74rem ui-monospace,SFMono-Regular,Menlo,monospace}.workflow-grid strong{font-size:.92rem}.workflow-grid small{color:#6b7280;line-height:1.35}.futuretech-shell :focus-visible{outline:3px solid #06b6d4;outline-offset:3px}@media(max-width:900px){.lab-hero,.section-heading{grid-template-columns:1fr}.tool-grid{grid-template-columns:repeat(2,1fr)}.workflow-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:620px){.futuretech-shell{padding:.7rem}.lab-hero{grid-template-columns:1fr;padding:1.2rem;border-radius:20px}.tool-grid{grid-template-columns:1fr}.level-card{grid-template-columns:54px 1fr}.level-number{width:48px;height:48px}.level-status{grid-column:2}.workflow-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:380px){.workflow-grid{grid-template-columns:1fr}.hero-actions>a{width:100%}}
</style>
