---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;

const phases = [
  {
    name:'FOUNDATIONS',
    summary:'Learn how FutureTech works and build the core habits that every creator needs.',
    missions:[
      {n:'01',title:'Welcome to FutureTech: Debug the System',summary:'Learn the mission system, TRY 4, and a practical way to troubleshoot.',href:'mission-1-make-it-happen/',ready:true},
      {n:'02',title:'Control It',summary:'Use precise instructions and sequence to control a digital system.'},
      {n:'03',title:'Make It Respond',summary:'Connect input, processing, and output.'},
      {n:'04',title:'Make It Smarter',summary:'Use loops and conditions to make systems behave intelligently.'}
    ]
  },
  {
    name:'EXPLORE',
    summary:'Experience robotics, systems thinking, and precise 3D design before choosing a pathway.',
    missions:[
      {n:'05',title:'Sense → Think → Act',summary:'Use sensor information to create a reactive system.'},
      {n:'06',title:"Don't Crash",summary:'Combine sensing, decisions, and movement in an autonomous challenge.'},
      {n:'07',title:'Design It',summary:'Use dimensions and relationships to create a precise CAD model.'},
      {n:'08',title:'Product Design Challenge',summary:'Design for a user, purpose, and constraint.'},
      {n:'09',title:'Make It Better',summary:'Diagnose, test, and improve a flawed technology solution.'}
    ]
  },
  {
    name:'CREATE',
    summary:'Choose a pathway, develop your skills, and build a Creator Challenge.',
    missions:[
      {n:'10',title:'Pathway Bootcamp',summary:'Build the technical skill you need in coding, robotics, or 3D design.'},
      {n:'11',title:'Pathway Challenge',summary:'Apply your pathway skills with less guidance.'},
      {n:'12',title:'Define It',summary:'Choose a problem and define a realistic minimum working solution.'},
      {n:'13',title:'Build It',summary:'Create the smallest version that actually works.'},
      {n:'14',title:'Break It',summary:'Stress-test your project and learn from failure.'},
      {n:'15',title:'Improve It',summary:'Use evidence to make one meaningful revision.'}
    ]
  },
  {
    name:'CERTIFY',
    summary:'Demonstrate that the skills belong to you, not just the finished project.',
    missions:[
      {n:'16',title:'Creator Certification',summary:'Retrieve, inspect, improve, prove, prepare, and certify.'}
    ]
  }
];
---

<BaseLayout title="FutureTech Level 1 | Creator Foundations" description="FutureTech Level 1 is a 16-mission Grade 8–9 coding, robotics, and 3D design course." themeColor="#312e81">
  <div class="level-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'FutureTech Lab',href:`${base}courses/futuretech-lab/`},{label:'Level 1'}]} />

    <header class="level-hero">
      <div>
        <p class="level-code">FUTURETECH // LEVEL 01</p>
        <h1>Creator <span>Foundations</span></h1>
        <p>Learn the tools. Build small wins. Prove the skill. Move on.</p>
      </div>
      <div class="level-badge"><strong>16</strong><span>missions</span></div>
    </header>

    <section class="current-card" aria-labelledby="continue-heading">
      <div>
        <p class="eyebrow">START HERE</p>
        <h2 id="continue-heading">Mission 1 — Debug the System</h2>
        <p>Learn how FutureTech works while you diagnose a failed calibration system.</p>
      </div>
      <a href="mission-1-make-it-happen.astro">OPEN MISSION 1 →</a>
    </section>

    <section class="journey" aria-labelledby="journey-heading">
      <div class="section-heading">
        <div><p class="eyebrow">MISSION MAP</p><h2 id="journey-heading">Your Level 1 journey</h2></div>
        <p>Work through the four phases. Mission 1 is the production prototype; later missions stay locked until their redesigned experiences are built.</p>
      </div>

      <div class="phase-stack">
        {phases.map((phase, phaseIndex) => (
          <section class="phase-block">
            <header class="phase-heading">
              <div class="phase-number">{String(phaseIndex+1).padStart(2,'0')}</div>
              <div><span>{phase.name}</span><p>{phase.summary}</p></div>
            </header>
            <div class="mission-grid">
              {phase.missions.map((m) => m.ready ? (
                <a class="mission-card ready" href={m.href}>
                  <div class="mission-top"><span class="mission-number">{m.n}</span><span class="status">AVAILABLE</span></div>
                  <h3>{m.title}</h3><p>{m.summary}</p><span class="mission-open">OPEN MISSION →</span>
                </a>
              ) : (
                <article class="mission-card planned" aria-label={`Mission ${m.n} ${m.title}, not yet available`}>
                  <div class="mission-top"><span class="mission-number">{m.n}</span><span class="status">LOCKED</span></div>
                  <h3>{m.title}</h3><p>{m.summary}</p><span class="mission-open">REDESIGN PENDING</span>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="system-note">
      <div><p class="eyebrow">HOW FUTURETECH WORKS</p><h2>One learning system all term.</h2></div>
      <div class="system-flow" aria-label="FutureTech learning cycle">
        <span><b>GET</b><small>Know the problem</small></span>
        <span><b>LEARN</b><small>See the skill</small></span>
        <span><b>TRY</b><small>Follow a model</small></span>
        <span><b>BUILD</b><small>Use it yourself</small></span>
        <span><b>PROVE</b><small>Show understanding</small></span>
        <span><b>CHECK</b><small>Show evidence</small></span>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.level-shell{--purple:#4338ca;--ink:#172033;--muted:#64748b;max-width:1160px;margin:auto;padding:1rem}
.level-hero{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;margin:1rem 0 1.1rem;padding:clamp(1.35rem,4vw,2.3rem);border-radius:24px;background:radial-gradient(circle at 90% 10%,rgba(103,232,249,.15),transparent 26%),linear-gradient(135deg,#111827,#312e81 66%,#155e75);color:#fff;box-shadow:0 16px 42px rgba(30,41,59,.18)}
.level-code{margin:0;color:#a5f3fc;font:850 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.level-hero h1{margin:.3rem 0;font-size:clamp(2.7rem,7vw,5rem);line-height:.95;letter-spacing:-.045em}.level-hero h1 span{display:block;color:#a5f3fc}.level-hero p:last-child{margin:.65rem 0 0;color:#e2e8f0;font-weight:700}
.level-badge{display:grid;justify-items:center;min-width:104px;padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:18px;background:rgba(255,255,255,.08)}.level-badge strong{font-size:2.5rem;line-height:1}.level-badge span{text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;font-weight:850;color:#cffafe}
.eyebrow{margin:0;color:var(--purple);font-size:.7rem;font-weight:950;letter-spacing:.11em}.current-card{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;padding:1rem 1.1rem;border:1px solid #c7d2fe;border-radius:18px;background:linear-gradient(135deg,#fff,#eef2ff)}.current-card h2,.section-heading h2,.system-note h2{margin:.18rem 0 .38rem;color:var(--ink);font-size:clamp(1.45rem,3.5vw,2.1rem);letter-spacing:-.025em}.current-card p{margin:0;color:var(--muted);line-height:1.5}.current-card a{display:inline-flex;min-height:44px;align-items:center;padding:.7rem .9rem;border-radius:10px;background:var(--purple);color:#fff;text-decoration:none;font-weight:900;white-space:nowrap}
.journey{margin:2rem 0}.section-heading{display:grid;grid-template-columns:1fr minmax(260px,.55fr);gap:1rem;align-items:end;margin-bottom:1rem}.section-heading>p{margin:0;color:var(--muted);line-height:1.5}.phase-stack{display:grid;gap:1rem}.phase-block{padding:1rem;border:1px solid #e2e8f0;border-radius:20px;background:#f8fafc}.phase-heading{display:grid;grid-template-columns:auto 1fr;gap:.7rem;align-items:center;margin-bottom:.75rem}.phase-number{display:grid;place-items:center;width:46px;height:46px;border-radius:12px;background:#111827;color:#67e8f9;font:900 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.phase-heading span{color:#4338ca;font:900 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.phase-heading p{margin:.2rem 0 0;color:#64748b;font-size:.88rem}
.mission-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.mission-card{display:grid;align-content:start;min-height:178px;padding:.9rem;border:1px solid #dbe3ef;border-radius:15px;background:#fff;color:inherit;text-decoration:none}.mission-card.ready{border-color:#a5b4fc;box-shadow:0 8px 22px rgba(67,56,202,.07)}.mission-card.ready:hover{transform:translateY(-2px);border-color:#6366f1}.mission-card.planned{background:#f1f5f9;border-style:dashed;opacity:.7}.mission-top{display:flex;justify-content:space-between;gap:.5rem;align-items:center}.mission-number{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#eef2ff;color:#4338ca;font:900 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.status{color:#64748b;font-size:.62rem;font-weight:950;letter-spacing:.08em}.ready .status{color:#166534}.mission-card h3{margin:.7rem 0 .3rem;color:var(--ink);font-size:1.13rem}.mission-card p{margin:0;color:var(--muted);line-height:1.45;font-size:.88rem}.mission-open{align-self:end;margin-top:.75rem;color:#4338ca;font-size:.69rem;font-weight:950}.planned .mission-open{color:#64748b}
.system-note{display:grid;grid-template-columns:minmax(220px,.45fr) 1fr;gap:1rem;align-items:center;margin:2rem 0;padding:1rem;border-radius:18px;background:#111827;color:#fff}.system-note .eyebrow{color:#67e8f9}.system-note h2{color:#fff}.system-flow{display:grid;grid-template-columns:repeat(6,1fr);gap:.35rem}.system-flow span{display:grid;gap:.18rem;padding:.6rem;border-radius:10px;background:#1f2937}.system-flow b{color:#67e8f9;font-size:.68rem}.system-flow small{color:#cbd5e1;font-size:.67rem;line-height:1.3}
.level-shell :focus-visible{outline:3px solid #06b6d4;outline-offset:3px}
@media(max-width:820px){.level-hero,.current-card,.section-heading,.system-note{grid-template-columns:1fr}.level-badge{justify-self:start;grid-template-columns:auto auto;gap:.5rem;align-items:center;min-width:0}.system-flow{grid-template-columns:repeat(3,1fr)}}
@media(max-width:650px){.mission-grid{grid-template-columns:1fr}.system-flow{grid-template-columns:1fr 1fr}.current-card a{width:100%;justify-content:center;white-space:normal}}
@media(max-width:430px){.level-shell{padding:.65rem}.system-flow{grid-template-columns:1fr}}
</style>
