---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;
const missions = [
  {n:'01',title:'Make It Happen',summary:'Create your first micro:bit program, use button events, and make the device respond to you.',href:'mission-1-make-it-happen/',ready:true,tag:'CODING FOUNDATIONS'},
  {n:'02',title:'Make It Think',summary:'Use variables, a simple loop, randomness, and one IF decision to build a Chance Machine.',href:'mission-2-make-it-think/',ready:true,tag:'SMART CODE'},
  {n:'03',title:'Build a Game',summary:'Build an equivalent timing game using your assigned :GAME or Retro Arcade controller path.',href:'mission-3-build-a-game/',ready:true,tag:'GAME DESIGN'},
  {n:'04',title:'Robot Rookie',summary:'Use Hummingbird Bit, an external LED, and a position servo to make code control real light and motion.',href:'mission-4-robot-rookie/',ready:true,tag:'ROBOTICS OUTPUTS'},
  {n:'05',title:'Sense → Think → Act',summary:'Use a light sensor, a threshold decision, and an LED output to build a reactive system.',href:'mission-5-sense-think-act/',ready:true,tag:'REACTIVE ROBOTICS'},
  {n:'06',title:'Design It. Print It.',summary:'Create an accurate 3D Maker Tag, check printability, and submit an approved STL to the print queue.',href:'mission-6-design-it-print-it/',ready:true,tag:'3D DESIGN'},
  {n:'07',title:'Choose Your Path',summary:'Choose coding, robotics, or 3D design and plan a Creator Challenge of your own.',href:'mission-7-choose-your-path/',ready:true,tag:'CREATOR CHALLENGE'},
  {n:'08',title:'Creator Certification',summary:'Test, improve, explain, and showcase your final Level 1 creation.',ready:false,tag:'SHOWCASE'}
];
---
<BaseLayout title="Level 1: Creator Foundations | FutureTech Lab" description="Level 1 FutureTech Lab missions for coding, robotics, game design, and 3D design." themeColor="#5b21b6">
  <div class="level-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'FutureTech Lab',href:`${base}courses/futuretech-lab/`},{label:'Creator Foundations'}]} />
    <header class="level-hero"><div><p class="level-code">FUTURETECH // LEVEL 01</p><h1>Creator <span>Foundations</span></h1><p>Learn the tools. Build small wins. Prove the skill. Move on.</p></div><div class="level-badge"><strong>8</strong><span>missions</span></div></header>
    <section class="level-intro" aria-labelledby="start-heading"><div><p class="eyebrow">START HERE</p><h2 id="start-heading">New to FutureTech? Mission 1 is your starting point.</h2><p>Work through the missions in order. Each one introduces a small number of new skills and ends with a quick checkpoint.</p></div><a href="mission-1-make-it-happen/">Open Mission 1 →</a></section>
    <section class="mission-section" aria-labelledby="missions-heading"><div class="section-heading"><div><p class="eyebrow">MISSION MAP</p><h2 id="missions-heading">Level 1 missions</h2></div><p><strong>Missions 1–7 are open now.</strong> Cards marked Coming Next are previews only and cannot be opened yet.</p></div><div class="mission-grid">{missions.map((m) => m.ready ? <a class="mission-card ready" href={m.href}><div class="mission-top"><span class="mission-number">{m.n}</span><span class="mission-tag">{m.tag}</span></div><h3>{m.title}</h3><p>{m.summary}</p><span class="mission-open">OPEN MISSION →</span></a> : <article class="mission-card planned" aria-label={`${m.title} — coming next and not available yet`}><div class="mission-top"><span class="mission-number">{m.n}</span><span class="mission-tag">{m.tag}</span></div><h3>{m.title}</h3><p>{m.summary}</p><span class="mission-open">COMING NEXT · PREVIEW</span></article>)}</div></section>
    <section class="mission-rules" aria-labelledby="rules-heading"><div><p class="eyebrow">THE FUTURETECH RULE</p><h2 id="rules-heading">Build your own skills. Collaborate when it helps.</h2></div><div class="rule-cards"><span><b>BUILD</b><small>Work independently by default</small></span><span><b>TEST</b><small>Use TRY 4 before asking for help</small></span><span><b>CHECK</b><small>Show your own understanding</small></span></div></section>
  </div>
</BaseLayout>
<style>
.level-shell{--purple:#5b21b6;--violet:#7c3aed;--cyan:#0891b2;--ink:#172033;--muted:#667085;max-width:1120px;margin:auto;padding:1rem}.level-hero{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;margin:1rem 0 1.4rem;padding:clamp(1.4rem,4vw,2.4rem);border-radius:24px;background:linear-gradient(135deg,#2e1065,#5b21b6 62%,#0e7490);color:#fff;box-shadow:0 16px 42px rgba(49,25,100,.2)}.level-code{margin:0;color:#a5f3fc;font:800 .73rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.level-hero h1{margin:.3rem 0;font-size:clamp(2.7rem,7vw,5rem);line-height:.95;letter-spacing:-.045em}.level-hero h1 span{display:block;color:#a5f3fc}.level-hero p:last-child{margin:.65rem 0 0;color:#e4def8;font-weight:700}.level-badge{display:grid;justify-items:center;min-width:100px;padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:18px;background:rgba(255,255,255,.08)}.level-badge strong{font-size:2.4rem;line-height:1}.level-badge span{text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;font-weight:800;color:#c4f7ff}.level-intro{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;padding:1.2rem 1.3rem;border:1px solid #ddd6fe;border-radius:18px;background:linear-gradient(135deg,#fff,#f5f3ff)}.eyebrow{margin:0;color:var(--purple);font-size:.72rem;font-weight:900;letter-spacing:.12em}.level-intro h2,.section-heading h2,.mission-rules h2{margin:.15rem 0 .4rem;color:var(--ink);font-size:clamp(1.45rem,3.5vw,2.15rem);letter-spacing:-.025em}.level-intro p{margin:0;color:var(--muted);line-height:1.55}.level-intro a{display:inline-flex;min-height:44px;align-items:center;padding:.75rem .95rem;border-radius:11px;background:var(--purple);color:#fff;text-decoration:none;font-weight:900;white-space:nowrap}.mission-section{margin:2rem 0}.section-heading{display:grid;grid-template-columns:1fr minmax(250px,.5fr);gap:1rem;align-items:end;margin-bottom:1rem}.section-heading>p{color:var(--muted);line-height:1.5}.mission-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.mission-card{position:relative;display:grid;align-content:start;min-height:215px;padding:1rem;border:1px solid #dfe5ee;border-radius:18px;background:#fff;color:inherit;text-decoration:none}.mission-card.ready{border-color:#c4b5fd;background:linear-gradient(145deg,#fff,#faf8ff);box-shadow:0 8px 24px rgba(91,33,182,.07)}.mission-card.planned{background:#f8fafc;opacity:.6;border-style:dashed;cursor:not-allowed}.mission-top{display:flex;justify-content:space-between;gap:.5rem;align-items:center}.mission-number{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#ede9fe;color:var(--purple);font:900 .8rem ui-monospace,SFMono-Regular,Menlo,monospace}.mission-tag{font-size:.66rem;font-weight:900;letter-spacing:.08em;color:#667085}.mission-card h3{margin:.85rem 0 .35rem;color:var(--ink);font-size:1.3rem}.mission-card p{margin:0;color:var(--muted);line-height:1.48}.mission-open{align-self:end;margin-top:1rem;color:var(--violet);font-size:.74rem;font-weight:900}.planned .mission-open{color:#7a8698}.ready:hover{transform:translateY(-2px);border-color:#8b5cf6}.mission-rules{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.8fr);gap:1rem;align-items:center;margin:2rem 0;padding:1.2rem;border-radius:20px;background:#111827;color:#fff}.mission-rules .eyebrow{color:#67e8f9}.mission-rules h2{color:#fff}.rule-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.rule-cards span{display:grid;gap:.2rem;padding:.8rem;border-radius:12px;background:#1f2937}.rule-cards b{color:#67e8f9;font-size:.72rem;letter-spacing:.08em}.rule-cards small{color:#cbd5e1;line-height:1.35}.level-shell :focus-visible{outline:3px solid #06b6d4;outline-offset:3px}@media(max-width:760px){.level-hero,.level-intro,.section-heading,.mission-rules{grid-template-columns:1fr}.level-badge{justify-self:start;grid-template-columns:auto auto;gap:.5rem;align-items:center;min-width:0}.mission-grid{grid-template-columns:1fr}.rule-cards{grid-template-columns:1fr 1fr 1fr}}@media(max-width:480px){.level-shell{padding:.7rem}.rule-cards{grid-template-columns:1fr}.level-intro a{width:100%;justify-content:center}}
</style>
