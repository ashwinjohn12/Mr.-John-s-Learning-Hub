<script>
const STORAGE_KEY='futuretech-level1-mission1-v2';
const configs={
 get:{start:[0,4],dir:1,target:[4,2],checkpoint:[2,4],intended:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'R'},{t:'F',v:2},{t:'STOP'}],commands:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'STOP'}],fault:3,correct:{t:'R'}},
 try:{start:[0,4],dir:1,target:[2,2],intended:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'STOP'}],commands:[{t:'F',v:2},{t:'R'},{t:'F',v:2},{t:'STOP'}],fault:1,correct:{t:'L'}},
 build:{start:[0,4],dir:1,target:[4,2],checkpoint:[2,4],intended:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'R'},{t:'F',v:2},{t:'STOP'}],commands:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'STOP'}],fault:3,correct:{t:'R'}},
 prove:{start:[0,4],dir:1,target:[3,2],intended:[{t:'F',v:1},{t:'L'},{t:'F',v:2},{t:'R'},{t:'F',v:2},{t:'STOP'}],commands:[{t:'F',v:1},{t:'L'},{t:'F',v:1},{t:'R'},{t:'F',v:2},{t:'STOP'}],fault:2,correct:{t:'F',v:2}},
 fast:{start:[0,4],dir:1,target:[4,2],checkpoint:[2,4],intended:[{t:'F',v:2},{t:'L'},{t:'F',v:2},{t:'R'},{t:'F',v:2},{t:'STOP'}],commands:[{t:'F',v:2},{t:'L'},{t:'F',v:1},{t:'R'},{t:'F',v:2},{t:'STOP'}],fault:2,suspicious:3,correct:{t:'F',v:2}}
};
const app=document.querySelector('[data-mission-app]');
if(app){
 const state=loadState();let currentStage=Math.min(Math.max(state.stage??0,0),5);const unlocked=new Set(state.unlocked??[0]);unlocked.add(0);
 if(state.tryFixed)unlocked.add(3);if(state.buildFixed||state.fastVerified)unlocked.add(4);if(state.proveFixed)unlocked.add(5);let supportLevel=state.supportLevel??0;
 const runtime={};Object.entries(configs).forEach(([name,cfg])=>runtime[name]={commands:cfg.commands.map(c=>({...c})),hasRun:false,selected:null,predictionLocked:false});
 initSimulators();restoreEvidence();showStage(currentStage,false);if(state.evidenceSubmitted)showEvidenceSaved();if(state.verified)showMissionComplete(state.rating||'P');
 document.querySelectorAll('[data-go-stage]').forEach(btn=>btn.addEventListener('click',()=>{const t=Number(btn.dataset.goStage);unlockStage(t);showStage(t)}));
 document.querySelectorAll('[data-stage-button]').forEach(btn=>btn.addEventListener('click',()=>{const t=Number(btn.dataset.stageButton);if(unlocked.has(t)||t<=currentStage)showStage(t)}));
 document.querySelectorAll('[data-run-sim]').forEach(btn=>btn.addEventListener('click',()=>runSim(btn.dataset.runSim,false)));document.querySelectorAll('[data-replay-sim]').forEach(btn=>btn.addEventListener('click',()=>runSim(btn.dataset.replaySim,true)));
 const try4=document.querySelector('[data-try4-dialog]');document.querySelectorAll('[data-open-try4]').forEach(btn=>btn.addEventListener('click',()=>try4?.showModal()));
 const backup=document.querySelector('[data-backup-dialog]');document.querySelectorAll('[data-open-backup]').forEach(btn=>btn.addEventListener('click',()=>backup?.showModal()));
 const support=document.querySelector('[data-support-dialog]');document.querySelectorAll('[data-open-support]').forEach(btn=>btn.addEventListener('click',()=>{supportLevel=Math.max(supportLevel,1);state.supportLevel=supportLevel;saveState();renderSupport();support?.showModal()}));document.querySelectorAll('[data-more-support]').forEach(btn=>btn.addEventListener('click',()=>{supportLevel=Math.max(supportLevel,Number(btn.dataset.moreSupport));state.supportLevel=supportLevel;saveState();renderSupport()}));
 const fast=document.querySelector('[data-fast-dialog]');document.querySelectorAll('[data-open-fast-track]').forEach(btn=>btn.addEventListener('click',()=>fast?.showModal()));document.querySelector('[data-fast-lock]')?.addEventListener('click',lockFast);
 document.querySelector('[data-prediction-form]')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget;const cmd=Number(form.querySelector('[data-predict-command]').value);const why=form.querySelector('[data-predict-why]').value.trim();const result=form.querySelector('[data-predict-result]').value.trim();if(!why||!result||Number.isNaN(cmd))return;runtime.prove.selected=cmd;runtime.prove.predictionLocked=true;state.provePrediction={cmd,why,result};saveState();renderCommands('prove');openEditor('prove',cmd);announce('Prediction locked. Make one change, then test it.')});
 document.querySelectorAll('[data-compare]').forEach(btn=>btn.addEventListener('click',()=>{const answer=btn.dataset.compare;state.proveCompare=answer;const wrap=document.querySelector('[data-next-test-wrap]');if(wrap)wrap.hidden=answer==='yes';if(answer==='yes'&&state.proveFixed)document.querySelector('[data-prove-complete]').hidden=false;saveState()}));
 document.querySelector('[data-evidence-form]')?.addEventListener('submit',e=>{e.preventDefault();state.evidence=Object.fromEntries(new FormData(e.currentTarget).entries());state.evidenceSubmitted=true;saveState();showEvidenceSaved();announce('Evidence saved. Ready for teacher check.')});
 document.querySelector('[data-teacher-verify]')?.addEventListener('click',()=>{const rating=document.querySelector('[data-passport-rating]')?.value||'P';state.verified=true;state.rating=rating;saveState();showMissionComplete(rating);announce('Mission 1 verified.')});
 document.querySelector('[data-teacher-retry]')?.addEventListener('click',()=>{state.verified=false;state.proveFixed=false;state.evidenceSubmitted=false;delete state.provePrediction;delete state.proveCompare;delete state.proveEdited;unlocked.delete(5);runtime.prove={commands:configs.prove.commands.map(c=>({...c})),hasRun:false,selected:null,predictionLocked:false};const form=document.querySelector('[data-prediction-form]');if(form){form.reset();form.hidden=true}const edit=document.querySelector('[data-simulator=\"prove\"] [data-edit-panel]');if(edit)edit.hidden=true;const compare=document.querySelector('[data-compare-panel]');if(compare)compare.hidden=true;const done=document.querySelector('[data-prove-complete]');if(done)done.hidden=true;const saved=document.querySelector('[data-evidence-saved]');if(saved)saved.hidden=true;const creator=document.querySelector('[data-creator-extension]');if(creator)creator.hidden=true;const complete=document.querySelector('[data-mission-complete]');if(complete)complete.hidden=true;drawGrid('prove');renderCommands('prove');saveState();unlockStage(4);showStage(4);announce('Return to Prove for one more try.')});
 document.querySelector('[data-create-bug]')?.addEventListener('click',createCreatorBug);
 document.querySelector('[data-hand-partner]')?.addEventListener('click',()=>{document.querySelector('[data-creator-partner]').hidden=false});
 document.querySelector('[data-partner-test]')?.addEventListener('click',()=>{const raw=document.querySelector('[data-partner-command]')?.value??'',guess=Number(raw),why=document.querySelector('[data-partner-prediction]')?.value.trim(),feedback=document.querySelector('[data-creator-feedback]');if(raw===''||Number.isNaN(guess)||!why||state.creatorBugIndex===undefined)return;const correct=guess===state.creatorBugIndex;feedback.textContent=correct?'Diagnosis confirmed ✓. You found the changed command.':'Not yet. Trace the route until the first mismatch.';if(correct)document.querySelector('[data-creator-reflect-wrap]').hidden=false});
 renderSupport();

 function loadState(){try{const raw=localStorage.getItem(STORAGE_KEY);return raw?JSON.parse(raw):{stage:0,unlocked:[0]}}catch{return{stage:0,unlocked:[0]}}}
 function saveState(){state.stage=currentStage;state.unlocked=[...unlocked].sort((a,b)=>a-b);try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state))}catch{}}
 function unlockStage(i){unlocked.add(i);saveState();updateStageUI()}
 function showStage(i,scroll=true){if(!(unlocked.has(i)||i<=currentStage))return;currentStage=i;document.querySelectorAll('[data-stage-panel]').forEach(p=>p.hidden=Number(p.dataset.stagePanel)!==i);saveState();updateStageUI();if(scroll)window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
 function updateStageUI(){document.querySelectorAll('[data-stage-button]').forEach(btn=>{const i=Number(btn.dataset.stageButton);const complete=i<currentStage||(i===2&&state.tryFixed)||(i===3&&(state.buildFixed||state.fastVerified))||(i===4&&state.proveFixed)||(i===5&&state.evidenceSubmitted);btn.disabled=!(unlocked.has(i)||i<=currentStage);btn.dataset.complete=String(Boolean(complete));i===currentStage?btn.setAttribute('aria-current','step'):btn.removeAttribute('aria-current');const icon=btn.querySelector('.stage-state');if(icon)icon.textContent=complete?'✓':i===currentStage?'●':'○'})}
 function initSimulators(){document.querySelectorAll('[data-simulator]').forEach(sim=>{const name=sim.dataset.simulator;if(!configs[name])return;drawGrid(name);renderCommands(name);if(name==='prove')fillSelect(document.querySelector('[data-predict-command]'),configs.prove.commands);if(name==='fast')fillSelect(document.querySelector('[data-fast-command]'),configs.fast.commands)})}
 function drawGrid(name,actual=[]){const sim=document.querySelector(`[data-simulator="${name}"]`);if(!sim)return;const grid=sim.querySelector('[data-grid]');const cfg=configs[name];const intended=execute(cfg.intended,cfg.start,cfg.dir).path;grid.innerHTML='';for(let y=0;y<5;y++){for(let x=0;x<5;x++){const cell=document.createElement('div');cell.className='sim-cell';cell.dataset.x=String(x);cell.dataset.y=String(y);if(has(intended,x,y))cell.classList.add('intended');if(has(actual,x,y))cell.classList.add('actual');if(cfg.start[0]===x&&cfg.start[1]===y)cell.append(label('START','start'));if(cfg.checkpoint&&cfg.checkpoint[0]===x&&cfg.checkpoint[1]===y)cell.append(label('A','checkpoint'));if(cfg.target[0]===x&&cfg.target[1]===y)cell.append(label(name==='try'||name==='prove'?'TARGET':'ZONE B','target'));grid.append(cell)}}placeUnit(grid,cfg.start[0],cfg.start[1],cfg.dir)}
 function label(text,cls){const el=document.createElement('span');el.className=`map-label ${cls}`;el.textContent=text;return el}
 function placeUnit(grid,x,y,dir){grid.querySelector('.unit-marker')?.remove();const cell=grid.querySelector(`[data-x="${x}"][data-y="${y}"]`);if(!cell)return;const m=document.createElement('span');m.className='unit-marker';m.setAttribute('aria-hidden','true');m.style.setProperty('--unit-rotation',`${dir*90}deg`);cell.append(m)}
 function renderCommands(name){const sim=document.querySelector(`[data-simulator="${name}"]`),stack=sim?.querySelector('[data-commands]');if(!stack)return;stack.innerHTML='';runtime[name].commands.forEach((cmd,i)=>{const b=document.createElement('button');b.type='button';b.className='command-card';b.innerHTML=`<span class="num">${i+1}</span><span>${text(cmd)}</span>`;if(runtime[name].selected===i)b.classList.add('selected');if(state[`${name}Edited`]===i)b.classList.add('edited');b.disabled=!runtime[name].hasRun||name==='get'||(name==='prove'&&!runtime.prove.predictionLocked)||(name==='fast'&&!runtime.fast.predictionLocked);b.addEventListener('click',()=>selectCommand(name,i));stack.append(b)})}
 function text(c){if(c.t==='F')return`FORWARD ${c.v??1}`;if(c.t==='L')return'TURN LEFT';if(c.t==='R')return'TURN RIGHT';return'STOP'}
 function execute(commands,start,dir){let x=start[0],y=start[1],d=dir;const path=[[x,y]],steps=[];for(let i=0;i<commands.length;i++){const c=commands[i];if(c.t==='L')d=(d+3)%4;if(c.t==='R')d=(d+1)%4;if(c.t==='F'){for(let n=0;n<(c.v||1);n++){if(d===0)y--;if(d===1)x++;if(d===2)y++;if(d===3)x--;path.push([x,y])}}steps.push({x,y,dir:d,command:i});if(c.t==='STOP')break}return{x,y,dir:d,path,steps}}
 function has(path,x,y){return path.some(p=>p[0]===x&&p[1]===y)}
 async function runSim(name){const sim=document.querySelector(`[data-simulator="${name}"]`),cfg=configs[name],rt=runtime[name];if(!sim||!cfg)return;const status=sim.querySelector('[data-sim-status]'),feedback=sim.querySelector('[data-sim-feedback]'),replay=sim.querySelector(`[data-replay-sim="${name}"]`);status.textContent='TESTING…';if(feedback)feedback.textContent='';const result=execute(rt.commands,cfg.start,cfg.dir);drawGrid(name,result.path);renderCommands(name);const grid=sim.querySelector('[data-grid]'),reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;for(const step of result.steps){sim.querySelectorAll('.command-card').forEach((c,i)=>c.classList.toggle('running',i===step.command));placeUnit(grid,step.x,step.y,step.dir);if(!reduced)await wait(300)}sim.querySelectorAll('.command-card').forEach(c=>c.classList.remove('running'));rt.hasRun=true;renderCommands(name);if(replay)replay.hidden=false;const passed=Number(result.x)===Number(cfg.target[0])&&Number(result.y)===Number(cfg.target[1]);status.textContent=passed?(name==='build'?'CALIBRATION PASSED ✓':name==='prove'?'EVIDENCE FOUND ✓':'FIXED ✓'):(name==='build'?'CALIBRATION FAILED':'TEST FAILED');if(name==='get')status.textContent='SYSTEM TEST FAILED';else if(name==='try')handleTry(passed,feedback);else if(name==='build')handleBuild(passed,feedback);else if(name==='prove')handleProve(passed,feedback);else if(name==='fast')handleFast(passed,feedback);announce(status.textContent)}
 function selectCommand(name,i){runtime[name].selected=i;renderCommands(name);if(name==='try'){const f=document.querySelector('[data-simulator="try"] [data-sim-feedback]');if(i===configs.try.fault){f.textContent='That is where the route first goes wrong. Choose the correction.';openEditor('try',i)}else f.textContent='Not yet. Compare the route again.'}else if(name==='build')openEditor('build',i);else if(name==='prove'&&runtime.prove.predictionLocked&&i===runtime.prove.selected)openEditor('prove',i);else if(name==='fast'&&runtime.fast.predictionLocked&&i===runtime.fast.selected)openEditor('fast',i)}
 function openEditor(name,i){const sim=document.querySelector(`[data-simulator="${name}"]`),panel=sim?.querySelector('[data-edit-panel]');if(!panel)return;const current=runtime[name].commands[i],opts=[{t:'F',v:1},{t:'F',v:2},{t:'L'},{t:'R'},{t:'STOP'}].filter(c=>text(c)!==text(current));panel.hidden=false;panel.innerHTML=`<div class="edit-row"><label><span>Replace Command ${i+1}</span><select data-replacement>${opts.map((c,j)=>`<option value="${j}">${text(c)}</option>`).join('')}</select></label><button class="btn secondary" type="button" data-apply-change>MAKE CHANGE</button></div>`;panel.querySelector('[data-apply-change]').addEventListener('click',()=>{const j=Number(panel.querySelector('[data-replacement]').value);runtime[name].commands[i]={...opts[j]};state[`${name}Edited`]=i;panel.hidden=true;renderCommands(name);sim.querySelector('[data-sim-status]').textContent='CHANGE READY TO TEST';announce('Change ready to test.')})}
 function handleTry(passed,f){if(passed){state.tryFixed=true;unlockStage(3);document.querySelector('[data-try-complete]').hidden=false;if(f)f.textContent='Fixed. The route now matches the target.';saveState()}else if(f)f.textContent='Select the command where the route first goes wrong.'}
 function handleBuild(passed,f){if(passed){state.buildFixed=true;unlockStage(4);document.querySelector('[data-build-complete]').hidden=false;if(f)f.textContent='Calibration passed. Your change repaired the route.';saveState()}else if(f)f.textContent='Find the first mismatch. Select one command, make one change, then test again.'}
 function handleProve(passed,f){const form=document.querySelector('[data-prediction-form]');if(!runtime.prove.predictionLocked){form.hidden=false;if(f)f.textContent='Now predict the first faulty command before changing anything.';return}document.querySelector('[data-compare-panel]').hidden=false;if(passed){state.proveFixed=true;unlockStage(5);if(f)f.textContent='Your change fixed the route. Compare the result with your prediction.';saveState()}else{document.querySelector('[data-next-test-wrap]').hidden=false;if(f)f.textContent='That did not fully fix it. Use the new evidence, then make a new prediction.';runtime.prove.commands=configs.prove.commands.map(c=>({...c}));runtime.prove.selected=null;runtime.prove.predictionLocked=false;state.proveEdited=undefined;renderCommands('prove');form.hidden=false;form.querySelector('[data-predict-command]').value='';announce('The test gave you new evidence. Make a new prediction.')}}
 function lockFast(){const raw=document.querySelector('[data-fast-command]')?.value??'',command=Number(raw),why=document.querySelector('[data-fast-why]')?.value.trim();if(raw===''||Number.isNaN(command)||!why)return;runtime.fast.selected=command;runtime.fast.predictionLocked=true;renderCommands('fast');openEditor('fast',command);announce('Fast Track prediction locked. Make one change and test it.')}
 function handleFast(passed,f){const predict=document.querySelector('[data-fast-predict]'),result=document.querySelector('[data-fast-result]');if(!runtime.fast.predictionLocked){predict.hidden=false;if(f)f.textContent='Find the first true cause. A later command looks suspicious but is correct.';return}result.hidden=false;if(passed){state.fastVerified=true;unlockStage(4);saveState();result.innerHTML='<p class="success-note"><strong>FAST TRACK VERIFIED ✓</strong> You found the root cause instead of the final symptom.</p><button class="btn primary" type="button" data-fast-to-prove>GO TO PROVE</button>';result.querySelector('[data-fast-to-prove]').addEventListener('click',()=>{document.querySelector('[data-fast-dialog]')?.close();showStage(4)})}else{result.innerHTML='<p><strong>NOT YET.</strong> Continue with Systems Calibration and use the standard route.</p><button class="btn secondary" type="button" data-fast-to-build>GO TO BUILD</button>';result.querySelector('[data-fast-to-build]').addEventListener('click',()=>{document.querySelector('[data-fast-dialog]')?.close();unlockStage(3);showStage(3)})}}
 function fillSelect(select,commands){if(select)select.innerHTML='<option value="">Choose a command…</option>'+commands.map((c,i)=>`<option value="${i}">${i+1} · ${text(c)}</option>`).join('')}
 function renderSupport(){document.querySelectorAll('[data-support-level]').forEach(s=>s.hidden=Number(s.dataset.supportLevel)>supportLevel)}
 function restoreEvidence(){if(!state.evidence)return;const form=document.querySelector('[data-evidence-form]');Object.entries(state.evidence).forEach(([k,v])=>{const input=form?.elements.namedItem(k);if(input)input.value=String(v)})}
 function showEvidenceSaved(){document.querySelector('[data-evidence-saved]').hidden=false;document.querySelector('[data-creator-extension]').hidden=false;const mini=document.querySelector('[data-passport-mini]');if(mini)mini.textContent='Evidence submitted · ready for teacher check.'}
 function showMissionComplete(rating){document.querySelector('[data-mission-complete]').hidden=false;document.querySelector('[data-rating-output]').textContent=rating;const mini=document.querySelector('[data-passport-mini]');if(mini)mini.textContent=`${rating} · Mission verified.`}
 function createCreatorBug(){const note=document.querySelector('[data-creator-bug]')?.value.trim(),rawIndex=document.querySelector('[data-creator-command]')?.value??'',index=Number(rawIndex),replacement=document.querySelector('[data-creator-replacement]')?.value,hand=document.querySelector('[data-hand-partner]'),broken=document.querySelector('[data-creator-broken]');if(!note||rawIndex===''||Number.isNaN(index)||!replacement||!hand||!broken)return;const map={F1:{t:'F',v:1},F2:{t:'F',v:2},L:{t:'L'},R:{t:'R'},STOP:{t:'STOP'}};const commands=configs.build.intended.map(x=>({...x}));const next=map[replacement];if(text(commands[index])===text(next)){broken.hidden=false;broken.textContent='Choose a replacement that actually changes the command.';return}commands[index]={...next};state.creatorBugIndex=index;state.creatorBugCommands=commands;saveState();broken.hidden=false;broken.innerHTML='<strong>Broken command stack:</strong><div class="creator-sequence">'+commands.map((cmd,i)=>`<span>${i+1} · ${text(cmd)}</span>`).join('')+'</div>';hand.disabled=false;announce('Fair bug created. Hand the challenge to a partner.')}
 function announce(msg){const live=document.querySelector('[data-live-region]');if(live){live.textContent='';requestAnimationFrame(()=>live.textContent=msg)}}
 function wait(ms){return new Promise(r=>setTimeout(r,ms))}
}
</script>
