---
import FutureTechLevel1MissionShell from '../../../../components/FutureTechLevel1MissionShell.astro';
---

<FutureTechLevel1MissionShell
  missionNumber="1"
  title="Welcome to FutureTech: Debug the System"
  subtitle="Find the fault. Fix the system. Prove your fix works."
  phase="FOUNDATIONS"
  missionCount={16}
  description="FutureTech Level 1 Mission 1: learn how to troubleshoot by comparing expected and actual behaviour, changing one thing, testing, and explaining the evidence."
>
  <div class="mission-app" data-mission-app>
    <nav class="stage-stepper" aria-label="Mission stages" data-stage-nav>
      {['GET','LEARN','TRY','BUILD','PROVE','CHECK'].map((stage, index) => (
        <button type="button" data-stage-button={index} aria-current={index === 0 ? 'step' : undefined}>
          <span class="stage-state" aria-hidden="true">{index === 0 ? '●' : '○'}</span>
          <span>{stage}</span>
        </button>
      ))}
    </nav>

    <div class="mission-layout">
      <div class="mission-workspace">
        <section class="mission-state" data-stage-panel="0" aria-labelledby="get-title">
          <div class="state-topline"><span>GET</span><strong>System Test Failed</strong></div>
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="status-chip status-fail">SYSTEM TEST FAILED</p>
              <h2 id="get-title">The delivery unit missed its target.</h2>
              <p>The delivery unit should reach the target. It doesn't.</p>
              <p class="hero-command"><strong>Find the problem. Fix it. Prove it.</strong></p>
              <div class="success-mini" aria-label="Mission success criteria">
                <span>Find the first fault</span>
                <span>Change only what is needed</span>
                <span>Test the fix</span>
                <span>Explain the evidence</span>
              </div>
            </div>
            <div class="simulator-card compact" data-simulator="get">
              <div class="sim-head">
                <div><span>CALIBRATION PREVIEW</span><strong>Delivery Unit 01</strong></div>
                <p class="sim-status" data-sim-status>READY FOR TEST</p>
              </div>
              <div class="sim-grid" data-grid role="img" aria-label="Calibration map. Start at bottom left. Intended route passes Checkpoint A and finishes at Delivery Zone B."></div>
              <div class="sim-actions">
                <button class="btn secondary" type="button" data-run-sim="get">RUN TEST</button>
                <button class="btn replay" type="button" data-replay-sim="get" hidden>REPLAY</button>
              </div>
            </div>
          </div>
          <button class="btn primary next-state" type="button" data-go-stage="1">START MISSION</button>
        </section>

        <section class="mission-state" data-stage-panel="1" aria-labelledby="learn-title" hidden>
          <div class="state-topline"><span>LEARN</span><strong>Debug Like a Creator</strong></div>
          <h2 id="learn-title">How FutureTech works</h2>
          <div class="mission-cycle" aria-label="FutureTech mission cycle">
            <span><b>GET</b><small>Know the problem</small></span><i aria-hidden="true">→</i>
            <span><b>LEARN</b><small>See the skill</small></span><i aria-hidden="true">→</i>
            <span><b>TRY</b><small>Follow a model</small></span><i aria-hidden="true">→</i>
            <span><b>BUILD</b><small>Use it yourself</small></span><i aria-hidden="true">→</i>
            <span><b>PROVE</b><small>Show you understand</small></span><i aria-hidden="true">→</i>
            <span><b>CHECK</b><small>Show evidence</small></span>
          </div>

          <article class="process-card">
            <div class="process-copy">
              <p class="eyebrow">DEBUG LIKE A CREATOR</p>
              <h3>Debugging is not guessing. It is testing.</h3>
              <div class="debug-cycle" aria-label="Debugging cycle">
                <span><b>EXPECT</b><small>What should happen?</small></span><i aria-hidden="true">→</i>
                <span><b>OBSERVE</b><small>What actually happened?</small></span><i aria-hidden="true">→</i>
                <span><b>CHANGE ONE THING</b><small>Make a purposeful change.</small></span><i aria-hidden="true">→</i>
                <span><b>TEST</b><small>Run it again.</small></span>
              </div>
              <p class="quiet">Sometimes you know exactly what should happen. Sometimes you only know what should <strong>not</strong> happen. Tests still give you evidence.</p>
            </div>
            <div class="micro-model" aria-label="Worked debugging model">
              <div class="model-state"><span>EXPECT</span><strong class="lamp green">GREEN</strong></div>
              <div class="model-state"><span>OBSERVE</span><strong class="lamp red">RED</strong></div>
              <div class="model-state"><span>CHANGE</span><strong>RED → GREEN</strong></div>
              <div class="model-state"><span>TEST</span><strong class="lamp green">PASSED</strong></div>
            </div>
          </article>

          <article class="try4-learn">
            <div><p class="eyebrow">WHEN YOU GET STUCK</p><h3>TRY 4</h3></div>
            <div class="try4-row">
              <span><b>1 · RE-READ</b><small>What should happen?</small></span>
              <span><b>2 · CHECK</b><small>Compare with the model.</small></span>
              <span><b>3 · TEST</b><small>Change one thing.</small></span>
              <span><b>4 · ASK</b><small>Explain what you expected, what happened, and what you tried.</small></span>
            </div>
          </article>

          <aside class="fast-banner" aria-label="Returning student fast track">
            <div><span>⚡ RETURNING CREATOR?</span><strong>Already comfortable troubleshooting?</strong></div>
            <button class="btn ghost" type="button" data-open-fast-track>TRY FAST TRACK</button>
          </aside>

          <button class="btn primary next-state" type="button" data-go-stage="2">CONTINUE TO TRY</button>
        </section>

        <section class="mission-state" data-stage-panel="2" aria-labelledby="try-title" hidden>
          <div class="state-topline"><span>TRY</span><strong>Guided Fault</strong></div>
          <h2 id="try-title">Try it once with support.</h2>
          <p class="state-intro">This test has one fault. <strong>Run it first.</strong> Then find where the commands stop matching the route.</p>
          <div class="simulator-card" data-simulator="try">
            <div class="sim-head"><div><span>GUIDED CALIBRATION</span><strong>Short Route</strong></div><p class="sim-status" data-sim-status>READY FOR TEST</p></div>
            <div class="sim-two-col">
              <div><div class="sim-grid" data-grid role="img" aria-label="Guided calibration route. Start at bottom left and reach the target near the centre."></div><p class="route-text">Target route: move east two spaces, turn north, move two spaces, then stop.</p></div>
              <div class="command-panel"><p class="eyebrow">COMMAND STACK</p><div class="command-stack" data-commands></div></div>
            </div>
            <div class="sim-actions"><button class="btn primary" type="button" data-run-sim="try">RUN TEST</button><button class="btn replay" type="button" data-replay-sim="try" hidden>REPLAY</button></div>
            <div class="sim-feedback" data-sim-feedback aria-live="polite"></div>
            <div class="edit-panel" data-edit-panel hidden></div>
          </div>
          <details class="hint-card"><summary>Need a hint?</summary><p>Look at the <strong>first change in direction</strong>.</p></details>
          <div class="completion-actions" data-try-complete hidden><p class="success-note"><strong>FIXED ✓</strong> You used evidence to find the fault.</p><button class="btn primary" type="button" data-go-stage="3">GO TO BUILD</button></div>
        </section>

        <section class="mission-state" data-stage-panel="3" aria-labelledby="build-title" hidden>
          <div class="state-topline"><span>BUILD</span><strong>Systems Calibration</strong></div>
          <h2 id="build-title">Repair the calibration route.</h2>
          <p class="state-intro">Pass <strong>Checkpoint A</strong> and stop inside <strong>Delivery Zone B</strong>. One command is wrong.</p>
          <div class="success-strip" aria-label="Build success criteria"><span>Pass Checkpoint A</span><span>Stop in Delivery Zone B</span><span>Change only what is needed</span><span>Explain why</span></div>
          <div class="simulator-card feature" data-simulator="build">
            <div class="sim-head"><div><span>SYSTEMS CALIBRATION</span><strong>Delivery Unit 01</strong></div><p class="sim-status" data-sim-status>READY FOR TEST</p></div>
            <div class="sim-two-col">
              <div><div class="sim-grid" data-grid role="img" aria-label="Systems calibration map. Start at bottom left. Pass Checkpoint A, travel north, then east, and finish inside Delivery Zone B."></div><p class="route-text">Intended route: east to Checkpoint A → north → east to Delivery Zone B.</p></div>
              <div class="command-panel"><p class="eyebrow">COMMAND STACK</p><div class="command-stack" data-commands></div></div>
            </div>
            <div class="sim-actions"><button class="btn primary" type="button" data-run-sim="build">RUN TEST</button><button class="btn replay" type="button" data-replay-sim="build" hidden>REPLAY</button></div>
            <div class="sim-feedback" data-sim-feedback aria-live="polite"></div>
            <div class="edit-panel" data-edit-panel hidden></div>
          </div>
          <details class="hint-card" data-build-hint><summary>Need a hint?</summary><p>Watch the system until the <strong>first moment</strong> it stops matching the intended route.</p><button class="btn text-button" type="button" data-open-support>OPEN SUPPORT ROUTE</button></details>
          <div class="completion-actions" data-build-complete hidden><p class="success-note"><strong>CALIBRATION PASSED ✓</strong> The system works. Now prove you understand why.</p><button class="btn primary" type="button" data-go-stage="4">PROVE IT</button></div>
        </section>

        <section class="mission-state" data-stage-panel="4" aria-labelledby="prove-title" hidden>
          <div class="state-topline"><span>PROVE</span><strong>Predict · Fix · Test</strong></div>
          <h2 id="prove-title">New system. New fault.</h2>
          <p class="state-intro">This time, <strong>predict the problem before you change anything.</strong></p>
          <div class="simulator-card" data-simulator="prove">
            <div class="sim-head"><div><span>INDEPENDENT TEST</span><strong>Evidence Route</strong></div><p class="sim-status" data-sim-status>READY FOR TEST</p></div>
            <div class="sim-two-col">
              <div><div class="sim-grid" data-grid role="img" aria-label="Independent calibration route. Start at bottom left. Move east, then north, then east into the target."></div><p class="route-text">Intended route: east one → north two → east two → stop.</p></div>
              <div class="command-panel"><p class="eyebrow">COMMAND STACK</p><div class="command-stack" data-commands></div></div>
            </div>
            <div class="sim-actions"><button class="btn primary" type="button" data-run-sim="prove">RUN TEST</button><button class="btn replay" type="button" data-replay-sim="prove" hidden>REPLAY</button></div>
            <div class="sim-feedback" data-sim-feedback aria-live="polite"></div>
            <form class="prediction-form" data-prediction-form hidden>
              <label><span>Which command do you think causes the first problem?</span><select data-predict-command required></select></label>
              <label><span>Why?</span><input type="text" data-predict-why maxlength="120" placeholder="I think it is the problem because…" required /></label>
              <label><span>What should happen after your fix?</span><input type="text" data-predict-result maxlength="100" placeholder="The unit should…" required /></label>
              <button class="btn secondary" type="submit">LOCK IN PREDICTION</button>
            </form>
            <div class="edit-panel" data-edit-panel hidden></div>
            <div class="compare-panel" data-compare-panel hidden>
              <p><strong>Did the test match your prediction?</strong></p>
              <div class="choice-row"><button type="button" class="btn choice" data-compare="yes">YES</button><button type="button" class="btn choice" data-compare="partly">PARTLY</button><button type="button" class="btn choice" data-compare="no">NO</button></div>
              <label data-next-test-wrap hidden><span>What would you test next?</span><input type="text" data-next-test maxlength="100" placeholder="Next I would test…" /></label>
            </div>
          </div>
          <details class="hint-card"><summary>Need a hint?</summary><p>Find the <strong>earliest movement</strong> that does not match the intended route.</p></details>
          <div class="completion-actions" data-prove-complete hidden><p class="success-note"><strong>EVIDENCE FOUND ✓</strong> You tested a prediction instead of guessing.</p><button class="btn primary" type="button" data-go-stage="5">SHOW YOUR EVIDENCE</button></div>
        </section>

        <section class="mission-state" data-stage-panel="5" aria-labelledby="check-title" hidden>
          <div class="state-topline"><span>CHECK</span><strong>Show Your Evidence</strong></div>
          <h2 id="check-title">Keep it short. Show your reasoning.</h2>
          <form class="evidence-card" data-evidence-form>
            <label><span>I changed:</span><input name="changed" maxlength="90" placeholder="TURN RIGHT → TURN LEFT" required /></label>
            <label><span>Because:</span><input name="because" maxlength="130" placeholder="the route first went wrong at the turn" required /></label>
            <label><span>My test showed:</span><input name="showed" maxlength="130" placeholder="the unit reached the target" required /></label>
            <label><span>If it still failed, I would test:</span><input name="next" maxlength="130" placeholder="the next command after the first mismatch" required /></label>
            <button class="btn primary" type="submit">SUBMIT EVIDENCE</button>
          </form>
          <div class="saved-card" data-evidence-saved hidden aria-live="polite">
            <p class="status-chip status-pass">EVIDENCE SAVED ✓</p>
            <h3>Ready for teacher check</h3>
            <p>Be ready to answer one quick question:</p>
            <blockquote>Show me where the first failure happened.</blockquote>
            <details class="teacher-check">
              <summary>Teacher check</summary>
              <label><span>Skill Passport status</span><select data-passport-rating><option value="P">P — Proficient</option><option value="D">D — Developing</option><option value="E">E — Emerging</option><option value="NY">NY — Not Yet</option></select></label>
              <div class="teacher-actions"><button class="btn verify" type="button" data-teacher-verify>VERIFY MISSION</button><button class="btn ghost" type="button" data-teacher-retry>ONE MORE TRY</button></div>
            </details>
          </div>

          <section class="creator-extension" id="creator-extension" data-creator-extension hidden aria-labelledby="creator-title">
            <p class="eyebrow">🌟 CREATOR EXTENSION</p><h3 id="creator-title">Break It on Purpose</h3>
            <p>Create <strong>one fair bug</strong>. Change one command, then challenge a partner to find it.</p>
            <label><span>My intended bug:</span><input type="text" data-creator-bug maxlength="100" placeholder="I will change one turn or movement…" /></label>
            <div class="creator-builder">
              <label><span>Command to change</span><select data-creator-command>
                <option value="">Choose…</option><option value="0">1 · FORWARD 2</option><option value="1">2 · TURN LEFT</option><option value="2">3 · FORWARD 2</option><option value="3">4 · TURN RIGHT</option><option value="4">5 · FORWARD 2</option>
              </select></label>
              <label><span>Replace it with</span><select data-creator-replacement>
                <option value="">Choose…</option><option value="F1">FORWARD 1</option><option value="F2">FORWARD 2</option><option value="L">TURN LEFT</option><option value="R">TURN RIGHT</option><option value="STOP">STOP</option>
              </select></label>
            </div>
            <div class="creator-actions"><button class="btn secondary" type="button" data-create-bug>CREATE BUG</button><button class="btn ghost" type="button" data-hand-partner disabled>HAND TO PARTNER</button></div>
            <div class="creator-broken" data-creator-broken hidden aria-live="polite"></div>
            <div class="creator-partner" data-creator-partner hidden>
              <p><strong>Partner:</strong> diagnose the system before changing it.</p>
              <label><span>Which command contains the bug?</span><select data-partner-command>
                <option value="">Choose…</option><option value="0">Command 1</option><option value="1">Command 2</option><option value="2">Command 3</option><option value="3">Command 4</option><option value="4">Command 5</option>
              </select></label>
              <label><span>Why do you think so?</span><input type="text" data-partner-prediction maxlength="140" /></label>
              <button class="btn secondary" type="button" data-partner-test>TEST MY DIAGNOSIS</button>
              <p class="creator-feedback" data-creator-feedback aria-live="polite"></p>
              <label data-creator-reflect-wrap hidden><span>Creator: what made your bug easy or difficult to find?</span><input type="text" data-creator-reflect maxlength="140" /></label>
            </div>
          </section>

          <section class="mission-complete" id="mission-passport" data-mission-complete hidden aria-live="polite">
            <p class="status-chip status-pass">MISSION 1 VERIFIED ✓</p><h3>Skill Passport updated</h3>
            <div class="passport-row"><span><b>Independence</b> · Troubleshoots systematically</span><strong data-rating-output>P</strong></div>
            <p class="debug-reminder">EXPECT → OBSERVE → CHANGE ONE THING → TEST</p>
            <div class="next-preview"><span>NEXT</span><strong>Mission 2 — Control It</strong><p>Computers follow instructions exactly.</p></div>
            <a class="btn primary link-btn" href="../">RETURN TO MISSION MAP</a>
          </section>
        </section>
      </div>

      <aside class="mission-tools" id="mission-help" aria-label="Mission tools">
        <section><p class="eyebrow">MISSION TOOLS</p><h2>Need help?</h2><button class="tool-button" type="button" data-open-try4><span>TRY 4</span><small>Re-read · Check · Test · Ask</small></button><button class="tool-button muted" type="button" data-open-backup><span>TECH NOT WORKING?</span><small>Use the Backup Route</small></button></section>
        <section class="passport-mini" aria-label="Current Skill Passport target"><p class="eyebrow">SKILL PASSPORT</p><strong>Troubleshoots systematically</strong><small data-passport-mini>Evidence not submitted yet.</small></section>
      </aside>
    </div>

    <dialog class="mission-dialog" data-try4-dialog aria-labelledby="try4-dialog-title">
      <form method="dialog"><button class="dialog-close" value="close" aria-label="Close TRY 4">×</button><p class="eyebrow">WHEN YOU GET STUCK</p><h2 id="try4-dialog-title">TRY 4</h2>
        <div class="try4-dialog-grid"><span><b>1 · RE-READ</b><small>What should happen?</small></span><span><b>2 · CHECK</b><small>Compare with the model.</small></span><span><b>3 · TEST</b><small>Change one thing.</small></span><span><b>4 · ASK</b><small>Explain what you expected, what happened, and what you already tried.</small></span></div>
        <button class="btn primary" value="close">BACK TO MISSION</button>
      </form>
    </dialog>

    <dialog class="mission-dialog support-dialog" data-support-dialog aria-labelledby="support-title">
      <form method="dialog"><button class="dialog-close" value="close" aria-label="Close Support Route">×</button><p class="eyebrow">SUPPORT ROUTE</p><h2 id="support-title">Find the first break.</h2>
        <section class="support-level" data-support-level="1"><span>1 · COMPARE</span><p>Compare the intended route with the actual route. <strong>Where do they first stop matching?</strong></p><div class="compare-mini"><div><b>INTENDED</b><span>east → north → east</span></div><div><b>ACTUAL</b><span>east → north → west</span></div></div><button class="btn secondary" type="button" data-more-support="2">I NEED MORE HELP</button></section>
        <section class="support-level" data-support-level="2" hidden><span>2 · NARROW IT DOWN</span><p>The first wrong movement happens around the <strong>second turn</strong>. Compare the turn command with the route.</p><button class="btn secondary" type="button" data-more-support="3">I NEED MORE HELP</button></section>
        <section class="support-level" data-support-level="3" hidden><span>3 · TRACE IT</span><div class="trace-table" role="table" aria-label="Command trace"><div role="row"><b role="cell">1</b><span role="cell">FORWARD 2</span><span role="cell">correct</span></div><div role="row"><b role="cell">2</b><span role="cell">TURN LEFT</span><span role="cell">correct</span></div><div role="row"><b role="cell">3</b><span role="cell">FORWARD 2</span><span role="cell">correct</span></div><div role="row"><b role="cell">4</b><span role="cell">TURN LEFT</span><span role="cell">check this movement</span></div></div><p class="quiet">Return to BUILD and choose the correction yourself.</p></section>
        <button class="btn primary" value="close">BACK TO BUILD</button>
      </form>
    </dialog>

    <dialog class="mission-dialog" data-fast-dialog aria-labelledby="fast-title">
      <form method="dialog" class="fast-dialog-form"><button class="dialog-close" value="close" aria-label="Close Fast Track">×</button><p class="eyebrow">⚡ RETURNING CREATOR</p><h2 id="fast-title">Fast Track</h2><p>The final failure is not always where the real problem begins. Find the <strong>first true fault</strong>.</p>
        <div class="simulator-card" data-simulator="fast"><div class="sim-head"><div><span>FAST TRACK</span><strong>Root-Cause Test</strong></div><p class="sim-status" data-sim-status>READY FOR TEST</p></div>
          <div class="sim-two-col"><div><div class="sim-grid" data-grid role="img" aria-label="Fast Track route with one root cause and one later command that looks suspicious but is correct."></div><p class="route-text">Find the earliest true cause, not the final symptom.</p></div><div class="command-panel"><p class="eyebrow">COMMAND STACK</p><div class="command-stack" data-commands></div></div></div>
          <div class="sim-actions"><button class="btn primary" type="button" data-run-sim="fast">RUN TEST</button></div><div class="sim-feedback" data-sim-feedback aria-live="polite"></div>
          <div class="fast-predict" data-fast-predict hidden><label><span>I think the first true fault is:</span><select data-fast-command></select></label><label><span>Why is the later suspicious command not the root cause?</span><input type="text" data-fast-why maxlength="130" /></label><button class="btn secondary" type="button" data-fast-lock>LOCK IN PREDICTION</button></div><div class="edit-panel" data-edit-panel hidden></div>
        </div><div class="fast-result" data-fast-result hidden></div>
      </form>
    </dialog>

    <dialog class="mission-dialog backup-dialog" data-backup-dialog aria-labelledby="backup-title">
      <form method="dialog"><button class="dialog-close" value="close" aria-label="Close Backup Route">×</button><p class="eyebrow">TECH NOT WORKING?</p><h2 id="backup-title">Backup Route</h2><p>Use the same calibration thinking without the animation.</p>
        <ol><li>Read one command at a time.</li><li>Trace the unit on the route.</li><li>Circle the first mismatch.</li><li>Change one command.</li><li>Trace it again.</li></ol>
        <div class="backup-static"><div><b>BUILD route</b><p>Start bottom-left → east two → north two → east two → Delivery Zone B.</p></div><div><b>Commands</b><p>FORWARD 2 · TURN LEFT · FORWARD 2 · TURN LEFT · FORWARD 2 · STOP</p></div></div>
        <p class="quiet"><strong>Teacher option:</strong> use printed command cards and a small token on the same route.</p><button class="btn primary" value="close">BACK TO MISSION</button>
      </form>
    </dialog>

    <div class="sr-only" aria-live="polite" data-live-region></div>
  </div>
</FutureTechLevel1MissionShell>

<style>
.mission-app{--indigo:#4338ca;--indigo-dark:#312e81;--ink:#172033;--muted:#64748b;--line:#dbe3ef;--soft:#f8fafc;--green:#15803d}
.stage-stepper{position:sticky;top:5.25rem;z-index:30;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.35rem;margin:.65rem 0 .8rem;padding:.38rem;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.96);box-shadow:0 7px 22px rgba(15,23,42,.05);backdrop-filter:blur(8px)}
.stage-stepper button{display:flex;justify-content:center;gap:.38rem;align-items:center;min-height:42px;border:0;border-radius:9px;background:transparent;color:#64748b;font:850 .76rem/1 system-ui,sans-serif;cursor:pointer}.stage-stepper button[aria-current="step"]{background:#eef2ff;color:var(--indigo-dark)}.stage-stepper button[data-complete="true"]{color:#166534}.stage-stepper button:disabled{opacity:.38;cursor:not-allowed}
.mission-layout{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:.85rem;align-items:start}.mission-workspace{min-width:0}.mission-state{padding:clamp(1rem,2.5vw,1.5rem);border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 10px 34px rgba(15,23,42,.045)}
.state-topline{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:.8rem;color:var(--muted);font-size:.72rem;font-weight:900;letter-spacing:.09em}.state-topline span{color:var(--indigo)}.mission-state h2{margin:.15rem 0 .5rem;font-size:clamp(1.55rem,3.5vw,2.25rem);letter-spacing:-.03em}.mission-state h3{margin:.15rem 0 .4rem;font-size:1.2rem}.state-intro,.hero-copy>p{color:var(--muted);line-height:1.55}
.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr);gap:1rem;align-items:center}.hero-copy h2{font-size:clamp(1.8rem,4vw,2.8rem)}.hero-command{font-size:1.08rem}
