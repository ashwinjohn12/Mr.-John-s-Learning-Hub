---
import Unit3LessonPage from '../../../../components/Unit3LessonPage.astro';
import { findCourse } from '../../../../data/courses';
import { unit3Content } from '../../../../data/unit3Content';
const course = findCourse('grade-6-math')!;
const unit = course.units.find((item) => item.slug === 'number-operations')!;
const topic = unit.topics.find((item) => item.slug === 'operations-parentheses-powers')!;
const content = unit3Content['grade-6-math/number-operations/operations-parentheses-powers'];
---
<Unit3LessonPage {course} {unit} {topic} {content} />
