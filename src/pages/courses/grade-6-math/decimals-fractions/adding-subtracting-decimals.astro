---
import Unit4DecimalLessonPage from '../../../../components/Unit4DecimalLessonPage.astro';
import { findCourse } from '../../../../data/courses';
import { unit4DecimalContent } from '../../../../data/unit4DecimalContent';

const course = findCourse('grade-6-math')!;
const unit = course.units.find((item) => item.slug === 'decimals-fractions')!;
const topic = unit.topics.find((item) => item.slug === 'adding-subtracting-decimals')!;
const key = 'grade-6-math/decimals-fractions/adding-subtracting-decimals';
const content = unit4DecimalContent[key];
---
<Unit4DecimalLessonPage {course} {unit} {topic} {content} />
