---
import Unit4LessonPage from '../../../../components/Unit4LessonPage.astro';
import { findCourse } from '../../../../data/courses';
import { unit4Content } from '../../../../data/unit4Content';

const course = findCourse('grade-6-math')!;
const unit = course.units.find((item) => item.slug === 'decimals-fractions')!;
const topic = unit.topics.find((item) => item.slug === 'adding-subtracting-fractions')!;
const key = 'grade-6-math/decimals-fractions/adding-subtracting-fractions';
const content = unit4Content[key];
---
<Unit4LessonPage {course} {unit} {topic} {content} />
