---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;

const continents = [
  { name: 'Gyre', code: 'GY', subtitle: 'Alpine Frontier', status: 'Promising', tone: 'yellow', icon: '⛰️', summary: 'Towering mountains, high plateaus, deep valleys, freshwater rivers, and snow-covered peaks.', known: ['Fresh water in valley systems', 'Strong elevation changes', 'Large unidentified organisms detected'], question: 'What is living in the valleys—and what else is hidden in the mountains?' },
  { name: 'Brillig', code: 'BR', subtitle: 'Emerald Basin', status: 'Very Promising', tone: 'green', icon: '🌿', summary: 'Warm, wet, humid, and covered by dense vegetation. Huge rivers cross a highly biodiverse landscape.', known: ['Abundant fresh water', 'Extremely high biodiversity', 'Exposed soil erodes quickly after vegetation is removed'], question: 'Can humans use Brillig’s resources without damaging what makes it valuable?' },
  { name: 'Manxome', code: 'MA', subtitle: 'Vorpal Archipelago', status: 'Promising', tone: 'yellow', icon: '🌊', summary: 'Hundreds of islands surrounded by the Vorpal Ocean, with mild temperatures for most of the year.', known: ['Mild climate', 'Many sheltered bays and islands', 'A severe annual storm season'], question: 'Can permanent structures survive what Manxome throws at them?' },
  { name: 'Slithy Toves', code: 'ST', subtitle: 'Sunscar Desert', status: 'Difficult', tone: 'orange', icon: '🏜️', summary: 'A very dry, sandy continent with scarce fresh water and huge temperature changes between day and night.', known: ['Intense sunlight', 'Very limited fresh water', 'Powerful sandstorms several times each year'], question: 'Can humans survive where water is so limited?' },
  { name: 'Wabe', code: 'WA', subtitle: 'White Frontier', status: 'Challenging', tone: 'orange', icon: '❄️', summary: 'An Arctic environment of snow, ice, short summers, and long periods of cold.', known: ['Large reserves of frozen fresh water', 'Short cool summers', 'Whiteout storms can last for days'], question: 'What can survive—and grow—in an environment this cold?' },
  { name: 'Bandersnatch', code: 'BA', subtitle: 'Golden Plains', status: 'Excellent', tone: 'green', icon: '🌾', summary: 'Huge open grasslands with cold winters, warm summers, fresh water, and a long growing season.', known: ['Large flat areas', 'Strong agricultural potential', 'Large herd-like movement detected from orbit'], question: 'Is Bandersnatch really as perfect as it looks?' },
  { name: 'Gimble', code: 'GI', subtitle: 'Greatwood', status: 'Very Promising', tone: 'green', icon: '🌲', summary: 'Enormous forests, freshwater lakes and rivers, cold winters, and relatively mild summers.', known: ['Abundant plant resources', 'Fresh water', 'Dense forests hide much of the surface from orbit'], question: 'How much can humans use before the forest begins to change?' },
  { name: 'Mimsy', code: 'MI', subtitle: 'Endless Wetlands', status: 'Poor', tone: 'red', icon: '🪷', summary: 'Warm, humid wetlands with marshes, muddy ground, shallow waterways, and nutrient-poor soils.', known: ['Abundant water', 'Extensive biological activity', 'Heavy construction may be difficult'], question: 'Is Mimsy unsuitable—or are we asking the wrong questions?' }
];

const lockedPhases = [
  { number: '02', title: 'The Living Resource', division: 'Botanical Resources Division', teaser: 'Can plants support human life without damaging Jabberwocky’s ecosystems?', clearance: 'Complete Mission Phase 1' },
  { number: '03', title: 'Surviving Jabberwocky', division: 'Thermal Systems Division', teaser: 'Can humans safely control heat and energy in this environment?', clearance: 'Complete Mission Phase 2' },
  { number: '04', title: 'Project New Horizon', division: 'Settlement Engineering Division', teaser: 'What would it take to build here permanently?', clearance: 'Complete Mission Phase 3' },
  { number: '05', title: 'Secrets Beneath the Surface', division: 'Planetary Geology Division', teaser: 'What does Jabberwocky’s past tell us about its future?', clearance: 'Complete Mission Phase 4' }
];
---

<BaseLayout title="Jabberwocky: Mission 2190 | Grade 7 Science" description="A year-long Grade 7 Science expedition across the planet Jabberwocky." themeColor="#071b2e">
  <div class="mission-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky: Mission 2190' }
    ]} />

    <section class="mission-hero" aria-labelledby="mission-title">
      <div class="scan-lines" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="system-label">JCEC // PATHFINDER NETWORK // CLEARANCE GRANTED</p>
        <p class="year-stamp">EARTH YEAR 2190</p>
        <h1 id="mission-title">JABBERWOCKY<br /><span>MISSION 2190</span></h1>
        <p class="hero-lead">Humanity has discovered life beyond Earth. The question is no longer <strong>“Are we alone?”</strong></p>
        <p class="hero-question">The question is: <strong>What do we do now?</strong></p>
        <div class="hero-actions">
          <a class="mission-button primary" href="#briefing">Begin Mission</a>
          <a class="mission-button secondary" href="#planet-scan">Scan the Planet</a>
          <a class="mission-button current" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>▶ Continue Current Mission</a>
        </div>
      </div>
      <aside class="mission-readout" aria-label="Mission status">
        <p>MISSION STATUS</p><strong>ACTIVE</strong>
        <dl>
          <div><dt>Destination</dt><dd>Jabberwocky</dd></div>
          <div><dt>Human population</dt><dd>0 permanent</dd></div>
          <div><dt>Continents</dt><dd>8</dd></div>
          <div><dt>Safe settlement regions</dt><dd>UNKNOWN</dd></div>
          <div><dt>Survey completion</dt><dd>7%</dd></div>
        </dl>
      </aside>
    </section>

    <nav class="mission-nav" aria-label="Jabberwocky mission navigation">
      <a href="#briefing">Mission Control</a>
      <a href="#planet-scan">Continents</a>
      <a class="active" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Current Mission</a>
      <a href="#archives">Archives</a>
      <a href="#status-board">JCEC Status</a>
    </nav>

    <section id="briefing" class="panel briefing-panel" aria-labelledby="briefing-heading">
      <div class="panel-heading">
        <p class="system-label">INCOMING TRANSMISSION 001</p>
        <span class="live-dot">LIVE</span>
      </div>
      <h2 id="briefing-heading">Welcome, Pathfinder.</h2>
      <div class="briefing-grid">
        <div>
          <p>For centuries, humans searched the universe for another world like Earth. Then we found one with clouds, oceans, rivers, mountains, forests, deserts, ice, weather... and <strong>life</strong>.</p>
          <p>The Jabberwocky Council for Exploration and Colonization—the <strong>JCEC</strong>—has been asked one enormous question:</p>
          <blockquote>Could Jabberwocky become a new home for humans?</blockquote>
        </div>
        <div class="briefing-card">
          <p class="card-kicker">YOUR MISSION</p>
          <h3>Explore. Investigate. Decide.</h3>
          <p>You will change teams and scientific jobs throughout the year. You may be sent to a different continent in every mission phase.</p>
          <p>You will inherit evidence from earlier teams—and future scientists will inherit yours.</p>
          <p class="warning">Your work does not disappear when your unit ends.</p>
        </div>
      </div>
    </section>

    <section class="section-block decision-lab early-decision" aria-labelledby="decision-heading">
      <div class="section-title-row"><div><p class="system-label">JCEC QUICK DECISION</p><h2 id="decision-heading">What would you do first?</h2></div><span class="decision-tag">MISSION DAY 001</span></div>
      <p>Humanity discovers a planet with breathable air, liquid water, and complex life. What should happen next?</p>
      <div class="decision-options" data-decision-group>
        <button data-choice="build">Begin building immediately</button>
        <button data-choice="resources">Search for valuable resources</button>
        <button data-choice="study">Study the ecosystems first</button>
        <button data-choice="avoid">Avoid the planet completely</button>
      </div>
      <p class="decision-response" id="decision-response" aria-live="polite">Choose an option. There is more to learn before the JCEC makes a final decision.</p>
    </section>

    <section class="remember-panel" aria-labelledby="remember-heading">
      <div><p class="system-label">DAY 1 TRANSLATOR</p><h2 id="remember-heading">You only need to remember 3 things.</h2></div>
      <div class="remember-grid">
        <article><strong>PATHFINDER</strong><span>= You</span></article>
        <article><strong>JCEC</strong><span>= The organization sending your missions</span></article>
        <article><strong>CONTINENTAL ARCHIVE</strong><span>= What teams discover about each continent</span></article>
      </div>
    </section>

    <section class="promise-strip" aria-label="Mission promise">
      <span>YOU WILL NOT HAVE ALL THE INFORMATION.</span>
      <strong>Neither do real scientists.</strong>
    </section>

    <section id="planet-scan" class="section-block" aria-labelledby="planet-heading">
      <div class="section-title-row">
        <div><p class="system-label">PLANETARY SCAN</p><h2 id="planet-heading">Eight continents. One unknown world.</h2></div>
        <p>Select a region on the map or open its JCEC file below.</p>
      </div>

      <div class="planet-map" aria-label="Interactive map of Jabberwocky">
        <div class="map-readout"><span>ORBITAL CARTOGRAPHY</span><strong>JABBERWOCKY // SURVEY MAP</strong><small>Preliminary geography — not all surface data confirmed</small></div>
        <svg viewBox="0 0 900 520" role="img" aria-labelledby="map-title map-desc">
          <title id="map-title">Jabberwocky planetary survey map</title>
          <desc id="map-desc">A stylized map showing the approximate locations of Gyre, Brillig, Manxome, Slithy Toves, Wabe, Bandersnatch, Gimble, and Mimsy.</desc>
          <defs>
            <radialGradient id="ocean" cx="45%" cy="38%"><stop offset="0" stop-color="#164d67"/><stop offset=".65" stop-color="#0b3048"/><stop offset="1" stop-color="#071c30"/></radialGradient>
            <clipPath id="planetClip"><ellipse cx="450" cy="260" rx="390" ry="220"/></clipPath>
          </defs>
          <ellipse class="planet" cx="450" cy="260" rx="390" ry="220" fill="url(#ocean)"/>
          <g clip-path="url(#planetClip)" class="grid-lines" aria-hidden="true">
            <path d="M60 170 Q450 250 840 170M60 260 Q450 330 840 260M60 350 Q450 410 840 350"/>
            <path d="M220 40 Q300 260 220 480M450 40 Q450 260 450 480M680 40 Q600 260 680 480"/>
          </g>
          <g class="continents-svg">
            <a class="map-link" href="#continent-GY" data-open="continent-GY" aria-label="Open Gyre continent file"><path class="land gyre" d="M145 125 C120 155 132 205 174 221 C207 233 244 211 250 174 C257 138 220 102 185 102 C167 102 153 111 145 125Z"/><text x="187" y="164">GYRE</text></a>
            <a class="map-link" href="#continent-BR" data-open="continent-BR" aria-label="Open Brillig continent file"><path class="land brillig" d="M322 120 C286 146 281 195 308 226 C334 256 385 250 408 218 C429 190 420 146 386 123 C365 109 342 108 322 120Z"/><text x="355" y="181">BRILLIG</text></a>
            <a class="map-link" href="#continent-MA" data-open="continent-MA" aria-label="Open Manxome continent file"><g class="islands"><path class="land manxome" d="M548 106 C525 119 521 144 537 158 C554 173 579 161 584 139 C589 118 570 99 548 106Z"/><path class="land manxome" d="M604 146 C589 157 591 179 607 187 C624 196 642 183 641 166 C640 149 620 136 604 146Z"/><path class="land manxome" d="M565 191 C548 201 550 223 567 231 C586 240 604 225 600 207 C597 193 579 183 565 191Z"/></g><text x="592" y="121">MANXOME</text></a>
            <a class="map-link" href="#continent-ST" data-open="continent-ST" aria-label="Open Slithy Toves continent file"><path class="land slithy" d="M686 205 C652 226 642 272 663 307 C687 346 743 347 774 316 C800 290 800 244 769 217 C746 197 711 190 686 205Z"/><text x="716" y="270"><tspan x="716" dy="0">SLITHY</tspan><tspan x="716" dy="18">TOVES</tspan></text></a>
            <a class="map-link" href="#continent-WA" data-open="continent-WA" aria-label="Open Wabe continent file"><path class="land wabe" d="M399 60 C367 75 356 105 373 129 C391 154 433 154 458 132 C485 108 477 74 446 59 C431 52 415 53 399 60Z"/><text x="420" y="101">WABE</text></a>
            <a class="map-link" href="#continent-BA" data-open="continent-BA" aria-label="Open Bandersnatch continent file"><path class="land bander" d="M212 288 C174 307 163 350 187 382 C213 416 269 419 302 391 C332 365 329 321 298 298 C276 282 236 277 212 288Z"/><text x="244" y="350">BANDERSNATCH</text></a>
            <a class="map-link" href="#continent-GI" data-open="continent-GI" aria-label="Open Gimble continent file"><path class="land gimble" d="M405 298 C367 317 358 361 385 392 C414 425 468 419 493 383 C516 351 500 309 466 295 C446 287 425 288 405 298Z"/><text x="440" y="354">GIMBLE</text></a>
            <a class="map-link" href="#continent-MI" data-open="continent-MI" aria-label="Open Mimsy continent file"><path class="land mimsy" d="M548 326 C520 347 521 389 548 410 C579 434 625 419 642 384 C658 351 633 317 599 313 C581 311 562 316 548 326Z"/><text x="588" y="371">MIMSY</text></a>
          </g>
          <ellipse class="planet-outline" cx="450" cy="260" rx="390" ry="220"/>
        </svg>
        <p class="map-help">Tip: choose a continent on the map to jump straight to its current JCEC file.</p>
      </div>

      <div class="continent-grid">
        {continents.map((continent) => (
          <details id={`continent-${continent.code}`} class={`continent-card tone-${continent.tone}`}>
            <summary>
              <span class="continent-icon" aria-hidden="true">{continent.icon}</span>
              <span class="continent-title"><small>JCEC FILE {continent.code}-2190</small><strong>{continent.name}</strong><em>{continent.subtitle}</em></span>
              <span class={`status-pill ${continent.tone}`}>{continent.status}</span>
            </summary>
            <div class="continent-body">
              <p>{continent.summary}</p>
              <h3>Current scan</h3>
              <ul>{continent.known.map((item) => <li>{item}</li>)}</ul>
              <div class="unknown-box"><span>?</span><p><strong>UNANSWERED</strong>{continent.question}</p></div>
              <div class="classified">🔒 CLASSIFIED DATA — NOT YET AVAILABLE</div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="section-block vote-lab" aria-labelledby="vote-heading">
      <div class="section-title-row"><div><p class="system-label">INITIAL JCEC VOTE</p><h2 id="vote-heading">Where would you settle first?</h2></div><span class="decision-tag">SAVE YOUR FIRST IMPRESSION</span></div>
      <p>Based only on today's limited evidence, choose the continent that looks most suitable for human settlement.</p>
      <div class="continent-vote" data-continent-vote>
        {continents.map((continent) => <button data-continent={continent.name}><span>{continent.icon}</span>{continent.name}</button>)}
      </div>
      <p class="decision-response" id="vote-response" aria-live="polite">No vote recorded yet. Your answer may look very different later in the year.</p>
    </section>

    <section class="section-block how-it-works" aria-labelledby="assignment-heading">
      <div class="section-title-row"><div><p class="system-label">PATHFINDER PROTOCOL</p><h2 id="assignment-heading">Your assignment will keep changing.</h2></div></div>
      <div class="protocol-grid">
        <article><span>01</span><h3>New team</h3><p>JCEC reorganizes Pathfinder personnel at the start of every mission phase.</p></article>
        <article><span>02</span><h3>New posting</h3><p>You may be sent to a continent you have never studied before.</p></article>
        <article><span>03</span><h3>New specialty</h3><p>Ecologist. Botanist. Thermal specialist. Engineer. Geologist.</p></article>
        <article><span>04</span><h3>Inherited evidence</h3><p>Read the Continental Archive before making new decisions.</p></article>
        <article><span>05</span><h3>Leave good science</h3><p>The next team will depend on the evidence and recommendations you leave behind.</p></article>
      </div>
    </section>

    <section id="mission-phases" class="section-block" aria-labelledby="phases-heading">
      <div class="section-title-row"><div><p class="system-label">MISSION ROADMAP</p><h2 id="phases-heading">Five scientific divisions. One connected expedition.</h2></div><p>Future phases are genuinely classified until your class reaches them.</p></div>
      <div class="phase-stack">
        <article class="phase-card active">
          <div class="phase-summary"><span class="phase-number">01</span><span class="phase-title"><small>Ecological Survey Division</small><strong>First Contact</strong><em>Planetary Ecologist</em></span><span class="phase-status">● ACTIVE</span></div>
          <div class="phase-content">
            <p class="phase-question">How does life on Jabberwocky survive, interact, and respond to change—and what happens when humans enter that system?</p>
            <div class="progress-grid">
              <div class="progress-item active-step"><strong>Mission Assignment</strong><span>ACTIVE</span></div>
              <div class="progress-item"><strong>Environmental Survey</strong><span>PENDING</span></div>
              <div class="progress-item"><strong>First Contact</strong><span>PENDING</span></div>
              <div class="progress-item"><strong>Ecosystem Network</strong><span>PENDING</span></div>
              <div class="progress-item"><strong>Population Investigation</strong><span>PENDING</span></div>
              <div class="progress-item classified-step"><strong>Classified Incident</strong><span>🔒 LOCKED</span></div>
            </div>
            <a class="mission-button primary phase-launch" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Enter Mission Phase 1 →</a>
          </div>
        </article>
        {lockedPhases.map((phase) => (
          <article class="phase-card locked" aria-label={`Mission Phase ${phase.number} locked`}>
            <div class="phase-summary"><span class="phase-number">{phase.number}</span><span class="phase-title"><small>{phase.division}</small><strong>{phase.title}</strong><em>{phase.teaser}</em></span><span class="phase-status">🔒 CLASSIFIED</span></div>
            <p class="locked-message"><strong>ACCESS DENIED.</strong> Clearance requirement: {phase.clearance}.</p>
          </article>
        ))}
      </div>
    </section>

    <section id="archives" class="section-block archive-section" aria-labelledby="archive-heading">
      <div class="section-title-row"><div><p class="system-label">JCEC CONTINENTAL ARCHIVES</p><h2 id="archive-heading">The planet remembers what your class discovers.</h2></div></div>
      <div class="archive-demo">
        <div class="archive-file">
          <div class="folder-tab">GYRE // MASTER FILE</div>
          <ul>
            <li class="done"><span>✓</span> Arrival Data</li>
            <li><span>○</span> Ecological Survey</li>
            <li><span>○</span> Botanical Survey</li>
            <li><span>○</span> Thermal Systems Report</li>
            <li><span>○</span> Engineering Report</li>
            <li><span>○</span> Geological Report</li>
            <li class="locked-item"><span>🔒</span> Final JCEC Status</li>
          </ul>
        </div>
        <div>
          <h3>Your Pathfinder Log follows <em>you</em>.</h3>
          <p>Record where you were sent, what your team discovered, what evidence mattered, what you recommended, and how your thinking changed.</p>
          <h3>The Continental Archive follows the <em>continent</em>.</h3>
          <p>Every specialist team adds another layer of evidence. By the end of the year, each continent will have a scientific history created by the class.</p>
        </div>
      </div>
    </section>

    <section id="status-board" class="section-block status-section" aria-labelledby="status-heading">
      <div class="section-title-row"><div><p class="system-label">JCEC LIVE STATUS BOARD</p><h2 id="status-heading">Initial settlement assessment</h2><small class="update-stamp">LAST UPDATED // MISSION DAY 001</small></div><p class="status-warning">⚠ Ratings are based on incomplete information.</p></div>
      <div class="status-board">
        {continents.map((continent) => (
          <div class="status-row"><span><strong>{continent.name}</strong><small>{continent.subtitle}</small></span><span class={`status-pill ${continent.tone}`}>{continent.status}</span></div>
        ))}
      </div>
      <p class="board-note">Watch this board. Ratings can rise, fall, or be placed under review when new evidence appears.</p>
    </section>

    <section class="pathfinder-code" aria-labelledby="code-heading">
      <p class="system-label">JCEC PATHFINDER CODE</p>
      <h2 id="code-heading">How we explore an unknown world</h2>
      <div class="code-grid">
        <strong>Observe before you change.</strong><strong>Ask before you assume.</strong><strong>Use evidence.</strong><strong>Expect consequences.</strong><strong>Change your ideas when the evidence changes.</strong><strong>Leave good science for the team that comes next.</strong>
      </div>
    </section>

    <section class="final-console" aria-label="Mission launch console">
      <p>PATHFINDER STATUS: <strong>CONFIRMED</strong></p><p>MISSION PHASE: <strong>01 ACTIVE</strong></p><p>LAUNCH WINDOW: <strong>OPEN</strong></p>
      <a class="mission-button primary launch" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>▶ Continue Current Mission</a>
      <small>Jabberwocky mission work now has its own campaign space, separate from the regular Grade 7 Science lesson pages.</small>
    </section>
  </div>

  <script>
    const group = document.querySelector('[data-decision-group]');
    const response = document.querySelector('#decision-response');
    const messages = {
      build: 'Fast—but what could we damage before we understand it?',
      resources: 'Useful—but how would we know what can be used safely?',
      study: 'A cautious scientific start. What evidence would you collect first?',
      avoid: 'Lowest immediate impact—but are we giving up before gathering enough evidence?'
    };
    const savedDecision = localStorage.getItem('jcec-first-decision');
    if (savedDecision) {
      const savedButton = group?.querySelector(`[data-choice="${savedDecision}"]`);
      savedButton?.classList.add('selected');
      if (response && messages[savedDecision]) response.textContent = `Decision remembered: ${messages[savedDecision]}`;
    }
    group?.querySelectorAll('button').forEach((button) => {
      button.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((b) => b.classList.remove('selected'));
        button.classList.add('selected');
        const choice = button.getAttribute('data-choice');
        if (choice) localStorage.setItem('jcec-first-decision', choice);
        if (response && choice && messages[choice]) response.textContent = messages[choice];
      });
    });

    const voteGroup = document.querySelector('[data-continent-vote]');
    const voteResponse = document.querySelector('#vote-response');
    const savedContinent = localStorage.getItem('jcec-initial-continent');
    const showVote = (name) => {
      voteGroup?.querySelectorAll('button').forEach((b) => b.classList.toggle('selected', b.getAttribute('data-continent') === name));
      if (voteResponse) voteResponse.textContent = `INITIAL ASSESSMENT RECORDED: ${name}. Keep this first impression in mind as new evidence arrives.`;
    };
    if (savedContinent) showVote(savedContinent);
    voteGroup?.querySelectorAll('button').forEach((button) => button.addEventListener('click', () => {
      const name = button.getAttribute('data-continent');
      if (name) { localStorage.setItem('jcec-initial-continent', name); showVote(name); }
    }));

    document.querySelectorAll('.map-link').forEach((link) => link.addEventListener('click', () => {
      const id = link.getAttribute('data-open');
      const target = id ? document.getElementById(id) : null;
      if (target && target instanceof HTMLDetailsElement) target.open = true;
    }));
  </script>
</BaseLayout>

<style>
