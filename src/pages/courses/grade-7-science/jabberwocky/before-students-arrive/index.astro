---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const root = `${base}courses/grade-7-science/jabberwocky/`;
const dashboard = `${root}teacher-dashboard/`;
const phase = (n) => `${root}phase-${n}/`;
const purchases = [['1','6 hand lenses'],['2','6 shallow reusable trays'],['3','6 classroom thermometers'],['4','6 plastic measuring containers'],['5','3 spring scales']];
const phasePrep = [
  {number:1,title:'FIRST CONTACT',unit:'Interactions & Ecosystems',gather:'Shared thermometers; a few spoons/tweezers/tongs; yarn/string; counters/paper markers; clipboards/metre sticks if already available.',print:'Week 1 only: continent roster, Environmental Survey field sheet, Environment Profile, Survival Structures sheet and Native Species material.',wait:'Mission 3–5 evidence/decision materials can wait until their week.',fallback:'Project evidence, use notebook paper, share one station set and teacher-provided observations/data.'},
  {number:2,title:'THE LIVING RESOURCE',unit:'Plants for Food & Fibre',gather:'Real plants if available; fast-growing seeds; reused containers; small amounts of growing media; wick/string.',print:'Mission 1 observation/profile and Mission 2 Growth Trial recording material.',wait:'Selective-breeding, growing-zone and Production Footprint materials can wait.',fallback:'Use plant photos, supplied growth data, evidence cards and labelled testable designs.'},
  {number:3,title:'SURVIVING JABBERWOCKY',unit:'Heat & Temperature',gather:'4–6 shared thermometers; standardized inner cups; recycled insulation materials; plastic measuring containers; shallow trays/towels; tape/string/elastics.',print:'Mission 1 thermal investigation first. For Mission 3 later, print/save the JCEC Thermos Design Report and graph page only when that week approaches.',wait:'Do not pre-build thermos kits. The Thermos Challenge, Habitat Control materials and Mission 5 source/energy cards can wait until their mission.',fallback:'Rotate/stagger shared thermometers; use a teacher thermos test or supplied Prototype/Final datasets; use Thermos Design Cards if construction materials are missing.'},
  {number:4,title:'PROJECT NEW HORIZON',unit:'Structures & Forces',gather:'3 shared spring scales if available; paper/card/recycled plastic; tape; rulers; small safe loads.',print:'Mission 1 Requirements Card / detective sheet and Mission 2 force material first.',wait:'Material-test graphing, stability/retest and final Design Review materials can wait.',fallback:'Teacher force demo + supplied data, evidence cards and paper/card models.'},
  {number:5,title:'THE DEEP RECORD',unit:'Planet Earth',gather:'Shared hand lenses; optional rock/mineral samples; shallow trays; sediment/water; measuring containers.',print:'Mission 1 photo/property/sample cards and first observation record.',wait:'Rock-cycle, surface-change, Earth-reference and final evidence materials can wait.',fallback:'Photo/property cards, projected evidence and supplied datasets; no geology purchases required.'}
];
const weekOne = [
  {day:1,title:'Welcome to Jabberwocky',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/`,prep:'Have the student → continent → Team ID roster ready. Test Student Launch and Mission 1 on a Chromebook.',see:'Story launch → assigned continent → preliminary JCEC rating → short starting prediction.',say:'“The preliminary JCEC rating is a starting idea, not the answer. Your job is to test ideas with evidence.”',finish:'Assigned continent saved + short baseline prediction. No major grade.'},
  {day:2,title:'Earth Environmental Survey',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/#investigate`,prep:'Choose safe microhabitats; check weather; stage shared field kits.',see:'Sample areas and record temperature, moisture/light, evidence of life, surface/soil and human impact.',say:'“Record what you observe before you explain it.”',finish:'Environmental Survey field sheet — formative.'},
  {day:3,title:'Explore Your Continent',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/#decide`,prep:'Return field sheets and confirm saved continent.',see:'Analyze continent scan → decision → Environment Profile + reflection.',say:'“One strong observation beats several vague claims.”',finish:'Environment Profile — formative.'},
  {day:4,title:'How Structures Help',mission:'Mission 2 — Meet a Native Species',href:`${phase(1)}mission-2/#investigate`,prep:'Set up shared Survival Structures stations.',see:'Structure/function/adaptation/needs → Survival Structures Lab.',say:'“Keep time and rules the same. Change the structure.”',finish:'Lab observations — formative.'},
  {day:5,title:'First Contact',mission:'Mission 2 — Meet a Native Species',href:`${phase(1)}mission-2/#investigate`,prep:'Have species reconstruction materials ready.',see:'Examine clues → infer features/behaviours → begin reconstruction.',say:'“EVIDENCE FIRST — IMAGINATION SECOND.”',finish:'Evidence-based reconstruction in progress.'}
];
const inventory = [['6 hand lenses','Priority purchase #1'],['6 shallow reusable trays','Priority purchase #2'],['6 classroom thermometers','Priority purchase #3'],['6 plastic measuring containers','Priority purchase #4'],['3 spring scales','Priority purchase #5'],['Rulers / metre sticks','Use existing supply'],['Yarn / string','Small reusable class set'],['Reused cups / containers','Collect/reuse; includes Phase 3 thermos inner cups'],['Tape / clips / elastics','Ordinary shared supplies'],['Clean recycled insulation materials','Cardboard/paper/fabric/foil/bubble wrap/clean foam as available']];
const recovery = [
  ['Chromebooks fail','Project the page and use paper/notebooks. Keep the same team/continent.'],
  ['Printing is unavailable','Project cards/sheets and copy only the needed table/headings onto blank paper.'],
  ['A lab runs long','Stop once students have enough evidence. Use the next flex period or supplied/class data.'],
  ['Materials are missing','Shared station → teacher demonstration → supplied data/evidence cards.'],
  ['A student is absent','Use team/class/supplied evidence. Do not recreate an entire lab unless useful.'],
  ['A class is lost','Protect the core investigation, one decision and Team Record; cut presentations/polish first.'],
  ['A group loses its saved continent posting','Use the teacher roster and restore the assigned continent at that phase hub. The five phase keys remain separate.'],
  ['Phase 3 Thermos Challenge equipment fails','Use staggered thermometers, a teacher test or the supplied Prototype/Final datasets. Preserve graphing, diagnosis, redesign and the JCEC Thermos Design Report.']
];
---

<BaseLayout title="Mission 2190 — Before Students Arrive" description="Concise teacher operations guide for Mission 2190." themeColor="#071b2e">
  <div class="ops-shell" id="jcec-before-students-arrive">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:root},{label:'Teacher Master Dashboard',href:dashboard},{label:'Before Students Arrive'}]} />
    <header class="hero"><p class="eyebrow">TEACHER OPERATIONS // MISSION 2190 v1.0</p><h1>BEFORE <span>STUDENTS ARRIVE</span></h1><p>This is an operations resource. The approved science, assessment architecture, continent canon and storyline stay intact; Phase 3 Mission 3 is now the approved JCEC Thermos Challenge.</p></header>
    <div class="actions"><a href={dashboard}>← Teacher Master Dashboard</a><button id="print-ops" type="button">Print / Save PDF</button></div>

    <section class="panel" id="school-year"><p class="eyebrow">1 · BEFORE THE SCHOOL YEAR</p><h2>Whole-year setup checklist</h2><div class="check-grid"><label><input type="checkbox"/> Bookmark Student Launch + Teacher Master Dashboard.</label><label><input type="checkbox"/> Test the launch, one phase hub, one mission and Council on a student Chromebook/network.</label><label><input type="checkbox"/> Test a continent posting and refresh to confirm localStorage persistence.</label><label><input type="checkbox"/> Tell students not to use Guest/Incognito for saved postings.</label><label><input type="checkbox"/> Prepare the Phase 1 student → continent → Team ID roster.</label><label><input type="checkbox"/> Decide paper/digital/mixed Team Record collection.</label><label><input type="checkbox"/> Create one reusable JCEC equipment bin and five phase folders.</label><label><input type="checkbox"/> Check priority equipment before buying anything.</label></div><div class="purchase-list">{purchases.map(([rank,item])=><article><b>{rank}</b><strong>{item}</strong></article>)}</div><p class="rule"><strong>Preserve every no-purchase pathway.</strong> These purchases improve convenience; none is required for Mission 2190 to run.</p></section>

    <section class="panel" id="phases"><p class="eyebrow">2 · BEFORE EACH PHASE</p><h2>Short prep cards</h2><div class="phase-grid">{phasePrep.map((item)=><article><header><span>PHASE {item.number}</span><div><small>{item.unit}</small><h3>{item.title}</h3></div></header><dl><div><dt>GATHER</dt><dd>{item.gather}</dd></div><div><dt>PRINT NOW</dt><dd>{item.print}</dd></div><div><dt>CAN WAIT</dt><dd>{item.wait}</dd></div><div><dt>NO-PURCHASE FALLBACK</dt><dd>{item.fallback}</dd></div></dl><footer><a href={phase(item.number)}>Student Hub →</a><a href={`${phase(item.number)}teacher-launch-guide/`}>Teacher Launch Guide →</a></footer></article>)}</div></section>

    <section class="panel" id="week-one"><p class="eyebrow">3 · FIRST WEEK / PHASE 1 LAUNCH</p><h2>Exact opening week</h2><div class="week-grid">{weekOne.map((item)=><article><header><b>DAY {item.day}</b><div><small>{item.mission}</small><h3>{item.title}</h3></div><a href={item.href}>Open →</a></header><div class="day-fields"><div><small>PREPARE</small><p>{item.prep}</p></div><div><small>STUDENTS SEE / DO</small><p>{item.see}</p></div><div><small>SAY / EMPHASIZE</small><p>{item.say}</p></div><div><small>FINISH LINE</small><p>{item.finish}</p></div></div></article>)}</div></section>

    <section class="panel inventory" id="inventory"><p class="eyebrow">4 · EQUIPMENT INVENTORY</p><h2>Already Have / Need to Find / Need to Buy</h2><table><thead><tr><th>ITEM</th><th>NOTE</th><th>ALREADY HAVE</th><th>NEED TO FIND</th><th>NEED TO BUY</th></tr></thead><tbody>{inventory.map(([item,note])=><tr><td><strong>{item}</strong></td><td>{note}</td><td>☐</td><td>☐</td><td>☐</td></tr>)}</tbody></table></section>

    <section class="panel" id="recovery"><p class="eyebrow">5 · QUICK RECOVERY GUIDE</p><h2>Protect the science, not the apparatus</h2><div class="recovery-grid">{recovery.map(([title,text])=><article><strong>{title}</strong><p>{text}</p></article>)}</div></section>

    <section class="panel" id="day-one"><p class="eyebrow">DAY 1 READY-CHECK</p><h2>Before students enter</h2><div class="check-grid"><label><input type="checkbox"/> Phase 1 continent + Team ID roster ready.</label><label><input type="checkbox"/> Student Launch + Phase 1 Mission 1 open successfully.</label><label><input type="checkbox"/> Projector ready.</label><label><input type="checkbox"/> Students use normal browser profiles.</label><label><input type="checkbox"/> Team Record collection mode chosen.</label><label><input type="checkbox"/> Day 1 ends with continent saved + short baseline prediction.</label></div></section>

    <script is:inline>document.getElementById('print-ops')?.addEventListener('click',()=>window.print());</script>
  </div>
</BaseLayout>

<style>
:global(body){background:#06111f}.ops-shell{max-width:1160px;margin:0 auto;padding:0 1rem 5rem;color:#eaf5ff}.ops-shell :global(.breadcrumbs){color:#9cb5c4}.ops-shell :global(.breadcrumbs a){color:#d9edf6}.eyebrow{margin:0;color:#73e8ca;font:850 .73rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.hero,.panel{margin:1rem 0;padding:1.1rem;border:1px solid #294e5f;border-radius:18px;background:#081b28}.hero{background:linear-gradient(145deg,#081827,#0b2939)}.hero h1{margin:.4rem 0;color:#fff;font-size:clamp(2.5rem,6vw,4.8rem)}.hero h1 span{color:#6ef2cf}.hero p:last-child{color:#bdd0db}.actions{display:flex;gap:.5rem}.actions a,.actions button,.phase-grid footer a,.week-grid header a{padding:.6rem .75rem;border:0;border-radius:8px;background:#6ef2cf;color:#06251c;text-decoration:none;font-weight:900}.panel h2{margin:.25rem 0;color:#fff}.check-grid,.purchase-list,.recovery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem}.check-grid label,.purchase-list article,.recovery-grid article{padding:.7rem;border-radius:9px;background:#071720;color:#c6d8e1}.purchase-list{grid-template-columns:repeat(5,1fr);margin-top:.7rem}.purchase-list b{color:#73e8ca}.purchase-list strong{font-size:.78rem}.rule{color:#bdd0db}.phase-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.phase-grid>article{padding:.8rem;border:1px solid #31505e;border-radius:10px;background:#071720}.phase-grid header{display:flex;gap:.6rem}.phase-grid header>span{color:#73e8ca;font-weight:900}.phase-grid h3{margin:.1rem 0;color:#fff}.phase-grid small{color:#8fa7b5}.phase-grid dl{display:grid;grid-template-columns:1fr 1fr;gap:.4rem}.phase-grid dl div{padding:.6rem;border-radius:8px;background:#0c222e}.phase-grid dt{color:#73e8ca;font-size:.65rem;font-weight:900}.phase-grid dd{margin:.25rem 0;color:#b7cbd5;font-size:.78rem;line-height:1.45}.phase-grid footer{display:flex;gap:.4rem}.week-grid{display:grid;gap:.5rem}.week-grid>article{border:1px solid #31505e;border-radius:10px;background:#071720;overflow:hidden}.week-grid header{display:grid;grid-template-columns:65px 1fr auto;gap:.6rem;align-items:center;padding:.7rem}.week-grid header b{color:#73e8ca}.week-grid header small{color:#8fa7b5}.week-grid h3{margin:.1rem 0;color:#fff}.day-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:.4rem;padding:.7rem;border-top:1px solid #294e5f}.day-fields div{padding:.6rem;border-radius:8px;background:#0c222e}.day-fields small{color:#73e8ca;font-weight:900}.day-fields p,.recovery-grid p{margin:.25rem 0;color:#b7cbd5;font-size:.78rem;line-height:1.45}.inventory{overflow:auto}.inventory table{width:100%;min-width:760px;border-collapse:collapse}.inventory th,.inventory td{padding:.55rem;border:1px solid #31505e;text-align:left}.inventory th{color:#73e8ca}.inventory td:nth-child(n+3){text-align:center;font-size:1.2rem}@media(max-width:800px){.check-grid,.recovery-grid,.phase-grid,.day-fields{grid-template-columns:1fr}.purchase-list{grid-template-columns:repeat(2,1fr)}.phase-grid dl{grid-template-columns:1fr}.week-grid header{grid-template-columns:55px 1fr}.week-grid header a{grid-column:1/-1;text-align:center}}@media(max-width:520px){.purchase-list{grid-template-columns:1fr}.actions,.phase-grid footer{display:grid}.actions a,.actions button,.phase-grid footer a{text-align:center}}@media print{.actions,.ops-shell :global(.breadcrumbs){display:none!important}:global(body){background:#fff}.ops-shell{max-width:none;color:#111}.hero,.panel,.phase-grid>article,.week-grid>article,.check-grid label,.purchase-list article,.recovery-grid article,.phase-grid dl div,.day-fields div{background:#fff;border-color:#999}.hero h1,.hero h1 span,.panel h2,.phase-grid h3,.week-grid h3{color:#111}.hero p:last-child,.check-grid label,.phase-grid dd,.day-fields p,.recovery-grid p{color:#333}}
</style>
