ace-items:center;min-width:65px;min-height:48px;border-radius:9px;background:#153d37;color:#8ef0d5;font-size:.69rem;font-weight:900}.phase-prep h3,.day-card h3{margin:.08rem 0;color:#fff;font-size:1.1rem}.phase-prep header small,.day-card header small{color:#8fa8b4;font-size:.73rem}.phase-prep dl{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;margin:.7rem 0}.phase-prep dl>div{padding:.65rem;border:1px solid #284653;border-radius:8px;background:#081925}.phase-prep dt{margin-bottom:.22rem}.phase-prep dd{margin:0;color:#a9bec7;font-size:.77rem;line-height:1.45}.phase-links{display:flex;justify-content:flex-end;gap:.4rem}.phase-links a,.day-card header>a{padding:.5rem .65rem;border-radius:7px;background:#12362f;color:#9af3dc;text-decoration:none;font-size:.72rem;font-weight:900}.week-grid{display:grid;gap:.65rem;margin-top:.9rem}.day-card{border:1px solid #2d4e5c;border-radius:12px;overflow:hidden;background:#071720}.day-card header{display:grid;grid-template-columns:64px 1fr auto;gap:.7rem;align-items:center;padding:.7rem;background:#0a202c}.day-card header>b{display:grid;place-items:center;height:42px;border-radius:9px;background:#153d37;color:#8ef0d5;font-size:.78rem}.day-fields{display:grid;grid-template-columns:repeat(4,1fr);gap:.45rem;padding:.7rem}.day-fields>div{padding:.6rem;border:1px solid #284653;border-radius:8px;background:#081925}.day-fields p{margin:.25rem 0 0;color:#a9bec7;font-size:.75rem;line-height:1.45}.inventory-wrap{overflow:auto;margin-top:.8rem}.inventory-panel table{width:100%;border-collapse:collapse;min-width:690px}.inventory-panel th,.inventory-panel td{padding:.65rem;border:1px solid #2b4b58}.inventory-panel th{background:#0b2630;color:#83ead2;font-size:.68rem;letter-spacing:.06em}.inventory-panel td{background:#071720;color:#dceaf0;text-align:center}.inventory-panel td:first-child{text-align:left}.inventory-panel td strong{display:block}.inventory-panel td small{display:block;margin-top:.12rem;color:#8da6b1}.inventory-panel input{width:18px;height:18px;accent-color:#6ef2cf}.recovery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem;margin-top:.8rem}.recovery-grid article{padding:.75rem;border:1px solid #2d4c59;border-radius:10px;background:#071720}.recovery-grid strong{color:#fff}.recovery-grid p{margin:.3rem 0 0;color:#a8bec7;font-size:.79rem;line-height:1.48}.day-one{border-color:#3e786d;background:linear-gradient(145deg,#081b28,#0b2928)}.check-grid.short{grid-template-columns:repeat(3,1fr)}.day-one-actions{display:flex;justify-content:flex-end;gap:.5rem;margin-top:.8rem}
