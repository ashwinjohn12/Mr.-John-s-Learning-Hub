---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const root = `${base}courses/grade-7-science/jabberwocky/`;
const dashboard = `${root}teacher-dashboard/`;
const phase = (n) => `${root}phase-${n}/`;

const purchases = [
  ['1','6 hand lenses','Phase 5 observation; useful across science.'],
  ['2','6 shallow reusable trays','Phase 5 surface-change testing and shared-station organization.'],
  ['3','6 classroom thermometers','Phase 1 environmental survey + Phase 3 thermal investigations.'],
  ['4','6 plastic measuring containers','Reusable in plant, thermal and Earth-system investigations.'],
  ['5','3 spring scales','Shared Phase 4 force-measurement stations; not one per team.']
];

const phasePrep = [
  {
    number:1,title:'FIRST CONTACT',unit:'Interactions & Ecosystems',
    gather:'Shared thermometers; a few spoons/tweezers/tongs/chopsticks; yarn/string; beans/counters/paper markers; metre sticks/clipboards if already available.',
    print:'Week 1 only: continent roster, Earth Environmental Survey field sheet, Environment Profile, Survival Structures Lab sheet, species reconstruction sheet / Native Species Card.',
    wait:'Mission 3 organism cards, Mission 4 sampling/local-source pack and Mission 5 Stowaway / pollutant tokens can wait until their week.',
    fallback:'Project the evidence, use notebook paper, share one station set, use printed/paper markers and teacher-provided observations/data. No dedicated lab kit is required.'
  },
  {
    number:2,title:'THE LIVING RESOURCE',unit:'Plants for Food & Fibre',
    gather:'Real flowering/seed plants if available; fast-growing seeds; reused containers; small amounts of sand-rich, clay-rich and organic-rich media; wick/string.',
    print:'Mission 1 plant profile / observation material and the Mission 2 Growth Trial recording sheet. Print later mission decision pages only when you reach them.',
    wait:'Selective-breeding simulation cards, growing-zone planning pieces and Production Footprint materials can wait.',
    fallback:'Use teacher plant examples/photos, supplied growth data, evidence cards and a labelled testable design instead of a physical growing prototype.'
  },
  {
    number:3,title:'SURVIVING JABBERWOCKY',unit:'Heat & Temperature',
    gather:'About 4–6 shared thermometers; reused cups/containers; ordinary classroom barrier/insulation materials; simple items for conduction/convection/radiation demonstrations.',
    print:'Mission 1 thermal investigation / risk record and any station sheets you know you will use first.',
    wait:'Thermal Barrier Fair Test sheets, Habitat Control materials and Mission 5 energy/source cards can wait until their mission.',
    fallback:'Run a teacher demonstration, rotate a few thermometers, or use supplied datasets / observation cards. No one-thermometer-per-team requirement.'
  },
  {
    number:4,title:'PROJECT NEW HORIZON',unit:'Structures & Forces',
    gather:'3 shared spring scales if available; paper/card/recycled plastic; tape; rulers; small safe loads; materials for standardized paper/card stability models.',
    print:'Mission 1 Requirements Card / detective sheet and Mission 2 force-recording material first.',
    wait:'Material-test graphing pages, stability/retest materials and the final Design Review / Authorization can wait.',
    fallback:'Use a teacher force demo + supplied data, evidence cards, equal-sized paper samples and labelled structural designs. No large build, hot glue, saws or specialty equipment.'
  },
  {
    number:5,title:'THE DEEP RECORD',unit:'Planet Earth',
    gather:'Shared hand lenses; optional small rock/mineral samples; shallow reusable trays; sediment/water; plastic measuring containers if using the surface-change fair test.',
    print:'Mission 1 photo/property or sample evidence cards and the first observation/classification record.',
    wait:'Rock-cycle cards, surface-change dataset, authentic Earth-reference source cards and the final Geological Evidence Packet can wait.',
    fallback:'Use photo/property cards, projected evidence, supplied quantitative data and teacher-curated source cards. Phase 5 can run with no geology purchases.'
  }
];

const weekOne = [
  {
    day:1,title:'Welcome to Jabberwocky',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/`,
    prep:'Have the student → continent → Team ID roster ready. Test the Student Launch and Mission 1 on a Chromebook. Decide whether students use paper, digital Team Records or both.',
    see:'Story launch → assigned continent → preliminary JCEC rating → short starting prediction → four core science ideas.',
    say:'“The preliminary JCEC rating is a starting idea, not the answer. Your job this year is to test ideas with evidence.”',
    finish:'Assigned continent saved on the Chromebook + short baseline prediction. No major grade.'
  },
  {
    day:2,title:'Earth Environmental Survey',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/#investigate`,
    prep:'Choose 3 safe microhabitats; check weather; stage one or a few shared field kits and field sheets.',
    see:'Sample 3 areas and record temperature, light/moisture, evidence of life, surface/soil and human impact.',
    say:'“Record what you observe before you explain it. Shared tools rotate; your team does not need its own full kit.”',
    finish:'Earth Environmental Survey field sheet — formative.'
  },
  {
    day:3,title:'Explore Your Continent',mission:'Mission 1 — Explore Your Environment',href:`${phase(1)}mission-1/#decide`,
    prep:'Return field sheets. Confirm each group still has the correct Phase 1 continent posting saved.',
    see:'Analyze the simplified continent scan → one team decision → Environment Profile + individual reflection.',
    say:'“One strong observation beats several vague claims.”',
    finish:'Environment Profile — formative.'
  },
  {
    day:4,title:'How Structures Help',mission:'Mission 2 — Meet a Native Species',href:`${phase(1)}mission-2/#investigate`,
    prep:'Set up 2–3 shared Survival Structures stations using desks, paper zones or reused shallow containers.',
    see:'Learn structure/function/adaptation/needs → complete the Survival Structures Lab.',
    say:'“Keep time, amount and rules the same. Change the structure. We are testing how structure affects the job.”',
    finish:'Lab observations — formative.'
  },
  {
    day:5,title:'First Contact',mission:'Mission 2 — Meet a Native Species',href:`${phase(1)}mission-2/#investigate`,
    prep:'Confirm the continent posting is saved. Have species reconstruction sheets/pencils ready if using paper.',
    see:'Examine 4 clues → infer features/behaviours → begin species reconstruction.',
    say:'“EVIDENCE FIRST — IMAGINATION SECOND.”',
    finish:'A reconstruction in progress that uses the four clues; no major submission yet.'
  }
];

const inventory = [
  ['6 hand lenses','Priority purchase #1'],
  ['6 shallow reusable trays','Priority purchase #2'],
  ['6 classroom thermometers','Priority purchase #3'],
  ['6 plastic measuring containers','Priority purchase #4'],
  ['3 spring scales','Priority purchase #5'],
  ['Rulers / metre sticks','Use existing classroom supply'],
  ['Yarn / string','Small reusable class set'],
  ['Spoons / tweezers / tongs / chopsticks','A few shared station tools; mixed types are fine'],
  ['Beans / counters / paper markers','Reusable manipulatives; paper replacements are valid'],
  ['Reused cups / small containers','Clean classroom/recycling stock; do not buy a team set']
];

const recovery = [
  ['Chromebooks fail','Project the student page, give one paper/notebook Team Record per team, and keep the same continent/team. Pair devices if only some work. Resume digitally later only if useful.'],
  ['Printing is unavailable','Project cards/sheets and have students reproduce only the needed table, diagram or Team Record headings on blank paper/notebooks. Do not postpone the science just to get the designed packet.'],
  ['A lab runs long','Stop when students have enough evidence to make the intended decision. Use the next purposeful flex period, a teacher dataset or shared class results for the missing portion. Cut extra trials/polish first.'],
  ['Materials are missing','Switch to shared stations → teacher demonstration → supplied data/evidence cards, in that order. The fallback counts as the same lesson pathway.'],
  ['A student is absent','Use the team record plus supplied/teacher data for missed observations. The student completes the short individual reflection when they return; do not recreate an entire lab unless it is genuinely useful.'],
  ['A class is lost','Protect the core investigation, one team decision and Team Record. Remove gallery walks, extra trials, presentations and polish before cutting core science. Use the phase flex days for recovery.'],
  ['A group loses its saved continent posting','Use your teacher roster. For Phase 1, return to Mission 1 and restore the assigned continent. For Phases 2–5, return to that phase hub and reselect the teacher-assigned continent. Do not guess or choose a new continent. For the final Council, restore the Phase 5 posting first, then reopen Council. The five phase keys are separate.']
];
---

<BaseLayout title="Mission 2190 — Before Students Arrive" description="Concise teacher operations guide for preparing and recovering the year-long Jabberwocky: Mission 2190 experience." themeColor="#071b2e">
  <div class="ops-shell" id="jcec-before-students-arrive">
    <Breadcrumbs items={[
      {label:'Home',href:base},
      {label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},
      {label:'Jabberwocky',href:root},
      {label:'Teacher Master Dashboard',href:dashboard},
      {label:'Before Students Arrive'}
    ]} />

    <header class="hero">
      <div>
        <p class="eyebrow">TEACHER OPERATIONS // MISSION 2190 v1.0</p>
        <h1>BEFORE<br/><span>STUDENTS ARRIVE</span></h1>
        <p>This is an operations resource only. The approved science, missions, assessments, continent canon, storyline and student page structure remain frozen.</p>
      </div>
      <aside><strong>SET UP ONCE</strong><span>then prep one phase at a time</span><strong>FALLBACK FIRST</strong><span>shared · reused · printable · projected</span></aside>
    </header>

    <div class="top-actions">
      <a class="button secondary" href={dashboard}>← Teacher Master Dashboard</a>
      <button class="button primary" id="print-ops" type="button">Print / Save PDF</button>
    </div>

    <nav class="jump-nav" aria-label="Operations sections">
      <a href="#school-year">Before the Year</a>
      <a href="#phases">Before Each Phase</a>
      <a href="#week-one">First Week</a>
      <a href="#inventory">Equipment Inventory</a>
      <a href="#recovery">Quick Recovery</a>
      <a href="#day-one">Day 1 Checklist</a>
    </nav>

    <section class="panel setup-sheet" id="school-year">
      <div class="section-heading"><p class="eyebrow">1 · BEFORE THE SCHOOL YEAR</p><h2>One-page setup checklist</h2><p>Do the durable setup now. Leave mission-specific printing and consumables until the phase that needs them.</p></div>

      <div class="check-grid">
        <label><input type="checkbox"/> Bookmark the <a href={root}>Student Launch</a> and <a href={dashboard}>Teacher Master Dashboard</a>.</label>
        <label><input type="checkbox"/> Open the Student Launch, one phase hub, one mission and the Council on an actual student Chromebook/network.</label>
        <label><input type="checkbox"/> Test one continent posting, refresh the page and confirm it persists on that Chromebook/browser.</label>
        <label><input type="checkbox"/> Tell students to use their normal browser profile, not Guest/Incognito, because phase postings are stored locally on that browser/device.</label>
        <label><input type="checkbox"/> Prepare the Phase 1 student → continent → Team ID roster.</label>
        <label><input type="checkbox"/> Decide the normal Team Record submission mode: paper, digital or both.</label>
        <label><input type="checkbox"/> Test classroom projection and one print-to-PDF / printer route for teacher resources.</label>
        <label><input type="checkbox"/> Create one reusable JCEC equipment bin and five labelled phase folders/envelopes using containers you already have.</label>
        <label><input type="checkbox"/> Keep one teacher master copy of each roster and phase posting assignment so lost localStorage can be restored quickly.</label>
        <label><input type="checkbox"/> Check the five priority equipment items below before buying anything.</label>
      </div>

      <div class="three-grid compact-blocks">
        <article><small>PRINT AHEAD</small><strong>Only the launch essentials</strong><p>Phase 1 continent roster, Week 1 field/lab sheets and any reusable station cards you prefer on paper. Print this operations guide/inventory if a paper clipboard copy helps.</p></article>
        <article><small>DO NOT PRINT YET</small><strong>The whole year</strong><p>Do not stockpile all 25 mission packets. Print later Team Records, source cards and evidence sets as each phase approaches.</p></article>
        <article><small>STORE</small><strong>Simple, not elaborate</strong><p>One central reusable-equipment bin; five phase folders/envelopes for masters/cards; one active-team folder location for current records. Existing boxes are enough.</p></article>
      </div>

      <div class="purchase-block">
        <p class="eyebrow">PURCHASE PRIORITY — ONLY IF YOU DO NOT ALREADY HAVE THEM</p>
        <div class="purchase-list">{purchases.map(([rank,item,use])=><article><b>{rank}</b><div><strong>{item}</strong><span>{use}</span></div></article>)}</div>
        <p class="rule"><strong>Preserve the no-purchase pathway.</strong> These improve convenience; none is required for Mission 2190 to run.</p>
      </div>
    </section>

    <section class="panel" id="phases">
      <div class="section-heading"><p class="eyebrow">2 · BEFORE EACH PHASE</p><h2>Five short prep cards</h2><p>Use these 5–10 minutes at the start of a unit, then open the full Teacher Launch Guide only when you need day-level detail.</p></div>
      <div class="phase-prep-grid">
        {phasePrep.map((item)=>(
          <article class="phase-prep">
            <header><span>PHASE {item.number}</span><div><small>{item.unit}</small><h3>{item.title}</h3></div></header>
            <dl>
              <div><dt>GATHER</dt><dd>{item.gather}</dd></div>
              <div><dt>PRINT NOW</dt><dd>{item.print}</dd></div>
              <div><dt>CAN WAIT</dt><dd>{item.wait}</dd></div>
              <div><dt>NO-PURCHASE FALLBACK</dt><dd>{item.fallback}</dd></div>
            </dl>
            <div class="phase-links"><a href={phase(item.number)}>Student Hub →</a><a href={`${phase(item.number)}teacher-launch-guide/`}>Teacher Launch Guide →</a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="panel" id="week-one">
      <div class="section-heading"><p class="eyebrow">3 · FIRST WEEK / PHASE 1 LAUNCH</p><h2>Exact opening-week sequence</h2><p>Keep the first week moving. The finish line in each row is what matters most.</p></div>
      <div class="week-grid">
        {weekOne.map((item)=>(
          <article class="day-card">
            <header><b>DAY {item.day}</b><div><small>{item.mission}</small><h3>{item.title}</h3></div><a href={item.href}>Open lesson →</a></header>
            <div class="day-fields">
              <div><small>PREPARE</small><p>{item.prep}</p></div>
              <div><small>STUDENTS SEE / DO</small><p>{item.see}</p></div>
              <div><small>SAY / EMPHASIZE</small><p>{item.say}</p></div>
              <div><small>STUDENTS FINISH</small><p>{item.finish}</p></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="panel inventory-panel" id="inventory">
      <div class="section-heading"><p class="eyebrow">4 · EQUIPMENT INVENTORY</p><h2>Reusable whole-year supplies</h2><p>Check one status for each line. “Need to buy” should be rare; most ordinary materials can be found, shared, reused or replaced by the approved fallback.</p></div>
      <div class="inventory-wrap">
        <table>
          <thead><tr><th>ITEM</th><th>ALREADY HAVE</th><th>NEED TO FIND</th><th>NEED TO BUY</th></tr></thead>
          <tbody>{inventory.map(([item,note])=><tr><td><strong>{item}</strong><small>{note}</small></td><td><input type="checkbox" aria-label={`Already have ${item}`}/></td><td><input type="checkbox" aria-label={`Need to find ${item}`}/></td><td><input type="checkbox" aria-label={`Need to buy ${item}`}/></td></tr>)}</tbody>
        </table>
      </div>
      <p class="rule"><strong>Inventory rule:</strong> buy the five priority items only if the school does not already have a workable shared version. Do not create one equipment set per team.</p>
    </section>

    <section class="panel" id="recovery">
      <div class="section-heading"><p class="eyebrow">5 · QUICK RECOVERY GUIDE</p><h2>When the plan breaks</h2><p>Protect the science goal, evidence, team decision and Team Record. Everything else is negotiable.</p></div>
      <div class="recovery-grid">{recovery.map(([problem,response])=><article><strong>{problem}</strong><p>{response}</p></article>)}</div>
    </section>

    <section class="panel day-one" id="day-one">
      <div class="section-heading"><p class="eyebrow">DAY 1 · FINAL READY-CHECK</p><h2>Before students walk in</h2></div>
      <div class="check-grid short">
        <label><input type="checkbox"/> Phase 1 continent + Team ID roster is ready.</label>
        <label><input type="checkbox"/> Student Launch and Phase 1 Mission 1 open successfully on a Chromebook.</label>
        <label><input type="checkbox"/> Projector/display is ready with the Student Launch page.</label>
        <label><input type="checkbox"/> Students know which normal Chromebook/browser profile to use; no Guest/Incognito.</label>
        <label><input type="checkbox"/> I have chosen paper, digital or mixed Team Record collection.</label>
        <label><input type="checkbox"/> Pencils/notebooks or the short starting-prediction sheet are available.</label>
        <label><input type="checkbox"/> I will emphasize: “The preliminary JCEC rating is a starting idea, not the answer.”</label>
        <label><input type="checkbox"/> Day 1 ends when each group has its assigned continent saved and each student has made the short baseline prediction.</label>
        <label><input type="checkbox"/> If technology fails, I will project/share the launch and record the assigned continent on paper rather than postponing the mission.</label>
      </div>
      <div class="day-one-actions"><a class="button primary" href={`${phase(1)}mission-1/`}>Open Day 1 · Mission 1 →</a><a class="button secondary" href={`${phase(1)}teacher-launch-guide/`}>Open Phase 1 Teacher Guide →</a></div>
    </section>
  </div>
</BaseLayout>

<script>
  document.getElementById('print-ops')?.addEventListener('click', () => window.print());
</script>

<style>
