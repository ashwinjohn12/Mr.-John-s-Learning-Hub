---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase4Progress from '../../../../../../components/JcecPhase4Progress.astro';
import { phase4StructuralSites } from '../../../../../../data/jabberwockyPhase4';

const base = import.meta.env.BASE_URL;

const materialIdeas = [
  { icon:'🧱', name:'STRENGTH', detail:'How well a material withstands a load without reaching the agreed failure limit.' },
  { icon:'〰️', name:'FLEXIBILITY', detail:'How much a material can bend or change shape under a specified load.' },
  { icon:'📏', name:'STIFFNESS', detail:'How strongly a material resists deformation under a load.' },
  { icon:'↘️', name:'DEFORMATION', detail:'A change in shape caused by a load.' }
];

const backupData = [
  { material:'Cardstock strip', sameLoad:'200 g', deformation:'14 mm', safeLoad:'300 g' },
  { material:'Corrugated cardboard strip', sameLoad:'200 g', deformation:'7 mm', safeLoad:'500 g' },
  { material:'Flexible recycled plastic strip', sameLoad:'200 g', deformation:'18 mm', safeLoad:'600 g — teacher maximum reached; exact failure strength unknown' }
];

const mission3Cases = {
  gyre: {
    reminder:'Mission 2 showed that snow and other downward loading can create compression in supports and bending in horizontal members.',
    clues:[
      'A horizontal member carrying snow-related loading needs a property that limits excessive bending.',
      'Keeping the habitat lighter can reduce the amount of material and site disturbance on fragile alpine ground.',
      'Connections must stay reliable under the priority load, but controlled movement may be useful only where the structural job actually requires it.'
    ]
  },
  brillig: {
    reminder:'Mission 2 showed that the habitat must carry its normal loads while heavy rainfall can add temporary loading to exposed surfaces.',
    clues:[
      'A wet environment makes durability and dependable connections important properties to consider.',
      'A compact footprint means structural parts must do their jobs without simply using much more material or land.',
      'Some members may need stiffness under bending while some connections may benefit from controlled movement rather than being rigid everywhere.'
    ]
  },
  manxome: {
    reminder:'Mission 2 showed that storm-season external pushes can create tension, compression, shear and bending in different parts and connections.',
    clues:[
      'Connections exposed to changing storm loads may need to resist separation or sliding.',
      'Some structural parts may need both strength and controlled flexibility instead of maximum stiffness.',
      'The best property choice depends on the part\'s job: a connection and a horizontal member may need different behaviours.'
    ]
  },
  'slithy-toves': {
    reminder:'Mission 2 showed that the habitat must carry normal loads and also face established desert storms in an exposed setting.',
    clues:[
      'Material-efficient members are valuable because construction cannot depend on heavy resource use or a huge footprint.',
      'Exposed members may need enough stiffness to limit bending while still meeting the thermal design inherited from Phase 3.',
      'Large day-night temperature changes make it especially important not to assume every connection should behave exactly the same way.'
    ]
  },
  wabe: {
    reminder:'Mission 2 showed that snow loading and long storm conditions can create several internal-force patterns at the same time.',
    clues:[
      'Members carrying snow-related loading may need strong resistance to bending or compression, depending on their job.',
      'Light, efficient parts can reduce repeated disturbance on slow-recovering ground.',
      'Connections should stay dependable under the priority load without adding unnecessary material everywhere.'
    ]
  },
  bandersnatch: {
    reminder:'Mission 2 showed that the compact prairie habitat must carry normal loads while remaining reliable on an exposed site.',
    clues:[
      'A compact design makes efficient use of material especially important.',
      'Some members may need stiffness under bending while other parts may need controlled flexibility across strong seasonal changes.',
      'Joint behaviour should match the part\'s job rather than using the same connection everywhere.'
    ]
  },
  gimble: {
    reminder:'Mission 2 showed that severe winter conditions and a compact forest footprint shape the structure\'s loading problem.',
    clues:[
      'Members carrying winter-related loading may need stiffness and safe load capacity without becoming unnecessarily heavy.',
      'A compact forest site rewards material efficiency rather than simply adding more structural material.',
      'Connections should fit the force pattern while respecting the existing thermal and habitat restrictions.'
    ]
  },
  mimsy: {
    reminder:'Mission 2 showed that the habitat must carry normal structural loads even though the support conditions are unusual.',
    clues:[
      'Keeping the structure relatively light can reduce the load that eventually reaches the wet support system.',
      'Members still need enough stiffness and strength for their job even when material use is kept efficient.',
      'Some connections may need to remain fixed while others may allow controlled movement; foundation design itself waits until Mission 4.'
    ]
  }
};
---

<BaseLayout title="Mission 3: Choose What Holds | Project New Horizon" description="Phase 4 Mission 3: fairly test material properties and joints, analyze load-deformation evidence, and make a structural recommendation." themeColor="#11161d">
  <div class="mission-shell" id="phase4-mission3">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 4', href:`${base}courses/grade-7-science/jabberwocky/phase-4/` },
      { label:'Mission 3' }
    ]} />

    <JcecPhase4Progress active={3} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 4 // MISSION 3 OF 5</p>
        <h1>CHOOSE WHAT <span>HOLDS</span></h1>
        <p class="question">How do materials and joints change what a structure can handle?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How fair tests reveal useful material properties and connection choices</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 3 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Material & Joint Recommendation + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>Knowing the forces is not enough. Different parts need properties and joints that fit their jobs.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 3 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Mission 2 traced the loads and internal forces that could deform your New Horizon habitat. Now JCEC needs evidence about what should resist those forces. Your team will test ordinary material samples fairly, compare how much they deform and how much safe test load they can handle, check when fixed or flexible joints make sense, and recommend the properties that matter most for your site.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon"></span><div><small>YOUR PHASE 4 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>STRUCTURAL CHALLENGE</small><b id="assignment-challenge"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 4 posting is not saved on this device yet.</strong><p>Return to the Phase 4 Hub and confirm the continent your teacher assigned. Do not create a new posting for Mission 3.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-4/`}>Get Phase 4 posting →</a></div>

      <div class="continuity-strip"><strong>FROM MISSION 2</strong><span id="force-reminder">Your Structural Force Map is useful evidence if you have it, but you do not need to recreate it.</span></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>

      <div class="science-grid four">
        {materialIdeas.map((idea) => <article><span>{idea.icon}</span><strong>{idea.name}</strong><p>{idea.detail}</p></article>)}
      </div>

      <div class="misconception-note"><strong>Do not use this shortcut:</strong> “the material that bends least is the strongest.” A sample can be stiff but still fail suddenly. A flexible sample can bend more and still remain useful. <strong>Strength, stiffness and flexibility answer different questions.</strong></div>

      <section class="definitions-block">
        <div><small>OUR CLASSROOM OPERATIONAL DEFINITION</small><strong>FLEXIBILITY</strong><p>For this investigation, flexibility = the amount of deformation under the same specified load.</p></div>
        <div><small>OUR CLASSROOM OPERATIONAL DEFINITION</small><strong>STRENGTH</strong><p>For this investigation, strength = the greatest safe test load handled before the agreed failure limit is reached.</p></div>
      </section>

      <div class="failure-limit"><strong>SAFE FAILURE LIMIT</strong><p>Your teacher will set the stopping rule. It might be permanent bending, deformation past a marked limit, joint separation, or reaching the maximum allowed test load. <b>You do not need to snap or destroy a sample.</b></p></div>

      <div class="joint-grid">
        <article><span>🔒</span><strong>FIXED JOINT</strong><p>Designed to prevent or greatly limit movement.</p></article>
        <article><span>↔️</span><strong>FLEXIBLE JOINT</strong><p>Allows controlled movement where the structural job benefits from it.</p></article>
      </div>
      <p class="joint-question">The question is not “Which joint is strongest?” It is: <strong>Which joint behaviour fits this structural part's job?</strong></p>

      <section class="nature-strip">
        <div class="block-title"><div><small>NATURE'S MATERIALS</small><h3>Living structures do not use one material everywhere</h3></div><span>SHORT CONNECTION</span></div>
        <div class="nature-grid"><article><strong>BONE</strong><span>stiff / strong support</span></article><article><strong>CARTILAGE</strong><span>flexible support</span></article><article><strong>LIGAMENT</strong><span>flexible connection</span></article><article><strong>PLANT TISSUES / LAYERS</strong><span>different materials perform different structural jobs</span></article></div>
        <p>Ask: <strong>Why don't living structures use one material everywhere?</strong></p>
      </section>

      <details class="learn-more"><summary>Need Help? / Learn More</summary><div><h3>Natural and synthetic</h3><p>Natural materials come from living things or Earth materials with limited processing. Synthetic materials are manufactured through human-controlled processes. Neither category is automatically “better”; JCEC cares about the properties needed for a specific structural job.</p><h3>Why don't we use engineering equations?</h3><p>Mission 3 is about controlled evidence and structural reasoning. You do not need stress/strain equations, elastic modulus or advanced engineering mathematics.</p></div></details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Material & Joint Fair Test</h3></div><span>SCIENCE CHECKPOINT</span></div>
        <p>The goal is not to build the best-looking model or make a sample carry the most mass. The goal is to compare materials <strong>fairly</strong> and use the evidence correctly.</p>

        <div class="fair-test-strip"><span><small>CHANGE</small><b>material sample</b></span><i>→</i><span><small>MEASURE</small><b>deformation + greatest safe test load</b></span><i>→</i><span><small>KEEP SIMILAR</small><b>length, width, span, load position and loading method</b></span></div>

        <section class="test-card">
          <div class="test-title"><b>A</b><div><small>FLEXIBILITY / STIFFNESS</small><h3>Same load, compare deformation</h3></div></div>
          <ol><li>Place equal-sized samples across the same support span.</li><li>Apply the <strong>same safe load</strong> at the same position.</li><li>Measure deformation in a consistent way, such as millimetres below the starting line.</li><li>Record: <strong>material → load → deformation.</strong></li></ol>
          <p class="test-note">Less deformation under this same load suggests greater stiffness in this setup. It does <strong>not</strong> automatically prove greater strength.</p>
        </section>

        <section class="test-card">
          <div class="test-title"><b>B</b><div><small>STRENGTH</small><h3>Safe stepped-load test</h3></div></div>
          <ol><li>Begin with a small teacher-approved load.</li><li>Increase the load in small, consistent steps.</li><li>Stop when the agreed failure limit is reached or the teacher maximum is reached.</li><li>Record the greatest safe test load reached.</li></ol>
          <p class="test-note"><strong>Reached the teacher maximum without failing ≠ exact breaking strength.</strong> It only tells you the sample safely handled the maximum used in this classroom test.</p>
        </section>

        <section class="data-panel">
          <div class="block-title"><div><small>DATA DISPLAY</small><h3>Keep it quantitative but manageable</h3></div><span>TABLE + ONE GRAPH</span></div>
          <div class="blank-table"><div class="head"><span>Material</span><span>Test load</span><span>Deformation</span><span>Greatest safe load reached</span></div><div><span>________</span><span>________</span><span>________</span><span>________</span></div><div><span>________</span><span>________</span><span>________</span><span>________</span></div><div><span>________</span><span>________</span><span>________</span><span>________</span></div></div>
          <p>Create one simple <strong>load-versus-deformation graph</strong> using the most useful team or pooled class data. The purpose is to interpret evidence, not make a polished graphing project.</p>
        </section>

        <section class="joint-check">
          <div class="test-title"><b>C</b><div><small>JOINT CHECK</small><h3>Fixed or controlled movement?</h3></div></div>
          <p>Compare one simple fixed connection with one connection that allows controlled movement. Use tape, a loose string loop, a paper hinge, or supplied evidence cards.</p>
          <div class="joint-record"><span>Where would a fixed joint help? __________________________</span><span>Where could controlled flexibility help? __________________</span></div>
        </section>

        <section class="fallback-data">
          <div class="block-title"><div><small>NO-PURCHASE / NOISY-DATA FALLBACK</small><h3>JCEC standardized classroom dataset</h3></div><span>USE IF NEEDED</span></div>
          <p>These are supplied results from one standardized classroom setup. Use them if materials are unavailable or your class data are too noisy to support the reasoning task.</p>
          <div class="fallback-table"><div class="head"><span>Material</span><span>Same flexibility load</span><span>Deformation</span><span>Greatest safe load reached</span></div>{backupData.map((row) => <div><span>{row.material}</span><span>{row.sameLoad}</span><span>{row.deformation}</span><span>{row.safeLoad}</span></div>)}</div>
          <p class="fallback-note"><strong>Notice:</strong> the recycled plastic strip bends the most in the same-load test yet reaches the teacher maximum in the safe-load test. That is why “least bending = strongest” is not a valid shortcut.</p>
        </section>

        <div class="materials-safety">
          <article><small>LOW-MATERIAL VERSION</small><strong>Paper/cardstock · recycled cardboard · rulers · tape · binder clips · coins/washers/books · recycled strips</strong><p>Craft sticks, standardized masses and spring scales are optional, not required.</p></article>
          <article><small>SAFETY LIMITS</small><strong>Desk-sized samples · small loads · teacher maximum · no deliberate snapping</strong><p>No hot glue, knives, saws or tall standing structures are required.</p></article>
        </div>

        <button type="button" class="small-button" id="print-phase4-mission3">Print Material Test + Recommendation</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASSES 3–4</p><h2>Make a Decision</h2></div></div>
      <div class="continent-evidence">
        <div class="block-title"><div><small>YOUR CONTINENT</small><h3>Three material / joint clues</h3></div><span id="evidence-continent">PHASE 4 POSTING</span></div>
        <div id="material-clues" class="clue-grid"><p>Confirm your Phase 4 posting to load the three clues.</p></div>
        <p class="clue-note">Recommend <strong>properties first</strong>. “This member needs stiffness under bending” is stronger reasoning than simply naming a material such as steel or titanium.</p>
      </div>

      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>What material properties and joint type should JCEC prioritize for the most important parts of our structure?</h3>
        <div class="reasoning-frame"><div><strong>CLAIM</strong><span>We recommend a ______ material/property because ______.</span></div><div><strong>TEST DATA</strong><span>Our test showed ______.</span></div><div><strong>APPLICATION</strong><span>This matters because this structural part must resist/do ______.</span></div><div><strong>LIMITATION</strong><span>One limitation of our evidence is ______.</span></div></div>
        <p class="decision-note">Mission 3 is the structural-science checkpoint: use fair evidence, connect it to a property, and explain the structural job. Do not choose the final whole-structure design yet.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> test</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one recommendation</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Material & Joint Recommendation</h3></div><span>CHECKPOINT · EVIDENCE FIRST</span></div>
        <div class="record-grid"><label>Important structural part / job<textarea></textarea></label><label>Required material property or properties<textarea></textarea></label><label>Quantitative test evidence<textarea></textarea></label><label>Where a fixed joint may help<textarea></textarea></label><label>Where controlled flexibility may help<textarea></textarea></label><label>Connection to the priority force / load<textarea></textarea></label><label class="wide">One limitation or uncertainty<textarea></textarea></label></div>
        <p class="assessment-note"><strong>Checkpoint focus:</strong> fair testing → evidence → material-property understanding → structural application. <strong>Not</strong> model appearance and <strong>not</strong> which team's sample held the most mass.</p>
      </div>

      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>Why is the strongest material not automatically the best material for every part of a structure?</h3><p>Everyone answers individually. Use at least one idea about strength, stiffness, flexibility, a joint, or the job of the structural part.</p></div>

      <div class="finished-box"><strong>Mission 3 is finished when:</strong><p>your team has one Material & Joint Recommendation and you have completed your reflection.</p><span>Mission 4 — Keep It Standing remains locked.</span></div>
    </section>

    <section class="class-plan">
      <p class="mini-label">4 × 45-MINUTE CLASSES</p>
      <div class="class-grid"><article><b>1</b><strong>What Makes a Material Useful?</strong><p>Strength, flexibility, stiffness, deformation, operational definitions and fair-test planning.</p></article><article><b>2</b><strong>Test the Materials</strong><p>Same-load deformation test, safe stepped-load test and quantitative data collection.</p></article><article><b>3</b><strong>What Does the Evidence Show?</strong><p>Table/graph, joints, Nature's Materials and three continent clues.</p></article><article><b>4</b><strong>Choose What Holds</strong><p>One recommendation, checkpoint reasoning, Team Record and reflection.</p></article></div>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase4StructuralSites, caseData: mission3Cases }}>
    (() => {
      const POSTING_KEY='jabberwocky-phase4-posting';
      const saved=localStorage.getItem(POSTING_KEY);
      const site=siteData.find((item)=>item.id===saved);
      const assignment=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const clues=document.getElementById('material-clues');
      const caseInfo=saved?caseData[saved]:null;
      if(!site){missing.hidden=false;}
      else{
        assignment.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-challenge').textContent=site.structuralChallenge;
        document.getElementById('evidence-continent').textContent=`${site.icon} ${site.name}`;
        if(caseInfo){document.getElementById('force-reminder').textContent=caseInfo.reminder;clues.innerHTML='';caseInfo.clues.forEach((clue,index)=>{const article=document.createElement('article');article.innerHTML=`<b>${index+1}</b><p>${clue}</p>`;clues.appendChild(article);});}
      }
      document.getElementById('print-phase4-mission3')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
