---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const phase4 = (part = '') => `${base}courses/grade-7-science/jabberwocky/phase-4/${part}`;

const coreDays = [
  { day:1, mission:'Mission 1 — Read the Building Site', title:'What Makes a Structure Successful?', route:'mission-1/', prep:'Assign new Phase 4 teams/continents; open the Phase 4 Hub; gather 4–5 ordinary structure examples or print evidence cards.', materials:'Devices/projector; cardboard box, cup/container, chair/desk or evidence cards; Requirements Card.', student:'Phase launch → new posting → four-card Structural Briefing → function/form/material/performance requirement → frame/shell/frame+shell.', science:'Structures are designed to perform functions. Forms, materials and performance requirements shape design choices.', emphasis:'Students are not designing yet. Keep the job/requirements first.', collect:'Quick classification/requirements notes — formative.', cut:'Use only three detective examples; protect function/form/performance requirement.' },
  { day:2, mission:'Mission 1 — Read the Building Site', title:'Structure Detectives', route:'mission-1/#investigate', prep:'Set shared structure examples/evidence cards; cache the two approved Blackfoot Crossing source cards.', materials:'Ordinary structure examples or printable cards; Blackfoot Crossing source cards; pencils.', student:'Structure Detective routine → natural/manufactured comparison → same-function different-design comparison → short Siksika structure comparison.', science:'Different structural forms and materials can solve similar functions in different ways; structures can change across time and context.', emphasis:'Use only the specific approved Blackfoot Crossing evidence. Do not infer cultural meaning or ask students to reproduce sacred designs.', collect:'Detective table + one culture/time comparison — formative.', cut:'Run 3 stations and one source card pair; skip extra examples.' },
  { day:3, mission:'Mission 1 — Read the Building Site', title:'What Must Our Structure Do?', route:'mission-1/#record', prep:'Confirm continent posting; display three site clues; prepare Requirements Card.', materials:'Device; site clues; Requirements Card.', student:'Read site clues → choose three performance requirements → identify one likely failure point → reflection.', science:'Performance requirements connect a structure’s function to site constraints.', emphasis:'Do not let teams choose the final structural solution yet.', collect:'New Horizon Requirements Card — formative.', cut:'Use teacher-provided sentence starters; keep three requirements + restriction.' },

  { day:4, mission:'Mission 2 — Trace the Forces', title:'What Pushes and Pulls a Structure?', route:'mission-2/', prep:'Prepare mass-vs-force visual; set one force-measurement station if a spring scale exists; print supplied force data as backup.', materials:'String; paper/card; small safe object; 1–3 shared spring scales if available; force-data card.', student:'Mass vs force → N vs g/kg → external load vs internal force → begin four force patterns.', science:'Loads are external pushes/pulls; structural parts develop internal forces. Mass and force are different measurements.', emphasis:'No F=mg. One shared scale is enough.', collect:'Mass/force comparison + first force-pattern notes — formative.', cut:'Teacher demonstrates one force measurement and distribute backup readings.' },
  { day:5, mission:'Mission 2 — Trace the Forces', title:'Forces Inside the Structure', route:'mission-2/#investigate', prep:'Set Force Pattern Stations and friction mini-station.', materials:'String/paper strips; folded card/sponge if available; stacked cards; ruler/cardboard strip; clips; supplied observation cards.', student:'Model tension, compression, shearing and bending → short friction application → record evidence.', science:'Tension pulls, compression squeezes, shear slides, bending curves. Friction can resist sliding at some contacts.', emphasis:'Torsion is optional enrichment only. No snapping materials.', collect:'Force Pattern station sheet — formative.', cut:'Teacher demonstrates one or two patterns; teams use evidence cards for the rest.' },
  { day:6, mission:'Mission 2 — Trace the Forces', title:'What Must Our Structure Resist?', route:'mission-2/#record', prep:'Open three continent force/load clues; prepare Structural Force Map.', materials:'Device; force clues; simple habitat outline/Force Map.', student:'Apply clues → choose one priority load/force → label arrows/internal forces → one likely failure → reflection.', science:'A single external load can create different internal-force effects in different structural parts.', emphasis:'Science diagram, not architectural art.', collect:'Structural Force Map — formative.', cut:'Provide the outline; students add arrows, labels and one evidence statement.' },

  { day:8, mission:'Mission 3 — Choose What Holds', title:'What Makes a Material Useful?', route:'mission-3/', prep:'Prepare equal-size samples; choose safe failure criterion and teacher-set maximum; set fair-test variable table.', materials:'Paper/cardstock; recycled cardboard; optional recycled plastic/craft sticks; rulers; binder clips; small masses; data sheet.', student:'Strength/flexibility/stiffness/deformation → operational definitions → fair-test plan.', science:'Stiffness, flexibility and strength are related but not identical. Fair tests need consistent sample size/span/loading.', emphasis:'Least bending does not automatically mean strongest.', collect:'Fair-test plan + operational definitions — checkpoint evidence in progress.', cut:'Provide the variable table and operational definitions; students identify only what changes/measures/stays similar.' },
  { day:9, mission:'Mission 3 — Choose What Holds', title:'Test the Materials', route:'mission-3/#investigate', prep:'Set standardized spans/loading steps; pre-sort more even samples; prepare backup dataset.', materials:'Equal-size samples; rulers; small safe loads; supports; clips/tape; data sheet.', student:'Same-load deformation test → safe stepped-load strength test → record quantitative evidence.', science:'Flexibility can be compared by deformation under the same load; strength uses an agreed safe failure limit.', emphasis:'Never test to destruction. Reaching teacher maximum does not reveal exact breaking strength.', collect:'Load/deformation data — checkpoint.', cut:'Test fewer materials and use pooled class/backup data.' },
  { day:10, mission:'Mission 3 — Choose What Holds', title:'What Does the Evidence Show?', route:'mission-3/#investigate', prep:'Pool class data; prepare simple graph template; prepare fixed/flexible Joint Check and Nature’s Materials strip.', materials:'Class data; graph template; joint evidence/cards; Nature’s Materials evidence; continent clues.', student:'Create/interpret load-vs-deformation graph → Joint Check → natural/synthetic + bone/cartilage/ligament/plant structure connection → continent clues.', science:'Different structural jobs need different properties and joint behaviours.', emphasis:'Keep Nature’s Materials concise; use it to answer why one material does not fit every job.', collect:'Graph + joint/property notes — checkpoint.', cut:'Teacher provides graph; students interpret one pattern and one limitation.' },
  { day:11, mission:'Mission 3 — Choose What Holds', title:'Choose What Holds', route:'mission-3/#record', prep:'Return test evidence; prepare Material & Joint Recommendation and checkpoint rubric.', materials:'Data/graph; continent clues; Team Record.', student:'Claim → test data → property → application → limitation → reflection.', science:'A defensible material/joint recommendation connects measured evidence to the structural job and force risk.', emphasis:'Assess fair testing, evidence, property understanding and application—not which sample held the most mass.', collect:'Material & Joint Recommendation — stronger checkpoint.', cut:'Accept concise bullet reasoning; cut presentation/polish.' },

  { day:13, mission:'Mission 4 — Keep It Standing', title:'What Makes a Structure Stable?', route:'mission-4/', prep:'Prepare one standardized small baseline model per team or shared station; choose stability comparison and test ceiling.', materials:'Index cards/cardstock; scrap cardboard; tape; binder clips; coins/washers/small masses; string if useful.', student:'Stability → mass distribution/foundation → centre of gravity as support idea → strengthening methods → margin of safety.', science:'Whole-structure stability depends on support, mass distribution and design—not just material strength.', emphasis:'Mission 3 tested parts; Mission 4 tests the whole system.', collect:'Quick stability prediction — formative.', cut:'Use teacher baseline model plus supplied photos/data.' },
  { day:14, mission:'Mission 4 — Keep It Standing', title:'Test the Whole System', route:'mission-4/#investigate', prep:'Set identical/near-identical baseline models; choose one repeatable disturbance; post maximum load.', materials:'Standardized small models; small loads; string/tilt method; evidence sheet.', student:'Compare base/support or high-vs-low mass using one factor at a time → identify a weakness.', science:'Changing foundation width/support or mass location can alter stability.', emphasis:'No strongest/tallest contest. Stop at the teacher ceiling.', collect:'Baseline stability evidence — formative.', cut:'Use shared class model and supplied stability dataset.' },
  { day:15, mission:'Mission 4 — Keep It Standing', title:'Improve and Retest', route:'mission-4/#investigate', prep:'Provide limited improvement materials; require two alternatives before selection.', materials:'Paper/cardboard; tape; clips; same test setup.', student:'Propose two improvements → choose one → modify one main feature → rerun same test → troubleshoot.', science:'Engineering/science improvement uses evidence, alternatives, modification and retesting.', emphasis:'More material is not automatically better. Ask whether the change solved one weakness and created another.', collect:'Before/change/after evidence — formative.', cut:'Teacher supplies two possible improvements; teams choose one and retest.' },
  { day:16, mission:'Mission 4 — Keep It Standing', title:'What Rule Should JCEC Require?', route:'mission-4/#record', prep:'Open three continent stability clues; prepare Safety Protocol.', materials:'Baseline/retest evidence; site clues; Safety Protocol.', student:'Choose one stability rule → foundation/mass rule → strengthening → environmental condition → margin-of-safety rule → reflection.', science:'Safe design combines stability evidence, site conditions and margin of safety.', emphasis:'Do not repeat Mission 3 material recommendation.', collect:'New Horizon Safety Protocol — formative.', cut:'Use sentence starters; keep one rule, one safeguard, one uncertainty.' },

  { day:18, mission:'Mission 5 — Authorize New Horizon', title:'Assemble the Structural System', route:'mission-5/', prep:'Print/project Structural Design Toolkit and six review criteria; prepare relative resource-demand legend.', materials:'Toolkit cards or projected list; paper; pencils; Design Review Matrix.', student:'Review function/reliability/safety/material efficiency/cost-complexity/environment → assemble conceptual system.', science:'A structural system must satisfy multiple performance criteria, not only strength.', emphasis:'Properties first; no required named materials. No final physical habitat build.', collect:'Initial conceptual design choices — synthesis in progress.', cut:'Teacher narrows toolkit to two choices per category.' },
  { day:19, mission:'Mission 5 — Authorize New Horizon', title:'JCEC Design Review', route:'mission-5/#investigate', prep:'Prepare six-part Design Review Matrix.', materials:'Initial design; matrix; pencils/device.', student:'Review six criteria → identify evidence strong enough / concern / possible revision.', science:'Design evaluation considers function, reliability, safety, efficiency, relative construction demand and environment.', emphasis:'Relative cost/complexity only; no real budget math.', collect:'Completed Design Review Matrix — synthesis evidence.', cut:'Review four criteria in class and provide teacher prompts for the final two.' },
  { day:20, mission:'Mission 5 — Authorize New Horizon', title:'Evidence and Revision', route:'mission-5/#investigate', prep:'Open Structural Evidence Locker and continent-specific review concern.', materials:'Evidence Locker; review concern; matrix.', student:'Choose three strongest evidence pieces → receive one continent concern → make one required revision → tentative authorization.', science:'Strong final decisions synthesize requirements, forces, materials and safety evidence and respond to new constraints.', emphasis:'Evidence Locker first; do not send students back through four mission pages.', collect:'Three evidence items + one revision + tentative status.', cut:'Teacher preselects four evidence reminders; teams choose three and explain one revision.' },
  { day:21, mission:'Mission 5 — Authorize New Horizon', title:'Authorize New Horizon', route:'mission-5/#record', prep:'Prepare one-page Structural Authorization and concise scoring guide.', materials:'Evidence Locker; revised design; JCEC New Horizon Structural Authorization.', student:'Choose Proceed / Proceed after modifications / Limit the build / Hold for more evidence → 3–5 sentence why → reflection.', science:'Evidence-based authorization balances structural science, safety, resource demand and environmental responsibility.', emphasis:'Major synthesis: science understanding → evidence use → structural reasoning → safety → environmental responsibility.', collect:'JCEC New Horizon Structural Authorization — major synthesis.', cut:'Use Flex Day 22 for essential completion. Cut gallery walk before reasoning.' }
];

const flexDays = [
  { day:7, title:'Force-station spillover + absence recovery', use:'Finish force measurement/stations, catch absent students, reteach mass vs force or internal-force patterns.', priority:'Protect understanding of N vs g/kg and the four required internal-force patterns.' },
  { day:12, title:'Mission 3 checkpoint recovery', use:'Fair-test rerun, pooled-data troubleshooting, graph completion, Material & Joint Recommendation completion.', priority:'Protect controlled testing and evidence-based checkpoint reasoning.' },
  { day:17, title:'Structures & Forces review / individual check', use:'Vocabulary/science review, targeted reteach, optional short individual science assessment before final synthesis.', priority:'Clarify concepts without adding new content.' },
  { day:22, title:'Structural Authorization completion', use:'Finish Mission 5 synthesis, recover missing evidence, teacher conferences.', priority:'Essential synthesis completion before enrichment.' },
  { day:23, title:'Absence recovery / short individual assessment', use:'Make up missed investigation reasoning or run optional individual science check.', priority:'Individual evidence, not Jabberwocky trivia.' },
  { day:24, title:'Optional Structural Authorization gallery review', use:'Compare why different continents/designs justify different authorization statuses; peer questions.', priority:'Optional—cut before core learning.' },
  { day:25, title:'Final buffer / feedback / transition', use:'Normal school interruptions, final feedback, reteach, make-up and transition planning.', priority:'No Phase 5 student content.' }
];

const materials = [
  { mission:'Mission 1', title:'Structure Detective + authentic Siksika comparison', preferred:'Ordinary classroom objects or 4–5 evidence cards; devices/projector; cached Blackfoot Crossing source cards.', fallback:'Run all stations from photographs/evidence cards. Use the two already-approved Blackfoot Crossing extracts rather than live browsing.', specialty:'None.' },
  { mission:'Mission 2', title:'Force Pattern Stations + force measurement', preferred:'String, paper/card, ruler/cardboard strip, clips, stacked cards, small safe object; 1–3 shared spring scales if already available.', fallback:'One teacher demonstration or no scale at all: use supplied mass/force readings plus internal-force observation cards.', specialty:'Class sets of force meters are unnecessary.' },
  { mission:'Mission 3', title:'Material & Joint Fair Test + graph', preferred:'Equal-size paper/cardstock/recycled cardboard/recycled plastic samples; rulers; binder clips; tape; small classroom masses; graph template.', fallback:'Teacher demonstration + supplied load/deformation dataset + fixed/flexible joint evidence cards.', specialty:'Craft sticks, standardized lab masses or spring scales are optional only.' },
  { mission:'Mission 4', title:'Standardized Stability & Improvement Investigation', preferred:'Index cards/cardstock, scrap cardboard, small tape amount, binder clips, coins/washers/small masses, string if useful.', fallback:'Baseline-model photos/data + stability dataset + before/after strengthening evidence.', specialty:'No structural kits, hot glue, saws or utility knives.' },
  { mission:'Mission 5', title:'Structural Design Review + Structural Authorization', preferred:'Printed/projected toolkit cards, Design Review Matrix, Evidence Locker, one-page Structural Authorization, pencils.', fallback:'Project everything and complete choices on notebook paper.', specialty:'No final physical build is required.' }
];

const contingencies = [
  ['No spring scale available','Use the supplied mass/force readings or one teacher demonstration. The outcome is distinguishing mass/force and reading evidence, not owning a scale.'],
  ['Missing station materials','Replace the physical station with the matching observation/evidence card. Keep the same reasoning question.'],
  ['Noisy or contradictory material-test data','Keep the data visible. Pool class results, compare with backup data, and ask which uncontrolled variable or measurement issue could explain the discrepancy.'],
  ['Uneven material samples','Pre-trim a small standardized set or switch to the backup dataset. Do not pretend unequal samples are a fair material comparison.'],
  ['Student absent during an investigation','Give class/backup data and require the same interpretation/reasoning. Do not recreate a private full lab.'],
  ['A class is lost','Cut presentations, extra examples and polish before cutting the scientific decision or Team Record. Use the nearest flex day.'],
  ['Mission 3 testing runs long','Test fewer materials/loads and pool data. Protect operational definitions and one useful comparison.'],
  ['Graphing takes too long','Provide a partially completed or teacher-generated graph; students interpret the pattern and limitation.'],
  ['Baseline stability models behave differently','Treat the variation as evidence about uncontrolled variables; use one teacher reference model or the fallback dataset for comparison.'],
  ['A model fails before meaningful data are collected','Stop safely, identify why evidence is insufficient, then use the shared/fallback dataset. Do not reward destruction.'],
  ['Students begin competing for maximum load','Stop the test at the posted ceiling and redirect to evidence quality, alternatives and explanation. There is no strongest-model prize.'],
  ['Mission 4 modification/retest runs long','Teacher provides two improvement choices; teams choose one, justify it and use supplied retest evidence if needed.'],
  ['Mission 5 Design Review runs long','Narrow the toolkit and require the six review criteria plus one revision; move final prose to Flex Day 22.'],
  ['Printing/device failure','Project shared materials, copy templates to the board, or use notebook paper. No core task depends on individual devices.']
];

const curriculum = [
  ['Function / performance requirements; frame, shell, frame+shell; same-function variation; natural and manufactured structures','M1','Requirements Card + detective evidence'],
  ['Structures from different cultures/times','M1','Approved Blackfoot Crossing comparison'],
  ['Failure points; mass vs force units; loads; friction; tension, compression, shearing, bending','M1–M2','Force Pattern sheet + Structural Force Map'],
  ['Strength, flexibility, stiffness/deformation; controlled material testing; fixed/flexible joints; natural/synthetic materials; plant/animal structural materials','M3','Load/deformation table + graph + Material & Joint Recommendation'],
  ['Mass distribution; foundations; stability; corrugation, lamination, shape, fastening/bracing; environmental factors; margin of safety','M4','Baseline/retest evidence + Safety Protocol'],
  ['Prototype alternatives; modification/retesting; troubleshooting; qualitative/quantitative evidence; tables/graphs','M3–M4','Checkpoint data + improvement cycle'],
  ['Function, reliability, safety, material efficiency, cost/complexity, environmental impact; evidence-based structural decisions','M5','Design Review Matrix + Structural Authorization']
];
---

<BaseLayout title="Phase 4 Teacher Launch Guide | Project New Horizon" description="Teacher-facing pacing, materials, assessment, contingencies and Alberta Structures & Forces alignment for Phase 4." themeColor="#11161d">
  <div class="teacher-shell" id="phase4-teacher-guide">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 4',href:phase4()},{label:'Teacher Launch Guide'}]} />

    <header class="teacher-hero"><div><p class="eyebrow">PROJECT NEW HORIZON // TEACHER SYSTEM</p><h1>PHASE 4 <span>TEACHER LAUNCH GUIDE</span></h1><p>18 core classes + 7 purposeful flex periods. The teacher system now matches the completed five-mission student experience.</p></div><aside><strong>LOW-MATERIAL RULE</strong><span>ordinary supplies → shared/reused equipment → printables/data fallbacks → specialty equipment only as optional enrichment</span></aside></header>

    <section class="summary-grid"><article><small>CORE</small><b>18</b><span>mission classes</span></article><article><small>FLEX</small><b>7</b><span>purposeful periods</span></article><article><small>CHECKPOINT</small><b>M3</b><span>Material & Joint Recommendation</span></article><article><small>MAJOR SYNTHESIS</small><b>M5</b><span>Structural Authorization</span></article></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">25-PERIOD IMPLEMENTATION</p><h2>Core classes</h2></div><div class="day-list">{coreDays.map((d)=><article class="day-card"><div class="day-title"><span>DAY {d.day}</span><div><small>{d.mission}</small><h3>{d.title}</h3></div><a href={phase4(d.route)}>Student page ↗</a></div><div class="fields"><p><b>BEFORE CLASS</b>{d.prep}</p><p><b>MATERIALS</b>{d.materials}</p><p><b>STUDENTS SEE / DO</b>{d.student}</p><p><b>KEY SCIENCE</b>{d.science}</p><p><b>TEACHER EMPHASIS</b>{d.emphasis}</p><p><b>COLLECT / ASSESS</b>{d.collect}</p><p><b>IF TIME RUNS OUT</b>{d.cut}</p></div></article>)}</div></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">PURPOSEFUL BUFFER</p><h2>Seven flex periods</h2></div><div class="flex-grid">{flexDays.map((d)=><article><b>DAY {d.day}</b><h3>{d.title}</h3><p>{d.use}</p><small>{d.priority}</small></article>)}</div></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">MISSION MATERIALS MASTER LIST</p><h2>Physical version + no-purchase fallback</h2></div><div class="material-list">{materials.map((m)=><article><span>{m.mission}</span><h3>{m.title}</h3><p><b>PREFERRED</b>{m.preferred}</p><p><b>NO-PURCHASE FALLBACK</b>{m.fallback}</p><p><b>OPTIONAL / NOT REQUIRED</b>{m.specialty}</p></article>)}</div><div class="equipment-note"><strong>SPRING-SCALE SHARING PLAN</strong><p>One teacher station or 1–3 shared force meters is enough. Rotate teams through the station while others complete force-pattern tasks. If there is no spring scale, use the supplied force data. Never purchase one per group for this unit.</p></div></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">ASSESSMENT MAP</p><h2>Grade less. Use the evidence that matters.</h2></div><div class="assessment-grid"><article><b>M1</b><h3>Formative</h3><p>Requirements Card</p></article><article><b>M2</b><h3>Formative</h3><p>Structural Force Map</p></article><article class="strong"><b>M3</b><h3>Checkpoint</h3><p>Material & Joint Recommendation</p></article><article><b>M4</b><h3>Formative</h3><p>Safety Protocol</p></article><article class="major"><b>M5</b><h3>Major synthesis</h3><p>Structural Authorization</p></article></div><p class="grading"><strong>Suggested numeric balance if needed:</strong> 30% Mission 3 checkpoint + 55% Mission 5 synthesis + 15% optional individual Structures & Forces science check. If no individual check is used, about 35% / 65% is reasonable. Do not heavily grade every Team Record.</p></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">CONTINGENCY PLAYBOOK</p><h2>Recover without buying more equipment</h2></div><div class="contingency-list">{contingencies.map(([problem,response])=><details><summary>{problem}</summary><p>{response}</p></details>)}</div></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">ALBERTA STRUCTURES & FORCES ALIGNMENT</p><h2>Required science → student evidence</h2></div><p class="source-note">This implementation uses the existing Alberta Science 7–9 Program of Studies, Unit D: Structures & Forces. <a href="https://education.alberta.ca/media/159716/sci7to9.pdf" target="_blank" rel="noreferrer">Official program source ↗</a></p><div class="curriculum-table">{curriculum.map(([outcome,mission,evidence])=><div><strong>{outcome}</strong><span>{mission}</span><p>{evidence}</p></div>)}</div><div class="scope-guard"><strong>KEEP OUT OF THE REQUIRED PATHWAY</strong><span>formal stress/strain equations · torque calculations · beam mathematics · numerical safety-factor calculations · advanced engineering economics · torsion as a required fifth internal-force type</span></div></section>

    <section class="guide-section"><div class="section-head"><p class="eyebrow">AUTHENTIC-SOURCE SAFEGUARD</p><h2>Siksika / Blackfoot Crossing component</h2></div><p>Use only the two specific Blackfoot Crossing Historical Park sources already embedded in Mission 1. Keep the comparison to function, materials and structural solution. Do not generalize, invent cultural meaning, or ask students to reproduce sacred designs.</p><div class="source-links"><a href="https://blackfootcrossing.ca/our-culture/" target="_blank" rel="noreferrer">Blackfoot Crossing — Our Culture ↗</a><a href="https://blackfootcrossing.ca/wp-content/uploads/2025/09/A-Home-for-our-History-V5a-spreads.pdf" target="_blank" rel="noreferrer">Blackfoot Crossing — A Home for Our History ↗</a></div></section>

    <section class="guide-section readiness"><div class="section-head"><p class="eyebrow">TEACHER LAUNCH-READINESS AUDIT</p><h2>Can I launch this tomorrow?</h2></div><div class="ready-grid"><article><b>✓</b><p><strong>Do I know what to prepare tomorrow?</strong><br/>Every core day has an explicit setup field.</p></article><article><b>✓</b><p><strong>Do I know what students should finish each day?</strong><br/>Every day identifies what gets collected or assessed.</p></article><article><b>✓</b><p><strong>Do I know when spring scales/shared equipment are needed?</strong><br/>Only Mission 2 benefits from a scale; one shared station is enough.</p></article><article><b>✓</b><p><strong>Can I run the whole unit without buying specialized equipment?</strong><br/>Yes. Every physical investigation has a printable/data fallback.</p></article><article><b>✓</b><p><strong>Do I know what is formative, checkpoint and major assessment?</strong><br/>M1/M2/M4 formative; M3 checkpoint; M5 synthesis.</p></article><article><b>✓</b><p><strong>Can I recover if a test, model or class goes wrong?</strong><br/>Use the contingency playbook and seven flex periods.</p></article><article><b>✓</b><p><strong>Do Mission 3 and Mission 4 remain different?</strong><br/>M3 tests components/materials; M4 tests whole-system stability and improvement.</p></article><article><b>✓</b><p><strong>Does this stay science-first rather than competition-first?</strong><br/>Yes. Testing ceilings, standardized models and evidence rubrics prevent strongest-model contests.</p></article><article><b>✓</b><p><strong>Do teacher and student systems match?</strong><br/>Five missions, 18 core classes, identical Team Records, assessment roles and final authorization.</p></article></div></section>

    <div class="stop-note"><strong>STOP POINT</strong><span>Phase 4 teacher implementation is complete. Do not begin Phase 5 until the teacher system is approved.</span></div>
  </div>
</BaseLayout>

<style>
:global(body){background:#080b0f}.teacher-shell{max-width:1180px;margin:auto;padding:0 1rem 5rem;color:#e9eef2}.eyebrow{margin:0;color:#f2b35d;font:850 .74rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.teacher-hero{display:grid;grid-template-columns:1fr 320px;gap:1.2rem;margin:1rem 0;padding:2rem;border:1px solid #4e5965;border-radius:22px;background:linear-gradient(145deg,#11171d,#202a33)}.teacher-hero h1{margin:.4rem 0;color:#fff;font-size:clamp(2.3rem,6vw,4.5rem);line-height:.92}.teacher-hero h1 span{display:block;color:#f3b55f}.teacher-hero p{color:#bcc5cd;line-height:1.6}.teacher-hero aside{display:grid;gap:.5rem;align-content:center;padding:1rem;border:1px solid #56616c;border-radius:14px;background:#0d1318}.teacher-hero aside strong{color:#ffd18c}.teacher-hero aside span{color:#aab4bd;line-height:1.5}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem}.summary-grid article{padding:1rem;border:1px solid #424d57;border-radius:13px;background:#11171d}.summary-grid small{color:#f2b35d;font-weight:900}.summary-grid b{display:block;color:#fff;font-size:2rem}.summary-grid span{color:#9faab3}.guide-section{margin:1.3rem 0;padding:1.2rem;border:1px solid #424d57;border-radius:18px;background:#11171d}.section-head h2{margin:.25rem 0 1rem;color:#fff}.day-list{display:grid;gap:.8rem}.day-card{border:1px solid #3e4952;border-radius:13px;background:#0c1217;overflow:hidden}.day-title{display:grid;grid-template-columns:72px 1fr auto;gap:.8rem;align-items:center;padding:.9rem;background:#171f26}.day-title>span{color:#f3b55f;font-weight:900}.day-title small{color:#92a0aa}.day-title h3{margin:.15rem 0;color:#fff}.day-title a{color:#ffd08d}.fields{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem;padding:.8rem}.fields p{margin:0;padding:.7rem;border-radius:9px;background:#111820;color:#b9c3cb;line-height:1.45}.fields b{display:block;margin-bottom:.25rem;color:#f3b55f;font-size:.7rem}.flex-grid,.material-list,.ready-grid{di