---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase4Progress from '../../../../../../components/JcecPhase4Progress.astro';
import { phase4StructuralSites } from '../../../../../../data/jabberwockyPhase4';

const base = import.meta.env.BASE_URL;

const reviewCriteria = [
  { icon:'🎯', name:'FUNCTION', detail:'Does the structural system do the job it is supposed to do?' },
  { icon:'🔁', name:'RELIABILITY', detail:'Can it perform consistently under the expected conditions?' },
  { icon:'🛡️', name:'SAFETY', detail:'Does it account for loads, stability and a margin of safety?' },
  { icon:'🧱', name:'MATERIAL EFFICIENCY', detail:'Does the idea use more structural material than it needs?' },
  { icon:'🧰', name:'CONSTRUCTION COST / COMPLEXITY', detail:'How demanding would the system be to build, maintain or modify?' },
  { icon:'🌱', name:'ENVIRONMENTAL IMPACT', detail:'Does it obey the ecological and site restrictions inherited from earlier teams?' }
];

const toolkit = [
  { title:'STRUCTURAL FORM', choices:['Frame','Shell','Frame + shell'] },
  { title:'SUPPORT APPROACH', choices:['Distributed / wider support','Limited / elevated support','Compact support footprint','Modular / lightweight approach'] },
  { title:'MATERIAL PROPERTIES', choices:['Stiff','Flexible where controlled movement helps','Strong under tension','Strong under compression','Lightweight','Durable'] },
  { title:'CONNECTIONS', choices:['Fixed where movement should be limited','Flexible where controlled movement is useful'] },
  { title:'STRENGTHENING', choices:['Corrugation','Lamination','Component shape','Bracing / improved fastening'] }
];

const authorizationChoices = [
  { icon:'✅', title:'PROCEED', detail:'Current evidence supports the proposed structural system.' },
  { icon:'🔧', title:'PROCEED AFTER REQUIRED MODIFICATIONS', detail:'The general approach is viable, but JCEC requires a specific correction first.' },
  { icon:'⚠️', title:'LIMIT THE BUILD', detail:'Current evidence supports only a smaller, lighter, simpler or temporary structural system.' },
  { icon:'📋', title:'HOLD FOR MORE EVIDENCE', detail:'A critical site or safety question is still unresolved.' }
];

const mission5Cases = {
  gyre: {
    requirement:'A stable, low-disturbance habitat must fit limited uneven alpine ground and tolerate snow/exposure.',
    force:'Snow and exposed conditions can create external loads that lead to compression and bending in different structural parts.',
    material:'Mission 3 evidence should identify properties that resist the priority load without simply adding more material everywhere.',
    safety:'Foundation/support and mass distribution must improve stability while preserving fragile alpine soils and a margin of safety.',
    concern:'Does the proposed support approach still protect fragile alpine soils, or does the design solve stability by disturbing too much ground?'
  },
  brillig: {
    requirement:'A reliable habitat must work in a wet rainforest while keeping the cleared construction footprint small.',
    force:'Ordinary structural loads plus heavy rainfall on exposed surfaces must transfer safely through members and connections.',
    material:'Mission 3 evidence should support material properties and joint behaviours that remain useful for the priority structural jobs.',
    safety:'The whole system must stay stable on a frequently wet site without solving the problem through large canopy clearing.',
    concern:'Does the proposal require more forest clearing or ground disturbance than the inherited ecological restriction allows?'
  },
  manxome: {
    requirement:'A permanent island habitat must remain reliable through the established severe storm season while protecting coastal and freshwater connections.',
    force:'Changing storm-season pushes can create tension, compression, shear and bending in different parts and connections.',
    material:'Mission 3 evidence should support properties and connections suited to the team’s priority storm-related structural job.',
    safety:'The base, connections and mass distribution must work together so changing loads do not make the whole system unstable.',
    concern:'Do the connection and stability rules remain defensible for the established storm season, or is one important weakness still unresolved?'
  },
  'slithy-toves': {
    requirement:'A material-efficient habitat must work on an exposed dry site without heavy fresh-water use or unnecessary land demand.',
    force:'The structure carries ordinary loads while established desert storms can add changing external pushes.',
    material:'Mission 3 evidence should prioritize the properties needed for the chosen force job rather than a named material.',
    safety:'The system needs a practical stability rule and safety margin while remaining compatible with large day-night thermal changes.',
    concern:'Does the plan use an unnecessarily large or resource-heavy construction approach that conflicts with the continent’s water and land limits?'
  },
  wabe: {
    requirement:'A low-disturbance habitat must remain reliable through Arctic cold, snow and long storms.',
    force:'Snow and long storms can create loading beyond ordinary daily conditions while supports and connections experience different internal forces.',
    material:'Mission 3 evidence should support the properties needed to resist the chosen structural load without turning the design into a maximum-material solution.',
    safety:'The whole system needs a defensible margin of safety while repeated rebuilding and ground disturbance remain unacceptable.',
    concern:'Does the design provide a reasonable safety margin for established snow/storm conditions while keeping disturbance to slow-recovering vegetation low?'
  },
  bandersnatch: {
    requirement:'A compact prairie habitat must remain reliable through seasonal conditions without unnecessarily consuming productive soil or habitat.',
    force:'The habitat must carry its own mass, people and equipment while remaining exposed to changing outside conditions.',
    material:'Mission 3 evidence should identify useful properties and connections without assuming that more material automatically means a better structure.',
    safety:'Mass distribution, support and strengthening must improve stability while the footprint remains compact.',
    concern:'Does the footprint or resource demand consume more productive prairie/soil than the structural function actually requires?'
  },
  gimble: {
    requirement:'A compact forest habitat must remain safe through severe winters without fragmenting the surrounding forest.',
    force:'Ordinary structural loads and established winter loading must transfer through the structure safely.',
    material:'Mission 3 evidence should support properties that fit the priority force job while keeping the overall system efficient.',
    safety:'Foundation/support, mass distribution and strengthening must improve reliability without requiring a much larger cleared site.',
    concern:'Does construction create unnecessary forest fragmentation or clearing in order to make the structure easier to support?'
  },
  mimsy: {
    requirement:'A light, stable wetland habitat must be supported on saturated ground without draining the wetland.',
    force:'The structure must carry its own mass, people and equipment while those loads travel through members to a difficult support system.',
    material:'Mission 3 evidence should identify useful properties and joint behaviours without pretending that one named material solves the wetland problem.',
    safety:'Support and mass distribution must improve stability while the no-drainage ecological restriction remains non-negotiable.',
    concern:'Does the support strategy depend on draining, filling or otherwise simplifying the wetland instead of working within the established site restriction?'
  }
};
---

<BaseLayout title="Mission 5: Authorize New Horizon | Project New Horizon" description="Phase 4 Mission 5: synthesize structural evidence and decide what New Horizon system JCEC should authorize." themeColor="#11161d">
  <div class="mission-shell" id="phase4-mission5">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 4', href:`${base}courses/grade-7-science/jabberwocky/phase-4/` },
      { label:'Mission 5' }
    ]} />

    <JcecPhase4Progress active={5} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 4 // MISSION 5 OF 5</p>
        <h1>AUTHORIZE <span>NEW HORIZON</span></h1>
        <p class="question">What structural system should JCEC authorize for this continent?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How to evaluate a structural system using evidence, safety, practicality and environmental responsibility</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 5 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 JCEC New Horizon Structural Authorization + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>A structure is not approved just because it stands up. JCEC must decide whether it is safe, practical and responsible enough to build.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 5 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>JCEC now knows what your habitat must do, which forces matter, what material properties and connections are useful, and what stability rules should protect the whole system. But passing one test is not enough for permanent construction. Your Structural Systems team must assemble a realistic concept, review it against six criteria, respond to one site concern, and decide whether Project New Horizon should be authorized on your continent.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon"></span><div><small>YOUR PHASE 4 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>SITE CHALLENGE</small><b id="assignment-challenge"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 4 posting is not saved on this device yet.</strong><p>Return to the Phase 4 Hub and confirm the continent your teacher assigned. Do not create a new posting for Mission 5.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-4/`}>Get Phase 4 posting →</a></div>

      <div class="inherit-strip"><strong>ONE INHERITED RESTRICTION</strong><span id="ecology-restriction">Your continent’s ecological/site limit will appear here.</span></div>
      <div class="continuity-strip"><strong>MISSIONS 1–4 ALREADY DID THE TESTING</strong><span>You do not need to reopen or copy your old Team Records. Mission 5 gives you a compact Evidence Locker, and you may replace a reminder with stronger real classroom evidence.</span></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="section-lead">Mission 5 does not add a large new vocabulary list. Instead, JCEC uses six review questions to decide whether a structural system deserves authorization.</p>
      <div class="science-grid six">{reviewCriteria.map((criterion) => <article><span>{criterion.icon}</span><strong>{criterion.name}</strong><p>{criterion.detail}</p></article>)}</div>
      <div class="resource-note"><strong>RELATIVE COST / COMPLEXITY ONLY</strong><p>Use simple labels such as <b>LOW / MEDIUM / HIGH resource demand</b> or <b>1 / 2 / 3 JCEC construction units</b>. You are comparing ideas—not calculating real construction budgets or engineering economics.</p></div>
      <details class="learn-more"><summary>Need Help? / Learn More</summary><div><h3>What is reliability?</h3><p>Reliability asks whether a system can keep doing its job under the conditions it was designed for—not just whether it succeeded once.</p><h3>What does material efficiency mean?</h3><p>Using more material can sometimes improve performance, but good structural design tries to meet the requirement without wasting material or creating new problems.</p></div></details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>

      <section class="design-review-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>JCEC Structural Design Review</h3></div><span>CONCEPTUAL REVIEW</span></div>
        <p>This is a <strong>design-review simulation</strong>, not a final construction project. Use evidence to assemble one structural concept, review it, then make one evidence-based revision.</p>

        <div class="toolkit-grid">{toolkit.map((group) => <article><small>{group.title}</small>{group.choices.map((choice) => <span>□ {choice}</span>)}</article>)}</div>
        <div class="property-warning"><strong>PROPERTIES FIRST</strong><p>Choose useful structural <b>properties</b> and behaviours. JCEC has not established that named materials such as steel or titanium are available on your continent.</p></div>
      </section>

      <section class="review-matrix">
        <div class="block-title"><div><small>DESIGN REVIEW MATRIX</small><h3>Six checks before authorization</h3></div><span>CLASS 2</span></div>
        <div class="matrix-table">
          <div class="head"><span>Criterion</span><span>Strong enough evidence?</span><span>Concern</span><span>Possible revision</span></div>
          {reviewCriteria.map((criterion) => <div><strong>{criterion.name}</strong><span>□ yes □ not yet</span><span>________________</span><span>________________</span></div>)}
        </div>
        <p class="matrix-note">Keep each entry short. JCEC needs a useful review, not another engineering report.</p>
      </section>

      <section class="evidence-locker">
        <div class="block-title"><div><small>STRUCTURAL EVIDENCE LOCKER</small><h3>Four reminders. Choose your best three.</h3></div><span>CLASS 3</span></div>
        <p>You do not need to reopen old mission pages. These are reminders, not an answer key. If your real investigation evidence is stronger or different, use that instead.</p>
        <div class="locker-grid">
          <article><small>M1 · REQUIREMENTS</small><strong id="locker-requirement">Site requirement will appear here.</strong></article>
          <article><small>M2 · FORCES</small><strong id="locker-force">Force reminder will appear here.</strong></article>
          <article><small>M3 · MATERIALS</small><strong id="locker-material">Material/joint reminder will appear here.</strong></article>
          <article><small>M4 · SAFETY</small><strong id="locker-safety">Stability/safety reminder will appear here.</strong></article>
        </div>
        <div class="choose-evidence"><strong>OUR 3 STRONGEST PIECES OF EVIDENCE</strong><p>1. ________________________________________________</p><p>2. ________________________________________________</p><p>3. ________________________________________________</p></div>
      </section>

      <section class="review-concern" id="review-concern" hidden>
        <div><small>JCEC REVIEW CONCERN</small><h3 id="concern-continent"></h3></div>
        <p id="concern-text"></p>
        <div class="revision-box"><strong>REQUIRED REVISION</strong><p>What one part of your structural concept will you revise after this concern?</p><p>We will change __________________________________ because __________________________________.</p></div>
      </section>

      <section class="materials-panel"><strong>MATERIALS REALITY CHECK</strong><p>Printable/projected toolkit cards, the Design Review Matrix and pencils are enough. No final large physical habitat, specialty equipment or purchased construction materials are required.</p></section>
      <section class="fallback-panel"><strong>NO-PURCHASE IMPLEMENTATION</strong><p>Project the toolkit and review matrix. Students can record their structural choices on notebook paper, a printed sheet or the website. Mission 5 works even if nothing is physically built.</p></section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="decision-question"><small>ONE TEAM DECISION</small><h3>What structural system should JCEC authorize, and what rules must humans follow when building it?</h3></div>
      <div class="reasoning-chain"><span>STRUCTURAL CHOICE</span><b>→</b><span>EVIDENCE</span><b>→</b><span>FAILURE RISK</span><b>→</b><span>SAFETY RULE</span><b>→</b><span>ENVIRONMENTAL SAFEGUARD</span></div>
      <div class="authorization-grid">{authorizationChoices.map((choice) => <article><span>{choice.icon}</span><strong>{choice.title}</strong><p>{choice.detail}</p></article>)}</div>
      <p class="choice-note">No continent has an automatically correct status. Your authorization depends on the structural system you propose, the evidence you use, and the questions that remain.</p>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="collab-row"><article><b>👥 TEAM WORK</b><span>Review evidence and agree on one authorization.</span></article><article><b>📝 TEAM RECORD</b><span>One person records the team's final structural decision.</span></article><article><b>💭 MY REFLECTION</b><span>Everyone answers one short question.</span></article></div>

      <section class="record-card">
        <div class="record-heading"><div><small>MAJOR PHASE 4 SYNTHESIS</small><h3>JCEC NEW HORIZON STRUCTURAL AUTHORIZATION</h3></div><button type="button" id="print-phase4-mission5">Print / Save PDF</button></div>
        <div class="record-grid">
          <label>CONTINENT / SITE <span id="record-continent">____________________________</span></label>
          <label>STRUCTURE FUNCTION <span>________________________________________</span></label>
          <label>PRIMARY STRUCTURAL FORM <span>__________________________________</span></label>
          <label>MAIN LOAD / FORCE RISK <span>___________________________________</span></label>
          <label>REQUIRED MATERIAL PROPERTIES <span>_____________________________</span></label>
          <label>JOINT / CONNECTION RULE <span>_________________________________</span></label>
          <label>FOUNDATION / STABILITY RULE <span>_____________________________</span></label>
          <label>STRENGTHENING METHOD <span>____________________________________</span></label>
          <label>MARGIN-OF-SAFETY RULE <span>___________________________________</span></label>
          <label class="wide">3 STRONGEST PIECES OF EVIDENCE <span>1. __________________  2. __________________  3. __________________</span></label>
          <label>RELATIVE CONSTRUCTION / RESOURCE DEMAND <span>LOW / MEDIUM / HIGH</span></label>
          <label>ENVIRONMENTAL SAFEGUARD <span>________________________________</span></label>
          <label class="wide">AUTHORIZATION STATUS <span>□ PROCEED &nbsp; □ PROCEED AFTER REQUIRED MODIFICATIONS &nbsp; □ LIMIT THE BUILD &nbsp; □ HOLD FOR MORE EVIDENCE</span></label>
          <label class="wide why">WHY · 3–5 SENTENCES <span>________________________________________________________________________________<br/>________________________________________________________________________________<br/>________________________________________________________________________________</span></label>
        </div>
        <p class="sketch-note"><strong>Optional labelled sketch:</strong> useful if it clarifies your science, but <b>this is not an art or architectural-drawing assessment.</b></p>
      </section>

      <section class="reflection-card"><small>MY REFLECTION</small><h3>What design change could make a structure stronger or easier to build but create a new environmental or safety problem?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>

      <section class="assessment-note"><strong>WHAT YOUR TEACHER IS ASSESSING</strong><span>science understanding → evidence use → structural reasoning → safety → environmental responsibility</span><p>Model or sketch appearance should carry little or no weight.</p></section>

      <div class="finished-box"><strong>PHASE 4 IS FINISHED WHEN:</strong><span>Your team has <b>one JCEC New Horizon Structural Authorization</b> and you have completed <b>your reflection</b>.</span></div>
      <div class="stop-box"><strong>STOP HERE</strong><span>Phase 5 has not been released. Do not create a new posting or begin a new phase yet.</span></div>
    </section>

    <section class="pacing-panel">
      <small>MISSION 5 · FOUR-CLASS PLAN</small>
      <div><article><b>CLASS 1</b><strong>Assemble the Structural System</strong><span>Review criteria + Design Toolkit + initial choices</span></article><article><b>CLASS 2</b><strong>JCEC Design Review</strong><span>Six-part matrix + identify concerns</span></article><article><b>CLASS 3</b><strong>Evidence and Revision</strong><span>Evidence Locker + site concern + one revision + tentative authorization</span></article><article><b>CLASS 4</b><strong>Authorize New Horizon</strong><span>Final record + 3–5 sentence reasoning + reflection</span></article></div>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase4StructuralSites, caseData: mission5Cases }}>
    (() => {
      const KEY='jabberwocky-phase4-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const concern=document.getElementById('review-concern');
      if(saved&&sites[saved]&&caseData[saved]){
        const site=sites[saved], c=caseData[saved];
        result.hidden=false;missing.hidden=true;concern.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-challenge').textContent=site.structuralChallenge;
        document.getElementById('ecology-restriction').textContent=site.previousTeamStructuralBriefing.ecologicalRestriction;
        document.getElementById('locker-requirement').textContent=c.requirement;
        document.getElementById('locker-force').textContent=c.force;
        document.getElementById('locker-material').textContent=c.material;
        document.getElementById('locker-safety').textContent=c.safety;
        document.getElementById('concern-continent').textContent=`${site.icon} ${site.name}`;
        document.getElementById('concern-text').textContent=c.concern;
        document.getElementById('record-continent').textContent=site.name;
      }else{result.hidden=true;missing.hidden=false;concern.hidden=true;}
      document.getElementById('print-phase4-mission5')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
