---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase4Progress from '../../../../../../components/JcecPhase4Progress.astro';
import { phase4StructuralSites } from '../../../../../../data/jabberwockyPhase4';

const base = import.meta.env.BASE_URL;
const sourceCards = [
  {
    label:'AUTHENTIC SIKSIKA SOURCE A · BLACKFOOT CROSSING HISTORICAL PARK',
    title:'Siksika / Blackfoot tipi',
    fact:'Blackfoot Crossing explains that Blackfoot tipis used a four-pole framework and a covering with an opening at the top. When people travelled, the tipi could be collapsed and transported; earlier forms used lighter poles and other coverings.',
    url:'https://blackfootcrossing.ca/our-culture/'
  },
  {
    label:'AUTHENTIC SIKSIKA SOURCE B · BLACKFOOT CROSSING HISTORICAL PARK',
    title:'Blackfoot Crossing Historical Centre',
    fact:'Blackfoot Crossing describes the centre roof as a semicircular arbour made with tall structural-steel poles. The design intentionally recalls lodgepole pine poles used in tipis; other steel elements reference bow strings and travois.',
    url:'https://blackfootcrossing.ca/wp-content/uploads/2025/09/A-Home-for-our-History-V5a-spreads.pdf'
  }
];

const detectiveCards = [
  { icon:'📦', title:'Cardboard box', type:'MANUFACTURED', prompt:'A thin outer surface surrounds and contains objects. What is the job? What form best describes it? Where could it crush, tear or open?' },
  { icon:'🥤', title:'Cup / container', type:'MANUFACTURED', prompt:'A thin outer surface holds material inside. What material property helps it keep its shape? Where might it fail if squeezed or cracked?' },
  { icon:'🪑', title:'Chair or desk frame', type:'MANUFACTURED', prompt:'Connected members carry a person or objects. Which parts form the skeleton? Which connection looks most important?' },
  { icon:'🌿', title:'Plant stem / leaf', type:'NATURAL', prompt:'A living structure must support itself while staying light enough to grow. What part carries or supports the load? Where could damage weaken it?' },
  { icon:'🧺', title:'Open basket / rack', type:'MANUFACTURED', prompt:'An open framework can hold objects without a solid outer wall. When would this be more useful than a closed box?' }
];
---

<BaseLayout title="Mission 1: Read the Building Site | Project New Horizon" description="Phase 4 Mission 1: identify structural functions, forms and performance requirements before designing." themeColor="#11161d">
  <div class="mission-shell" id="phase4-mission1">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 4', href:`${base}courses/grade-7-science/jabberwocky/phase-4/` },
      { label:'Mission 1' }
    ]} />

    <JcecPhase4Progress active={1} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 4 // MISSION 1 OF 5</p>
        <h1>READ THE <span>BUILDING SITE</span></h1>
        <p class="question">What does a structure need to do before we decide how to build it?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How function, form, materials and performance requirements shape a structural decision</strong><small>3 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 1 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 New Horizon Requirements Card + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>JCEC should not start building until it knows what “successful” means on this site.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 1 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Three specialist teams have already studied your continent. Now JCEC wants permanent infrastructure—but your Structural Systems team is <strong>not building yet</strong>. First determine what a small long-term research habitat on this site must actually do. Use the inherited environmental limits, structural science and site evidence to identify three performance requirements. Those requirements will guide every later force, material and stability decision in Project New Horizon.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon"></span><div><small>YOUR PHASE 4 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>STRUCTURAL CHALLENGE</small><b id="assignment-challenge"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 4 posting is not saved on this device yet.</strong><p>Return to the Phase 4 Hub and choose the continent your teacher assigned.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-4/`}>Get Phase 4 posting →</a></div>

      <section class="briefing-mini" id="structural-briefing" hidden>
        <div class="block-title"><div><small>PREVIOUS TEAM STRUCTURAL BRIEFING</small><h3>Four inherited findings</h3></div><span>NO ARCHIVE SEARCH</span></div>
        <div class="briefing-grid">
          <article><small>ENVIRONMENT</small><p id="brief-environment"></p></article>
          <article><small>THERMAL REQUIREMENT</small><p id="brief-thermal"></p></article>
          <article><small>ECOLOGICAL RESTRICTION</small><p id="brief-ecology"></p></article>
          <article><small>SITE / LOAD WARNING</small><p id="brief-site"></p></article>
        </div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Start with the job. A structure is successful when its <strong>form and materials help it meet the requirements of its function.</strong></p>

      <div class="science-grid four">
        <article><span>🎯</span><strong>FUNCTION</strong><p>What the structure is meant to do.</p></article>
        <article><span>🧱</span><strong>FORM</strong><p>How the structure is organized overall.</p></article>
        <article><span>🪵</span><strong>MATERIAL</strong><p>What the parts are made from and what properties those materials bring.</p></article>
        <article><span>✅</span><strong>PERFORMANCE REQUIREMENT</strong><p>Something the structure must be able to do safely and reliably.</p></article>
      </div>

      <section class="forms-block">
        <p class="mini-label">THREE USEFUL STRUCTURAL FORMS</p>
        <div class="forms-grid">
          <article><div class="form-visual frame"><i></i><i></i><i></i><i></i></div><strong>FRAME</strong><p>A skeleton of connected members carries the loads.</p></article>
          <article><div class="form-visual shell"></div><strong>SHELL</strong><p>A thin outer surface encloses space and carries loads through its surface.</p></article>
          <article><div class="form-visual combo"><i></i><i></i></div><strong>FRAME + SHELL</strong><p>A supporting frame works together with an outer covering or surface.</p></article>
        </div>
        <p class="form-note">Natural structures do not always fit a human-made category perfectly. Use the forms as tools for noticing how parts support a job—not as labels you must force onto every example.</p>
      </section>

      <div class="failure-card"><strong>FAILURE POINT</strong><span>A location or feature where a structure may be more likely to deform, separate, tip or fail. Mission 1 only asks you to notice possible weak points. Mission 2 will explain the forces in detail.</span></div>

      <section class="culture-block">
        <div class="block-title"><div><small>STRUCTURES ACROSS TIME &amp; CULTURE</small><h3>One authentic Siksika comparison</h3></div><span>5–10 MINUTES</span></div>
        <p class="culture-intro">Use only what Blackfoot Crossing Historical Park says in its own cultural and architectural materials. Focus on structural science. Do not copy sacred designs or invent cultural meanings.</p>
        <div class="source-grid">
          {sourceCards.map((source) => <article><small>{source.label}</small><h4>{source.title}</h4><p>{source.fact}</p><a href={source.url} target="_blank" rel="noreferrer">Open Blackfoot Crossing source ↗</a></article>)}
        </div>
        <div class="culture-question"><strong>ONE QUESTION</strong><span>Same culture, different time: what changed in the <b>function, materials and structural solution</b>?</span></div>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASS 2</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Structure Detective Investigation</h3></div><span>SHARED STATIONS</span></div>
        <p><strong>Question:</strong> How do different structures use form and materials to perform a job—and where could they fail?</p>
        <div class="repeat-question"><span>WHAT IS ITS JOB?</span><b>→</b><span>WHAT FORM DOES IT USE?</span><b>→</b><span>WHAT MATERIAL MATTERS?</span><b>→</b><span>WHERE MIGHT IT FAIL?</span></div>
        <div class="detective-grid">{detectiveCards.map((card) => <article><span>{card.icon}</span><small>{card.type}</small><h4>{card.title}</h4><p>{card.prompt}</p><div>Job: __________ · Form: __________ · Material: __________ · Possible failure: __________</div></article>)}</div>

        <section class="same-function">
          <p class="mini-label">SAME JOB · DIFFERENT DESIGN</p>
          <h3>Which storage structure better meets the requirement?</h3>
          <div class="compare-grid"><article><strong>A · CLOSED CARDBOARD BOX</strong><p>Thin shell surrounds the contents. Good at containing small loose objects, but airflow and visibility are limited.</p></article><article><strong>B · OPEN FRAME BASKET / RACK</strong><p>Open frame supports contents. Air can move through and contents are visible, but tiny loose objects may escape.</p></article></div>
          <p class="compare-question"><strong>If the requirement is “contain many tiny loose parts,” which design fits better? If the requirement is “maximize airflow and visibility,” which fits better?</strong> Same function does not mean one design is always best.</p>
        </section>

        <div class="fallback-note"><strong>NO-PURCHASE FALLBACK</strong><span>If physical examples are unavailable, use the five evidence cards above. The science question stays exactly the same.</span></div>
        <button type="button" class="small-button" id="print-phase4-mission1">Print Structure Detective + Requirements Card</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="continent-evidence">
        <div class="block-title"><div><small>YOUR BUILDING SITE</small><h3>Three site clues</h3></div><span id="evidence-continent">PHASE 4 POSTING</span></div>
        <div id="site-clues" class="clue-grid"><p>Confirm your Phase 4 posting to load your three clues.</p></div>
      </div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p><h3>What are the three most important performance requirements for our structure?</h3>
        <p class="decision-note">For this prototype, every team is setting requirements for a <strong>small long-term New Horizon research habitat</strong>. You are not choosing the final design yet.</p>
        <div class="reasoning-frame"><div><strong>FUNCTION</strong><span>Our structure must ______.</span></div><div><strong>REQUIREMENT</strong><span>That means it needs to ______.</span></div><div><strong>POSSIBLE FORM</strong><span>A useful structural form might be ______ because ______.</span></div></div>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> decide</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one card</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>
      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>New Horizon Requirements Card</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span>____________________________</span></label>
          <label><strong>STRUCTURE PURPOSE</strong><span>Small long-term research habitat</span></label>
          <label class="wide"><strong>3 PERFORMANCE REQUIREMENTS</strong><span>1. ____________________________________<br/>2. ____________________________________<br/>3. ____________________________________</span></label>
          <label><strong>LIKELY STRUCTURAL FORM(S)</strong><span>____________________________</span></label>
          <label><strong>ONE LIKELY FAILURE POINT</strong><span>____________________________</span></label>
          <label class="wide"><strong>ONE INHERITED ECOLOGICAL / SITE RESTRICTION</strong><span>______________________________________________</span></label>
        </div>
      </div>
      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>Why can two structures with the same purpose have very different designs?</h3><p>Everyone answers individually. Use function, form, material or performance requirement in your answer.</p></div>
      <div class="finished-box"><strong>Mission 1 is finished when:</strong><p>your team has one New Horizon Requirements Card and you have completed your reflection.</p><span>Mission 2 — Trace the Forces remains locked.</span></div>
    </section>

    <section class="class-plan">
      <p class="mini-label">3 × 45-MINUTE CLASSES</p>
      <div class="class-grid"><article><b>1</b><strong>What Makes a Structure Successful?</strong><p>Phase launch, new posting, function/form/material/performance and structural forms.</p></article><article><b>2</b><strong>Structure Detectives</strong><p>Shared investigation, natural/manufactured examples, same-function comparison and authentic Siksika source cards.</p></article><article><b>3</b><strong>What Must Our Structure Do?</strong><p>Three continent clues, three performance requirements, Requirements Card and reflection.</p></article></div>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase4StructuralSites }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase4-posting';
      const saved = localStorage.getItem(POSTING_KEY);
      const site = siteData.find((item) => item.id === saved);
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const briefing = document.getElementById('structural-briefing');
      if (!site) {
        missing.hidden = false;
      } else {
        assignment.hidden = false; briefing.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-subtitle').textContent = site.subtitle;
        document.getElementById('assignment-challenge').textContent = site.structuralChallenge;
        document.getElementById('brief-environment').textContent = site.previousTeamStructuralBriefing.environment;
        document.getElementById('brief-thermal').textContent = site.previousTeamStructuralBriefing.thermalRequirement;
        document.getElementById('brief-ecology').textContent = site.previousTeamStructuralBriefing.ecologicalRestriction;
        document.getElementById('brief-site').textContent = site.previousTeamStructuralBriefing.siteLoadWarning;
        document.getElementById('evidence-continent').textContent = `${site.icon} ${site.name}`;
        const clueBox = document.getElementById('site-clues');
        clueBox.innerHTML = '';
        site.mission1Clues.forEach((clue, index) => {
          const article = document.createElement('article');
          article.innerHTML = `<b>${index + 1}</b><p></p>`;
          article.querySelector('p').textContent = clue;
          clueBox.appendChild(article);
        });
      }
      document.getElementById('print-phase4-mission1')?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

<style>
