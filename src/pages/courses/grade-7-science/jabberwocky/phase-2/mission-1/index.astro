---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Mission 1: Find the Living Resource | Jabberwocky 2190" description="Phase 2 Mission 1: investigate plant structures, functions, adaptations, and useful native plant resources." themeColor="#0b1c16">
  <div class="mission-shell" id="phase2-mission1">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2', href: `${base}courses/grade-7-science/jabberwocky/phase-2/` },
      { label: 'Mission 1' }
    ]} />

    <JcecPhase2Progress active={1} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 2 // MISSION 1 OF 5</p>
        <h1>FIND THE LIVING <span>RESOURCE</span></h1>
        <p class="question">What can this plant provide, and how is it built to survive here?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How plant structures help plants survive</strong>
        <small>3 classes × 45 minutes</small>
      </aside>
    </header>

    <section class="mission-at-a-glance" aria-label="Mission 1 at a glance">
      <div><small>WHERE AM I?</small><strong>Mission 1 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Living Resource Profile + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>JCEC needs to know what humans could use without damaging the ecosystem.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 1 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing">
        <p>Your new Botanical Resources team has inherited ecological evidence from an earlier crew. JCEC has now identified a native plant that may provide food, fibre or useful material. Before anyone harvests or farms it, your team must understand how the plant is built, how its structures help it survive, and what warning the previous team left behind.</p>
      </div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon" aria-hidden="true"></span>
        <div><small>YOUR PHASE 2 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-location"></p></div>
        <div class="plant-badge"><small>RESOURCE PLANT</small><b id="assignment-plant"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden>
        <strong>Your Phase 2 posting is not saved on this device yet.</strong>
        <p>Return to the Phase 2 Hub and choose the continent your teacher assigned.</p>
        <a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Get Phase 2 posting →</a>
      </div>

      <div class="plant-interest" id="plant-interest" hidden>
        <small>WHY JCEC IS INTERESTED</small>
        <strong id="plant-use"></strong>
        <p id="plant-reason"></p>
        <p class="common-name-note" id="common-name-note" hidden></p>
      </div>

      <div class="inherited-warning" id="inherited-warning" hidden>
        <span>⚠️</span><div><small>PREVIOUS TEAM WARNING</small><p id="warning-text"></p></div>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Start with four plant structures. Each structure has a job.</p>
      <div class="science-grid">
        <article><span>🪴</span><strong>Roots</strong><p>Absorb water and materials from the environment and anchor the plant.</p></article>
        <article><span>🌿</span><strong>Stem</strong><p>Supports the plant and helps move water and other materials.</p></article>
        <article><span>🍃</span><strong>Leaves</strong><p>Capture light and help with photosynthesis and gas exchange.</p></article>
        <article><span>🌼</span><strong>Flowers / reproductive structures</strong><p>Help seed plants reproduce and make the next generation.</p></article>
      </div>

      <div class="adaptation-strip"><strong>Adaptation</strong><span>A structure or behaviour that helps an organism survive in its environment.</span></div>

      <div class="plants-matter">
        <strong>Why plants matter</strong>
        <p>Plants make food, support food webs, create habitat and provide materials humans use. A useful plant is still part of an ecosystem.</p>
      </div>

      <details class="help-box">
        <summary>Need help? Match structure to job</summary>
        <div>
          <p><strong>Roots:</strong> think <em>absorb + anchor</em>.</p>
          <p><strong>Stem:</strong> think <em>support + transport</em>.</p>
          <p><strong>Leaves:</strong> think <em>light + food making + gas exchange</em>.</p>
          <p><strong>Flowers / reproductive structures:</strong> think <em>reproduction + seeds</em>.</p>
        </div>
      </details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–2</p><h2>Investigate</h2></div></div>

      <section class="investigation-block earth-plant">
        <div class="block-title"><div><small>CLASS 1</small><h3>Plant Structure Investigation</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> How does each plant structure help a real plant survive?</p>
        <div class="equipment-strip"><strong>You need:</strong><span>one teacher-approved flowering/seed plant</span><span>hand lens if available</span><span>field sheet</span></div>
        <ol class="simple-procedure">
          <li>Observe the whole plant before touching or separating anything.</li>
          <li>Find the <strong>roots, stem, leaves and flower/reproductive structure</strong>.</li>
          <li>Sketch or label each structure on your field sheet.</li>
          <li>For each structure, write its main <strong>job</strong>.</li>
          <li>Choose one structure and explain how its shape or features may help the plant survive.</li>
        </ol>
        <div class="investigation-reminder"><strong>Look closely first.</strong><span>Structure → job → survival.</span></div>
        <button type="button" class="small-button secondary" id="print-phase2-mission1">Print Mission 1 field sheet + profile</button>
      </section>

      <section class="investigation-block jabberwocky-plant">
        <div class="block-title"><div><small>CLASSES 2–3</small><h3>Your Jabberwocky Resource Plant</h3></div><span>TEAM WORK</span></div>
        <p>Now apply the same thinking to the plant on your assigned continent. Use only the four structure clues below.</p>
        <div class="no-continent" id="no-continent"><strong>Phase 2 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Hub →</a></div>
        <div id="plant-files" hidden>
          {phase2PlantSites.map((site) => (
            <article class="plant-file" data-plant-file={site.id} hidden>
              <header><span>{site.icon}</span><div><small>{site.name} · {site.baseCamp}</small><h3>{site.plant.name}</h3><p>{site.plant.resourceUse}</p></div></header>
              {site.plant.commonNameNote && <p class="species-note">🌼 <strong>Important:</strong> {site.plant.commonNameNote}</p>}
              <div class="clue-grid">
                {site.plant.structureClues.map((clue, index) => (
                  <article><b>{index + 1}</b><small>{clue.structure}</small><strong>{clue.clue}</strong><p><span>JOB:</span> {clue.function}</p></article>
                ))}
              </div>
              <div class="adaptation-summary"><small>BIG ADAPTATION IDEA</small><p>{site.plant.adaptation}</p></div>
              <details class="help-box compact-help">
                <summary>Learn More: future production challenge</summary>
                <div><p><strong>Growing challenge:</strong> {site.plant.productionProblem}</p><p><strong>Sustainability warning:</strong> {site.plant.sustainabilityRisk}</p></div>
              </details>
            </article>
          ))}
        </div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which feature of this plant makes it most promising—or most difficult—for humans to use?</h3>
        <div class="reasoning-frame">
          <div><strong>STRUCTURE</strong><span>Name the root, stem, leaf or reproductive feature.</span></div>
          <div><strong>WHY IT HELPS</strong><span>This structure helps the plant because ______.</span></div>
          <div><strong>HUMAN CONNECTION</strong><span>This could make the plant useful / difficult because ______.</span></div>
        </div>
        <p class="decision-note">Choose one feature. You do not need to explain every structure again.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one profile</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Living Resource Profile</h3></div><span>ONE PER TEAM</span></div>
        <p>Your profile needs only these seven pieces.</p>
        <div class="profile-checklist">
          <label><input type="checkbox" /> our continent</label>
          <label><input type="checkbox" /> native resource plant</label>
          <label><input type="checkbox" /> possible human use</label>
          <label><input type="checkbox" /> one important plant structure</label>
          <label><input type="checkbox" /> one adaptation</label>
          <label><input type="checkbox" /> one inherited Phase 1 warning</label>
          <label><input type="checkbox" /> our team's most important finding</label>
        </div>
      </div>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>Which plant structure tells you the most about how this plant survives? Why?</h3>
        <p>Everyone answers this question individually.</p>
      </div>

      <div class="finished-box">
        <strong>Mission 1 is finished when:</strong>
        <span>✓ your team has one Living Resource Profile</span>
        <span>✓ you completed the short individual reflection</span>
        <p>Mission 2 — Keep It Growing — is coming next. Do not start it yet.</p>
        <a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Mission Hub →</a>
      </div>
    </section>

    <section class="print-packet" aria-label="Phase 2 Mission 1 printable packet">
      <section class="print-page">
        <h1>Phase 2 · Mission 1 — Plant Structure Investigation</h1>
        <p>Team: ________________________________ &nbsp; Date: ____________</p>
        <p><strong>Plant:</strong> ________________________________________________</p>
        <table><thead><tr><th>Structure</th><th>What I observe</th><th>Main job</th></tr></thead><tbody><tr><th>Roots</th><td></td><td></td></tr><tr><th>Stem</th><td></td><td></td></tr><tr><th>Leaves</th><td></td><td></td></tr><tr><th>Flower / reproductive structure</th><td></td><td></td></tr></tbody></table>
        <p><strong>Choose one structure. How might its shape or features help the plant survive?</strong></p><div class="writing-lines"></div>
      </section>
      <section class="print-page page-break">
        <h1>Living Resource Profile</h1>
        <p>Continent: ________________________________ &nbsp; Team: ________________________________</p>
        <div class="print-grid two"><div><strong>Native resource plant</strong></div><div><strong>Possible human use</strong></div></div>
        <div class="print-grid two"><div><strong>Important plant structure</strong></div><div><strong>How that structure helps the plant</strong></div></div>
        <div class="print-grid two"><div><strong>One adaptation</strong></div><div><strong>Inherited Phase 1 warning</strong></div></div>
        <p><strong>Our team's most important finding</strong></p><div class="writing-lines tall"></div>
        <p><strong>MY REFLECTION:</strong> Which plant structure tells you the most about how this plant survives? Why?</p><div class="writing-lines tall"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites }}>
    (() => {
      const PHASE2_POSTING_KEY = 'jabberwocky-phase2-posting';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const saved = localStorage.getItem(PHASE2_POSTING_KEY);
      const site = saved ? sites[saved] : null;
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const interest = document.getElementById('plant-interest');
      const warning = document.getElementById('inherited-warning');
      const noContinent = document.getElementById('no-continent');
      const plantFiles = document.getElementById('plant-files');

      if (site) {
        assignment.hidden = false;
        missing.hidden = true;
        interest.hidden = false;
        warning.hidden = false;
        noContinent.hidden = true;
        plantFiles.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-location').textContent = `${site.subtitle} · ${site.baseCamp}`;
        document.getElementById('assignment-plant').textContent = site.plant.name;
        document.getElementById('plant-use').textContent = site.plant.resourceUse;
        document.getElementById('plant-reason').textContent = site.plant.jcecInterest;
        document.getElementById('warning-text').textContent = site.previousTeamBriefing.warning;
        const commonNameNote = document.getElementById('common-name-note');
        if (site.plant.commonNameNote) {
          commonNameNote.hidden = false;
          commonNameNote.textContent = site.plant.commonNameNote;
        } else {
          commonNameNote.hidden = true;
          commonNameNote.textContent = '';
        }
        document.querySelectorAll('[data-plant-file]').forEach((el) => el.hidden = el.dataset.plantFile !== saved);
      } else {
        assignment.hidden = true;
        missing.hidden = false;
        interest.hidden = true;
        warning.hidden = true;
        noContinent.hidden = false;
        plantFiles.hidden = true;
      }

      document.getElementById('print-phase2-mission1')?.addEventListener('click', () => {
        document.body.classList.add('print-phase2-mission1');
        window.print();
      });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-phase2-mission1'));
    })();
  </script>
</BaseLayout>

