---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;

const growthEvidence: Record<string, { focus: string; clues: Array<{ process: string; evidence: string; challenge: string }> }> = {
  gyre: {
    focus: 'Cold temperatures and a short growing season make timing especially important.',
    clues: [
      { process: 'Water uptake', evidence: 'Skyroot grows in thin pockets of mountain soil that can dry quickly between rain or snowmelt.', challenge: 'Roots need access to enough liquid water even when conditions are cold.' },
      { process: 'Photosynthesis', evidence: 'The warm growing season is brief, but summer light can be strong.', challenge: 'The plant has limited time to capture light and make enough food for growth.' },
      { process: 'Germination', evidence: 'Seeds remain inactive through the cold season and begin growing after soils warm.', challenge: 'Starting too early could expose young plants to freezing conditions.' },
      { process: 'Reproduction', evidence: 'Skyroot flowers open quickly during the warmest part of summer.', challenge: 'Humans would need a growing schedule that still allows flowering and seed production.' }
    ]
  },
  brillig: {
    focus: 'Brillig has abundant water, but light, drainage and nutrient movement can still limit growth.',
    clues: [
      { process: 'Photosynthesis', evidence: 'Dense forest vegetation creates deep shade below the canopy.', challenge: 'Cultivated plants still need enough light to make food.' },
      { process: 'Water uptake', evidence: 'Heavy rain keeps soil wet for long periods.', challenge: 'More water is not always better; growing areas need a way to avoid permanently flooded roots.' },
      { process: 'Transport', evidence: 'Frequent rainfall can move dissolved materials through shallow soils quickly.', challenge: 'Plants need water and dissolved materials to remain available to their roots.' },
      { process: 'Reproduction', evidence: 'Rainspout Tree flowers and fruit are normally part of a busy canopy community.', challenge: 'A growing system must still allow successful flowering, pollination and seed production.' }
    ]
  },
  manxome: {
    focus: 'Storms, wind and salt exposure make reliable water balance difficult on the islands.',
    clues: [
      { process: 'Osmosis / water uptake', evidence: 'Coastal soils can receive salty spray during storms.', challenge: 'Too much salt can make it harder for roots to take in water.' },
      { process: 'Transpiration', evidence: 'Strong ocean winds move across exposed islands.', challenge: 'Wind can increase water loss from leaves even when the air is not very hot.' },
      { process: 'Germination', evidence: 'Young Storm Palms establish best in sheltered patches after storms.', challenge: 'Seedlings need enough fresh water and protection while roots develop.' },
      { process: 'Reproduction', evidence: 'Fruits can float between islands.', challenge: 'Humans must plan how to grow the plant without accidentally spreading it into sensitive areas.' }
    ]
  },
  'slithy-toves': {
    focus: 'Water availability is the main challenge, and extra irrigation could also create salt problems.',
    clues: [
      { process: 'Osmosis / water uptake', evidence: 'Fresh water is scarce and surface soil is often extremely dry.', challenge: 'Roots need enough available water for cells to stay hydrated.' },
      { process: 'Transpiration', evidence: 'Hot days and intense sunlight can increase water loss from leaves and stems.', challenge: 'Humans would need to reduce unnecessary water loss.' },
      { process: 'Germination', evidence: 'Reservoir Thorn seeds often begin growing soon after rare rainfall.', challenge: 'Seeds need the right moisture at the right time.' },
      { process: 'Water balance', evidence: 'Repeated irrigation can leave salts behind as water evaporates.', challenge: 'Adding more water could solve one problem while creating a new growing problem.' }
    ]
  },
  wabe: {
    focus: 'Cold temperature and a very short growing season limit when growth and reproduction can happen.',
    clues: [
      { process: 'Water uptake', evidence: 'Only a shallow surface layer of soil thaws during the growing season.', challenge: 'Roots can use liquid water only where the ground has thawed.' },
      { process: 'Photosynthesis', evidence: 'Summer days are long, but temperatures stay cool.', challenge: 'Light may be available while low temperature still slows overall growth.' },
      { process: 'Germination', evidence: 'Ember Moss seeds begin growing only after the surface layer warms.', challenge: 'A protected growing space could extend the time seedlings can grow.' },
      { process: 'Reproduction', evidence: 'The plant flowers and produces seed rapidly during midsummer.', challenge: 'Any human growing plan must leave enough time for the whole life cycle.' }
    ]
  },
  bandersnatch: {
    focus: 'Conditions are favourable, but water timing and seasonal change still matter.',
    clues: [
      { process: 'Photosynthesis', evidence: 'Open prairie provides strong light through a long growing season.', challenge: 'Light is rarely the main limitation for Goldstem Grain.' },
      { process: 'Water uptake', evidence: 'Fresh water is available, but windy periods can dry the upper soil.', challenge: 'Young plants need reliable moisture while roots are small.' },
      { process: 'Transpiration', evidence: 'Persistent prairie winds move air across narrow leaves.', challenge: 'Plants can lose water quickly during warm, windy periods.' },
      { process: 'Germination / reproduction', evidence: 'Seeds survive the cold season and germinate when spring conditions improve.', challenge: 'Humans need to match planting and harvesting to the seasonal life cycle.' }
    ]
  },
  gimble: {
    focus: 'Ironwood has access to water, but young trees compete strongly for light and grow slowly.',
    clues: [
      { process: 'Photosynthesis', evidence: 'Dense forest canopy creates shaded ground below mature trees.', challenge: 'Young Ironwood needs enough light to make food and grow.' },
      { process: 'Transport', evidence: 'Mature trees move water from large roots through tall woody stems to broad leaves.', challenge: 'A growing system must supply enough water for a large plant over many years.' },
      { process: 'Germination', evidence: 'Seedlings establish most successfully in openings where light reaches the forest floor.', challenge: 'Planting location can affect whether a seedling survives its first years.' },
      { process: 'Reproduction', evidence: 'Ironwood takes many years before it produces large numbers of seeds.', challenge: 'Slow reproduction means harvested trees cannot be replaced quickly.' }
    ]
  },
  mimsy: {
    focus: 'Water is abundant, but waterlogged, nutrient-poor conditions create a different set of limits.',
    clues: [
      { process: 'Water uptake', evidence: 'Floatroot grows in saturated mud and shallow water.', challenge: 'Humans do not need to add much water, but they must keep water levels suitable.' },
      { process: 'Photosynthesis / gas exchange', evidence: 'Leaves float or rise above the water surface.', challenge: 'Leaves need access to light and air even when roots are in flooded ground.' },
      { process: 'Transport', evidence: 'Wetland soils contain relatively few available nutrients.', challenge: 'Plants still need dissolved materials for growth even when water is plentiful.' },
      { process: 'Reproduction', evidence: 'Flowers rise above the water and seeds can float to new areas.', challenge: 'A contained growing system may be needed if humans want to control where new plants establish.' }
    ]
  }
};
---

<BaseLayout title="Mission 2: Keep It Growing | Jabberwocky 2190" description="Phase 2 Mission 2: investigate plant needs, transport, photosynthesis, growth and reproduction." themeColor="#0b1c16">
  <div class="mission-shell" id="phase2-mission2">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2', href: `${base}courses/grade-7-science/jabberwocky/phase-2/` },
      { label: 'Mission 2' }
    ]} />

    <JcecPhase2Progress active={2} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 2 // MISSION 2 OF 5</p>
        <h1>KEEP IT <span>GROWING</span></h1>
        <p class="question">What does a plant need to grow and reproduce?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How plants get, move and use what they need</strong>
        <small>4 classes × 45 minutes</small>
      </aside>
    </header>

    <section class="mission-at-a-glance" aria-label="Mission 2 at a glance">
      <div><small>WHERE AM I?</small><strong>Mission 2 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Plant Growth Requirements Card + 1 reflection</strong></div>
      <div><small>WHAT KEEPS RUNNING?</small><strong>Your Growth Trial continues for about 7–10 days. Quick checks are evidence, not new assignments.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 2 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Finding a useful plant does not mean humans know how to keep it alive. JCEC needs your team to learn what plants need, how water and materials move through them, how they make food, and how new plants begin. You will grow Earth plants under two conditions, then use that evidence to decide which growing condition humans must control most carefully on your Jabberwocky continent.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon" aria-hidden="true"></span>
        <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
        <div class="plant-badge"><small>RESOURCE PLANT</small><b id="assignment-plant"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden>
        <strong>Your Phase 2 posting is not saved on this device yet.</strong>
        <p>Return to the Phase 2 Hub and choose the continent your teacher assigned.</p>
        <a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Get Phase 2 posting →</a>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASSES 1–3</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Six science words, but only three jobs to remember.</p>

      <div class="process-story">
        <article>
          <div class="process-title"><span>1</span><div><small>JOB 1</small><h3>GET MATERIALS</h3></div></div>
          <div class="term"><strong>Diffusion</strong><p>Particles spread from an area where there are more of them toward an area where there are fewer.</p></div>
          <div class="term"><strong>Osmosis</strong><p>Water moves across a cell membrane toward an area with less available water.</p></div>
          <p class="why">Plants use these kinds of movement as water and dissolved materials enter and move between cells.</p>
        </article>
        <article>
          <div class="process-title"><span>2</span><div><small>JOB 2</small><h3>MOVE WATER & MATERIALS</h3></div></div>
          <div class="term"><strong>Conduction / transport</strong><p>Water and dissolved materials move from roots through internal transport tissues toward stems and leaves.</p></div>
          <div class="term"><strong>Transpiration</strong><p>Water leaves the plant from leaf surfaces as water vapour.</p></div>
          <p class="why">Water entering roots, moving upward and leaving leaves is part of one connected pathway.</p>
        </article>
        <article>
          <div class="process-title"><span>3</span><div><small>JOB 3</small><h3>MAKE FOOD & EXCHANGE GASES</h3></div></div>
          <div class="term"><strong>Photosynthesis</strong><p>Plants use light, water and carbon dioxide to make food. Oxygen is released.</p></div>
          <div class="term"><strong>Gas exchange</strong><p>Carbon dioxide can enter leaves and oxygen can leave through tiny openings.</p></div>
          <p class="formula">light + water + carbon dioxide → food + oxygen</p>
        </article>
      </div>

      <div class="life-cycle">
        <p class="mini-label">MAKING THE NEXT GENERATION</p>
        <div class="cycle-row"><span>🌰 <strong>Seed</strong></span><i>→</i><span>🌱 <strong>Germination</strong></span><i>→</i><span>🪴 <strong>Seedling</strong></span><i>→</i><span>🌿 <strong>Mature plant</strong></span><i>→</i><span>🌼 <strong>Flowers / seeds</strong></span></div>
        <p><strong>Propagation</strong> means making new plants. Seeds are one method; some plants can also start from cuttings, runners or other plant parts.</p>
      </div>

      <details class="help-box">
        <summary>Learn More: what are the plant's transport tubes?</summary>
        <div><p>Plants have specialized tissues that move water, minerals and sugars. You may hear the words <strong>xylem</strong> and <strong>phloem</strong>. For this mission, you only need the bigger idea: materials move through transport tissues inside the plant.</p></div>
      </details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–4 + QUICK CHECKS</p><h2>Investigate</h2></div></div>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 1</small><h3>JCEC Growth Trial</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> What changes when one important growing condition changes?</p>
        <div class="trial-design"><div><small>CONTROL</small><strong>Normal growing conditions</strong></div><div><small>CHANGED CONDITION</small><strong>Your teacher chooses one condition for the whole class</strong></div></div>

        <label class="condition-picker" for="trial-condition"><span>Record the condition your teacher chose:</span><select id="trial-condition"><option value="">Choose the teacher-assigned condition…</option><option>Reduced water</option><option>Mild salinity</option><option>Reduced light</option><option>Other teacher-assigned condition</option></select></label>
        <p class="save-status" id="condition-status" aria-live="polite"></p>

        <ol class="simple-procedure">
          <li>Label two growing containers: <strong>CONTROL</strong> and <strong>CHANGED</strong>.</li>
          <li>Use the same seed type, number of seeds and growing medium in both.</li>
          <li>Give the control normal conditions. Change only the condition your teacher assigned in the second container.</li>
          <li>Place both containers where your teacher directs and record the starting setup.</li>
          <li>On observation days, spend only <strong>3–5 minutes</strong> recording germination, height, leaf number and visible health.</li>
        </ol>
        <div class="fair-test"><strong>Fair test:</strong><span>Change one condition. Keep the other important conditions as similar as possible.</span></div>
        <div class="background-note"><strong>🌱 Your plants keep growing after today's class.</strong><span>Quick observations are evidence for this mission and Mission 3. They are not separate assignments or submissions.</span></div>
        <button type="button" class="small-button" id="print-phase2-mission2">Print Growth Trial sheet + Team Record</button>
      </section>

      <section class="investigation-block demo-block">
        <div class="block-title"><div><small>CLASS 2 · SHORT TEACHER DEMO</small><h3>Watch Water Move</h3></div><span>5–10 MIN</span></div>
        <p>Your teacher may place a cut stem or celery stalk in coloured water. Watch for colour moving upward. This is a quick model of <strong>transport through the plant</strong>—not another lab to hand in.</p>
      </section>

      <section class="investigation-block continent-block">
        <div class="block-title"><div><small>CLASS 4</small><h3>What Will Work on Your Continent?</h3></div><span>TEAM WORK</span></div>
        <p>Use the Earth Growth Trial, then read only four clues about your resource plant. Look for a connection between a <strong>plant process → environmental condition → growing challenge</strong>.</p>
        <div class="no-continent" id="no-continent"><strong>Phase 2 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Hub →</a></div>
        <div id="continent-files" hidden>
          {phase2PlantSites.map((site) => {
            const evidence = growthEvidence[site.id];
            return (
              <article class="continent-file" data-continent-file={site.id} hidden>
                <header><span>{site.icon}</span><div><small>{site.name} · {site.baseCamp}</small><h3>{site.plant.name}</h3><p>{evidence.focus}</p></div></header>
                <div class="clue-grid">
                  {evidence.clues.map((clue, index) => <article><b>{index + 1}</b><small>{clue.process}</small><strong>{clue.evidence}</strong><p><span>GROWING CHALLENGE:</span> {clue.challenge}</p></article>)}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which growing condition will humans need to control most carefully on your continent?</h3>
        <div class="reasoning-frame"><div><strong>EARTH EVIDENCE</strong><span>When ______ changed, ______ changed.</span></div><div><strong>WHAT IT SUGGESTS</strong><span>This suggests the plant needs ______.</span></div><div><strong>JABBERWOCKY CONNECTION</strong><span>On our continent, this matters because ______.</span></div></div>
        <p class="decision-note">Use the evidence you have now. You do not need a full CER.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one card</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Plant Growth Requirements Card</h3></div><span>ONE PER TEAM</span></div>
        <p>Your card needs only these seven pieces.</p>
        <div class="profile-checklist"><label><input type="checkbox" /> continent</label><label><input type="checkbox" /> resource plant</label><label><input type="checkbox" /> most important growing condition</label><label><input type="checkbox" /> Growth Trial evidence</label><label><input type="checkbox" /> one important plant process</label><label><input type="checkbox" /> one growth/reproduction requirement</label><label><input type="checkbox" /> how this applies to the continent</label></div>
      </div>

      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>Which plant process surprised you most, and why does the plant need it?</h3><p>Everyone answers this question individually.</p></div>

      <div class="finished-box"><strong>Mission 2 is finished when:</strong><span>✓ your team has one Plant Growth Requirements Card</span><span>✓ you completed the short individual reflection</span><p>Keep the Growth Trial growing if your teacher tells you to. Later observations will become evidence for Mission 3.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Mission Hub →</a></div>
    </section>

    <section class="print-packet" aria-label="Phase 2 Mission 2 printable packet">
      <section class="print-page">
        <h1>Phase 2 · Mission 2 — JCEC Growth Trial</h1>
        <p>Team: ____________________________ &nbsp; Changed condition: ____________________________</p>
        <p><strong>Fair test:</strong> Change one condition. Keep the other important conditions as similar as possible.</p>
        <table><thead><tr><th>Date / Day</th><th>Control: germination</th><th>Control: height</th><th>Control: leaves + health</th><th>Changed: germination</th><th>Changed: height</th><th>Changed: leaves + health</th></tr></thead><tbody>{['Start','Check 1','Check 2','Check 3','Final check'].map((label) => <tr><th>{label}</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>)}</tbody></table>
        <p><strong>What changed most between the control and changed condition?</strong></p><div class="writing-lines"></div>
      </section>
      <section class="print-page page-break">
        <h1>Plant Growth Requirements Card</h1>
        <p>Continent: ____________________________ &nbsp; Resource plant: ____________________________</p>
        <div class="print-grid two"><div><strong>Most important growing condition</strong></div><div><strong>One important plant process</strong></div></div>
        <div class="print-grid two"><div><strong>Growth Trial evidence</strong></div><div><strong>One growth / reproduction requirement</strong></div></div>
        <p><strong>How this applies to our continent</strong></p><div class="writing-lines tall"></div>
        <p><strong>Reasoning:</strong> When __________ changed, __________ changed. This suggests the plant needs __________. On our continent, this matters because __________.</p><div class="writing-lines tall"></div>
        <p><strong>MY REFLECTION:</strong> Which plant process surprised you most, and why does the plant need it?</p><div class="writing-lines tall"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase2-posting';
      const CONDITION_KEY = 'jabberwocky-phase2-growth-condition';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const saved = localStorage.getItem(POSTING_KEY);
      const site = saved ? sites[saved] : null;
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const noContinent = document.getElementById('no-continent');
      const continentFiles = document.getElementById('continent-files');

      if (site) {
        assignment.hidden = false; missing.hidden = true; noContinent.hidden = true; continentFiles.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-environment').textContent = site.previousTeamBriefing.environment;
        document.getElementById('assignment-plant').textContent = site.plant.name;
        document.querySelectorAll('[data-continent-file]').forEach((el) => el.hidden = el.dataset.continentFile !== saved);
      } else {
        assignment.hidden = true; missing.hidden = false; noContinent.hidden = false; continentFiles.hidden = true;
      }

      const picker = document.getElementById('trial-condition');
      const status = document.getElementById('condition-status');
      const savedCondition = localStorage.getItem(CONDITION_KEY);
      if (savedCondition) picker.value = savedCondition;
      picker?.addEventListener('change', () => {
        if (picker.value) { localStorage.setItem(CONDITION_KEY, picker.value); status.textContent = `✓ Growth Trial condition saved: ${picker.value}`; }
        else { localStorage.removeItem(CONDITION_KEY); status.textContent = ''; }
      });

      document.getElementById('print-phase2-mission2')?.addEventListener('click', () => { document.body.classList.add('print-phase2-mission2'); window.print(); });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-phase2-mission2'));
    })();
  </script>
</BaseLayout>

