---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;

type FootprintCase = {
  productionGoal: string;
  productionChallenge: string;
  zones: string[];
  constraints: string[];
  consequence: string;
  consequenceMeaning: string;
  growthEvidence: string;
  growingZoneEvidence: string;
  varietyEvidence: string;
};

const footprintCases: Record<string, FootprintCase> = {
  gyre: {
    productionGoal: 'Supply a small JCEC station using no more than two growing or harvest zones.',
    productionChallenge: 'Cold conditions, thin soils and very little flat growing land.',
    zones: ['Stable terrace', 'Alpine habitat', 'Freshwater channel', 'Erosion-prone slope', 'Base camp', 'Valley growing pocket'],
    constraints: ['Keep the erosion-prone slope undeveloped.', 'Protect the valley vegetation connection used by native animals.', 'Use water carefully; mountain soil can drain quickly.'],
    consequence: 'A week of heavy rain hits after construction.',
    consequenceMeaning: 'Disturbed thin soil begins moving downhill and muddy water reaches the channel. Revise one part of your plan to reduce erosion.',
    growthEvidence: 'Cold and a short growing season limit growth; warmth and a stable root zone matter.',
    growingZoneEvidence: 'Contained or protected growing can create deeper, warmer root conditions without stripping fragile slopes.',
    varietyEvidence: 'Cold or short-season traits are useful, but strong anchoring must remain part of the plan.'
  },
  brillig: {
    productionGoal: 'Produce fruit, seed and fibre for one JCEC outpost without opening a large plantation.',
    productionChallenge: 'Heavy rain, drainage problems and nutrient loss if forest is cleared.',
    zones: ['Existing clearing', 'Dense canopy habitat', 'Stream edge', 'Wet low ground', 'Base camp', 'Stable raised ground'],
    constraints: ['Use existing clearings before removing forest.', 'Keep a protected buffer beside the stream.', 'Plan for heavy rainfall and drainage.'],
    consequence: 'Several weeks of heavy rain arrive.',
    consequenceMeaning: 'Water carries soil and fertilizer from an exposed growing area toward the stream. Revise one part of your plan to reduce runoff.',
    growthEvidence: 'Water is abundant, but roots still need drainage and leaves may remain wet for long periods.',
    growingZoneEvidence: 'Contained or raised growing can improve drainage while reducing the need for forest clearing.',
    varietyEvidence: 'Production traits are useful, but disease resistance and plant variety matter in warm, humid conditions.'
  },
  manxome: {
    productionGoal: 'Supply food, oil and fibre while keeping the island system ready for severe storms.',
    productionChallenge: 'Salt exposure, storms and vulnerable young plants.',
    zones: ['Sheltered inland site', 'Coastal habitat', 'Freshwater catchment', 'Storm-exposed ridge', 'Base camp', 'Storage / processing pad'],
    constraints: ['Protect the freshwater catchment.', 'Keep sensitive coastal habitat connected.', 'Place vulnerable infrastructure away from the storm-exposed ridge.'],
    consequence: 'A severe storm pushes salt spray far inland.',
    consequenceMeaning: 'Young plants and one access route are damaged. Revise the plan so the system can recover without expanding into protected habitat.',
    growthEvidence: 'Young plants need fresh water and protection while they establish in salty, storm-prone conditions.',
    growingZoneEvidence: 'Protected or contained growing gives humans more control over salt, wind and drainage.',
    varietyEvidence: 'Storm and salt tolerance may matter more than maximum yield in exposed areas.'
  },
  'slithy-toves': {
    productionGoal: 'Produce useful seed, food and fibre while using as little scarce fresh water as possible.',
    productionChallenge: 'Extreme water scarcity and the risk of salt buildup from irrigation.',
    zones: ['Dry upland', 'Native oasis habitat', 'Freshwater well', 'Salt-prone flat', 'Base camp', 'Contained growing pad'],
    constraints: ['Do not develop the native oasis habitat.', 'Use no more than one water-access tile.', 'Include a way to reduce evaporation or salt buildup.'],
    consequence: 'A long drought cuts available fresh water in half.',
    consequenceMeaning: 'The original water plan can no longer be maintained. Revise one part of the footprint to reduce demand.',
    growthEvidence: 'Water is the major limiting condition; excessive irrigation can also leave salts behind.',
    growingZoneEvidence: 'Slow delivery, covered soil or contained root zones can reduce water loss.',
    varietyEvidence: 'Drought and salt tolerance can reduce water demand; selecting only for high yield may do the opposite.'
  },
  wabe: {
    productionGoal: 'Produce seed and insulating fibre without damaging the slow-recovering natural plant mats.',
    productionChallenge: 'A very short growing season and persistently cold conditions.',
    zones: ['Protected growing pad', 'Natural Ember Moss mat', 'Seasonal wet ground', 'Freshwater / ice access', 'Base camp', 'Wind-exposed ground'],
    constraints: ['Keep the natural mat protected.', 'Limit heated/protected growing to one main production zone.', 'Avoid repeated disturbance of slow-recovering ground.'],
    consequence: 'An unexpected cold snap arrives during flowering.',
    consequenceMeaning: 'Part of the production zone loses flowers. Revise the plan so one unusual cold event does not end the entire resource supply.',
    growthEvidence: 'Temperature and season length are major limits even when summer light is available.',
    growingZoneEvidence: 'Protected, raised or contained growing can warm the root zone without harvesting natural mats.',
    varietyEvidence: 'Short-season growth is useful, but cold tolerance and some variety still protect the crop.'
  },
  bandersnatch: {
    productionGoal: 'Produce grain and fibre while keeping prairie soil, water and habitat functioning.',
    productionChallenge: 'Excellent growing potential, but large-scale farming can damage soil, water and biodiversity.',
    zones: ['Productive field', 'Native prairie habitat', 'Stream', 'Wind-exposed field', 'Base camp', 'Buffer / shelter strip'],
    constraints: ['Keep a connected area of native prairie.', 'Protect the stream with a buffer.', 'Do not leave all production soil bare and exposed.'],
    consequence: 'A dry summer is followed by a new insect pest.',
    consequenceMeaning: 'Water demand rises and similar plants are damaged quickly. Revise the plan to protect soil and reduce the chance that one problem affects everything.',
    growthEvidence: 'Strong growth is possible, but water can become limiting during dry periods.',
    growingZoneEvidence: 'Targeted irrigation, soil cover and buffers can support growth while reducing erosion.',
    varietyEvidence: 'High yield is useful, but drought/pest resistance and plant variety improve resilience.'
  },
  gimble: {
    productionGoal: 'Provide useful Ironwood fibre and timber without removing forest faster than it can recover.',
    productionChallenge: 'Slow tree growth, forest competition and a long replacement time.',
    zones: ['Mature forest', 'Nursery / young forest', 'Stream corridor', 'Steep forest slope', 'Base camp', 'Processing / storage site'],
    constraints: ['Do not clear the mature forest as the main production strategy.', 'Keep the stream corridor protected.', 'Plan for replacement before harvest expands.'],
    consequence: 'A bark-boring insect appears in the nursery.',
    consequenceMeaning: 'Many similar young trees are damaged. Revise the plan to protect long-term supply without cutting more mature forest.',
    growthEvidence: 'Ironwood grows slowly and needs enough light and suitable forest soil to establish.',
    growingZoneEvidence: 'A nursery-style starting system can support young trees while natural forest remains intact.',
    varietyEvidence: 'Faster growth may shorten production time, but wood strength, pest resistance and variety remain important.'
  },
  mimsy: {
    productionGoal: 'Produce seed and fibre without draining or fragmenting the wetland.',
    productionChallenge: 'Saturated, nutrient-poor ground and the danger of changing wetland water flow.',
    zones: ['Wetland core', 'Raised growing platform', 'Water channel', 'Sensitive habitat', 'Base camp', 'Dry margin'],
    constraints: ['Do not drain the wetland core.', 'Keep natural water flow through the channel.', 'Contain added nutrients and cultivated plants.'],
    consequence: 'A storm raises water levels and washes nutrients from one growing area.',
    consequenceMeaning: 'Nutrient-rich water begins moving toward sensitive habitat. Revise one part of the plan to contain the production system.',
    growthEvidence: 'Floatroot tolerates saturated ground, but nutrient availability is limited.',
    growingZoneEvidence: 'Raised or contained systems can add useful growing material without draining the surrounding wetland.',
    varietyEvidence: 'Waterlogging tolerance and nutrient efficiency are useful; containment remains important if high-production plants spread.'
  }
};
---

<BaseLayout title="Mission 5: Use It Without Losing It | Jabberwocky 2190" description="Phase 2 Mission 5: synthesize plant-resource evidence and recommend a sustainable way to use a Jabberwocky plant resource." themeColor="#0b1c16">
  <div class="mission-shell" id="phase2-mission5">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2', href: `${base}courses/grade-7-science/jabberwocky/phase-2/` },
      { label: 'Mission 5' }
    ]} />

    <JcecPhase2Progress active={5} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 2 // MISSION 5 OF 5</p>
        <h1>USE IT <span>WITHOUT LOSING IT</span></h1>
        <p class="question">How can humans use plant resources without damaging the system they depend on?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How to make a sustainable plant-resource decision from evidence</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance" aria-label="Mission 5 at a glance">
      <div><small>WHERE AM I?</small><strong>Final mission of Phase 2</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 JCEC Living Resource Plan + 1 reflection</strong></div>
      <div><small>BIG QUESTION</small><strong>Can we keep producing the resource without damaging the system?</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 5 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>JCEC now knows what your plant can provide, what it needs, how humans might grow it and which traits could help. The final problem is scale. More production can mean more land, water, fertilizer, pest control, roads and harvesting. Your team must design a small resource footprint, test it against one new consequence, and decide the safest realistic way humans should use this plant without damaging the system that makes it possible.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon" aria-hidden="true"></span>
        <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-warning"></p></div>
        <div class="plant-badge"><small>RESOURCE PLANT</small><b id="assignment-plant"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 2 posting is not saved on this device yet.</strong><p>Return to the Phase 2 Hub and choose the continent your teacher assigned.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Get Phase 2 posting →</a></div>
      <div class="challenge-strip" id="challenge-strip" hidden><small>PRODUCTION CHALLENGE</small><strong id="challenge-text"></strong></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Mission 5 adds very little new vocabulary. It asks you to use science you already learned to judge a bigger human plan.</p>
      <div class="science-grid">
        <article><span>🗺️</span><strong>LAND USE</strong><p>Farms, plantations, roads and processing areas can change habitats, soil and water. More developed land usually means less natural land left unchanged.</p></article>
        <article><span>💧</span><strong>PRODUCTION INPUTS</strong><p>Irrigation, fertilizer and pest management can improve production, but each can also create unintended effects when overused or poorly placed.</p></article>
        <article><span>🌾</span><strong>VARIETY &amp; RESILIENCE</strong><p>Productive systems still need enough variety and safeguards to cope with pests, unusual weather and changing conditions.</p></article>
        <article><span>♻️</span><strong>SUSTAINABILITY</strong><p>A sustainable system meets human needs without using resources or damaging ecosystems faster than they can recover.</p></article>
      </div>
      <div class="big-distinction"><div><small>QUESTION 1</small><strong>Can we produce this resource?</strong></div><span>≠</span><div><small>QUESTION 2</small><strong>Can we keep producing it without damaging the system?</strong></div></div>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>

      <section class="investigation-block footprint-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Production Footprint Challenge</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> Can we meet a human resource need and still protect the conditions the plant and ecosystem depend on?</p>
        <ol class="simple-procedure">
          <li>Open only your continent case. Read the production goal, six map zones and three constraints.</li>
          <li>Place a small set of planning tiles: <strong>growing/harvest, protected habitat, water access, road/infrastructure, processing/storage, buffer/protection</strong>.</li>
          <li>Build one plan that meets the goal while obeying all three constraints.</li>
          <li>When your teacher says <strong>REVEAL</strong>, open the consequence card.</li>
          <li>Revise exactly one part of the plan and explain why that change makes the system safer or more sustainable.</li>
        </ol>
        <div class="model-note"><strong>Keep the footprint small.</strong><span>This is a resource decision, not a city-building game. You need a defensible plan, not the most elaborate map.</span></div>
        <button type="button" class="small-button" id="print-phase2-mission5">Print Footprint Challenge + Living Resource Plan</button>
      </section>

      <section class="investigation-block continent-case">
        <div class="block-title"><div><small>CLASSES 1–2</small><h3>Your Continent Footprint</h3></div><span>6 ZONES · 3 CONSTRAINTS</span></div>
        <div class="no-continent" id="no-continent"><strong>Phase 2 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Hub →</a></div>
        <div id="case-files" hidden>
          {phase2PlantSites.map((site) => {
            const info = footprintCases[site.id];
            return (
              <article class="case-file" data-case-file={site.id} hidden>
                <header><span>{site.icon}</span><div><small>{site.name} · {site.plant.name}</small><h3>{info.productionGoal}</h3></div></header>
                <div class="zone-grid">{info.zones.map((zone, index) => <div><b>{index + 1}</b><span>{zone}</span></div>)}</div>
                <div class="constraint-box"><small>YOUR PLAN MUST</small>{info.constraints.map((constraint) => <p>✓ {constraint}</p>)}</div>
                <details class="consequence-card"><summary>REVEAL only when your teacher says so</summary><div><small>CONSEQUENCE</small><strong>{info.consequence}</strong><p>{info.consequenceMeaning}</p></div></details>
              </article>
            );
          })}
        </div>
      </section>

      <section class="investigation-block locker-block">
        <div class="block-title"><div><small>CLASS 3</small><h3>Evidence Locker</h3></div><span>4 SHORT REMINDERS</span></div>
        <p>You do not need to reopen four old mission pages. JCEC has surfaced one useful reminder from each mission. Choose your <strong>three strongest</strong> pieces of evidence, preferably from different missions.</p>
        <div class="locker-grid" id="evidence-locker" hidden>
          <article><small>MISSION 1 · RESOURCE</small><strong id="locker-resource"></strong><p id="locker-resource-detail"></p></article>
          <article><small>MISSION 2 · GROWTH</small><strong id="locker-growth"></strong><p id="locker-growth-detail"></p></article>
          <article><small>MISSION 3 · GROWING ZONE</small><strong id="locker-zone"></strong><p id="locker-zone-detail"></p></article>
          <article><small>MISSION 4 · VARIETY</small><strong id="locker-variety"></strong><p id="locker-variety-detail"></p></article>
        </div>
        <div class="locker-note" id="growth-condition-note"></div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASSES 3–4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>What is the safest realistic way humans should use this plant resource?</h3>
        <div class="strategy-grid">
          <article><span>🌿</span><strong>Limited monitored harvest</strong><p>Use small amounts from established populations while monitoring recovery.</p></article>
          <article><span>🌱</span><strong>Small managed cultivation</strong><p>Grow the plant deliberately in limited farms, gardens, forestry plots or other managed areas.</p></article>
          <article><span>🏗️</span><strong>Controlled-environment cultivation</strong><p>Use protected, contained, greenhouse, raised-bed, wetland-compatible or soilless systems where appropriate.</p></article>
          <article><span>⛔</span><strong>Do not develop yet</strong><p>Current evidence or uncertainty makes development too risky.</p></article>
        </div>
        <div class="reasoning-frame"><div><strong>DECISION</strong><span>We recommend ______.</span></div><div><strong>EVIDENCE</strong><span>Our strongest evidence is ______, ______ and ______.</span></div><div><strong>CONSEQUENCE / SAFEGUARD</strong><span>One important risk is ______, so humans must ______.</span></div></div>
        <p class="decision-note">No strategy is automatically best. Your choice has to fit your continent evidence.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> plan + revise</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one final plan</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">MAJOR PHASE 2 SYNTHESIS</p><h3>JCEC Living Resource Plan</h3></div><span>ONE PER TEAM</span></div>
        <p>Keep this to one page. Scientific thinking matters more than visual polish.</p>
        <div class="profile-checklist"><label><input type="checkbox" /> our continent</label><label><input type="checkbox" /> our resource plant</label><label><input type="checkbox" /> what humans could use it for</label><label><input type="checkbox" /> what this plant needs</label><label><input type="checkbox" /> one useful adaptation or selected trait</label><label><input type="checkbox" /> recommended growing / harvesting strategy</label><label><input type="checkbox" /> three strongest pieces of evidence</label><label><input type="checkbox" /> biggest environmental risk</label><label><input type="checkbox" /> one practice humans must follow</label><label><input type="checkbox" /> final strategy + 3–5 sentence explanation</label></div>
        <div class="assessment-note"><strong>What matters most:</strong><span>Science understanding → use of evidence → reasoning → sustainable practical decision.</span></div>
      </div>

      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>What is one thing humans could do that would make plant production more successful but less sustainable? What would you choose instead?</h3><p>Everyone answers this question individually.</p></div>

      <div class="finished-box"><strong>Phase 2 is finished when:</strong><span>✓ your team has one JCEC Living Resource Plan</span><span>✓ you completed the short individual reflection</span><p>Stop here. Do not begin Phase 3 until your teacher launches the next phase.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Mission Hub →</a></div>
    </section>

    <section class="print-packet" aria-label="Phase 2 Mission 5 printable packet">
      <section class="print-page">
        <h1>Phase 2 · Mission 5 — Production Footprint Challenge</h1>
        <p>Team: ________________________________ &nbsp; Date: ____________</p>
        <p>Continent: <strong id="print-continent"></strong> &nbsp; Resource plant: <strong id="print-plant"></strong></p>
        <p><strong>Production goal:</strong> <span id="print-goal"></span></p>
        <div class="print-zones" id="print-zones"></div>
        <p><strong>Three constraints</strong></p><ol id="print-constraints"></ol>
        <p><strong>Planning tiles:</strong> growing/harvest · protected habitat · water access · road/infrastructure · processing/storage · buffer/protection</p>
        <p><strong>Consequence:</strong> <span id="print-consequence"></span></p>
        <p><strong>Our one revision:</strong></p><div class="writing-lines tall"></div>
      </section>
      <section class="print-page page-break living-plan-page">
        <h1>JCEC Living Resource Plan</h1>
        <p>Continent: ____________________________ &nbsp; Resource plant: ____________________________</p>
        <div class="print-grid two"><div><strong>What humans could use it for</strong></div><div><strong>What this plant needs</strong></div></div>
        <div class="print-grid two"><div><strong>Useful adaptation / selected trait</strong></div><div><strong>Recommended growing / harvesting strategy</strong></div></div>
        <p><strong>Our three strongest pieces of evidence</strong></p><ol><li>_______________________________________________________________</li><li>_______________________________________________________________</li><li>_______________________________________________________________</li></ol>
        <div class="print-grid two"><div><strong>Biggest environmental risk</strong></div><div><strong>One practice humans must follow</strong></div></div>
        <p><strong>Final strategy:</strong> ☐ Limited monitored harvest &nbsp; ☐ Small managed cultivation &nbsp; ☐ Controlled-environment cultivation &nbsp; ☐ Do not develop yet</p>
        <p><strong>Why? 3–5 sentences</strong></p><div class="writing-lines very-tall"></div>
        <p><strong>MY REFLECTION:</strong> What could make production more successful but less sustainable? What would you choose instead?</p><div class="writing-lines"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites, footprintData: footprintCases }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase2-posting';
      const CONDITION_KEY = 'jabberwocky-phase2-growth-condition';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const saved = localStorage.getItem(POSTING_KEY);
      const site = saved ? sites[saved] : null;
      const info = saved ? footprintData[saved] : null;
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const challenge = document.getElementById('challenge-strip');
      const noContinent = document.getElementById('no-continent');
      const caseFiles = document.getElementById('case-files');
      const locker = document.getElementById('evidence-locker');

      if (site && info) {
        assignment.hidden = false; missing.hidden = true; challenge.hidden = false; noContinent.hidden = true; caseFiles.hidden = false; locker.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-warning').textContent = `Inherited ecosystem warning: ${site.previousTeamBriefing.warning}`;
        document.getElementById('assignment-plant').textContent = site.plant.name;
        document.getElementById('challenge-text').textContent = info.productionChallenge;
        document.querySelectorAll('[data-case-file]').forEach((el) => el.hidden = el.dataset.caseFile !== saved);

        document.getElementById('locker-resource').textContent = `${site.plant.name}: ${site.plant.resourceUse}`;
        document.getElementById('locker-resource-detail').textContent = `Adaptation: ${site.plant.adaptation} Warning: ${site.previousTeamBriefing.warning}`;
        document.getElementById('locker-growth').textContent = info.growthEvidence;
        document.getElementById('locker-growth-detail').textContent = 'Use your Growth Trial result if it gives stronger evidence than this reminder.';
        document.getElementById('locker-zone').textContent = info.growingZoneEvidence;
        document.getElementById('locker-zone-detail').textContent = `Production challenge: ${info.productionChallenge}`;
        document.getElementById('locker-variety').textContent = info.varietyEvidence;
        document.getElementById('locker-variety-detail').textContent = 'Use your Mission 4 chosen trait if your team selected a different evidence-based option.';

        document.getElementById('print-continent').textContent = site.name;
        document.getElementById('print-plant').textContent = site.plant.name;
        document.getElementById('print-goal').textContent = info.productionGoal;
        document.getElementById('print-consequence').textContent = `${info.consequence} ${info.consequenceMeaning}`;
        const zones = document.getElementById('print-zones');
        zones.innerHTML = info.zones.map((zone, i) => `<div><b>${i + 1}</b><span>${zone}</span></div>`).join('');
        const constraints = document.getElementById('print-constraints');
        constraints.innerHTML = info.constraints.map((item) => `<li>${item}</li>`).join('');
      } else {
        assignment.hidden = true; missing.hidden = false; challenge.hidden = true; noContinent.hidden = false; caseFiles.hidden = true; locker.hidden = true;
      }

      const savedCondition = localStorage.getItem(CONDITION_KEY);
      const note = document.getElementById('growth-condition-note');
      note.textContent = savedCondition
        ? `Mission 2 reminder: your class changed “${savedCondition}”. Use the actual control-vs-changed result your team observed if it strengthens your final evidence.`
        : 'Mission 2 reminder: use the Growth Trial result your class recorded. You do not need to reopen Mission 2.';

      document.getElementById('print-phase2-mission5')?.addEventListener('click', () => { document.body.classList.add('print-phase2-mission5'); window.print(); });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-phase2-mission5'));
    })();
  </script>
</BaseLayout>

<style>
