---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;
const missions = [
  { number: 1, title: 'Find the Living Resource', question: 'What can this plant provide, and how is it built to survive here?', summary: 'Study a real plant, then investigate the native resource plant on your new continent.', icon: '🌱', status: 'COMPLETE', ready: true, href: `${base}courses/grade-7-science/jabberwocky/phase-2/mission-1/`, linkText: 'Review Mission 1 →' },
  { number: 2, title: 'Keep It Growing', question: 'What does a plant need to grow and reproduce?', summary: 'Run a Growth Trial and connect plant processes to the growing challenge on your continent.', icon: '💧', status: 'COMPLETE', ready: true, href: `${base}courses/grade-7-science/jabberwocky/phase-2/mission-2/`, linkText: 'Review Mission 2 →' },
  { number: 3, title: 'Build the Growing Zone', question: 'How can humans create good growing conditions without creating new problems?', summary: 'Use soil and Growth Trial evidence to build and recommend a simple growing system.', icon: '🪴', status: 'COMPLETE', ready: true, href: `${base}courses/grade-7-science/jabberwocky/phase-2/mission-3/`, linkText: 'Review Mission 3 →' },
  { number: 4, title: 'Choose the Next Generation', question: 'Which plant traits should humans encourage, and what risks come with that?', summary: 'Model selective breeding, test a surprise change and choose one useful trait with one safeguard.', icon: '🌾', status: 'CURRENT', ready: true, href: `${base}courses/grade-7-science/jabberwocky/phase-2/mission-4/`, linkText: 'Start Mission 4 →' },
  { number: 5, title: 'Use It Without Losing It', question: 'How can humans use plant resources without damaging the system they depend on?', summary: 'Bring the evidence together and recommend a sustainable resource plan.', icon: '🛡️', status: 'UPCOMING', ready: false }
];
---

<BaseLayout title="Phase 2: The Living Resource | Jabberwocky 2190" description="The simplified five-mission student pathway for Grade 7 Science: Plants for Food & Fibre." themeColor="#0b1c16">
  <div class="phase2-shell" id="phase2-hub">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2' }
    ]} />

    <header class="phase2-hero">
      <div>
        <p class="eyebrow">MISSION 2190 // PHASE 2</p>
        <h1>THE LIVING <span>RESOURCE</span></h1>
        <p class="division">BOTANICAL RESOURCES DIVISION</p>
        <p class="lead">Human exploration is expanding. Supplies from Earth cannot support a permanent settlement forever. JCEC has identified native plants that may provide food, fibre and useful materials—but using them could damage the ecosystems already discovered.</p>
      </div>
      <aside><span>YOUR NEW ROLE</span><strong>Planetary Botanist</strong><small>Study. Grow. Protect.</small></aside>
    </header>

    <section class="big-question"><span>THE BIG QUESTION</span><h2>How can humans use Jabberwocky's plant resources without damaging the systems they depend on?</h2></section>

    <JcecPhase2Progress active={4} />

    <section class="handoff-panel" aria-labelledby="handoff-heading">
      <div class="handoff-copy"><p class="eyebrow">NEW TEAM // NEW POSTING</p><h2 id="handoff-heading">You are not beginning a new mission. You are continuing theirs.</h2><p>Phase 2 uses new teams. Your teacher will usually send you to a different continent. Choose only the continent your teacher assigned. Your Phase 1 continent and evidence stay saved separately.</p></div>
      <div class="assignment-control"><label for="phase2-continent"><strong>Your Phase 2 continent</strong><span>Choose the posting your teacher gave you.</span></label><select id="phase2-continent"><option value="">Choose your assigned continent…</option>{phase2PlantSites.map((site) => <option value={site.id}>{site.icon} {site.name} — {site.subtitle}</option>)}</select><p class="save-message" id="save-message" aria-live="polite"></p></div>
    </section>

    <section class="previous-team" id="previous-team" hidden aria-labelledby="briefing-heading">
      <div class="briefing-heading"><div><p class="eyebrow">PREVIOUS TEAM BRIEFING</p><h2 id="briefing-heading">Three things you inherit</h2></div><strong id="briefing-continent"></strong></div>
      <p class="briefing-intro">The Ecological Survey team already did the first investigation. You only need these three findings.</p>
      <div class="briefing-grid"><article><span>🌦️</span><small>ENVIRONMENT</small><p id="briefing-environment"></p></article><article><span>🕸️</span><small>ECOSYSTEM CONNECTION</small><p id="briefing-connection"></p></article><article><span>⚠️</span><small>WARNING</small><p id="briefing-warning"></p></article></div>
      <div class="continue-strip"><div><strong>Your posting is ready.</strong><span>Missions 1–3 found the resource, learned what it needs and designed a growing system. Mission 4 asks which traits humans should encourage next.</span></div><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/mission-4/`}>Continue Current Mission →</a></div>
    </section>

    <section class="quick-start" id="assignment-needed"><div><p class="eyebrow">YOUR NEXT STEP</p><h2>Get your Phase 2 continent posting.</h2><p>Once you choose the continent your teacher assigned, your inherited findings and current mission will appear.</p></div><span>1</span></section>

    <section class="how-it-works"><div class="section-heading"><p class="eyebrow">SAME ROUTINE EVERY MISSION</p><h2>How Phase 2 works</h2></div><div class="work-grid"><article><span>👥</span><div><strong>TEAM WORK</strong><p>Investigate and make decisions together.</p></div></article><article><span>📝</span><div><strong>TEAM RECORD</strong><p>One person records one team product.</p></div></article><article><span>💭</span><div><strong>MY REFLECTION</strong><p>Everyone answers one short question.</p></div></article></div></section>

    <section class="mission-list">
      <div class="section-heading"><p class="eyebrow">PHASE 2 PATH</p><h2>Five missions. One growing problem.</h2></div>
      <div class="mission-cards">{missions.map((mission) => (<article class:list={['mission-card', { ready: mission.ready, current: mission.number === 4 }]}><div class="mission-icon">{mission.icon}</div><div class="mission-main"><div class="mission-topline"><span>MISSION {mission.number}</span><b>{mission.status}</b></div><h3>{mission.title}</h3><p class="mission-question">{mission.question}</p><p class="mission-summary">{mission.summary}</p></div>{mission.ready ? <a class="mission-ready-link" href={mission.href}>{mission.linkText}</a> : <span class="locked">Upcoming</span>}</article>))}</div>
    </section>

    <section class="phase1-link"><span>←</span><div><strong>Need to check the earlier ecology work?</strong><p>Phase 1 remains available, but you do not need to search it for today's mission.</p></div><a href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1 Mission Hub</a></section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites }}>
    (() => {
      const PHASE2_POSTING_KEY = 'jabberwocky-phase2-posting';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const select = document.getElementById('phase2-continent');
      const previousTeam = document.getElementById('previous-team');
      const assignmentNeeded = document.getElementById('assignment-needed');
      const saveMessage = document.getElementById('save-message');
      const showSite = (id, announce = false) => {
        const site = sites[id];
        if (!site) { previousTeam.hidden = true; assignmentNeeded.hidden = false; saveMessage.textContent = ''; return; }
        localStorage.setItem(PHASE2_POSTING_KEY, id);
        previousTeam.hidden = false; assignmentNeeded.hidden = true;
        document.getElementById('briefing-continent').textContent = `${site.icon} ${site.name}`;
        document.getElementById('briefing-environment').textContent = site.previousTeamBriefing.environment;
        document.getElementById('briefing-connection').textContent = site.previousTeamBriefing.ecosystemConnection;
        document.getElementById('briefing-warning').textContent = site.previousTeamBriefing.warning;
        saveMessage.textContent = announce ? `✓ ${site.name} saved for Phase 2 on this device.` : `Saved Phase 2 posting: ${site.name}`;
      };
      const saved = localStorage.getItem(PHASE2_POSTING_KEY);
      if (saved && sites[saved]) { select.value = saved; showSite(saved, false); }
      select.addEventListener('change', () => showSite(select.value, true));
    })();
  </script>
</BaseLayout>

<style>
:global(body){background:#07120e}.phase2-shell{max-width:1120px;margin:0 auto;padding:0 1rem 5rem;color:#edf8ef}.phase2-shell :global(.breadcrumbs){color:#9eb4a5}.phase2-shell :global(.breadcrumbs a){color:#d9eadc}:global(body:has(#phase2-hub) .jcec-submission-dock),:global(body:has(#phase2-hub) .jcec-device-tools){display:none!important}.eyebrow{margin:0;color:#a8e779;font:850 .75rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em}.phase2-hero{display:grid;grid-template-columns:1fr 255px;gap:1.5rem;align-items:end;margin:1rem 0;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid #416448;border-radius:24px;background:radial-gradient(circle at 80% 18%,rgba(183,231,125,.15),transparent 28%),linear-gradient(145deg,#081711,#15351f)}.phase2-hero h1{margin:.55rem 0 .35rem;color:#fff;font-size:clamp(3rem,8vw,5.8rem);line-height:.86;letter-spacing:-.055em}.phase2-hero h1 span{display:block;color:#b7e77d}.division{margin:.65rem 0 0;color:#d3f4b0;font-size:.75rem;font-weight:900;letter-spacing:.12em}.lead{max-width:730px;margin:.9rem 0 0;color:#c3d5c8;font-size:1.04rem;line-height:1.6}.phase2-hero aside{display:grid;gap:.18rem;padding:1rem;border:1px solid #45644c;border-radius:14px;background:#0b1c13}.phase2-hero aside span{color:#a7d883;font-size:.72rem;font-weight:900;letter-spacing:.08em}.phase2-hero aside strong{color:#fff;font-size:1.22rem}.phase2-hero aside small{color:#9eb4a4}.big-question{margin:1rem 0;padding:1.2rem 1.3rem;border-left:4px solid #b7e77d;border-radius:0 14px 14px 0;background:#10251a}.big-question span{color:#a8e779;font-size:.72rem;font-weight:900;letter-spacing:.08em}.big-question h2{margin:.35rem 0 0;color:#fff;font-size:clamp(1.35rem,3vw,1.95rem);line-height:1.28}.handoff-panel{display:grid;grid-template-columns:1.25fr .75fr;gap:1rem;margin:1.2rem 0;padding:1.2rem;border:1px solid #4e7456;border-radius:17px;background:#10241a}.handoff-copy h2{margin:.3rem 0;color:#fff;font-size:1.45rem}.handoff-copy p:last-child{margin:.45rem 0 0;color:#adc2b2;line-height:1.5}.assignment-control{display:grid;align-content:start;gap:.45rem;padding:1rem;border:1px solid #44604a;border-radius:12px;background:#0a1810}.assignment-control label{display:grid;gap:.18rem}.assignment-control label strong{color:#fff}.assignment-control label span{color:#8fa698;font-size:.78rem}.assignment-control select{width:100%;padding:.72rem;border:1px solid #536d58;border-radius:8px;background:#102219;color:#fff;font:inherit}.save-message{min-height:1.15em;margin:0;color:#b9e899;font-size:.76rem}.previous-team,.how-it-works,.mission-list{margin:1.3rem 0;padding:1.2rem;border:1px solid #355344;border-radius:18px;background:#0b1b13}.briefing-heading{display:flex;justify-content:space-between;gap:1rem;align-items:end}.briefing-heading h2,.section-heading h2{margin:.28rem 0 .8rem;color:#fff;font-size:1.55rem}.briefing-heading>strong{padding:.4rem .6rem;border-radius:999px;background:#1a3a24;color:#d7ffb9;font-size:.82rem}.briefing-intro{margin:.1rem 0 .75rem;color:#9eb3a4}.briefing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.briefing-grid article{padding:.9rem;border:1px solid #3a5943;border-radius:12px;background:#0a1710}.briefing-grid article>span{display:block;margin-bottom:.35rem;font-size:1.3rem}.briefing-grid small{color:#9ed075;font-size:.67rem;font-weight:900;letter-spacing:.08em}.briefing-grid p{margin:.35rem 0 0;color:#c0d2c4;font-size:.86rem;line-height:1.5}.continue-strip{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:.8rem;padding:.8rem;border-radius:11px;background:#142b1d}.continue-strip div{display:grid;gap:.15rem}.continue-strip strong{color:#fff}.continue-strip span{color:#9db2a2;font-size:.8rem}.continue-strip a,.mission-ready-link{padding:.7rem .85rem;border-radius:9px;background:#b7e77d;color:#18320d!important;text-decoration:none;font-size:.82rem;font-weight:900;white-space:nowrap}.quick-start{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:1.2rem 0;padding:1.1rem 1.2rem;border:1px solid #4a674f;border-radius:15px;background:#102119}.quick-start h2{margin:.25rem 0;color:#fff}.quick-start p:last-child{margin:.2rem 0 0;color:#9eb3a3}.quick-start>span{display:grid;place-items:center;width:45px;height:45px;border-radius:50%;background:#b7e77d;color:#18320d;font-weight:950}.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.work-grid article{display:flex;gap:.7rem;align-items:flex-start;padding:.85rem;border:1px solid #344e3d;border-radius:12px;background:#09150e}.work-grid article>span{font-size:1.3rem}.work-grid strong{color:#fff;font-size:.9rem}.work-grid p{margin:.22rem 0 0;color:#a4b9aa;font-size:.84rem;line-height:1.45}.mission-cards{display:grid;gap:.65rem}.mission-card{display:grid;grid-template-columns:auto 1fr auto;gap:.9rem;align-items:center;padding:.9rem 1rem;border:1px solid #344a3c;border-radius:13px;background:#09150e;opacity:.68}.mission-card.ready{opacity:.9}.mission-card.current{border-color:#6f9c55;background:#12281a;opacity:1}.mission-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;background:#152a1d;font-size:1.45rem}.mission-main{min-width:0}.mission-topline{display:flex;gap:.5rem;align-items:center}.mission-topline span{color:#8ea392;font-size:.68rem;font-weight:900;letter-spacing:.08em}.mission-topline b{padding:.2rem .4rem;border-radius:999px;background:#17261c;color:#9db0a0;font-size:.62rem}.mission-card.current .mission-topline b{background:#294f32;color:#d8ffb7}.mission-card h3{margin:.25rem 0;color:#fff;font-size:1.15rem}.mission-question{margin:.05rem 0;color:#d0ded3;font-weight:750}.mission-summary{margin:.28rem 0 0;color:#8fa394;font-size:.84rem;line-height:1.45}.locked{padding:.55rem .7rem;border:1px solid #415346;border-radius:8px;color:#819384;font-size:.76rem;font-weight:850}.phase1-link{display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;margin-top:1.2rem;padding:.9rem;border:1px solid #344f40;border-radius:12px;background:#09160f}.phase1-link>span{font-size:1.2rem;color:#8fa794}.phase1-link strong{color:#fff}.phase1-link p{margin:.18rem 0 0;color:#93a797;font-size:.8rem}.phase1-link a{color:#b7df9c;text-decoration:none;font-size:.8rem;font-weight:850}
@media(max-width:800px){.phase2-hero,.handoff-panel{grid-template-columns:1fr}.briefing-grid,.work-grid{grid-template-columns:1fr}.mission-card{grid-template-columns:auto 1fr}.mission-card>.mission-ready-link,.mission-card>.locked{grid-column:1/-1;text-align:center}.continue-strip{display:grid}.continue-strip a{text-align:center}.phase1-link{grid-template-columns:auto 1fr}.phase1-link a{grid-column:1/-1}}
@media(max-width:520px){.phase2-shell{padding-inline:.7rem}.phase2-hero h1{font-size:3.25rem}.mission-summary{display:none}.briefing-heading{display:grid;align-items:start}.briefing-heading>strong{width:max-content}}
</style>
