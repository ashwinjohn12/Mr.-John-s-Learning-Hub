---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;

type SelectionCase = {
  challenge: string;
  evidence: Array<{ label: string; evidence: string; meaning: string }>;
  surprise: string;
  helpful: string;
};

const selectionCases: Record<string, SelectionCase> = {
  gyre: {
    challenge: 'Short seasons favour cold-tolerant plants, but strong anchoring still matters on steep ground.',
    evidence: [
      { label: 'SEASON', evidence: 'Snow can remain late and the warm growing window is brief.', meaning: 'Cold tolerance or short-season growth could help plants finish their life cycle.' },
      { label: 'STABILITY', evidence: 'Skyroot roots help hold thin soil on windy slopes.', meaning: 'Selecting only for fast growth could reduce a feature that keeps plants anchored.' },
      { label: 'TRADE-OFF', evidence: 'The fastest-growing trial plants had shallower roots.', meaning: 'More growth is useful only if the plants still survive mountain conditions.' }
    ],
    surprise: 'An unusually cold, windy summer arrives two weeks earlier than expected.',
    helpful: 'Cold tolerance, short-season growth and strong anchoring would all help.'
  },
  brillig: {
    challenge: 'High production is attractive, but humid growing areas can spread disease quickly.',
    evidence: [
      { label: 'HUMIDITY', evidence: 'Warm, wet conditions keep leaves damp for long periods.', meaning: 'Disease resistance can matter as much as yield.' },
      { label: 'PRODUCTION', evidence: 'Some Rainspout Trees produce more fruit and bark fibre than others.', meaning: 'Humans may want to favour high production.' },
      { label: 'TRADE-OFF', evidence: 'Dense uniform plantings leave little space between similar plants.', meaning: 'A pest or disease can move quickly when many plants share the same weakness.' }
    ],
    surprise: 'A fungal leaf disease appears after several weeks of heavy rain.',
    helpful: 'Disease/pest resistance and keeping some variety in the population would help.'
  },
  manxome: {
    challenge: 'Useful production traits must not replace the storm and salt tolerance that keep Storm Palm alive.',
    evidence: [
      { label: 'STORMS', evidence: 'Plants with strong flexible stems survive severe winds more often.', meaning: 'Fibre/stem strength remains important even if humans want faster growth.' },
      { label: 'SALT', evidence: 'Some palms tolerate salty spray better than others.', meaning: 'Salt tolerance can protect plants after coastal storms.' },
      { label: 'TRADE-OFF', evidence: 'The highest-fruit plants in sheltered sites are not always the strongest in exposed sites.', meaning: 'High yield alone may not fit the whole continent.' }
    ],
    surprise: 'A severe storm pushes salt spray far inland and damages exposed young plants.',
    helpful: 'Salt tolerance and strong flexible structure would help.'
  },
  'slithy-toves': {
    challenge: 'Drought and salt tolerance are valuable, but high-yield plants may demand more scarce water.',
    evidence: [
      { label: 'WATER', evidence: 'Reservoir Thorn individuals differ in how long they stay healthy between rainfalls.', meaning: 'Drought tolerance could reduce irrigation demand.' },
      { label: 'SALT', evidence: 'Some plants continue growing in saltier soil than others.', meaning: 'Salt tolerance could matter where irrigation leaves salts behind.' },
      { label: 'TRADE-OFF', evidence: 'The plants producing the most seeds also use more water during growth.', meaning: 'Higher yield could make the water problem worse.' }
    ],
    surprise: 'A long dry period arrives and the freshwater supply is cut in half.',
    helpful: 'Drought tolerance and lower water demand would help.'
  },
  wabe: {
    challenge: 'Plants must finish quickly in a short season, but they also need enough cold tolerance for an unusual freeze.',
    evidence: [
      { label: 'TIMING', evidence: 'Some Ember Moss plants flower and set seed earlier than others.', meaning: 'Short-season growth could help complete reproduction.' },
      { label: 'COLD', evidence: 'Some dense mats remain healthy after colder nights.', meaning: 'Cold tolerance still matters even during summer.' },
      { label: 'TRADE-OFF', evidence: 'The fastest-growing plants lose more tissue during sudden cold snaps.', meaning: 'Rapid growth alone may reduce resilience.' }
    ],
    surprise: 'A late cold snap freezes the growing zone during flowering.',
    helpful: 'Cold tolerance and short-season growth would help.'
  },
  bandersnatch: {
    challenge: 'High yield is easy to value, but drought, pests and soil protection can decide whether a crop remains reliable.',
    evidence: [
      { label: 'YIELD', evidence: 'Some Goldstem Grain plants produce much larger seed heads.', meaning: 'High yield could provide more food from the same area.' },
      { label: 'RESILIENCE', evidence: 'Other plants stay healthy longer during dry, windy periods.', meaning: 'Drought tolerance may protect production in difficult years.' },
      { label: 'TRADE-OFF', evidence: 'Very uniform test plots were damaged by the same insect at nearly the same time.', meaning: 'Low variety can make one pest more damaging.' }
    ],
    surprise: 'A new insect pest arrives during a dry summer.',
    helpful: 'Pest resistance, drought tolerance and variety would help.'
  },
  gimble: {
    challenge: 'Faster Ironwood growth could shorten harvest time, but strength, longevity and pest resistance still matter.',
    evidence: [
      { label: 'GROWTH', evidence: 'Some young Ironwood trees add height more quickly.', meaning: 'Rapid growth could shorten the long production cycle.' },
      { label: 'WOOD', evidence: 'Slower-growing trees often develop denser, stronger wood.', meaning: 'Selecting only for speed could reduce the resource quality humans want.' },
      { label: 'TRADE-OFF', evidence: 'A few tree families show less damage from bark-boring insects.', meaning: 'Pest resistance could be important in a long-lived forest crop.' }
    ],
    surprise: 'A bark-boring insect spreads through the nursery.',
    helpful: 'Pest resistance and maintaining strong, varied trees would help.'
  },
  mimsy: {
    challenge: 'Floatroot must keep its wetland tolerance while humans also look for efficient production and nutrient use.',
    evidence: [
      { label: 'WATER', evidence: 'Some Floatroot plants remain healthy through deeper flooding.', meaning: 'Waterlogging tolerance fits the natural wetland system.' },
      { label: 'NUTRIENTS', evidence: 'Some plants produce similar seed amounts with fewer added nutrients.', meaning: 'Nutrient efficiency could reduce the need to alter the wetland.' },
      { label: 'TRADE-OFF', evidence: 'The highest-production plants spread new shoots beyond test containers more often.', meaning: 'Production plans also need containment and monitoring.' }
    ],
    surprise: 'Storms raise water levels and flood the growing zone for several days.',
    helpful: 'Waterlogging tolerance, nutrient efficiency and containment would help.'
  }
};

const starterPopulation = [
  { id: 'A', traits: ['High yield', 'Pest resistance'] },
  { id: 'B', traits: ['Drought tolerance', 'Fibre / stem strength'] },
  { id: 'C', traits: ['Cold tolerance', 'Short-season growth'] },
  { id: 'D', traits: ['Salt tolerance', 'Strong anchoring'] },
  { id: 'E', traits: ['Rapid growth', 'High yield'] },
  { id: 'F', traits: ['Pest resistance', 'Fibre / stem strength'] },
  { id: 'G', traits: ['Drought tolerance', 'Short-season growth'] },
  { id: 'H', traits: ['Waterlogging tolerance', 'Nutrient efficiency'] }
];
---

<BaseLayout title="Mission 4: Choose the Next Generation | Jabberwocky 2190" description="Phase 2 Mission 4: investigate plant variation, selective breeding, monoculture risk and practical safeguards." themeColor="#0b1c16">
  <div class="mission-shell" id="phase2-mission4">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2', href: `${base}courses/grade-7-science/jabberwocky/phase-2/` },
      { label: 'Mission 4' }
    ]} />

    <JcecPhase2Progress active={4} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 2 // MISSION 4 OF 5</p>
        <h1>CHOOSE THE <span>NEXT GENERATION</span></h1>
        <p class="question">Which plant traits should humans encourage, and what risks come with that?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How selection can change cultivated plant populations</strong><small>3 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance" aria-label="Mission 4 at a glance">
      <div><small>WHERE AM I?</small><strong>Mission 4 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Plant Variety Decision Card + 1 reflection</strong></div>
      <div><small>BIG IDEA</small><strong>Useful traits matter—but keeping variety and safeguards can matter too.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 4 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>JCEC now knows what your resource plant is, what it needs and how humans might grow it. The next question is which plants should produce the next generation. Choosing plants with useful traits can improve a cultivated variety—but selecting too narrowly can leave many plants with the same weakness. Your team will model repeated selection, face one surprise change, then recommend one trait JCEC should favour without ignoring the risk.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon" aria-hidden="true"></span>
        <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
        <div class="plant-badge"><small>RESOURCE PLANT</small><b id="assignment-plant"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 2 posting is not saved on this device yet.</strong><p>Return to the Phase 2 Hub and choose the continent your teacher assigned.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Get Phase 2 posting →</a></div>
      <div class="challenge-strip" id="challenge-strip" hidden><small>PRODUCTION CHALLENGE FROM EARLIER MISSIONS</small><strong id="challenge-text"></strong></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Plants of the same kind are <strong>not all identical</strong>. Humans can choose which differences they want to encourage.</p>

      <div class="science-grid">
        <article><span>🌼</span><strong>REPRODUCTION</strong><p>Seed plants make new generations through reproduction. Pollination helps flowering plants form seeds. Some plants can also be propagated from cuttings, runners or other plant parts.</p></article>
        <article><span>🌿</span><strong>PLANT VARIETY</strong><p>Plants of the same kind can differ in height, yield, drought tolerance, strength, timing and resistance to pests.</p></article>
        <article><span>🎯</span><strong>SELECTIVE BREEDING</strong><p>Humans repeatedly choose plants with useful characteristics to reproduce so those characteristics become more common in cultivated varieties.</p></article>
        <article><span>⚠️</span><strong>MONOCULTURE / LOW VARIETY</strong><p>Large areas of very similar plants can be efficient, but one pest, disease or environmental change may affect many plants in the same way.</p></article>
      </div>

      <div class="core-message"><strong>Grade 7 idea:</strong><span>People choose plants with characteristics they want and use those plants to produce future generations.</span></div>

      <details class="help-box"><summary>Need Help? What selective breeding is NOT in this mission</summary><div><p>You do not need Punnett squares, alleles, genotype, phenotype or dominant/recessive inheritance here. Focus on <strong>observable plant characteristics, repeated human selection and the consequences of that choice.</strong></p></div></details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–2</p><h2>Investigate</h2></div></div>

      <section class="investigation-block simulation-block">
        <div class="block-title"><div><small>MAIN HANDS-ON MODEL</small><h3>Selective Breeding Simulation</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> What happens to a cultivated population when humans keep choosing the same useful trait?</p>
        <ol class="simple-procedure">
          <li>Examine the mixed starting population. Notice that different plants have different combinations of traits.</li>
          <li>Choose <strong>one target trait</strong> JCEC wants to encourage.</li>
          <li>Select the plant cards with that trait to contribute more offspring to the next generation.</li>
          <li>Repeat the simplified selection for <strong>2–3 generations</strong>. Track which traits become common and which become rare.</li>
          <li>When your teacher says so, reveal the surprise event. Check whether your selected population still has traits that help it cope.</li>
        </ol>
        <div class="model-note"><strong>This is a model.</strong><span>Real offspring vary and selective breeding usually takes many generations. Here, the model only shows how repeated selection can change which traits are common.</span></div>

        <div class="population-grid" aria-label="Starter plant population">
          {starterPopulation.map((plant) => <article><b>{plant.id}</b><strong>Plant {plant.id}</strong><span>{plant.traits[0]}</span><span>{plant.traits[1]}</span></article>)}
        </div>
        <button type="button" class="small-button" id="print-phase2-mission4">Print Simulation Cards + Decision Card</button>
      </section>

      <section class="investigation-block case-block">
        <div class="block-title"><div><small>CLASS 2–3</small><h3>Your Continent Selection Case</h3></div><span>3 EVIDENCE CARDS</span></div>
        <p>Read only the three cards for your continent. Then open the surprise when your teacher says <strong>REVEAL</strong>.</p>
        <div class="no-continent" id="no-continent"><strong>Phase 2 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Hub →</a></div>
        <div id="case-files" hidden>
          {phase2PlantSites.map((site) => {
            const info = selectionCases[site.id];
            return (
              <article class="case-file" data-case-file={site.id} hidden>
                <header><span>{site.icon}</span><div><small>{site.name} · {site.plant.name}</small><h3>{info.challenge}</h3></div></header>
                <div class="clue-grid">{info.evidence.map((card, index) => <article><b>{index + 1}</b><small>{card.label}</small><strong>{card.evidence}</strong><p><span>WHY IT MATTERS:</span> {card.meaning}</p></article>)}</div>
                <details class="surprise-box"><summary>⚠️ Reveal the surprise event</summary><div><strong>{info.surprise}</strong><p>{info.helpful}</p><span>Ask: Did our selected population keep enough useful variety to handle this change?</span></div></details>
              </article>
            );
          })}
        </div>
      </section>

      <section class="investigation-block pest-response">
        <div class="block-title"><div><small>AFTER THE SURPRISE</small><h3>If a pest appears, humans have choices</h3></div><span>KEEP IT SIMPLE</span></div>
        <div class="control-grid">
          <article><strong>Biological control</strong><p>Use a living organism or natural enemy to reduce the pest. It must be chosen carefully so it does not create a new problem.</p></article>
          <article><strong>Physical / cultural control</strong><p>Use barriers, remove infected material, change planting patterns or use other management practices.</p></article>
          <article><strong>Chemical control</strong><p>Use a pesticide or herbicide when appropriate. It may work quickly, but misuse can affect non-target organisms, soil or water.</p></article>
        </div>
        <div class="key-message"><strong>Selective breeding can be useful.</strong><span>Variety and safeguards still matter.</span></div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which trait should JCEC favour in this plant, and what risk must remain part of the plan?</h3>
        <div class="reasoning-frame"><div><strong>SELECT</strong><span>We would select ______ because ______.</span></div><div><strong>USE EVIDENCE</strong><span>Use one continent clue + one result from the simulation.</span></div><div><strong>WATCH FOR</strong><span>But we would need to watch for ______.</span></div></div>
        <p class="decision-note">Your goal is not to find a “perfect” plant. Recommend one useful trait while keeping one real risk visible.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> select + test</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one card</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Plant Variety Decision Card</h3></div><span>ONE PER TEAM</span></div>
        <p>Your card needs these seven pieces.</p>
        <div class="profile-checklist"><label><input type="checkbox" /> continent + resource plant</label><label><input type="checkbox" /> trait selected</label><label><input type="checkbox" /> why humans want the trait</label><label><input type="checkbox" /> evidence that it fits the continent</label><label><input type="checkbox" /> one possible trade-off</label><label><input type="checkbox" /> one monoculture / pest / environmental risk</label><label><input type="checkbox" /> one safeguard</label></div>
      </div>

      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>Why might the plant with the highest yield not always be the best choice?</h3><p>Everyone answers this question individually.</p></div>

      <div class="finished-box"><strong>Mission 4 is finished when:</strong><span>✓ your team has one Plant Variety Decision Card</span><span>✓ you completed the short individual reflection</span><p>Mission 5 — Use It Without Losing It — is upcoming. Do not start it yet.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Mission Hub →</a></div>
    </section>

    <section class="print-packet" aria-label="Phase 2 Mission 4 printable packet">
      <section class="print-page">
        <h1>Phase 2 · Mission 4 — Selective Breeding Simulation</h1>
        <p>Team: ____________________________ &nbsp; Target trait: ____________________________</p>
        <div class="print-cards">{starterPopulation.map((plant) => <article><h3>Plant {plant.id}</h3><p>{plant.traits[0]}</p><p>{plant.traits[1]}</p></article>)}</div>
        <table><thead><tr><th>Generation</th><th>Which plant letters reproduce most?</th><th>What trait is becoming more common?</th><th>What useful variety might be disappearing?</th></tr></thead><tbody><tr><th>Start</th><td></td><td></td><td></td></tr><tr><th>2</th><td></td><td></td><td></td></tr><tr><th>3</th><td></td><td></td><td></td></tr></tbody></table>
        <p><strong>Surprise event:</strong> ________________________________________________</p>
        <p><strong>What happened to your selected population?</strong></p><div class="writing-lines"></div>
      </section>
      <section class="print-page page-break">
        <h1>Plant Variety Decision Card</h1>
        <p>Continent: ____________________________ &nbsp; Resource plant: ____________________________</p>
        <div class="print-grid two"><div><strong>Trait selected</strong></div><div><strong>Why humans want it</strong></div></div>
        <div class="print-grid two"><div><strong>Evidence that it fits our continent</strong></div><div><strong>Simulation evidence</strong></div></div>
        <div class="print-grid two"><div><strong>Possible trade-off / risk</strong></div><div><strong>Safeguard</strong></div></div>
        <p><strong>Reasoning:</strong> We would select __________ because __________. But we would need to watch for __________.</p><div class="writing-lines tall"></div>
        <p><strong>MY REFLECTION:</strong> Why might the plant with the highest yield not always be the best choice?</p><div class="writing-lines tall"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites, caseData: selectionCases }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase2-posting';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const saved = localStorage.getItem(POSTING_KEY);
      const site = saved ? sites[saved] : null;
      const info = saved ? caseData[saved] : null;
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const challenge = document.getElementById('challenge-strip');
      const noContinent = document.getElementById('no-continent');
      const caseFiles = document.getElementById('case-files');

      if (site && info) {
        assignment.hidden = false; missing.hidden = true; challenge.hidden = false; noContinent.hidden = true; caseFiles.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-environment').textContent = site.previousTeamBriefing.environment;
        document.getElementById('assignment-plant').textContent = site.plant.name;
        document.getElementById('challenge-text').textContent = site.plant.productionProblem;
        document.querySelectorAll('[data-case-file]').forEach((el) => el.hidden = el.dataset.caseFile !== saved);
      } else {
        assignment.hidden = true; missing.hidden = false; challenge.hidden = true; noContinent.hidden = false; caseFiles.hidden = true;
      }

      document.getElementById('print-phase2-mission4')?.addEventListener('click', () => { document.body.classList.add('print-phase2-mission4'); window.print(); });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-phase2-mission4'));
    })();
  </script>
</BaseLayout>

<style>
