---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase2Progress from '../../../../../../components/JcecPhase2Progress.astro';
import { phase2PlantSites } from '../../../../../../data/jabberwockyPhase2';

const base = import.meta.env.BASE_URL;

type GrowingCase = {
  challenge: string;
  focus: string;
  evidence: Array<{ label: string; evidence: string; meaning: string }>;
  prototypeGoal: string;
};

const growingCases: Record<string, GrowingCase> = {
  gyre: {
    challenge: 'Cold conditions, thin soils and very little flat growing land',
    focus: 'Skyroot already survives difficult mountain conditions, but large-scale growing would need warmth, stable growing media and careful land use.',
    evidence: [
      { label: 'SOIL', evidence: 'Natural growing pockets are shallow and rocky.', meaning: 'A contained growing bed may need deeper material without stripping fragile slopes.' },
      { label: 'TEMPERATURE', evidence: 'The useful growing season is short and cold nights can return quickly.', meaning: 'Protection from cold could extend the time plants can grow.' },
      { label: 'WATER', evidence: 'Mountain soil can drain rapidly after snowmelt or rain.', meaning: 'A system must hold enough water without causing erosion.' }
    ],
    prototypeGoal: 'Create a stable, protected growing space that holds water without depending on steep natural soil.'
  },
  brillig: {
    challenge: 'Heavy rain, drainage problems and nutrient loss if forest is cleared',
    focus: 'Rainspout Tree has plenty of water, but a useful growing zone must handle intense rain without destroying the forest conditions that support the ecosystem.',
    evidence: [
      { label: 'WATER', evidence: 'Rain can keep ground wet for long periods.', meaning: 'Roots need drainage so the growing area does not stay waterlogged.' },
      { label: 'SOIL', evidence: 'Frequent rain can wash dissolved materials through exposed soil.', meaning: 'Growing media should hold useful materials while still draining.' },
      { label: 'ECOSYSTEM', evidence: 'Removing forest cover increases erosion and damages habitat.', meaning: 'A system that uses existing clearings or contained beds may reduce clearing.' }
    ],
    prototypeGoal: 'Drain excess water while keeping soil/materials in place and avoiding unnecessary forest clearing.'
  },
  manxome: {
    challenge: 'Salt exposure, storms and vulnerable young plants',
    focus: 'Storm Palm is adapted to island weather, but young cultivated plants would still need fresh water and protection during establishment.',
    evidence: [
      { label: 'SALT', evidence: 'Storm spray can leave salt on soil and growing surfaces.', meaning: 'Fresh-water control and drainage may be needed to prevent salt buildup.' },
      { label: 'STORMS', evidence: 'Severe storms can damage seedlings before roots are established.', meaning: 'Young plants may need temporary shelter or protected growing.' },
      { label: 'SOIL', evidence: 'Island soils vary from sandy shore deposits to deeper inland material.', meaning: 'A contained medium gives humans more control over drainage and rooting.' }
    ],
    prototypeGoal: 'Protect young plants from wind and salt while keeping fresh water moving through the root zone.'
  },
  'slithy-toves': {
    challenge: 'Extreme water scarcity and the risk of salt buildup from irrigation',
    focus: 'Reservoir Thorn can survive drought, but trying to grow many plants could use scarce fresh water and leave salts behind.',
    evidence: [
      { label: 'WATER', evidence: 'Fresh water is the continent’s main limiting resource.', meaning: 'A growing system must reduce wasted water.' },
      { label: 'EVAPORATION', evidence: 'Hot, dry air removes water quickly from exposed soil.', meaning: 'Covering soil or delivering water slowly may reduce loss.' },
      { label: 'SALT', evidence: 'Repeated watering followed by evaporation can leave salts behind.', meaning: 'More irrigation is not automatically a better solution.' }
    ],
    prototypeGoal: 'Deliver small amounts of water efficiently while reducing evaporation and avoiding salt buildup.'
  },
  wabe: {
    challenge: 'A very short growing season and persistently cold conditions',
    focus: 'Ember Moss completes its life cycle quickly, but humans would need to create a longer period of suitable warmth without using excessive resources.',
    evidence: [
      { label: 'TEMPERATURE', evidence: 'Surface soil is usable for only a short summer window.', meaning: 'Protected growing could warm the root zone earlier and longer.' },
      { label: 'LIGHT', evidence: 'Summer days are long once the season begins.', meaning: 'Light may be available even when temperature is the main limit.' },
      { label: 'GROUND', evidence: 'Frozen or saturated ground can limit normal root-zone conditions.', meaning: 'Raised or contained growing may separate plants from unsuitable ground.' }
    ],
    prototypeGoal: 'Create a small protected growing zone that warms the root area and uses the long summer daylight.'
  },
  bandersnatch: {
    challenge: 'Excellent growing potential, but soil and water can be damaged by large-scale farming',
    focus: 'Goldstem Grain could grow well here. The challenge is preventing an easy agricultural opportunity from becoming an erosion or habitat problem.',
    evidence: [
      { label: 'SOIL', evidence: 'Prairie soils can support strong plant growth.', meaning: 'Humans should protect the productive top layer instead of exhausting or compacting it.' },
      { label: 'WIND', evidence: 'Open plains can experience strong winds and dry surface soil.', meaning: 'Bare soil is more vulnerable to moisture loss and erosion.' },
      { label: 'WATER', evidence: 'Water is available but not unlimited during dry periods.', meaning: 'Irrigation should be targeted rather than automatic.' }
    ],
    prototypeGoal: 'Support strong growth while keeping soil covered, reducing erosion and avoiding unnecessary water use.'
  },
  gimble: {
    challenge: 'Slow tree growth, forest competition and a long replacement time',
    focus: 'Ironwood can provide valuable fibre and timber, but a growing system must deal with shade and the fact that mature trees take years to replace.',
    evidence: [
      { label: 'LIGHT', evidence: 'Young trees grow best where enough light reaches the forest floor.', meaning: 'Planting location matters as much as soil or water.' },
      { label: 'SOIL', evidence: 'Forest soils contain organic material and hold moisture under litter.', meaning: 'Removing all surface material could reduce useful soil conditions.' },
      { label: 'TIME', evidence: 'Ironwood grows and reproduces slowly.', meaning: 'A system that destroys mature forest faster than replacement is not sustainable.' }
    ],
    prototypeGoal: 'Create a nursery-style starting system for young Ironwood without assuming the natural forest should be cleared.'
  },
  mimsy: {
    challenge: 'Saturated, nutrient-poor ground and the danger of draining wetlands',
    focus: 'Floatroot is adapted to wet conditions. Humans should work with the wetland instead of trying to turn it into dry farmland.',
    evidence: [
      { label: 'WATER', evidence: 'Natural ground stays saturated or shallowly flooded.', meaning: 'Adding drainage could destroy the ecosystem function the plant depends on.' },
      { label: 'NUTRIENTS', evidence: 'Wetland soils contain relatively few available nutrients.', meaning: 'A contained growing medium could add materials without changing the whole wetland.' },
      { label: 'ROOT ZONE', evidence: 'Floatroot tolerates waterlogged conditions better than many Earth crops.', meaning: 'The system should fit the plant rather than forcing dry-soil conditions.' }
    ],
    prototypeGoal: 'Support roots and nutrients in a contained or raised system without draining the surrounding wetland.'
  }
};
---

<BaseLayout title="Mission 3: Build the Growing Zone | Jabberwocky 2190" description="Phase 2 Mission 3: investigate soil and growing media, use Growth Trial evidence, and recommend a practical growing system." themeColor="#0b1c16">
  <div class="mission-shell" id="phase2-mission3">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 2', href: `${base}courses/grade-7-science/jabberwocky/phase-2/` },
      { label: 'Mission 3' }
    ]} />

    <JcecPhase2Progress active={3} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 2 // MISSION 3 OF 5</p>
        <h1>BUILD THE <span>GROWING ZONE</span></h1>
        <p class="question">How can humans create good growing conditions without creating new problems?</p>
      </div>
      <aside><span>YOU ARE LEARNING</span><strong>How soil, water and growing technology affect plant production</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance" aria-label="Mission 3 at a glance">
      <div><small>WHERE AM I?</small><strong>Mission 3 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Growing System Recommendation + 1 reflection</strong></div>
      <div><small>WHAT EVIDENCE RETURNS?</small><strong>Your Mission 2 Growth Trial now becomes evidence for a real growing decision.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 3 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>You know what your resource plant needs. Now JCEC wants enough plants to make the resource useful. That means humans may need to change soil, water, nutrients or temperature. Your team will test growing materials, use the Growth Trial you already started, and build one small growing-system model. The challenge is not simply to grow more—it is to solve the growing problem without creating a new environmental problem.</p></div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon" aria-hidden="true"></span>
        <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
        <div class="plant-badge"><small>RESOURCE PLANT</small><b id="assignment-plant"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 2 posting is not saved on this device yet.</strong><p>Return to the Phase 2 Hub and choose the continent your teacher assigned.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Get Phase 2 posting →</a></div>

      <div class="challenge-strip" id="challenge-strip" hidden><small>MAIN GROWING CHALLENGE</small><strong id="challenge-text"></strong><p id="challenge-focus"></p></div>
      <div class="trial-carryover"><small>MISSION 2 GROWTH TRIAL</small><strong id="saved-condition">No changed condition saved on this device.</strong><p>Use your latest Growth Trial row. You only need one useful difference between the control and changed condition—do not copy the whole table again.</p></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASSES 1–2</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Think of soil and growing systems as one problem: <strong>roots need the right balance of water, air, materials and support.</strong></p>

      <div class="science-grid">
        <article><span>🪨</span><strong>SOIL PARTICLES</strong><p><b>Sand-rich:</b> larger particles and larger spaces. <b>Clay-rich:</b> very small particles and tiny spaces. <b>Organic-rich:</b> contains decomposed plant material that can help hold water and nutrients.</p></article>
        <article><span>💧</span><strong>WATER IN SOIL</strong><p><b>Drainage</b> is how easily water leaves. <b>Retention</b> is how much water stays. <b>Compaction</b> squeezes spaces smaller and can reduce air and water movement.</p></article>
        <article><span>🧪</span><strong>MATERIALS PLANTS NEED</strong><p>Roots need water and dissolved nutrients/materials. Fertilizer can add nutrients, but too much can wash away or damage water and soil systems.</p></article>
        <article><span>🏗️</span><strong>CHANGE THE ENVIRONMENT</strong><p>Irrigation, protected growing, raised/contained beds and soilless systems can solve particular problems. They are tools—not automatically better choices.</p></article>
      </div>

      <div class="cause-chain"><strong>Particle size → pore spaces → water movement → root conditions</strong><span>This is the connection to remember—not a long list of soil words.</span></div>

      <details class="help-box"><summary>Learn More: four growing tools</summary><div class="tool-grid"><p><strong>Irrigation:</strong> supplies water where or when natural water is not enough.</p><p><strong>Protected growing:</strong> uses a cover/greenhouse to change temperature, wind or moisture.</p><p><strong>Raised / contained bed:</strong> gives humans more control over the root zone and drainage.</p><p><strong>Soilless / hydroponic growing:</strong> grows plants without ordinary soil, but needs controlled water, nutrients and equipment.</p></div></details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>

      <section class="investigation-block soil-lab">
        <div class="block-title"><div><small>CLASSES 1–2</small><h3>Soil / Growing Medium Investigation</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> Which growing material holds water, drains water, and supports useful root conditions most effectively?</p>
        <div class="equipment-strip"><strong>You need:</strong><span>3 teacher-provided media</span><span>3 equal containers</span><span>equal water amounts</span><span>timer / measuring cup if available</span><span>field sheet</span></div>
        <ol class="simple-procedure">
          <li>Label three samples: <strong>sand-rich, clay-rich and organic-rich</strong> (or the teacher-provided equivalents).</li>
          <li>Observe texture and particle size. Gently press each sample once to compare how easily it compacts.</li>
          <li>Put the same amount of each material into similar containers.</li>
          <li>Add the same amount of water. Record how quickly or how much drains through.</li>
          <li>Compare what remains damp, what drains fastest and what became most compact. Decide what each material might be useful for.</li>
        </ol>
        <div class="fair-test"><strong>Fair comparison:</strong><span>Use equal amounts of material and water, similar containers and the same procedure.</span></div>
        <button type="button" class="small-button" id="print-phase2-mission3">Print Soil Investigation + Recommendation</button>
      </section>

      <section class="investigation-block growth-return">
        <div class="block-title"><div><small>CLASS 3 · 5–10 MIN</small><h3>Bring Back the Growth Trial</h3></div><span>OLD EVIDENCE</span></div>
        <p>Look at your final or near-final Mission 2 data. Answer only:</p>
        <blockquote>What difference do you see between the control and the changed condition?</blockquote>
        <div class="evidence-choice"><span>height</span><span>germination</span><span>leaf number</span><span>visible health</span></div>
        <p class="small-note">Choose one difference that is actually visible in your data. A simple height graph is optional if your teacher asks for one. This is not a new Growth Trial assignment.</p>
      </section>

      <section class="investigation-block continent-case">
        <div class="block-title"><div><small>CLASS 3</small><h3>Your Continent Growing Case</h3></div><span>3 EVIDENCE CARDS</span></div>
        <p>Read only the three cards for your continent. Use them with the soil investigation and Growth Trial evidence.</p>
        <div class="no-continent" id="no-continent"><strong>Phase 2 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Hub →</a></div>
        <div id="case-files" hidden>
          {phase2PlantSites.map((site) => {
            const info = growingCases[site.id];
            return (
              <article class="case-file" data-case-file={site.id} hidden>
                <header><span>{site.icon}</span><div><small>{site.name} · {site.plant.name}</small><h3>{info.challenge}</h3></div></header>
                <div class="clue-grid">{info.evidence.map((card, index) => <article><b>{index + 1}</b><small>{card.label}</small><strong>{card.evidence}</strong><p><span>WHY IT MATTERS:</span> {card.meaning}</p></article>)}</div>
                <div class="prototype-goal"><small>YOUR MODEL'S JOB</small><strong>{info.prototypeGoal}</strong></div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="investigation-block prototype-block">
        <div class="block-title"><div><small>CLASS 3</small><h3>Growing System Challenge</h3></div><span>SMALL MODEL</span></div>
        <p>Build a cup-sized model that solves <strong>one</strong> growing problem. It does not need to grow a plant today.</p>
        <div class="prototype-tools">
          <article><strong>Drainage</strong><p>holes, gravel or a medium that lets extra water leave</p></article>
          <article><strong>Water saving</strong><p>wick/reservoir or cover that slows evaporation</p></article>
          <article><strong>Root-zone control</strong><p>raised/contained medium separated from unsuitable ground</p></article>
          <article><strong>Protection</strong><p>simple clear cover or shelter from cold/wind</p></article>
        </div>
        <ol class="simple-procedure compact-list">
          <li>Choose the single growing problem your model will solve.</li>
          <li>Select only the materials you need.</li>
          <li>Build a small model in one container.</li>
          <li>Test the feature once with water, drainage, cover or another teacher-approved check.</li>
          <li>Identify one problem your solution could create and one change that could reduce it.</li>
        </ol>
        <div class="prototype-warning"><strong>Keep it simple.</strong><span>This is evidence for a decision, not an engineering competition.</span></div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>What growing system should JCEC test first on your continent?</h3>
        <div class="reasoning-frame"><div><strong>RECOMMEND</strong><span>Our growing system should ______.</span></div><div><strong>EVIDENCE</strong><span>...because our soil and/or Growth Trial evidence shows ______.</span></div><div><strong>SAFEGUARD</strong><span>One possible problem is ______, so we would ______.</span></div></div>
        <p class="decision-note">This is a checkpoint: use real evidence and explain one practical trade-off. You still do not need a long CER.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> test + discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one recommendation</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Growing System Recommendation</h3></div><span>ONE PER TEAM</span></div>
        <p>Your recommendation needs these eight pieces.</p>
        <div class="profile-checklist"><label><input type="checkbox" /> continent</label><label><input type="checkbox" /> resource plant</label><label><input type="checkbox" /> main growing challenge</label><label><input type="checkbox" /> recommended growing system</label><label><input type="checkbox" /> soil / growing-medium evidence</label><label><input type="checkbox" /> Growth Trial evidence</label><label><input type="checkbox" /> one possible environmental consequence</label><label><input type="checkbox" /> one safeguard or improvement</label></div>
      </div>

      <div class="reflection-card"><p class="mini-label">MY REFLECTION</p><h3>What is one way humans can help a plant grow that could also create an environmental problem?</h3><p>Everyone answers this question individually.</p></div>

      <div class="finished-box"><strong>Mission 3 is finished when:</strong><span>✓ your team has one Growing System Recommendation</span><span>✓ you completed the short individual reflection</span><p>Mission 4 — Choose the Next Generation — is upcoming. Do not start it yet.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Return to Phase 2 Mission Hub →</a></div>
    </section>

    <section class="print-packet" aria-label="Phase 2 Mission 3 printable packet">
      <section class="print-page">
        <h1>Phase 2 · Mission 3 — Soil / Growing Medium Investigation</h1>
        <p>Team: ________________________________ &nbsp; Date: ____________</p>
        <table><thead><tr><th>Growing material</th><th>Texture / particles</th><th>Compaction</th><th>Drainage</th><th>Water retained / dampness</th><th>What could this be useful for?</th></tr></thead><tbody><tr><th>Sand-rich</th><td></td><td></td><td></td><td></td><td></td></tr><tr><th>Clay-rich</th><td></td><td></td><td></td><td></td><td></td></tr><tr><th>Organic-rich</th><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>
        <p><strong>Growth Trial evidence:</strong> Compared with the control, what is one useful difference in the changed condition?</p><div class="writing-lines"></div>
        <p><strong>Growing System Challenge:</strong> What problem will your model solve?</p><div class="writing-lines short"></div>
        <p><strong>Test result:</strong> What worked? What could your model accidentally make worse?</p><div class="writing-lines"></div>
      </section>
      <section class="print-page page-break">
        <h1>Growing System Recommendation</h1>
        <p>Continent: ____________________________ &nbsp; Resource plant: ____________________________</p>
        <div class="print-grid two"><div><strong>Main growing challenge</strong></div><div><strong>Recommended growing system</strong></div></div>
        <div class="print-grid two"><div><strong>Soil / growing-medium evidence</strong></div><div><strong>Growth Trial evidence</strong></div></div>
        <div class="print-grid two"><div><strong>Possible environmental consequence</strong></div><div><strong>Safeguard / improvement</strong></div></div>
        <p><strong>Reasoning:</strong> Our growing system should __________ because our evidence shows __________. One possible problem is __________, so we would __________.</p><div class="writing-lines tall"></div>
        <p><strong>MY REFLECTION:</strong> What is one way humans can help a plant grow that could also create an environmental problem?</p><div class="writing-lines tall"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase2PlantSites, caseData: growingCases }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase2-posting';
      const CONDITION_KEY = 'jabberwocky-phase2-growth-condition';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const saved = localStorage.getItem(POSTING_KEY);
      const site = saved ? sites[saved] : null;
      const info = saved ? caseData[saved] : null;
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const challenge = document.getElementById('challenge-strip');
      const noContinent = document.getElementById('no-continent');
      const caseFiles = document.getElementById('case-files');

      if (site && info) {
        assignment.hidden = false; missing.hidden = true; challenge.hidden = false; noContinent.hidden = true; caseFiles.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-environment').textContent = site.previousTeamBriefing.environment;
        document.getElementById('assignment-plant').textContent = site.plant.name;
        document.getElementById('challenge-text').textContent = info.challenge;
        document.getElementById('challenge-focus').textContent = info.focus;
        document.querySelectorAll('[data-case-file]').forEach((el) => el.hidden = el.dataset.caseFile !== saved);
      } else {
        assignment.hidden = true; missing.hidden = false; challenge.hidden = true; noContinent.hidden = false; caseFiles.hidden = true;
      }

      const savedCondition = localStorage.getItem(CONDITION_KEY);
      const conditionLabel = document.getElementById('saved-condition');
      if (savedCondition) conditionLabel.textContent = `Changed condition saved from Mission 2: ${savedCondition}`;
      else conditionLabel.textContent = 'Growth Trial condition not saved here. Ask your teacher which condition your class changed—do not restart the trial.';

      document.getElementById('print-phase2-mission3')?.addEventListener('click', () => { document.body.classList.add('print-phase2-mission3'); window.print(); });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-phase2-mission3'));
    })();
  </script>
</BaseLayout>

<style>
