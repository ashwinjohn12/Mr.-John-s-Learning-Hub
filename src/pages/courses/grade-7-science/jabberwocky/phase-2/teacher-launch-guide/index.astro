---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const phase2 = (part = '') => `${base}courses/grade-7-science/jabberwocky/phase-2/${part}`;

const coreDays = [
  { day:1, week:1, mission:'Mission 1 — Find the Living Resource', title:'New Team, New Resource Plant', route:'mission-1/', prep:'Assign Phase 2 teams/continents; open the Phase 2 Hub; set up 3–5 shared flowering/seed-plant stations; print Plant Structure Investigation sheets.', materials:'Devices; a few shared real flowering/seed plants; pencils; Plant Structure Investigation sheet. Hand lenses are optional; trays are only needed if the specimens are messy.', student:'Phase 2 launch → new-team/new-continent handoff → Previous Team Briefing → roots, stems, leaves, reproductive structures → begin real-plant investigation.', science:'Plant structures have functions: roots absorb/anchor; stems support/transport; leaves capture light and support photosynthesis/gas exchange; reproductive structures help make the next generation.', emphasis:'Use structure → job → survival. Rotate teams through shared plant stations rather than buying one specimen per team.', collect:'Plant Structure Investigation observations — formative only.', cut:'Extended whole-class sharing. Finish the structure-to-job table next class if needed.' },
  { day:2, week:1, mission:'Mission 1 — Find the Living Resource', title:'Earth Plant → Jabberwocky Plant', route:'mission-1/#investigate', prep:'Confirm Phase 2 continent postings are saved; return field sheets; open continent resource-plant clues.', materials:'Devices; Mission 1 field sheet; Living Resource Profile; pencils.', student:'Finish real-plant reasoning → investigate four Jabberwocky structure clues → connect structure, function, adaptation and possible human use.', science:'Plant structures vary; adaptations can help plants survive particular environments; useful plants remain part of ecosystems.', emphasis:'The fictional plant must obey the science students observed. Keep evidence ahead of imagination.', collect:'Check at least one structure claim is supported by a clue — formative.', cut:'Optional future-production details and artistic polish.' },
  { day:3, week:1, mission:'Mission 1 — Find the Living Resource', title:'Living Resource Decision', route:'mission-1/#record', prep:'Make the Living Resource Profile available; confirm inherited Phase 1 warning is visible.', materials:'Device; Living Resource Profile; Mission 1 evidence.', student:'Choose the plant feature that makes the resource most promising or difficult for humans to use → complete one profile + reflection.', science:'Adaptations affect both survival and possible human use.', emphasis:'One strong feature with a clear explanation is enough. Assess reasoning, not drawing quality.', collect:'Living Resource Profile — formative; individual reflection for feedback.', cut:'Sharing/polish. Keep the team decision, profile and reflection.' },
  { day:4, week:1, mission:'Mission 2 — Keep It Growing', title:'What Does a Plant Need?', route:'mission-2/#investigate', prep:'Choose ONE class-wide changed condition. Prefer a no-purchase condition such as reduced water or reduced light. Stage two small reused containers/team, seeds, growing medium and labels; start one teacher backup tray beforehand if practical.', materials:'2 small reused containers/team; fast-growing seeds; growing medium; labels; water/measuring cup; tray or spill mat; Growth Trial data sheet. Extra treatment materials are only needed if you deliberately choose a treatment that requires them.', student:'Mission launch → basic plant needs → set up CONTROL and CHANGED conditions → record starting state.', science:'Plant growth depends on environmental conditions; fair tests change one condition while keeping others similar.', emphasis:'Use one class-wide changed condition so pooled evidence is useful. Clean yogurt cups or similar reused containers are fine—the goal is evidence, not specialized equipment.', collect:'Growth Trial setup/data sheet — formative evidence, not a separate assignment.', cut:'Teacher can finish watering/placement logistics after class; do not skip labels or fair-test thinking.' },
  { day:5, week:1, mission:'Mission 2 — Keep It Growing', title:'Get + Move Water and Materials', route:'mission-2/#learn', prep:'Check Growth Trial containers; prepare a short coloured-water transport/transpiration demo only if useful.', materials:'Devices; Growth Trial sheet; ruler; optional clear cup + coloured water + celery/carnation or transpiration demo.', student:'GET MATERIALS: diffusion + osmosis → MOVE WATER & MATERIALS: transport + transpiration → 3–5 minute Growth Trial check.', science:'Water and dissolved materials enter/move through plants; water can leave leaves as vapour.', emphasis:'Teach one connected pathway, not four disconnected vocabulary words. Detailed xylem/phloem is optional.', collect:'Quick observation + exit explanation — formative.', cut:'Optional demonstration before cutting the connected process explanation.' },
  { day:6, week:2, mission:'Mission 2 — Keep It Growing', title:'Make Food + Make New Plants', route:'mission-2/#learn', prep:'Check plants; prepare a simple life-cycle visual.', materials:'Devices; Growth Trial sheet; ruler; simple seed/seedling/flower images or specimens.', student:'Photosynthesis + gas exchange → seed → germination → seedling → mature plant → flowers/seeds → simple propagation → quick Growth Trial check.', science:'Plants use light, water and carbon dioxide to make food; oxygen is released; seed plants reproduce and new plants can begin from seeds or some vegetative methods.', emphasis:'Keep photosynthesis conceptual. Do not add detailed cellular chemistry or Grade 9 genetics.', collect:'Quick process explanation — formative.', cut:'Shorten propagation examples; protect photosynthesis, gas exchange and the life-cycle sequence.' },
  { day:7, week:2, mission:'Mission 2 — Keep It Growing', title:'What Will Work on Jabberwocky?', route:'mission-2/#record', prep:'Confirm continent growth clues are available; prepare Plant Growth Requirements Card.', materials:'Device; Growth Trial sheet; Plant Growth Requirements Card.', student:'Compare available Growth Trial evidence → read assigned continent clues → choose the growing condition humans must control most carefully → card + reflection.', science:'Plant processes interact with environmental conditions; growth needs vary by context.', emphasis:'Use: When ___ changed, ___ changed. This suggests the plant needs ___. On our continent, this matters because ___.', collect:'Plant Growth Requirements Card — formative. Keep Growth Trial running.', cut:'Finish the card on Flex Day 8 if needed; do not end the Growth Trial just because Mission 2 is complete.' },
  { day:9, week:2, mission:'Mission 3 — Build the Growing Zone', title:'What Makes Good Soil?', route:'mission-3/#investigate', prep:'Set up shared stations with small class quantities of sand-rich, clay-rich and organic-rich media. Reuse identical cups/filters or drainage containers at the stations.', materials:'Three shared media; reusable drainage cups/containers; trays; water; measuring cups; spoons; one or a few timers; paper towels; investigation sheet.', student:'Mission launch → particle size → pore spaces → drainage/retention/compaction → begin Soil / Growing Medium Investigation.', science:'Particle size and pore spaces affect water movement and root conditions.', emphasis:'Make the causal chain explicit: particles → spaces → water movement → root conditions. Teams rotate through stations rather than receiving three full material sets.', collect:'Investigation observations — formative.', cut:'Finish drainage measurements next class; remove extra media rather than core comparisons.' },
  { day:10, week:2, mission:'Mission 3 — Build the Growing Zone', title:'Investigate the Growing Medium', route:'mission-3/#investigate', prep:'Reset shared media stations if needed; prepare short examples of fertilizer, irrigation, protected growing, raised/contained beds and soilless growing.', materials:'Shared soil-investigation stations; technology cards/images; devices.', student:'Complete media tests → compare evidence → connect fertilizer, irrigation and modified growing environments to problems they solve and impacts they may create.', science:'Plants need water and dissolved materials; human technologies can modify growing conditions and can create unintended effects.', emphasis:'Technologies are tools for particular problems, not automatically better methods.', collect:'Completed soil/growing-medium evidence — formative.', cut:'Keep one clear example each of water, nutrients and environment modification; move detail to Learn More.' },
  { day:11, week:3, mission:'Mission 3 — Build the Growing Zone', title:'Build the Growing Zone', route:'mission-3/#investigate', prep:'Take final/near-final Growth Trial reading if practical; set out one shared prototype-material station; provide one reused cup/container per team or allow a labelled design instead; confirm continent challenge cards.', materials:'Growth Trial sheets; rulers; one reused cup/container per team if building; shared media/gravel/wick/string/cover/water; safe drainage setup; continent evidence. A labelled design is an equally valid low-material option.', student:'Compare CONTROL vs CHANGED evidence → read 3–4 continent clues → build/test one small growing-system model OR create a labelled testable design solving one problem.', science:'Plant-needs evidence + media behaviour can guide a practical growing system; solutions can also create consequences.', emphasis:'One problem, one testable idea, one consequence. Do not make a miniature engineering kit for every team; the reasoning is the checkpoint.', collect:'Prototype/design evidence + Growth Trial comparison — checkpoint evidence in progress.', cut:'Use a labelled design instead of a physical build; protect evidence-to-decision reasoning.' },
  { day:12, week:3, mission:'Mission 3 — Build the Growing Zone', title:'Recommend a Growing System', route:'mission-3/#record', prep:'Return soil/Growth Trial evidence; prepare Growing System Recommendation.', materials:'Device; growing-medium evidence; Growth Trial evidence; prototype/design; Growing System Recommendation.', student:'Recommend one system → identify one environmental consequence → add one safeguard → Team Record + reflection.', science:'A practical growing system should fit plant needs/environmental conditions while reducing foreseeable impacts.', emphasis:'Our system should ___ because evidence shows ___. One possible problem is ___, so we would ___.', collect:'Growing System Recommendation — stronger Phase 2 reasoning checkpoint.', cut:'Accept a clear diagram + concise reasoning; cut presentation/polish before consequence + safeguard.' },
  { day:14, week:3, mission:'Mission 4 — Choose the Next Generation', title:'Plants Are Not All the Same', route:'mission-4/#investigate', prep:'Print/cut Selective Breeding Simulation starter cards + tracker.', materials:'Starter population cards; trait labels; generation tracker; devices.', student:'Reproduction/pollination → plant variety → selective breeding → choose one target trait → begin simulation.', science:'Plants of the same kind vary; repeated human selection can make useful characteristics more common in cultivated varieties.', emphasis:'Variation exists before selection. No Punnett squares, alleles, genotype/phenotype or dominant/recessive inheritance.', collect:'Simulation tracker — formative/light.', cut:'Model one generation together and continue next class.' },
  { day:15, week:3, mission:'Mission 4 — Choose the Next Generation', title:'Choose the Next Generation', route:'mission-4/#investigate', prep:'Prepare continent surprise event cards and short pest-management examples.', materials:'Simulation cards/tracker; surprise cards; biological, physical/cultural and chemical control cards.', student:'Run 2–3 simplified generations → observe trait change → reveal surprise → discuss low-variety/monoculture risk → consider simple control strategies.', science:'Selective breeding can increase useful traits; uniform populations may share vulnerabilities; pest controls can have benefits and unintended effects.', emphasis:'Selective breeding can be useful. Variety and safeguards still matter. Real offspring vary and real breeding takes many generations.', collect:'Simulation reasoning — formative/light.', cut:'Stop after two generations; reveal only one surprise.' },
  { day:16, week:4, mission:'Mission 4 — Choose the Next Generation', title:'What Should JCEC Select?', route:'mission-4/#record', prep:'Open three continent evidence cards; prepare Plant Variety Decision Card.', materials:'Device; simulation result; continent evidence; Plant Variety Decision Card.', student:'Use simulation + continent evidence → choose one trait JCEC should favour + one risk to watch → Team Record + reflection.', science:'Useful traits involve trade-offs; the best choice depends on environmental conditions and risk.', emphasis:'We would select ___ because ___. But we would need to watch for ___.', collect:'Plant Variety Decision Card — formative/light.', cut:'Cut whole-class sharing; keep trait + evidence + risk + safeguard.' },
  { day:18, week:4, mission:'Mission 5 — Use It Without Losing It', title:'How Big Can This Get?', route:'mission-5/#investigate', prep:'Print/stage continent Production Footprint maps and paper tiles; confirm continent/resource plant/inherited warning are visible.', materials:'Printed footprint map; paper growing/harvest, protected habitat, water, infrastructure, processing/storage and buffer tiles; devices.', student:'Land use + production inputs + resilience + sustainability → receive 6-zone map, one production goal, 3 constraints → begin resource-use plan.', science:'Land conversion, irrigation, fertilizer, pest management, infrastructure and harvesting can increase production and affect habitat, soil, water and resilience.', emphasis:'Ask Can we keep producing it without damaging the system? not only Can we produce it? This is intentionally a paper planning model, not a construction project.', collect:'Initial footprint plan — formative evidence for final synthesis.', cut:'Use fewer tiles; do not add more zones or constraints.' },
  { day:19, week:4, mission:'Mission 5 — Use It Without Losing It', title:'The Consequence', route:'mission-5/#investigate', prep:'Prepare one continent-appropriate consequence card per team.', materials:'Printed footprint maps/tiles; consequence cards; pencils.', student:'Complete initial plan → reveal consequence → identify what it exposes → revise exactly one part of the plan.', science:'Resource systems can create unintended effects; sustainable planning includes monitoring, limits, buffers and revision.', emphasis:'The consequence is not a punishment for a wrong answer. It tests whether the plan can adapt.', collect:'One justified revision — formative evidence.', cut:'Require one written/diagrammed revision instead of rebuilding the whole map.' },
  { day:20, week:4, mission:'Mission 5 — Use It Without Losing It', title:'Build the Recommendation', route:'mission-5/#decide', prep:'Open Evidence Locker; make earlier Team Records available only if clarification is needed; print Living Resource Plans.', materials:'Device; Evidence Locker; footprint result; JCEC Living Resource Plan.', student:'Review four short mission reminders → choose 3 strongest evidence items → select final resource-use strategy → begin plan.', science:'Sustainable decisions use evidence about the plant, its needs, growing system, variation/risk and environmental consequences.', emphasis:'Evidence Locker first; do not send students back through four mission pages. Three strong pieces of evidence beat a long list.', collect:'Living Resource Plan draft — major synthesis in progress.', cut:'Protect evidence selection + final strategy; move polish to Day 21/22.' },
  { day:21, week:5, mission:'Mission 5 — Use It Without Losing It', title:'JCEC Living Resource Decision', route:'mission-5/#record', prep:'Prepare final collection/submission method and concise teacher rubric.', materials:'JCEC Living Resource Plan; Evidence Locker; footprint revision; pencils/devices.', student:'Complete one-page plan → 3–5 sentence explanation → individual reflection.', science:'Human needs, technologies, plant biology, environmental conditions and sustainability are connected.', emphasis:'Assess science understanding → evidence → reasoning → sustainable practical decision. Visual polish should carry little/no weight.', collect:'JCEC Living Resource Plan — major Phase 2 synthesis; individual reflection supports interpretation.', cut:'Use Flex Day 22 for essential completion; cut presentations/gallery walk first.' }
];

const flexDays = [
  { day:8, title:'Growth timing + Mission 2 recovery', use:'Extra Growth Trial observation; delayed germination; absent-student catch-up; plant-process reteach.', priority:'Protect biological timing and core process understanding.' },
  { day:13, title:'Growth / Mission 3 lab recovery', use:'Final measurement or simple graph; soil-lab spillover/cleanup; prototype completion; absence recovery.', priority:'Protect evidence needed for the Mission 3 checkpoint.' },
  { day:17, title:'Science review + targeted reteach', use:'Structures/processes; soils; selective breeding; vocabulary misconceptions.', priority:'Fix misconceptions before final sustainability synthesis.' },
  { day:22, title:'Living Resource Plan completion', use:'Finish Mission 5 synthesis; recover missed footprint/simulation evidence.', priority:'Essential completion before enrichment.' },
  { day:23, title:'Short individual science check', use:'Optional concise individual assessment when an individual mark is needed.', priority:'Science understanding, not Jabberwocky trivia.' },
  { day:24, title:'Optional gallery walk / continent comparison', use:'Compare why different continents produced different strategies; brief presentations/peer questions.', priority:'Optional — cut before core learning.' },
  { day:25, title:'Final buffer / feedback / transition', use:'Absences, interruptions, final feedback, make-up or reteach.', priority:'No new Phase 3 content.' }
];

const materials = [
  { mission:'Mission 1', title:'Find the Living Resource', reusable:['3–5 shared real flowering/seed plants or one demonstration plant','pencils/clipboards','hand lenses only if already available'], print:['Plant Structure Investigation','Living Resource Profile'] },
  { mission:'Mission 2', title:'Keep It Growing', reusable:['2 reused small containers/team','fast-growing seeds','potting/growing medium','labels/markers','water + measuring cup/spoon','rulers','tray/spill mat','one no-purchase class-wide treatment such as reduced water or reduced light','optional transport/transpiration demo','optional teacher backup tray'], print:['JCEC Growth Trial data table','Plant Growth Requirements Card'] },
  { mission:'Mission 3', title:'Build the Growing Zone', reusable:['small shared quantities of sand-rich, clay-rich and organic-rich media','reusable drainage cups/containers at shared stations','trays','water/measuring cups','spoons','shared timer(s)','paper towels','one reused prototype cup/team if physically building','shared gravel/wick/string/cover material','safe drainage setup'], print:['Soil / Growing Medium Investigation','continent growing challenge/evidence','Growing System Recommendation','Mission 2 Growth Trial data','labelled design option instead of physical prototype'] },
  { mission:'Mission 4', title:'Choose the Next Generation', reusable:['starter plant population cards','trait labels','generation tracker','continent surprise cards','biological / physical-cultural / chemical control cards'], print:['Selective Breeding Simulation cards/tracker','Plant Variety Decision Card'] },
  { mission:'Mission 5', title:'Use It Without Losing It', reusable:['none beyond pencils if maps/tiles are printed'], print:['continent Production Footprint maps/zone mats','growing/harvest tiles','protected habitat tiles','water-access tiles','infrastructure tiles','processing/storage tiles','buffer/protection tiles','continent consequence cards','Evidence Locker on student page','one-page JCEC Living Resource Plan'] }
];

const growthTimeline = [
  ['2–3 days before Day 4','Optional teacher backup tray','Use the same seed type; this is insurance, not another student assignment.'],
  ['Day 4','SETUP','Teams establish CONTROL + one class-wide CHANGED condition.'],
  ['Day 5','CHECK 1','3–5 minutes: germination, height, leaves, visible health.'],
  ['Day 6','CHECK 2','3–5 minutes; continue normal class.'],
  ['Day 7','CHECK 3','Use available evidence for Mission 2 decision; keep plants growing.'],
  ['Day 8 FLEX','TIMING BUFFER','Extra observation, delayed germination, absence recovery or process reteach.'],
  ['Days 9–10','BACKGROUND','Quick observations while Mission 3 begins.'],
  ['Day 11','FINAL / NEAR-FINAL','Compare CONTROL vs CHANGED; one simple graph only if useful.'],
  ['Day 12','USE THE EVIDENCE','Growth Trial becomes one evidence source in the Growing System Recommendation.'],
  ['Day 13 FLEX','BIOLOGY BUFFER','Final check / graph / recovery only if timing needs it.']
];

const contingencies = [
  ['Failed germination','Use teacher backup plants, pooled class results or a teacher-provided sample dataset. Preserve evidence interpretation; do not restart the whole unit.'],
  ['Missing lab materials','Use shared stations/demos, two media instead of three, prepared data, digital cards, a labelled growing-system design or paper zone labels. Keep the reasoning target rather than the apparatus.'],
  ['A class is lost','Use the nearest flex day first. If needed, combine the lightest adjacent tasks and protect each mission’s final evidence-based decision.'],
  ['Student absent during a lab','Provide team/class data + photo/setup summary + one focused interpretation question. Do not require a solo repeat unless practical.'],
  ['Growth Trial shows little difference','Use the actual result. Ask what the evidence supports, whether treatment/time was sufficient, and what remains uncertain. Do not invent the expected result.'],
  ['Selective-breeding simulation runs long','Stop after two generations and reveal one surprise. The target is repeated selection + low-variety risk, not number of rounds.'],
  ['Production Footprint Challenge runs long','Freeze the current plan, reveal the consequence, and require one written/diagrammed revision instead of rebuilding the entire map.']
];
---

<BaseLayout title="Phase 2 Teacher Launch Guide | Jabberwocky 2190" description="Teacher implementation guide for the five-mission Plants for Food & Fibre Phase 2." themeColor="#0b1c16">
  <div class="teacher-shell" id="phase2-teacher-guide">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 2',href:phase2()},{label:'Teacher Launch Guide'}]} />

    <nav class="teacher-nav"><a href="#launch">Launch</a><a href="#core">18 Core</a><a href="#growth">Growth Trial</a><a href="#flex">7 Flex</a><a href="#materials">Materials</a><a href="#assessment">Assessment</a><a href="#curriculum">Curriculum</a><a href="#contingency">Contingency</a></nav>

    <header class="hero" id="launch">
      <div><p class="eyebrow">TEACHER GUIDE // PHASE 2</p><h1>THE LIVING RESOURCE<br/><span>FIVE-MISSION LAUNCH</span></h1><p>The teacher plan now matches exactly what students see: <strong>5 missions · 18 core classes · 7 purposeful flex classes</strong>.</p></div>
      <aside><strong>25 × 45 MIN</strong><span>18 CORE + 7 FLEX</span></aside>
    </header>

    <section class="panel setup">
      <p class="eyebrow">BEFORE DAY 1</p><h2>Set the system once.</h2>
      <div class="grid four">
        <article><strong>New teams + postings</strong><p>Assign new Phase 2 teams and normally a different continent. The site stores Phase 2 separately from Phase 1.</p></article>
        <article><strong>Choose submission mode</strong><p>Team Records can be paper, digital or both. Keep metadata and tracking teacher-managed.</p></article>
        <article><strong>Prepare one backup growth tray</strong><p>If practical, start it 2–3 days before Mission 2 in case student germination is delayed.</p></article>
        <article><strong>Use low-material defaults</strong><p>Prefer shared stations, reused containers, printables and no-purchase treatments such as reduced water/light before buying dedicated lab sets.</p></article>
      </div>
      <div class="actions"><a class="button primary" href={phase2()}>Open Student Hub</a><button class="button secondary" id="print-guide" type="button">Print guide</button></div>
    </section>

    <section class="mission-strip">
      <article><b>M1 · 3 classes</b><strong>Find the Living Resource</strong><span>Resource</span></article>
      <article><b>M2 · 4 classes</b><strong>Keep It Growing</strong><span>Growth</span></article>
      <article><b>M3 · 4 classes</b><strong>Build the Growing Zone</strong><span>Growing Zone</span></article>
      <article><b>M4 · 3 classes</b><strong>Choose the Next Generation</strong><span>Variety</span></article>
      <article><b>M5 · 4 classes</b><strong>Use It Without Losing It</strong><span>Sustainable Use</span></article>
    </section>

    <section class="section-head" id="core"><p class="eyebrow">CORE PATH</p><h2>18 classes teachers should protect</h2><p>Every class answers the same planning questions: before class, materials, student work, science, emphasis, collect/assess, and what can be shortened first.</p></section>
    <div class="days">
      {coreDays.map(d => <article class="day"><header><span>DAY {d.day}</span><div><small>WEEK {d.week} · {d.mission}</small><h3>{d.title}</h3></div><a href={phase2(d.route)}>Open →</a></header><div class="day-grid"><section><b>BEFORE CLASS</b><p>{d.prep}</p></section><section><b>MATERIALS</b><p>{d.materials}</p></section><section><b>STUDENTS SEE / DO</b><p>{d.student}</p></section><section><b>KEY SCIENCE</b><p>{d.science}</p></section><section><b>TEACHER EMPHASIS</b><p>{d.emphasis}</p></section><section><b>COLLECT / ASSESS</b><p>{d.collect}</p></section><section class="cut"><b>IF TIME RUNS OUT</b><p>{d.cut}</p></section></div></article>)}
    </div>

    <section class="section-head" id="growth"><p class="eyebrow">BIOLOGY MANAGEMENT</p><h2>Growth Trial timeline</h2><p>The trial runs for about <strong>7–10 calendar days</strong>, but selected observations take only <strong>3–5 minutes</strong>. It is evidence, not a daily assignment.</p></section>
    <div class="timeline">{growthTimeline.map(([when,title,note]) => <article><span>{when}</span><strong>{title}</strong><p>{note}</p></article>)}</div>
    <div class="panel note"><h3>If the plants do not cooperate</h3><p><strong>Poor germination:</strong> use teacher backup plants, pooled class data or a sample dataset. <strong>Little difference:</strong> treat that as valid evidence and discuss what the data can/cannot support. <strong>Slow growth:</strong> use the strongest available observations and keep the unit moving.</p></div>

    <section class="section-head" id="flex"><p class="eyebrow">PURPOSEFUL BUFFER</p><h2>7 flex periods with jobs</h2><p>Use flex time for biology, absences, reteaching and assessment before enrichment.</p></section>
    <div class="flex-grid">{flexDays.map(d => <article><span>DAY {d.day}</span><h3>{d.title}</h3><p>{d.use}</p><b>PRIORITY</b><small>{d.priority}</small></article>)}</div>

    <section class="section-head" id="materials"><p class="eyebrow">MISSION MATERIALS MASTER LIST</p><h2>Prepare shared stations and printables before buying duplicates</h2></section>
    <div class="materials-grid">{materials.map(m => <article><header><span>{m.mission}</span><h3>{m.title}</h3></header><div><b>SHARED / REUSABLE</b><ul>{m.reusable.map(x => <li>{x}</li>)}</ul></div><div><b>PRINT / DIGITAL</b><ul>{m.print.map(x => <li>{x}</li>)}</ul></div></article>)}</div>

    <section class="section-head" id="assessment"><p class="eyebrow">ASSESSMENT MAP</p><h2>Do not grade every Team Record</h2></section>
    <div class="assessment-grid">
      <article><span>FORMATIVE</span><h3>Missions 1, 2 and 4</h3><p>Living Resource Profile; Plant Growth Requirements Card; Plant Variety Decision Card. Give feedback/completion checks; avoid three extra projects.</p></article>
      <article class="checkpoint"><span>CHECKPOINT · 30%</span><h3>Mission 3</h3><p><strong>Growing System Recommendation</strong>: science understanding → evidence → reasoning → practical decision.</p></article>
      <article class="major"><span>MAJOR SYNTHESIS · 55%</span><h3>Mission 5</h3><p><strong>JCEC Living Resource Plan</strong>: science understanding → cross-mission evidence → reasoning → sustainable practical decision. Visual polish carries little/no weight.</p></article>
      <article><span>OPTIONAL INDIVIDUAL · 15%</span><h3>Short science check</h3><p>Use Flex Day 23 when a clean individual mark is needed. Assess science, not story trivia.</p></article>
    </div>
    <p class="weight-note">Recommended formal weighting: <strong>30% Mission 3 + 55% Mission 5 + 15% individual science check.</strong> If the individual check is not needed, redistribute locally rather than creating another major assignment.</p>

    <section class="section-head" id="curriculum"><p class="eyebrow">ALBERTA GRADE 7 SCIENCE</p><h2>Plants for Food & Fibre alignment</h2><p>This plan uses the existing Alberta Grade 7 Science Program of Studies, Unit B. <a href="https://education.alberta.ca/media/159716/sci7to9.pdf">Official program source ↗</a></p></section>
    <div class="curriculum-grid">
      <article><b>OUTCOME AREA 1</b><h3>Plant uses, needs, technologies, products, impacts</h3><p>Missions 1, 3 and 5: Living Resource Profile → Growing System Recommendation → Living Resource Plan.</p></article>
      <article><b>OUTCOME AREA 2</b><h3>Life processes, structures, characteristics and needs</h3><p>Missions 1–2: roots/stems/leaves/reproductive structures; diffusion, osmosis, transport, transpiration, photosynthesis, gas exchange, germination, reproduction and propagation.</p></article>
      <article><b>OUTCOME AREA 3</b><h3>Plant environments, factors and controls</h3><p>Missions 2–5: Growth Trial; soils/media; fertilizer/irrigation/growing technologies; selective breeding/pest management; Production Footprint Challenge.</p></article>
      <article><b>OUTCOME AREA 4</b><h3>Human needs, technologies, environments, food and fibre</h3><p>Missions 3–5 culminate in the evidence-based JCEC Living Resource Plan.</p></article>
    </div>
    <div class="panel note"><h3>Keep enrichment optional</h3><p>Detailed xylem/phloem anatomy, cellular photosynthesis chemistry, advanced soil chemistry, Punnett squares/genetics terminology, detailed pesticide chemistry and agricultural economics are not required on the core student pathway. Hydroponics is one possible growing technology example, not a separate mandatory unit.</p></div>

    <section class="section-head" id="contingency"><p class="eyebrow">RECOVERY PLAN</p><h2>When real classrooms happen</h2></section>
    <div class="contingency-grid">{contingencies.map(([problem,response]) => <article><h3>{problem}</h3><p>{response}</p></article>)}</div>
    <div class="panel scaffold"><h3>If students are overloaded, return to one scaffold.</h3><p><strong>M1:</strong> structure → job → survival &nbsp;·&nbsp; <strong>M2:</strong> condition changed → plant response → plant need &nbsp;·&nbsp; <strong>M3:</strong> system → evidence → consequence → safeguard &nbsp;·&nbsp; <strong>M4:</strong> select trait → benefit → risk &nbsp;·&nbsp; <strong>M5:</strong> decision → evidence → consequence/safeguard</p></div>

    <section class="readiness">
      <p class="eyebrow">TEACHER LAUNCH-READINESS AUDIT</p><h2>Can I teach this tomorrow?</h2>
      <div class="audit-grid">
        <article><strong>Do I know what to prepare tomorrow?</strong><p>Yes. Every core class names preparation/materials, and the Mission Materials Master List separates shared/reusable resources from print/digital resources.</p></article>
        <article><strong>Do I know what students should finish each day?</strong><p>Yes. Each day names the student task and collection point. Only Missions 3 and 5 carry significant formal weight.</p></article>
        <article><strong>Do I know what I actually need to assess?</strong><p>Yes. M1/M2/M4 formative; M3 checkpoint; M5 major synthesis; optional individual science check.</p></article>
        <article><strong>Can I recover if plant growth or lab timing changes?</strong><p>Yes. Flex Days 8 and 13 protect the Growth Trial/Mission 3, and the contingency plan supports pooled/sample data, shared stations, labelled designs, shorter simulations and written revisions.</p></article>
        <article><strong>Do teacher and student systems match?</strong><p>Yes. The same mission names, 3 + 4 + 4 + 3 + 4 pacing, investigations, Team Records, reasoning scaffolds and final Living Resource Plan are used in both.</p></article>
      </div>
      <p class="stop"><strong>STOP AFTER PHASE 2.</strong> Do not begin Phase 3 until the Phase 2 teacher system is approved.</p>
    </section>
  </div>

