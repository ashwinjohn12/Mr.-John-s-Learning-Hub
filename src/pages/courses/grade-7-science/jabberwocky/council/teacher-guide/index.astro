ize:.75rem}.guard-grid span,.contingency-grid span{color:#94a8b7;font-size:.72rem;line-height:1.45}.section-heading h2{margin:.25rem 0;color:#fff}.day-card{margin:.85rem 0;border:1px solid #35536c;border-radius:12px;background:#07131f;overflow:hidden}.day-card header{display:flex;gap:.7rem;align-items:center;padding:.7rem .8rem;background:#102337}.day-card header span{padding:.3rem .45rem;border-radius:999px;background:#f0be68;color:#251706;font-size:.62rem;font-weight:900}.day-card h3{margin:0;color:#fff}.day-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem;padding:.7rem}.day-grid>div{padding:.65rem;border:1px solid #263e52;border-radius:8px}.day-grid .wide{grid-column:1/-1}.day-grid small{color:#8fc1e3;font-size:.6rem;font-weight:900}.day-grid p{margin:.22rem 0 0;color:#afc0cd;font-size:.75rem;line-height:1.45}.lens-list{display:grid;gap:.45rem}.lens-list article{display:grid;grid-template-columns:32px 1fr auto;gap:.55rem;align-items:center;padding:.65rem;border-radius:9px;background:#07131f}.lens-list b{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#23445e;color:#fff}.lens-list strong{color:#fff;font-size:.76rem}.lens-list span{color:#f0be68;font-size:.64rem;font-weight:900}.note{margin:.7rem 0 0;padding:.75rem;border-radius:9px;background:#15283a;color:#b9c8d3;line-height:1.5}.fallback-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.fallback-grid article{padding:.8rem;border-radius:10px;background:#07131f}.fallback-grid small{color:#f0be68;font-weight:900}.fallback-grid strong{display:block;margin:.15rem 0;color:#fff}.fallback-grid p{color:#9eafbb}.closure blockquote{margin:1rem 0 0;padding:1rem;border-left:4px solid #73a866;background:#0c2114;color:#d6ead8;font-weight:750}.check-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;margin:.7rem 0}.check-grid span{padding:.6rem;border-radius:8px;background:#07131f;color:#b9c9d5;font-size:.76rem}.ready-audit>a{display:inline-flex;margin-t