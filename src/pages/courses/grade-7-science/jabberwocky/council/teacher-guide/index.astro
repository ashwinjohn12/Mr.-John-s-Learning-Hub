---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const council = `${base}courses/grade-7-science/jabberwocky/council/`;
const coreDays = [
  {
    day:1,
    title:'Open the Evidence Vault',
    before:'Confirm each team keeps its Phase 5 team and continent. Open the Council page and verify the saved Phase 5 posting loads the correct five-card Evidence Vault. Decide whether students will work on paper, Chromebook or both.',
    materials:'Mission 2190 Evidence Vault, Five-Lens Council Review, pencils and/or Chromebooks. No old Team Records.',
    students:'Read exactly five evidence cards → sort what each lens supports, limits, protects and leaves uncertain → complete the Five-Lens Council Review → identify two plausible Council outcomes.',
    science:'Cross-unit transfer: ecosystems, plant resources, thermal survival, structures/forces and geology all constrain one decision. Evidence is not the same as a recommendation.',
    emphasis:'Do not let students choose an outcome first and then hunt for supporting evidence. Every team must consider all five lenses. No continent has a predetermined correct answer.',
    collect:'Completed Five-Lens Council Review and two plausible candidate outcomes — capstone evidence in progress.',
    cut:'If time is short, complete one strong SUPPORTS/LIMITS/PROTECTS/UNCERTAIN entry per lens and identify two candidate outcomes. Do not reopen archives.'
  },
  {
    day:2,
    title:'The Council Deliberates',
    before:'Prepare the five outcome cards and the two-option comparison board. Review which safeguards are already established canon for each continent.',
    materials:'Five-Lens Council Review, outcome cards, two-option comparison board, pencils/Chromebooks.',
    students:'Compare at least two plausible outcomes → identify strongest supporting evidence, biggest limit, required safeguard and important uncertainty for each → discuss mixed directives where appropriate → choose a draft directive.',
    science:'Scientific decision making weighs multiple forms of evidence, trade-offs, protection needs and uncertainty. A responsible recommendation can remain conditional.',
    emphasis:'A directive is not a popularity vote. Environmental safeguards matter as much as human convenience. “Delay and collect more evidence” is a legitimate outcome when a critical uncertainty remains.',
    collect:'Two-option comparison and draft directive — year-long transfer reasoning.',
    cut:'Compare exactly two outcomes and require one explicit trade-off, one safeguard and one uncertainty before choosing.'
  },
  {
    day:3,
    title:'Issue the Mission 2190 Directive',
    before:'Prepare one Mission 2190 Council Directive per team and one reflection prompt per student. Decide whether to use optional 60-second Council Statements or a quiet gallery after core work is complete.',
    materials:'Council Directive, five evidence cards, completed review board, pencils/Chromebooks.',
    students:'Finalize level of human presence + where/scale + protection requirements → cite all five science lenses → select three non-negotiable safeguards → name one uncertainty and next investigation → write 4–6 sentence Council message → complete individual reflection.',
    science:'A final scientific recommendation should be evidence-based, revisable and explicit about uncertainty, safeguards and next questions.',
    emphasis:'Assess evidence integration and reasoning, not presentation polish or memorized vocabulary. One directive per team; one reflection per student.',
    collect:'Mission 2190 Council Directive + individual reflection — final year-long transfer task.',
    cut:'Protect the directive, three safeguards, one uncertainty, five evidence lenses and individual reflection. Cut gallery/presentation first.'
  }
];
---

<BaseLayout title="Mission 2190 Council — Teacher Guide" description="Three-class teacher implementation guide for the final Mission 2190 Council capstone." themeColor="#08172b">
  <div class="teacher-shell" id="mission-2190-council-teacher-guide">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Mission 2190 Council', href:council },
      { label:'Teacher Guide' }
    ]} />

    <header class="teacher-hero">
      <div><p class="eyebrow">FINAL CAPSTONE // TEACHER IMPLEMENTATION</p><h1>MISSION 2190<br /><span>COUNCIL GUIDE</span></h1><p>The Council is a <strong>3-class year-long transfer task</strong>, not a sixth science unit. Students stay with their Phase 5 teams and continents and use exactly five concise Evidence Vault cards instead of reopening old Team Records.</p></div>
      <aside><span>CORE DESIGN</span><strong>Evidence Vault → Five-Lens Review → Compare Two Outcomes → Council Directive → Reflection</strong><small>No new content unit · essentially no-purchase</small></aside>
    </header>

    <section class="quick-grid">
      <article><small>STUDENT ROLE</small><strong>JCEC Council Delegation</strong></article>
      <article><small>TEAM RECORD</small><strong>1 Mission 2190 Council Directive</strong></article>
      <article><small>INDIVIDUAL</small><strong>1 short reflection</strong></article>
      <article><small>TIME</small><strong>3 × 45 minutes</strong></article>
    </section>

    <section class="guardrails">
      <p class="eyebrow">NON-NEGOTIABLE COUNCIL GUARDRAILS</p>
      <div class="guard-grid">
        <article><strong>NO ARCHIVE REOPENING</strong><span>The five Evidence Vault cards are the capstone evidence source.</span></article>
        <article><strong>NO PREDETERMINED OUTCOME</strong><span>Do not score a continent against a hidden “correct” settlement status.</span></article>
        <article><strong>NO NEW JABBERWOCKY CANON</strong><span>Do not invent hazards, resources, energy systems, structures, fossil beds, faults or ecosystem conditions to make the decision easier.</span></article>
        <article><strong>NO VOCABULARY TEST</strong><span>Students should apply science rather than re-memorize five units.</span></article>
        <article><strong>UNCERTAINTY COUNTS</strong><span>A responsible Council may limit or delay activity because evidence remains incomplete.</span></article>
        <article><strong>PROTECTION IS PART OF THE DECISION</strong><span>Safeguards are not an optional add-on after the human-presence choice.</span></article>
      </div>
    </section>

    <section class="days">
      <div class="section-heading"><p class="eyebrow">3-CLASS IMPLEMENTATION</p><h2>What to do each day</h2></div>
      {coreDays.map((day) => (
        <article class="day-card">
          <header><span>CLASS {day.day}</span><h3>{day.title}</h3></header>
          <div class="day-grid">
            <div><small>BEFORE CLASS</small><p>{day.before}</p></div>
            <div><small>MATERIALS</small><p>{day.materials}</p></div>
            <div><small>STUDENTS SEE / DO</small><p>{day.students}</p></div>
            <div><small>KEY SCIENCE / SYNTHESIS</small><p>{day.science}</p></div>
            <div><small>TEACHER EMPHASIS</small><p>{day.emphasis}</p></div>
            <div><small>COLLECT / ASSESS</small><p>{day.collect}</p></div>
            <div class="wide"><small>IF TIME RUNS OUT</small><p>{day.cut}</p></div>
          </div>
        </article>
      ))}
    </section>

    <section class="materials">
      <div class="section-heading"><p class="eyebrow">LOW-MATERIAL IMPLEMENTATION</p><h2>The final Council should require no new purchases.</h2></div>
      <div class="materials-grid">
        <article><small>PREFERRED</small><strong>Printed or digital Evidence Vault</strong><span>Exactly five cards per team.</span></article>
        <article><small>PREFERRED</small><strong>Five-Lens Council Review</strong><span>Paper or website prompts.</span></article>
        <article><small>PREFERRED</small><strong>Mission 2190 Council Directive</strong><span>One per team.</span></article>
        <article><small>OPTIONAL</small><strong>Chromebooks / projector</strong><span>Useful but not required if cards are printed.</span></article>
        <article><small>ESSENTIAL</small><strong>Pencils</strong><span>No laboratory materials or physical model needed.</span></article>
        <article><small>NO-PURCHASE FALLBACK</small><strong>Project the Evidence Vault</strong><span>Teams complete the review and directive on ordinary paper.</span></article>
      </div>
    </section>

    <section class="evidence-system">
      <div class="section-heading"><p class="eyebrow">MISSION 2190 EVIDENCE VAULT</p><h2>Exactly five concise science lenses</h2></div>
      <div class="lens-list">
        <article><b>1</b><strong>ECOSYSTEM EVIDENCE + ECOLOGICAL SAFEGUARD</strong><span>Phase 1</span></article>
        <article><b>2</b><strong>PLANT RESOURCE EVIDENCE + SUSTAINABILITY RULE</strong><span>Phase 2</span></article>
        <article><b>3</b><strong>THERMAL EVIDENCE + SURVIVAL / ENERGY RULE</strong><span>Phase 3</span></article>
        <article><b>4</b><strong>STRUCTURAL EVIDENCE + SAFETY / SITE RULE</strong><span>Phase 4</span></article>
        <article><b>5</b><strong>GEOLOGICAL EVIDENCE + LIMIT / UNCERTAINTY / PROTECTION RULE</strong><span>Phase 5</span></article>
      </div>
      <p class="note"><strong>Teacher check:</strong> the Evidence Vault summarizes established project canon. It must not become an answer key. The cards contain evidence and constraints only; students choose the final directive.</p>
    </section>

    <section class="assessment">
      <div class="section-heading"><p class="eyebrow">ASSESSMENT ROLE</p><h2>Year-long transfer task</h2></div>
      <p>The Council is best assessed as evidence transfer and scientific decision making. It should <strong>not</strong> replace unit-specific science assessments and should not become a vocabulary exam.</p>
      <div class="assessment-grid">
        <article><strong>EVIDENCE INTEGRATION</strong><span>Uses all five science lenses accurately and relevantly.</span></article>
        <article><strong>REASONING / TRADE-OFFS</strong><span>Explains why the directive fits the combined evidence better than at least one alternative.</span></article>
        <article><strong>SAFEGUARDS + UNCERTAINTY</strong><span>Protection rules are specific and uncertainty meaningfully affects the plan.</span></article>
        <article><strong>FINAL COMMUNICATION</strong><span>Council message is concise, evidence-based and revisable if new evidence appears.</span></article>
      </div>
      <p class="note">If a numeric score is needed, use four roughly equal criteria. Do not add points for artistic design, elaborate presentation or recalling old Team Record wording.</p>
    </section>

    <section class="fallback">
      <div class="section-heading"><p class="eyebrow">2-CLASS COMPRESSED FALLBACK</p><h2>If the end-of-year calendar collapses</h2></div>
      <div class="fallback-grid">
        <article><small>CLASS 1</small><strong>Evidence Vault + Review + Compare Two Outcomes</strong><p>Read the five cards, complete one strong SUPPORTS/LIMITS/PROTECTS/UNCERTAIN entry per lens, compare exactly two outcomes, and select a draft directive.</p></article>
        <article><small>CLASS 2</small><strong>Directive + Reflection + Closure</strong><p>Finalize human-presence level, scale, three safeguards, protection, uncertainty, next investigation, Council message and individual reflection.</p></article>
      </div>
      <p class="note">Cut gallery walks and presentations first. Do not cut the five-lens evidence review, uncertainty, safeguards or individual reflection.</p>
    </section>

    <section class="contingencies">
      <div class="section-heading"><p class="eyebrow">COMMON END-OF-YEAR CONTINGENCIES</p><h2>Keep the reasoning, not the ceremony</h2></div>
      <div class="contingency-grid">
        <article><strong>Phase 5 posting missing</strong><span>Use the teacher-assigned Phase 5 continent and restore it through the Phase 5 hub. Do not assign a new continent in the Council.</span></article>
        <article><strong>Students want old assignments</strong><span>Redirect to the five Evidence Vault cards. The capstone is intentionally archive-light.</span></article>
        <article><strong>Students pick an answer immediately</strong><span>Require the Five-Lens Review and comparison of two plausible outcomes before a directive is accepted.</span></article>
        <article><strong>Students ignore environmental safeguards</strong><span>Remind them that three non-negotiable safeguards and a protection statement are required parts of the final record.</span></article>
        <article><strong>Students think “delay” means failure</strong><span>Reframe it as a scientific decision when a critical uncertainty remains.</span></article>
        <article><strong>Teams disagree</strong><span>Ask which claim is better supported by the Evidence Vault; allow a mixed directive if the evidence supports it.</span></article>
        <article><strong>A class is lost</strong><span>Switch to the approved two-class compressed pathway.</span></article>
        <article><strong>Printing/device failure</strong><span>Project the five evidence cards and use ordinary lined paper for the review/directive. No special template is required.</span></article>
      </div>
    </section>

    <section class="closure">
      <p class="eyebrow">YEAR-LONG STORY CLOSURE</p><h2>End with evidence—not conquest.</h2>
      <p>Avoid treating permanent settlement as the “successful” ending. The project is complete when students can make a defensible, revisable Council directive from multiple scientific constraints. Some teams may support long-term presence, some seasonal or research-only presence, some protection, and some delay for more evidence.</p>
      <blockquote>“Jabberwocky was never a puzzle with one correct answer. Science gave JCEC stronger evidence, clearer limits, better questions and reasons to protect systems that cannot simply be replaced.”</blockquote>
    </section>

    <section class="ready-audit">
      <p class="eyebrow">TEACHER LAUNCH-READINESS</p><h2>Final check</h2>
      <div class="check-grid">
        <span>✓ Do I know what to prepare tomorrow?</span>
        <span>✓ Do I know what students finish each class?</span>
        <span>✓ Can the Council run with no purchases?</span>
        <span>✓ Do all five science phases appear?</span>
        <span>✓ Is uncertainty allowed to change the decision?</span>
        <span>✓ Are safeguards part of the directive?</span>
        <span>✓ Is there only one final Team Record?</span>
        <span>✓ Is the individual reflection clear?</span>
        <span>✓ Can I switch to the two-class fallback?</span>
        <span>✓ Does Mission 2190 clearly end here?</span>
      </div>
      <a href={council}>Open the student Mission 2190 Council →</a>
    </section>
  </div>
</BaseLayout>

<style>
