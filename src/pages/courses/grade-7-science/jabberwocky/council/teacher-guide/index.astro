@media(max-width:800px){.teacher-hero,.quick-grid{grid-template-columns:1fr}.guard-grid,.materials-grid,.assessment-grid,.contingency-grid,.day-grid,.fallback-grid,.check-grid{grid-template-columns:1fr}.day-grid .wide{grid-column:auto}.lens-list article{grid-template-columns:30px 1fr}.lens-list span{grid-column:2}}
</style>
