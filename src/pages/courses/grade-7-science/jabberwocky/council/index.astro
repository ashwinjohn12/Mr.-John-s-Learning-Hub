---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import { councilContinents } from '../../../../../data/jabberwockyCouncil';

const base = import.meta.env.BASE_URL;
const outcomes = [
  { key:'long-term', icon:'🏠', title:'LONG-TERM PRESENCE WITH STRONG SAFEGUARDS', text:'A small permanent human presence may continue only under clearly stated ecological, resource, energy, structural and geological rules.' },
  { key:'seasonal', icon:'🗓️', title:'LIMITED / SEASONAL PRESENCE', text:'Human activity is limited by time, scale or footprint because year-round expansion would create unnecessary pressure.' },
  { key:'research', icon:'🔬', title:'RESEARCH-ONLY PRESENCE', text:'Controlled scientific work may continue, but the evidence does not justify long-term settlement at this time.' },
  { key:'protect', icon:'🛡️', title:'PROTECTED AREA / RESTRICTED HUMAN ACTIVITY', text:'Important ecosystems, sites or records require strong protection from major human disturbance. This may be combined with limited activity elsewhere if evidence supports it.' },
  { key:'delay', icon:'🔎', title:'DELAY LONG-TERM EXPANSION / COLLECT MORE EVIDENCE', text:'A critical uncertainty remains. JCEC should identify the missing evidence before making a larger or longer-term commitment.' }
];
const lenses = [
  { id:'ecosystem', icon:'🌿', title:'ECOSYSTEM', question:'Can human activity occur without unacceptable ecosystem damage?' },
  { id:'plant', icon:'🌱', title:'PLANT RESOURCES', question:'Can necessary living resources be used sustainably?' },
  { id:'thermal', icon:'🌡️', title:'THERMAL SURVIVAL', question:'Can people survive without unreasonable thermal or energy demands?' },
  { id:'structural', icon:'🏗️', title:'STRUCTURAL SAFETY', question:'Can the required structures function safely at the site?' },
  { id:'geology', icon:'🪨', title:'GEOLOGY', question:'Does the ground support the plan, and what remains uncertain or vulnerable?' }
];
---

<BaseLayout title="Mission 2190 Council | Jabberwocky" description="The final Grade 7 Science capstone for Jabberwocky: Mission 2190." themeColor="#08172b">
  <div class="council-shell" id="mission-2190-council">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Mission 2190 Council' }
    ]} />

    <header class="council-hero">
      <div>
        <p class="eyebrow">FINAL CAPSTONE // JCEC COUNCIL SESSION</p>
        <h1>MISSION 2190<br /><span>COUNCIL</span></h1>
        <p class="lead">Five scientific divisions have finished their investigations. Your team is no longer acting as one specialist group. You are now a <strong>JCEC Council Delegation</strong> responsible for using all five science lenses together.</p>
      </div>
      <aside>
        <span>FINAL YEAR-LONG QUESTION</span>
        <strong>How and where, if anywhere, should humans establish a long-term presence on Jabberwocky—and what must remain protected?</strong>
        <small>3 classes × 45 minutes</small>
      </aside>
    </header>

    <section class="at-a-glance">
      <article><small>YOUR TEAM</small><strong>Keep your Phase 5 team + continent</strong></article>
      <article><small>TEAM HAND-IN</small><strong>1 Mission 2190 Council Directive</strong></article>
      <article><small>INDIVIDUAL HAND-IN</small><strong>1 short reflection</strong></article>
    </section>

    <section class="story-panel">
      <p class="eyebrow">JCEC TRANSMISSION // FINAL SESSION</p>
      <h2>The specialist investigations are over.</h2>
      <p>Ecology told JCEC what living systems could be damaged. Plant science showed what living resources might support people and what sustainable use would require. Thermal science identified survival and energy demands. Structural science tested what safe construction would require. Geology revealed what the ground can—and cannot yet—tell us.</p>
      <blockquote>Now the Council must decide what level of human presence the evidence can actually support.</blockquote>
      <p class="boundary"><strong>No continent has a predetermined correct answer.</strong> Different delegations may reach different conclusions if they use the evidence carefully and make their safeguards explicit.</p>
    </section>

    <section class="class-path" aria-label="Council capstone pacing">
      <article class="current"><b>1</b><div><small>CLASS 1</small><strong>OPEN THE EVIDENCE VAULT</strong><span>Understand all five science lenses.</span></div></article>
      <article><b>2</b><div><small>CLASS 2</small><strong>THE COUNCIL DELIBERATES</strong><span>Compare at least two plausible outcomes.</span></div></article>
      <article><b>3</b><div><small>CLASS 3</small><strong>ISSUE THE DIRECTIVE</strong><span>One team decision + one reflection.</span></div></article>
    </section>

    <section class="delegation-panel" id="delegation-panel" hidden>
      <div><p class="eyebrow">YOUR JCEC COUNCIL DELEGATION</p><h2><span id="delegation-icon"></span> <span id="delegation-name"></span></h2><p id="delegation-subtitle"></p></div>
      <div class="carry-forward"><small>SAME TEAM · SAME CONTINENT</small><strong>No regrouping. No archive search.</strong><span>The five Evidence Vault cards below contain the concise year-long evidence your delegation needs.</span></div>
    </section>

    <section class="missing-posting" id="missing-posting" hidden>
      <strong>Your Phase 5 continent posting is not saved on this device.</strong>
      <p>The Council does not assign a new continent. Return to the Phase 5 hub and save only the continent your teacher assigned to your existing team.</p>
      <a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Return to Phase 5 Hub →</a>
    </section>

    <section class="vault" id="evidence-vault" hidden>
      <div class="section-heading"><div><p class="eyebrow">CLASS 1 · MISSION 2190 EVIDENCE VAULT</p><h2>Exactly five cards. One from each science phase.</h2></div><span>NO OLD TEAM RECORDS REQUIRED</span></div>
      <p class="section-lead">These cards are <strong>evidence summaries and constraints—not answer cards.</strong> They will not tell you which Council outcome to choose.</p>
      <div class="vault-grid" id="vault-grid"></div>
      <div class="vault-rule"><strong>Read every card.</strong><span>For each one, ask what it supports, what it limits, what it protects, and what is still uncertain.</span></div>
    </section>

    <section class="review-board" id="five-lens-review">
      <div class="section-heading"><div><p class="eyebrow">MAIN COUNCIL ACTIVITY</p><h2>Five-Lens Council Review</h2></div><span>SUPPORTS → LIMITS → PROTECTS → UNCERTAIN</span></div>
      <p class="section-lead">Do not decide first and search for evidence later. Work through all five lenses before your team chooses a directive.</p>
      <div class="lens-grid">
        {lenses.map((lens) => (
          <article class={`lens-card lens-${lens.id}`}>
            <header><span>{lens.icon}</span><div><small>{lens.title}</small><strong>{lens.question}</strong></div></header>
            <div class="lens-fields">
              <label><b>SUPPORTS</b><span>What makes some human presence possible?</span><i></i></label>
              <label><b>LIMITS</b><span>What makes human presence harder?</span><i></i></label>
              <label><b>PROTECTS</b><span>What must not be damaged?</span><i></i></label>
              <label><b>UNCERTAIN</b><span>What do we still not know?</span><i></i></label>
            </div>
          </article>
        ))}
      </div>
      <div class="reversibility"><strong>COUNCIL CHECK</strong><span>If new evidence appears later, could your plan be reduced, changed or stopped?</span></div>
    </section>

    <section class="outcomes" id="outcomes">
      <div class="section-heading"><div><p class="eyebrow">CLASS 2 · COMPARE BEFORE YOU CHOOSE</p><h2>Select at least two plausible Council outcomes.</h2></div><span id="candidate-count">0 CANDIDATES SELECTED</span></div>
      <p class="section-lead">Your team may combine a presence decision with a protection restriction when the evidence supports it. There is no automatic outcome for any continent.</p>
      <div class="outcome-grid">
        {outcomes.map((outcome) => (
          <button class="outcome-card" type="button" data-outcome={outcome.key} aria-pressed="false">
            <span>{outcome.icon}</span><div><strong>{outcome.title}</strong><p>{outcome.text}</p></div><b>Mark as candidate</b>
          </button>
        ))}
      </div>

      <div class="compare-board">
        <h3>COMPARE TWO PLAUSIBLE OPTIONS</h3>
        <div class="compare-grid">
          <article><small>OPTION A</small><strong>Outcome:</strong><span class="write-line"></span><strong>Best evidence supporting it:</strong><span class="write-line"></span><strong>Biggest limit:</strong><span class="write-line"></span><strong>Required safeguard:</strong><span class="write-line"></span><strong>Important uncertainty:</strong><span class="write-line"></span></article>
          <article><small>OPTION B</small><strong>Outcome:</strong><span class="write-line"></span><strong>Best evidence supporting it:</strong><span class="write-line"></span><strong>Biggest limit:</strong><span class="write-line"></span><strong>Required safeguard:</strong><span class="write-line"></span><strong>Important uncertainty:</strong><span class="write-line"></span></article>
        </div>
        <p><strong>Which option fits all five lenses better—and why?</strong> ____________________________________________________________</p>
      </div>
    </section>

    <section class="reasoning">
      <p class="eyebrow">COUNCIL REASONING</p>
      <div><span>EVIDENCE</span><b>→</b><span>IMPLICATION</span><b>→</b><span>SAFEGUARD</span><b>→</b><span>UNCERTAINTY</span><b>→</b><span>DIRECTIVE</span></div>
      <p><strong>Our evidence shows</strong> ______. <strong>That matters because</strong> ______. <strong>Therefore JCEC must</strong> ______. <strong>We are still uncertain about</strong> ______. <strong>Because of this, our Council recommends</strong> ______.</p>
    </section>

    <section class="decision-box">
      <p class="eyebrow">ONE MAIN TEAM DECISION</p>
      <h2>What human-presence directive best fits all five science lenses—and what must remain protected?</h2>
      <p>Your team must decide three connected things: <strong>level of human presence → where/at what scale → what remains protected.</strong></p>
    </section>

    <section class="record-section" id="record">
      <div class="section-heading"><div><p class="eyebrow">CLASS 3 · FINAL TEAM RECORD</p><h2>Mission 2190 Council Directive</h2></div><button type="button" id="print-directive">Print / Save Directive</button></div>
      <div class="directive-sheet" id="directive-sheet">
        <header><div><small>JABBERWOCKY COUNCIL FOR EXPLORATION AND COLONIZATION</small><h3>MISSION 2190 COUNCIL DIRECTIVE</h3></div><span>FINAL TEAM RECORD</span></header>
        <div class="sheet-row"><b>CONTINENT</b><span id="sheet-continent">________________________</span></div>
        <div class="sheet-row tall"><b>OUR HUMAN-PRESENCE DIRECTIVE</b><span>________________________________________________________________________________</span></div>
        <div class="sheet-row"><b>WHERE / SCALE</b><span>________________________________________________________________________________</span></div>
        <div class="five-evidence">
          <article><b>ECOSYSTEM EVIDENCE</b><span>____________________________________________________________</span></article>
          <article><b>PLANT RESOURCE EVIDENCE</b><span>____________________________________________________________</span></article>
          <article><b>THERMAL EVIDENCE</b><span>____________________________________________________________</span></article>
          <article><b>STRUCTURAL EVIDENCE</b><span>____________________________________________________________</span></article>
          <article><b>GEOLOGICAL EVIDENCE</b><span>____________________________________________________________</span></article>
        </div>
        <div class="sheet-block"><b>3 NON-NEGOTIABLE SAFEGUARDS</b><span>1. ______________________________________________________________________________</span><span>2. ______________________________________________________________________________</span><span>3. ______________________________________________________________________________</span></div>
        <div class="sheet-row tall"><b>WHAT MUST REMAIN PROTECTED?</b><span>________________________________________________________________________________</span></div>
        <div class="sheet-row tall"><b>ONE IMPORTANT UNCERTAINTY</b><span>________________________________________________________________________________</span></div>
        <div class="sheet-row tall"><b>WHAT SHOULD JCEC INVESTIGATE NEXT?</b><span>________________________________________________________________________________</span></div>
        <div class="sheet-block final-message"><b>FINAL COUNCIL MESSAGE · 4–6 SENTENCES</b><span>________________________________________________________________________________</span><span>________________________________________________________________________________</span><span>________________________________________________________________________________</span><span>________________________________________________________________________________</span></div>
      </div>

      <div class="collaboration-grid">
        <article><span>👥</span><div><small>TEAM WORK</small><strong>Review all five lenses. Compare at least two plausible outcomes. Agree on one evidence-supported directive.</strong></div></article>
        <article><span>📝</span><div><small>TEAM RECORD</small><strong>One Mission 2190 Council Directive per delegation.</strong></div></article>
        <article><span>💭</span><div><small>MY REFLECTION</small><strong>Everyone answers the reflection individually.</strong></div></article>
      </div>

      <div class="reflection-box">
        <small>MY REFLECTION</small>
        <h3>Which piece of evidence most changed your thinking about human presence on Jabberwocky, and what new evidence could make you change your decision again?</h3>
        <span></span><span></span><span></span>
      </div>

      <div class="finish-line"><strong>MISSION 2190 IS COMPLETE WHEN</strong><span>Your delegation has one <b>Mission 2190 Council Directive</b> and every student has completed the individual reflection.</span></div>
    </section>

    <section class="mission-complete">
      <p class="eyebrow">JCEC FINAL RECORD</p>
      <h2>MISSION 2190 — COUNCIL RECORD COMPLETE</h2>
      <p>Jabberwocky was never a puzzle with one correct answer. Science gave JCEC stronger evidence, clearer limits, better questions and reasons to protect systems that cannot simply be replaced.</p>
      <blockquote>Humanity's future on Jabberwocky will depend on evidence, restraint, continued investigation and the willingness to change plans when the planet tells us something new.</blockquote>
      <div><strong>Five science phases.</strong><strong>One evidence-based Council directive.</strong><strong>Mission complete.</strong></div>
    </section>

    <section class="teacher-link"><span>TEACHER</span><div><strong>Running the final Council?</strong><p>The matching three-class Teacher Council Guide includes pacing, assessment and the two-class compressed fallback.</p></div><a href={`${base}courses/grade-7-science/jabberwocky/council/teacher-guide/`}>Open Teacher Council Guide →</a></section>
  </div>

  <script is:inline define:vars={{ councilData: councilContinents }}>
    (() => {
      const KEY='jabberwocky-phase5-posting';
      const map=Object.fromEntries(councilData.map((item)=>[item.id,item]));
      const saved=localStorage.getItem(KEY);
      const delegation=document.getElementById('delegation-panel');
      const missing=document.getElementById('missing-posting');
      const vault=document.getElementById('evidence-vault');
      const grid=document.getElementById('vault-grid');
      if(saved && map[saved]){
        const continent=map[saved];
        delegation.hidden=false;vault.hidden=false;missing.hidden=true;
        document.getElementById('delegation-icon').textContent=continent.icon;
        document.getElementById('delegation-name').textContent=`${continent.name} Council Delegation`;
        document.getElementById('delegation-subtitle').textContent=continent.subtitle;
        document.getElementById('sheet-continent').textContent=`${continent.icon} ${continent.name} — ${continent.subtitle}`;
        grid.innerHTML=continent.cards.map((card)=>`<article class="vault-card card-${card.id}"><small>${card.phase}</small><h3>${card.title}</h3><p>${card.evidence}</p><div><b>${card.ruleLabel}</b><span>${card.rule}</span></div></article>`).join('');
      }else{
        delegation.hidden=true;vault.hidden=true;missing.hidden=false;
      }

      const buttons=[...document.querySelectorAll('[data-outcome]')];
      const count=document.getElementById('candidate-count');
      const updateCount=()=>{
        const n=buttons.filter((button)=>button.getAttribute('aria-pressed')==='true').length;
        count.textContent=`${n} CANDIDATE${n===1?'':'S'} SELECTED${n<2?' · CHOOSE AT LEAST 2':''}`;
      };
      buttons.forEach((button)=>button.addEventListener('click',()=>{
        const selected=button.getAttribute('aria-pressed')==='true';
        button.setAttribute('aria-pressed',selected?'false':'true');
        button.classList.toggle('selected',!selected);
        const label=button.querySelector('b');if(label)label.textContent=!selected?'Candidate selected':'Mark as candidate';
        updateCount();
      }));
      updateCount();

      const printButton=document.getElementById('print-directive');
      if(printButton)printButton.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
