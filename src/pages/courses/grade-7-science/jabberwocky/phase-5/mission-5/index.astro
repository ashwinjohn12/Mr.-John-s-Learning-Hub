---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase5Progress from '../../../../../../components/JcecPhase5Progress.astro';
import { phase5GeologicalSites } from '../../../../../../data/jabberwockyPhase5';

const base = import.meta.env.BASE_URL;

const handoffOptions = [
  { icon:'🟢', title:'CONTINUE GEOLOGICAL PLANNING', text:'Current geological evidence is adequate for the Council’s next stage, within the limits your team states.' },
  { icon:'🟡', title:'CONTINUE WITH GROUND-DISTURBANCE LIMITS', text:'Planning can continue, but excavation or other ground disturbance must follow clear restrictions.' },
  { icon:'🔵', title:'PROTECT A GEOLOGICAL FEATURE / RECORD', text:'Important physical, environmental or scientific evidence should remain undisturbed.' },
  { icon:'🔎', title:'COLLECT MORE GEOLOGICAL EVIDENCE', text:'A critical geological inference remains too uncertain for the Council to rely on yet.' }
];

const siteReviews = {
  gyre: {
    ground:'Layered exposed rock, angular fragments and thin/discontinuous surface sediment.',
    rock:'Layering is consistent with deposition, but JCEC has not confirmed one rock class or exact formation history for the whole site.',
    surface:'Loose material on steep/exposed ground can be redistributed; fragile alpine soils make even modest surface loss important.',
    deep:'An erosion surface cuts older layers and younger sediment rests above it. No confirmed fossil evidence, active fault or exact geological age is established.',
    concern:'Can JCEC keep future investigation or construction from disturbing the thin, erosion-prone alpine soils while still collecting the evidence it needs?',
    safeguard:'Keep disturbance small and avoid treating exposed layers or thin soil as disposable simply because bedrock is visible.'
  },
  brillig: {
    ground:'Strongly weathered surfaces, rounded stream sediment and fine deposits beside slower water.',
    rock:'Transport and deposition are well supported, but the rock class of buried or strongly weathered bedrock remains unresolved.',
    surface:'Weathering, stream transport and quiet-water deposition are all active parts of the surface record.',
    deep:'Shallow cores show alternating sediment layers and an older channel-shaped surface later filled by younger sediment. No confirmed fossil or crustal-deformation evidence is established.',
    concern:'Can JCEC learn enough about the buried ground without clearing rainforest or increasing erosion near waterways?',
    safeguard:'Protect forest cover and stream-edge ground while using the least disruptive survey method available.'
  },
  manxome: {
    ground:'Solid coastal exposures occur beside rounded pebbles and bands of loose sand/sediment.',
    rock:'Several stages of transport, deposition and exposed-rock history are plausible, but one island-wide rock class is not supported.',
    surface:'Shoreline material is both transported and deposited; the established storm season can change the amount of movement.',
    deep:'Several solid layers occur below younger shoreline sediment, with an irregular worn surface between them. No confirmed fossil evidence or crustal deformation is established.',
    concern:'Can JCEC protect coastal habitat and freshwater catchments while recognizing that shoreline material continues to move?',
    safeguard:'Avoid treating a changing shoreline as fixed ground and keep investigation away from sensitive catchment connections where possible.'
  },
  'slithy-toves': {
    ground:'Fractured exposed rock, nearby angular fragments and loose sediment sorted differently from place to place.',
    rock:'Some fragments may come from local exposed material, while other sediment has likely been moved; the three rock classes are not confirmed from current evidence.',
    surface:'Surface breakdown and redistribution of loose sediment are both supported, but one weathering mechanism is not proven.',
    deep:'A fracture crosses several exposed layers, but JCEC has not measured offset or movement. No confirmed fossil evidence is present, so the fracture is not confirmed as a fault.',
    concern:'Can JCEC avoid over-interpreting the fracture or using scarce water simply to make geological investigation easier?',
    safeguard:'Treat the fracture as an unresolved clue, conserve fresh water and limit disturbance near scarce water sources.'
  },
  wabe: {
    ground:'Fractured rock surfaces, angular debris and small seasonal meltwater sediment deposits.',
    rock:'Exposed grains are not detailed enough to confirm a rock class; later surface deposits should not be confused with the original rock’s formation.',
    surface:'Local breakdown, short-distance meltwater transport and deposition can all occur while the ecosystem recovers slowly.',
    deep:'Older material lies below an irregular surface and younger loose sediment lies above it. No confirmed fossil evidence, active fault or exact age is established.',
    concern:'Can JCEC monitor seasonal sediment movement without repeatedly disturbing a slow-recovering Arctic surface?',
    safeguard:'Use low-disturbance monitoring and avoid repeated excavation or trampling of slow-recovering ground.'
  },
  bandersnatch: {
    ground:'Productive soil covers layered sediment and gravel, while solid-rock exposures are limited.',
    rock:'Sediment transport and deposition can be described more confidently than the origin of the deeper bedrock.',
    surface:'Protecting productive prairie soil from loss or redistribution is a more immediate concern than claiming a deep rock history.',
    deep:'Shallow cores show several loose sediment layers, but the limited rock exposure does not support a complete deep sequence. No confirmed fossil or crustal-deformation evidence is established.',
    concern:'Does JCEC know enough about the deeper ground to justify disturbance, or would excavation mainly sacrifice productive soil while leaving the main bedrock question unresolved?',
    safeguard:'Protect productive prairie soil and use shallow/non-destructive evidence before deeper disturbance is considered.'
  },
  gimble: {
    ground:'A weathered outcrop lies beneath forest soil; nearby streams contain rounded sediment from transport.',
    rock:'The outcrop supports a cautious rock-history hypothesis, but weathering and transported stream material limit site-wide certainty.',
    surface:'Weathering and stream transport are evident, but the forest cover means the same surface-change rate should not be assumed everywhere.',
    deep:'Several layers lie beneath forest soil and an irregular surface separates older exposed material from younger soil/sediment. No confirmed fossil evidence or fault movement is established.',
    concern:'Can JCEC protect forest continuity while collecting enough evidence from a geological record that is only partly exposed?',
    safeguard:'Do not clear or fragment forest simply to expose more rock; prefer existing outcrops, stream evidence and small survey areas.'
  },
  mimsy: {
    ground:'Fine saturated sediment occurs in visible mineral-rich and organic-rich layers, with very little exposed solid rock.',
    rock:'Repeated deposition is strongly supported, but the current survey has too little bedrock evidence to confirm a rock class.',
    surface:'Fine sediment continues to settle in a low-energy wetland setting; the no-drainage rule limits how the site can be investigated.',
    deep:'Shallow cores preserve repeated sediment layers, but deeper bedrock and crustal history remain highly uncertain. No confirmed fossil evidence is established.',
    concern:'Can JCEC answer the remaining geological questions without draining, excavating or simplifying the wetland that preserves the sediment record?',
    safeguard:'Keep the wetland hydrology intact; uncertainty is preferable to damaging the site just to expose deeper material.'
  }
};
---

<BaseLayout title="Mission 5: Prepare the Final Evidence | The Deep Record" description="Phase 5 Mission 5: synthesize geological evidence into a careful handoff for the future Mission 2190 Council." themeColor="#111916">
  <div class="mission-shell" id="phase5-mission5">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:`${base}courses/grade-7-science/jabberwocky/phase-5/` },
      { label:'Mission 5' }
    ]} />

    <JcecPhase5Progress active={5} compact={true} />

    <header class="mission-hero">
      <div><p class="eyebrow">PHASE 5 // MISSION 5 OF 5</p><h1>PREPARE THE <span>FINAL EVIDENCE</span></h1><p class="question">What geological evidence must JCEC carry into the final Mission 2190 decision?</p></div>
      <aside><span>MAJOR PHASE 5 SYNTHESIS</span><strong>Geological understanding + evidence use + uncertainty + responsible handoff</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 5 of 5 · Geological Handoff</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 JCEC Geological Evidence Packet + 1 reflection</strong></div>
      <div><small>WHAT AM I DECIDING?</small><strong>What geological guidance the future JCEC Council must receive—not whether humans settle here.</strong></div>
    </section>

    <div class="not-final"><strong>THIS IS NOT THE FINAL HUMAN-SETTLEMENT DECISION.</strong><span>Your team is preparing the geological evidence, limits, protections and unanswered questions the final JCEC Council will need later.</span></div>

    <nav class="step-nav" aria-label="Mission 5 steps"><a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a></nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Your Geological Survey Division has reached the end of its investigation. JCEC already has evidence about the ground, a possible rock history, ongoing surface change and the deeper record. Your final job is <strong>not</strong> to decide whether humans should settle this continent. Choose the strongest geological evidence, separate what is known from what is inferred or uncertain, identify what should be protected or monitored, and prepare a clear handoff for the future Mission 2190 Council.</p></div>

      <div class="assignment-result" id="assignment-result" hidden><span id="assignment-icon"></span><div><small>YOUR PHASE 5 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>GROUND-DISTURBANCE LIMIT</small><b id="assignment-limit"></b></div></div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 5 posting is not saved on this device yet.</strong><p>Return to The Deep Record hub and confirm the continent your teacher assigned. Mission 5 does not create a new posting.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Get Phase 5 posting →</a></div>
      <div class="continuity-strip"><strong>MISSIONS 1–4 ARE ALREADY DONE</strong><span>Do not reopen four mission pages. The Geological Evidence Locker below gives you the compact reminders you need. If your real classroom evidence is stronger, use it instead.</span></div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="section-lead">Mission 5 adds almost no new geology. Your job is to sort the evidence carefully:</p>
      <div class="review-grid">
        <article><small>KNOW</small><strong>WHAT DO WE KNOW?</strong><p>Direct observations or measurements that the survey actually recorded.</p></article>
        <article><small>INFER</small><strong>WHAT HAVE WE INFERRED?</strong><p>An explanation supported by evidence, but not directly observed.</p></article>
        <article><small>UNCERTAIN</small><strong>WHAT REMAINS UNCERTAIN?</strong><p>A question the available evidence cannot yet answer confidently.</p></article>
        <article><small>RESPOND</small><strong>WHAT SHOULD BE PROTECTED OR MONITORED?</strong><p>A feature, process or evidence source JCEC should protect, limit disturbance around, or keep watching.</p></article>
      </div>
      <div class="reasoning-rule"><span>GEOLOGICAL CLAIM</span><b>→</b><span>EVIDENCE</span><b>→</b><span>CHANGE / SITE CONSEQUENCE</span><b>→</b><span>UNCERTAINTY</span><b>→</b><span>HANDOFF RULE</span></div>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–2</p><h2>Investigate</h2></div></div>

      <section class="locker" id="locker" hidden>
        <div class="block-title"><div><small>GEOLOGICAL EVIDENCE LOCKER</small><h3>Four reminders. Choose your strongest three.</h3></div><span>NO ARCHIVE REOPENING</span></div>
        <p class="locker-note">These are concise JCEC reminders—not replacements for your actual classroom work. If your team's real evidence is stronger or more precise, use that.</p>
        <div class="locker-grid">
          <article><small>M1 · GROUND</small><strong>Observable ground evidence</strong><p id="locker-ground"></p></article>
          <article><small>M2 · ROCK HISTORY</small><strong>Formation/process inference</strong><p id="locker-rock"></p></article>
          <article><small>M3 · SURFACE CHANGE</small><strong>Process/monitoring finding</strong><p id="locker-surface"></p></article>
          <article><small>M4 · DEEP PAST</small><strong>History/uncertainty finding</strong><p id="locker-deep"></p></article>
        </div>
        <div class="choose-three"><strong>CHOOSE THREE STRONGEST EVIDENCE ITEMS</strong><span>Try to use evidence from at least three different missions.</span></div>
      </section>

      <section class="site-review" id="site-review" hidden>
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>JCEC Geological Site Review</h3></div><span>KNOWN · INFERRED · UNCERTAIN · PROTECT/MONITOR</span></div>
        <div class="review-question-grid">
          <article><b>1</b><strong>WHAT DO WE KNOW?</strong><p>List direct observations/measurements that matter most.</p><span>____________________________________________</span></article>
          <article><b>2</b><strong>WHAT HAVE WE INFERRED?</strong><p>List one or two explanations supported by evidence.</p><span>____________________________________________</span></article>
          <article><b>3</b><strong>WHAT REMAINS UNCERTAIN?</strong><p>Name the most important question the current evidence cannot settle.</p><span>____________________________________________</span></article>
          <article><b>4</b><strong>WHAT SHOULD BE PROTECTED OR MONITORED?</strong><p>Name the feature/process and explain why it matters.</p><span>____________________________________________</span></article>
        </div>
        <div class="continent-concern"><small>FINAL GEOLOGICAL REVIEW CONCERN</small><h4 id="review-continent"></h4><p id="review-concern"></p><div><strong>ONE USEFUL IMPLICATION / SAFEGUARD</strong><span id="review-safeguard"></span></div></div>
      </section>

      <section class="sts-box">
        <small>MISSION 2190 APPLICATION · NOT A SEPARATE PLANET EARTH OUTCOME</small><h3>What if humans eventually want to disturb or use geological material?</h3>
        <p>Rock, sediment and other geological materials can become human resources—but this mission does <strong>not</strong> invent a mine or resource deposit and it is not an extraction/reclamation project.</p>
        <div><article><strong>BEFORE DISTURBANCE</strong><span>What evidence would JCEC need before disturbing geological material?</span></article><article><strong>AFTER ANY AUTHORIZED DISTURBANCE</strong><span>What would need to be protected, monitored or restored?</span></article></div>
      </section>

      <div class="materials-check"><strong>MATERIALS REALITY CHECK</strong><p>Preferred version: projected/printed Evidence Locker + Geological Site Review + Evidence Packet + pencils. <b>No geology purchase, specialty kit, physical final model or new field collection is required.</b> The projected version is also the complete no-purchase fallback.</p></div>
      <button type="button" class="small-button" id="print-phase5-mission5">Print Site Review + Evidence Packet</button>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <section class="decision-card">
        <small>ONE GEOLOGICAL HANDOFF DECISION</small><h3>What should JCEC do geologically before final settlement planning continues?</h3>
        <p class="decision-warning"><strong>This is NOT the final human-settlement decision.</strong> No continent has a predetermined status. Choose the option your evidence supports.</p>
        <div class="handoff-grid">{handoffOptions.map((option)=><article><span>{option.icon}</span><strong>{option.title}</strong><p>{option.text}</p></article>)}</div>
        <div class="sentence-stems"><p><b>Our geological claim is</b> ______________________________________________.</p><p><b>The strongest evidence is</b> ______________________________________________.</p><p><b>This matters for the site because</b> ________________________________________.</p><p><b>One important uncertainty is</b> ____________________________________________.</p><p><b>JCEC should therefore</b> _________________________________________________.</p></div>
      </section>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="collab-row"><article><b>TEAM WORK</b><span>Select evidence and agree on one geological handoff.</span></article><article><b>TEAM RECORD</b><span>One person records the JCEC Geological Evidence Packet.</span></article><article><b>MY REFLECTION</b><span>Everyone answers one short individual question.</span></article></div>

      <section class="team-record">
        <div class="record-heading"><div><small>MAJOR PHASE 5 SYNTHESIS</small><h3>JCEC GEOLOGICAL EVIDENCE PACKET</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span id="record-continent">____________________________</span></label>
          <label><strong>SURFACE / GROUND EVIDENCE</strong><span>____________________________________________</span></label>
          <label><strong>LIKELY ROCK HISTORY</strong><span>____________________________________________</span></label>
          <label><strong>ACTIVE SURFACE-CHANGE PROCESS</strong><span>____________________________________________</span></label>
          <label class="wide"><strong>DEEP-HISTORY EVIDENCE</strong><span>________________________________________________________________</span></label>
          <label class="wide"><strong>3 STRONGEST GEOLOGICAL EVIDENCE ITEMS</strong><span>1. __________________________  2. __________________________  3. __________________________</span></label>
          <label><strong>ONE IMPORTANT UNCERTAINTY</strong><span>____________________________________________</span></label>
          <label><strong>ONE FEATURE / PROCESS TO PROTECT OR MONITOR</strong><span>____________________________________________</span></label>
          <label class="wide"><strong>GROUND-DISTURBANCE RULE</strong><span>________________________________________________________________</span></label>
          <label class="wide"><strong>WHAT SHOULD JCEC INVESTIGATE NEXT?</strong><span>________________________________________________________________</span></label>
          <label class="wide"><strong>GEOLOGICAL HANDOFF STATUS</strong><span>🟢 / 🟡 / 🔵 / 🔎 ______________________________________________</span></label>
          <label class="wide council-message"><strong>MESSAGE TO THE FINAL JCEC COUNCIL · 3–5 SENTENCES</strong><span>________________________________________________________________<br/>________________________________________________________________<br/>________________________________________________________________<br/>________________________________________________________________</span></label>
        </div>
      </section>

      <section class="assessment-focus"><small>WHAT THIS SYNTHESIS ASSESSES</small><strong>geological understanding → evidence use → uncertainty → responsible handoff</strong><p>It does not assess artistic appearance, a physical model, or whether your team chose the same status as another group.</p></section>

      <section class="reflection-card"><small>MY REFLECTION</small><h3>What is one geological conclusion JCEC should not make yet because the evidence is still too limited?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>
      <div class="finished-box"><strong>Phase 5 is finished when:</strong><span>your team has one <b>JCEC Geological Evidence Packet</b> and you have completed <b>your reflection</b>.</span><em>STOP HERE. The final Mission 2190 Council decision has not yet begun.</em></div>
    </section>

    <section class="class-plan"><small>4 × 45-MINUTE CLASSES</small><div><article><b>CLASS 1</b><strong>Gather the Strongest Evidence</strong><p>Open the Geological Evidence Locker and choose useful M1–M4 evidence.</p></article><article><b>CLASS 2</b><strong>Review the Geological Site</strong><p>Sort known, inferred, uncertain and protect/monitor evidence; complete the Site Review.</p></article><article><b>CLASS 3</b><strong>Decide the Geological Handoff</strong><p>Respond to the continent concern, establish one safeguard and choose a tentative handoff status.</p></article><article><b>CLASS 4</b><strong>Prepare the Final Evidence</strong><p>Complete the Evidence Packet, 3–5 sentence Council message and reflection.</p></article></div></section>
  </div>

  <script is:inline define:vars={{ siteData: phase5GeologicalSites, reviewData: siteReviews }}>
    (()=>{
      const KEY='jabberwocky-phase5-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const locker=document.getElementById('locker');
      const review=document.getElementById('site-review');
      if(saved&&sites[saved]&&reviewData[saved]){
        const site=sites[saved], data=reviewData[saved];
        result.hidden=false;missing.hidden=true;locker.hidden=false;review.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-limit').textContent=site.previousTeamGeologicalBriefing.groundDisturbanceLimit;
        document.getElementById('locker-ground').textContent=data.ground;
        document.getElementById('locker-rock').textContent=data.rock;
        document.getElementById('locker-surface').textContent=data.surface;
        document.getElementById('locker-deep').textContent=data.deep;
        document.getElementById('review-continent').textContent=`${site.icon} ${site.name}`;
        document.getElementById('review-concern').textContent=data.concern;
        document.getElementById('review-safeguard').textContent=data.safeguard;
        document.getElementById('record-continent').textContent=site.name;
      }else{
        result.hidden=true;missing.hidden=false;locker.hidden=true;review.hidden=true;
      }
      document.getElementById('print-phase5-mission5')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
