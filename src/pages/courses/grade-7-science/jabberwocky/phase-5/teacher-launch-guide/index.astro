---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const phase5 = (part='') => `${base}courses/grade-7-science/jabberwocky/phase-5/${part}`;

const coreDays = [
  { day:1, mission:'Mission 1 — Read the Ground', title:'How Do Geologists Know?', route:'mission-1/', prep:'Open the Phase 5 Hub; assign/confirm the final Geological Survey continent; preload the Earth Reference Evidence strips; decide whether physical samples or evidence cards will be used on Day 2.', materials:'Devices/projector; Phase 5 posting; Previous Team Geological Briefing; Earth-interior/tool visuals.', student:'Phase launch → new posting → four-card Geological Briefing → Earth Reference vs Jabberwocky Survey Evidence → observation/property/rock/mineral/classification → layered Earth + evidence/tool preview → gradual/sudden-change preview.', science:'Geology begins with evidence. Scientists use direct and indirect observations to classify materials and build models of Earth.', emphasis:'Do not turn Day 1 into rock-name memorization. Keep Earth examples separate from Jabberwocky canon.', collect:'Quick observation-vs-inference check — formative.', cut:'Use one evidence-source example, one tool example and the broad crust/mantle/core model. Protect the evidence-source distinction.' },
  { day:2, mission:'Mission 1 — Read the Ground', title:'Read the Samples', route:'mission-1/#investigate', prep:'Set 4–6 safe sample stations if available OR print/project the built-in photo/property cards; prepare fingernail/copper/teacher-approved steel comparisons.', materials:'Existing school samples optional; trays; rulers; limited shared hand lenses; relative-hardness references; classification key; photo/property cards.', student:'Geologist’s Evidence Stations → observe → test → describe → classify → state uncertainty.', science:'Common terminology and repeatable property observations strengthen classification. Rock, possible mineral and uncertain are all legitimate outcomes.', emphasis:'No striking rocks, no loose glass plates, no forced sample name. “One clue” is not enough evidence.', collect:'Station evidence notes — formative.', cut:'Use three evidence cards instead of 4–6 physical stations; keep one relative-hardness comparison and the classification key.' },
  { day:3, mission:'Mission 1 — Read the Ground', title:'What Does Our Ground Evidence Tell Us?', route:'mission-1/#record', prep:'Confirm saved Phase 5 posting; open that continent’s Jabberwocky Survey Sample Packet; prepare Ground Evidence Card.', materials:'Device/projector; continent Survey Packet; Ground Evidence Card; pencils.', student:'Read three site observations → separate observation from interpretation → choose strongest evidence → one uncertainty → one useful Earth-study tool → reflection.', science:'Claims about a site should be proportional to the evidence collected.', emphasis:'Students are not identifying exact ages, faults, fossils, hazards or deposits.', collect:'Ground Evidence Card — formative.', cut:'Provide sentence stems; protect three useful properties/evidence items + uncertainty.' },

  { day:4, mission:'Mission 2 — Follow the Rock Story', title:'Three Ways Rocks Form', route:'mission-2/', prep:'Prepare the three formation-process cards and one-clue-does-not-prove-it examples.', materials:'Projected/printed igneous, sedimentary and metamorphic evidence cards; process cards; pencils.', student:'Rock vs mineral recap → igneous/sedimentary/metamorphic through formation process → evidence clues → process-network view of the rock cycle.', science:'Rock classes are best understood through formation processes. Earth materials can follow multiple rock-cycle pathways.', emphasis:'Process first, appearance second. Loose sediment is not automatically sedimentary rock.', collect:'Rock-class/process quick check — formative.', cut:'Teach one representative evidence clue per class plus the process-network idea.' },
  { day:5, mission:'Mission 2 — Follow the Rock Story', title:'Follow the Rock Story', route:'mission-2/#investigate', prep:'Set the Rock Cycle Evidence Lab with 4–5 evidence cases; cache the local Calgary-area AGS evidence card.', materials:'Existing samples optional; hand lenses optional; sample photographs; observation cards; rock-class cards; process cards; local Alberta evidence card.', student:'Rock Cycle Evidence Lab → evidence → possible process → consistent rock class → uncertainty; short LOCAL EARTH EVIDENCE comparison.', science:'Several observations can support a formation history, but uncertainty remains when evidence is incomplete.', emphasis:'Do not heat, melt, bake or chemically alter materials. The local example teaches Earth processes, not Jabberwocky history.', collect:'Evidence-case reasoning — formative.', cut:'Use three evidence cases plus the 5–10 minute local Alberta card.' },
  { day:6, mission:'Mission 2 — Follow the Rock Story', title:'What History Fits Our Evidence?', route:'mission-2/#record', prep:'Open the assigned continent’s Mission 2 rock-history clues; prepare Rock History Profile.', materials:'Device/projector; continent clues; Rock History Profile; pencils.', student:'Compare plausible histories → choose one formation pathway OR “not enough evidence yet” → identify two clues → one possible later rock-cycle change → reflection.', science:'A rock-history explanation is an inference supported by evidence, not a direct observation.', emphasis:'Uncertainty is scientifically legitimate; do not force a rock class for Mimsy/Bandersnatch/other incomplete cases.', collect:'Rock History Profile — formative.', cut:'Keep one formation process, two clues and one uncertainty.' },

  { day:8, mission:'Mission 3 — Track the Changing Surface', title:'Break, Move, Settle', route:'mission-3/', prep:'Prepare weathering evidence cards; choose the tray/sediment setup and one standard water amount for Day 9; display fair-test variable plan.', materials:'Weathering cards; tray setup preview; rulers; data sheet; towels.', student:'Weathering vs erosion vs deposition → gradual vs sudden change → fair-test question/prediction → identify change/measure/keep-similar variables.', science:'Weathering breaks material down; erosion moves it; deposition/sedimentation settles transported material.', emphasis:'Mission 3 models gradual surface change. Do not transfer Earth earthquake examples to Jabberwocky.', collect:'Prediction + fair-test plan — checkpoint evidence in progress.', cut:'Use BREAK → MOVE → SETTLE plus the variable table; postpone extra examples.' },
  { day:9, mission:'Mission 3 — Track the Changing Surface', title:'Surface Change Fair Test', route:'mission-3/#investigate', prep:'Set shallow trays; pre-measure small sediment amounts; mark one 50–100 mL water amount; place devices away from water; prepare fallback dataset.', materials:'Reusable trays; small sand/soil/gravel amount; marked cup/bottle; ruler; books/blocks; towels; data table; backup dataset.', student:'Run lower-slope vs higher-slope comparison → measure sediment transport distance → record deposition location + observation.', science:'A fair test changes one important variable while keeping other conditions reasonably similar; evidence can be quantitative and qualitative.', emphasis:'No erosion contest. One water manager per team. Stop and switch to data cards if setup becomes unsafe or inconsistent.', collect:'Surface Change data — checkpoint.', cut:'Run one team/class demonstration and give all groups the shared dataset.' },
  { day:10, mission:'Mission 3 — Track the Changing Surface', title:'What Does the Pattern Show?', route:'mission-3/#investigate', prep:'Pool selected class data; prepare the supplied anomaly case and the short interpolation/extrapolation training sequence.', materials:'Class/fallback dataset; table/graph template if used; anomaly prompt; model-data task; continent clues.', student:'Identify overall pattern → explain one discrepant/anomalous result → interpolate/extrapolate model data → discuss why real landscapes may not change at a constant rate → read continent clues.', science:'Patterns support cautious predictions; unusual data should be explained, not erased; extrapolation is conditional.', emphasis:'Do not convert classroom centimetres into exact long-term geological rates.', collect:'Pattern/anomaly/prediction reasoning — checkpoint.', cut:'Teacher supplies a prepared graph/table; students explain one pattern, one anomaly and one limitation.' },
  { day:11, mission:'Mission 3 — Track the Changing Surface', title:'What Should JCEC Monitor?', route:'mission-3/#record', prep:'Return/present usable evidence; prepare Surface Change Forecast and checkpoint scoring guide.', materials:'Investigation data; continent clues; Surface Change Forecast; pencils.', student:'Claim → data → process → long-term direction → limitation → monitoring recommendation → reflection.', science:'A monitoring recommendation should connect model evidence to site evidence while acknowledging model limits.', emphasis:'Assess fair testing, data, geological-process understanding and cautious prediction—not dramatic erosion.', collect:'Surface Change Forecast — stronger checkpoint.', cut:'Allow concise bullets and sentence stems; cut presentation/polish.' },

  { day:13, mission:'Mission 4 — Read the Deep Past', title:'When Earth’s Layers Bend and Break', route:'mission-4/', prep:'Cache Parks Canada Canadian Rockies/Cordillera evidence and USGS Dynamic Planet map; prepare simple strata/fold/fault visuals.', materials:'Projected Earth Reference files; simple layer/fold/fault diagrams; pencils.', student:'Strata → folding → faulting → mountain/crustal patterns → compare Rockies/Cordillera and global crustal-movement evidence.', science:'Patterns in layers, folds, faults, earthquakes and volcanoes provide evidence for crustal movement and plate tectonics.', emphasis:'Qualitative Grade 7 reasoning only. A fracture is not automatically a fault unless movement is supported.', collect:'Short pattern explanation — formative synthesis.', cut:'Use one Rockies image/card plus one global-pattern map; protect the pattern → explanation reasoning.' },
  { day:14, mission:'Mission 4 — Read the Deep Past', title:'Fossils and Geological Time', route:'mission-4/#learn', prep:'Cache Royal Tyrrell badlands and Found a Fossil? evidence cards; prepare simplified geological-time strip.', materials:'Fossil/context cards; Royal Tyrrell evidence; geological-time strip; projector/paper.', student:'Body/trace/mold-cast evidence → fossil formation/context → stewardship → geological time → one fossil vs accumulated evidence.', science:'Fossils and strata can reconstruct past life/environments, but the fossil record is incomplete and context matters.', emphasis:'No dinosaur-identification detour. No numerical era-boundary memorization or radiometric calculations.', collect:'Fossil-context/uncertainty response — formative synthesis.', cut:'Teach three fossil-evidence categories, context/stewardship and the broad time strip.' },
  { day:15, mission:'Mission 4 — Read the Deep Past', title:'Reconstruct the Deep Record', route:'mission-4/#investigate', prep:'Print/project the common Earth Training Cross-Section and event/evidence cards; prepare relative-sequence rules.', materials:'Cross-section; layer/event cards; fossil/evidence cards; pencils; optional scissors.', student:'Sequence FIRST → NEXT → LATER → MOST RECENT using 4 relative-history rules → combine several clues → explain ambiguous clue.', science:'Relative sequence uses relationships among layers, deformation and erosion; several agreeing clues strengthen explanations.', emphasis:'No absolute ages. Keep the puzzle small enough to reason with.', collect:'Earth Training Cross-Section sequence — formative synthesis.', cut:'Teacher preorders two obvious events; teams reason through the remaining sequence.' },
  { day:16, mission:'Mission 4 — Read the Deep Past', title:'What Happened at Our Site?', route:'mission-4/#record', prep:'Open the assigned continent’s Deep Record Survey File; prepare Deep Record Timeline.', materials:'Jabberwocky Deep Record Survey File; Deep Record Timeline; pencils/device.', student:'Interpret continent evidence → choose best-supported past change → cite two agreeing clues → state fossil/deformation evidence only if present → one uncertainty → reflection.', science:'Absence of fossil/fault evidence is a valid result. The strongest explanation fits several observations without exceeding the evidence.', emphasis:'Do not invent exact ages, active faults, fossil beds or catastrophes to complete the record.', collect:'Deep Record Timeline — formative synthesis.', cut:'Require relative sequence, two evidence items and one uncertainty; cut extra narrative.' },

  { day:18, mission:'Mission 5 — Prepare the Final Evidence', title:'Gather the Strongest Evidence', route:'mission-5/', prep:'Open/project the Geological Evidence Locker and Mission 5 known/inferred/uncertain/protect-monitor framework.', materials:'Evidence Locker; Site Review sheet; pencils/device.', student:'Review compact M1–M4 reminders → replace with stronger real classroom evidence where useful → choose three strongest evidence items from at least three missions.', science:'Synthesis depends on selecting relevant evidence, not copying every previous Team Record.', emphasis:'The Locker is a memory support, not an answer key.', collect:'Three evidence items + source mission labels — major synthesis in progress.', cut:'Teacher preselects four reminders; teams choose three and explain why each matters.' },
  { day:19, mission:'Mission 5 — Prepare the Final Evidence', title:'Review the Geological Site', route:'mission-5/#investigate', prep:'Open the continent Site Review concern; prepare KNOWN / INFERRED / UNCERTAIN / PROTECT-MONITOR matrix.', materials:'Geological Evidence Locker; Site Review; continent concern; pencils.', student:'Sort evidence into known/inferred/uncertain/protect-monitor → respond to final geological concern → identify one useful implication/safeguard.', science:'Evidence-based decisions distinguish direct evidence from interpretation and keep uncertainty visible.', emphasis:'Do not invent a mine, resource deposit, hazard probability, fault or fossil bed.', collect:'JCEC Geological Site Review — synthesis evidence.', cut:'Complete one strong entry in each quadrant plus the continent safeguard.' },
  { day:20, mission:'Mission 5 — Prepare the Final Evidence', title:'Decide the Geological Handoff', route:'mission-5/#decide', prep:'Prepare four handoff-status cards and the small Mission 2190 application box.', materials:'Site Review; handoff cards; STS application prompt; pencils.', student:'Use geological claim → evidence → site consequence → uncertainty → handoff rule → choose tentative status; brief resource/disturbance application.', science:'A geological handoff can allow planning, impose disturbance limits, protect a record, or request more evidence without deciding human settlement.', emphasis:'This is NOT the final human-settlement decision. Resource/reclamation is a bounded Mission 2190 application, not a separate Planet Earth outcome.', collect:'Tentative handoff status + safeguard — major synthesis.', cut:'Skip extended discussion of the STS application; protect evidence-based handoff choice.' },
  { day:21, mission:'Mission 5 — Prepare the Final Evidence', title:'Prepare the Final Evidence', route:'mission-5/#record', prep:'Prepare one-page JCEC Geological Evidence Packet and concise scoring guide.', materials:'Evidence Locker; Site Review; Evidence Packet; pencils/device.', student:'Complete Evidence Packet → Council message 3–5 sentences → individual reflection → stop before Council.', science:'A final scientific handoff communicates evidence, limits, uncertainty, stewardship and next questions clearly.', emphasis:'Major synthesis: geological understanding → evidence use → uncertainty → responsible handoff. Do not grade visual polish.', collect:'JCEC Geological Evidence Packet — major synthesis.', cut:'Use Flex Day 22 for essential completion. Cut gallery work before core reasoning.' }
];

const flexDays = [
  { day:7, title:'Sample/classification + absence recovery', use:'Finish Mission 1/2 sample reasoning, replace missed stations with photo/property cards, reteach rock vs mineral or formation-process distinctions.', priority:'Protect evidence-before-identification and uncertainty.' },
  { day:12, title:'Mission 3 checkpoint recovery', use:'Finish Surface Change data, troubleshoot fair-test inconsistencies, explain anomalous results, complete prediction/limitation and Surface Change Forecast.', priority:'Protect controlled variables, quantitative/qualitative evidence and cautious prediction.' },
  { day:17, title:'Planet Earth review / optional individual check', use:'Targeted review of rock cycle, surface processes, crustal patterns, fossils, geological time, uncertainty; optional short individual Planet Earth science check.', priority:'Clarify science before final synthesis; do not add new content.' },
  { day:22, title:'Geological Evidence Packet completion', use:'Finish Mission 5 synthesis, recover missing evidence, teacher conferences, complete Council message.', priority:'Essential synthesis before enrichment.' },
  { day:23, title:'Absence recovery / individual assessment', use:'Students recover missed reasoning from supplied/class evidence or complete the optional individual science check.', priority:'Individual science evidence, not Jabberwocky trivia.' },
  { day:24, title:'Optional Geological Evidence gallery/review', use:'Compare how different continents justify different handoff statuses; peer questions about evidence and uncertainty.', priority:'Optional—cut before core learning.' },
  { day:25, title:'Final buffer / feedback / transition', use:'Normal interruptions, final feedback, reteach, make-up, and transition planning for the future Mission 2190 Council.', priority:'Do not begin the final Council until it is separately approved.' }
];

const materials = [
  { mission:'Mission 1', title:"Geologist's Evidence Stations + real-sample option", preferred:'4–6 safe school rock/mineral samples if already owned; trays; rulers; a few shared hand lenses; fingernail/copper/teacher-approved steel relative-hardness references; classification key.', shared:'One small sample set can rotate among teams. 2–4 hand lenses total is workable; teams can share by station. No Mohs kit or one-lens-per-student assumption.', fallback:'Run the full investigation from the built-in high-quality photo/property cards + classification key. Physical samples are optional.', absence:'Give the same cards/data and require the same OBSERVE → TEST/DATA → DESCRIBE → CLASSIFY → UNCERTAINTY reasoning.', safety:'No striking/breaking samples; no loose glass scratch plates; use only blunt teacher-approved tools; wash hands after handling dusty samples.' },
  { mission:'Mission 2', title:'Rock Cycle Evidence Lab + rock/process/evidence cards', preferred:'Existing rock samples if useful; printed/projected sample photographs; rock-class cards; process cards; hand lenses optional; pencils.', shared:'One evidence-card set per 2–3 teams or projected whole-class cases. Samples can be demonstration-only.', fallback:'Projected/printed evidence cases supply all necessary observations, processes and uncertainty prompts. No physical rock collection required.', absence:'Use the same evidence cases plus the Rock History Profile scaffold.', safety:'No heating, melting, baking, acid testing or chemical alteration of samples.' },
  { mission:'Mission 2', title:'Local Alberta rock/sediment evidence', preferred:'Teacher-curated Calgary-area Alberta Geological Survey card using the existing AGS source; 5–10 minute discussion.', shared:'Project one card for the whole class; no student research devices required.', fallback:'Cache/print the short source excerpt/image in advance; if unavailable, use the teacher summary already embedded in Mission 2.', absence:'Include the same card with the missed-work packet.', safety:'No off-site collecting trip required.' },
  { mission:'Mission 3', title:'Weathering evidence cards', preferred:'Projected/printed cracked-rock, freeze–thaw, root-in-crack and chemical-surface examples.', shared:'Whole-class projection is enough.', fallback:'The cards themselves are the default no-purchase method.', absence:'Student reviews the cards and answers the same “breakdown before movement” question.', safety:'No need to crack rocks, freeze containers or run chemical reactions.' },
  { mission:'Mission 3', title:'Surface Change Fair Test + tray/sediment/water setup', preferred:'Shallow reused trays; small sand/soil/gravel amount; one marked 50–100 mL water amount per trial; books/blocks; rulers; towels; data table.', shared:'4–6 trays for a class can rotate; one or two class demonstration trays also work. Pre-measure sediment and water to reduce setup time.', fallback:'Use before/after tray photos + supplied quantitative dataset + deposition diagrams + anomaly evidence + interpolation/extrapolation task.', absence:'Use class or supplied data and complete the same pattern/anomaly/prediction reasoning.', safety:'Devices stay away from wet stations; one water manager per team; wipe spills immediately; desk-sized trays only; wash hands after sediment.' },
  { mission:'Mission 4', title:'Earth Reference Evidence files', preferred:'Cached/projected Canadian Rockies/Cordillera card (Parks Canada), global crustal-movement map (USGS), Alberta badlands/Royal Tyrrell card, fossil-context/stewardship card.', shared:'Project once for the class or print one set per table group.', fallback:'Teacher-curated cached screenshots/text summaries from the approved sources; no live browsing required.', absence:'Provide the same evidence cards with 1–2 guiding questions.', safety:'Keep Earth Reference Evidence visibly separate from Jabberwocky Survey Evidence to avoid false canon transfer.' },
  { mission:'Mission 4', title:'Deep Record Evidence Puzzle + Earth Training Cross-Section', preferred:'Paper/projected cross-section; layer/event cards; fossil/evidence cards; pencils; optional scissors.', shared:'One laminated class set per table or projected whole-class sequence.', fallback:'The printable/projected puzzle is already the no-purchase version; no real fossils or geology models are needed.', absence:'Use the same cross-section and relative-sequence rules independently or with a teacher key for checking.', safety:'No rock saws, real fossil handling or specialty equipment.' },
  { mission:'Mission 4', title:'Jabberwocky Deep Record Survey Files', preferred:'Project/print the continent-specific evidence file already embedded in Mission 4.', shared:'One device or printout per team is enough.', fallback:'Teacher reads the three observations aloud and students record them.', absence:'Use the same assigned-continent file; no archive reopening.', safety:'Do not invent unsupported faults, fossils, volcanoes, exact ages or hazards.' },
  { mission:'Mission 5', title:'Geological Evidence Locker + JCEC Geological Site Review + Evidence Packet', preferred:'Projected/printed Evidence Locker, four-question Site Review, continent concern, handoff-status cards, JCEC Geological Evidence Packet, pencils.', shared:'Project the Locker and status cards; one paper Site Review/Packet per team is enough.', fallback:'Students copy the four review headings and final packet fields onto notebook paper. No printer or device is required once evidence is displayed.', absence:'Use the same Locker reminders and complete the review/packet without reopening Missions 1–4.', safety:'No field collection or physical final model. Keep resource/reclamation as a small STS application only.' }
];

const contingencies = [
  ['No rock/mineral samples','Run Mission 1 and Mission 2 entirely from the built-in photo/property/evidence cards. The learning target is evidence reasoning, not owning a collection.'],
  ['Limited hand lenses','Rotate the few lenses at one station, use device zoom/projected close-ups, or omit lenses entirely when the property data card already provides the needed observation.'],
  ['Students over-identify samples from one clue','Return to ONE CLUE ≠ PROOF. Require at least two observations or allow ROCK / POSSIBLE MINERAL / UNCERTAIN / NOT ENOUGH EVIDENCE YET.'],
  ['Hardness testing becomes confusing','Stop sample testing and switch to teacher-provided relative-hardness results. Students interpret the evidence rather than troubleshoot tools.'],
  ['Mission 2 rock classifications are ambiguous','Treat ambiguity as expected. Use “consistent with” language and keep the uncertainty field; do not force a named rock or class.'],
  ['Local Alberta evidence unavailable','Use the cached teacher summary from the existing AGS source or postpone the 5–10 minute local card to a flex period. Do not replace it with invented Jabberwocky geology.'],
  ['Sediment/tray materials unavailable','Use the complete supplied Surface Change dataset, before/after diagrams and anomaly task.'],
  ['Surface Change Fair Test runs long','Run one trial per condition, pool class evidence, or finish physical testing and use the fallback dataset for analysis. Protect the reasoning rather than extra trials.'],
  ['Water spills/device concerns','Stop devices at wet stations; use printed data sheets; wipe spills immediately; switch remaining teams to the dataset if needed.'],
  ['Groups get contradictory erosion data','Keep contradictions visible. Compare pouring rate, starting sediment shape, side-flow and measurement differences; then use pooled/fallback data for the main pattern.'],
  ['Graph/data interpretation takes too long','Provide a teacher-prepared graph/table and assess pattern, anomaly, prediction and limitation instead of graph polish.'],
  ['Student absent during the fair test','Use class/supplied evidence and require the same CLAIM → DATA → PROCESS → PREDICTION → LIMITATION reasoning.'],
  ['Students erase anomalous results','Pause and model why anomalous data are scientifically useful. Require the odd result plus one plausible explanation.'],
  ['Students over-extrapolate model data','Attach the phrase “if model conditions stayed similar” to every prediction and ask what could change in a real landscape.'],
  ['Mission 4 vocabulary becomes overwhelming','Collapse the visible focus to layers → bend/break → fossils → time → uncertainty; keep advanced terms behind teacher explanation.'],
  ['Students confuse fracture with fault','Repeat: a fracture is a break; a fault requires evidence of movement. Use Slithy Toves as the explicit non-example.'],
  ['Students assume Earth-reference volcanoes/earthquakes exist on Jabberwocky','Point to the evidence-source labels. Earth Reference Evidence teaches meaning; Jabberwocky Survey Evidence establishes canon.'],
  ['Students treat fossils as dinosaur trivia','Ask “What can this evidence tell us about past life/environment, and what can it not tell us alone?” Require context/layer discussion.'],
  ['Students struggle with relative sequencing','Use the common Earth Training Cross-Section first; physically order event cards; keep only four rules and no absolute ages.'],
  ['Printing/projector failure','Read evidence cards aloud, draw the simplified cross-section/table on the board, and have teams use notebook paper for Team Records.'],
  ['Mission 5 Evidence Locker becomes an answer key','Call each item a reminder, not a final answer. Students must choose three, label which are observation vs inference, and may replace them with stronger actual classroom evidence.'],
  ['Students confuse the geological handoff with the final settlement decision','Display THIS IS NOT THE FINAL HUMAN-SETTLEMENT DECISION. Ask only what geological guidance the future Council needs.'],
  ['A class is lost','Cut extra examples, presentations and polish before cutting the investigation reasoning, Team Record or reflection. Use the nearest flex period.']
];

const assessment = [
  { mission:'Mission 1', role:'FORMATIVE', evidence:'Ground Evidence Card', note:'Feedback on observation/property evidence, classification caution and uncertainty. Do not heavily grade sample identification.' },
  { mission:'Mission 2', role:'FORMATIVE', evidence:'Rock History Profile', note:'Feedback on formation-process reasoning and evidence-supported uncertainty.' },
  { mission:'Mission 3', role:'STRONGER CHECKPOINT', evidence:'Surface Change Forecast', note:'Assess fair testing, controlled variables, quantitative + qualitative data, anomaly reasoning, process understanding and cautious prediction.' },
  { mission:'Mission 4', role:'FORMATIVE SYNTHESIS', evidence:'Deep Record Timeline', note:'Assess relative sequence, accumulated evidence, fossil/context reasoning and uncertainty without making this another major grade.' },
  { mission:'Mission 5', role:'MAJOR SYNTHESIS', evidence:'JCEC Geological Evidence Packet', note:'Assess geological understanding, evidence selection/use, known vs inferred vs uncertain, stewardship and responsible handoff.' }
];

const curriculum = [
  ['Gradual + sudden surface change','M1 preview; M3 gradual surface processes; M4 real-Earth sudden/crustal evidence','Students distinguish rates of change without inventing Jabberwocky disasters.'],
  ['Layered Earth model + supporting evidence','M1','Crust → mantle → core supported by samples/cores, seismic evidence, patterns and models.'],
  ['Earth-study tools / techniques','M1','Hand lens/sample tools, coring drill, seismograph, maps/models tied to the evidence they provide.'],
  ['Rock/mineral terminology + classification','M1','Colour, lustre, transparency, relative hardness, existing surfaces/grains/layers; classification key; uncertainty.'],
  ['Rocks vs minerals','M1 → M2','Observed/material distinctions are reinforced before rock-class work.'],
  ['Igneous / sedimentary / metamorphic + formation evidence','M2','EVIDENCE → PROCESS → ROCK CLASS.'],
  ['Rock cycle','M2','Process network: melting, cooling/solidifying, weathering, transport, deposition, compaction/cementation, heat/pressure.'],
  ['Local rocks / sediments','M2','Teacher-curated Calgary-area AGS sand/gravel evidence card or safe local evidence.'],
  ['Weathering / erosion / sedimentation-deposition','M3','BREAK → MOVE → SETTLE plus weathering cards and fair-test model.'],
  ['Long-term incremental change','M3','Students connect repeated small changes to landscape change over time.'],
  ['Controlled variables + predictions/hypotheses','M3','Slope is changed; tray/sediment/water/pour conditions are kept reasonably similar.'],
  ['Qualitative + quantitative data / measurement','M3','Transport distance in cm + deposition location + observations.'],
  ['Tables / appropriate displays / trends','M3','Small data table; optional teacher-prepared graph; pattern interpretation.'],
  ['Interpolation / extrapolation','M3','Short model-data task with explicit conditional-limit discussion.'],
  ['Discrepancies / anomalies','M3','Students keep and explain an unusual result instead of erasing it.'],
  ['Mountain formation patterns / fold mountains / fault mountains','M4','Canadian Rockies/Cordillera Earth Reference Evidence plus simple strata/fold/fault diagrams.'],
  ['Crustal movement / qualitative Grade 7 plate tectonics','M4','Global earthquake/volcano/plate-pattern evidence; no advanced vectors or detailed boundary taxonomy.'],
  ['Fossils + fossil formation / interpretation','M4','Body, trace and mold/cast-type evidence; context; incomplete record; past-life/environment inference.'],
  ['Geological time','M4','Broad geological-time strip and relative sequencing; no numerical age calculations.'],
  ['Uncertainty + accumulated evidence','M1–M5, strongest in M4/M5','Several agreeing clues strengthen explanations; missing evidence remains legitimate.'],
  ['New questions from evidence','M5','Evidence Packet includes WHAT SHOULD JCEC INVESTIGATE NEXT?'],
  ['Evidence-based explanations','All missions','Mission reasoning grows from observation to process, prediction, reconstruction and final handoff.'],
  ['Collaboration','All missions','TEAM WORK → TEAM RECORD → MY REFLECTION.'],
  ['Stewardship','M4/M5','Royal Tyrrell fossil-context safeguard; protect/monitor and ground-disturbance rules.'],
  ['Safety','M1/M3/M4 implementation','No destructive rock testing; controlled small water/sediment models; no specialty cutting tools or field excavation.']
];

const scopeGuard = [
  'radiometric-dating calculations',
  'advanced seismology',
  'detailed plate vectors',
  'advanced plate-boundary taxonomy',
  'crystallography',
  'mineral chemistry',
  'geological engineering calculations'
];

const sources = [
  ['Alberta Grade 7 Science Program of Studies','https://education.alberta.ca/media/159716/sci7to9.pdf','Use as the curriculum baseline for Planet Earth.'],
  ['Alberta Geological Survey — Calgary-area sand and gravel','https://ags.aer.ca/publications/all-publications/ofr-1981-08','Mission 2 local Earth evidence.'],
  ['Parks Canada — Canadian Rocky Mountain Parks','https://parks.canada.ca/culture/spm-whs/sites-canada/sec02h','Mission 4 folded/faulted/uplifted Cordillera evidence.'],
  ['USGS — Dynamic Planet','https://www.usgs.gov/maps/dynamic-planet-world-map-volcanoes-earthquakes-impact-craters-and-plate-tectonics','Mission 4 global crustal-movement pattern evidence.'],
  ['Royal Tyrrell Museum — Badlands, Goodlands','https://tyrrellmuseum.com/learn/Badlands_Goodlands','Mission 3–4 Alberta sedimentation/erosion/fossil evidence.'],
  ['Royal Tyrrell Museum — Found a Fossil?','https://www.tyrrellmuseum.com/research/found_a_fossil','Mission 4 fossil-context and stewardship safeguard.']
];

const readiness = [
  ['Do I know what to prepare tomorrow?','Yes — every core day has a BEFORE CLASS field and route.'],
  ['Do I know what students should finish each day?','Yes — each core day names the evidence/product to collect or protect.'],
  ['Can I run the unit with no geology purchases?','Yes — Missions 1–2 can be card/photo based; Mission 3 uses ordinary trays/sediment/water or supplied data; Missions 4–5 are paper/projector first.'],
  ['Do I know which activities actually need physical materials?','Yes — only the optional real-sample stations and Surface Change Fair Test benefit meaningfully from physical materials; both have complete evidence-card/data fallbacks.'],
  ['Do I know what is formative, checkpoint and major assessment?','Yes — M1/M2 formative, M3 checkpoint, M4 formative synthesis, M5 major synthesis.'],
  ['Can I recover if a lab, dataset, sample set or class goes wrong?','Yes — the contingency playbook and seven flex periods protect every core reasoning target.'],
  ['Do Missions 1–5 remain scientifically distinct?','Yes — observe/classify → formation history → ongoing surface change → reconstruct deep past → geological handoff.'],
  ['Does the teacher system preserve evidence-first geology?','Yes — sample naming is secondary to observations, processes, patterns, uncertainty and evidence-based explanations.'],
  ['Do Earth Reference Evidence and Jabberwocky Survey Evidence stay separate?','Yes — Earth examples teach what evidence can mean; only JCEC survey observations establish Jabberwocky claims.'],
  ['Does Mission 5 still stop before the final Mission 2190 Council decision?','Yes — the teacher guide repeatedly labels Mission 5 as a geological handoff only.'],
  ['Do teacher and student systems match?','Yes — mission titles, pacing, investigations, Team Records, assessment roles, evidence lockers and stop point are aligned.']
];
---

<BaseLayout title="Phase 5 Teacher Launch Guide | The Deep Record" description="Teacher-facing implementation system for Phase 5 — The Deep Record." themeColor="#111916">
  <main class="teacher-shell">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:phase5() },
      { label:'Teacher Launch Guide' }
    ]} />

    <header class="hero"><p class="eyebrow">TEACHER SYSTEM // PHASE 5</p><h1>THE DEEP RECORD</h1><p class="division">JCEC GEOLOGICAL SURVEY DIVISION · TEACHER LAUNCH GUIDE</p><p>Complete implementation system for the finished five-mission student experience. <strong>18 core classes + 7 purposeful flex periods = 25 classes.</strong></p><div class="links"><a href={phase5()}>Open student hub →</a><a href={phase5('mission-5/')}>Open final student mission →</a></div></header>

    <section class="rule"><strong>LOW-MATERIAL RULE</strong><span>ordinary classroom supplies → shared/reused equipment → printables/data fallbacks → specialty equipment only as optional enrichment</span></section>
    <section class="stop"><strong>BOUNDARY</strong><span>Phase 5 ends with a geological evidence handoff. <b>Do not begin the final Mission 2190 Council decision yet.</b></span></section>

    <section><h2>Five-mission pacing</h2><div class="mission-summary"><article><b>M1</b><strong>Read the Ground</strong><span>3 classes · formative</span></article><article><b>M2</b><strong>Follow the Rock Story</strong><span>3 classes · formative</span></article><article><b>M3</b><strong>Track the Changing Surface</strong><span>4 classes · stronger checkpoint</span></article><article><b>M4</b><strong>Read the Deep Past</strong><span>4 classes · formative synthesis</span></article><article><b>M5</b><strong>Prepare the Final Evidence</strong><span>4 classes · major synthesis</span></article></div></section>

    <section><h2>18 core classes</h2><p class="section-lead">Every core class uses the same planning fields: <b>BEFORE CLASS → MATERIALS → STUDENTS SEE / DO → KEY SCIENCE → TEACHER EMPHASIS → COLLECT / ASSESS → IF TIME RUNS OUT</b>.</p><div class="days">{coreDays.map((d)=><article class="day"><div class="day-head"><span>DAY {d.day}</span><div><small>{d.mission}</small><h3>{d.title}</h3></div><a href={phase5(d.route)}>Student route ↗</a></div><dl><dt>BEFORE CLASS</dt><dd>{d.prep}</dd><dt>MATERIALS</dt><dd>{d.materials}</dd><dt>STUDENTS SEE / DO</dt><dd>{d.student}</dd><dt>KEY SCIENCE</dt><dd>{d.science}</dd><dt>TEACHER EMPHASIS</dt><dd>{d.emphasis}</dd><dt>COLLECT / ASSESS</dt><dd>{d.collect}</dd><dt>IF TIME RUNS OUT</dt><dd>{d.cut}</dd></dl></article>)}</div></section>

    <section><h2>7 purposeful flex periods</h2><div class="flex-grid">{flexDays.map((d)=><article><span>DAY {d.day} · FLEX</span><h3>{d.title}</h3><p>{d.use}</p><strong>{d.priority}</strong></article>)}</div></section>

    <section><h2>Phase 5 Mission Materials Master List</h2><p class="section-lead">Every investigation has a preferred classroom version, shared-equipment plan, no-purchase fallback, absence fallback and cleanup/safety note.</p><div class="materials-grid">{materials.map((m)=><article><div><small>{m.mission}</small><h3>{m.title}</h3></div><dl><dt>PREFERRED CLASSROOM VERSION</dt><dd>{m.preferred}</dd><dt>SHARED-EQUIPMENT PLAN</dt><dd>{m.shared}</dd><dt>NO-PURCHASE FALLBACK</dt><dd>{m.fallback}</dd><dt>ABSENCE FALLBACK</dt><dd>{m.absence}</dd><dt>CLEANUP / SAFETY</dt><dd>{m.safety}</dd></dl></article>)}</div></section>

    <section><h2>Contingency playbook</h2><div class="contingencies">{contingencies.map(([problem,response])=><article><strong>{problem}</strong><p>{response}</p></article>)}</div></section>

    <section><h2>Assessment map</h2><div class="assessment-grid">{assessment.map((a)=><article><small>{a.role}</small><h3>{a.mission}</h3><strong>{a.evidence}</strong><p>{a.note}</p></article>)}</div><div class="grading"><strong>Recommended numerical balance if needed</strong><p><b>30% Mission 3 checkpoint + 55% Mission 5 synthesis + 15% optional individual Planet Earth science check.</b></p><p>Without the individual check: approximately <b>35% Mission 3 + 65% Mission 5</b>. Do not heavily grade all five Team Records.</p></div><div class="check"><strong>Optional individual Planet Earth science check</strong><span>Short individual check on rock/mineral evidence, three rock classes/processes, weathering–erosion–deposition, controlled variables/data, relative sequence, folds/faults/crustal movement, fossils/geological time, uncertainty and evidence-source separation.</span></div></section>

    <section><h2>Alberta Grade 7 Planet Earth alignment</h2><p class="section-lead">Curriculum baseline: the existing Alberta Grade 7 Science 7–9 Program of Studies already used in this project. The unit remains evidence/model focused rather than rock-name focused.</p><div class="curriculum-table"><table><thead><tr><th>Required learning / inquiry</th><th>Where it is taught</th><th>Teacher verification</th></tr></thead><tbody>{curriculum.map(([outcome,where,evidence])=><tr><td>{outcome}</td><td>{where}</td><td>{evidence}</td></tr>)}</tbody></table></div></section>

    <section><h2>Scope guard</h2><p>Keep these <strong>outside the required pathway</strong>:</p><div class="scope">{scopeGuard.map((item)=><span>{item}</span>)}</div></section>

    <section class="evidence-system"><h2>Evidence-source rule</h2><div class="evidence-grid"><article><small>EARTH REFERENCE EVIDENCE</small><strong>REAL EARTH · AUTHENTIC SOURCE</strong><p>Use Earth examples to teach what geological evidence can mean.</p></article><article><small>JABBERWOCKY SURVEY EVIDENCE</small><strong>MISSION 2190 SURVEY</strong><p>Use only JCEC observations to establish claims about the fictional continent.</p></article></div><p><b>Never transfer</b> an Earth earthquake, volcano, fault, fossil bed, exact age, resource deposit or hazard to Jabberwocky unless the JCEC Survey Evidence explicitly supports it.</p></section>

    <section><h2>Approved authoritative references</h2><div class="sources">{sources.map(([title,url,use])=><article><strong>{title}</strong><p>{use}</p><a href={url} target="_blank" rel="noreferrer">Open source ↗</a></article>)}</div><div class="source-guard"><strong>Royal Tyrrell safeguard</strong><span>Keep fossil context/location scientifically important; do not turn Mission 4 into fossil collecting. Preserve the approved “leave buried fossils in place and report them” guidance.</span></div></section>

    <section><h2>Teacher launch-readiness audit</h2><div class="readiness">{readiness.map(([q,a])=><article><strong>{q}</strong><span>{a}</span></article>)}</div></section>

    <footer class="final-stop"><strong>PHASE 5 TEACHER SYSTEM COMPLETE</strong><span>Student experience + teacher implementation now describe the same 18-core-class Planet Earth unit. <b>STOP before the final Mission 2190 Council decision.</b></span></footer>
  </main>
</BaseLayout>

