an{padding:.45rem .55rem;border-radius:8px;background:#2b3d34;color:#fff;font-weight:900}.day-head small{color:#e4b46e;font-weight:900}.day-head h3{margin:.12rem 0;color:#fff}.day-head a{color:#efc987;font-size:.78rem;font-weight:850}.day dl,.materials-grid dl{display:grid;grid-template-columns:190px 1fr;gap:.35rem .75rem;margin:0}.day dt,.materials-grid dt{color:#e4b46e;font-size:.67rem;font-weight:900}.day dd,.materials-grid dd{margin:0;color:#c5d0ca;line-height:1.45}.flex-grid,.assessment-grid,.sources,.readiness{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem}.flex-grid article,.assessment-grid article,.sources article,.readiness article{padding:.9rem;border:1px solid #435149;border-radius:11px;background:#09120e}.flex-grid span,.assessment-grid small{color:#e4b46e;font-size:.68rem;font-weight:900}.flex-grid h3,.assessment-grid h3{margin:.25rem 0;color:#fff}.flex-grid p,.assessment-grid p,.sources p{color:#a7b4ad}.flex-grid strong{color:#dce8e2;font-size:.82rem}.materials-grid{display:grid;gap:.7rem}.materials-grid article{padding:1rem;border:1px solid #45544d;border-radius:12px;background:#09120e}.materials-grid small{color:#e4b46e;font-weight:900}.materials-grid h3{margin:.2rem 0 .75rem;color:#fff}.contingencies{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem}.contingencies article{padding:.8rem;border-left:3px solid #e4b46e;background:#0a130f}.contingencies strong{color:#fff}.contingencies p{margin:.3rem 0 0;color:#aebbb4;font-size:.82rem;line-height:1.45}.grading,.check,.source-guard{margin-top:.8rem;padding:.9rem;border-radius:10px;background:#18261f}.grading strong,.check strong,.source-guard strong{display:block;color:#efc987}.grading p,.check span,.source-guard span{color:#c6d2cc}.curriculum-table{overflow-x:auto}.curriculum-table table{width:100%;border-collapse:collapse}.curriculum-table th,.curriculum-table td{padding:.65rem;border-bottom:1px solid #334039;text-align:left;vertical-align:top}.curriculum-table th{color:#efc987;font-size:.72rem}.curriculum-table td{color:#c3cec8;font-size:.82rem}.scope{display:flex;flex-wrap:wrap;gap:.45rem}.scope span{padding:.5rem .6rem;border:1px solid #5a4533;border-radius:999px;background:#211810;color:#efc9a0;font-size:.76rem}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.evidence-grid article{padding:1rem;border-radius:11px}.evidence-grid article:first-child{border:1px solid #4f7a91;background:#10222c}.evidence-grid article:last-child{border:1px solid #81643a;background:#281f12}.evidence-grid small{color:#9ed9f4;font-weight:900}.evidence-grid article:last-child small{color:#efc987}.evidence-grid strong{display:block;margin:.2rem 0;color:#fff}.evidence-grid p{color:#b8c7c0}.sources strong{color:#fff}.sources a{color:#efc987;font-size:.78rem;font-weight:850}.readiness article{display:grid;gap:.35rem}.readiness strong{color:#fff}.readiness span{color:#b9c6bf}.final-stop{display:grid;gap:.3rem;margin-top:1.4rem;padding:1.1rem;border:1px solid #8a6231;border-radius:14px;background:#261d11}.final-stop strong{color:#efc987}.final-stop span{color:#e5ddd1}
