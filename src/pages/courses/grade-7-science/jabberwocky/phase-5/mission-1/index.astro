---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase5Progress from '../../../../../../components/JcecPhase5Progress.astro';
import { phase5GeologicalSites } from '../../../../../../data/jabberwockyPhase5';

const base = import.meta.env.BASE_URL;

const scienceIdeas = [
  { icon:'👁️', title:'OBSERVATION', text:'What you directly notice or measure. Observations come before explanations.' },
  { icon:'📏', title:'PROPERTY', text:'A characteristic you can describe or test in a consistent way.' },
  { icon:'🪨', title:'ROCK', text:'Earth material made from one or more mineral or material components.' },
  { icon:'◇', title:'MINERAL', text:'A naturally occurring Earth material with characteristic properties.' },
  { icon:'🗂️', title:'CLASSIFICATION', text:'Organizing evidence using shared rules instead of guessing from appearance.' }
];

const stationCards = [
  { code:'A', title:'Uniform translucent sample', description:'Looks mostly uniform. Light passes through thin edges. Surface is glassy rather than dull.', hardness:'Fingernail: no visible scratch · copper reference: scratch uncertain · steel reference: visible scratch', structure:'No obvious separate grains are visible in the photograph/data card.', prompt:'Does the evidence justify ROCK, POSSIBLE MINERAL or UNCERTAIN?' },
  { code:'B', title:'Coarse speckled sample', description:'Several visibly different light and dark grains are locked together.', hardness:'Different grains respond differently; one single hardness description would hide useful evidence.', structure:'Clearly made of several visible components.', prompt:'Which observation is strongest for classifying this as a rock?' },
  { code:'C', title:'Fine layered sample', description:'Thin layers are visible. The sample is dull and breaks along some layer surfaces.', hardness:'Teacher data: copper reference scratches some surfaces; no exact mineral identity is supplied.', structure:'Layers contain many tiny grains; individual crystals are not obvious.', prompt:'What can you classify confidently, and what remains uncertain?' },
  { code:'D', title:'Dark fine-grained sample', description:'Mostly dark and fine grained. A few small holes are visible. Separate mineral grains are hard to see.', hardness:'Teacher data: steel reference makes a mark; fingernail does not.', structure:'Appears to contain material too fine to identify by eye.', prompt:'Why would naming this sample from colour alone be weak evidence?' },
  { code:'E', title:'Shiny platy flakes', description:'Thin shiny sheets reflect light strongly and separate along flat surfaces that already exist.', hardness:'Teacher data: fingernail can mark the surface.', structure:'The card shows one repeated-looking material rather than many obvious grains.', prompt:'What evidence supports “possible mineral,” and what would you still want to verify?' }
];

const tools = [
  { title:'HAND LENS + SAMPLE TOOLS', evidence:'Surface details, grains, layers and repeatable property observations.' },
  { title:'CORING DRILL', evidence:'A narrow sample from material hidden below the surface.' },
  { title:'SEISMOGRAPH', evidence:'Records ground motion; patterns in seismic waves provide indirect evidence about Earth’s interior.' },
  { title:'MAPS + MODELS', evidence:'Combine many observations so scientists can look for patterns and test explanations.' }
];

const usgsInterior='https://pubs.usgs.gov/gip/interior/';
const usgsEarthquakes='https://www.usgs.gov/programs/earthquake-hazards/science-earthquakes';
---

<BaseLayout title="Mission 1: Read the Ground | The Deep Record" description="Phase 5 Mission 1: gather geological evidence from rocks, minerals, surface observations and Earth-study tools." themeColor="#111916">
  <div class="mission-shell" id="phase5-mission1">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:`${base}courses/grade-7-science/jabberwocky/phase-5/` },
      { label:'Mission 1' }
    ]} />

    <JcecPhase5Progress active={1} compact={true} />

    <header class="mission-hero">
      <div><p class="eyebrow">PHASE 5 // MISSION 1 OF 5</p><h1>READ THE <span>GROUND</span></h1><p class="question">What can observations of rocks and minerals tell us about a site?</p></div>
      <aside><span>YOU ARE LEARNING</span><strong>How geologists gather, test and classify evidence before making claims about a site</strong><small>3 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 1 of 5 · Evidence</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Ground Evidence Card + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>The final JCEC Council needs geological evidence—not confident guesses about the ground.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 1 steps"><a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a></nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Project New Horizon proved that structural planning can move forward—but JCEC still knows surprisingly little about the ground beneath each site. Your Geological Survey team is <strong>not trying to name every rock</strong>. Your first job is to gather defensible evidence: observe samples and surface materials, test useful properties, separate observation from interpretation, and identify what JCEC still cannot claim yet.</p></div>

      <div class="assignment-result" id="assignment-result" hidden><span id="assignment-icon"></span><div><small>YOUR PHASE 5 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>OPEN GEOLOGICAL QUESTION</small><b id="assignment-question"></b></div></div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 5 posting is not saved on this device yet.</strong><p>Return to The Deep Record hub and choose only the Geological Survey continent your teacher assigned.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Get Phase 5 posting →</a></div>

      <section class="briefing-mini" id="geological-briefing" hidden>
        <div class="block-title"><div><small>PREVIOUS TEAM GEOLOGICAL BRIEFING</small><h3>Four inherited findings</h3></div><span>NO ARCHIVE SEARCH</span></div>
        <div class="briefing-grid"><article><small>SURFACE / ENVIRONMENT</small><p id="brief-surface"></p></article><article><small>STRUCTURAL SITE NEED</small><p id="brief-structure"></p></article><article><small>GROUND-DISTURBANCE LIMIT</small><p id="brief-ground"></p></article><article><small>OPEN GEOLOGICAL QUESTION</small><p id="brief-question"></p></article></div>
      </section>

      <section class="evidence-source-rule">
        <article class="earth"><small>EARTH REFERENCE EVIDENCE</small><strong>REAL EARTH · AUTHENTIC SOURCE</strong><p>Use real Earth science to learn what geological evidence can mean.</p></article>
        <article class="jabber"><small>JABBERWOCKY SURVEY EVIDENCE</small><strong>MISSION 2190 SURVEY</strong><p>Use only JCEC survey observations when making claims about your continent.</p></article>
        <div><b>Keep them separate:</b> Earth Reference Evidence teaches what evidence can mean. Jabberwocky Survey Evidence tells us what JCEC actually found. <strong>Do not assume an Earth process exists on Jabberwocky unless the survey evidence supports it.</strong></div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="section-lead">Geologists build explanations from observations that other people can check. The goal is not to sound certain—it is to show the evidence behind the claim.</p>
      <div class="science-grid five">{scienceIdeas.map((idea)=><article><span>{idea.icon}</span><strong>{idea.title}</strong><p>{idea.text}</p></article>)}</div>

      <section class="property-panel">
        <div class="block-title"><div><small>USE A SMALL SET OF SHARED TERMS</small><h3>Describe before you identify</h3></div><span>NO HUGE PROPERTY LIST</span></div>
        <div class="property-strip"><span><b>COLOUR</b> what colour(s) are visible?</span><span><b>LUSTRE</b> shiny/glassy or dull?</span><span><b>TRANSPARENCY</b> does light pass through?</span><span><b>RELATIVE HARDNESS</b> what scratches what?</span><span><b>EXISTING SURFACES</b> visible flat breaks, rough breaks, grains or layers?</span></div>
        <p class="safety-note"><strong>Safety:</strong> do not strike or deliberately break samples to create cleavage or fracture surfaces. Observe surfaces that already exist or use the evidence card.</p>
      </section>

      <section class="hardness-panel">
        <div><small>RELATIVE HARDNESS</small><h3>Compare. Do not memorize a scale.</h3><p>Use only teacher-approved comparison tools already available. A useful classroom order is <b>fingernail → copper reference if available → teacher-approved steel reference</b>. Record what happened instead of guessing a mineral name.</p></div>
        <blockquote>“The sample was scratched by the steel reference but not by the copper reference.”</blockquote>
        <p>That sentence is stronger evidence than “It looks hard.” A Mohs kit is optional enrichment, not required for this mission. No loose glass plates are needed.</p>
      </section>

      <section class="interior-panel">
        <div class="source-heading"><div><small>EARTH REFERENCE EVIDENCE</small><h3>How can geologists study what they cannot see?</h3></div><a href={usgsInterior} target="_blank" rel="noreferrer">U.S. Geological Survey source ↗</a></div>
        <div class="evidence-chain"><span>SURFACE OBSERVATIONS</span><b>→</b><span>SAMPLES / CORES</span><b>+</b><span>SEISMIC EVIDENCE</span><b>+</b><span>PATTERNS</span><b>→</b><span>MODELS</span></div>
        <p>Scientists cannot directly inspect most of Earth's interior. They combine surface rocks, samples, earthquake-wave records and other evidence to build and improve models.</p>
        <div class="earth-layers"><span><b>CRUST</b> thin outer rocky layer</span><i>→</i><span><b>MANTLE</b> much thicker layer below</span><i>→</i><span><b>CORE</b> central region</span></div>
        <p class="source-note">For this mission, you only need the broad <b>crust → mantle → core</b> model and the idea that indirect evidence supports it. Detailed seismic-wave mathematics belongs outside this Grade 7 pathway.</p>
      </section>

      <section class="tools-panel">
        <div class="block-title"><div><small>EARTH-STUDY TOOLS</small><h3>Ask what evidence the tool collects</h3></div><span>TOOL → EVIDENCE</span></div>
        <div class="tools-grid">{tools.map((tool)=><article><strong>{tool.title}</strong><p>{tool.evidence}</p></article>)}</div>
      </section>

      <section class="change-preview">
        <div class="source-heading"><div><small>EARTH REFERENCE EVIDENCE · PREVIEW ONLY</small><h3>Earth changes at different rates</h3></div><a href={usgsEarthquakes} target="_blank" rel="noreferrer">USGS earthquake science ↗</a></div>
        <div class="change-grid"><article><strong>GRADUAL / INCREMENTAL CHANGE</strong><p>Examples include weathering, erosion and sediment movement that can build up over long periods.</p></article><article><strong>SUDDEN CHANGE</strong><p>Earthquakes are one real-Earth example of change that can happen quickly.</p></article></div>
        <p>This is only a preview. Mission 3 and Mission 4 will investigate surface change and deeper Earth evidence. <b>Nothing here proves that your Jabberwocky continent has earthquakes or any other sudden geological hazard.</b></p>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASS 2</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Geologist's Evidence Stations</h3></div><span>4–6 SAMPLES OR CARDS</span></div>
        <p><strong>Question:</strong> What observations and property tests are strong enough to support a classification—and what remains uncertain?</p>
        <div class="repeat-question"><span>OBSERVE</span><b>→</b><span>TEST</span><b>→</b><span>DESCRIBE</span><b>→</b><span>CLASSIFY</span><b>→</b><span>STATE UNCERTAINTY</span></div>

        <div class="materials-check"><strong>MATERIALS REALITY CHECK</strong><p>Preferred: 4–6 safe school samples already owned, hand lenses if available, trays, rulers, fingernail, a teacher-provided copper reference if available, and a blunt/teacher-approved steel comparison tool. <b>No new mineral kit, glass plates or destructive rock breaking is required.</b></p></div>

        <div class="classification-key"><small>SMALL CLASSIFICATION KEY</small><h4>Do not force a name when the evidence is weak.</h4><ol><li>If several visibly different grains/components are clearly joined together → classify as <b>ROCK</b>.</li><li>If the sample appears mostly uniform and its repeated properties match one material → record <b>POSSIBLE MINERAL</b>, then verify with teacher/reference evidence.</li><li>If the evidence is incomplete or conflicting → record <b>UNCERTAIN</b>. Uncertainty is a valid scientific result.</li></ol></div>

        <div class="station-grid">{stationCards.map((card)=><article><div><span>{card.code}</span><small>PHOTO / DATA FALLBACK CARD</small></div><h4>{card.title}</h4><p>{card.description}</p><dl><dt>RELATIVE HARDNESS</dt><dd>{card.hardness}</dd><dt>STRUCTURE / GRAINS</dt><dd>{card.structure}</dd></dl><strong>{card.prompt}</strong></article>)}</div>

        <div class="fallback-note"><strong>NO-PURCHASE FALLBACK</strong><span>The entire investigation can run from teacher-approved sample photographs plus the property-data cards above. If a photo is unavailable, the data card still preserves the evidence/classification reasoning. Physical samples are helpful—not required.</span></div>
        <button type="button" class="small-button" id="print-phase5-mission1">Print Evidence Stations + Ground Evidence Card</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <section class="survey-panel" id="survey-panel" hidden>
        <div class="block-title"><div><small>JABBERWOCKY SURVEY EVIDENCE</small><h3>Your Survey Sample Packet</h3></div><span id="survey-continent">PHASE 5 POSTING</span></div>
        <p class="survey-warning">These are <strong>observations only</strong>. They do not prove an exact rock identity, geological age, fault, fossil bed, mineral deposit or hazard.</p>
        <div class="survey-grid" id="survey-observations"></div>
      </section>

      <section class="decision-card">
        <small>ONE TEAM QUESTION</small><h3>Which observations give JCEC the strongest evidence about our site's surface materials?</h3>
        <div class="reasoning-chain"><span>OBSERVATION</span><b>→</b><span>TEST</span><b>→</b><span>PROPERTY</span><b>→</b><span>INTERPRETATION</span></div>
        <div class="observed-vs-inferred"><article><strong>WHAT WE OBSERVED</strong><p>Write what was actually seen, measured or supplied in the survey.</p></article><article><strong>WHAT WE THINK IT MAY MEAN</strong><p>State the interpretation separately—and keep it as cautious as the evidence requires.</p></article></div>
      </section>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> decide</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one card</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>
      <section class="team-record">
        <div class="record-heading"><div><small>TEAM RECORD</small><h3>Ground Evidence Card</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span id="record-continent">____________________________</span></label>
          <label><strong>SAMPLE / MATERIAL OBSERVED</strong><span>____________________________</span></label>
          <label class="wide"><strong>3 USEFUL PROPERTIES</strong><span>1. ____________________  2. ____________________  3. ____________________</span></label>
          <label class="wide"><strong>TEST / OBSERVATION EVIDENCE</strong><span>______________________________________________</span></label>
          <label><strong>CLASSIFICATION</strong><span>□ ROCK  □ POSSIBLE MINERAL  □ UNCERTAIN</span></label>
          <label><strong>ONE UNCERTAINTY</strong><span>____________________________</span></label>
          <label class="wide"><strong>ONE EARTH-STUDY TOOL THAT COULD ADD EVIDENCE</strong><span>Tool: ____________________  Evidence it could collect: ______________________________</span></label>
        </div>
      </section>
      <section class="reflection-card"><small>MY REFLECTION</small><h3>Why is “I know what this rock is” weaker scientific evidence than explaining how you identified it?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>
      <div class="finished-box"><strong>Mission 1 is finished when:</strong><span>your team has one <b>Ground Evidence Card</b> and you have completed <b>your reflection</b>.</span><em>Mission 2 — Follow the Rock Story remains locked.</em></div>
    </section>

    <section class="class-plan"><small>3 × 45-MINUTE CLASSES</small><div><article><b>CLASS 1</b><strong>How Do Geologists Know?</strong><p>Phase launch, posting, evidence types, rock vs mineral, Earth-study tools, layered Earth model, gradual/sudden-change preview.</p></article><article><b>CLASS 2</b><strong>Read the Samples</strong><p>Evidence Stations, relative properties, classification key and evidence versus inference.</p></article><article><b>CLASS 3</b><strong>What Does Our Ground Evidence Tell Us?</strong><p>Jabberwocky Survey Packet, strongest observations, Ground Evidence Card and reflection.</p></article></div></section>
  </div>

  <script is:inline define:vars={{ siteData: phase5GeologicalSites }}>
    (() => {
      const KEY='jabberwocky-phase5-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const briefing=document.getElementById('geological-briefing');
      const survey=document.getElementById('survey-panel');
      if(saved&&sites[saved]){
        const site=sites[saved];result.hidden=false;missing.hidden=true;briefing.hidden=false;survey.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-question').textContent=site.geologicalQuestion;
        document.getElementById('brief-surface').textContent=site.previousTeamGeologicalBriefing.surfaceEnvironment;
        document.getElementById('brief-structure').textContent=site.previousTeamGeologicalBriefing.structuralSiteNeed;
        document.getElementById('brief-ground').textContent=site.previousTeamGeologicalBriefing.groundDisturbanceLimit;
        document.getElementById('brief-question').textContent=site.previousTeamGeologicalBriefing.openGeologicalQuestion;
        document.getElementById('survey-continent').textContent=`${site.icon} ${site.name}`;
        document.getElementById('record-continent').textContent=site.name;
        const grid=document.getElementById('survey-observations');grid.innerHTML='';
        site.mission1SurveyPacket.forEach((observation,index)=>{const card=document.createElement('article');card.innerHTML=`<small>OBSERVATION ${index+1}</small><p></p>`;card.querySelector('p').textContent=observation;grid.appendChild(card);});
      }else{result.hidden=true;missing.hidden=false;briefing.hidden=true;survey.hidden=true;}
      document.getElementById('print-phase5-mission1')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
