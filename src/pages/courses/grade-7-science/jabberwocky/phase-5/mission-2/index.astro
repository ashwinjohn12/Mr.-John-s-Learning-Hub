---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase5Progress from '../../../../../../components/JcecPhase5Progress.astro';
import { phase5GeologicalSites } from '../../../../../../data/jabberwockyPhase5';

const base = import.meta.env.BASE_URL;

const rockClasses = [
  { icon:'🔥', title:'IGNEOUS', process:'Molten material cools and solidifies.', evidence:'Possible clues: interlocking crystals, very fine texture, or holes from trapped gas. One clue alone is not proof.' },
  { icon:'🧱', title:'SEDIMENTARY', process:'Sediments are deposited, then compacted and cemented.', evidence:'Possible clues: layers, visible grains or fragments, rounded/cemented particles. Loose sediment is not yet sedimentary rock.' },
  { icon:'〰️', title:'METAMORPHIC', process:'Existing rock is changed by heat and pressure without completely melting.', evidence:'Possible clues: banding, aligned minerals, recrystallized texture or altered layers. Appearance alone may still be uncertain.' }
];

const processCards = [
  { title:'MELTING', text:'Solid rock becomes molten material.' },
  { title:'COOLING / SOLIDIFYING', text:'Molten material becomes igneous rock.' },
  { title:'WEATHERING / BREAKDOWN', text:'Rock is broken into smaller material at or near the surface.' },
  { title:'EROSION / TRANSPORT', text:'Loose material is moved.' },
  { title:'DEPOSITION', text:'Moved sediment settles.' },
  { title:'COMPACTION / CEMENTATION', text:'Sediment becomes sedimentary rock.' },
  { title:'HEAT / PRESSURE', text:'Existing rock changes without fully melting, producing metamorphic rock.' }
];

const evidenceCases = [
  { code:'A', title:'Coarse interlocking crystals', evidence:'Several visible crystals fit together tightly. No layering or rounded sediment grains are visible.', process:'Slow cooling and solidifying could allow larger crystals to form.', className:'IGNEOUS is consistent with the evidence.', uncertainty:'The card does not identify a named rock or prove where the molten material cooled.' },
  { code:'B', title:'Layered cemented grains', evidence:'Visible layers contain many sand-sized grains. Some grains are rounded and appear joined together.', process:'Deposition followed by compaction/cementation could explain the texture.', className:'SEDIMENTARY is consistent with the evidence.', uncertainty:'The card does not show how long deposition took or exactly where the sediment came from.' },
  { code:'C', title:'Banded altered texture', evidence:'Light and dark mineral-rich bands run through the sample. Grains appear stretched or aligned rather than loose.', process:'Heat and pressure could change an older rock and rearrange/recrystallize minerals.', className:'METAMORPHIC is consistent with the evidence.', uncertainty:'The original rock type is not supplied.' },
  { code:'D', title:'Dark fine texture with holes', evidence:'The sample is dark and very fine grained. Small rounded holes occur through part of the surface.', process:'Rapid cooling of molten material, with gas bubbles trapped as it solidified, could explain this evidence.', className:'IGNEOUS is consistent with the evidence.', uncertainty:'Colour alone is not useful enough to make the classification.' },
  { code:'E', title:'Fine dull sample with few clues', evidence:'The sample is fine grained and dull. No clear layers, bands, large crystals or cemented particles can be confirmed from the available view.', process:'More than one formation history could produce a fine texture.', className:'NOT ENOUGH EVIDENCE YET is the strongest conclusion.', uncertainty:'A closer view, additional property tests or a better sample could change the interpretation.' }
];

const calgarySource='https://ags.aer.ca/publications/all-publications/ofr-1981-08';
---

<BaseLayout title="Mission 2: Follow the Rock Story | The Deep Record" description="Phase 5 Mission 2: interpret rock-formation evidence and reconstruct plausible rock histories." themeColor="#111916">
  <div class="mission-shell" id="phase5-mission2">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:`${base}courses/grade-7-science/jabberwocky/phase-5/` },
      { label:'Mission 2' }
    ]} />

    <JcecPhase5Progress active={2} compact={true} />

    <header class="mission-hero">
      <div><p class="eyebrow">PHASE 5 // MISSION 2 OF 5</p><h1>FOLLOW THE <span>ROCK STORY</span></h1><p class="question">How can rocks record the processes that formed and changed them?</p></div>
      <aside><span>YOU ARE LEARNING</span><strong>How to use rock evidence and geological processes to build a cautious formation history</strong><small>3 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 2 of 5 · Rock History</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Rock History Profile + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>JCEC needs a formation story supported by evidence—not a rock name guessed from a picture.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 2 steps"><a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a></nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Mission 1 taught your Geological Survey team how to describe what JCEC actually observed. Now the Council wants the next layer of the story: <strong>what processes could explain those materials?</strong> Use formation evidence to compare possible rock histories, keep uncertainty visible, and avoid turning one clue into a confident conclusion. You are interpreting the evidence—not simply naming samples.</p></div>

      <div class="assignment-result" id="assignment-result" hidden><span id="assignment-icon"></span><div><small>YOUR PHASE 5 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>OPEN GEOLOGICAL QUESTION</small><b id="assignment-question"></b></div></div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 5 posting is not saved on this device yet.</strong><p>Return to The Deep Record hub and confirm the continent your teacher assigned. Mission 2 does not create a new posting.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Get Phase 5 posting →</a></div>

      <div class="continuity-strip"><strong>MISSION 1 ALREADY DID THE SAMPLE DESCRIPTION</strong><span>You do not need to reopen your Ground Evidence Card. Mission 2 gives you the rock-history clues needed for your continent.</span></div>

      <section class="evidence-source-rule">
        <article class="earth"><small>EARTH REFERENCE EVIDENCE</small><strong>REAL EARTH · AUTHENTIC SOURCE</strong><p>Use real Earth examples to learn what formation evidence and processes can mean.</p></article>
        <article class="jabber"><small>JABBERWOCKY SURVEY EVIDENCE</small><strong>MISSION 2190 SURVEY</strong><p>Use only JCEC observations when making claims about your continent.</p></article>
        <div><b>Keep them separate:</b> Earth examples can teach a process. They do <strong>not</strong> automatically establish that rock class or history on Jabberwocky.</div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <div class="recap-strip"><span><b>MINERAL</b> naturally occurring Earth material with characteristic properties</span><span><b>ROCK</b> material made from one or more mineral/material components</span></div>
      <p class="section-lead">Rock classes make the most sense when you begin with <strong>how the rock formed</strong>. The pattern for this mission is:</p>
      <div class="big-chain"><span>EVIDENCE</span><b>→</b><span>PROCESS</span><b>→</b><span>ROCK CLASS</span></div>
      <div class="science-grid">{rockClasses.map((rock)=><article><span>{rock.icon}</span><strong>{rock.title}</strong><p class="process">{rock.process}</p><p>{rock.evidence}</p></article>)}</div>
      <div class="misconception"><strong>ONE CLUE ≠ PROOF</strong><p>Layers, crystals, colour or holes can be useful evidence, but a single appearance clue may fit more than one history. Stronger explanations combine several observations and say what remains uncertain.</p></div>

      <section class="cycle-panel">
        <div class="block-title"><div><small>THE ROCK CYCLE IS A PROCESS NETWORK</small><h3>Earth materials can take more than one path.</h3></div><span>DO NOT MEMORIZE ONE CIRCLE</span></div>
        <div class="process-grid">{processCards.map((card)=><article><strong>{card.title}</strong><p>{card.text}</p></article>)}</div>
        <div class="cycle-rule"><b>Useful idea:</b> any exposed rock can break down; sediments can be moved and deposited; buried rock can be changed by heat/pressure; rock can melt and later cool again. <strong>There is no single route every rock must follow.</strong></div>
        <details><summary>Need Help? / Learn More</summary><p><b>Mission 3</b> will investigate weathering, erosion and deposition in much more detail. Here they only help you understand possible rock-cycle pathways.</p><p>Radiometric dating, crystallography, mineral chemistry and advanced plate-tectonic mathematics are outside this required Grade 7 pathway.</p></details>
      </section>

      <section class="local-evidence">
        <div class="source-heading"><div><small>LOCAL EARTH EVIDENCE · SOUTHERN ALBERTA</small><h3>Calgary-area sand and gravel</h3></div><a href={calgarySource} target="_blank" rel="noreferrer">Alberta Geological Survey source ↗</a></div>
        <p>The Alberta Geological Survey reports major Calgary-area sand and gravel deposits associated with river and glacial-water processes, including alluvial deposits connected to the Bow and Elbow rivers. This is <b>sediment evidence</b>: it shows that transport and deposition can build layers of loose Earth material.</p>
        <div class="local-question"><strong>What can we infer?</strong><span>Moving water can transport and deposit sediment.</span><strong>What can we NOT infer from this alone?</strong><span>That every local sediment layer is already sedimentary rock, or that a Jabberwocky site formed the same way.</span></div>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASS 2</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Rock Cycle Evidence Lab</h3></div><span>5 EVIDENCE CASES</span></div>
        <p><strong>Question:</strong> What formation process is consistent with the evidence, which rock class fits, and what remains uncertain?</p>
        <div class="repeat-question"><span>WHAT EVIDENCE?</span><b>→</b><span>WHICH PROCESS?</span><b>→</b><span>WHICH ROCK CLASS?</span><b>→</b><span>WHAT IS UNCERTAIN?</span></div>

        <div class="materials-check"><strong>MATERIALS REALITY CHECK</strong><p>Preferred: existing school rock samples if useful, hand lenses if already available, small sediment examples if already available, printed/projected evidence cards, process cards and pencils. <b>Do not buy a rock collection for this mission.</b></p></div>

        <div class="case-grid">{evidenceCases.map((card)=><article><div><span>{card.code}</span><small>PHOTO / OBSERVATION CARD</small></div><h4>{card.title}</h4><dl><dt>EVIDENCE</dt><dd>{card.evidence}</dd><dt>POSSIBLE PROCESS</dt><dd>{card.process}</dd><dt>CONSISTENT CLASS</dt><dd>{card.className}</dd><dt>UNCERTAINTY</dt><dd>{card.uncertainty}</dd></dl></article>)}</div>

        <div class="lab-task"><strong>TEAM TASK</strong><p>For each case, cover or ignore the suggested interpretation first. Use only the evidence to choose a process card and a rock-class card. Then compare your reasoning with the supplied interpretation and identify where uncertainty remains.</p></div>
        <div class="fallback-note"><strong>NO-PURCHASE FALLBACK</strong><span>The complete lab can run from the projected/printed cards above. Physical rock samples and hand lenses are optional supports, not requirements. No heating, melting, baking or chemical treatment is needed.</span></div>
        <button type="button" class="small-button" id="print-phase5-mission2">Print Evidence Lab + Rock History Profile</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <section class="survey-panel" id="survey-panel" hidden>
        <div class="block-title"><div><small>JABBERWOCKY SURVEY EVIDENCE</small><h3 id="survey-title">Rock-history clues</h3></div><span>MISSION 2190 SURVEY</span></div>
        <p class="survey-warning"><strong>Interpret cautiously.</strong> These clues are observations and bounded interpretations. They do not establish exact ages, mineral deposits, volcanoes, active faults, fossil beds or one predetermined rock type.</p>
        <div class="survey-grid"><article><small>CLUE 1</small><p id="clue-1"></p></article><article><small>CLUE 2</small><p id="clue-2"></p></article><article><small>CLUE 3</small><p id="clue-3"></p></article></div>
      </section>

      <section class="decision-card">
        <small>ONE TEAM DECISION</small><h3>What formation pathway best explains the geological material JCEC surveyed at our site?</h3>
        <div class="reasoning-chain"><span>EVIDENCE</span><b>→</b><span>ROCK CLASS</span><b>→</b><span>PROCESS</span><b>→</b><span>POSSIBLE HISTORY</span></div>
        <div class="sentence-stems"><p><b>Our strongest evidence is</b> __________________________________________.</p><p><b>This is consistent with</b> __________________ rock because ______________________________.</p><p><b>A likely formation process is</b> ______________________________________.</p><p><b>One part of the site's history we still cannot confirm is</b> ______________________________.</p></div>
        <p class="uncertainty-note">If the evidence is too limited, <strong>“not enough evidence yet”</strong> is a scientifically valid rock-class conclusion.</p>
      </section>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="collab-row"><article><b>TEAM WORK</b><span>Compare formation explanations and choose one cautious team interpretation.</span></article><article><b>TEAM RECORD</b><span>One person records the Rock History Profile.</span></article><article><b>MY REFLECTION</b><span>Everyone completes one short science reflection.</span></article></div>

      <section class="team-record">
        <div class="record-heading"><div><small>FORMATIVE TEAM RECORD</small><h3>ROCK HISTORY PROFILE</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span id="record-continent">____________________________</span></label>
          <label><strong>KEY GEOLOGICAL MATERIAL / SAMPLE</strong><span>________________________________________</span></label>
          <label class="wide"><strong>LIKELY ROCK CLASS</strong><span>□ IGNEOUS &nbsp; □ SEDIMENTARY &nbsp; □ METAMORPHIC &nbsp; □ NOT ENOUGH EVIDENCE YET</span></label>
          <label><strong>FORMATION EVIDENCE 1</strong><span>________________________________________</span></label>
          <label><strong>FORMATION EVIDENCE 2</strong><span>________________________________________</span></label>
          <label><strong>LIKELY FORMATION PROCESS</strong><span>________________________________________</span></label>
          <label><strong>ONE POSSIBLE LATER ROCK-CYCLE CHANGE</strong><span>________________________________________</span></label>
          <label class="wide"><strong>ONE UNCERTAINTY</strong><span>________________________________________________________________</span></label>
        </div>
      </section>
      <section class="reflection-card"><small>MY REFLECTION</small><h3>Why can the same rock material become a different kind of rock over a very long time?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>
      <div class="finished-box"><strong>Mission 2 is finished when:</strong><span>your team has one <b>Rock History Profile</b> and you have completed <b>your reflection</b>.</span><em>Mission 3 — Track the Changing Surface remains locked/upcoming.</em></div>
    </section>

    <section class="class-plan"><small>3 × 45-MINUTE CLASSES</small><div><article><b>CLASS 1</b><strong>Three Ways Rocks Form</strong><p>Rock vs mineral recap, igneous/sedimentary/metamorphic formation processes and evidence clues.</p></article><article><b>CLASS 2</b><strong>Follow the Rock Story</strong><p>Rock Cycle Evidence Lab, process network and Calgary-area Earth evidence.</p></article><article><b>CLASS 3</b><strong>What History Fits Our Evidence?</strong><p>Continent clues, one cautious formation pathway, Rock History Profile and reflection.</p></article></div></section>
  </div>

  <script is:inline define:vars={{ siteData: phase5GeologicalSites }}>
    (() => {
      const KEY='jabberwocky-phase5-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const survey=document.getElementById('survey-panel');
      if(saved&&sites[saved]){
        const site=sites[saved];
        result.hidden=false;missing.hidden=true;survey.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-question').textContent=site.previousTeamGeologicalBriefing.openGeologicalQuestion;
        document.getElementById('survey-title').textContent=`${site.icon} ${site.name} · Rock-history clues`;
        const clues=site.mission2RockHistoryClues||[];
        ['clue-1','clue-2','clue-3'].forEach((id,i)=>{document.getElementById(id).textContent=clues[i]||'No additional clue supplied.';});
        document.getElementById('record-continent').textContent=site.name;
      }else{result.hidden=true;missing.hidden=false;survey.hidden=true;}
      document.getElementById('print-phase5-mission2')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
