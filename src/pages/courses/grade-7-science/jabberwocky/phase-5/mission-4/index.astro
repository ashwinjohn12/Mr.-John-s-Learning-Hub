---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase5Progress from '../../../../../../components/JcecPhase5Progress.astro';
import { phase5GeologicalSites } from '../../../../../../data/jabberwockyPhase5';

const base = import.meta.env.BASE_URL;

const parksRockies='https://parks.canada.ca/culture/spm-whs/sites-canada/sec02h';
const usgsDynamic='https://www.usgs.gov/maps/dynamic-planet-world-map-volcanoes-earthquakes-impact-craters-and-plate-tectonics';
const tyrrellBadlands='https://tyrrellmuseum.com/learn/Badlands_Goodlands';
const tyrrellFossil='https://www.tyrrellmuseum.com/research/found_a_fossil';

const deepIdeas = [
  { title:'STRATA / LAYERS', text:'Sequences of deposited material can preserve evidence of earlier conditions.' },
  { title:'FOLDING', text:'Rock layers can bend. The pattern can provide evidence that layers were changed after they formed.' },
  { title:'FAULTING', text:'Rock can break and move along a fracture. A fracture is not automatically a fault unless movement is supported by evidence.' },
  { title:'CRUSTAL MOVEMENT', text:'Large-scale movement of Earth’s crust helps explain patterns in mountains, folds, faults, earthquakes and volcanoes.' },
  { title:'FOSSIL EVIDENCE', text:'Preserved remains, traces or impressions can provide evidence of past life and environments.' },
  { title:'GEOLOGICAL TIME', text:'Earth history is extremely long. Scientists organize that history into divisions using accumulated evidence.' },
  { title:'UNCERTAINTY', text:'One piece of evidence rarely tells the whole geological story. Several agreeing clues make an explanation stronger.' }
];

const fossilTypes = [
  { title:'BODY FOSSIL', text:'Preserved remains or parts of an organism.' },
  { title:'TRACE FOSSIL', text:'Evidence of activity such as a track, burrow or other trace.' },
  { title:'MOLD / CAST-TYPE EVIDENCE', text:'An impression left in material, or material that later fills that impression.' }
];

const timeStrip = [
  { title:'PRECAMBRIAN', text:'Very long early history of Earth.' },
  { title:'PALEOZOIC', text:'Major diversification of ancient life.' },
  { title:'MESOZOIC', text:'Includes the age of dinosaurs and many other organisms.' },
  { title:'CENOZOIC', text:'Most recent major division of geological time.' }
];

const trainingLayers = [
  { code:'A', title:'LOWEST LAYER', text:'A coarse sedimentary layer lies at the bottom of the training section.' },
  { code:'B', title:'SECOND LAYER', text:'A finer layer lies above A and contains a preserved body-fossil clue.' },
  { code:'C', title:'THIRD LAYER', text:'A layered deposit lies above B and contains a trace-fossil clue.' },
  { code:'F', title:'FAULT EVENT', text:'A fracture offsets Layers A–C. The break crosses all three older layers.' },
  { code:'E', title:'EROSION SURFACE', text:'An irregular surface cuts across the top of older material and truncates the fault.' },
  { code:'D', title:'YOUNGEST LAYER', text:'A later deposit lies across the erosion surface and is not offset by the fault.' }
];

const deepFiles = {
  gyre: [
    'A layered outcrop exposes several older layers below a younger patch of loose surface sediment.',
    'One irregular surface cuts across the upper part of two older layers before later sediment rests above it.',
    'No confirmed fossil evidence, active fault or exact geological age has been identified in the current survey.'
  ],
  brillig: [
    'A shallow core beneath the forest soil shows alternating finer and coarser sediment layers.',
    'One older layer is cut by a narrow channel-shaped surface that was later filled by younger sediment.',
    'No confirmed fossil evidence or crustal deformation has been identified in the current survey.'
  ],
  manxome: [
    'A coastal exposure shows several solid layers below a younger band of loose shoreline sediment.',
    'The top of one solid layer is irregular and worn before the younger sediment rests on it.',
    'No confirmed fossil evidence or crustal deformation has been identified in the current survey; the deeper coastal history remains uncertain.'
  ],
  'slithy-toves': [
    'Several exposed layers are crossed by a fracture, but JCEC has not measured any offset or movement along it.',
    'Loose angular fragments rest on an irregular surface above older exposed material.',
    'The survey contains no confirmed fossil evidence and does not establish that the fracture is a fault.'
  ],
  wabe: [
    'An exposed section shows older rock below a thin irregular surface and younger loose sediment above it.',
    'Seasonal surface deposits rest on top of older material and are not evidence of the original rock’s formation age.',
    'No confirmed fossil evidence, active fault or exact age has been identified in the current survey.'
  ],
  bandersnatch: [
    'A shallow core shows soil above several loose sediment layers, including a gravel-rich layer over finer sediment.',
    'The limited solid-rock exposures do not connect clearly enough to build a complete deep sequence across the site.',
    'No confirmed fossil evidence or crustal deformation is present in the current survey; the deeper bedrock history remains incomplete.'
  ],
  gimble: [
    'A small outcrop shows several layers beneath forest soil, but weathering has softened some contacts between them.',
    'An irregular surface separates older exposed material from younger soil and sediment above it.',
    'No confirmed fossil evidence or fault movement has been identified in the current survey.'
  ],
  mimsy: [
    'Shallow cores show repeated fine mineral-rich and organic-rich sediment layers below the wetland surface.',
    'The sequence records repeated deposition, but no solid bedrock is exposed deeply enough to identify crustal deformation.',
    'No confirmed fossil evidence is present in the current survey, and deeper geological history remains highly uncertain.'
  ]
};
---

<BaseLayout title="Mission 4: Read the Deep Past | The Deep Record" description="Phase 5 Mission 4: use strata, deformation, fossils, relative sequence and accumulated evidence to reconstruct the deep past." themeColor="#111916">
  <div class="mission-shell" id="phase5-mission4">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:`${base}courses/grade-7-science/jabberwocky/phase-5/` },
      { label:'Mission 4' }
    ]} />

    <JcecPhase5Progress active={4} compact={true} />

    <header class="mission-hero">
      <div><p class="eyebrow">PHASE 5 // MISSION 4 OF 5</p><h1>READ THE <span>DEEP PAST</span></h1><p class="question">How can layers, landforms and fossils reveal events we never observed?</p></div>
      <aside><span>FORMATIVE SYNTHESIS</span><strong>Observation + relative sequence + accumulated evidence + uncertainty</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 4 of 5 · Deep Past</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Deep Record Timeline + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>JCEC needs to know what the geological record can—and cannot—tell us about events before anyone observed them.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 4 steps"><a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a></nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Mission 3 tracked processes changing the surface <strong>now</strong>. But JCEC still needs the older story. Your Geological Survey team will learn how layers, folds, faults and fossils can preserve evidence of events nobody witnessed. First, practise on real-Earth evidence. Then reconstruct the most defensible relative history for your Jabberwocky site—using several clues together and keeping uncertainty visible.</p></div>

      <div class="assignment-result" id="assignment-result" hidden><span id="assignment-icon"></span><div><small>YOUR PHASE 5 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>OPEN GEOLOGICAL QUESTION</small><b id="assignment-question"></b></div></div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 5 posting is not saved on this device yet.</strong><p>Return to The Deep Record hub and confirm the continent your teacher assigned. Mission 4 does not create a new posting.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Get Phase 5 posting →</a></div>
      <div class="continuity-strip"><strong>MISSIONS 1–3 ARE ALREADY DONE</strong><span>You do not need to reopen earlier Team Records. Mission 4 gives you the deep-history evidence you need.</span></div>

      <section class="evidence-source-rule">
        <article class="earth"><small>EARTH REFERENCE EVIDENCE</small><strong>REAL EARTH · AUTHENTIC SOURCE</strong><p>Use real Earth patterns to learn what layers, folds, faults, fossils and plate/crustal movement can mean.</p></article>
        <article class="jabber"><small>JABBERWOCKY SURVEY EVIDENCE</small><strong>MISSION 2190 SURVEY</strong><p>Use only JCEC observations when reconstructing your assigned continent’s history.</p></article>
        <div><b>Keep them separate:</b> learning about a real Earth fault, earthquake, volcano or fossil bed does <strong>not</strong> mean that feature exists on Jabberwocky.</div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASSES 1–2</p><h2>Learn the Science</h2></div></div>
      <p class="section-lead">The goal is not to memorize a wall of geology words. Use each idea as a clue in one reasoning pattern:</p>
      <div class="big-chain"><span>OBSERVATION</span><b>→</b><span>PATTERN</span><b>→</b><span>SCIENTIFIC EXPLANATION</span></div>
      <div class="idea-grid">{deepIdeas.map((idea)=><article><strong>{idea.title}</strong><p>{idea.text}</p></article>)}</div>

      <details class="scope-guard"><summary>Need Help? / Grade 7 Scope</summary><p>This mission stays qualitative. <b>Radiometric-dating calculations</b>, <b>seismic-wave mathematics</b>, <b>detailed plate vectors</b> and <b>advanced tectonic terminology</b> are outside the required pathway. You are using visible patterns and relative sequence to build an evidence-based explanation.</p></details>

      <section class="earth-files">
        <div class="block-title"><div><small>EARTH REFERENCE EVIDENCE</small><h3>Three short files. Three ways evidence builds an explanation.</h3></div><span>REAL EARTH</span></div>
        <div class="reference-grid">
          <article><small>FILE A · CANADIAN ROCKIES / CORDILLERA</small><h4>Folded + faulted rock can record crustal change.</h4><p>Parks Canada describes the Canadian Rocky Mountain Parks as highly <b>faulted, folded and uplifted sedimentary rocks</b>. The important Grade 7 idea is the pattern: layers formed first, then later crustal forces changed their position and shape.</p><a href={parksRockies} target="_blank" rel="noreferrer">Parks Canada source ↗</a></article>
          <article><small>FILE B · GLOBAL CRUSTAL-MOVEMENT PATTERNS</small><h4>Patterns of earthquakes and volcanoes help reveal moving plates.</h4><p>The USGS world map places plate boundaries, earthquakes and volcanoes together. Students use the spatial pattern as evidence that Earth’s crust is divided into moving plates—without memorizing detailed boundary categories.</p><a href={usgsDynamic} target="_blank" rel="noreferrer">USGS map/source ↗</a></article>
          <article><small>FILE C · ALBERTA BADLANDS / ROYAL TYRRELL</small><h4>Layers + erosion + fossils preserve a record of changing environments.</h4><p>The Royal Tyrrell’s Grade 7-connected badlands material links sedimentation, erosion and fossilization to interpreting Alberta’s past. Fossils make the most scientific sense when their geological context is preserved.</p><div class="source-links"><a href={tyrrellBadlands} target="_blank" rel="noreferrer">Badlands, Goodlands ↗</a><a href={tyrrellFossil} target="_blank" rel="noreferrer">Found a Fossil? ↗</a></div></article>
        </div>
        <div class="source-rule"><strong>Pattern, not transfer.</strong><span>These Earth files teach what evidence can mean. They do not create folds, faults, earthquakes, volcanoes or fossil beds on your Jabberwocky continent.</span></div>
      </section>

      <section class="fossil-panel">
        <div class="block-title"><div><small>FOSSIL EVIDENCE</small><h3>What can a fossil tell us—and what can it NOT tell us by itself?</h3></div><span>CONTEXT MATTERS</span></div>
        <div class="fossil-grid">{fossilTypes.map((fossil)=><article><strong>{fossil.title}</strong><p>{fossil.text}</p></article>)}</div>
        <div class="fossil-rule"><p>Fossilization requires particular conditions, so the fossil record is incomplete. One fossil can be useful evidence, but its <b>layer, location and surrounding evidence</b> matter.</p><p><strong>Alberta stewardship:</strong> the Royal Tyrrell Museum explains that location is scientifically important; buried fossils should be left in place and reported rather than excavated by the public. Follow the Museum/provincial guidance for Alberta finds.</p></div>
      </section>

      <section class="time-panel">
        <div class="block-title"><div><small>GEOLOGICAL TIME</small><h3>Organize a very long history without a giant-number test.</h3></div><span>NO AGE CALCULATIONS</span></div>
        <div class="time-strip">{timeStrip.map((item)=><article><strong>{item.title}</strong><p>{item.text}</p></article>)}</div>
        <p>Scientists organize Earth history into broad divisions using accumulated rock and fossil evidence. <b>You do not need to memorize numerical boundaries or calculate ages in millions/billions of years.</b></p>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASS 3</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Deep Record Evidence Puzzle</h3></div><span>RELATIVE SEQUENCE · NO ABSOLUTE AGES</span></div>
        <p><strong>Question:</strong> What happened first, next, later and most recently—and which parts of the history remain uncertain?</p>

        <div class="relative-rules"><article><b>RULE 1</b><span>In an undisturbed sequence, lower deposited layers are generally older than layers above them.</span></article><article><b>RULE 2</b><span>A fold or fault happened after the layers it affected already existed.</span></article><article><b>RULE 3</b><span>An erosion surface formed after the material it cuts or removes.</span></article><article><b>RULE 4</b><span>A later layer/deposit formed after the surface below it.</span></article></div>

        <div class="training-section">
          <div class="block-title"><div><small>EARTH TRAINING CROSS-SECTION</small><h4>Use the cards to build the most defensible relative sequence.</h4></div><span>FIRST → NEXT → LATER → MOST RECENT</span></div>
          <div class="cross-section" aria-label="Simplified training cross-section">
            <div class="layer d"><span>D</span><b>youngest deposit</b></div>
            <div class="erosion">EROSION SURFACE</div>
            <div class="layer c"><span>C</span><b>trace-fossil clue</b></div>
            <div class="layer b"><span>B</span><b>body-fossil clue</b></div>
            <div class="layer a"><span>A</span><b>lowest layer</b></div>
            <div class="fault-line"><span>FAULT offsets A–C</span></div>
          </div>
          <div class="training-grid">{trainingLayers.map((item)=><article><span>{item.code}</span><div><strong>{item.title}</strong><p>{item.text}</p></div></article>)}</div>
          <div class="sequence-task"><strong>TEAM SEQUENCE</strong><span>Arrange the events. Then explain how you know the fault is younger than A–C but older than D.</span></div>
        </div>

        <div class="accumulated-evidence"><article><strong>ONE CLUE</strong><span>→ possible idea</span></article><article><strong>SEVERAL CLUES THAT AGREE</strong><span>→ stronger explanation</span></article></div>
        <div class="ambiguity-note"><strong>AMBIGUOUS CLUE</strong><span>A loose fossil fragment found on an erosion surface may have been moved from an older layer. It is useful evidence, but it cannot by itself date the surface where it was found.</span></div>

        <div class="materials-check"><strong>MATERIALS REALITY CHECK / NO-PURCHASE FALLBACK</strong><p>This mission is designed to run from paper or a projector: cross-section, layer/event cards, fossil/evidence cards and pencils. Optional scissors are fine. <b>No real fossils, rock saws, specialty geology kits or purchases are required.</b></p></div>
        <button type="button" class="small-button" id="print-phase5-mission4">Print Deep Record Puzzle + Timeline</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 4</p><h2>Make a Decision</h2></div></div>
      <section class="survey-panel" id="survey-panel" hidden>
        <div class="block-title"><div><small>JABBERWOCKY SURVEY EVIDENCE</small><h3 id="survey-title">Deep Record Survey File</h3></div><span>MISSION 2190 SURVEY</span></div>
        <p class="survey-warning"><strong>Do not import the Earth training case.</strong> Your continent gets only the evidence JCEC actually surveyed. A missing fossil, fold or fault is a valid result.</p>
        <div class="survey-grid"><article><small>EVIDENCE 1</small><p id="deep-1"></p></article><article><small>EVIDENCE 2</small><p id="deep-2"></p></article><article><small>EVIDENCE 3</small><p id="deep-3"></p></article></div>
      </section>

      <section class="decision-card">
        <small>ONE TEAM INTERPRETATION</small><h3>What past geological change best explains the evidence at our site, and what remains uncertain?</h3>
        <div class="reasoning-chain"><span>OBSERVATION</span><b>→</b><span>SEQUENCE</span><b>→</b><span>PROCESS</span><b>→</b><span>INTERPRETATION</span><b>→</b><span>UNCERTAINTY</span></div>
        <div class="sentence-stems"><p><b>Our evidence shows</b> ______________________________________________.</p><p><b>We think</b> __________________ happened before __________________ because __________________.</p><p><b>The process that best explains the pattern is</b> __________________________________.</p><p><b>Our explanation is stronger because these clues agree:</b> __________________ and __________________.</p><p><b>We still cannot confirm</b> __________________________________________.</p></div>
        <p class="uncertainty-note">Several explanations may remain possible. Choose the one best supported by the available evidence and state what the survey still cannot show.</p>
      </section>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="collab-row"><article><b>TEAM WORK</b><span>Sequence the evidence and agree on one cautious interpretation.</span></article><article><b>TEAM RECORD</b><span>One person records the Deep Record Timeline.</span></article><article><b>MY REFLECTION</b><span>Everyone completes one short science reflection.</span></article></div>

      <section class="team-record">
        <div class="record-heading"><div><small>FORMATIVE SYNTHESIS TEAM RECORD</small><h3>DEEP RECORD TIMELINE</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span id="record-continent">____________________________</span></label>
          <label><strong>IMPORTANT LAYERS / EVIDENCE</strong><span>________________________________________</span></label>
          <label class="wide"><strong>RELATIVE EVENT SEQUENCE</strong><span>FIRST: __________________ → NEXT: __________________ → LATER: __________________ → MOST RECENT: __________________</span></label>
          <label><strong>FOLDING / FAULTING / CRUSTAL EVIDENCE</strong><span>________________________________________ OR none confirmed</span></label>
          <label><strong>FOSSIL EVIDENCE</strong><span>________________________________________ OR none confirmed in current survey</span></label>
          <label class="wide"><strong>LIKELY LANDSCAPE / GEOLOGICAL CHANGE</strong><span>________________________________________________________________</span></label>
          <label><strong>ACCUMULATED EVIDENCE 1</strong><span>________________________________________</span></label>
          <label><strong>ACCUMULATED EVIDENCE 2</strong><span>________________________________________</span></label>
          <label class="wide"><strong>ONE UNCERTAINTY</strong><span>________________________________________________________________</span></label>
        </div>
      </section>

      <section class="reflection-card"><small>MY REFLECTION</small><h3>Why do scientists become more confident when many different pieces of geological evidence support the same explanation?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>
      <div class="finished-box"><strong>Mission 4 is finished when:</strong><span>your team has one <b>Deep Record Timeline</b> and you have completed <b>your reflection</b>.</span><em>Mission 5 — Prepare the Final Evidence remains locked/upcoming.</em></div>
    </section>

    <section class="class-plan"><small>4 × 45-MINUTE CLASSES</small><div><article><b>CLASS 1</b><strong>When Earth’s Layers Bend and Break</strong><p>Strata, folding, faulting, Canadian Rockies/Cordillera and qualitative crustal-movement evidence.</p></article><article><b>CLASS 2</b><strong>Fossils and Geological Time</strong><p>Fossil types, formation/context, uncertainty, simplified geological time and Royal Tyrrell stewardship.</p></article><article><b>CLASS 3</b><strong>Reconstruct the Deep Record</strong><p>Common Earth training cross-section, relative event sequence, accumulated evidence and uncertainty.</p></article><article><b>CLASS 4</b><strong>What Happened at Our Site?</strong><p>Continent Deep Record Survey File, one team interpretation, Deep Record Timeline and reflection.</p></article></div></section>
  </div>

  <script is:inline define:vars={{ siteData: phase5GeologicalSites, deepData: deepFiles }}>
    (() => {
      const KEY='jabberwocky-phase5-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const survey=document.getElementById('survey-panel');
      if(saved&&sites[saved]){
        const site=sites[saved];
        const clues=deepData[saved]||[];
        result.hidden=false;missing.hidden=true;survey.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-question').textContent=site.previousTeamGeologicalBriefing.openGeologicalQuestion;
        document.getElementById('survey-title').textContent=`${site.icon} ${site.name} · Deep Record Survey File`;
        ['deep-1','deep-2','deep-3'].forEach((id,i)=>{document.getElementById(id).textContent=clues[i]||'No additional evidence supplied.';});
        document.getElementById('record-continent').textContent=site.name;
      }else{result.hidden=true;missing.hidden=false;survey.hidden=true;}
      document.getElementById('print-phase5-mission4')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

