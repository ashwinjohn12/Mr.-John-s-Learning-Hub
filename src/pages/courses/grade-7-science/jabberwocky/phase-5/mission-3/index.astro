---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase5Progress from '../../../../../../components/JcecPhase5Progress.astro';
import { phase5GeologicalSites } from '../../../../../../data/jabberwockyPhase5';

const base = import.meta.env.BASE_URL;

const surfaceProcesses = [
  { icon:'🪨', title:'WEATHERING', action:'BREAKS material down', text:'Rock or other Earth material changes or breaks into smaller pieces at or near the surface. It does not have to move.' },
  { icon:'➡️', title:'EROSION', action:'MOVES material', text:'Water, wind, ice or gravity can transport loosened Earth material from one place to another.' },
  { icon:'⬇️', title:'DEPOSITION / SEDIMENTATION', action:'material SETTLES', text:'Transported material is left behind when the moving agent can no longer carry as much of it.' },
  { icon:'⏳', title:'TIME', action:'small changes can add up', text:'A process can be slow during one class period and still reshape a landscape when it continues or repeats.' }
];

const weatheringCards = [
  { title:'Cracked rock surface', evidence:'A rock surface contains widening cracks and small fragments nearby.', idea:'Evidence that material is breaking down; the card alone does not prove what caused every crack.' },
  { title:'Freeze–thaw example', evidence:'On Earth, water can enter a crack, freeze and expand, helping widen the crack over repeated cycles.', idea:'A real-Earth example of physical weathering. Do not automatically transfer it to a Jabberwocky site.' },
  { title:'Roots in a crack', evidence:'Roots can grow into existing cracks and press on rock as they grow.', idea:'A biological contribution to weathering before pieces are transported.' },
  { title:'Changed surface colour/texture', evidence:'Some Earth minerals react with water or air and develop altered surface material.', idea:'A real-Earth example of chemical weathering. A colour change alone does not identify the reaction.' }
];

const fallbackData = [
  { condition:'Lower slope · Trial 1', distance:'11 cm', deposition:'Mostly lower half of tray', observation:'Water spread broadly; several grains stopped early.' },
  { condition:'Lower slope · Trial 2', distance:'13 cm', deposition:'Lower half / tray end', observation:'A narrow pathway formed; some fine sediment travelled farther.' },
  { condition:'Higher slope · Trial 1', distance:'25 cm', deposition:'Near tray end', observation:'More material moved quickly down one channel.' },
  { condition:'Higher slope · Trial 2', distance:'17 cm', deposition:'Mid-to-lower tray', observation:'Unusual result: water ran strongly along one side rather than through the centre.' }
];

const tyrrellBadlands='https://tyrrellmuseum.com/learn/Badlands_Goodlands';
const usgsEarthquakes='https://www.usgs.gov/programs/earthquake-hazards/science-earthquakes';
---

<BaseLayout title="Mission 3: Track the Changing Surface | The Deep Record" description="Phase 5 Mission 3: investigate weathering, erosion, deposition, fair testing and cautious long-term prediction." themeColor="#111916">
  <div class="mission-shell" id="phase5-mission3">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 5', href:`${base}courses/grade-7-science/jabberwocky/phase-5/` },
      { label:'Mission 3' }
    ]} />

    <JcecPhase5Progress active={3} compact={true} />

    <header class="mission-hero">
      <div><p class="eyebrow">PHASE 5 // MISSION 3 OF 5</p><h1>TRACK THE <span>CHANGING SURFACE</span></h1><p class="question">How can small surface processes reshape a landscape over long periods of time?</p></div>
      <aside><span>SCIENCE REASONING CHECKPOINT</span><strong>Fair testing + data + geological-process understanding + cautious prediction</strong><small>4 classes × 45 minutes</small></aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 3 of 5 · Surface Change</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 Surface Change Forecast + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>JCEC needs to know what surface process could keep changing a site after settlement planning begins.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 3 steps"><a href="#your-mission"><b>1</b><span>Your Mission</span></a><a href="#learn"><b>2</b><span>Learn</span></a><a href="#investigate"><b>3</b><span>Investigate</span></a><a href="#decide"><b>4</b><span>Decide</span></a><a href="#record"><b>5</b><span>Record It</span></a></nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing"><p>Mission 2 reconstructed how geological materials <strong>may have formed in the past</strong>. But the surface is still changing now. Your Geological Survey team must separate weathering from erosion and deposition, run a controlled model of sediment movement, explain the pattern in the data, and decide which surface-change process JCEC should monitor most carefully. Slow change still matters when it repeats for a long time.</p></div>

      <div class="assignment-result" id="assignment-result" hidden><span id="assignment-icon"></span><div><small>YOUR PHASE 5 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div><div class="challenge-badge"><small>SURFACE / ENVIRONMENT</small><b id="assignment-surface"></b></div></div>
      <div class="missing-assignment" id="missing-assignment" hidden><strong>Your Phase 5 posting is not saved on this device yet.</strong><p>Return to The Deep Record hub and confirm the continent your teacher assigned. Mission 3 does not create a new posting.</p><a href={`${base}courses/grade-7-science/jabberwocky/phase-5/`}>Get Phase 5 posting →</a></div>
      <div class="continuity-strip"><strong>MISSIONS 1–2 ARE ALREADY DONE</strong><span>You do not need to reopen the Ground Evidence Card or Rock History Profile. Mission 3 gives you the surface-change clues you need.</span></div>

      <section class="evidence-source-rule">
        <article class="earth"><small>EARTH REFERENCE EVIDENCE</small><strong>REAL EARTH · AUTHENTIC SOURCE</strong><p>Use real Earth cases to learn what surface-change evidence can mean.</p></article>
        <article class="jabber"><small>JABBERWOCKY SURVEY EVIDENCE</small><strong>MISSION 2190 SURVEY</strong><p>Use only JCEC observations when deciding what process matters on your continent.</p></article>
        <div><b>Keep them separate:</b> real-Earth examples can teach a process. They do <strong>not</strong> automatically create a flood, landslide, earthquake or other hazard on Jabberwocky.</div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="section-lead">A simple way to keep the three surface processes straight is:</p>
      <div class="big-chain"><span>BREAK</span><b>→</b><span>MOVE</span><b>→</b><span>SETTLE</span></div>
      <div class="science-grid">{surfaceProcesses.map((idea)=><article><span>{idea.icon}</span><strong>{idea.title}</strong><b>{idea.action}</b><p>{idea.text}</p></article>)}</div>

      <div class="misconception"><strong>WEATHERING ≠ EROSION</strong><p><b>Weathering can happen without transport.</b> A rock can crack or change in place. <b>Erosion requires movement.</b> Once loosened material is transported, erosion is occurring; when it settles, deposition/sedimentation is occurring.</p></div>

      <section class="weathering-panel">
        <div class="block-title"><div><small>EARTH REFERENCE EVIDENCE</small><h3>What shows material breaking down before it is moved?</h3></div><span>WEATHERING EVIDENCE</span></div>
        <div class="weathering-grid">{weatheringCards.map((card)=><article><strong>{card.title}</strong><p>{card.evidence}</p><span>{card.idea}</span></article>)}</div>
        <p class="source-note">These are short evidence examples, not a second investigation. Your main physical model in this mission focuses most directly on <b>erosion + deposition</b>.</p>
      </section>

      <section class="change-panel">
        <div class="source-heading"><div><small>EARTH REFERENCE EVIDENCE</small><h3>Gradual change and sudden change both reshape Earth.</h3></div><a href={usgsEarthquakes} target="_blank" rel="noreferrer">USGS sudden-change example ↗</a></div>
        <div class="change-grid"><article><strong>GRADUAL / INCREMENTAL</strong><p>Weathering, erosion and deposition can repeat slowly and accumulate over long periods.</p></article><article><strong>SUDDEN</strong><p>Earthquakes are a real-Earth example of rapid change. Mission 4 will use real Earth evidence to study deeper crustal change.</p></article></div>
        <p><b>Mission 3 stays focused on gradual surface processes.</b> A real-Earth sudden-change example does not prove that your Jabberwocky continent has that hazard.</p>
      </section>

      <section class="alberta-panel">
        <div class="source-heading"><div><small>EARTH REFERENCE EVIDENCE · ALBERTA</small><h3>Badlands: erosion exposes a layered record</h3></div><a href={tyrrellBadlands} target="_blank" rel="noreferrer">Royal Tyrrell Museum source ↗</a></div>
        <p>Alberta's badlands are a useful reference because students can see how sedimentation builds layers and erosion later exposes and reshapes them. Use this Earth example to understand the processes—<strong>not</strong> to claim that a Jabberwocky site is becoming badlands.</p>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>
      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Surface Change Fair Test</h3></div><span>CONTROL ONE MAIN VARIABLE</span></div>
        <p><strong>Question:</strong> How does changing slope affect how far sediment is transported by the same amount of moving water in our model?</p>
        <div class="fair-test-grid"><article><small>CHANGE</small><strong>SLOPE</strong><p>Compare a lower slope with a higher slope.</p></article><article><small>MEASURE</small><strong>TRANSPORT DISTANCE (cm)</strong><p>Measure how far the sediment front moves.</p></article><article><small>OBSERVE</small><strong>DEPOSITION LOCATION</strong><p>Where does transported sediment settle?</p></article></div>

        <div class="control-box"><small>KEEP THESE REASONABLY SIMILAR</small><div><span>same tray</span><span>same sediment mixture</span><span>same sediment amount</span><span>same starting shape</span><span>same water amount</span><span>same pouring point</span><span>same approximate pouring time/rate</span></div></div>

        <div class="setup-grid"><article><small>LOWER SLOPE</small><strong>Raise the tray with one identical book/block.</strong><p>No angle calculation is required.</p></article><article><small>HIGHER SLOPE</small><strong>Raise the same tray with two or three identical books/blocks.</strong><p>Change slope—not everything else.</p></article></div>

        <div class="materials-check"><strong>MATERIALS REALITY CHECK</strong><p>Use shallow reused trays/containers, a small quantity of sand/soil/gravel, a marked cup or bottle, ruler, towels and ordinary books/blocks. Teacher chooses one water amount between <b>50–100 mL per trial</b> and uses the same amount for both conditions. Assign one water manager per group. <b>No running hose and no commercial stream table are required.</b></p></div>
        <div class="safety-note"><strong>CLASSROOM SAFETY</strong><span>Desk-sized trays only. Keep water inside the tray, wipe spills immediately, keep devices away from wet stations, and wash hands after handling classroom sediment.</span></div>

        <section class="data-table">
          <div class="block-title"><div><small>ONE SMALL DATA TABLE</small><h4>Record numbers and observations together.</h4></div><span>QUANTITATIVE + QUALITATIVE</span></div>
          <div class="table-wrap"><table><thead><tr><th>Slope condition</th><th>Transport distance (cm)</th><th>Deposition location</th><th>Observation</th></tr></thead><tbody><tr><td>Lower slope</td><td>_____ cm</td><td>________________</td><td>____________________________</td></tr><tr><td>Higher slope</td><td>_____ cm</td><td>________________</td><td>____________________________</td></tr></tbody></table></div>
        </section>

        <section class="fallback-panel">
          <div class="block-title"><div><small>NO-PURCHASE / ABSENCE FALLBACK</small><h4>Use supplied evidence if the physical model cannot run.</h4></div><span>TRAINING DATA · NOT JABBERWOCKY CANON</span></div>
          <div class="fallback-grid">{fallbackData.map((row)=><article><strong>{row.condition}</strong><span>{row.distance}</span><p><b>Deposition:</b> {row.deposition}</p><p>{row.observation}</p></article>)}</div>
          <p>Students who miss the physical investigation can use class data or this supplied dataset and complete the same reasoning. If available, pair the data with before/after tray photos or simple deposition diagrams.</p>
        </section>

        <section class="anomaly-panel">
          <small>DO NOT ERASE THE WEIRD RESULT</small><h4>Which result did not fit the overall pattern? What might explain it?</h4>
          <div class="anomaly-grid"><span>different pouring rate</span><span>uneven starting sediment</span><span>measurement error</span><span>water flowed along one side</span></div>
          <p>An unusual result is evidence about the <b>quality of the test</b>. Explain it instead of deleting it.</p>
        </section>

        <section class="prediction-panel">
          <div class="block-title"><div><small>MODEL-DATA TASK</small><h4>Predict—but keep the conditions attached to the prediction.</h4></div><span>INTERPOLATION / EXTRAPOLATION</span></div>
          <p class="training-note">JCEC training data: after controlled pours under the same model conditions, a sediment front is recorded at <b>4 cm → 7 cm → 10 cm → 13 cm</b>.</p>
          <div class="prediction-grid"><article><small>INTERPOLATE</small><strong>If the 10 cm measurement were missing, what value would fit the pattern between 7 cm and 13 cm?</strong><p>Estimate: __________</p></article><article><small>EXTRAPOLATE</small><strong>If the same model pattern continued one more trial, what next value would you predict?</strong><p>Predict: __________</p></article></div>
          <blockquote>Why would it be unsafe to assume a real landscape will continue changing at exactly this rate for hundreds or thousands of years?</blockquote>
          <p><b>Model prediction = useful, but conditional.</b> Real landscapes change when water amount, vegetation, sediment, weather, slope or other conditions change.</p>
        </section>

        <div class="checkpoint-focus"><strong>THIS CHECKPOINT ASSESSES</strong><span>fair testing → data → geological-process understanding → cautious prediction</span><em>Not whose tray moved the most sediment.</em></div>
        <button type="button" class="small-button" id="print-phase5-mission3">Print Fair Test + Surface Change Forecast</button>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASSES 3–4</p><h2>Make a Decision</h2></div></div>
      <section class="survey-panel" id="survey-panel" hidden>
        <div class="block-title"><div><small>JABBERWOCKY SURVEY EVIDENCE</small><h3 id="survey-title">Surface-change clues</h3></div><span>MISSION 2190 SURVEY</span></div>
        <p class="survey-warning"><strong>Several processes may matter.</strong> These clues do not create a predetermined answer or a new disaster. Choose the process JCEC should monitor first and explain why.</p>
        <div class="survey-grid"><article><small>CLUE 1</small><p id="clue-1"></p></article><article><small>CLUE 2</small><p id="clue-2"></p></article><article><small>CLUE 3</small><p id="clue-3"></p></article></div>
      </section>

      <section class="decision-card">
        <small>ONE TEAM DECISION</small><h3>Which surface-change process should JCEC monitor most carefully at this site?</h3>
        <div class="reasoning-chain"><span>CLAIM</span><b>→</b><span>DATA</span><b>→</b><span>PROCESS</span><b>→</b><span>LONG-TERM PREDICTION</span><b>→</b><span>LIMITATION</span></div>
        <div class="sentence-stems"><p><b>We think JCEC should monitor</b> __________________________________________.</p><p><b>Our investigation showed</b> ______________________________________________.</p><p><b>This is evidence of</b> __________________ because ____________________________.</p><p><b>If similar conditions continued, we would predict</b> __________________________.</p><p><b>One reason the real site may not change exactly like our model is</b> __________________.</p></div>
      </section>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="collab-row"><article><b>TEAM WORK</b><span>Compare the model evidence and continent clues, then choose one monitoring priority.</span></article><article><b>TEAM RECORD</b><span>One person records the Surface Change Forecast.</span></article><article><b>MY REFLECTION</b><span>Everyone completes one short science reflection.</span></article></div>

      <section class="team-record">
        <div class="record-heading"><div><small>SCIENCE REASONING CHECKPOINT</small><h3>SURFACE CHANGE FORECAST</h3></div><span>ONE PER TEAM</span></div>
        <div class="record-grid">
          <label><strong>CONTINENT</strong><span id="record-continent">____________________________</span></label>
          <label><strong>PRIORITY SURFACE-CHANGE PROCESS</strong><span>________________________________________</span></label>
          <label><strong>QUANTITATIVE EXPERIMENTAL EVIDENCE</strong><span>________________________________________</span></label>
          <label><strong>ONE QUALITATIVE OBSERVATION</strong><span>________________________________________</span></label>
          <label class="wide"><strong>CONNECTION TO OUR SITE EVIDENCE</strong><span>________________________________________________________________</span></label>
          <label class="wide"><strong>PREDICTED LONG-TERM DIRECTION OF CHANGE</strong><span>________________________________________________________________</span></label>
          <label><strong>ONE FACTOR THAT COULD CHANGE THE PREDICTION</strong><span>________________________________________</span></label>
          <label><strong>ONE MONITORING RECOMMENDATION</strong><span>________________________________________</span></label>
        </div>
      </section>

      <section class="reflection-card"><small>MY REFLECTION</small><h3>Why can a very slow geological process still become important over a long time?</h3><p>________________________________________________________________________________</p><p>________________________________________________________________________________</p></section>
      <div class="finished-box"><strong>Mission 3 is finished when:</strong><span>your team has one <b>Surface Change Forecast</b> and you have completed <b>your reflection</b>.</span><em>Mission 4 — Read the Deep Past remains locked/upcoming.</em></div>
    </section>

    <section class="class-plan"><small>4 × 45-MINUTE CLASSES</small><div><article><b>CLASS 1</b><strong>Break, Move, Settle</strong><p>Weathering vs erosion vs deposition, gradual/sudden change and fair-test planning.</p></article><article><b>CLASS 2</b><strong>Surface Change Fair Test</strong><p>Run the controlled slope comparison and collect quantitative + qualitative evidence.</p></article><article><b>CLASS 3</b><strong>What Does the Pattern Show?</strong><p>Combine/interpret data, explain an anomaly, practise interpolation/extrapolation, discuss model limits and read continent clues.</p></article><article><b>CLASS 4</b><strong>What Should JCEC Monitor?</strong><p>Select one priority process, complete checkpoint reasoning, Surface Change Forecast and reflection.</p></article></div></section>
  </div>

  <script is:inline define:vars={{ siteData: phase5GeologicalSites }}>
    (() => {
      const KEY='jabberwocky-phase5-posting';
      const sites=Object.fromEntries(siteData.map((site)=>[site.id,site]));
      const saved=localStorage.getItem(KEY);
      const result=document.getElementById('assignment-result');
      const missing=document.getElementById('missing-assignment');
      const survey=document.getElementById('survey-panel');
      if(saved&&sites[saved]){
        const site=sites[saved];
        result.hidden=false;missing.hidden=true;survey.hidden=false;
        document.getElementById('assignment-icon').textContent=site.icon;
        document.getElementById('assignment-name').textContent=site.name;
        document.getElementById('assignment-subtitle').textContent=site.subtitle;
        document.getElementById('assignment-surface').textContent=site.previousTeamGeologicalBriefing.surfaceEnvironment;
        document.getElementById('survey-title').textContent=`${site.icon} ${site.name} · Surface-change clues`;
        const clues=site.mission3SurfaceChangeClues||[];
        ['clue-1','clue-2','clue-3'].forEach((id,i)=>{document.getElementById(id).textContent=clues[i]||'No additional clue supplied.';});
        document.getElementById('record-continent').textContent=site.name;
      }else{result.hidden=true;missing.hidden=false;survey.hidden=true;}
      document.getElementById('print-phase5-mission3')?.addEventListener('click',()=>window.print());
    })();
  </script>
</BaseLayout>

<style>
