---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const phase3 = (part='') => `${base}courses/grade-7-science/jabberwocky/phase-3/${part}`;

const coreDays = [
  {day:1,mission:'Mission 1 — Read the Thermal Warning',title:'What Does Temperature Tell Us?',route:'mission-1/',prep:'Assign Phase 3 teams/continents; open the Hub; stage thermometer-sharing stations.',materials:'4–6 shared thermometers if available; reused cups; cool/room/warm water; towels.',student:'Launch Phase 3 → thermometer skill → temperature vs thermal energy → particle model.',science:'Temperature relates to average particle motion; thermal energy is not identical to temperature.',emphasis:'Use °C and careful measurement. Shared thermometers rotate.',collect:'Thermometer evidence + particle explanation — formative.',cut:'Use teacher-provided sample readings for one station.'},
  {day:2,mission:'Mission 1 — Read the Thermal Warning',title:'Heating and Cooling Evidence',route:'mission-1/#investigate',prep:'Prepare safe state-change/expansion observations or evidence cards.',materials:'Water/ice; shared thermometer access; optional bottle + balloon/flexible cover; towels.',student:'Observe melting/condensation and expansion/contraction evidence.',science:'Heating/cooling changes particle motion and can cause state/volume changes.',emphasis:'One particle idea connects the observations.',collect:'Observation table — formative.',cut:'Use supplied evidence cards.'},
  {day:3,mission:'Mission 1 — Read the Thermal Warning',title:'What Is Our Thermal Risk?',route:'mission-1/#record',prep:'Confirm posting; open continent clues; prepare Thermal Risk Card.',materials:'Device; Mission 1 evidence; Thermal Risk Card.',student:'Use continent clues → choose main thermal risk → Team Record + reflection.',science:'Temperature evidence identifies risk, but temperature and total thermal energy differ.',emphasis:'Do not design solutions yet.',collect:'Thermal Risk Card — formative.',cut:'Cut sharing/polish.'},

  {day:4,mission:'Mission 2 — Follow the Heat',title:'Thermal Energy on the Move',route:'mission-2/',prep:'Set conduction/convection stations and fallback cards.',materials:'Warm water; metal/plastic/wood pieces; optional colouring; shared thermometers.',student:'Learn conduction + convection → begin Heat Pathway Stations.',science:'Conduction transfers through particle interactions; convection transfers through moving fluids.',emphasis:'Air is a fluid. Conduction is not limited to solids.',collect:'Station evidence — formative.',cut:'Teacher-demonstrate convection.'},
  {day:5,mission:'Mission 2 — Follow the Heat',title:'Heat Without Touching',route:'mission-2/#investigate',prep:'Set radiation comparison or sample data.',materials:'Dark/light or exposed/shaded surfaces; existing lamp/sunlight if useful.',student:'Learn radiation → complete Heat Pathway Stations.',science:'Radiation can transfer thermal energy across space without matter between source and receiver.',emphasis:'All three pathways can happen at once.',collect:'Completed station sheet — formative.',cut:'Use radiation evidence card.'},
  {day:6,mission:'Mission 2 — Follow the Heat',title:'Trace Our Habitat',route:'mission-2/#record',prep:'Open continent heat-pathway clues; prepare Habitat Heat Map.',materials:'Station evidence; Habitat Heat Map.',student:'Choose priority pathway → simple science arrows/labels → reflection.',science:'Conditions affect which transfer pathway deserves first attention.',emphasis:'Science diagram, not art project.',collect:'Habitat Heat Map — formative.',cut:'Provide a habitat outline.'},

  {day:8,mission:'Mission 3 — The Director Is Coming',title:'Design for Heat Retention',route:'mission-3/',prep:'Prepare standardized inner cups; shared recycled-material depot; design sheets. No hot water yet.',materials:'Same inner cup per team; cardboard/paper/fabric/foil/bubble wrap/clean foam if available; tape/string/elastics; rulers.',student:'Director briefing → retrieve conduction/convection/radiation → choose materials → label layers → build Prototype 1.',science:'Insulation slows thermal-energy transfer; design can reduce conductive pathways, air movement and radiative transfer.',emphasis:'Design from heat-transfer science, not from which material “looks warm.”',collect:'Labelled design + material rationale — checkpoint evidence in progress.',cut:'Finish construction at start of Day 9.'},
  {day:9,mission:'Mission 3 — The Director Is Coming',title:'Prototype Test',route:'mission-3/#investigate',prep:'Stage teacher-controlled hot water, 200 mL measuring containers, 4–6 shared thermometers, timers, trays/towels.',materials:'Prototype thermoses; safe hot-but-not-boiling water; shared thermometers; measuring containers; timer.',student:'Record 0, 5, 10, 15, 20, 25, 30 min temperatures; annotate likely heat-transfer pathways.',science:'Quantitative temperature data reveal how quickly the system loses thermal energy.',emphasis:'Controlled test, not a competition. Teacher controls heating/pouring.',collect:'Prototype 1 seven-reading dataset — checkpoint evidence.',cut:'Stagger starts or use teacher/shared dataset.'},
  {day:10,mission:'Mission 3 — The Director Is Coming',title:'Evidence → Redesign',route:'mission-3/#investigate',prep:'Prepare graph template; return prototype data; reopen materials depot.',materials:'Prototype data; graph paper/template; redesign materials.',student:'Calculate temperature decrease → make time–temperature graph → diagnose conduction/convection/radiation → propose two changes → choose redesign.',science:'Temperature change and graph patterns support claims; redesign must respond to evidence.',emphasis:'“Add more stuff” is not reasoning. Change → transfer process → predicted effect.',collect:'Graph + diagnosis + redesign plan — checkpoint evidence.',cut:'Provide graph axes/template; keep diagnosis and redesign reasoning.'},
  {day:11,mission:'Mission 3 — The Director Is Coming',title:'Final Test + JCEC Decision',route:'mission-3/#record',prep:'Repeat Day 9 testing setup as closely as practical; prepare JCEC Thermos Design Report.',materials:'Final thermoses; same test equipment/procedure; Design Report.',student:'Retest → compare prototype/final → choose two thermal-design principles → Team Record + reflection.',science:'Comparable tests support stronger conclusions. A worse redesign is still useful evidence.',emphasis:'Assess thermal science, fair testing, graph/data reasoning and evidence-based redesign—not appearance or class rank.',collect:'JCEC Thermos Design Report — stronger checkpoint.',cut:'Use a common teacher final-test dataset if equipment/time fails; do not cut the reasoning.'},

  {day:13,mission:'Mission 4 — Control the Habitat',title:'How Does a Habitat Know When to Respond?',route:'mission-4/',prep:'Prepare thermostat feedback diagram + generate/transfer/remove/control cards.',materials:'Projected/printed cards; pencils; optional thermometer/bimetal demo.',student:'Scale from thermos barrier thinking to whole-habitat generate/transfer/remove/control + feedback.',science:'Thermostat feedback: measure → compare → respond → measure again.',emphasis:'Cooling moves thermal energy out; it does not make cold. Mission 3 slowed transfer; Mission 4 controls the whole system.',collect:'Feedback-loop explanation — formative.',cut:'Protect feedback-loop idea; shorten historical example.'},
  {day:14,mission:'Mission 4 — Control the Habitat',title:'Habitat Control Loop Challenge',route:'mission-4/#investigate',prep:'Prepare temperature sequence and response cards.',materials:'Projected/printed readings/cards; pencils.',student:'Use target range → select heater/cooling/shade/vent/hold responses → write if/then rules.',science:'Control systems respond to measurements and can use passive/active actions.',emphasis:'Students are learning control logic, not HVAC engineering.',collect:'Control-loop decisions — formative.',cut:'Use fewer rounds.'},
  {day:15,mission:'Mission 4 — Control the Habitat',title:'Passive, Active and Thermal Sources',route:'mission-4/#learn',prep:'Prepare passive/active solar comparison + source board.',materials:'Source cards/images; protocol draft.',student:'Compare passive/active solar and source options → read continent clues.',science:'Systems can generate, move, remove and control thermal energy; sources have limits.',emphasis:'Do not imply every energy source exists on every continent.',collect:'One passive strategy + one active backup — formative.',cut:'Keep one source comparison.'},
  {day:16,mission:'Mission 4 — Control the Habitat',title:'Write the Habitat Control Protocol',route:'mission-4/#record',prep:'Prepare protocol template.',materials:'Mission 4 evidence; protocol.',student:'Choose target + passive first + heating/cooling response + safety rule → reflection.',science:'Useful protocols respond to measured conditions and explicit safety limits.',emphasis:'Mission 4 stays formative.',collect:'Habitat Control Protocol — formative.',cut:'Use sentence starters.'},

  {day:18,mission:'Mission 5 — Survive Without Wasting It',title:'When a Working System Is Still a Bad Choice',route:'mission-5/',prep:'Prepare cached source cards + energy-source comparison.',materials:'Source cards; devices optional; pencils.',student:'Sources → energy use → conservation → sustainability/trade-offs.',science:'A thermal system must be effective, safe and sustainable.',emphasis:'No open internet research required.',collect:'Two useful source facts — formative synthesis evidence.',cut:'Teacher summarize one card.'},
  {day:19,mission:'Mission 5 — Survive Without Wasting It',title:'Thermal Energy Budget Challenge',route:'mission-5/#investigate',prep:'Set continent scenario/budget/options/restriction.',materials:'Scenario; tally sheet/tokens; pencils.',student:'Plan passive/active responses within relative energy budget.',science:'Passive design can reduce active-energy demand.',emphasis:'JCEC units are relative, not watts/kWh.',collect:'Initial budget plan.',cut:'Use three rounds.'},
  {day:20,mission:'Mission 5 — Survive Without Wasting It',title:'Consequence + Thermal Evidence Locker',route:'mission-5/#investigate',prep:'Prepare consequence reveal and Evidence Locker reminders.',materials:'Budget plan; consequence; Evidence Locker.',student:'Revise one part → choose three strongest evidence items. M3 reminder = thermos-test result + thermal-design principle.',science:'Final decisions draw on temperature, transfer, thermal design and control evidence.',emphasis:'Evidence Locker first; do not reopen old mission pages unless verifying a detail.',collect:'One justified revision + three evidence selections.',cut:'Teacher preselects the four reminders.'},
  {day:21,mission:'Mission 5 — Survive Without Wasting It',title:'JCEC Thermal Survival Decision',route:'mission-5/#record',prep:'Prepare Thermal Survival Plan.',materials:'Evidence Locker; budget revision; final plan.',student:'Authorize a thermal system → one-page plan → 3–5 sentence why → reflection.',science:'Balance safety, transfer control, energy use, conservation and ecological safeguards.',emphasis:'Assess science + evidence + sustainable reasoning, not polish.',collect:'JCEC Thermal Survival Plan — major synthesis.',cut:'Use Flex Day 22; cut gallery work first.'}
];

const flexDays = [
  {day:7,title:'Heat Pathway spillover + equipment reset',use:'Mission 2 station spillover, absence recovery, conduction/convection/radiation reteach.'},
  {day:12,title:'Mission 3 checkpoint recovery',use:'Thermos retest if needed, graph completion, data troubleshooting, JCEC Thermos Design Report completion.'},
  {day:17,title:'Heat & Temperature review / individual check',use:'Targeted reteach + optional short individual science check.'},
  {day:22,title:'Thermal Survival Plan completion',use:'Finish Mission 5 synthesis and recover missing evidence.'},
  {day:23,title:'Absence recovery / individual assessment',use:'Make-up reasoning or optional individual science check.'},
  {day:24,title:'Optional gallery walk / continent comparison',use:'Compare evidence-supported thermal systems.'},
  {day:25,title:'Final buffer / feedback / transition',use:'Interruptions, feedback, make-up or transition.'}
];

const materials = [
  {mission:'Mission 1',title:'Thermal Change Investigation',preferred:'4–6 shared thermometers; reused cups; water/ice; simple expansion evidence.',fallback:'Rotate 1–2 thermometers + supplied readings/evidence cards.'},
  {mission:'Mission 2',title:'Heat Pathway Stations',preferred:'Warm water; common metal/plastic/wood pieces; optional colouring; dark/light surfaces; shared thermometer access.',fallback:'Teacher demonstrations + conduction/convection/radiation observation cards.'},
  {mission:'Mission 3',title:'The Director Is Coming — JCEC Thermos Challenge',preferred:'Same inner cup per team; recycled insulation materials; tape/string; 4–6 shared thermometers; 200 mL measuring containers; safe hot water; trays/towels; graph paper.',fallback:'Stagger/shared thermometer station → teacher test → supplied Prototype/Final datasets → Thermos Design Card Challenge. No thermos kit required.'},
  {mission:'Mission 4',title:'Habitat Control Loop Challenge',preferred:'Projected/printed temperature sequence and response cards.',fallback:'Project the challenge and record on notebook paper.'},
  {mission:'Mission 5',title:'Thermal Energy Budget + Survival Plan',preferred:'Cached source cards; scenarios; paper tokens/tally; Evidence Locker; final plan.',fallback:'Project one set and use notebook paper.'}
];

const contingencies = [
  ['Limited thermometers','Stagger team starts. Four to six shared thermometers are enough; with one thermometer use a teacher measurement station.'],
  ['Thermos materials are limited','Use one shared recycled-material depot. If construction cannot run, use Thermos Design Cards + supplied data.'],
  ['Hot-water setup is unavailable','Use the supplied Prototype/Final dataset. Preserve graphing, temperature change, diagnosis and redesign.'],
  ['Prototype or final test goes wrong','Keep the actual evidence if safe. Use pooled/teacher data only for missing measurements; record the limitation.'],
  ['Starting temperatures differ','Compare each design’s temperature decrease rather than raw final temperature alone.'],
  ['A cup leaks','Stop safely, record the design failure, repair if practical or use supplied data.'],
  ['Student absent during the thermos test','Use team/class data; do not require a private hot-water repeat.'],
  ['A class is lost','Use Flex Day 12. If necessary combine analysis/redesign with a shorter standardized final test; never cut evidence reasoning.'],
  ['Control Loop Challenge runs long','Use fewer readings but retain too-cold, safe-range and too-warm cases.'],
  ['Thermal Energy Budget runs long','Use three rounds; reveal consequence; require one revision.'],
  ['Source websites unavailable','Use cached source cards.']
];

const curriculum = [
  ['Temperature measurement + thermometers','Mission 1'],
  ['Heat vs temperature + particle model','Mission 1'],
  ['Expansion / contraction + changes of state','Mission 1'],
  ['Conduction / convection / radiation','Mission 2 → explicitly applied in Mission 3'],
  ['Conductivity / insulation','Mission 3 Thermos Challenge'],
  ['Fair testing / repeated quantitative temperature data / graphing / redesign / limitations','Mission 3 Thermos Challenge'],
  ['Passive + active solar','Mission 4'],
  ['Thermal-energy sources','Missions 4–5'],
  ['Thermometers / thermostats / feedback','Missions 1 and 4'],
  ['Heating / cooling systems','Mission 4'],
  ['Historical thermal technology','Mission 4'],
  ['Safety','Missions 1–5; hot-water safety explicit in Mission 3'],
  ['Energy use + renewable/non-renewable considerations','Mission 5'],
  ['Conservation + environmental consequences','Mission 5'],
  ['Evidence-based decisions','Mission 3 checkpoint + Mission 5 synthesis']
];
---

<BaseLayout title="Phase 3 Teacher Launch Guide | Mission 2190" description="Teacher implementation guide for Phase 3 Heat & Temperature, including the JCEC Thermos Challenge." themeColor="#081722">
  <div class="guide-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 3',href:phase3()},{label:'Teacher Launch Guide'}]} />
    <header class="hero"><p class="eyebrow">TEACHER CONTROL // PHASE 3</p><h1>PHASE 3 <span>TEACHER LAUNCH GUIDE</span></h1><p class="lead"><strong>18 core classes + 7 purposeful flex periods.</strong> Mission 3 is now <em>The Director Is Coming — The JCEC Thermos Challenge</em>, the stronger science-reasoning checkpoint.</p><div class="hero-links"><a href={phase3()}>Student Hub →</a><a href={`${base}courses/grade-7-science/jabberwocky/teacher-dashboard/`}>Teacher Master Dashboard →</a></div></header>

    <section class="rule"><strong>LOW-MATERIAL RULE</strong><span>ordinary classroom supplies → shared/reused equipment → printables/data fallbacks → specialty equipment only as optional enrichment</span></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">MISSION MAP</p><h2>3 + 3 + 4 + 4 + 4 = 18 core classes</h2></div><div class="mission-map"><article>1 · Read the Thermal Warning<br/><small>Thermal Risk Card · formative</small></article><article>2 · Follow the Heat<br/><small>Habitat Heat Map · formative</small></article><article class="checkpoint">3 · The Director Is Coming<br/><small>JCEC Thermos Design Report · stronger checkpoint</small></article><article>4 · Control the Habitat<br/><small>Habitat Control Protocol · formative</small></article><article class="major">5 · Survive Without Wasting It<br/><small>JCEC Thermal Survival Plan · major synthesis</small></article></div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">MISSION MATERIALS MASTER LIST</p><h2>What you actually need</h2></div><div class="materials-grid">{materials.map((item)=><article><small>{item.mission}</small><h3>{item.title}</h3><p><strong>PREFERRED:</strong> {item.preferred}</p><p><strong>No-purchase fallback:</strong> {item.fallback}</p></article>)}</div><div class="thermometer-plan"><h3>Thermometer sharing plan</h3><p><strong>You do not need one thermometer per team.</strong> Preferred: 4–6 shared thermometers. With 1–2, stagger starts or run a teacher station. Mission 3 can still use supplied Prototype/Final datasets if no usable thermometers are available.</p></div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">18 CORE DAYS</p><h2>Open tomorrow's lesson</h2></div><div class="days">{coreDays.map((d)=><details class="day-card"><summary><span>DAY {d.day}</span><div><small>{d.mission}</small><strong>{d.title}</strong></div><a href={phase3(d.route)}>Student page →</a></summary><div class="day-grid"><article><b>BEFORE CLASS</b><p>{d.prep}</p></article><article><b>MATERIALS</b><p>{d.materials}</p></article><article><b>STUDENTS SEE / DO</b><p>{d.student}</p></article><article><b>KEY SCIENCE</b><p>{d.science}</p></article><article><b>TEACHER EMPHASIS</b><p>{d.emphasis}</p></article><article><b>COLLECT / ASSESS</b><p>{d.collect}</p></article><article><b>IF TIME RUNS OUT</b><p>{d.cut}</p></article></div></details>)}</div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">7 PURPOSEFUL FLEX</p><h2>Recovery is planned, not improvised</h2></div><div class="flex-grid">{flexDays.map((d)=><article><span>DAY {d.day} · FLEX</span><h3>{d.title}</h3><p>{d.use}</p></article>)}</div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">ASSESSMENT</p><h2>Keep the grading light</h2></div><div class="assessment-grid"><article><small>FORMATIVE</small><h3>Missions 1, 2 and 4</h3><p>Feedback and evidence gathering; do not heavily grade every Team Record.</p></article><article class="checkpoint"><small>STRONGER CHECKPOINT</small><h3>Mission 3 · JCEC Thermos Design Report</h3><p>Thermal science → fair testing → quantitative data → graphing → evidence-based redesign.</p></article><article class="major"><small>MAJOR SYNTHESIS</small><h3>Mission 5 · JCEC Thermal Survival Plan</h3><p>Evidence → practical thermal decision → energy/conservation → ecological safeguard.</p></article><article><small>OPTIONAL INDIVIDUAL SCIENCE CHECK</small><h3>Day 17 or 23</h3><p>Suggested numeric balance: <strong>30% M3 / 55% M5 / 15% individual check</strong>, or about <strong>35% checkpoint / 65% synthesis</strong> without the check.</p></article></div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">CONTINGENCY PLAYBOOK</p><h2>Protect the reasoning when apparatus fails</h2></div><div class="contingencies">{contingencies.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section>

    <section class="panel"><div class="section-heading"><p class="eyebrow">ALBERTA HEAT & TEMPERATURE ALIGNMENT</p><h2>Curriculum coverage after the replacement</h2></div><div class="curriculum-grid">{curriculum.map(([topic,where])=><article><strong>{topic}</strong><span>→</span><p>{where}</p></article>)}</div><div class="boundary">Keep outside the required Grade 7 pathway: <strong>advanced calorimetry · specific-heat calculations · gas laws · detailed refrigeration cycles · formal efficiency equations</strong>. Official program source: <a href="https://education.alberta.ca/media/159716/sci7to9.pdf">Alberta Science 7–9 Program of Studies</a>.</div></section>

    <section class="panel readiness"><div class="section-heading"><p class="eyebrow">TEACHER LAUNCH-READINESS</p><h2>Final checks</h2></div><ul><li><strong>Do I know what to prepare tomorrow?</strong> Yes — every core day identifies setup/materials.</li><li><strong>Do I know what students should finish each day?</strong> Yes — Collect / Assess is explicit.</li><li><strong>Do I know when thermometers/shared equipment are needed?</strong> Yes — especially Missions 1–3; Mission 3 uses staggered/shared testing.</li><li><strong>Can I run the unit if equipment is limited?</strong> Yes — teacher/data fallbacks remain complete.</li><li><strong>Do I know what is formative, checkpoint and major assessment?</strong> Yes — M1/M2/M4 formative, M3 checkpoint, M5 major synthesis.</li><li><strong>Can I recover if a class or investigation is disrupted?</strong> Yes — Flex Days 7, 12, 17, 22–25 plus explicit fallbacks.</li><li><strong>Do teacher and student systems match?</strong> Yes — Mission 3 now uses the same thermos prototype → redesign → retest cycle in both.</li></ul></section>
  </div>
</BaseLayout>

<style>
:global(body){background:#061019}.guide-shell{max-width:1160px;margin:0 auto;padding:0 1rem 5rem;color:#eaf4fb}.guide-shell :global(.breadcrumbs){color:#91a7b5}.guide-shell :global(.breadcrumbs a){color:#dcecf5}.eyebrow{margin:0;color:#ffb25f;font:850 .73rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.hero,.panel{margin:1rem 0;padding:1.15rem;border:1px solid #29485b;border-radius:18px;background:#091a24}.hero{background:linear-gradient(145deg,#071722,#102b3b)}.hero h1{margin:.4rem 0;color:#fff;font-size:clamp(2.5rem,6vw,4.8rem)}.hero h1 span{color:#ffb25f}.lead{color:#b8cbd7;line-height:1.55}.hero-links{display:flex;gap:.5rem;flex-wrap:wrap}.hero-links a{padding:.6rem .75rem;border-radius:8px;background:#ffb25f;color:#2b1907;text-decoration:none;font-weight:900}.rule{display:flex;gap:.7rem;padding:.8rem;border-radius:10px;background:#102936}.rule strong{color:#ffbd78}.rule span{color:#bdd0da}.section-heading h2{margin:.2rem 0 .65rem;color:#fff}.mission-map{display:grid;grid-template-columns:repeat(5,1fr);gap:.5rem}.mission-map article,.materials-grid article,.assessment-grid article,.flex-grid article,.contingencies article{padding:.8rem;border:1px solid #304d5e;border-radius:10px;background:#07151e;color:#dceaf0}.mission-map small,.materials-grid small,.assessment-grid small,.flex-grid span{color:#ffb25f}.checkpoint{border-color:#e2b157!important}.major{border-color:#ff8f70!important}.materials-grid,.assessment-grid,.flex-grid,.contingencies{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.materials-grid h3,.assessment-grid h3,.flex-grid h3,.contingencies h3{margin:.25rem 0;color:#fff}.materials-grid p,.assessment-grid p,.flex-grid p,.contingencies p{color:#b9ccd6;font-size:.8rem;line-height:1.5}.thermometer-plan,.boundary{margin-top:.7rem;padding:.8rem;border-radius:9px;background:#102936;color:#bdd0da}.thermometer-plan h3{margin:0;color:#fff}.days{display:grid;gap:.55rem}.day-card{border:1px solid #355367;border-radius:11px;background:#07151e;overflow:hidden}.day-card summary{display:grid;grid-template-columns:70px 1fr auto;gap:.7rem;align-items:center;padding:.8rem;cursor:pointer}.day-card summary>span{color:#ffb25f;font-weight:900}.day-card summary div{display:grid}.day-card summary small{color:#8da5b5}.day-card summary strong{color:#fff}.day-card summary a{padding:.55rem .65rem;border-radius:7px;background:#ffb25f;color:#2c1905;text-decoration:none;font-size:.75rem;font-weight:900}.day-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;padding:.7rem;border-top:1px solid #29485b}.day-grid article{padding:.65rem;border-radius:8px;background:#0c222e}.day-grid article:last-child{grid-column:1/-1}.day-grid b{color:#ffbd78;font-size:.68rem}.day-grid p{margin:.3rem 0 0;color:#bdd0da;font-size:.8rem;line-height:1.45}.curriculum-grid{display:grid;gap:.35rem}.curriculum-grid article{display:grid;grid-template-columns:1fr 25px 1.2fr;gap:.4rem;padding:.6rem;border-radius:8px;background:#07151e}.curriculum-grid strong{color:#fff}.curriculum-grid span{color:#ffb25f;text-align:center}.curriculum-grid p{margin:0;color:#b4c7d1}.boundary a{color:#ffd0a0}.readiness ul{color:#bdd0da;line-height:1.55}.readiness strong{color:#fff}@media(max-width:850px){.mission-map{grid-template-columns:1fr 1fr}.materials-grid,.assessment-grid,.flex-grid,.contingencies,.day-grid{grid-template-columns:1fr}.day-grid article:last-child{grid-column:auto}.day-card summary{grid-template-columns:1fr}.curriculum-grid article{grid-template-columns:1fr}.curriculum-grid span{display:none}}@media(max-width:560px){.mission-map{grid-template-columns:1fr}.rule{display:grid}}
</style>
