---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const phase3 = (part = '') => `${base}courses/grade-7-science/jabberwocky/phase-3/${part}`;

const coreDays = [
  { day:1, mission:'Mission 1 — Read the Thermal Warning', title:'What Does Temperature Tell Us?', route:'mission-1/', prep:'Assign Phase 3 teams/continents; open the Phase 3 Hub; set up thermometer-sharing stations; prepare room-temperature, cool and warm water.', materials:'Devices; 4–6 shared thermometers if available; reused cups/containers; room-temperature, cool and warm water; towels; Thermal Change Investigation sheet.', student:'Phase launch → new posting → Previous Team Thermal Briefing → thermometer skill → temperature vs thermal energy → particle model.', science:'Temperature relates to average particle motion. Thermal energy depends on all particles in the sample and is not identical to temperature.', emphasis:'Use °C. Model careful reading and recording with units. A few thermometers are enough if teams rotate.', collect:'Thermometer readings + quick particle explanation — formative.', cut:'Use teacher-provided sample readings for one water sample if station rotation runs long.' },
  { day:2, mission:'Mission 1 — Read the Thermal Warning', title:'What Happens When Matter Heats or Cools?', route:'mission-1/#investigate', prep:'Prepare ice/condensation observation; set up bottle + balloon/flexible cover demonstration; prepare expansion evidence cards if no demo is available.', materials:'Shared thermometers; reused containers; water/ice; bottle + balloon/flexible cover; towels; optional demonstration materials already on hand.', student:'Thermal Change Investigation → melting/condensation → air expansion/contraction → teacher evidence for liquid/solid expansion.', science:'Heating increases particle motion; cooling decreases it. Matter can expand, contract and change state.', emphasis:'Treat expansion, contraction and state change as evidence of one particle idea, not three disconnected lessons.', collect:'Observation table — formative.', cut:'Use supplied evidence cards for liquid/solid expansion instead of a physical demonstration.' },
  { day:3, mission:'Mission 1 — Read the Thermal Warning', title:'What Is Our Thermal Risk?', route:'mission-1/#record', prep:'Confirm continent posting is saved; open the three continent thermal clues; prepare Thermal Risk Card.', materials:'Device; Mission 1 evidence; Thermal Risk Card; pencil.', student:'Read three continent clues → identify biggest thermal condition → explain with particle/temperature evidence → Team Record + reflection.', science:'Temperature evidence helps identify thermal risk, but temperature and total thermal energy are different quantities.', emphasis:'One clear risk + evidence is enough. Do not drift into designing the habitat yet.', collect:'Thermal Risk Card — formative; individual reflection for feedback.', cut:'Cut sharing/polish; keep decision, evidence and reflection.' },

  { day:4, mission:'Mission 2 — Follow the Heat', title:'Thermal Energy on the Move', route:'mission-2/', prep:'Set up conduction and convection shared stations; stage fallback observation/data cards before class.', materials:'Cups; warm water; metal/plastic/wood utensils or strips; optional food colouring; shared thermometers; towels; station sheet.', student:'Mission launch → conduction + convection science → begin Heat Pathway Stations.', science:'Conduction transfers thermal energy through particle interactions in matter. Convection transfers thermal energy through moving fluids—liquids and gases.', emphasis:'Conduction is easy to observe in solids but is not limited to solids. Air is a fluid.', collect:'What moved? → Evidence → Pathway notes — formative.', cut:'Demonstrate convection once for the whole class and give teams the evidence card.' },
  { day:5, mission:'Mission 2 — Follow the Heat', title:'Heat Without Touching', route:'mission-2/#investigate', prep:'Set up radiation comparison using sunlight/existing lamp if useful; have sample data ready in case the physical difference is weak.', materials:'Dark/light or exposed/shaded paper/surfaces; optional existing lamp; shared thermometers if useful; station sheet.', student:'Radiation science → complete remaining stations → compare conduction, convection and radiation.', science:'Radiation transfers energy across space and does not need matter between source and receiver.', emphasis:'All three pathways can happen at once in a real habitat. Students are learning to identify evidence, not memorize isolated definitions.', collect:'Completed Heat Pathway station sheet — formative.', cut:'Use the radiation sample-data card instead of waiting for a measurable classroom temperature difference.' },
  { day:6, mission:'Mission 2 — Follow the Heat', title:'Trace Our Habitat', route:'mission-2/#record', prep:'Open three continent-specific heat-pathway clues; prepare Habitat Heat Map.', materials:'Device; station evidence; Habitat Heat Map; pencil.', student:'Apply three pathway clues → choose one priority pathway → draw simple science arrows/labels → reflection.', science:'The dominant thermal pathway depends on conditions, but more than one pathway can matter.', emphasis:'This is a science diagram, not an art project. Require one priority while allowing students to acknowledge other pathways.', collect:'Habitat Heat Map — formative.', cut:'Use a teacher-provided habitat outline so students only add arrows, labels and one evidence statement.' },

  { day:8, mission:'Mission 3 — Hold the Temperature', title:'What Makes a Fair Thermal Test?', route:'mission-3/', prep:'Prepare equal-size barrier samples; choose matched reused containers; set up thermometer-sharing rotation; preview backup dataset.', materials:'Reused identical cups/containers; 4–6 shared thermometers if available; warm water; equal-size paper/cardboard/fabric/foil samples; timer; towels; fair-test sheet.', student:'Conductor vs insulator → trapped air/design → identify changed/measured/controlled variables → write the testable question.', science:'Thermal conductors allow transfer more readily; insulators slow transfer. A fair test changes one main variable and keeps other important conditions similar.', emphasis:'Do not let teams vary material, thickness, amount and container shape at once.', collect:'Fair-test plan/testable question — checkpoint evidence in progress.', cut:'Give the class the testable question and variable table rather than spending the whole period designing procedures.' },
  { day:9, mission:'Mission 3 — Hold the Temperature', title:'Run the Thermal Barrier Fair Test', route:'mission-3/#investigate', prep:'Set shared stations; prepare warm water safely; assign different barrier materials to different teams/stations so equipment can be shared.', materials:'Matched containers; warm water; shared thermometers; timer; assigned barrier samples; towels; data sheet.', student:'Measure start temperature → wait fixed time → measure end temperature → calculate temperature change.', science:'Smaller temperature change in the cooling test means slower heat loss during the test.', emphasis:'Shared stations are preferred. One or two teams can collect data that the whole class later uses.', collect:'Beginning/end temperatures + temperature change — checkpoint evidence.', cut:'If equipment is limited, run one teacher station and distribute the class/backup dataset.' },
  { day:10, mission:'Mission 3 — Hold the Temperature', title:'What Does the Evidence Say?', route:'mission-3/#investigate', prep:'Combine class results; prepare simple graph template; keep backup dataset available for missing/noisy results.', materials:'Class dataset; graph paper/template; calculator optional; continent clues.', student:'Combine results → make one simple bar graph → identify overall pattern → explain one result that does not fit → read three continent clues.', science:'Patterns and discrepancies both matter. Measurement, starting temperature, coverage and timing can affect evidence.', emphasis:'Do not erase noisy data. Ask what could explain it and whether the conclusion is still supported.', collect:'Graph + discrepancy explanation — checkpoint evidence.', cut:'Teacher provides the graph; students interpret it and explain the outlier.' },
  { day:11, mission:'Mission 3 — Hold the Temperature', title:'Thermal Barrier Recommendation', route:'mission-3/#record', prep:'Return fair-test/graph evidence; prepare Thermal Barrier Recommendation.', materials:'Data/graph; continent clues; Thermal Barrier Recommendation; pencil/device.', student:'Choose first barrier/design strategy → Claim → Data → Thermal Explanation → Limitation/Uncertainty → reflection.', science:'Materials and coverage can slow unwanted transfer in either direction; insulation does not create heat or cold.', emphasis:'This is the stronger Phase 3 reasoning checkpoint. Assess evidence quality and science, not model appearance.', collect:'Thermal Barrier Recommendation — stronger checkpoint.', cut:'Accept concise bullet reasoning; cut presentation/polish before evidence and limitation.' },

  { day:13, mission:'Mission 4 — Control the Habitat', title:'How Does a Habitat Know When to Respond?', route:'mission-4/', prep:'Print/project thermostat feedback diagram, generate/transfer/remove/control cards and short Then → Now strip.', materials:'Devices/projector; printed/projected control-system cards; pencils; optional existing thermometer/bimetal strip demonstration.', student:'Mission launch → generate/transfer/remove/control → thermometer vs thermostat → feedback loop → brief Then → Now thermal technology.', science:'A thermostat uses feedback: measure → compare with target → respond → measure again. Thermal technologies developed to solve practical human needs.', emphasis:'Cooling systems move thermal energy out; they do not “make cold.” Keep historical coverage brief and purposeful.', collect:'Quick feedback-loop explanation — formative.', cut:'Use one historical example only; protect the feedback-loop idea.' },
  { day:14, mission:'Mission 4 — Control the Habitat', title:'Habitat Control Loop Challenge', route:'mission-4/#investigate', prep:'Print/project temperature sequence and response cards; prepare energy-unit legend.', materials:'Printed/projected temperature readings; response cards; pencils. No electronics required.', student:'Use 18–22°C simulation target → choose heater/cooling/shade/vent/hold responses → create simple if/then control rules.', science:'Control systems respond to measurements and can use passive or active actions. Active heating/cooling uses more energy in the simplified model.', emphasis:'The next temperature is supplied by the model; students are learning control logic, not predicting HVAC performance.', collect:'Control-loop decisions/rules — formative.', cut:'Run fewer rounds, but keep at least one too-cold, safe-range and too-warm case.' },
  { day:15, mission:'Mission 4 — Control the Habitat', title:'Passive, Active and Thermal Sources', route:'mission-4/#learn', prep:'Prepare Passive vs Active Solar comparison and Thermal Source Board.', materials:'Devices/projector; source cards/images; Habitat Control Protocol draft.', student:'Passive vs active solar → solar/combustion/geothermal/biological source examples → safety → read three continent control clues.', science:'Thermal systems can generate, move, remove and control energy; sources and technologies have benefits, limits and safety considerations.', emphasis:'Do not imply every source exists on every continent. A source must be verified before it becomes a real JCEC option.', collect:'One useful passive strategy + one active backup idea — formative.', cut:'Keep passive/active solar distinction and one source comparison; move extra examples to optional discussion.' },
  { day:16, mission:'Mission 4 — Control the Habitat', title:'Write the Habitat Control Protocol', route:'mission-4/#record', prep:'Prepare protocol template; confirm continent clues remain visible.', materials:'Control-loop evidence; continent clues; Habitat Control Protocol.', student:'Choose priority control approach → target range → passive first → heating rule → cooling/ventilation rule → safety rule → reflection.', science:'A good protocol uses measured conditions, passive controls first where useful, active backup when needed, and explicit safety limits.', emphasis:'Mission 4 is formative. Do not turn the protocol into a second major assessment after Mission 3.', collect:'Habitat Control Protocol — formative.', cut:'Use sentence starters; keep the target, two response rules and safety rule.' },

  { day:18, mission:'Mission 5 — Survive Without Wasting It', title:'When a Working System Is Still a Bad Choice', route:'mission-5/', prep:'Print/cache the two Thermal Technology Briefing source cards; prepare energy-source comparison board and continent budget files.', materials:'Printed/projected source cards; devices optional; pencils; Thermal Energy Budget Challenge cards/tokens.', student:'Thermal-energy sources → energy use → conservation → sustainability/trade-offs → extract one useful fact from each source card.', science:'A thermal system must be effective, safe and sustainable. Energy sources differ in renewability, availability and environmental effects.', emphasis:'Use cached/printed source cards as the default evidence. Do not turn this into open internet research.', collect:'Two source facts — formative evidence for synthesis.', cut:'Teacher summarizes one source aloud and students extract one fact from the other.' },
  { day:19, mission:'Mission 5 — Survive Without Wasting It', title:'Thermal Energy Budget Challenge', route:'mission-5/#investigate', prep:'Set out each continent scenario, budget, four rounds, options and restriction.', materials:'Printed/projected scenario; paper energy tokens or simple tally sheet; pencils. No thermal equipment required.', student:'Plan passive/active responses across four rounds while staying within relative energy budget and environmental restriction.', science:'Conservation reduces unnecessary energy use while maintaining safety. Passive strategies can lower active demand.', emphasis:'JCEC energy units are relative comparison units, not watts or kWh.', collect:'Initial budget plan — synthesis evidence in progress.', cut:'Use three rounds instead of four; preserve at least one active-energy trade-off.' },
  { day:20, mission:'Mission 5 — Survive Without Wasting It', title:'The Consequence + Evidence Locker', route:'mission-5/#investigate', prep:'Prepare consequence reveal and Thermal Evidence Locker reminders from Missions 1–4.', materials:'Budget plan; consequence card; Evidence Locker; earlier Team Records only if clarification is needed.', student:'Reveal consequence → revise exactly one part → open Evidence Locker → choose three strongest pieces of evidence.', science:'Robust systems adapt to new conditions; final decisions should draw on temperature, transfer, barrier and control evidence.', emphasis:'Evidence Locker first. Do not send students back through four mission pages unless they need to verify a detail.', collect:'One justified revision + three selected evidence pieces.', cut:'Teacher preselects four evidence reminders; students choose three and explain why.' },
  { day:21, mission:'Mission 5 — Survive Without Wasting It', title:'JCEC Thermal Survival Decision', route:'mission-5/#record', prep:'Prepare one-page Thermal Survival Plan and concise scoring guide.', materials:'Evidence Locker; budget revision; JCEC Thermal Survival Plan; pencil/device.', student:'Authorize heating-dominant / cooling-dominant / adaptive / seasonal-limited occupation → complete one-page plan → 3–5 sentence why → reflection.', science:'Final thermal decisions balance safety, transfer control, energy use, source choice, conservation and ecological safeguards.', emphasis:'Assess science understanding → evidence use → thermal reasoning → sustainable practical decision. Visual polish carries little/no weight.', collect:'JCEC Thermal Survival Plan — major synthesis; individual reflection.', cut:'Use Flex Day 22 for essential completion. Cut gallery walk before core reasoning.' }
];

const flexDays = [
  { day:7, title:'Station spillover + equipment reset', use:'Heat Pathway station spillover, thermometer rotation, absence recovery, conduction/convection/radiation reteach.', priority:'Protect clear evidence for all three heat-transfer pathways.' },
  { day:12, title:'Mission 3 checkpoint recovery', use:'Fair-test rerun if needed, graph completion, noisy-data discussion, Thermal Barrier Recommendation completion.', priority:'Protect the stronger science-reasoning checkpoint.' },
  { day:17, title:'Heat & Temperature review / individual check', use:'Targeted reteach, vocabulary misconceptions, optional short individual science check before final synthesis.', priority:'Clarify science without adding new content.' },
  { day:22, title:'Thermal Survival Plan completion', use:'Finish Mission 5 plan; recover missing evidence; teacher conferences.', priority:'Essential synthesis completion before enrichment.' },
  { day:23, title:'Absence recovery / short individual assessment', use:'Make up missed investigation reasoning or run the optional individual science check.', priority:'Individual evidence, not Jabberwocky trivia.' },
  { day:24, title:'Optional gallery walk / continent comparison', use:'Compare why different continents justify different thermal systems; short peer questions.', priority:'Optional—cut before core learning.' },
  { day:25, title:'Final buffer / feedback / transition', use:'Normal school interruptions, final feedback, reteach, make-up or transition planning.', priority:'No Phase 4 student content.' }
];

const materials = [
  { mission:'Mission 1', title:'Thermal Change Investigation + thermometer practice', preferred:'4–6 shared thermometers; reused cups/containers; room/cool/warm water; ice; bottle + balloon/flexible cover; towels.', fallback:'Rotate teams through 1–2 thermometers and use supplied temperature/expansion evidence cards for stations you cannot run.', specialty:'Digital probes or dedicated expansion apparatus are optional enrichment only.' },
  { mission:'Mission 2', title:'Heat Pathway Stations', preferred:'Warm water; common metal/plastic/wood utensils; optional food colouring; dark/light paper; shared thermometers; sunlight or existing lamp if useful.', fallback:'Teacher demonstration plus the station observation/data cards for conduction, convection and radiation.', specialty:'Infrared cameras, thermal imaging and commercial heat-transfer kits are not required.' },
  { mission:'Mission 3', title:'Thermal Barrier Fair Test', preferred:'Matched reused cups; shared thermometers; warm water; equal-size paper/cardboard/fabric/foil or other existing barrier samples; timer.', fallback:'Use one teacher-run shared station and/or the JCEC backup dataset; students still graph, analyze and recommend.', specialty:'Data loggers and commercial insulation kits are optional only.' },
  { mission:'Mission 4', title:'Habitat Control Loop Challenge', preferred:'Printed/projected temperature sequence, response cards and pencils.', fallback:'Project the entire challenge and have teams record responses on notebook paper.', specialty:'Physical thermostats, bimetal strips or electronics are optional demonstrations only.' },
  { mission:'Mission 5', title:'Thermal Technology Briefing + Budget Challenge + final plan', preferred:'Printed/cached source cards; printed/projected continent scenarios; paper tokens/tally sheet; Thermal Evidence Locker; Thermal Survival Plan.', fallback:'Project one copy of all materials and use notebook paper for team decisions.', specialty:'No specialty equipment is needed.' }
];

const contingencies = [
  ['Limited thermometers','Use 4–6 as shared station tools rather than one/team. If only 1–2 are available, run a teacher station and supply the remaining data.'],
  ['Missing station materials','Replace the missing physical station with its observation/data card. Preserve the reasoning question, not the apparatus.'],
  ['Convection demonstration fails','Use the prepared liquid-convection evidence card and the small air-as-fluid visual. Do not spend another period rebuilding the demo.'],
  ['Radiation station shows little difference','Use the supplied sample dataset. Classroom lamps/weather are variable; weak results are not a reason to buy stronger equipment.'],
  ['Fair-test data is noisy or contradictory','Keep the data. Ask students to identify possible uncontrolled variables, compare with the backup/class dataset and state uncertainty in the recommendation.'],
  ['Student absent during an investigation','Give the class dataset/evidence card plus the same reasoning prompts. Students do not need to physically repeat every setup.'],
  ['A class is lost','Use the nearest flex period; compress whole-class sharing and optional demonstrations before cutting the decision/record.'],
  ['Control Loop Challenge runs long','Reduce the number of simulated readings while keeping one too-cold, one safe-range and one too-warm condition.'],
  ['Thermal Energy Budget Challenge runs long','Run three rounds instead of four, reveal the consequence, require one revision, then move to the Evidence Locker.'],
  ['Source websites are unavailable','Use the printed/cached NRCan source cards already built into Mission 5. Students only need the curated evidence, not live browsing.']
];

const curriculum = [
  ['Temperature measurement + thermometers','M1 thermometer practice and Thermal Change Investigation'],
  ['Heat vs temperature + particle model','M1 visible science and reflection'],
  ['Expansion / contraction + changes of state','M1 matter-responds evidence'],
  ['Conduction / convection / radiation','M2 Heat Pathway Stations + Habitat Heat Map'],
  ['Conductivity / insulation','M3 Thermal Barrier Fair Test'],
  ['Fair testing / quantitative data / graphing / discrepancies','M3 checkpoint'],
  ['Passive + active solar','M4 passive/active comparison'],
  ['Thermal-energy sources','M4 source board + M5 source-choice board'],
  ['Thermometers / thermostats / feedback','M1 measurement + M4 Control Loop Challenge'],
  ['Heating / cooling systems','M4 generate-transfer-remove-control model'],
  ['Historical thermal technology','M4 Then → Now strip'],
  ['Safety','M1 warm-water handling + M4/M5 thermal-system safety'],
  ['Energy use + renewable/non-renewable considerations','M5 Thermal Technology Briefing and Energy Budget'],
  ['Conservation + environmental consequences','M5 budget, consequence and safeguard'],
  ['Evidence-based decisions','M3 checkpoint + M5 Thermal Survival Plan']
];
---

<BaseLayout title="Phase 3 Teacher Launch Guide | Jabberwocky 2190" description="Teacher-facing implementation guide for Phase 3 — Surviving Jabberwocky." themeColor="#081722">
  <main class="guide-shell">
    <Breadcrumbs items={[
      { label:'Home', href:base },
      { label:'Grade 7 Science', href:`${base}courses/grade-7-science/` },
      { label:'Jabberwocky', href:`${base}courses/grade-7-science/jabberwocky/` },
      { label:'Phase 3', href:phase3() },
      { label:'Teacher Launch Guide' }
    ]} />

    <header class="hero">
      <p class="eyebrow">TEACHER SYSTEM // PHASE 3</p>
      <h1>Surviving <span>Jabberwocky</span></h1>
      <p class="lead">Five missions · 18 core classes · 7 purposeful flex periods. This guide matches the live student experience and keeps Heat & Temperature practical, low-material and evidence-driven.</p>
      <div class="hero-links"><a href={phase3()}>Open student hub →</a><a href="#pacing">Jump to pacing ↓</a></div>
    </header>

    <section class="rule"><strong>LOW-MATERIAL RULE</strong><span>ordinary classroom supplies → shared/reused equipment → printables/data fallbacks → specialty equipment only as optional enrichment</span></section>

    <section class="panel" id="materials">
      <div class="section-heading"><p class="eyebrow">PREP ONCE</p><h2>Mission Materials Master List</h2></div>
      <div class="materials-grid">
        {materials.map(item => <article><small>{item.mission}</small><h3>{item.title}</h3><p><b>Preferred:</b> {item.preferred}</p><p><b>No-purchase fallback:</b> {item.fallback}</p><p class="optional"><b>Specialty:</b> {item.specialty}</p></article>)}
      </div>
      <aside class="thermometer-plan">
        <h3>🌡️ Thermometer-sharing plan</h3>
        <p><strong>You do not need one thermometer per team.</strong> A practical target is <strong>4–6 shared thermometers</strong> for the class. Put them at rotating stations, stagger measurements, and have teams share pooled data. With only 1–2 thermometers, run a teacher measurement station and supply the remaining readings. Missions 4–5 need no thermometers.</p>
      </aside>
    </section>

    <section class="panel" id="pacing">
      <div class="section-heading"><p class="eyebrow">18 CORE CLASSES</p><h2>Day-by-day launch plan</h2><p>Every core class uses the same seven planning fields.</p></div>
      <div class="days">
        {coreDays.map(day => <details class="day-card"><summary><span>DAY {day.day}</span><div><small>{day.mission}</small><strong>{day.title}</strong></div><a href={phase3(day.route)} onClick={(e) => e.stopPropagation()}>Student page ↗</a></summary><div class="day-grid">
          <article><b>BEFORE CLASS</b><p>{day.prep}</p></article>
          <article><b>MATERIALS</b><p>{day.materials}</p></article>
          <article><b>STUDENTS SEE / DO</b><p>{day.student}</p></article>
          <article><b>KEY SCIENCE</b><p>{day.science}</p></article>
          <article><b>TEACHER EMPHASIS</b><p>{day.emphasis}</p></article>
          <article><b>COLLECT / ASSESS</b><p>{day.collect}</p></article>
          <article><b>IF TIME RUNS OUT</b><p>{day.cut}</p></article>
        </div></details>)}
      </div>
    </section>

    <section class="panel">
      <div class="section-heading"><p class="eyebrow">7 PURPOSEFUL FLEX PERIODS</p><h2>Buffers that protect the science</h2></div>
      <div class="flex-grid">{flexDays.map(f => <article><span>DAY {f.day}</span><h3>{f.title}</h3><p>{f.use}</p><small>{f.priority}</small></article>)}</div>
    </section>

    <section class="panel">
      <div class="section-heading"><p class="eyebrow">ASSESSMENT LOAD</p><h2>Grade the reasoning, not every Team Record</h2></div>
      <div class="assessment-grid">
        <article><small>MISSIONS 1, 2 & 4</small><h3>FORMATIVE</h3><p>Thermal Risk Card, Habitat Heat Map and Habitat Control Protocol are feedback evidence. Do not turn them into major grades.</p></article>
        <article class="checkpoint"><small>MISSION 3</small><h3>SCIENCE-REASONING CHECKPOINT</h3><p>Thermal Barrier Recommendation: fair test, quantitative evidence, thermal explanation and limitation/uncertainty.</p></article>
        <article class="major"><small>MISSION 5</small><h3>MAJOR SYNTHESIS</h3><p>JCEC Thermal Survival Plan: science understanding, evidence use, thermal reasoning and sustainable practical decision.</p></article>
        <article><small>OPTIONAL</small><h3>INDIVIDUAL SCIENCE CHECK</h3><p>Short individual check on temperature/particles, heat transfer, insulation, feedback and energy choices. No Jabberwocky trivia.</p></article>
      </div>
      <p class="grading"><strong>Suggested balance if you need numeric weights:</strong> Mission 3 checkpoint <b>30%</b> · Mission 5 synthesis <b>55%</b> · optional individual science check <b>15%</b>. If you skip the individual check, use roughly <b>35% checkpoint / 65% synthesis</b>.</p>
    </section>

    <section class="panel">
      <div class="section-heading"><p class="eyebrow">CONTINGENCY PLAYBOOK</p><h2>Protect the reasoning when real classrooms get messy</h2></div>
      <div class="contingencies">{contingencies.map(([problem,response]) => <article><h3>{problem}</h3><p>{response}</p></article>)}</div>
    </section>

    <section class="panel">
      <div class="section-heading"><p class="eyebrow">ALBERTA GRADE 7</p><h2>Heat & Temperature alignment</h2><p>The teacher system uses the same existing Alberta Science 7–9 Program of Studies baseline as the approved Phase 3 blueprint.</p></div>
      <div class="curriculum-grid">{curriculum.map(([concept,evidence]) => <article><strong>{concept}</strong><span>→</span><p>{evidence}</p></article>)}</div>
      <div class="boundary"><strong>Keep outside the required pathway:</strong> advanced calorimetry, specific-heat calculations, gas laws, detailed refrigeration cycles and formal efficiency equations. <a href="https://education.alberta.ca/media/159716/sci7to9.pdf" target="_blank" rel="noreferrer">Official Alberta Science 7–9 Program of Studies ↗</a></div>
    </section>

    <section class="panel readiness">
      <div class="section-heading"><p class="eyebrow">FINAL LAUNCH-READINESS AUDIT</p><h2>Can I teach this tomorrow?</h2></div>
      <ul>
        <li><strong>Do I know what to prepare tomorrow?</strong> Yes — every core day begins with Before Class + Materials.</li>
        <li><strong>Do I know what students should finish each day?</strong> Yes — Collect / Assess identifies the day’s finish line.</li>
        <li><strong>Do I know when thermometers/shared equipment are needed?</strong> Yes — mainly Missions 1–3; Missions 4–5 are printable/projectable.</li>
        <li><strong>Can I run the unit if equipment is limited?</strong> Yes — shared-station and teacher-data fallbacks are built into every physical investigation.</li>
        <li><strong>Do I know what is formative, checkpoint and major assessment?</strong> Yes — M1/M2/M4 formative, M3 checkpoint, M5 major synthesis.</li>
        <li><strong>Can I recover if a class or investigation is disrupted?</strong> Yes — seven flex periods + specific contingency substitutions.</li>
        <li><strong>Do teacher and student systems match?</strong> Yes — the guide uses the live five-mission sequence, products, investigations and 3+3+4+4+4 pacing.</li>
      </ul>
      <div class="stop"><strong>STOP BEFORE PHASE 4</strong><span>Phase 3 teacher + student systems are complete. Do not release Phase 4 from this guide.</span></div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#061019}.guide-shell{max-width:1160px;margin:0 auto;padding:0 1rem 5rem;color:#eaf4fb}.eyebrow{margin:0;color:#ffb25f;font:850 .75rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em}.hero{margin:1rem 0;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid #35586f;border-radius:24px;background:radial-gradient(circle at 82% 18%,rgba(255,178,95,.14),transparent 28%),linear-gradient(145deg,#071722,#102b3b)}.hero h1{margin:.45rem 0;color:#fff;font-size:clamp(2.7rem,7vw,5rem);line-height:.92;letter-spacing:-.045em}.hero h1 span{color:#ffb25f}.lead{max-width:850px;color:#b8cbd7;font-size:1.04rem;line-height:1.6}.hero-links{display:flex;gap:.65rem;flex-wrap:wrap}.hero a,.day-card summary a{padding:.62rem .8rem;border-radius:9px;background:#ffb25f;color:#301c07!important;text-decoration:none;font-weight:900}.rule{display:flex;gap:1rem;align-items:center;margin:1rem 0;padding:1rem 1.1rem;border:1px solid #456f87;border-radius:14px;background:#0c2633}.rule strong{color:#ffbf7b;white-space:nowrap}.rule span{color:#bdd0da}.panel{margin:1.25rem 0;padding:1.2rem;border:1px solid #29485b;border-radius:18px;background:#091a24}.section-heading h2{margin:.25rem 0 .6rem;color:#fff;font-size:1.65rem}.section-heading>p:last-child{color:#9eb4c1}.materials-grid,.assessment-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.materials-grid article,.assessment-grid article,.contingencies article{padding:1rem;border:1px solid #304d5e;border-radius:12px;background:#07151e}.materials-grid small,.assessment-grid small{color:#ffb86d;font-weight:900}.materials-grid h3,.assessment-grid h3,.contingencies h3{margin:.25rem 0;color:#fff}.materials-grid p,.assessment-grid p,.contingencies p{margin:.45rem 0 0;color:#b9ccd6;line-height:1.5}.optional{color:#8199a7!important}.thermometer-plan{margin-top:.8rem;padding:1rem;border-left:4px solid #64c7e8;border-radius:0 12px 12px 0;background:#0d2936}.thermometer-plan h3{margin:0 0 .3rem;color:#fff}.therm