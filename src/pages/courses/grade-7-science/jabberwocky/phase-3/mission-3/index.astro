---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase3Progress from '../../../../../../components/JcecPhase3Progress.astro';
import { phase3ThermalSites } from '../../../../../../data/jabberwockyPhase3';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Mission 3: The Director Is Coming | Jabberwocky 2190" description="Phase 3 Mission 3: design, test, graph, redesign and retest a DIY thermos using conduction, convection, radiation and insulation evidence." themeColor="#081722">
  <div class="mission-shell" id="phase3-mission3">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 3', href: `${base}courses/grade-7-science/jabberwocky/phase-3/` },
      { label: 'Mission 3' }
    ]} />

    <JcecPhase3Progress active={3} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 3 // MISSION 3 OF 5</p>
        <h1>THE DIRECTOR <span>IS COMING</span></h1>
        <p class="subtitle">THE JCEC THERMOS CHALLENGE</p>
        <p class="question">How can we design a portable container that slows thermal-energy transfer?</p>
      </div>
      <aside>
        <span>STRONGER CHECKPOINT</span>
        <strong>Design → test → graph → explain → redesign → retest</strong>
        <small>4 classes × 45 minutes</small>
      </aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 3 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 JCEC Thermos Design Report + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>Mission 2 showed how thermal energy moves. Now you will deliberately slow that transfer.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 3 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing">
        <p><strong>JCEC PRIORITY MESSAGE:</strong> Director John is arriving to inspect your Thermal Survival Division. During the tour, his hot drink will cool unless your team can slow thermal-energy transfer. Design, test, improve and defend a portable DIY thermos. The goal is not the fanciest cup or the class “winner.” The strongest design is the one your team can explain with thermal science and temperature evidence.</p>
      </div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon"></span>
        <div><small>YOUR PHASE 3 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div>
        <div class="challenge-badge"><small>ESTABLISHED THERMAL CHALLENGE</small><b id="assignment-challenge"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden>
        <strong>Your Phase 3 posting is not saved on this device yet.</strong>
        <p>Return to the Phase 3 Hub and restore the continent your teacher assigned. Do not choose a new continent for this mission.</p>
        <a href={`${base}courses/grade-7-science/jabberwocky/phase-3/`}>Restore Phase 3 posting →</a>
      </div>

      <section class="design-brief">
        <p class="mini-label">JCEC DESIGN CONSTRAINTS</p>
        <div class="constraint-grid">
          <article><b>1</b><p>Use the same teacher-provided inner test cup/container as the other teams.</p></article>
          <article><b>2</b><p>Keep the finished thermos at or below <strong>20 cm maximum width/diameter</strong>.</p></article>
          <article><b>3</b><p>Make it easy for one person to carry.</p></article>
          <article><b>4</b><p>Do not use parts from a pre-existing insulated bottle or commercial thermos.</p></article>
          <article><b>5</b><p>Leave an accessible opening for a thermometer.</p></article>
          <article><b>6</b><p>Use teacher-approved ordinary/reused materials and the standard <strong>200 mL</strong> test volume.</p></article>
        </div>
      </section>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro"><strong>Mission 2 already taught the pathways.</strong> Mission 3 asks you to use them.</p>

      <div class="science-grid four">
        <article><span>🤝</span><strong>CONDUCTION · CONTACT</strong><p>Thermal energy transfers through direct particle interactions in materials. Where can energy conduct through the cup, lid or touching layers?</p></article>
        <article><span>↺</span><strong>CONVECTION · MOVING FLUID</strong><p>Moving liquids and gases can carry thermal energy. Where could warm air escape or cooler air replace it?</p></article>
        <article><span>☀️</span><strong>RADIATION · ACROSS SPACE</strong><p>Thermal energy can transfer by electromagnetic radiation. How might exposed or reflective surfaces change radiative transfer?</p></article>
        <article><span>🧤</span><strong>INSULATION · SLOW THE TRANSFER</strong><p>Insulation slows thermal-energy transfer. It does not create heat or “keep cold out.”</p></article>
      </div>

      <div class="misconception"><strong>KEY IDEA:</strong><span>A thermos does not make heat. It slows thermal-energy transfer from warmer water to cooler surroundings.</span></div>

      <section class="materials-depot">
        <p class="mini-label">JCEC MATERIALS DEPOT</p>
        <p>Choose only what your teacher has available. Possible materials include paper, cardstock, corrugated cardboard, newspaper, fabric scraps, felt, cotton, bubble wrap, clean foam packaging, aluminum foil, string, elastic bands and tape.</p>
        <div class="reasoning-strip"><strong>MATERIAL</strong><b>→</b><strong>HEAT-TRANSFER PROBLEM</strong><b>→</b><strong>WHY IT MIGHT HELP</strong></div>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–4</p><h2>Investigate</h2></div></div>
      <div class="cycle-strip"><span>PLAN</span><b>→</b><span>BUILD</span><b>→</b><span>TEST</span><b>→</b><span>GRAPH</span><b>→</b><span>EXPLAIN</span><b>→</b><span>REDESIGN</span><b>→</b><span>RETEST</span></div>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 1</small><h3>Plan + Build Prototype 1</h3></div><span>TEAM WORK</span></div>
        <p>Sketch a cross-section of your thermos. Label every major layer and write the thermal purpose beside it. Build only after the design is clear enough that another team could understand it.</p>
        <div class="plan-grid">
          <label><strong>LAYER / MATERIAL 1</strong><span>________________________</span><small>It is meant to reduce __________________ because __________________.</small></label>
          <label><strong>LAYER / MATERIAL 2</strong><span>________________________</span><small>It is meant to reduce __________________ because __________________.</small></label>
          <label><strong>TOP / OPENING STRATEGY</strong><span>________________________</span><small>How will you reduce transfer while keeping thermometer access?</small></label>
          <label><strong>LABELLED DESIGN SKETCH</strong><span class="sketch-space">Draw the cup + layers here.</span></label>
        </div>
      </section>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 2</small><h3>Prototype Test</h3></div><span>QUANTITATIVE EVIDENCE</span></div>
        <p>Every team follows the same core procedure so Prototype 1 and the Final Design can be compared fairly.</p>
        <ol class="procedure">
          <li>Your teacher provides <strong>200 mL of hot-but-not-boiling water</strong> in the standard inner cup. Students do not carry kettles.</li>
          <li>Measure and record the real starting temperature at <strong>0 minutes</strong>.</li>
          <li>Record temperature again at <strong>5, 10, 15, 20, 25 and 30 minutes</strong>.</li>
          <li>Keep the cup, water volume, time intervals, thermometer method and test location as similar as practical.</li>
          <li>During waiting time, annotate where conduction, convection and radiation may still be occurring.</li>
        </ol>
        <div class="safety-strip"><strong>HOT-WATER SAFETY</strong><span>Teacher controls heating/pouring. No boiling water. Keep cups on desks/trays, keep wet materials away from Chromebooks and report spills immediately.</span></div>

        <div class="data-table">
          <div class="head"><span>TIME (min)</span><span>0</span><span>5</span><span>10</span><span>15</span><span>20</span><span>25</span><span>30</span></div>
          <div><strong>PROTOTYPE 1 · °C</strong><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span></div>
          <div><strong>FINAL DESIGN · °C</strong><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span><span>___</span></div>
        </div>
      </section>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 3</small><h3>Graph → Diagnose → Redesign</h3></div><span>EVIDENCE FIRST</span></div>
        <div class="calculation"><strong>Temperature change = initial temperature − final temperature</strong><span>Prototype 1: ______ °C − ______ °C = ______ °C decrease</span></div>
        <div class="graph-card">
          <strong>TIME–TEMPERATURE GRAPH</strong>
          <p><b>x-axis:</b> Time (minutes) · <b>y-axis:</b> Temperature (°C). Plot the seven Prototype 1 readings. Your graph is evidence, not decoration.</p>
          <span>What does the shape of your graph show about cooling over time? __________________________________________</span>
        </div>
        <div class="diagnosis-grid">
          <article><strong>CONDUCTION</strong><p>Where might direct contact still transfer thermal energy?</p></article>
          <article><strong>CONVECTION</strong><p>Where might moving warm/cool air still transfer energy?</p></article>
          <article><strong>RADIATION</strong><p>Where might radiation still matter?</p></article>
          <article><strong>MAIN WEAKNESS</strong><p>What evidence suggests the most useful place to improve?</p></article>
        </div>
        <div class="redesign-card">
          <p class="mini-label">PROPOSE 2 → CHOOSE 1 OR 2</p>
          <p><strong>Possible change A:</strong> ________________________ <em>because it should reduce ______ transfer by ______.</em></p>
          <p><strong>Possible change B:</strong> ________________________ <em>because it should reduce ______ transfer by ______.</em></p>
          <p><strong>Chosen redesign:</strong> ________________________</p>
          <small>“Add more stuff” is not enough. Every change needs a heat-transfer reason.</small>
        </div>
      </section>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 4</small><h3>Final Test + Compare</h3></div><span>RETEST</span></div>
        <p>Repeat the same 0–30 minute test as closely as practical. Do not change the test duration, water volume, inner cup or measurement intervals just to improve the result.</p>
        <div class="comparison-table">
          <div class="head"><span>EVIDENCE</span><span>PROTOTYPE 1</span><span>FINAL DESIGN</span></div>
          <div><strong>Starting temperature</strong><span>_____ °C</span><span>_____ °C</span></div>
          <div><strong>30-minute temperature</strong><span>_____ °C</span><span>_____ °C</span></div>
          <div><strong>Total temperature decrease</strong><span>_____ °C</span><span>_____ °C</span></div>
          <div><strong>Main design feature</strong><span>____________</span><span>____________</span></div>
        </div>
        <div class="result-choice"><strong>DID OUR DESIGN IMPROVE?</strong><span>YES</span><span>PARTLY</span><span>NO</span><span>UNCLEAR</span></div>
        <p class="science-note">All four are legitimate scientific conclusions if your evidence supports them. A redesign that performs worse can still teach JCEC something important.</p>
      </section>

      <details class="fallback-evidence">
        <summary>No-purchase / limited-equipment fallback</summary>
        <div class="fallback-grid">
          <article><strong>LIMITED THERMOMETERS</strong><p>Use staggered starts or a teacher measurement station. Four to six shared thermometers are plenty; one thermometer can still support a teacher-run quantitative test.</p></article>
          <article><strong>NO USABLE THERMOMETERS</strong><p>Use the teacher-provided Prototype 1 and Final Design datasets. Students still graph, calculate temperature change, diagnose and evaluate the redesign.</p></article>
          <article><strong>NO BUILD MATERIALS</strong><p>Use Thermos Design Cards to assemble layers on paper, then analyze the matching test dataset.</p></article>
          <article><strong>ABSENT STUDENT</strong><p>Use the team/class dataset. Do not require a private repeat of the hot-water test.</p></article>
        </div>
      </details>

      <button type="button" class="small-button" id="print-phase3-mission3">Print / Save Mission 3 Thermos Design Report</button>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which thermal-design principles should JCEC carry forward from our thermos investigation?</h3>
        <p>Choose <strong>two</strong> principles. Transfer the science, not the exact craft material.</p>
        <div class="reasoning-frame">
          <div><strong>DESIGN CHOICE</strong><span>JCEC should use ______.</span></div>
          <div><strong>HEAT-TRANSFER PROCESS</strong><span>It helps reduce ______.</span></div>
          <div><strong>DATA</strong><span>Our evidence shows ______.</span></div>
          <div><strong>RECOMMENDATION</strong><span>Therefore ______ is worth carrying forward.</span></div>
        </div>
        <div class="continent-transfer" id="continent-transfer" hidden>
          <strong>CONNECT TO YOUR CONTINENT</strong>
          <p id="continent-transfer-text"></p>
          <small>Do not invent a new temperature, hazard or energy resource. Use only the thermal challenge already established for your continent.</small>
        </div>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> test + redesign</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one report</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="checkpoint-note"><strong>SCIENCE REASONING CHECKPOINT</strong><span>Your teacher is assessing thermal science, fair testing, quantitative evidence, graphing and evidence-based redesign—not decoration, expensive materials or which team kept water hottest.</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>JCEC Thermos Design Report</h3></div><span>ONE PER TEAM</span></div>
        <div class="report-grid">
          <label><strong>A · OUR DESIGN</strong><span>Labelled sketch + materials/layers + intended thermal purpose.</span></label>
          <label><strong>B · PROTOTYPE TEST</strong><span>Seven readings + temperature decrease + time–temperature graph.</span></label>
          <label><strong>C · THERMAL EXPLANATION</strong><span>How conduction, convection and radiation affected performance.</span></label>
          <label><strong>D · REDESIGN</strong><span>Weakness + two possible changes + chosen modification(s) + reason.</span></label>
          <label><strong>E · FINAL TEST</strong><span>Seven final readings + final temperature decrease + Prototype vs Final comparison.</span></label>
          <label><strong>F · JCEC RECOMMENDATION</strong><span>Two thermal-design principles worth carrying forward.</span></label>
          <label class="wide"><strong>G · ONE LIMITATION</strong><span>One condition or variable that makes your conclusion less certain.</span></label>
        </div>
      </div>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>Which part of your thermos design did the most to reduce thermal-energy transfer? Explain using conduction, convection and/or radiation and evidence from your test.</h3>
        <p>Everyone answers individually.</p>
      </div>

      <div class="finished-box">
        <strong>Mission 3 is complete when:</strong>
        <p>your team has one JCEC Thermos Design Report and you have completed your individual reflection.</p>
        <span>NEXT: scale the same thermal thinking up from a mug to an entire habitat.</span>
      </div>
    </section>

    <section class="class-plan">
      <p class="mini-label">4 × 45-MINUTE CLASSES</p>
      <div class="class-grid">
        <article><b>1</b><strong>Design for Heat Retention</strong><p>Mission briefing → transfer pathways → materials reasoning → labelled design → build.</p></article>
        <article><b>2</b><strong>Prototype Test</strong><p>Run the standardized 200 mL test and collect 0–30 minute temperature evidence.</p></article>
        <article><b>3</b><strong>Evidence → Redesign</strong><p>Calculate temperature change → graph → diagnose → propose two changes → redesign.</p></article>
        <article><b>4</b><strong>Final Test + JCEC Decision</strong><p>Retest → compare Prototype vs Final → choose two design principles → Team Record + reflection.</p></article>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase3ThermalSites }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase3-posting';
      const saved = localStorage.getItem(POSTING_KEY);
      const site = siteData.find((item) => item.id === saved);
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const transfer = document.getElementById('continent-transfer');
      if (!site) {
        missing.hidden = false;
      } else {
        assignment.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-subtitle').textContent = site.subtitle;
        document.getElementById('assignment-challenge').textContent = site.thermalChallenge;
        transfer.hidden = false;
        document.getElementById('continent-transfer-text').textContent = `Your established ${site.name} challenge is: ${site.thermalChallenge} Which thermos design principle could help JCEC manage that challenge at habitat scale?`;
      }
      document.getElementById('print-phase3-mission3')?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

