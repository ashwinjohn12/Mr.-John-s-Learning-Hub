---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecPhase3Progress from '../../../../../../components/JcecPhase3Progress.astro';
import { phase3ThermalSites } from '../../../../../../data/jabberwockyPhase3';

const base = import.meta.env.BASE_URL;

const mission5Cases = {
  gyre: {
    budget: 16,
    scenario: 'A cold alpine habitat must stay usable through a four-round cold spell without expanding onto fragile slopes.',
    rounds: ['Cold morning', 'Sunny midday', 'Wind exposure increases', 'Cold evening'],
    consequence: 'A longer cold period arrives than expected. JCEC reduces your remaining energy allowance by 3 units. Revise one part of your plan.',
    safeguard: 'Keep erosion-prone slopes and important valley habitat undisturbed.'
  },
  brillig: {
    budget: 12,
    scenario: 'A warm, humid rainforest habitat must remain safe while minimizing active cooling and avoiding new forest clearing.',
    rounds: ['Warm humid morning', 'Canopy shade shifts', 'Afternoon heat builds', 'Warm evening'],
    consequence: 'A hotter-than-expected period lasts longer than planned. Revise one part of your control strategy without clearing more canopy.',
    safeguard: 'Use existing clearings and protect rainforest canopy, soil and habitat connections.'
  },
  manxome: {
    budget: 13,
    scenario: 'A mild island habitat must stay stable through changing cloud, wind and storm-season exposure.',
    rounds: ['Mild morning', 'Cloud cover changes', 'Wind increases', 'Storm conditions approach'],
    consequence: 'Storm conditions make passive ventilation unreliable for one round. Revise one part of your plan without inventing a new power-grid failure.',
    safeguard: 'Protect freshwater catchments and sensitive coastal connections.'
  },
  'slithy-toves': {
    budget: 14,
    scenario: 'A desert habitat must handle very hot days and cold nights while using as little active energy and fresh water as practical.',
    rounds: ['Hot morning', 'Peak daytime heat', 'Rapid evening cooling', 'Cold night'],
    consequence: 'Fresh-water availability drops. Any water-intensive cooling option must be removed. Revise one part of your plan.',
    safeguard: 'Do not solve the thermal problem by consuming large amounts of scarce fresh water.'
  },
  wabe: {
    budget: 18,
    scenario: 'An Arctic habitat must stay safe through prolonged cold and storms while protecting slow-recovering vegetation.',
    rounds: ['Cold morning', 'Brief sunlight', 'Storm exposure', 'Long cold night'],
    consequence: 'The cold period lasts longer than forecast. JCEC reduces your remaining energy allowance by 4 units. Revise one part of your plan.',
    safeguard: 'Keep slow-recovering natural plant mats protected from repeated disturbance.'
  },
  bandersnatch: {
    budget: 15,
    scenario: 'A prairie habitat must be ready for both winter heating and summer cooling without expanding the development footprint.',
    rounds: ['Cold-season start', 'Milder transition', 'Warm-season heat', 'Cool evening'],
    consequence: 'A sharp seasonal shift arrives earlier than expected. Your plan must now handle the opposite thermal need without adding a second full system.',
    safeguard: 'Keep native prairie connections and soil protection in the development plan.'
  },
  gimble: {
    budget: 17,
    scenario: 'A forest habitat must survive severe winter cold while remaining practical in warmer summer conditions.',
    rounds: ['Very cold morning', 'Solar gain available', 'Cold wind period', 'Mild-season test'],
    consequence: 'A longer cold snap increases heating demand. Revise one part of the plan without clearing more forest for solar exposure.',
    safeguard: 'Avoid extensive forest clearing or fragmentation for human infrastructure.'
  },
  mimsy: {
    budget: 12,
    scenario: 'A warm, humid wetland habitat must limit heat gain and remain comfortable without draining or heavily altering the wetland.',
    rounds: ['Warm morning', 'Direct sun period', 'Humid afternoon', 'Warm evening'],
    consequence: 'A hotter period raises cooling demand. Revise one part of your plan without draining the wetland or creating a larger footprint.',
    safeguard: 'Do not drain or heavily alter the wetland to make thermal control easier.'
  }
};

const sourceCards = [
  {
    label: 'AUTHENTIC SOURCE A · NATURAL RESOURCES CANADA',
    title: 'Insulation slows heat flow',
    fact: 'NRCan explains that insulation slows heat loss and that small pockets of still air can reduce heat transfer by conduction and convection.',
    url: 'https://natural-resources.canada.ca/energy-efficiency/home-energy-efficiency/keeping-heat-section-2-your-house-works'
  },
  {
    label: 'AUTHENTIC SOURCE B · NATURAL RESOURCES CANADA',
    title: 'Control choices can reduce energy use',
    fact: 'NRCan notes that thermostat setbacks can reduce heating energy use when a building does not need the same temperature all the time.',
    url: 'https://natural-resources.canada.ca/energy-efficiency/home-energy-efficiency/keeping-heat-section-9-operating-your-house-thermostats-water-heaters-furnaces-other-heatingcooling-systems'
  }
];
---

<BaseLayout title="Mission 5: Survive Without Wasting It | Jabberwocky 2190" description="Phase 3 Mission 5: use thermal evidence, an energy budget and sustainability trade-offs to authorize a thermal survival system." themeColor="#081722">
  <div class="mission-shell" id="phase3-mission5">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 3', href: `${base}courses/grade-7-science/jabberwocky/phase-3/` },
      { label: 'Mission 5' }
    ]} />

    <JcecPhase3Progress active={5} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">PHASE 3 // MISSION 5 OF 5</p>
        <h1>SURVIVE WITHOUT <span>WASTING IT</span></h1>
        <p class="question">How can humans maintain safe living conditions without wasting energy or damaging the environment?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How energy sources, conservation and environmental trade-offs change a thermal decision</strong>
        <small>4 classes × 45 minutes</small>
      </aside>
    </header>

    <section class="mission-at-a-glance">
      <div><small>WHERE AM I?</small><strong>Mission 5 of 5</strong></div>
      <div><small>WHAT DO I HAND IN?</small><strong>1 JCEC Thermal Survival Plan + 1 reflection</strong></div>
      <div><small>WHY DOES IT MATTER?</small><strong>A thermal system can work and still use too much energy or damage Jabberwocky.</strong></div>
    </section>

    <nav class="step-nav" aria-label="Mission 5 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing">
        <p>Your Thermal Survival team can now measure the problem, trace heat transfer, slow unwanted transfer and build a temperature-control rule. But JCEC has one final question before a habitat can be authorized: can the system stay safe without using more energy than necessary or creating unacceptable environmental damage? Use evidence from the whole phase, test a limited energy budget and authorize the safest realistic thermal survival system for your continent.</p>
      </div>

      <div class="assignment-result" id="assignment-result" hidden>
        <span id="assignment-icon"></span>
        <div><small>YOUR PHASE 3 CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-subtitle"></p></div>
        <div class="challenge-badge"><small>THERMAL CHALLENGE</small><b id="assignment-challenge"></b></div>
      </div>
      <div class="missing-assignment" id="missing-assignment" hidden>
        <strong>Your Phase 3 posting is not saved on this device yet.</strong>
        <p>Return to the Phase 3 Hub and choose the continent your teacher assigned. Do not create a new posting for Mission 5.</p>
        <a href={`${base}courses/grade-7-science/jabberwocky/phase-3/`}>Get Phase 3 posting →</a>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro"><strong>Final shift:</strong> do not ask only whether a thermal system works. Ask whether it can keep working responsibly.</p>

      <div class="science-grid four">
        <article><span>☀️</span><strong>THERMAL-ENERGY SOURCES</strong><p>Heating and cooling systems depend on energy sources. Sources differ in renewability, availability, safety and environmental effects.</p></article>
        <article><span>⚡</span><strong>ENERGY USE</strong><p>Active heating and cooling use energy. A system that needs active control constantly usually uses more energy than one that reduces the load first.</p></article>
        <article><span>🛟</span><strong>ENERGY CONSERVATION</strong><p>Conservation means avoiding unnecessary energy use while keeping conditions safe—for example, using passive design and sensible control rules first.</p></article>
        <article><span>⚖️</span><strong>SUSTAINABILITY / TRADE-OFFS</strong><p>A good choice balances human safety, energy demand, resource limits and protection of the environment.</p></article>
      </div>

      <section class="source-briefing">
        <div class="block-title"><div><small>2 AUTHENTIC SOURCE CARDS</small><h3>Thermal Technology Briefing</h3></div><span>5–10 MINUTES</span></div>
        <p>Read only the two short evidence cards. Record <strong>one useful fact from each</strong> that could affect a JCEC thermal decision. This is not an internet-research project.</p>
        <div class="source-grid">
          {sourceCards.map((source) => (
            <article>
              <small>{source.label}</small>
              <h4>{source.title}</h4>
              <p>{source.fact}</p>
              <a href={source.url} target="_blank" rel="noreferrer">Open official source ↗</a>
              <div><strong>Useful fact for JCEC:</strong><span>________________________________________</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="source-choice-board">
        <p class="mini-label">ENERGY-SOURCE CHOICE BOARD</p>
        <div class="choice-grid">
          <article><strong>SOLAR-DERIVED ENERGY</strong><p>Renewable when available, but collection depends on conditions and equipment.</p></article>
          <article><strong>COMBUSTION FUEL</strong><p>Controllable heat, but fuel is finite and combustion creates safety and environmental trade-offs.</p></article>
          <article><strong>GEOTHERMAL THERMAL ENERGY</strong><p>Can provide useful heating/cooling where suitable, but the local resource must be verified before JCEC can rely on it.</p></article>
          <article><strong>ELECTRIC HEATING / COOLING</strong><p>Electricity is an energy carrier. Its environmental impact depends on how the electricity is produced.</p></article>
        </div>
        <p class="source-note"><strong>Canon safeguard:</strong> these are comparison choices, not confirmed continent resources. Your team may recommend a source only with a condition such as “if JCEC verifies it is available here.”</p>
      </section>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–2</p><h2>Investigate</h2></div></div>

      <section class="investigation-block">
        <div class="block-title"><div><small>MAIN INVESTIGATION</small><h3>Thermal Energy Budget Challenge</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> Can your team keep a habitat operational while staying inside a limited energy budget and respecting the continent's environmental restriction?</p>

        <div class="system-cards">
          <article><strong>PASSIVE BARRIER / SHADE</strong><small>0 energy units per round</small><p>Use insulation, shade or another passive feature established in Missions 3–4.</p></article>
          <article><strong>ACTIVE HEATING</strong><small>3 energy units</small><p>Add thermal energy when conditions require it.</p></article>
          <article><strong>ACTIVE COOLING</strong><small>4 energy units</small><p>Move thermal energy out when conditions require it.</p></article>
          <article><strong>CONTROLLED VENTILATION</strong><small>0 energy units in this simplified model</small><p>Use only when outside conditions make ventilation useful and safe.</p></article>
          <article><strong>HOLD / MONITOR</strong><small>0 energy units</small><p>If conditions are already acceptable, do not spend energy just because a system exists.</p></article>
        </div>

        <div class="model-note"><strong>Model limit:</strong><span>JCEC energy units are relative comparison units, not real watts or kilowatt-hours. The goal is Grade 7 decision-making, not HVAC engineering calculations.</span></div>
        <div class="fallback-note"><strong>Low-material rule:</strong><span>The challenge uses printable cards/tokens or projected information and pencils. No thermal equipment or purchased supplies are required.</span></div>

        <div class="no-continent" id="no-continent"><strong>Phase 3 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-3/`}>Return to Phase 3 Hub →</a></div>
        <div id="budget-files" hidden>
          {phase3ThermalSites.map((site) => {
            const scenario = mission5Cases[site.id as keyof typeof mission5Cases];
            return (
              <article class="budget-file" data-budget-file={site.id} hidden>
                <header><span>{site.icon}</span><div><small>{site.name} · {site.subtitle}</small><h3>{scenario.scenario}</h3></div><b>{scenario.budget} ENERGY UNITS</b></header>
                <div class="round-grid">
                  {scenario.rounds.map((round, index) => <article><small>ROUND {index + 1}</small><strong>{round}</strong><p>Action: __________</p><p>Energy used: ____</p></article>)}
                </div>
                <div class="restriction"><small>ENVIRONMENTAL RESTRICTION</small><p>{scenario.safeguard}</p></div>
                <div class="consequence"><small>CONSEQUENCE REVEAL</small><p>{scenario.consequence}</p><strong>Revise exactly one part of your original plan.</strong></div>
              </article>
            );
          })}
        </div>

        <button type="button" class="small-button" id="print-phase3-mission5">Print Mission 5 Budget Challenge + Thermal Survival Plan</button>
      </section>

      <section class="evidence-locker">
        <div class="block-title"><div><small>CLASS 3</small><h3>Thermal Evidence Locker</h3></div><span>CHOOSE 3</span></div>
        <p>You do not need to reopen Missions 1–4. JCEC has surfaced one useful reminder from each mission. Choose the <strong>three strongest pieces</strong> for your final decision.</p>
        <div id="locker-files" hidden>
          {phase3ThermalSites.map((site) => (
            <article class="locker-file" data-locker-file={site.id} hidden>
              <label><input type="checkbox" /><span><small>M1 · TEMPERATURE</small><strong>{site.mission1Clues[0]}</strong></span></label>
              <label><input type="checkbox" /><span><small>M2 · TRANSFER</small><strong>{site.mission2Clues[0]}</strong></span></label>
              <label><input type="checkbox" /><span><small>M3 · BARRIER</small><strong>{site.mission3Clues[0]}</strong></span></label>
              <label><input type="checkbox" /><span><small>M4 · CONTROL</small><strong>{site.mission4Clues[0]}</strong></span></label>
            </article>
          ))}
        </div>
        <p class="locker-note">Your actual class data may be stronger than these reminders. If so, use your real result instead.</p>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASSES 3–4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE FINAL TEAM QUESTION</p>
        <h3>What thermal survival system should JCEC authorize for this continent?</h3>
        <div class="authorization-grid">
          <article><span>🔥</span><strong>HEATING-DOMINANT HABITAT</strong><p>Designed mainly to reduce heat loss and provide controlled heating.</p></article>
          <article><span>❄️</span><strong>COOLING-DOMINANT HABITAT</strong><p>Designed mainly to reduce heat gain and remove excess thermal energy.</p></article>
          <article><span>↔️</span><strong>ADAPTIVE HEATING-AND-COOLING HABITAT</strong><p>Designed to respond to different thermal needs across changing conditions.</p></article>
          <article><span>🗓️</span><strong>SEASONAL / LIMITED OCCUPATION</strong><p>Human occupation is limited when year-round thermal control would require too much energy or environmental disturbance.</p></article>
        </div>
        <p class="decision-note">No authorization is automatically correct for any continent. Your evidence must justify the choice.</p>
        <div class="reasoning-frame four">
          <div><strong>DECISION</strong><span>We recommend ______.</span></div>
          <div><strong>EVIDENCE</strong><span>Our three strongest pieces of evidence are ______, ______ and ______.</span></div>
          <div><strong>ENERGY CONSEQUENCE</strong><span>This choice affects energy use because ______.</span></div>
          <div><strong>ENVIRONMENTAL SAFEGUARD</strong><span>JCEC must ______ so that ______ is protected.</span></div>
        </div>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> decide</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one final plan</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="assessment-note"><strong>MAJOR PHASE 3 SYNTHESIS</strong><span>Your teacher is assessing science understanding, evidence use, thermal reasoning and a sustainable practical decision—not artistic polish.</span></div>

      <div class="team-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>JCEC Thermal Survival Plan</h3></div><span>ONE PAGE · ONE PER TEAM</span></div>
        <div class="plan-grid">
          <label><strong>THERMAL THREAT</strong><span>__________________________________</span></label>
          <label><strong>KEEP / REMOVE / BOTH</strong><span>__________________________________</span></label>
          <label><strong>PASSIVE DESIGN</strong><span>__________________________________</span></label>
          <label><strong>ACTIVE CONTROL</strong><span>__________________________________</span></label>
          <label><strong>ENERGY SOURCE</strong><span>__________________________________</span></label>
          <label><strong>3 PIECES OF EVIDENCE</strong><span>1. ________________________________<br/>2. ________________________________<br/>3. ________________________________</span></label>
          <label><strong>CONSERVATION RULE</strong><span>__________________________________</span></label>
          <label><strong>ECOLOGICAL SAFEGUARD</strong><span>__________________________________</span></label>
          <label><strong>FINAL AUTHORIZATION</strong><span>__________________________________</span></label>
          <label class="wide"><strong>WHY · 3–5 SENTENCES</strong><span>________________________________________________________________________<br/>________________________________________________________________________<br/>________________________________________________________________________</span></label>
        </div>
      </div>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>What is one thermal solution that would make human life easier but might be a poor long-term choice? What would you do instead?</h3>
        <p>Everyone answers individually. Use one science idea from this phase.</p>
      </div>

      <div class="finished-box">
        <strong>Phase 3 is finished when:</strong>
        <p>your team has one JCEC Thermal Survival Plan and you have completed your reflection.</p>
        <span>STOP HERE. Phase 4 has not been released.</span>
      </div>
    </section>

    <section class="class-plan">
      <p class="mini-label">4 × 45-MINUTE CLASSES</p>
      <div class="class-grid">
        <article><b>1</b><strong>Can a Working System Still Be a Bad Choice?</strong><p>Sources, energy use, conservation, sustainability and the two-source briefing.</p></article>
        <article><b>2</b><strong>Spend the Energy Budget</strong><p>Run the Thermal Energy Budget Challenge, reveal the consequence and make one revision.</p></article>
        <article><b>3</b><strong>Build the Authorization</strong><p>Open the Evidence Locker, choose three strong pieces and select a final authorization pattern.</p></article>
        <article><b>4</b><strong>JCEC Thermal Survival Decision</strong><p>Complete the one-page Thermal Survival Plan and individual reflection.</p></article>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ siteData: phase3ThermalSites }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase3-posting';
      const saved = localStorage.getItem(POSTING_KEY);
      const site = siteData.find((item) => item.id === saved);
      const assignment = document.getElementById('assignment-result');
      const missing = document.getElementById('missing-assignment');
      const budgetFiles = document.getElementById('budget-files');
      const lockerFiles = document.getElementById('locker-files');
      const noContinent = document.getElementById('no-continent');
      if (!site) {
        missing.hidden = false;
        noContinent.hidden = false;
      } else {
        assignment.hidden = false;
        document.getElementById('assignment-icon').textContent = site.icon;
        document.getElementById('assignment-name').textContent = site.name;
        document.getElementById('assignment-subtitle').textContent = site.subtitle;
        document.getElementById('assignment-challenge').textContent = site.thermalChallenge;
        budgetFiles.hidden = false;
        lockerFiles.hidden = false;
        noContinent.hidden = true;
        document.querySelectorAll('[data-budget-file]').forEach((node) => node.hidden = node.getAttribute('data-budget-file') !== site.id);
        document.querySelectorAll('[data-locker-file]').forEach((node) => node.hidden = node.getAttribute('data-locker-file') !== site.id);
      }

      const printButton = document.getElementById('print-phase3-mission5');
      printButton?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

<style>
