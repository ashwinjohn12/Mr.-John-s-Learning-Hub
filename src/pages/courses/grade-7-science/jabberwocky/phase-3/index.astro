---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import JcecPhase3Progress from '../../../../../components/JcecPhase3Progress.astro';
import { phase3ThermalSites } from '../../../../../data/jabberwockyPhase3';

const base = import.meta.env.BASE_URL;
const missions = [
  { number: 1, title: 'Read the Thermal Warning', question: 'What is temperature actually telling us?', summary: 'Measure temperature, use the particle model and identify the main thermal risk on your continent.', icon: '🌡️', status: 'COMPLETE' },
  { number: 2, title: 'Follow the Heat', question: 'How does thermal energy get from one place to another?', summary: 'Trace conduction, convection and radiation through a habitat.', icon: '↗️', status: 'COMPLETE' },
  { number: 3, title: 'The Director Is Coming', question: 'How can we design a portable container that slows thermal-energy transfer?', summary: 'Use thermal science to design, test, graph, redesign and retest a DIY thermos.', icon: '☕', status: 'COMPLETE' },
  { number: 4, title: 'Control the Habitat', question: 'How do humans keep temperatures within a useful range?', summary: 'Use feedback, passive controls and active systems to build a habitat control protocol.', icon: '🎛️', status: 'COMPLETE' },
  { number: 5, title: 'Survive Without Wasting It', question: 'How can humans maintain safe living conditions without wasting energy or damaging the environment?', summary: 'Use an energy budget and evidence from the whole phase to authorize a Thermal Survival Plan.', icon: '⚡', status: 'CURRENT' }
];
---

<BaseLayout title="Phase 3: Surviving Jabberwocky | Mission 2190" description="Phase 3 of Jabberwocky: Mission 2190 — Grade 7 Heat & Temperature." themeColor="#081722">
  <div class="phase3-shell" id="phase3-hub">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 3' }
    ]} />

    <header class="hero">
      <p class="eyebrow">MISSION 2190 // PHASE 3</p>
      <h1>SURVIVING <span>JABBERWOCKY</span></h1>
      <p class="division">JCEC THERMAL SURVIVAL DIVISION</p>
      <p class="lead">Measure the thermal problem → trace how energy moves → engineer against unwanted transfer → control the habitat → decide how to survive without wasting energy.</p>
    </header>

    <section class="big-question"><small>THE BIG QUESTION</small><h2>How can humans maintain safe living conditions without wasting energy or damaging Jabberwocky?</h2></section>
    <JcecPhase3Progress active={5} />

    <section class="posting-panel">
      <div><p class="eyebrow">YOUR PHASE 3 POSTING</p><h2>Keep the same Thermal Survival continent through Mission 5.</h2><p>Choose only the continent your teacher assigned if this device has not saved it yet.</p></div>
      <label><strong>Your Phase 3 continent</strong><select id="phase3-continent"><option value="">Choose your assigned continent…</option>{phase3ThermalSites.map((site)=><option value={site.id}>{site.icon} {site.name} — {site.subtitle}</option>)}</select><span id="save-message"></span></label>
    </section>

    <section class="briefing" id="previous-team" hidden>
      <header><div><p class="eyebrow">PREVIOUS TEAM THERMAL BRIEFING</p><h2>Four inherited limits still matter</h2></div><strong id="briefing-continent"></strong></header>
      <div class="briefing-grid">
        <article><small>ENVIRONMENT</small><p id="briefing-environment"></p></article>
        <article><small>RESOURCE</small><p id="briefing-resource"></p></article>
        <article><small>ECOSYSTEM WARNING</small><p id="briefing-warning"></p></article>
        <article><small>DEVELOPMENT RESTRICTION</small><p id="briefing-restriction"></p></article>
      </div>
    </section>

    <section class="mission-list">
      <div class="section-heading"><p class="eyebrow">PHASE 3 PATH</p><h2>Five missions. One survival problem.</h2></div>
      <div class="sequence"><span>Temperature ✓</span><b>→</b><span>Heat Transfer ✓</span><b>→</b><span>Thermal Design ✓</span><b>→</b><span>Habitat Control ✓</span><b>→</b><span class="current">Sustainable Survival ●</span></div>
      <div class="mission-cards">
        {missions.map((mission)=>(
          <article>
            <span class="icon">{mission.icon}</span>
            <div><small>MISSION {mission.number} · {mission.status}</small><h3>{mission.title}</h3><p><strong>{mission.question}</strong></p><p>{mission.summary}</p></div>
            <a href={`${base}courses/grade-7-science/jabberwocky/phase-3/mission-${mission.number}/`}>{mission.number === 5 ? 'Start' : 'Review'} Mission {mission.number} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="routine"><article><strong>TEAM WORK</strong><p>Investigate and make one decision together.</p></article><article><strong>TEAM RECORD</strong><p>One clear product captures the evidence that matters.</p></article><article><strong>MY REFLECTION</strong><p>Everyone answers one short science question.</p></article></section>
  </div>

  <script is:inline define:vars={{ siteData: phase3ThermalSites }}>
    (() => {
      const KEY = 'jabberwocky-phase3-posting';
      const sites = Object.fromEntries(siteData.map((site) => [site.id, site]));
      const select = document.getElementById('phase3-continent');
      const briefing = document.getElementById('previous-team');
      const message = document.getElementById('save-message');
      const show = (id, announce=false) => {
        const site = sites[id];
        if (!site) { briefing.hidden = true; message.textContent = ''; return; }
        localStorage.setItem(KEY, id);
        briefing.hidden = false;
        document.getElementById('briefing-continent').textContent = `${site.icon} ${site.name}`;
        document.getElementById('briefing-environment').textContent = site.previousTeamThermalBriefing.environment;
        document.getElementById('briefing-resource').textContent = site.previousTeamThermalBriefing.resource;
        document.getElementById('briefing-warning').textContent = site.previousTeamThermalBriefing.ecosystemWarning;
        document.getElementById('briefing-restriction').textContent = site.previousTeamThermalBriefing.developmentRestriction;
        message.textContent = announce ? `✓ ${site.name} saved for Phase 3 on this device.` : `Saved posting: ${site.name}`;
      };
      const saved = localStorage.getItem(KEY);
      if (saved && sites[saved]) { select.value = saved; show(saved); }
      select.addEventListener('change', () => show(select.value, true));
    })();
  </script>
</BaseLayout>

<style>
:global(body){background:#061019}.phase3-shell{max-width:1120px;margin:0 auto;padding:0 1rem 5rem;color:#eaf4fb}.phase3-shell :global(.breadcrumbs){color:#91a7b5}.phase3-shell :global(.breadcrumbs a){color:#dcecf5}.eyebrow{margin:0;color:#ffb25f;font:850 .75rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em}.hero{margin:1rem 0;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid #35586f;border-radius:24px;background:linear-gradient(145deg,#071722,#102b3b)}.hero h1{margin:.55rem 0 .35rem;color:#fff;font-size:clamp(3rem,8vw,5.6rem);line-height:.88}.hero h1 span{display:block;color:#ffb25f}.division{color:#ffd2a2;font-size:.75rem;font-weight:900}.lead{max-width:800px;color:#b8cbd7;line-height:1.6}.big-question,.posting-panel,.briefing,.mission-list{margin:1.2rem 0;padding:1.1rem;border:1px solid #29485b;border-radius:17px;background:#091a24}.big-question small,.briefing small,.mission-cards small{color:#ffb25f;font-size:.66rem;font-weight:900}.big-question h2,.posting-panel h2,.briefing h2,.section-heading h2{margin:.25rem 0;color:#fff}.posting-panel{display:grid;grid-template-columns:1.3fr .7fr;gap:1rem}.posting-panel p{color:#9fb4bf}.posting-panel label{display:grid;gap:.4rem;padding:.8rem;border-radius:10px;background:#071720}.posting-panel select{padding:.65rem;border:1px solid #49697b;border-radius:8px;background:#0d222e;color:#fff}.posting-panel label span{color:#ffc27e;font-size:.75rem}.briefing header{display:flex;justify-content:space-between;gap:1rem;align-items:end}.briefing header>strong{color:#fff}.briefing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}.briefing-grid article{padding:.75rem;border-radius:9px;background:#071720}.briefing-grid p{color:#bdd0da;font-size:.8rem;line-height:1.45}.sequence{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;margin:.6rem 0 1rem}.sequence span{padding:.35rem .55rem;border-radius:999px;background:#123040;color:#cde4f0;font-size:.75rem}.sequence .current{background:#4e3417;color:#ffd6a9}.mission-cards{display:grid;gap:.6rem}.mission-cards article{display:grid;grid-template-columns:45px 1fr auto;gap:.75rem;align-items:center;padding:.8rem;border:1px solid #315164;border-radius:11px;background:#071720}.icon{font-size:1.7rem}.mission-cards h3{margin:.15rem 0;color:#fff}.mission-cards p{margin:.25rem 0;color:#a8bdc8;font-size:.82rem}.mission-cards p strong{color:#dbeaf1}.mission-cards a{padding:.6rem .7rem;border-radius:8px;background:#ffb25f;color:#2d1906;text-decoration:none;font-size:.75rem;font-weight:900}.routine{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.routine article{padding:.8rem;border-radius:10px;background:#0d2633}.routine strong{color:#fff}.routine p{color:#9fb4bf;font-size:.8rem}@media(max-width:800px){.posting-panel{grid-template-columns:1fr}.briefing-grid{grid-template-columns:repeat(2,1fr)}.mission-cards article{grid-template-columns:40px 1fr}.mission-cards a{grid-column:1/-1;text-align:center}.routine{grid-template-columns:1fr}}@media(max-width:560px){.briefing-grid{grid-template-columns:1fr}}
</style>
