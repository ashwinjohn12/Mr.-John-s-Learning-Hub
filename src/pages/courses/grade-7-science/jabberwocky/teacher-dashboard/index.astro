---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const root = `${base}courses/grade-7-science/jabberwocky/`;
const phase = (n) => `${root}phase-${n}/`;
const phases = [
  {number:1,title:'FIRST CONTACT',unit:'Interactions & Ecosystems',missions:['Explore Your Environment','Meet a Native Species','Build the Ecosystem','Watch the Ecosystem Change','Humans Have Arrived'],core:'18 core classes',flex:'~7 purposeful flex classes',materials:'Shared thermometer(s); a few spoons/tweezers/tongs; yarn/string; printed grids + counters; printable Stowaway mat.',checkpoint:'Mission 4 · Ecosystem Change Record — formative / light checkpoint',synthesis:'Mission 5 · JCEC Recommendation Board — major synthesis',hub:phase(1),guide:`${phase(1)}teacher-launch-guide/`},
  {number:2,title:'THE LIVING RESOURCE',unit:'Plants for Food & Fibre',missions:['Find the Living Resource','Keep It Growing','Build the Growing Zone','Choose the Next Generation','Use It Without Losing It'],core:'18 core classes',flex:'~7 purposeful flex classes',materials:'Real plants / fast-growing seeds; reused containers; growing media; wick/string; paper planning models.',checkpoint:'Mission 3 · Growing System Recommendation — stronger reasoning checkpoint',synthesis:'Mission 5 · JCEC Living Resource Plan — major synthesis',hub:phase(2),guide:`${phase(2)}teacher-launch-guide/`},
  {number:3,title:'SURVIVING JABBERWOCKY',unit:'Heat & Temperature',missions:['Read the Thermal Warning','Follow the Heat','The Director Is Coming','Control the Habitat','Survive Without Wasting It'],core:'18 core classes',flex:'~7 purposeful flex classes',materials:'4–6 shared thermometers; standardized inner cups; recycled insulation materials; 200 mL measuring containers; trays/towels; simple transfer stations.',checkpoint:'Mission 3 · JCEC Thermos Design Report — stronger checkpoint',synthesis:'Mission 5 · JCEC Thermal Survival Plan — major synthesis',hub:phase(3),guide:`${phase(3)}teacher-launch-guide/`},
  {number:4,title:'PROJECT NEW HORIZON',unit:'Structures & Forces',missions:['Read the Building Site','Trace the Forces','Choose What Holds','Keep It Standing','Authorize New Horizon'],core:'18 core classes',flex:'~7 purposeful flex classes',materials:'Shared spring scales if available; paper/card/recycled plastic; tape + rulers; standardized paper/card stability models.',checkpoint:'Mission 3 · Material & Joint Recommendation — stronger checkpoint',synthesis:'Mission 5 · JCEC New Horizon Structural Authorization — major synthesis',hub:phase(4),guide:`${phase(4)}teacher-launch-guide/`},
  {number:5,title:'THE DEEP RECORD',unit:'Planet Earth',missions:['Read the Ground','Follow the Rock Story','Track the Changing Surface','Read the Deep Past','Prepare the Final Evidence'],core:'18 core classes',flex:'~7 purposeful flex classes',materials:'Shared hand lenses; optional rock/mineral samples or photo/property cards; shallow trays + sediment/water; supplied datasets.',checkpoint:'Mission 3 · Surface Change Forecast — stronger checkpoint',synthesis:'Mission 5 · JCEC Geological Evidence Packet — major synthesis',hub:phase(5),guide:`${phase(5)}teacher-launch-guide/`}
];
const purchases = [['1','6 hand lenses'],['2','6 shallow reusable trays'],['3','6 classroom thermometers'],['4','6 plastic measuring containers'],['5','3 spring scales']];
---

<BaseLayout title="Jabberwocky Teacher Master Launch Dashboard" description="Whole-year teacher launch dashboard for Jabberwocky: Mission 2190." themeColor="#071b2e">
  <div class="dashboard-shell" id="jcec-teacher-master-dashboard">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:root},{label:'Teacher Master Dashboard'}]} />
    <header class="hero"><p class="eyebrow">TEACHER CONTROL // WHOLE-YEAR RELEASE</p><h1>JABBERWOCKY <span>MASTER LAUNCH DASHBOARD</span></h1><p>One place to launch tomorrow's lesson, open a teacher guide, see material moments and identify checkpoint/major synthesis assessments.</p></header>

    <div class="quick-links"><a href={`${root}before-students-arrive/`}>Before Students Arrive →</a><a href={root}>Student Year-Long Launch →</a><a href={`${root}council/teacher-guide/`}>Teacher Council Guide →</a></div>

    <main class="phase-grid">
      {phases.map((item)=>(
        <section class="phase-card" id={`phase-${item.number}`}>
          <header><span>PHASE {item.number}</span><div><small>{item.unit}</small><h2>{item.title}</h2></div></header>
          <div class="pacing"><b>{item.core}</b><span>{item.flex}</span></div>
          <ol class="mission-list">{item.missions.map((mission,index)=><li><a href={`${item.hub}mission-${index+1}/`}><b>{index+1}</b>{mission}</a></li>)}</ol>
          <div class="info-grid"><article><small>MAJOR PHYSICAL-MATERIAL MOMENTS</small><p>{item.materials}</p></article><article><small>CHECKPOINT</small><p>{item.checkpoint}</p></article><article><small>MAJOR SYNTHESIS</small><p>{item.synthesis}</p></article></div>
          <div class="actions"><a href={item.hub}>Student Hub →</a><a class="teacher" href={item.guide}>Teacher Launch Guide →</a></div>
        </section>
      ))}
    </main>

    <section class="council-card"><p class="eyebrow">FINAL CAPSTONE</p><h2>MISSION 2190 COUNCIL</h2><p><strong>3 × 45-minute classes.</strong> Evidence Vault → Council Deliberation → Mission 2190 Directive. Essentially no-purchase.</p><div class="actions"><a href={`${root}council/`}>Student Council →</a><a class="teacher" href={`${root}council/teacher-guide/`}>Teacher Council Guide →</a></div></section>

    <section class="materials-card"><p class="eyebrow">WHOLE-YEAR MATERIALS AT A GLANCE</p><h2>Five highest-value purchases</h2><div class="purchase-list">{purchases.map(([rank,item])=><article><b>{rank}</b><strong>{item}</strong></article>)}</div><p><strong>Buy shared, not per team.</strong> All approved no-purchase / print-data fallbacks remain valid.</p></section>
  </div>
</BaseLayout>

<style>
:global(body){background:#06111f}.dashboard-shell{max-width:1180px;margin:0 auto;padding:0 1rem 5rem;color:#eaf5ff}.dashboard-shell :global(.breadcrumbs){color:#9cb5c4}.dashboard-shell :global(.breadcrumbs a){color:#d9edf6}.eyebrow{margin:0;color:#73e8ca;font:850 .73rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em}.hero,.phase-card,.council-card,.materials-card{margin:1rem 0;padding:1.1rem;border:1px solid #294e5f;border-radius:18px;background:#081b28}.hero{background:linear-gradient(145deg,#081827,#0b2939)}.hero h1{margin:.4rem 0;color:#fff;font-size:clamp(2.6rem,7vw,5rem)}.hero h1 span{display:block;color:#6ef2cf}.hero p:last-child{color:#bdd0db}.quick-links,.actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.quick-links a,.actions a{padding:.65rem .8rem;border-radius:8px;background:#123643;color:#dcecf3;text-decoration:none;font-weight:900}.actions .teacher{background:#6ef2cf;color:#06251c}.phase-grid{display:grid;gap:.8rem}.phase-card header{display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:center}.phase-card header>span{padding:.5rem;border-radius:9px;background:#12362f;color:#8ff0d5;font-weight:900}.phase-card small,.info-grid small{color:#75ddc6;font-size:.65rem;font-weight:900}.phase-card h2,.council-card h2,.materials-card h2{margin:.12rem 0;color:#fff}.pacing{display:flex;gap:.6rem;margin:.7rem 0;color:#bdd0db}.mission-list{display:grid;grid-template-columns:repeat(5,1fr);gap:.4rem;padding:0;list-style:none}.mission-list a{display:flex;gap:.4rem;height:100%;padding:.6rem;border:1px solid #31505e;border-radius:9px;background:#071720;color:#d6e7ee;text-decoration:none;font-size:.74rem;font-weight:800}.mission-list b{color:#8ff0d5}.info-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:.5rem}.info-grid article{padding:.7rem;border-radius:9px;background:#071720}.info-grid p{margin:.25rem 0;color:#a9c0ca;font-size:.8rem;line-height:1.45}.purchase-list{display:grid;grid-template-columns:repeat(5,1fr);gap:.45rem}.purchase-list article{display:flex;gap:.5rem;padding:.65rem;border-radius:8px;background:#071720}.purchase-list b{color:#73e8ca}.purchase-list strong{color:#fff;font-size:.8rem}.materials-card p{color:#bdd0db}@media(max-width:850px){.mission-list{grid-template-columns:repeat(2,1fr)}.info-grid{grid-template-columns:1fr}.purchase-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.mission-list,.purchase-list{grid-template-columns:1fr}.quick-links,.actions{display:grid}.quick-links a,.actions a{text-align:center}}
</style>
