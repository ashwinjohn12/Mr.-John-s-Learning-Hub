---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;
const roles = ['Lead Scientist','Evidence Recorder','Materials Manager','Data Analyst','Communicator'];
const logos = ['🚀','🧭','🌎','🔬','🛰️','🌿','⚡','🧪','🛡️','⭐'];
const continents = [
  ['gyre','Gyre'],['brillig','Brillig'],['manxome','Manxome'],['slithy-toves','Slithy Toves'],
  ['wabe','Wabe'],['bandersnatch','Bandersnatch'],['gimble','Gimble'],['mimsy','Mimsy']
];
---

<BaseLayout title="Join Existing Phase 1 Team | Jabberwocky 2190" description="Load an existing Phase 1 team onto another Chromebook using the same canonical Team ID." themeColor="#071b2e">
  <main class="recovery-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 1',href:`${base}courses/grade-7-science/jabberwocky/phase-1/`},{label:'Load / Join Existing Team'}]} />

    <section class="hero">
      <p class="eyebrow">SAME TEAM // ANOTHER CHROMEBOOK</p>
      <h1>Load / Join an existing Phase 1 team</h1>
      <p>Use the existing <strong>Team ID</strong> for your team. Every teammate may keep the same team profile on their own Chromebook, but the team should have only one Team ID.</p>
    </section>

    <section class="warning">
      <strong>Important</strong>
      <p>This connects this Chromebook to the same central team identity. It does <em>not</em> copy old mission work that only exists locally on another Chromebook. Work already sent to the teacher spreadsheet remains safe.</p>
    </section>

    <section class="join-code panel-lite">
      <h2>Fastest option: paste a Team Join Code</h2>
      <p>On a Chromebook that already has the correct team, choose <strong>Copy Team Join Code</strong>. Paste that code here to fill the team details automatically.</p>
      <textarea id="join-code" rows="4" placeholder="Paste the JCEC1:... Team Join Code here"></textarea>
      <button type="button" id="load-join-code" class="secondary">Load Team Join Code</button>
      <p id="join-code-status" role="status" aria-live="polite"></p>
    </section>

    <form id="recovery-form" class="panel">
      <label><span>Existing Team ID</span><input id="team-id" required maxlength="100" placeholder="Use the one canonical Team ID for this team" /></label>
      <label><span>Team name</span><input id="team-name" required maxlength="40" /></label>
      <label><span>Team logo</span><select id="team-logo" required><option value="">Choose the same logo…</option>{logos.map((logo) => <option value={logo}>{logo}</option>)}</select></label>
      <label><span>Mission statement</span><textarea id="mission-statement" required maxlength="180" rows="3"></textarea></label>
      <label><span>Assigned continent</span><select id="continent" required><option value="">Choose…</option>{continents.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>

      <fieldset>
        <legend>Team members and roles</legend>
        <p class="hint">Use first names only. Enter 3–5 members. These should match the existing team.</p>
        <div id="members"></div>
        <button type="button" id="add-member" class="secondary">+ Add member</button>
      </fieldset>

      <div class="actions">
        <button type="submit" class="primary">Load this team on this Chromebook</button>
        <a class="secondary link" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Cancel</a>
      </div>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </main>

  <script is:inline define:vars={{ roles, base }}>
    (() => {
      const TEAM_KEY = 'jabberwocky-phase1-team-profile';
      const POSTING_KEY = 'jabberwocky-phase1-posting';
      const form = document.getElementById('recovery-form');
      const members = document.getElementById('members');
      const addMember = document.getElementById('add-member');
      const status = document.getElementById('status');
      const joinCode = document.getElementById('join-code');
      const joinCodeStatus = document.getElementById('join-code-status');
      const loadJoinCode = document.getElementById('load-join-code');
      const validId = /^[A-Za-z0-9._:-]{8,100}$/;

      const escapeHtml = (value) => String(value || '').replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;');
      const addRow = (member = {}) => {
        if (members.children.length >= 5) return;
        const row = document.createElement('div');
        row.className = 'member-row';
        row.innerHTML = `
          <label><span>First name</span><input class="member-name" required maxlength="40" value="${escapeHtml(member.name)}" /></label>
          <label><span>Main role</span><select class="member-role" required><option value="">Choose role…</option>${roles.map((role) => `<option value="${role}" ${member.role === role ? 'selected' : ''}>${role}</option>`).join('')}</select></label>
          <button type="button" class="remove" aria-label="Remove member">×</button>`;
        row.querySelector('.remove').addEventListener('click', () => {
          if (members.children.length <= 3) {
            status.textContent = 'A team needs at least 3 members.';
            return;
          }
          row.remove();
        });
        members.appendChild(row);
      };

      const resetMembers = (items = [{},{},{}]) => {
        members.innerHTML = '';
        items.slice(0,5).forEach(addRow);
        while (members.children.length < 3) addRow();
      };

      resetMembers();
      addMember.addEventListener('click', () => {
        if (members.children.length >= 5) status.textContent = 'Teams can have up to 5 members.';
        else { addRow(); status.textContent = ''; }
      });

      const fillFromPayload = (payload) => {
        const team = payload?.team;
        if (!team || !validId.test(String(team.teamId || ''))) throw new Error('missing-team-id');
        document.getElementById('team-id').value = team.teamId;
        document.getElementById('team-name').value = team.teamName || '';
        document.getElementById('team-logo').value = team.logo || '';
        document.getElementById('mission-statement').value = team.missionStatement || '';
        document.getElementById('continent').value = payload.continent || '';
        resetMembers(Array.isArray(team.members) ? team.members : []);
      };

      loadJoinCode?.addEventListener('click', () => {
        const raw = joinCode.value.trim();
        if (!raw.startsWith('JCEC1:')) {
          joinCodeStatus.textContent = 'That does not look like a Phase 1 Team Join Code.';
          return;
        }
        try {
          const payload = JSON.parse(raw.slice(6));
          fillFromPayload(payload);
          joinCodeStatus.textContent = '✓ Team details loaded. Check them, then load the team on this Chromebook.';
        } catch {
          joinCodeStatus.textContent = 'The Team Join Code could not be read. Copy it again from a Chromebook that already has the correct team.';
        }
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const teamId = document.getElementById('team-id').value.trim();
        if (!validId.test(teamId)) {
          status.textContent = 'That Team ID is not valid. Copy the canonical Team ID again.';
          return;
        }
        const profile = {
          teamId,
          teamName: document.getElementById('team-name').value.trim(),
          logo: document.getElementById('team-logo').value,
          missionStatement: document.getElementById('mission-statement').value.trim(),
          members: [...members.querySelectorAll('.member-row')].map((row) => ({
            name: row.querySelector('.member-name').value.trim().split(/\s+/)[0],
            role: row.querySelector('.member-role').value
          })),
          updatedAt: new Date().toISOString()
        };
        if (!profile.teamName || !profile.logo || !profile.missionStatement || profile.members.length < 3 || profile.members.length > 5 || profile.members.some((m) => !m.name || !m.role)) {
          status.textContent = 'Complete the team details and all 3–5 member rows first.';
          return;
        }
        const continent = document.getElementById('continent').value;
        if (!continent) {
          status.textContent = 'Choose the team’s assigned continent before loading the team.';
          return;
        }
        localStorage.setItem(TEAM_KEY, JSON.stringify(profile));
        localStorage.setItem(POSTING_KEY, continent);
        status.innerHTML = `✓ This Chromebook now uses the same Team ID as the rest of the team. <a href="${base}courses/grade-7-science/jabberwocky/phase-1/">Return to Phase 1</a>.`;
      });
    })();
  </script>

  <style>
    .recovery-shell{max-width:900px;margin:0 auto;padding:1.2rem;color:#eaf5ff}.hero,.panel,.warning,.panel-lite{margin:1rem 0;padding:1.2rem;border:1px solid #365f6a;border-radius:16px;background:#081d29}.hero h1{margin:.25rem 0 .5rem;font-size:clamp(1.7rem,4vw,2.5rem)}.eyebrow{margin:0;color:#75e1c2;font:850 .75rem/1.2 ui-monospace,monospace;letter-spacing:.1em}.warning{border-color:#8a6a34;background:#2a2110}.warning p{margin:.35rem 0 0}.panel-lite h2{margin:.1rem 0 .35rem}.panel-lite p{color:#a9c0ca;line-height:1.5}.panel-lite textarea{width:100%;box-sizing:border-box;padding:.75rem;border:1px solid #456570;border-radius:9px;background:#06141d;color:#fff;font:inherit}.panel{display:grid;gap:1rem}.panel label{display:grid;gap:.35rem}.panel span,.panel legend{font-weight:850;color:#d9edf2}.panel input,.panel textarea,.panel select{width:100%;box-sizing:border-box;padding:.75rem;border:1px solid #456570;border-radius:9px;background:#06141d;color:#fff;font:inherit}.panel fieldset{border:1px solid #35515b;border-radius:12px;padding:1rem}.hint{margin:.2rem 0 .7rem;color:#9fb7c0}.member-row{display:grid;grid-template-columns:1fr 1fr auto;gap:.6rem;align-items:end;margin:.55rem 0}.remove{width:42px;height:42px;border:1px solid #71474a;border-radius:8px;background:#2c151a;color:#ffc9cc;font-size:1.2rem}.actions{display:flex;flex-wrap:wrap;gap:.7rem}.primary,.secondary{padding:.72rem .9rem;border-radius:9px;font-weight:900;cursor:pointer}.primary{border:0;background:#b6e779;color:#17320d}.secondary{border:1px solid #456b70;background:#0a2029;color:#d7edf2}.link{text-decoration:none;display:inline-flex;align-items:center}.panel #status,.panel-lite #join-code-status{min-height:1.4em;color:#9fd7c9}.panel #status a{color:#b6e779}@media(max-width:680px){.member-row{grid-template-columns:1fr}.remove{width:100%;height:auto;padding:.5rem}}
  </style>
</BaseLayout>
