---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import JcecMissionProgress from '../../../../../components/JcecMissionProgress.astro';
const base = import.meta.env.BASE_URL;

const missions = [
  { number: 1, title: 'Explore Your Environment', question: 'What is this place like?', summary: 'Investigate an Earth environment, then explore the conditions on your assigned continent.', icon: '🌎', status: 'COMPLETE', href: `${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`, ready: true, linkText: 'Review Mission 1 →' },
  { number: 2, title: 'Meet a Native Species', question: 'How does this organism survive here?', summary: 'Test how structures work, then use four clues to reconstruct your continent’s native species.', icon: '🔎', status: 'COMPLETE', href: `${base}courses/grade-7-science/jabberwocky/phase-1/mission-2/`, ready: true, linkText: 'Review Mission 2 →' },
  { number: 3, title: 'Build the Ecosystem', question: 'How are living things connected?', summary: 'Build a food web, test what happens when it changes, and trace simple water and carbon paths.', icon: '🕸️', status: 'COMPLETE', href: `${base}courses/grade-7-science/jabberwocky/phase-1/mission-3/`, ready: true, linkText: 'Review Mission 3 →' },
  { number: 4, title: 'Watch the Ecosystem Change', question: 'What happens when conditions change?', summary: 'Sample a population, read two simple datasets, and track how a disturbed habitat recovers.', icon: '🌱', status: 'COMPLETE', href: `${base}courses/grade-7-science/jabberwocky/phase-1/mission-4/`, ready: true, linkText: 'Review Mission 4 →' },
  { number: 5, title: 'Humans Have Arrived', question: 'How can people explore without causing too much harm?', summary: 'Investigate human-caused ecological problems and make your final Phase 1 recommendation.', icon: '🚨', status: 'COMPLETE', href: `${base}courses/grade-7-science/jabberwocky/phase-1/mission-5/`, ready: true, linkText: 'Review Mission 5 →' }
];
---

<BaseLayout title="Phase 1: First Contact | Jabberwocky 2190" description="The simplified five-mission student pathway for Grade 7 Science: Interactions & Ecosystems." themeColor="#071b2e">
  <div class="simple-phase-shell" id="simplified-phase1-hub">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1' }
    ]} />

    <header class="simple-hero">
      <div>
        <p class="eyebrow">MISSION 2190 // PHASE 1</p>
        <h1>FIRST <span>CONTACT</span></h1>
        <p class="lead">You are one of the first scientists studying life on Jabberwocky. Over five missions, your team learned how your continent works—and decided how humans should explore it.</p>
      </div>
      <aside>
        <span>PHASE STATUS</span>
        <strong>Complete</strong>
        <small>Your ecology evidence stays with the continent.</small>
      </aside>
    </header>

    <section class="big-question" aria-labelledby="phase-question">
      <span>THE BIG QUESTION</span>
      <h2 id="phase-question">How does life on Jabberwocky work—and what should humans do?</h2>
    </section>

    <JcecMissionProgress active={6} />

    <section class="quick-start phase2-next">
      <div>
        <p class="eyebrow">NEXT PHASE</p>
        <h2>Your evidence is about to change hands.</h2>
        <p>Join a new Botanical Resources team, receive a new continent posting, and investigate whether Jabberwocky's plants can become useful resources without damaging the ecosystems you just studied.</p>
      </div>
      <a class="primary-button" href={`${base}courses/grade-7-science/jabberwocky/phase-2/`}>Enter Phase 2 →</a>
    </section>

    <section class="how-it-works" aria-labelledby="work-heading">
      <div class="section-heading">
        <p class="eyebrow">SAME ROUTINE EVERY MISSION</p>
        <h2 id="work-heading">How mission work happened</h2>
      </div>
      <div class="work-grid">
        <article><span aria-hidden="true">👥</span><div><strong>TEAM WORK</strong><p>Work together on the investigation.</p></div></article>
        <article><span aria-hidden="true">📝</span><div><strong>TEAM RECORD</strong><p>One person records your team's answer.</p></div></article>
        <article><span aria-hidden="true">💭</span><div><strong>MY REFLECTION</strong><p>Everyone answers one short question.</p></div></article>
      </div>
    </section>

    <section class="mission-list" aria-labelledby="missions-heading">
      <div class="section-heading">
        <p class="eyebrow">PHASE 1 PATH</p>
        <h2 id="missions-heading">Five missions. One completed story.</h2>
      </div>
      <div class="mission-cards">
        {missions.map((mission) => (
          <article class:list={['mission-card', { ready: mission.ready }]}>
            <div class="mission-icon" aria-hidden="true">{mission.icon}</div>
            <div class="mission-main">
              <div class="mission-topline"><span>MISSION {mission.number}</span><b>{mission.status}</b></div>
              <h3>{mission.title}</h3>
              <p class="mission-question-text">{mission.question}</p>
              <p class="mission-summary">{mission.summary}</p>
            </div>
            <a href={mission.href}>{mission.linkText}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="story-note">
      <span aria-hidden="true">📁</span>
      <div>
        <strong>Your work follows the continent.</strong>
        <p>The next science team will inherit only the most useful findings from Phase 1. You do not need to move, rewrite or submit your archive again.</p>
      </div>
    </section>

    <div class="teacher-link"><a href={`${base}courses/grade-7-science/jabberwocky/phase-1/teacher-launch-guide/`}>Teacher planning guide →</a></div>
  </div>
</BaseLayout>

<style>
  :global(body){background:#06111f}.simple-phase-shell{max-width:1120px;margin:0 auto;padding:0 1rem 5rem;color:#eaf5ff}.simple-phase-shell :global(.breadcrumbs){color:#9eb6c4}.simple-phase-shell :global(.breadcrumbs a){color:#d7ecf5}.simple-phase-shell :global(.jcec-submission-dock),.simple-phase-shell~:global(.jcec-submission-dock),:global(body:has(#simplified-phase1-hub) .jcec-submission-dock),:global(body:has(#simplified-phase1-hub) .jcec-device-tools){display:none!important}.eyebrow{margin:0;color:#77e8ca;font:850 .75rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em}.simple-hero{display:grid;grid-template-columns:1fr 250px;gap:1.5rem;align-items:end;margin:1rem 0;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid #2c6070;border-radius:24px;background:radial-gradient(circle at 78% 18%,rgba(110,242,207,.15),transparent 27%),linear-gradient(145deg,#071727,#0a2939)}.simple-hero h1{margin:.55rem 0;color:#fff;font-size:clamp(3.1rem,8vw,6rem);line-height:.86;letter-spacing:-.055em}.simple-hero h1 span{color:#6ef2cf}.lead{max-width:720px;margin:.9rem 0 0;color:#bfd2dd;font-size:1.06rem;line-height:1.6}.simple-hero aside{display:grid;gap:.18rem;padding:1rem;border:1px solid #315b69;border-radius:14px;background:#071923}.simple-hero aside span{color:#7ecdbd;font-size:.72rem;font-weight:900;letter-spacing:.08em}.simple-hero aside strong{color:#fff;font-size:1.25rem}.simple-hero aside small{color:#95afbc}.big-question{margin:1rem 0;padding:1.2rem 1.3rem;border-left:4px solid #6ef2cf;border-radius:0 14px 14px 0;background:#0a202c}.big-question span{color:#74e9cb;font-size:.72rem;font-weight:900;letter-spacing:.08em}.big-question h2{margin:.35rem 0 0;color:#fff;font-size:clamp(1.4rem,3vw,2rem);line-height:1.25}.quick-start{display:flex;justify-content:space-between;gap:1.2rem;align-items:center;margin:1.2rem 0;padding:1.15rem 1.25rem;border:1px solid #3a786a;border-radius:16px;background:#0a292b}.phase2-next{border-color:#6f7f47;background:linear-gradient(120deg,#10291f,#1c3117)}.quick-start h2{margin:.25rem 0;color:#fff}.quick-start p:last-child{margin:.2rem 0 0;color:#a9c9c4}.primary-button{flex:0 0 auto;padding:.8rem 1rem;border-radius:10px;background:#b7e77d;color:#18320d!important;text-decoration:none;font-weight:900}.how-it-works,.mission-list{margin:1.4rem 0;padding:1.2rem;border:1px solid #244a5a;border-radius:18px;background:#081b28}.section-heading h2{margin:.3rem 0 .85rem;color:#fff;font-size:1.55rem}.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.work-grid article{display:flex;gap:.7rem;align-items:flex-start;padding:.85rem;border:1px solid #294a58;border-radius:12px;background:#071620}.work-grid article>span{font-size:1.3rem}.work-grid strong{color:#fff;font-size:.9rem}.work-grid p{margin:.22rem 0 0;color:#a9bfca;font-size:.84rem;line-height:1.45}.mission-cards{display:grid;gap:.65rem}.mission-card{display:grid;grid-template-columns:auto 1fr auto;gap:.9rem;align-items:center;padding:.9rem 1rem;border:1px solid #274655;border-radius:13px;background:#071620;opacity:.72}.mission-card.ready{border-color:#315d58;background:#08201e;opacity:.9}.mission-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;background:#12352f;font-size:1.45rem}.mission-main{min-width:0}.mission-topline{display:flex;gap:.5rem;align-items:center}.mission-topline span{color:#84a5b4;font-size:.68rem;font-weight:900;letter-spacing:.08em}.mission-topline b{padding:.2rem .4rem;border-radius:999px;background:#173d35;color:#9acfc0;font-size:.62rem}.mission-card h3{margin:.25rem 0;color:#fff;font-size:1.15rem}.mission-question-text{margin:.05rem 0;color:#c9dce4;font-weight:750}.mission-summary{margin:.28rem 0 0;color:#8fa8b5;font-size:.84rem;line-height:1.45}.mission-card>a{padding:.65rem .78rem;border-radius:9px;background:#173b36;color:#a9e5d4!important;text-decoration:none;font-size:.82rem;font-weight:900;white-space:nowrap}.story-note{display:flex;gap:.8rem;align-items:flex-start;margin:1.2rem 0;padding:1rem;border:1px solid #345160;border-radius:14px;background:#091a24}.story-note>span{font-size:1.35rem}.story-note strong{color:#fff}.story-note p{margin:.25rem 0 0;color:#a8bfca;line-height:1.5}.teacher-link{text-align:right;margin-top:1rem}.teacher-link a{color:#7898a8;font-size:.76rem;text-decoration:none}.teacher-link a:hover{color:#a9c7d3}
  @media(max-width:760px){.simple-hero{grid-template-columns:1fr}.work-grid{grid-template-columns:1fr}.quick-start{display:grid}.primary-button{width:100%;text-align:center}.mission-card{grid-template-columns:auto 1fr}.mission-card>a{grid-column:1/-1;text-align:center;width:100%}}
  @media(max-width:520px){.simple-phase-shell{padding-inline:.7rem}.simple-hero h1{font-size:3.4rem}.mission-icon{width:42px;height:42px}.mission-card{gap:.65rem;padding:.8rem}.mission-summary{display:none}}
</style>
