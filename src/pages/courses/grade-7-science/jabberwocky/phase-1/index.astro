---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;

const continents = [
  {
    id: 'gyre', name: 'Gyre', code: 'GY-2190', codename: 'Alpine Frontier', rating: 'Promising', ratingTone: 'yellow', baseCamp: 'Frumious Basin', icon: '⛰️',
    environment: 'Mountainous alpine continent',
    known: ['High plateaus and deep valleys', 'Valleys contain plentiful vegetation and drinking-water sources', 'Highest areas are colder, drier, and snow-covered year-round', 'Possible dangerous creatures have been detected in some valleys'],
    opportunities: ['Fresh water in valley systems', 'Protected valley locations', 'Varied habitats across different elevations'],
    risks: ['Steep terrain', 'Cold, dry high elevations', 'Altitude and year-round snow', 'Unknown large wildlife'],
    question: 'How are living things distributed across Gyre’s valleys and higher elevations?'
  },
  {
    id: 'brillig', name: 'Brillig', code: 'BR-2190', codename: 'Emerald Basin', rating: 'Very Promising', ratingTone: 'green', baseCamp: 'Tulgey Station', icon: '🌿',
    environment: 'Lush tropical rainforest',
    known: ['Warm, rainy, and humid conditions', 'Large rivers flow through the continent and sometimes flood', 'Early surveys show unusually high biodiversity', 'Removing vegetation can lead to rapid soil erosion'],
    opportunities: ['Abundant fresh water', 'Extensive plant life', 'High biodiversity for scientific study'],
    risks: ['Heavy rainfall and flooding', 'Rapid erosion after vegetation loss', 'Dense vegetation can make travel difficult'],
    question: 'How do Brillig’s rainfall, rivers, vegetation, and soil affect where organisms can live?'
  },
  {
    id: 'manxome', name: 'Manxome', code: 'MA-2190', codename: 'Vorpal Archipelago', rating: 'Promising', ratingTone: 'yellow', baseCamp: 'Calloo Island', icon: '🏝️',
    environment: 'Island archipelago in the Vorpal Ocean',
    known: ['Made up of many islands', 'Temperatures are usually mild and comfortable', 'A severe storm season occurs once each year', 'During the roughly two-month storm season, extreme winds make some shorelines uninhabitable'],
    opportunities: ['Mild temperatures for much of the year', 'Many islands and coastal environments to study', 'Access to ocean and freshwater environments'],
    risks: ['Extreme seasonal winds', 'Dangerous shorelines during storms', 'Travel between islands may be difficult'],
    question: 'How do native organisms survive a place that can be calm for months and dangerous during storm season?'
  },
  {
    id: 'slithy-toves', name: 'Slithy Toves', code: 'ST-2190', codename: 'Sunscar Desert', rating: 'Difficult', ratingTone: 'orange', baseCamp: 'Borogove Station', icon: '🏜️',
    environment: 'Hot, dry desert',
    known: ['Very dry, with few sources of fresh water', 'Daytime temperatures can reach about 40°C', 'Night temperatures can fall to about -5°C', 'Sandy terrain is hit by at least four major storms each year'],
    opportunities: ['Large amounts of sunlight', 'Open terrain for observation', 'Rare freshwater sites create clear research zones'],
    risks: ['Fresh-water scarcity', 'Large day-night temperature changes', 'Sand and major storms'],
    question: 'How can an ecosystem survive when water is so limited and temperatures change so quickly?'
  },
  {
    id: 'wabe', name: 'Wabe', code: 'WA-2190', codename: 'White Frontier', rating: 'Challenging', ratingTone: 'orange', baseCamp: 'Beamish Station', icon: '❄️',
    environment: 'Arctic environment',
    known: ['Cold conditions with extensive snow', 'Summers are short and cool', 'Violent snowstorms sometimes last up to five days', 'Whiteout conditions can make travel extremely dangerous'],
    opportunities: ['Large amounts of frozen fresh water', 'Open areas for environmental monitoring', 'Strong seasonal contrasts to investigate'],
    risks: ['Extreme cold', 'Long storms and whiteouts', 'Very short growing season'],
    question: 'What adaptations would living things need to survive Wabe’s long cold conditions?'
  },
  {
    id: 'bandersnatch', name: 'Bandersnatch', code: 'BA-2190', codename: 'Golden Plains', rating: 'Excellent', ratingTone: 'green', baseCamp: 'Jubjub Station', icon: '🌾',
    environment: 'Large open prairie',
    known: ['Wide grasslands similar to Saskatchewan', 'Winter temperatures can reach about -30°C', 'Summer temperatures can reach about +30°C', 'A long growing season has made JCEC interested in future agriculture'],
    opportunities: ['Long growing season', 'Large areas of relatively flat land', 'Strong potential for future food production'],
    risks: ['Large seasonal temperature range', 'Open exposure to wind and weather', 'Native prairie relationships are not yet understood'],
    question: 'What relationships connect Bandersnatch’s prairie organisms, water, soil, and seasonal conditions?'
  },
  {
    id: 'gimble', name: 'Gimble', code: 'GI-2190', codename: 'Greatwood', rating: 'Very Promising', ratingTone: 'green', baseCamp: 'Galumph Station', icon: '🌲',
    environment: 'Temperate forest',
    known: ['Extensive forests cover much of the continent', 'Winters can reach about -40°C', 'Summers average around +24°C', 'Winters are long and summers are comparatively short'],
    opportunities: ['Large forested areas', 'Freshwater lakes and rivers are visible in survey data', 'Temperate summer conditions'],
    risks: ['Very cold winters', 'Dense forest may make travel difficult', 'Short summers may limit some activities'],
    question: 'How are organisms distributed through Gimble’s forest, lakes, rivers, and seasonal habitats?'
  },
  {
    id: 'mimsy', name: 'Mimsy', code: 'MI-2190', codename: 'Endless Wetlands', rating: 'Poor', ratingTone: 'red', baseCamp: 'Mome Station', icon: '🪷',
    environment: 'Warm marsh and wetland',
    known: ['Much of the continent is marshy, wet, and muddy', 'Conditions are warm and humid all year', 'Soils are nutrient-poor', 'The landscape is similar to large wetland systems such as the Florida Everglades'],
    opportunities: ['Abundant water', 'Warm year-round conditions', 'Extensive wetland life to investigate'],
    risks: ['Wet, unstable ground', 'Nutrient-poor soil', 'High humidity and difficult overland travel'],
    question: 'How do Mimsy’s wetlands, water levels, soils, and warm climate shape the organisms that live there?'
  }
];
---

<BaseLayout title="Mission Phase 1: First Contact | Jabberwocky 2190" description="The active Jabberwocky Mission 2190 campaign space for Grade 7 Science: Interactions & Ecosystems." themeColor="#071b2e">
  <div class="phase-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Mission Phase 1' }
    ]} />

    <nav class="mission-nav" aria-label="Jabberwocky mission navigation">
      <a href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/#planet-scan`}>Continents</a>
      <a class="active" href="#phase-brief">Current Phase</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/#archives`}>Archives</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/#status-board`}>JCEC Status</a>
    </nav>

    <header class="phase-hero" id="phase-brief">
      <p class="system-label">MISSION PHASE 01 // CLEARANCE GRANTED</p>
      <div class="hero-grid">
        <div>
          <p class="division">JCEC ECOLOGICAL SURVEY DIVISION</p>
          <h1>FIRST<br /><span>CONTACT</span></h1>
          <p class="lead">You are among the first human scientists assigned to investigate how life on Jabberwocky survives, interacts, and responds to change.</p>
        </div>
        <aside>
          <span>ACTIVE ROLE</span><strong>Planetary Ecologist</strong>
          <dl>
            <div><dt>Mission status</dt><dd>ACTIVE</dd></div>
            <div><dt>Assignment</dt><dd id="hero-assignment">Not selected</dd></div>
            <div><dt>Archive access</dt><dd>Arrival data</dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <section class="mission-question">
      <p>YOUR MISSION QUESTION</p>
      <h2>How does life on Jabberwocky survive, interact, and respond to change—and what happens when humans enter that system?</h2>
    </section>

    <section class="assignment-terminal" id="mission-assignment" aria-labelledby="assignment-heading">
      <div class="terminal-heading">
        <div>
          <p class="system-label">OPERATION 01 // MISSION ASSIGNMENT</p>
          <h2 id="assignment-heading">Receive your continental posting.</h2>
          <p>Pathfinder personnel have been organized into Ecological Survey Teams. Your teacher will assign your team one continent. <strong>Select only the continent your teacher gives you.</strong></p>
          <p class="preliminary-note"><strong>JCEC settlement ratings are preliminary.</strong> They are based on limited information and are not the “correct answer.” Your team may later find evidence that changes the rating.</p>
        </div>
        <span class="active-chip" id="assignment-chip">● ACTIVE</span>
      </div>

      <div class="assignment-instructions" aria-label="Assignment instructions">
        <div><span>1</span><p><strong>Listen</strong> for your team’s continent.</p></div>
        <div><span>2</span><p><strong>Open</strong> that posting below.</p></div>
        <div><span>3</span><p><strong>Save</strong> your first scientific prediction on this device.</p></div>
      </div>

      <div class="continent-grid" role="list" aria-label="Continental postings">
        {continents.map((continent) => (
          <button class="continent-card" type="button" data-continent={continent.id} role="listitem" aria-controls={`posting-${continent.id}`}>
            <span class="continent-icon" aria-hidden="true">{continent.icon}</span>
            <span class="file-code">JCEC FILE {continent.code}</span>
            <strong>{continent.name}</strong>
            <small>{continent.codename}</small>
            <span class="rating-label">JCEC PRELIMINARY RATING</span>
            <span class={`rating ${continent.ratingTone}`}>{continent.rating}</span>
            <span class="open-label">Open posting →</span>
          </button>
        ))}
      </div>
    </section>

    <section class="posting-shell" id="posting-shell" aria-live="polite" hidden>
      {continents.map((continent) => (
        <article class="posting" id={`posting-${continent.id}`} data-posting={continent.id} hidden>
          <div class="posting-topline">
            <div>
              <p class="system-label">PATHFINDER POSTING ORDER // {continent.code}</p>
              <h2>{continent.name} <span>— {continent.codename}</span></h2>
            </div>
            <div class="posting-rating">
              <span class="rating-label">JCEC PRELIMINARY RATING</span>
              <span class={`rating large ${continent.ratingTone}`}>{continent.rating}</span>
            </div>
          </div>

          <div class="posting-banner">
            <div><span>ASSIGNED DIVISION</span><strong>Ecological Survey</strong></div>
            <div><span>FIELD BASE</span><strong>{continent.baseCamp}</strong></div>
            <div><span>ENVIRONMENT</span><strong>{continent.environment}</strong></div>
            <div><span>PHASE</span><strong>01 ONLY</strong></div>
          </div>

          <div class="posting-grid">
            <section>
              <h3>Known conditions</h3>
              <ul>{continent.known.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <h3>Possible opportunities</h3>
              <ul>{continent.opportunities.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <h3>Known operational risks</h3>
              <ul>{continent.risks.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section class="question-card">
              <p class="system-label">JCEC UNANSWERED QUESTION</p>
              <h3>{continent.question}</h3>
              <p>You do not have enough evidence to answer this yet. That is what your mission is for.</p>
            </section>
          </div>

          <div class="handoff-notice">
            <span>↗</span>
            <div>
              <strong>Your posting lasts for Mission Phase 1 only.</strong>
              <p>When your ecological survey ends, another team will inherit this continent’s archive. <em>Future scientists will depend on the evidence you leave behind.</em></p>
            </div>
          </div>
        </article>
      ))}

      <section class="assessment" id="initial-assessment" aria-labelledby="assessment-heading">
        <p class="system-label">INITIAL SCIENTIFIC HYPOTHESIS</p>
        <h2 id="assessment-heading">What is your first assessment?</h2>
        <p>Based only on the information in your posting, how suitable does your continent <strong>seem right now</strong> for future human settlement? This is a starting hypothesis, not a correct-or-incorrect answer. <strong>The JCEC preliminary rating is evidence to consider, not an answer to copy.</strong></p>

        <form id="assessment-form">
          <fieldset>
            <legend>Choose one initial assessment.</legend>
            <label><input type="radio" name="assessment" value="Looks promising" /> <span><strong>Looks promising</strong><small>The known conditions seem favourable overall.</small></span></label>
            <label><input type="radio" name="assessment" value="Possibly suitable" /> <span><strong>Possibly suitable</strong><small>There are opportunities, but important concerns remain.</small></span></label>
            <label><input type="radio" name="assessment" value="Major concerns" /> <span><strong>Major concerns</strong><small>The known risks could make settlement difficult.</small></span></label>
            <label><input type="radio" name="assessment" value="Not enough evidence yet" /> <span><strong>Not enough evidence yet</strong><small>I need more ecological evidence before deciding.</small></span></label>
          </fieldset>
          <label class="reason-label" for="assessment-reason"><strong>Give one evidence-based reason.</strong><span>Use something from your posting—not just a guess.</span></label>
          <textarea id="assessment-reason" rows="4" placeholder="Example: I chose ___ because the posting says..." maxlength="500"></textarea>
          <p class="device-note"><strong>Saved on this device only.</strong> This page does not submit your response to your teacher. Your teacher may ask you to copy your response into your Pathfinder Log or another class document.</p>
          <div class="form-actions">
            <button class="button primary" type="submit">Save Initial Assessment on This Device</button>
            <button class="text-button" id="change-posting" type="button">Change posting</button>
          </div>
          <p class="form-message" id="assessment-message" role="status"></p>
        </form>
      </section>
    </section>

    <section class="next-step" id="operation-02" aria-labelledby="next-step-heading">
      <div class="next-step-status"><span>02</span><strong>NEXT OPERATION</strong></div>
      <div>
        <p class="system-label">OPERATION PREVIEW</p>
        <h2 id="next-step-heading">Environmental Survey</h2>
        <p>Your first ecological investigation will begin with the environment around your landing zone. You will examine conditions, separate <strong>biotic</strong> and <strong>abiotic</strong> evidence, and predict what kinds of life could survive there.</p>
        <div class="operation-lock" id="operation-lock"><span>🔒</span><div><strong>Await JCEC activation.</strong><small>Operation 02 classroom materials are not active yet.</small></div></div>
        <div class="step-preview"><span id="now-step" class="now">● NOW: Mission Assignment</span><span>○ NEXT: Environmental Survey</span></div>
      </div>
    </section>

    <section class="panel progress-panel" aria-labelledby="progress-heading">
      <div class="heading-row"><div><p class="system-label">MISSION PROGRESS</p><h2 id="progress-heading">Phase 1 Operations</h2></div><span class="active-chip">● CURRENT PHASE</span></div>
      <div class="progress-list">
        <div class="step active" id="progress-assignment"><span>01</span><div><strong>Mission Assignment</strong><small id="assignment-progress-text">ACTIVE — receive your continent posting</small></div></div>
        <div class="step pending"><span>02</span><div><strong>Environmental Survey</strong><small>PENDING</small></div></div>
        <div class="step pending"><span>03</span><div><strong>First Contact</strong><small>PENDING</small></div></div>
        <div class="step pending"><span>04</span><div><strong>Ecosystem Network</strong><small>PENDING</small></div></div>
        <div class="step pending"><span>05</span><div><strong>Population Investigation</strong><small>PENDING</small></div></div>
        <div class="step pending"><span>06</span><div><strong>Environmental Change</strong><small>PENDING</small></div></div>
        <div class="step classified"><span>07</span><div><strong>🔒 Classified Incident</strong><small>ACCESS DENIED</small></div></div>
        <div class="step pending"><span>08</span><div><strong>JCEC Ecological Report</strong><small>PENDING</small></div></div>
      </div>
    </section>

    <section class="panel connection" aria-labelledby="connection-heading">
      <p class="system-label">SCIENCE CONNECTION</p>
      <h2 id="connection-heading">Mission work and science lessons work together.</h2>
      <p>When your team needs scientific knowledge, this mission page will send you to the matching Grade 7 Science lesson, investigation, simulation, or reference page. Learn the science there, then return here to use it as a Pathfinder.</p>
      <div class="flow" aria-label="Learning flow"><span>LEARN</span><b>→</b><span>INVESTIGATE</span><b>→</b><span>USE EVIDENCE</span><b>→</b><span>DECIDE</span></div>
      <div class="two-actions">
        <a class="button primary" href={`${base}courses/grade-7-science/jabberwocky/`}>← Mission Control</a>
        <a class="button secondary" href={`${base}courses/grade-7-science/interactions-ecosystems/`}>Science Learning Resources →</a>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const STORAGE_POSTING = 'jabberwocky-phase1-posting';
      const STORAGE_ASSESSMENT = 'jabberwocky-phase1-assessment';
      const STORAGE_REASON = 'jabberwocky-phase1-assessment-reason';
      const buttons = [...document.querySelectorAll('[data-continent]')];
      const postings = [...document.querySelectorAll('[data-posting]')];
      const shell = document.getElementById('posting-shell');
      const form = document.getElementById('assessment-form');
      const heroAssignment = document.getElementById('hero-assignment');
      const assignmentChip = document.getElementById('assignment-chip');
      const progressAssignment = document.getElementById('progress-assignment');
      const progressText = document.getElementById('assignment-progress-text');
      const nowStep = document.getElementById('now-step');
      const message = document.getElementById('assessment-message');
      const reason = document.getElementById('assessment-reason');
      const changeButton = document.getElementById('change-posting');

      function continentName(id) {
        const button = buttons.find((item) => item.dataset.continent === id);
        return button ? button.querySelector('strong')?.textContent?.trim() || id : id;
      }

      function showPosting(id, shouldScroll = true) {
        const matching = postings.find((item) => item.dataset.posting === id);
        if (!matching || !shell) return;
        postings.forEach((item) => { item.hidden = item !== matching; });
        shell.hidden = false;
        buttons.forEach((button) => {
          const selected = button.dataset.continent === id;
          button.classList.toggle('selected', selected);
          button.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
        localStorage.setItem(STORAGE_POSTING, id);
        if (heroAssignment) heroAssignment.textContent = continentName(id);
        if (assignmentChip) assignmentChip.textContent = '✓ POSTING RECEIVED';
        if (progressText) progressText.textContent = 'IN PROGRESS — save your initial assessment';
        if (nowStep) nowStep.textContent = '● NOW: Initial Assessment';
        restoreAssessment(id);
        if (shouldScroll) shell.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function restoreAssessment(id) {
        if (!form || !reason || !message) return;
        const storedPosting = localStorage.getItem(STORAGE_POSTING);
        const storedAssessment = localStorage.getItem(STORAGE_ASSESSMENT);
        const storedReason = localStorage.getItem(STORAGE_REASON) || '';
        form.reset();
        reason.value = '';
        message.textContent = '';
        if (storedPosting === id && storedAssessment) {
          const radio = form.querySelector(`input[name="assessment"][value="${CSS.escape(storedAssessment)}"]`);
          if (radio) radio.checked = true;
          reason.value = storedReason;
          markAssignmentComplete();
          message.textContent = '✓ Your initial assessment is saved on this device. It has not been submitted to your teacher.';
        } else {
          markAssignmentInProgress();
        }
      }

      function markAssignmentComplete() {
        if (progressAssignment) {
          progressAssignment.classList.remove('active');
          progressAssignment.classList.add('complete');
        }
        if (progressText) progressText.textContent = 'COMPLETE — posting and assessment saved on this device';
        if (nowStep) nowStep.textContent = '✓ OPERATION 01 COMPLETE';
        if (assignmentChip) assignmentChip.textContent = '✓ OPERATION 01 COMPLETE';
      }

      function markAssignmentInProgress() {
        if (progressAssignment) {
          progressAssignment.classList.add('active');
          progressAssignment.classList.remove('complete');
        }
      }

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', 'false');
        button.addEventListener('click', () => showPosting(button.dataset.continent));
      });

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const posting = localStorage.getItem(STORAGE_POSTING);
        const selected = form.querySelector('input[name="assessment"]:checked');
        const writtenReason = reason?.value.trim() || '';
        if (!posting || !selected || writtenReason.length < 12) {
          if (message) message.textContent = 'Choose an assessment and give a short evidence-based reason before saving it.';
          return;
        }
        localStorage.setItem(STORAGE_ASSESSMENT, selected.value);
        localStorage.setItem(STORAGE_REASON, writtenReason);
        markAssignmentComplete();
        if (message) message.textContent = '✓ Initial assessment saved on this device. It has not been submitted to your teacher. Keep it in mind—new evidence may change your thinking.';
        document.getElementById('operation-02')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      changeButton?.addEventListener('click', () => {
        localStorage.removeItem(STORAGE_POSTING);
        localStorage.removeItem(STORAGE_ASSESSMENT);
        localStorage.removeItem(STORAGE_REASON);
        shell.hidden = true;
        buttons.forEach((button) => { button.classList.remove('selected'); button.setAttribute('aria-pressed', 'false'); });
        if (heroAssignment) heroAssignment.textContent = 'Not selected';
        if (assignmentChip) assignmentChip.textContent = '● ACTIVE';
        if (progressText) progressText.textContent = 'ACTIVE — receive your continent posting';
        if (nowStep) nowStep.textContent = '● NOW: Mission Assignment';
        markAssignmentInProgress();
        document.getElementById('mission-assignment')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      const savedPosting = localStorage.getItem(STORAGE_POSTING);
      if (savedPosting) showPosting(savedPosting, false);
    })();
  </script>
</BaseLayout>

<style>
:global(body){background:#06111f}.phase-shell{max-width:1120px;margin:0 auto;padding:0 1.1rem 5rem;color:#eaf5ff}.phase-shell :global(.breadcrumbs){color:#9fb8c8}.phase-shell :global(.breadcrumbs a){color:#d3eafa}.mission-nav{position:sticky;top:.6rem;z-index:20;display:flex;gap:.35rem;align-items:center;overflow:auto;margin:1rem 0;padding:.45rem;border:1px solid #244b60;border-radius:14px;background:rgba(5,20,33,.94);backdrop-filter:blur(12px);box-shadow:0 8px 28px rgba(0,0,0,.25)}.mission-nav a{flex:0 0 auto;padding:.65rem .78rem;border-radius:9px;color:#b9cfdd;text-decoration:none;font-size:.88rem;font-weight:800}.mission-nav a:hover,.mission-nav a.active{background:#123348;color:#fff}.mission-nav a.active{box-shadow:inset 0 -2px #6ef2cf}.system-label{margin:0;color:#74e9cb;font:800 .82rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;text-transform:uppercase}.phase-hero{position:relative;overflow:hidden;margin:1.2rem 0 1.4rem;padding:clamp(1.5rem,5vw,3.2rem);border:1px solid #236078;border-radius:26px;background:radial-gradient(circle at 78% 22%,rgba(110,242,207,.2),transparent 24%),linear-gradient(145deg,#071527,#0b2d42 60%,#06111f)}.phase-hero:before{content:"";position:absolute;inset:0;background-image:radial-gradient(#9bd9ff 1px,transparent 1px);background-size:34px 34px;opacity:.08}.hero-grid{position:relative;display:grid;grid-template-columns:1fr 290px;gap:1.6rem;align-items:end}.division{margin:1.5rem 0 .35rem;color:#a9c3d3;font-weight:850;letter-spacing:.12em}.phase-hero h1{margin:0;color:#fff;font-size:clamp(3.5rem,9vw,7rem);line-height:.82;letter-spacing:-.06em}.phase-hero h1 span{color:#6ef2cf}.lead{max-width:720px;margin:1.5rem 0 0;color:#c4d9e7;font-size:1.14rem;line-height:1.65}.phase-hero aside{padding:1.15rem;border:1px solid #315d73;border-radius:16px;background:rgba(4,17,29,.8);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.phase-hero aside>span{display:block;color:#8ea8b8;font-size:.78rem}.phase-hero aside>str