---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecWorkMode from '../../../../../../components/JcecWorkMode.astro';
import JcecPopulationGraph from '../../../../../../components/JcecPopulationGraph.astro';
import { operation05Cases } from '../../../../../../data/jabberwockyOperation05';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';
const gridCells = Array.from({ length: 25 }, (_, index) => index + 1);
---

<BaseLayout title="Operation 05: Population Investigation | Jabberwocky 2190" description="A Grade 7 Science population-data investigation using sampling, graphs, multiple evidence sources, and CER reasoning." themeColor="#071b2e">
  <div class="operation-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Operation 05' }
    ]} />

    <nav class="mission-nav" aria-label="Operation navigation">
      <a href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1</a>
      <a class="active" href="#briefing">Operation 05</a>
      <a href="#sampling-lab">Sampling Lab</a>
      <a href="#case-file">Population Case</a>
      <a href="#archive">Archive</a>
    </nav>

    <header class="operation-hero" id="briefing">
      <p class="system-label">MISSION PHASE 01 // OPERATION 05</p>
      <div class="hero-grid">
        <div>
          <p class="division">JCEC ECOLOGICAL SURVEY DIVISION</p>
          <h1>POPULATION<br /><span>INVESTIGATION</span></h1>
          <p class="lead">Something has changed in your continent’s population records. JCEC needs more than a guess. Your team must decide what the data actually show, what explanation fits best, and what remains uncertain.</p>
        </div>
        <aside>
          <span>MISSION PURPOSE</span>
          <strong>Solve a population mystery with evidence</strong>
          <dl>
            <div><dt>Science focus</dt><dd>Population change + limiting factors</dd></div>
            <div><dt>Hands-on work</dt><dd>Population sampling</dd></div>
            <div><dt>Official record</dt><dd>Team CER</dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <section class="mission-question">
      <p>OPERATION QUESTION</p>
      <h2>How can scientists use population data to decide which explanation best fits an ecological change?</h2>
    </section>

    <section class="panel operation-route" aria-labelledby="route-heading">
      <p class="system-label">MISSION ROUTE</p>
      <h2 id="route-heading">Where are we going?</h2>
      <div class="route-grid">
        <span><b>1</b> Sample a Population</span><i>→</i><span><b>2</b> Read the Graphs</span><i>→</i><span><b>3</b> Compare Evidence</span><i>→</i><span><b>4</b> Choose a Working Claim</span><i>→</i><span><b>5</b> Build CER</span><i>→</i><span><b>6</b> Archive</span>
      </div>
    </section>

    <section class="panel operation-checklist" aria-labelledby="checklist-heading">
      <p class="system-label">YOUR OPERATION 05 CHECKLIST</p>
      <h2 id="checklist-heading">What do I have to complete?</h2>
      <div class="completion-grid">
        <article><span>👥</span><div><strong>As a team</strong><ul><li>Complete the hands-on Population Sampling Lab.</li><li>Analyze all three datasets for your continent.</li><li>Select key evidence and test possible explanations.</li><li>Write one Claim–Evidence–Reasoning conclusion.</li></ul></div></article>
        <article><span>🗂️</span><div><strong>One team member</strong><ul><li>Submit the official Population Case Finding to JCEC.</li><li>Keep the completed case sheet in the Continental Archive.</li></ul></div></article>
        <article><span>👤</span><div><strong>Each Pathfinder</strong><ul><li>Complete the individual reflection when directed.</li></ul></div></article>
      </div>
      <p class="completion-rule"><strong>Operation 05 is complete when</strong> your team has a defensible CER, the official finding is submitted, and you have completed your Pathfinder reflection.</p>
    </section>

    <section class="panel science-focus" aria-labelledby="science-heading">
      <p class="system-label">SCIENCE YOU WILL USE</p>
      <h2 id="science-heading">A count is evidence—not automatically the whole population.</h2>
      <div class="science-grid">
        <article><strong>Population</strong><p>All members of one species living in a particular area at a particular time.</p></article>
        <article><strong>Population distribution</strong><p>Where members of a population are located. A population can move or become clustered without necessarily changing total size.</p></article>
        <article><strong>Limiting factor</strong><p>A condition or resource that can restrict population growth or survival, such as food, water, shelter, space, temperature, or another interaction.</p></article>
        <article><strong>Trend</strong><p>The overall pattern in data over time—such as increasing, decreasing, stable, or changing direction.</p></article>
        <article><strong>Sample</strong><p>A smaller part of a population or habitat used to estimate or describe the larger system. How and where we sample matters.</p></article>
        <article><strong>Correlation ≠ proof of cause</strong><p>Two patterns changing together can support an explanation, but scientists also look for timing, mechanism, other evidence, and alternative explanations.</p></article>
      </div>
      <div class="science-warning"><strong>JCEC rule:</strong> never write “the graph proves…” when the evidence only supports a likely explanation. Use precise language such as <em>supports, suggests, is consistent with, may, likely,</em> and <em>because</em>.</div>
      <a class="text-link" href={`${base}courses/grade-7-science/interactions-ecosystems/`}>Need a refresher? Open Interactions & Ecosystems resources →</a>
    </section>

    <section class="panel sampling-lab" id="sampling-lab" aria-labelledby="sampling-heading">
      <JcecWorkMode mode="team" title="Estimate a population without counting everything first" />
      <div class="section-heading"><div><p class="system-label">HANDS-ON INVESTIGATION // ECOLOGICAL MONITORING</p><h2 id="sampling-heading">Population Sampling Lab</h2></div><span class="duration">35–45 min</span></div>
      <p class="intro">Ecologists often cannot count every organism. Your team will use random quadrat samples to estimate an unknown population, then test what happens when the same population becomes clustered.</p>

      <div class="lab-grid">
        <article><h3>Equipment per team</h3><ul><li>1 printed 5 × 5 habitat grid</li><li>1 cup of small counters, beans, beads, or paper dots prepared by your teacher</li><li>Calculator if permitted</li><li>Population Sampling Record</li></ul><p class="equipment-note"><strong>Do not count the whole cup first.</strong> The unknown total is part of the investigation.</p></article>
        <article><h3>Team jobs</h3><ul><li><strong>Sampler:</strong> counts only the selected quadrats.</li><li><strong>Recorder:</strong> records counts and calculations.</li><li><strong>Randomizer:</strong> generates sample-square numbers.</li><li><strong>Quality Checker:</strong> checks that the team does not choose “good-looking” squares on purpose.</li></ul><p class="equipment-note">Your teacher may assign or combine jobs. Everyone should be able to explain why random sampling matters.</p></article>
      </div>

      <div class="sample-tool">
        <div class="sample-tool-heading"><p class="system-label">RANDOM QUADRAT SELECTOR</p><h3>Keep both rounds visible.</h3><p>Generate Round 1 only after the counters are spread. Record it on paper before changing the distribution.</p></div>
        <div class="sample-round">
          <div><strong>ROUND 1 SAMPLE</strong><output id="sample-output-1" aria-live="polite">— — — — —</output></div>
          <button type="button" class="button primary" id="generate-samples-1">Generate Round 1 Sample</button>
        </div>
        <div class="sample-round">
          <div><strong>ROUND 2 SAMPLE</strong><output id="sample-output-2" aria-live="polite">— — — — —</output></div>
          <button type="button" class="button primary" id="generate-samples-2" disabled>Generate Round 2 Sample</button>
        </div>
        <button type="button" class="sample-reset" id="reset-samples">Reset samples</button>
        <p class="sample-status" id="sample-status" role="status">Generate Round 1 first. Round 2 unlocks after Round 1 has been generated.</p>
      </div>

      <div class="procedure">
        <h3>Round 1 — Estimate the unknown population</h3>
        <ol>
          <li><strong>Pour the counters onto the habitat grid</strong> without counting them. Make sure each counter lies inside one numbered square. If a counter lands on a grid line, gently move it into the square containing most of the counter.</li>
          <li><strong>Generate five random quadrat numbers.</strong> Record the Round 1 sample on your sheet. Do not replace numbers with squares that look more interesting.</li>
          <li><strong>Count only those five squares</strong> and record each count.</li>
          <li><strong>Calculate the mean number per quadrat:</strong> total organisms in the five samples ÷ 5.</li>
          <li><strong>Estimate the whole population:</strong> mean per quadrat × 25 quadrats.</li>
          <li><strong>Now count every counter</strong> to reveal the true population. Calculate how far your estimate was from the true count.</li>
        </ol>
        <h3>Round 2 — Same population, different distribution</h3>
        <ol>
          <li><strong>Do not add or remove any counters.</strong> Move many of them into a cluster of several neighbouring quadrats while leaving other areas sparse.</li>
          <li>Only after the counters are clustered, generate the <strong>Round 2 sample</strong>. Your Round 1 numbers remain visible above for comparison.</li>
          <li>Repeat the estimate and compare Round 1 with Round 2. The true population stayed the same. Did the estimate change? Why?</li>
        </ol>
      </div>

      <div class="sampling-debrief">
        <article><strong>Sampling error</strong><p>An estimate can be above or below the true population because a sample is only part of the habitat.</p></article>
        <article><strong>Distribution matters</strong><p>Clustered organisms can make a small number of quadrats less representative of the whole area.</p></article>
        <article><strong>Repeated evidence helps</strong><p>More samples, repeated surveys, and consistent methods usually give scientists more confidence.</p></article>
      </div>

      <div class="print-actions"><button class="button secondary" type="button" id="print-op5-packet">Print Operation 05 Field Packet (if needed)</button><span><strong>Your teacher may already provide the packet.</strong> One habitat grid and one case record per team are enough.</span></div>

      <section class="print-packet" aria-label="Operation 05 printable packet">
        <section class="print-page">
          <div class="print-header"><div><strong>JCEC ECOLOGICAL MONITORING CERTIFICATION</strong><h3>Population Sampling Habitat</h3></div><div>Team: ____________________</div></div>
          <div class="habitat-grid">{gridCells.map((cell) => <div>{cell}</div>)}</div>
          <div class="sample-record">
            <table><thead><tr><th></th><th>Sample squares</th><th>5 counts</th><th>Mean</th><th>Estimate × 25</th><th>True population</th></tr></thead><tbody><tr><th>Round 1</th><td></td><td></td><td></td><td></td><td></td></tr><tr><th>Round 2</th><td></td><td></td><td></td><td></td><td>same as Round 1</td></tr></tbody></table>
            <p><strong>Which estimate was closer to the true population?</strong> __________________________________________________</p>
            <p><strong>How did clustering affect your estimate?</strong> __________________________________________________________</p>
          </div>
        </section>
        <section class="print-page case-sheet">
          <div class="print-header"><div><strong>JCEC POPULATION CASE RECORD</strong><h3>Claim–Evidence–Reasoning</h3></div><div>Continent: ____________________ &nbsp; Team ID: ____________</div></div>
          <div class="case-prompts">
            <p><strong>What trend do the focal-species data show?</strong> __________________________________________________________</p>
            <p><strong>Working claim:</strong> _____________________________________________________________________________________</p>
            <p><strong>Evidence 1 — include a specific value or change:</strong> ___________________________________________________</p>
            <p><strong>Evidence 2 — include a specific value or change:</strong> ___________________________________________________</p>
            <p><strong>Evidence 3 — use another data source:</strong> ______________________________________________________________</p>
            <p><strong>Reasoning — explain how the evidence connects to the claim:</strong></p><div class="writing-box"></div>
            <p><strong>Alternative explanation considered:</strong> _______________________________________________________________</p>
            <p><strong>Why it is weaker / what evidence would be needed:</strong> __________________________________________________</p>
            <p><strong>Uncertainty / next measurement:</strong> ____________________________________________________________________</p>
          </div>
        </section>
      </section>
    </section>

    <section class="panel checkpoint" aria-labelledby="checkpoint-heading">
      <p class="system-label">MISSION CHECKPOINT // BEFORE OPENING THE CASE</p>
      <h2 id="checkpoint-heading">Three questions before you trust a population graph.</h2>
      <div class="checkpoint-grid">
        <article><span>1</span><p><strong>What was actually measured?</strong> A survey count, detection index, or sample is not automatically the total population.</p></article>
        <article><span>2</span><p><strong>Was the method consistent?</strong> Changes in time, place, weather, or equipment can change what gets detected.</p></article>
        <article><span>3</span><p><strong>What other evidence changes at the same time?</strong> Look for resources, abiotic conditions, movement, predators, and alternative explanations.</p></article>
      </div>
    </section>

    <section class="panel case-file" id="case-file" aria-labelledby="case-heading">
      <JcecWorkMode mode="team" title="Solve your continent’s population mystery" />
      <p class="system-label">JCEC POPULATION ALERT // DATA REVIEW REQUIRED</p>
      <h2 id="case-heading">Open your assigned population case.</h2>
      <p class="intro">Do not choose a cause after looking at one graph. Read all datasets, check the monitoring notes, compare the timing, and then decide which explanation is most defensible.</p>

      <div class="detection-rule">
        <div><strong>DETECTIONS ≠ TOTAL POPULATION</strong><span>A detection count can change for more than one reason.</span></div>
        <ul><li>the population size changed;</li><li>organisms moved to a different place;</li><li>their behaviour or activity changed;</li><li>habitat conditions changed where they were found;</li><li>or the monitoring method detected them differently.</li></ul>
        <p><strong>Your job:</strong> decide which explanation—or combination of explanations—the evidence supports.</p>
      </div>

      <div class="no-posting" id="no-posting" hidden><strong>No continental posting detected on this device.</strong><p>Return to Operation 01, open the continent your teacher assigned, then come back here.</p><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Return to Mission Assignment</a></div>

      <div id="population-files" hidden>
        {operation05Cases.map((item) => (
          <article class="population-file" data-population={item.id} hidden>
            <div class="case-heading"><div><p class="system-label">CASE 05-{item.code} // {item.baseCamp}</p><h3>{item.name}: {item.focalSpecies} Population Mystery</h3><small>{item.environment}</small></div><span class="case-status">8 SURVEYS</span></div>
            <div class="mystery"><strong>THE MYSTERY</strong><p>{item.mystery}</p></div>

            <div class="analysis-team-roles">
              <article><span>📊</span><div><strong>Data Reader</strong><small>Reads graph axes, values, and trends aloud.</small></div></article>
              <article><span>🧾</span><div><strong>Evidence Recorder</strong><small>Records exact numbers and observations on the case sheet.</small></div></article>
              <article><span>💻</span><div><strong>JCEC Operator</strong><small>Uses the site only after team discussion.</small></div></article>
              <article><span>❓</span><div><strong>Alternative-Explanation Checker</strong><small>Asks what else could explain the pattern.</small></div></article>
            </div>

            <section class="data-section">
              <p class="system-label">STEP 1 // READ ALL THREE DATASETS</p>
              <div class="graph-detective"><strong>GRAPH DETECTIVE RULE</strong><p>Different graphs may use different <strong>y-axis scales</strong>. A line that looks steeper is not automatically a bigger change. Check the axis numbers and use actual values before comparing graphs.</p></div>
              <div class="graph-grid">{item.series.map((series) => <JcecPopulationGraph title={series.label} unit={series.unit} labels={item.timeLabels} values={series.values} note={series.note} />)}</div>
              <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Dataset</th>{item.timeLabels.map((label) => <th>{label}</th>)}</tr></thead><tbody>{item.series.map((series) => <tr><th>{series.label}<small>{series.unit}</small></th>{series.values.map((value) => <td>{value}</td>)}</tr>)}</tbody></table></div>
              <div class="trend-prompts"><strong>Before moving on, your team should identify:</strong><span>What changes first?</span><span>What changes next?</span><span>What stays fairly stable?</span><span>Which graph alone could be misleading?</span></div>
            </section>

            <section class="evidence-section">
              <p class="system-label">STEP 2 // CHECK OTHER EVIDENCE</p>
              <h4>Read every evidence record first. Then mark the three or more records that best help test your explanation.</h4>
              <p class="evidence-direction">Do not choose records just because you need three. Ask whether each one supports, weakens, or helps rule out a possible explanation.</p>
              <div class="evidence-grid">
                {item.evidence.map((record, index) => <article class="evidence-card"><span>{String(index + 1).padStart(2,'0')}</span><div><strong>{record.source}</strong><p>{record.observation}</p></div><button type="button" class="key-evidence" aria-pressed="false">Mark as key evidence</button></article>)}
              </div>
              <p class="evidence-counter" data-evidence-counter>0 evidence records marked. Your CER should use graph data too—not only these cards.</p>
            </section>

            <section class="claims-section">
              <p class="system-label">STEP 3 // WORKING EXPLANATION BOARD</p>
              <h4>Which explanation is most defensible right now?</h4>
              <p>All three are <strong>plausible scientific hypotheses</strong>. There is no “always choose A” pattern. Discuss the evidence for and against each one, select the claim your team can best defend, and revise it if needed.</p>
              <div class="claim-grid">{item.possibleClaims.map((claim, index) => <button type="button" class="claim-card" data-claim={claim}><span>CLAIM {String.fromCharCode(65 + index)}</span><strong>{claim}</strong><small>Select as working claim</small></button>)}</div>
              <p class="working-claim" data-working-claim>No working claim selected yet.</p>
            </section>

            <section class="cer-section">
              <p class="system-label">STEP 4 // BUILD YOUR CER</p>
              <h4>{item.investigationQuestion}</h4>
              <div class="cer-example">
                <p class="system-label">QUICK CER EXAMPLE // NOT FROM JABBERWOCKY</p>
                <div><strong>Claim</strong><p>The shaded microhabitat likely supported more of the organisms observed during our survey.</p></div>
                <div><strong>Evidence</strong><p>Sample A had 12 organisms while Sample B had 5, and Sample A was 4°C cooler.</p></div>
                <div><strong>Reasoning</strong><p>The cooler conditions may reduce water loss and provide conditions that more of the observed organisms could tolerate.</p></div>
                <footer><strong>Notice:</strong> Evidence tells <em>what</em> was observed or measured. Reasoning explains <em>why</em> that evidence supports the claim.</footer>
              </div>
              <div class="cer-grid">
                <article><span>C</span><div><strong>Claim</strong><p>State the explanation your team thinks best fits the population pattern. Do not claim more than the data support.</p></div></article>
                <article><span>E</span><div><strong>Evidence</strong><p>Use at least <strong>three specific pieces</strong> of evidence. Include exact values or changes from at least two datasets.</p></div></article>
                <article><span>R</span><div><strong>Reasoning</strong><p>Explain <em>why</em> the evidence supports the claim using population, limiting-factor, habitat, resource, or interaction science.</p></div></article>
              </div>
              <div class="cer-quality"><strong>A strong team explanation also includes:</strong><ul><li>one alternative explanation you considered;</li><li>why current evidence supports it less strongly, or what evidence would be needed to test it;</li><li>one uncertainty or next measurement.</li></ul></div>
              <p class="record-direction"><strong>Record your agreed CER on the Operation 05 Population Case Record.</strong> The website does not submit your working claim automatically.</p>
            </section>
          </article>
        ))}
      </div>
    </section>

    <section class="panel archive-panel" id="archive" aria-labelledby="archive-heading">
      <JcecWorkMode mode="archive" title="Add the Population Case Finding to the Continental Archive" />
      <p class="system-label">JCEC ARCHIVE TRANSMISSION</p>
      <h2 id="archive-heading">Submit the explanation—not just the graph trend.</h2>
      <p>Your case sheet stays with the Continental Archive. One team member sends the team’s written CER to JCEC so the evidence is teacher-visible and available for later decisions.</p>

      <div class="submission-map">
        <article><strong>Claim / Decision / Main Finding</strong><p>Your concise population explanation.</p></article>
        <article><strong>Evidence</strong><p>At least three specific observations or data values from two or more sources.</p></article>
        <article><strong>Reasoning / Explanation</strong><p>Explain the mechanism, why the evidence supports the claim, and include your uncertainty or alternative explanation.</p></article>
        <article><strong>Pathfinder Reflection</strong><p>Leave blank for this team archive submission unless your teacher tells you otherwise.</p></article>
      </div>

      <div class="submission-guide">
        <div class="guide-heading"><span>📡</span><div><strong>Submit to the JCEC Portal</strong><small>One designated team member submits.</small></div></div>
        <dl><div><dt>Submission Type</dt><dd>Continental Archive</dd></div><div><dt>Mission Phase</dt><dd>01 First Contact</dd></div><div><dt>Operation / Task</dt><dd>Population Investigation — Population Case Finding</dd></div><div><dt>Continent</dt><dd id="archive-continent">Your assigned continent</dd></div><div><dt>Team ID</dt><dd id="archive-team-id">Use the ID your teacher gives you</dd></div><div><dt>Team Members</dt><dd>List everyone represented</dd></div></dl>
        <p><strong>Your teacher gives you the Team ID; do not invent one.</strong> Read the final CER aloud before submitting. Every team member should be able to explain why the claim is supported and what remains uncertain.</p>
        <a class="button primary" href={portalUrl} target="_blank" rel="noopener noreferrer">Submit Population Case Finding to JCEC ↗</a>
        <p class="return-note"><strong>After submitting:</strong> return to this page or Mission Control. The JCEC dashboard—not this webpage—is the official submission record.</p>
      </div>
    </section>

    <section class="panel reflection" aria-labelledby="reflection-heading">
      <JcecWorkMode mode="individual" title="Update your Pathfinder Log" />
      <h2 id="reflection-heading">What did you learn about trusting population data?</h2>
      <ol>
        <li>Which specific data point or observation had the biggest effect on your explanation?</li>
        <li>How could a survey count decrease even if the total population did not decrease by the same amount?</li>
        <li>What alternative explanation did your team consider, and why was it weaker or still uncertain?</li>
        <li>What would you measure next if JCEC gave you one more week of field time?</li>
      </ol>
      <p class="reflection-note">This reflection is individual. Keep it in your Pathfinder Log unless your teacher directs you to submit it to JCEC.</p>
    </section>

    <section class="next-operation" aria-labelledby="next-heading">
      <div><span>06</span><strong>NEXT OPERATION</strong></div>
      <section><p class="system-label">ACCESS PENDING</p><h2 id="next-heading">Environmental Change</h2><p>A population can change quickly, but ecosystems also recover and reorganize over longer periods. Next, JCEC will examine what happens after a disturbance.</p><div class="locked"><span>🔒</span><strong>Await JCEC activation.</strong></div></section>
    </section>

    <div class="bottom-actions"><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/operation-04/`}>← Operation 04</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1 Operations</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a></div>
  </div>

  <script is:inline>
    (() => {
      const posting = localStorage.getItem('jabberwocky-phase1-posting');
      const noPosting = document.getElementById('no-posting');
      const files = document.getElementById('population-files');
      const file = posting ? document.querySelector(`[data-population="${posting}"]`) : null;
      if (!posting || !file) {
        if (noPosting) noPosting.hidden = false;
      } else {
        if (files) files.hidden = false;
        file.hidden = false;
        const continentName = file.querySelector('.case-heading h3')?.textContent?.split(':')[0]?.trim() || posting;
        const archiveContinent = document.getElementById('archive-continent');
        if (archiveContinent) archiveContinent.textContent = continentName;
        const signal = file.querySelector('.system-label')?.textContent || '';
        const codeMatch = signal.match(/05-([A-Z]{2})/);
        const archiveTeamId = document.getElementById('archive-team-id');
        if (archiveTeamId) archiveTeamId.textContent = `P1-${codeMatch?.[1] || 'XX'}-__ (use the number your teacher assigns)`;
      }

      const randomSamples = () => {
        const values = [];
        while (values.length < 5) {
          const value = Math.floor(Math.random() * 25) + 1;
          if (!values.includes(value)) values.push(value);
        }
        return values.sort((a, b) => a - b);
      };
      const round1Button = document.getElementById('generate-samples-1');
      const round2Button = document.getElementById('generate-samples-2');
      const round1Output = document.getElementById('sample-output-1');
      const round2Output = document.getElementById('sample-output-2');
      const sampleStatus = document.getElementById('sample-status');
      round1Button?.addEventListener('click', () => {
        if (round1Output) round1Output.textContent = randomSamples().join(' · ');
        round1Button.disabled = true;
        if (round2Button) round2Button.disabled = false;
        if (sampleStatus) sampleStatus.textContent = 'Round 1 generated. Record these numbers before clustering the population. Generate Round 2 only after the distribution has changed.';
      });
      round2Button?.addEventListener('click', () => {
        if (round2Output) round2Output.textContent = randomSamples().join(' · ');
        round2Button.disabled = true;
        if (sampleStatus) sampleStatus.textContent = 'Both samples are now visible. Keep them on screen while your team compares the two estimates.';
      });
      document.getElementById('reset-samples')?.addEventListener('click', () => {
        if (round1Output) round1Output.textContent = '— — — — —';
        if (round2Output) round2Output.textContent = '— — — — —';
        if (round1Button) round1Button.disabled = false;
        if (round2Button) round2Button.disabled = true;
        if (sampleStatus) sampleStatus.textContent = 'Samples reset. Generate Round 1 first.';
      });

      document.querySelectorAll('.population-file').forEach((populationFile) => {
        const evidenceCards = [...populationFile.querySelectorAll('.evidence-card')];
        const counter = populationFile.querySelector('[data-evidence-counter]');
        const updateCounter = () => {
          const count = evidenceCards.filter((card) => card.dataset.key === 'true').length;
          if (counter) counter.textContent = `${count} evidence record${count === 1 ? '' : 's'} marked. Your CER should also use exact graph or table values.`;
        };
        evidenceCards.forEach((card) => {
          const button = card.querySelector('.key-evidence');
          button?.addEventListener('click', () => {
            const selected = card.dataset.key === 'true';
            card.dataset.key = selected ? 'false' : 'true';
            button.setAttribute('aria-pressed', selected ? 'false' : 'true');
            button.textContent = selected ? 'Mark as key evidence' : '✓ Key evidence';
            card.classList.toggle('selected', !selected);
            updateCounter();
          });
        });
        updateCounter();

        const claimButtons = [...populationFile.querySelectorAll('.claim-card')];
        const workingClaim = populationFile.querySelector('[data-working-claim]');
        const storageKey = `jabberwocky-op5-claim-${populationFile.dataset.population}`;
        const selectClaim = (button) => {
          claimButtons.forEach((other) => other.classList.remove('selected'));
          button.classList.add('selected');
          const claim = button.dataset.claim || '';
          localStorage.setItem(storageKey, claim);
          if (workingClaim) workingClaim.textContent = `Working claim saved on this device: ${claim}`;
        };
        claimButtons.forEach((button) => button.addEventListener('click', () => selectClaim(button)));
        const saved = localStorage.getItem(storageKey);
        if (saved) {
          const match = claimButtons.find((button) => button.dataset.claim === saved);
          if (match) selectClaim(match);
        }
      });

      document.getElementById('print-op5-packet')?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

