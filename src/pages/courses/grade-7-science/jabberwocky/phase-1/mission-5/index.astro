---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecMissionProgress from '../../../../../../components/JcecMissionProgress.astro';
import { operation03Species } from '../../../../../../data/jabberwockyOperation03';
import { operation07Incidents } from '../../../../../../data/jabberwockyOperation07';
import { operation08Briefs } from '../../../../../../data/jabberwockyOperation08';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';

const continentIcons: Record<string, string> = {
  gyre: '⛰️',
  brillig: '🌿',
  manxome: '🏝️',
  'slithy-toves': '🏜️',
  wabe: '❄️',
  bandersnatch: '🌾',
  gimble: '🌲',
  mimsy: '🪷'
};

const missionFiles = operation07Incidents.map((incident) => {
  const species = operation03Species.find((item) => item.id === incident.id);
  const brief = operation08Briefs.find((item) => item.id === incident.id);
  if (!species || !brief) throw new Error(`Missing Mission 5 source data for ${incident.id}`);
  const first = incident.spread[0];
  const middle = incident.spread[Math.min(2, incident.spread.length - 1)];
  const last = incident.spread[incident.spread.length - 1];
  return {
    ...incident,
    icon: continentIcons[incident.id],
    nativeSpecies: species.fieldName,
    preliminaryRating: brief.preliminaryRating,
    ecologicalStrength: brief.ecologicalStrength,
    ecologicalConcern: brief.ecologicalConcern,
    spreadStages: [first, middle, last],
    impactEvidence: incident.evidence.slice(0, 2),
    contaminantPath: incident.contaminantPath
  };
});
---

<BaseLayout title="Mission 5: Humans Have Arrived | Jabberwocky 2190" description="The final simplified Grade 7 Science Phase 1 mission about human impacts, introduced species, pollution, conservation risk, and evidence-based decisions." themeColor="#071b2e">
  <div class="mission-shell" id="simplified-mission-5">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Mission 5' }
    ]} />

    <JcecMissionProgress active={5} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">MISSION 5 OF 5</p>
        <h1>HUMANS HAVE <span>ARRIVED</span></h1>
        <p class="question">How can people explore Jabberwocky without causing too much harm?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How human choices can change ecosystems</strong>
        <small>4 classes × 45 minutes</small>
      </aside>
    </header>

    <nav class="step-nav" aria-label="Mission 5 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing alert-briefing">
        <p>JCEC has confirmed a serious problem: humans brought an Earth organism to your continent by accident, and a human-made pollutant has entered part of the food web. Your team must investigate what happened, decide what is most at risk, and use everything you learned in Phase 1 to recommend what humans should be allowed to do next.</p>
      </div>

      <div class="assignment-box">
        <div class="assignment-result" id="assignment-result" hidden>
          <span id="assignment-icon" aria-hidden="true"></span>
          <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
          <div class="species-box"><small>NATIVE SPECIES</small><b id="assignment-species"></b></div>
        </div>
        <div class="missing-assignment" id="missing-assignment" hidden>
          <strong>Your continent is not saved on this device yet.</strong>
          <p>Go back to Mission 1 and choose the continent your teacher assigned.</p>
          <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a>
        </div>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASSES 1–2</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Start with four ideas.</p>
      <div class="science-grid">
        <article><span>📦</span><strong>Introduced species</strong><p>An organism moved by humans to a place where it did not live before.</p></article>
        <article><span>⚠️</span><strong>Invasive species</strong><p>An introduced species that spreads and causes harm. <strong>Introduced does not automatically mean invasive.</strong></p></article>
        <article><span>🧪</span><strong>Pollutant</strong><p>A substance released into the environment that can harm organisms or change conditions.</p></article>
        <article><span>🛡️</span><strong>Conservation</strong><p>Protecting species, habitats and ecosystem connections from serious harm.</p></article>
      </div>

      <div class="evidence-rule"><strong>To call an introduced species invasive, look for BOTH:</strong><span>1 · evidence it is spreading</span><span>2 · evidence it is causing ecological harm</span></div>

      <details class="help-box">
        <summary>Three conservation words you will use</summary>
        <div class="conservation-grid">
          <p><strong>Endangered:</strong> at serious risk of disappearing.</p>
          <p><strong>Local extinction:</strong> a species disappears from one area but still exists elsewhere.</p>
          <p><strong>Global extinction:</strong> a species disappears everywhere.</p>
        </div>
      </details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–3</p><h2>Investigate</h2></div></div>

      <section class="investigation-block spread-block">
        <div class="block-title"><div><small>CLASS 1</small><h3>Stowaway Spread Simulation</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> Can an early checkpoint reduce the spread of a hidden stowaway?</p>
        <div class="equipment-strip"><strong>You need:</strong><span>6 labelled cups or zones</span><span>neutral counters</span><span>4 different-coloured “stowaway” counters</span><span>a small scoop</span></div>
        <ol class="simple-procedure">
          <li>Mix the neutral counters and 4 stowaways in the <strong>Cargo</strong> cup.</li>
          <li><strong>Round A:</strong> move random counters Cargo → A → B → C → D → E. Do not inspect them. Count how many zones receive a stowaway.</li>
          <li>Reset everything.</li>
          <li><strong>Round B:</strong> repeat the same transfers, but inspect each transfer first. Put visible stowaways into a quarantine cup.</li>
          <li>Compare the two rounds. Which system stopped spread earlier?</li>
        </ol>
        <div class="model-note"><strong>Big idea:</strong><span>Human movement can create pathways for spread. Early checks can interrupt those pathways.</span></div>
        <button type="button" class="small-button secondary" id="print-mission5-board">Print JCEC Recommendation Board</button>
      </section>

      <section class="investigation-block incident-block">
        <div class="block-title"><div><small>CLASS 1–2</small><h3>Your Continent Incident</h3></div><span>TEAM WORK</span></div>
        <p>Use a small amount of evidence. Your job is to decide whether there is evidence of <strong>spread + harm</strong>.</p>

        <div class="no-continent" id="no-continent"><strong>Mission 1 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a></div>
        <div id="incident-files" hidden>
          {missionFiles.map((item) => (
            <article class="incident-file" data-incident={item.id} hidden>
              <header><span aria-hidden="true">{item.icon}</span><div><small>{item.name} · {item.baseCamp}</small><h3>{item.stowaway}</h3><p>Earth organism detected on {item.name}.</p></div></header>
              <div class="entry-card"><strong>How it may have arrived</strong><p>{item.suspectedEntry}</p></div>

              <div class="spread-evidence">
                <div class="evidence-heading"><strong>Spread over time</strong><span>Watch occupied zones and the native indicator.</span></div>
                {item.spreadStages.map((stage) => (
                  <article><strong>{stage.label}</strong><span>{stage.occupiedZones} occupied zone{stage.occupiedZones === 1 ? '' : 's'}</span><b>{item.nativeIndicatorLabel}: {stage.nativeIndicator}</b><p>{stage.note}</p></article>
                ))}
              </div>

              <div class="impact-evidence">
                <strong>Two more clues</strong>
                {item.impactEvidence.map((evidence, index) => <p><b>{index + 1}</b>{evidence}</p>)}
              </div>

              <div class="quick-check"><strong>Quick team check</strong><span>Do you see evidence of spread?</span><span>Do you see evidence of ecological harm?</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="investigation-block pollutant-block">
        <div class="block-title"><div><small>CLASS 2</small><h3>Pollution in a Food Chain</h3></div><span>TEACHER-GUIDED MODEL</span></div>
        <p>Use tokens to model a persistent pollutant. This is short: the goal is to see the pattern.</p>
        <div class="token-model">
          <article><b>1</b><strong>16 producers</strong><span>1 token each</span></article><i>→</i>
          <article><b>2</b><strong>4 consumers</strong><span>each eats 4 producers → 4 tokens each</span></article><i>→</i>
          <article><b>3</b><strong>1 predator</strong><span>eats the 4 consumers → 16 tokens</span></article>
        </div>
        <p class="pollutant-message"><strong>Some persistent pollutants can build up in organisms and become more concentrated higher in a food chain.</strong> This does not happen with every substance.</p>

        <div id="pollutant-files" hidden>
          {missionFiles.map((item) => (
            <article class="pollutant-file" data-pollutant={item.id} hidden>
              <div class="x17-title"><small>FICTIONAL X-17 SAMPLE PATH</small><p>{item.contaminantNote}</p></div>
              <div class="pollutant-path">
                {item.contaminantPath.map((level, index) => (
                  <><article><small>{level.trophicRole}</small><strong>{level.sample}</strong><span>{level.concentration} ppb</span></article>{index < item.contaminantPath.length - 1 && <i>→</i>}</>
                ))}
              </div>
              <p class="x17-note">X-17 is fictional. The data model how a persistent pollutant can move through a real food web.</p>
            </article>
          ))}
        </div>
      </section>

      <section class="investigation-block risk-block">
        <div class="block-title"><div><small>CLASS 2</small><h3>What Could Be at Risk?</h3></div><span>TEAM WORK</span></div>
        <p>Use the incident, pollution pathway and your Mission 3 Ecosystem Map.</p>
        <div class="risk-question"><strong>If this problem continued, which native species or ecosystem connection could be most at risk?</strong><span>Choose one. Explain the connection in one or two sentences.</span></div>
      </section>

      <section class="investigation-block evidence-review">
        <div class="block-title"><div><small>CLASS 3</small><h3>Bring Your Evidence Together</h3></div><span>TEAM WORK</span></div>
        <p>You do not need a new report. Look back at the four products you already made and choose the evidence that matters most.</p>
        <div class="mission-evidence-grid">
          <article><span>1</span><strong>Environment Profile</strong><p>What condition matters most?</p></article>
          <article><span>2</span><strong>Native Species Card</strong><p>What organism needs protection?</p></article>
          <article><span>3</span><strong>Ecosystem Map</strong><p>What connection matters?</p></article>
          <article><span>4</span><strong>Ecosystem Change Record</strong><p>What did monitoring show?</p></article>
        </div>
        <p class="three-evidence-rule"><strong>Choose three strong pieces of evidence.</strong> Try to use evidence from at least <strong>three different earlier missions</strong>.</p>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>What should humans be allowed to do on your continent?</h3>
        <div class="decision-choices">
          <span class="green">🟢 <strong>Explore carefully</strong></span>
          <span class="yellow">🟡 <strong>Explore with strong rules</strong></span>
          <span class="orange">🟠 <strong>Very limited exploration</strong></span>
          <span class="red">🔴 <strong>Stop for now</strong></span>
        </div>
        <div class="reasoning-frame"><strong>Decision</strong><span>Choose one recommendation.</span><strong>Evidence</strong><span>Use your strongest evidence.</span><strong>Possible consequence</strong><span>What could happen if humans ignore the evidence?</span></div>
        <div class="rule-prompt"><strong>One human rule:</strong><span>Write one clear rule that could reduce the biggest risk you found.</span></div>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASSES 3–4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one board</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record recommendation-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>JCEC Recommendation Board</h3></div><span>ONE PER TEAM</span></div>
        <p>This one-page board is your final Phase 1 team product.</p>
        <div class="board-checklist">
          <label><input type="checkbox" /> our continent</label>
          <label><input type="checkbox" /> why this ecosystem matters</label>
          <label><input type="checkbox" /> one important native species</label>
          <label><input type="checkbox" /> one important ecosystem connection</label>
          <label><input type="checkbox" /> biggest human-caused risk</label>
          <label><input type="checkbox" /> three strong pieces of evidence</label>
          <label><input type="checkbox" /> one rule humans must follow</label>
          <label><input type="checkbox" /> final recommendation + short explanation</label>
        </div>
      </div>

      <div class="continent-summary" id="summary-files" hidden>
        {missionFiles.map((item) => (
          <article data-summary={item.id} hidden>
            <div><small>PRELIMINARY JCEC RATING FROM THE START</small><strong>{item.preliminaryRating}</strong></div>
            <p><b>Ecological strength:</b> {item.ecologicalStrength}</p>
            <p><b>Current concern:</b> {item.ecologicalConcern}</p>
            <span>The preliminary rating was never the answer. Your recommendation must come from the evidence your team collected.</span>
          </article>
        ))}
      </div>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>At the start of Phase 1, what did you think about your continent? What do you think now? What evidence changed your mind?</h3>
        <p>Everyone answers this question individually.</p>
      </div>

      <details class="online-submit">
        <summary>Did your teacher tell one person to submit the Team Record online?</summary>
        <div><p>Submit the same Recommendation Board decision. Do not create another ecological report.</p><a href={portalUrl} target="_blank" rel="noopener noreferrer">Open JCEC submission portal ↗</a></div>
      </details>

      <div class="finished-box phase-finish">
        <strong>Mission 5 — and Phase 1 — are finished when:</strong>
        <span>✓ your team has one JCEC Recommendation Board</span>
        <span>✓ the board uses three strong pieces of evidence</span>
        <span>✓ you completed the short individual reflection</span>
        <p>You have completed First Contact. Your evidence will stay with this continent for the next science team.</p>
        <a class="return-hub" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Return to Phase 1 Mission Hub →</a>
      </div>
    </section>

    <section class="print-packet" aria-label="Mission 5 printable Recommendation Board">
      <section class="print-page recommendation-board-print">
        <h1>Mission 5 — JCEC Recommendation Board</h1>
        <p>Continent: ________________________________ &nbsp; Team: ________________________________</p>
        <div class="print-grid two"><div><strong>Why this ecosystem matters</strong><span></span></div><div><strong>Important native species</strong><span></span></div></div>
        <div class="print-grid two"><div><strong>Important ecosystem connection</strong><span></span></div><div><strong>Biggest human-caused risk</strong><span></span></div></div>
        <h2>Our three strongest pieces of evidence</h2>
        <div class="evidence-print"><p>1. ________________________________________________________________________________________</p><p>2. ________________________________________________________________________________________</p><p>3. ________________________________________________________________________________________</p></div>
        <div class="print-grid two"><div><strong>One rule humans must follow</strong><span></span></div><div><strong>What could happen if the rule is ignored?</strong><span></span></div></div>
        <h2>Our recommendation</h2>
        <p>□ 🟢 Explore carefully &nbsp;&nbsp; □ 🟡 Explore with strong rules &nbsp;&nbsp; □ 🟠 Very limited exploration &nbsp;&nbsp; □ 🔴 Stop for now</p>
        <p><strong>Why?</strong> ____________________________________________________________________________________________</p>
        <div class="writing-lines"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ missionData: missionFiles }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase1-posting';
      const files = Object.fromEntries(missionData.map((item) => [item.id, item]));
      const savedPosting = localStorage.getItem(POSTING_KEY);
      const item = savedPosting ? files[savedPosting] : null;

      const assignmentResult = document.getElementById('assignment-result');
      const missingAssignment = document.getElementById('missing-assignment');
      const noContinent = document.getElementById('no-continent');
      const incidentFiles = document.getElementById('incident-files');
      const pollutantFiles = document.getElementById('pollutant-files');
      const summaryFiles = document.getElementById('summary-files');

      if (item) {
        assignmentResult.hidden = false;
        missingAssignment.hidden = true;
        document.getElementById('assignment-icon').textContent = item.icon;
        document.getElementById('assignment-name').textContent = item.name;
        document.getElementById('assignment-environment').textContent = `${item.baseCamp} · ${item.environment}`;
        document.getElementById('assignment-species').textContent = item.nativeSpecies;
        noContinent.hidden = true;
        incidentFiles.hidden = false;
        pollutantFiles.hidden = false;
        summaryFiles.hidden = false;
        document.querySelectorAll('[data-incident]').forEach((el) => el.hidden = el.dataset.incident !== savedPosting);
        document.querySelectorAll('[data-pollutant]').forEach((el) => el.hidden = el.dataset.pollutant !== savedPosting);
        document.querySelectorAll('[data-summary]').forEach((el) => el.hidden = el.dataset.summary !== savedPosting);
      } else {
        assignmentResult.hidden = true;
        missingAssignment.hidden = false;
        noContinent.hidden = false;
        incidentFiles.hidden = true;
        pollutantFiles.hidden = true;
        summaryFiles.hidden = true;
      }

      document.getElementById('print-mission5-board')?.addEventListener('click', () => {
        document.body.classList.add('print-mission5-board');
        window.print();
      });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-mission5-board'));
    })();
  </script>
</BaseLayout>

<style>
