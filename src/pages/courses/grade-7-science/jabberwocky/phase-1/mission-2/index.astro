---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecMissionProgress from '../../../../../../components/JcecMissionProgress.astro';
import { operation03Species } from '../../../../../../data/jabberwockyOperation03';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';

const continentIcons: Record<string, string> = {
  gyre: '⛰️',
  brillig: '🌿',
  manxome: '🏝️',
  'slithy-toves': '🏜️',
  wabe: '❄️',
  bandersnatch: '🌾',
  gimble: '🌲',
  mimsy: '🪷'
};

const missionSpecies = operation03Species.map((species) => ({
  ...species,
  icon: continentIcons[species.id],
  clues: species.clues.slice(0, 4)
}));
---

<BaseLayout title="Mission 2: Meet a Native Species | Jabberwocky 2190" description="A simplified Grade 7 Science mission about structure, function, adaptations, and organism needs." themeColor="#071b2e">
  <div class="mission-shell" id="simplified-mission-2">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Mission 2' }
    ]} />

    <JcecMissionProgress active={2} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">MISSION 2 OF 5</p>
        <h1>MEET A NATIVE <span>SPECIES</span></h1>
        <p class="question">How does this organism survive here?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How features help organisms survive</strong>
        <small>3 classes × 45 minutes</small>
      </aside>
    </header>

    <nav class="step-nav" aria-label="Mission 2 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing">
        <p>Something is moving near your base camp. JCEC sensors have detected a native Jabberwocky organism, but scientists do not yet know much about it. Your team will first investigate how different body structures can help organisms survive. Then you will use clues from your continent to work out what the native species is like and how its features help it survive.</p>
      </div>

      <div class="assignment-box" id="assignment-box">
        <div class="assignment-result" id="assignment-result" hidden>
          <span id="assignment-icon" aria-hidden="true"></span>
          <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
          <div class="species-box"><small>NATIVE SPECIES</small><b id="assignment-species"></b></div>
        </div>
        <div class="missing-assignment" id="missing-assignment" hidden>
          <strong>Your continent is not saved on this device yet.</strong>
          <p>Go back to Mission 1 and choose the continent your teacher assigned.</p>
          <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a>
        </div>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">You only need four ideas for this mission.</p>
      <div class="science-grid">
        <article><span>🦶</span><strong>Structure</strong><p>A body part or physical feature.</p></article>
        <article><span>⚙️</span><strong>Function</strong><p>What a structure does or helps an organism do.</p></article>
        <article><span>🛡️</span><strong>Adaptation</strong><p>A feature or behaviour that helps an organism survive.</p></article>
        <article><span>💧</span><strong>Needs</strong><p>Things organisms require, such as food, water, shelter, space and suitable conditions.</p></article>
      </div>
      <details class="help-box">
        <summary>Need a quick example?</summary>
        <div><p><strong>Structure:</strong> a duck's webbed feet.</p><p><strong>Function:</strong> the feet push against water.</p><p><strong>How it helps:</strong> they help the duck swim to find food and move through its habitat.</p></div>
      </details>
      <details class="help-box subtle-help">
        <summary>Learn more: What is a niche?</summary>
        <div><p>A <strong>niche</strong> is an organism's way of living in an ecosystem—where it lives, what it uses, and how it interacts with its surroundings. You do not need this word to complete Mission 2.</p></div>
      </details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–2</p><h2>Investigate</h2></div></div>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 1</small><h3>Survival Structures Lab</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> Which structure works best in which environment?</p>

        <div class="lab-setup">
          <div><strong>Structures</strong><span>spoon · tweezers · clothespin/tongs · chopsticks</span></div>
          <div><strong>Resource zones</strong><span>open ground · narrow spaces · tangled cover</span></div>
        </div>

        <ol class="simple-procedure">
          <li>Set up the three resource zones your teacher gives you.</li>
          <li>Use one structure for the same amount of time in each trial.</li>
          <li>Count how many resources you can move to the collection cup.</li>
          <li>Repeat with every structure using the <strong>same time, resources and rules</strong>.</li>
          <li>Compare your results. Decide which structure worked best in each environment.</li>
        </ol>

        <div class="fair-test"><strong>Keep it fair.</strong><span>Change the structure. Keep the time, resource amount and rules the same.</span></div>
        <button type="button" class="small-button secondary" id="print-mission2-packet">Print Mission 2 lab + species card</button>
      </section>

      <section class="investigation-block species-investigation">
        <div class="block-title"><div><small>CLASS 2</small><h3>First Contact</h3></div><span>TEAM WORK</span></div>
        <p class="evidence-rule"><strong>EVIDENCE FIRST — IMAGINATION SECOND.</strong> Your drawing can be creative, but important features must come from the clues.</p>

        <div class="no-continent" id="no-continent"><strong>Mission 1 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a></div>
        <div id="species-files" hidden>
          {missionSpecies.map((species) => (
            <article class="species-file" data-species={species.id} hidden>
              <header>
                <span aria-hidden="true">{species.icon}</span>
                <div><small>{species.name} · {species.baseCamp}</small><h3>{species.fieldName}</h3><p>{species.contactZone}</p></div>
              </header>

              <div class="clue-grid">
                {species.clues.map((clue, index) => (
                  <article class="clue-card"><b>{index + 1}</b><div><small>{clue.source}</small><p>{clue.observation}</p></div></article>
                ))}
              </div>

              <div class="reconstruct-box">
                <strong>Reconstruct the species.</strong>
                <p>On your Native Species Card, draw the organism and label two or three features that are supported by these clues.</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 3</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which adaptation is most important for helping your native species survive on your continent?</h3>
        <div class="reasoning-frame">
          <div><strong>Feature</strong><span>What structure or behaviour?</span></div>
          <div><strong>Evidence</strong><span>Which clue supports it?</span></div>
          <div><strong>How it helps</strong><span>How does it help the organism survive?</span></div>
        </div>
        <div class="example-frame"><b>Example</b><span><strong>Feature:</strong> Wide feet</span><span><strong>Evidence:</strong> Tracks are broad and the ground is soft.</span><span><strong>How it helps:</strong> Wide feet may stop the animal from sinking.</span></div>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 3</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one person records</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <form class="team-record" id="team-record-form">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Native Species Card</h3></div><span>ONE PER TEAM</span></div>
        <label>Species name<input id="record-species" readonly placeholder="Your Mission 1 continent will load this" /></label>
        <div class="sketch-reminder"><span>✏️</span><div><strong>Add a simple sketch.</strong><p>Draw it on the printed Native Species Card or in the place your teacher gives you. Label the important features.</p></div></div>

        <div class="adaptation-table">
          <div class="adaptation-head"><span>Feature / adaptation</span><span>Evidence</span><span>How it helps</span></div>
          {[1, 2, 3].map((number) => (
            <div class="adaptation-row">
              <input id={`adaptation-${number}`} maxlength="90" aria-label={`Adaptation ${number}`} placeholder={number === 1 ? 'Most important feature' : `Feature ${number}`} />
              <input id={`evidence-${number}`} maxlength="150" aria-label={`Evidence ${number}`} placeholder="Clue or observation" />
              <input id={`helps-${number}`} maxlength="180" aria-label={`How adaptation ${number} helps`} placeholder="How it helps survival" />
            </div>
          ))}
        </div>

        <p class="record-note"><strong>Two strong adaptations are enough.</strong> Add a third if your team has clear evidence for it.</p>
        <div class="record-actions"><button type="submit" class="primary-button">Save Team Record</button><button type="button" class="small-button secondary" id="copy-team-record">Copy Team Record</button></div>
        <p class="save-status" id="record-status" role="status"></p>
      </form>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>Which clue helped you understand your organism the most? Why?</h3>
        <p>Everyone answers this question individually in the place your teacher uses for reflections.</p>
      </div>

      <details class="online-submit">
        <summary>Did your teacher tell one person to submit the Team Record online?</summary>
        <div><p>Use the same Native Species Card answers. You do not need to create another report.</p><a href={portalUrl} target="_blank" rel="noopener noreferrer">Open JCEC submission portal ↗</a></div>
      </details>

      <div class="finished-box">
        <strong>Mission 2 is finished when:</strong>
        <span>✓ your team has one Native Species Card with a sketch and at least two evidence-based adaptations</span>
        <span>✓ you answered the short reflection</span>
        <p>Mission 3 stays locked until your teacher is ready.</p>
      </div>
    </section>

    <section class="print-packet" aria-label="Mission 2 printable lab and Native Species Card">
      <section class="print-page">
        <h1>Mission 2 — Survival Structures Lab</h1>
        <p>Team: ________________________________ &nbsp; Date: ____________</p>
        <table><thead><tr><th>Structure</th><th>Open Ground</th><th>Narrow Spaces</th><th>Tangled Cover</th></tr></thead><tbody><tr><th>Spoon</th><td></td><td></td><td></td></tr><tr><th>Tweezers</th><td></td><td></td><td></td></tr><tr><th>Clothespin / tongs</th><td></td><td></td><td></td></tr><tr><th>Chopsticks</th><td></td><td></td><td></td></tr></tbody></table>
        <p><strong>Which structure worked best in each environment?</strong></p><div class="print-lines"></div>
        <p><strong>What did this lab teach you about structure and function?</strong></p><div class="print-lines"></div>
      </section>
      <section class="print-page">
        <h1>Mission 2 — Native Species Card</h1>
        <p>Continent: ________________________________ &nbsp; Species: ________________________________</p>
        <div class="print-sketch"><strong>Scientific sketch</strong><span>Draw and label the features supported by evidence.</span></div>
        <table><thead><tr><th>Feature / adaptation</th><th>Evidence</th><th>How it helps survival</th></tr></thead><tbody><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></tbody></table>
        <p><strong>Most important adaptation:</strong></p><div class="print-lines"></div>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ speciesData: missionSpecies }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase1-posting';
      const RECORD_KEY = 'jabberwocky-mission2-team-record';
      const speciesById = Object.fromEntries(speciesData.map((species) => [species.id, species]));
      const selectedId = localStorage.getItem(POSTING_KEY);
      const selected = selectedId ? speciesById[selectedId] : null;

      const assignmentResult = document.getElementById('assignment-result');
      const missingAssignment = document.getElementById('missing-assignment');
      const speciesFiles = document.getElementById('species-files');
      const noContinent = document.getElementById('no-continent');
      const recordSpecies = document.getElementById('record-species');

      if (selected) {
        assignmentResult.hidden = false;
        missingAssignment.hidden = true;
        document.getElementById('assignment-icon').textContent = selected.icon;
        document.getElementById('assignment-name').textContent = selected.name;
        document.getElementById('assignment-environment').textContent = `${selected.baseCamp} · ${selected.environment}`;
        document.getElementById('assignment-species').textContent = selected.fieldName;
        speciesFiles.hidden = false;
        noContinent.hidden = true;
        document.querySelectorAll('[data-species]').forEach((el) => el.hidden = el.dataset.species !== selectedId);
        recordSpecies.value = selected.fieldName;
      } else {
        assignmentResult.hidden = true;
        missingAssignment.hidden = false;
        speciesFiles.hidden = true;
        noContinent.hidden = false;
      }

      const fields = [1, 2, 3].flatMap((number) => [`adaptation-${number}`, `evidence-${number}`, `helps-${number}`]);
      const saved = (() => { try { return JSON.parse(localStorage.getItem(RECORD_KEY) || 'null'); } catch { return null; } })();
      if (saved) fields.forEach((id) => { const el = document.getElementById(id); if (el) el.value = saved[id] || ''; });

      const getRecord = () => {
        const record = { species: recordSpecies?.value?.trim() || '' };
        fields.forEach((id) => record[id] = document.getElementById(id)?.value?.trim() || '');
        return record;
      };

      const hasTwoCompleteAdaptations = (record) => [1, 2, 3].filter((number) => record[`adaptation-${number}`] && record[`evidence-${number}`] && record[`helps-${number}`]).length >= 2;

      document.getElementById('team-record-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const record = getRecord();
        const status = document.getElementById('record-status');
        if (!record.species) { status.textContent = 'Return to Mission 1 and choose your assigned continent first.'; return; }
        if (!hasTwoCompleteAdaptations(record)) { status.textContent = 'Complete at least two full adaptation rows first.'; return; }
        localStorage.setItem(RECORD_KEY, JSON.stringify(record));
        status.textContent = '✓ Native Species Card saved on this device.';
      });

      document.getElementById('copy-team-record')?.addEventListener('click', async () => {
        const record = getRecord();
        const status = document.getElementById('record-status');
        if (!record.species || !hasTwoCompleteAdaptations(record)) { status.textContent = 'Complete at least two full adaptation rows first.'; return; }
        const lines = [1, 2, 3].filter((number) => record[`adaptation-${number}`] && record[`evidence-${number}`] && record[`helps-${number}`]).map((number) => `Adaptation ${number}: ${record[`adaptation-${number}`]}\nEvidence: ${record[`evidence-${number}`]}\nHow it helps: ${record[`helps-${number}`]}`);
        const text = `MISSION 2 — NATIVE SPECIES CARD\nContinent: ${selected?.name || ''}\nSpecies: ${record.species}\n\n${lines.join('\n\n')}`;
        try { await navigator.clipboard.writeText(text); status.textContent = '✓ Team Record copied.'; }
        catch { status.textContent = 'Copy was blocked. Your answers are still on the page.'; }
      });

      document.getElementById('print-mission2-packet')?.addEventListener('click', () => { document.body.classList.add('print-mission2-packet'); window.print(); });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-mission2-packet'));
    })();
  </script>
</BaseLayout>

<style>
  :global(body){background:#06111f}.mission-shell{max-width:1050px;margin:0 auto;padding:0 1rem 5rem;color:#eaf5ff}.mission-shell :global(.breadcrumbs){color:#9eb6c4}.mission-shell :global(.breadcrumbs a){color:#d7ecf5}:global(body:has(#simplified-mission-2) .jcec-submission-dock),:global(body:has(#simplified-mission-2) .jcec-device-tools){display:none!important}.eyebrow,.mini-label{margin:0;color:#74e9cb;font:850 .73rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.mission-hero{display:grid;grid-template-columns:1fr 255px;gap:1.25rem;align-items:end;margin:.8rem 0 1rem;padding:clamp(1.35rem,4vw,2.25rem);border:1px solid #2d6070;border-radius:22px;background:radial-gradient(circle at 82% 18%,rgba(110,242,207,.14),transparent 26%),linear-gradient(145deg,#071727,#0a2939)}.mission-hero h1{margin:.45rem 0;color:#fff;font-size:clamp(2.5rem,7vw,5.1rem);line-height:.88;letter-spacing:-.05em}.mission-hero h1 span{display:block;color:#6ef2cf}.question{margin:.8rem 0 0;color:#d5e8ef;font-size:1.25rem;font-weight:750}.mission-hero aside{display:grid;gap:.18rem;padding:.9rem;border:1px solid #315b69;border-radius:13px;background:#071923}.mission-hero aside span{color:#7ed7c4;font-size:.68rem;font-weight:900;letter-spacing:.08em}.mission-hero aside strong{color:#fff}.mission-hero aside small{color:#95adba}.step-nav{position:sticky;top:.55rem;z-index:20;display:grid;grid-template-columns:repeat(5,1fr);gap:.35rem;margin:1rem 0;padding:.4rem;border:1px solid #294958;border-radius:13px;background:rgba(6,22,32,.96);backdrop-filter:blur(8px)}.step-nav a{display:flex;gap:.4rem;align-items:center;padding:.55rem;border-radius:9px;color:#afc4cf;text-decoration:none;font-size:.78rem;font-weight:850}.step-nav a:hover{background:#0d3040;color:#fff}.step-nav b{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#163444;color:#9dc0ce}.simple-step{margin:1rem 0;padding:clamp(1rem,3vw,1.45rem);scroll-margin-top:5.2rem;border:1px solid #244a5