---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecMissionProgress from '../../../../../../components/JcecMissionProgress.astro';
import { operation04Networks } from '../../../../../../data/jabberwockyOperation04';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';

const continentIcons: Record<string, string> = {
  gyre: '⛰️',
  brillig: '🌿',
  manxome: '🏝️',
  'slithy-toves': '🏜️',
  wabe: '❄️',
  bandersnatch: '🌾',
  gimble: '🌲',
  mimsy: '🪷'
};

const missionNetworks = operation04Networks.map((network) => {
  const nodes = network.id === 'mimsy'
    ? network.nodes.filter((node) => node.name !== 'Surface Skimmer')
    : network.nodes;
  const allowedNames = new Set(nodes.map((node) => node.name));
  const feedingLinks = network.feedingLinks
    .filter((link) => allowedNames.has(link.food) && allowedNames.has(link.eater))
    .slice(0, 6);
  const focalFoodLink = feedingLinks.find((link) => link.eater === network.focalSpecies);
  const cycleProducer = focalFoodLink?.food ?? nodes.find((node) => node.role === 'producer')?.name ?? 'producer';
  const decomposer = nodes.find((node) => node.role === 'decomposer')?.name ?? 'decomposer';

  return {
    ...network,
    icon: continentIcons[network.id],
    nodes,
    feedingLinks,
    cycleProducer,
    decomposer
  };
});

const practiceCards = [
  { name: 'Grass', role: 'Producer', icon: '🌱' },
  { name: 'Berry Shrub', role: 'Producer', icon: '🫐' },
  { name: 'Rabbit', role: 'Consumer', icon: '🐇' },
  { name: 'Grasshopper', role: 'Consumer', icon: '🦗' },
  { name: 'Mouse', role: 'Consumer', icon: '🐁' },
  { name: 'Hawk', role: 'Consumer', icon: '🦅' },
  { name: 'Fungi & Bacteria', role: 'Decomposer', icon: '🍄' }
];

const practiceLinks = [
  'Rabbit eats Grass.',
  'Grasshopper eats Grass.',
  'Mouse eats berries and seeds from the Berry Shrub.',
  'Hawk eats Rabbit.',
  'Hawk eats Mouse.',
  'Mouse sometimes eats Grasshoppers.'
];
---

<BaseLayout title="Mission 3: Build the Ecosystem | Jabberwocky 2190" description="A simplified Grade 7 Science mission about food webs, energy flow, and matter cycling." themeColor="#071b2e">
  <div class="mission-shell" id="simplified-mission-3">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Mission 3' }
    ]} />

    <JcecMissionProgress active={3} compact={true} />

    <header class="mission-hero">
      <div>
        <p class="eyebrow">MISSION 3 OF 5</p>
        <h1>BUILD THE <span>ECOSYSTEM</span></h1>
        <p class="question">How are living things connected?</p>
      </div>
      <aside>
        <span>YOU ARE LEARNING</span>
        <strong>How energy and matter connect ecosystems</strong>
        <small>4 classes × 45 minutes</small>
      </aside>
    </header>

    <nav class="step-nav" aria-label="Mission 3 steps">
      <a href="#your-mission"><b>1</b><span>Your Mission</span></a>
      <a href="#learn"><b>2</b><span>Learn</span></a>
      <a href="#investigate"><b>3</b><span>Investigate</span></a>
      <a href="#decide"><b>4</b><span>Decide</span></a>
      <a href="#record"><b>5</b><span>Record It</span></a>
    </nav>

    <section class="simple-step" id="your-mission">
      <div class="step-heading"><span>1</span><div><p>CLASS 1</p><h2>Your Mission</h2></div></div>
      <div class="briefing">
        <p>Your native species is not surviving alone. JCEC sensors have detected plants, animals, decomposers and other organisms across your continent. Your team must figure out how these organisms are connected. Then you will test what could happen if one part of the ecosystem changes.</p>
      </div>

      <div class="assignment-box">
        <div class="assignment-result" id="assignment-result" hidden>
          <span id="assignment-icon" aria-hidden="true"></span>
          <div><small>YOUR CONTINENT</small><strong id="assignment-name"></strong><p id="assignment-environment"></p></div>
          <div class="species-box"><small>FROM MISSION 2</small><b id="assignment-species"></b></div>
        </div>
        <div class="missing-assignment" id="missing-assignment" hidden>
          <strong>Your continent is not saved on this device yet.</strong>
          <p>Go back to Mission 1 and choose the continent your teacher assigned.</p>
          <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a>
        </div>
      </div>
    </section>

    <section class="simple-step" id="learn">
      <div class="step-heading"><span>2</span><div><p>CLASS 1</p><h2>Learn the Science</h2></div></div>
      <p class="step-intro">Start with four ideas.</p>
      <div class="science-grid">
        <article><span>🌿</span><strong>Producer</strong><p>Makes its own food, usually using sunlight.</p></article>
        <article><span>🐾</span><strong>Consumer</strong><p>Gets energy by eating other organisms.</p></article>
        <article><span>🍄</span><strong>Decomposer</strong><p>Breaks down dead material and returns matter to the environment.</p></article>
        <article><span>🕸️</span><strong>Food web</strong><p>Shows many feeding connections in an ecosystem.</p></article>
      </div>

      <div class="big-ideas">
        <article><strong>⚡ Energy flows.</strong><p>Energy enters through producers and moves to consumers.</p></article>
        <article><strong>♻️ Matter cycles.</strong><p>Water and carbon can be reused as they move through living and non-living parts of an ecosystem.</p></article>
      </div>

      <div class="arrow-rule">
        <span>FOOD</span><b>→</b><span>EATER</span>
        <p>The arrow points where the energy goes. Example: <strong>grass → rabbit</strong>.</p>
      </div>

      <details class="help-box">
        <summary>Need help remembering the arrow direction?</summary>
        <div><p>Read the arrow as <strong>“gives energy to.”</strong> Grass gives energy to a rabbit when the rabbit eats it, so the arrow is <strong>grass → rabbit</strong>.</p></div>
      </details>
    </section>

    <section class="simple-step" id="investigate">
      <div class="step-heading"><span>3</span><div><p>CLASSES 1–4</p><h2>Investigate</h2></div></div>

      <section class="investigation-block">
        <div class="block-title"><div><small>CLASS 1</small><h3>String Food Web</h3></div><span>TEAM WORK</span></div>
        <p><strong>Question:</strong> What happens when one part of a food web changes?</p>

        <div class="practice-cards" aria-label="Earth practice food web organisms">
          {practiceCards.map((card) => <article><span aria-hidden="true">{card.icon}</span><strong>{card.name}</strong><small>{card.role}</small></article>)}
        </div>

        <details class="help-box feeding-clues" open>
          <summary>Earth feeding clues</summary>
          <div>{practiceLinks.map((link) => <p>• {link}</p>)}</div>
        </details>

        <ol class="simple-procedure">
          <li>Place the organism cards where everyone can see them.</li>
          <li>Use string to connect each <strong>food to its eater</strong>.</li>
          <li>Put an arrow beside each string so it points <strong>food → eater</strong>.</li>
          <li>Remove or cover the <strong>Grass</strong> card. Notice which connections are affected.</li>
          <li>Discuss what might change next in the web.</li>
        </ol>

        <div class="model-note"><strong>A model helps us predict.</strong><span>It does not prove exactly what will happen in nature.</span></div>
        <button type="button" class="small-button secondary" id="print-mission3-packet">Print practice cards + Ecosystem Map</button>
      </section>

      <section class="investigation-block continent-investigation">
        <div class="block-title"><div><small>CLASS 2</small><h3>Build Your Continent Food Web</h3></div><span>TEAM WORK</span></div>
        <p>Your continent file has only the organisms and feeding clues you need for this mission.</p>

        <div class="no-continent" id="no-continent"><strong>Mission 1 continent not found.</strong><a href={`${base}courses/grade-7-science/jabberwocky/phase-1/mission-1/`}>Return to Mission 1 →</a></div>
        <div id="network-files" hidden>
          {missionNetworks.map((network) => (
            <article class="network-file" data-network={network.id} hidden>
              <header>
                <span aria-hidden="true">{network.icon}</span>
                <div><small>{network.name} · {network.baseCamp}</small><h3>{network.environment}</h3><p>Your Mission 2 species: <strong>{network.focalSpecies}</strong></p></div>
              </header>

              <div class="organism-grid">
                {network.nodes.map((node) => (
                  <article class:list={['organism-card', node.role, { focal: node.name === network.focalSpecies }]}>
                    <strong>{node.name}</strong>
                    <span>{node.role}</span>
                    {node.name === network.focalSpecies && <small>MISSION 2 SPECIES</small>}
                  </article>
                ))}
              </div>

              <div class="feeding-evidence">
                <div class="evidence-heading"><strong>Six feeding clues</strong><span>Decide the arrow direction for each clue.</span></div>
                {network.feedingLinks.map((link, index) => (
                  <article><b>{index + 1}</b><div><strong>{link.food} + {link.eater}</strong><p>{link.evidence}</p></div></article>
                ))}
              </div>

              <div class="decomposer-note"><strong>{network.decomposer}</strong><span>breaks down dead material and waste from the ecosystem. Add it to your map and label it as the decomposer.</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="investigation-block change-block">
        <div class="block-title"><div><small>CLASS 3</small><h3>Change the Web</h3></div><span>TEAM WORK</span></div>
        <p>Use the change for your continent. Cover or mark the organism or resource that changes, then follow the connected arrows.</p>
        <div id="change-files" hidden>
          {missionNetworks.map((network) => (
            <article class="change-file" data-change={network.id} hidden>
              <strong>What changed?</strong>
              <p>{network.changeChallenge.replace(/Predict.*$/i, '').trim()}</p>
              <div class="sentence-frame"><span>If this changes, then</span><b>__________</b><span>may change because</span><b>__________.</b></div>
            </article>
          ))}
        </div>
        <p class="change-reminder">Choose <strong>one clear likely effect</strong>. You do not need to explain every possible change.</p>
      </section>

      <section class="investigation-block matter-block">
        <div class="block-title"><div><small>CLASS 4</small><h3>Matter Moves Too</h3></div><span>TEAM WORK</span></div>
        <p>Add two simple paths to the same Ecosystem Map. You are showing the big idea—not memorizing a complicated cycle diagram.</p>

        <div id="cycle-files" hidden>
          {missionNetworks.map((network) => (
            <article class="cycle-file" data-cycle={network.id} hidden>
              <div class="cycle-path water"><span>💧 WATER PATH</span><strong>water in environment → {network.cycleProducer} → {network.focalSpecies} → waste/dead matter → environment</strong></div>
              <div class="cycle-path carbon"><span>♻️ CARBON PATH</span><strong>carbon dioxide → {network.cycleProducer} → {network.focalSpecies} → waste/dead matter → {network.decomposer} → carbon dioxide</strong></div>
            </article>
          ))}
        </div>

        <div class="flow-cycle-compare"><div><strong>Energy</strong><span>moves through the web</span></div><b>≠</b><div><strong>Matter</strong><span>can be reused and cycled</span></div></div>
      </section>
    </section>

    <section class="simple-step" id="decide">
      <div class="step-heading"><span>4</span><div><p>CLASS 4</p><h2>Make a Decision</h2></div></div>
      <div class="decision-card">
        <p class="mini-label">ONE TEAM QUESTION</p>
        <h3>Which connection in your ecosystem would cause the biggest problem if it were disrupted?</h3>
        <div class="sentence-frame large"><span>If this changes, then</span><b>__________</b><span>may change because</span><b>__________.</b></div>
        <p class="decision-note">Use one connection from your Ecosystem Map. A clear explanation is more important than a long answer.</p>
      </div>
    </section>

    <section class="simple-step" id="record">
      <div class="step-heading"><span>5</span><div><p>CLASS 4</p><h2>Record It</h2></div></div>
      <div class="handoff-strip"><span>👥 <strong>TEAM WORK</strong> discuss</span><i>→</i><span>📝 <strong>TEAM RECORD</strong> one map</span><i>→</i><span>💭 <strong>MY REFLECTION</strong> everyone answers</span></div>

      <div class="team-record map-record">
        <div class="record-heading"><div><p class="mini-label">TEAM RECORD</p><h3>Ecosystem Map</h3></div><span>ONE PER TEAM</span></div>
        <p>Use your printed map or the paper your teacher gives you. This is the only team product for Mission 3.</p>
        <div class="map-checklist">
          <label><input type="checkbox" /> continent name + key organisms</label>
          <label><input type="checkbox" /> producer / consumer / decomposer labels</label>
          <label><input type="checkbox" /> 5–7 food-web arrows pointing food → eater</label>
          <label><input type="checkbox" /> one simple water path</label>
          <label><input type="checkbox" /> one simple carbon path</label>
          <label><input type="checkbox" /> one connection your team thinks should be protected</label>
        </div>
        <div class="map-note"><strong>Write your team decision on the map:</strong><span>If this changes, then ______ may change because ______.</span></div>
      </div>

      <div class="reflection-card">
        <p class="mini-label">MY REFLECTION</p>
        <h3>Which organism would cause the biggest change if it disappeared? Explain one connection.</h3>
        <p>Everyone answers this question individually in the place your teacher uses for reflections.</p>
      </div>

      <details class="online-submit">
        <summary>Did your teacher tell one person to submit the Team Record online?</summary>
        <div><p>Use the same Ecosystem Map. Enter your protected connection as the team decision, use one arrow or cycle path as evidence, and explain the likely effect. Do not create another report.</p><a href={portalUrl} target="_blank" rel="noopener noreferrer">Open JCEC submission portal ↗</a></div>
      </details>

      <div class="finished-box">
        <strong>Mission 3 is finished when:</strong>
        <span>✓ your team has one Ecosystem Map with food-web arrows, water and carbon paths, and one protected connection</span>
        <span>✓ you answered the short reflection</span>
        <p>Mission 4 stays locked until your teacher is ready.</p>
      </div>
    </section>

    <section class="print-packet" aria-label="Mission 3 printable food-web cards and Ecosystem Map">
      <section class="print-page">
        <h1>Mission 3 — Earth String Food Web</h1>
        <p>Cut out or place these cards. Use string to connect <strong>food → eater</strong>.</p>
        <div class="print-card-grid">
          {practiceCards.map((card) => <article><strong>{card.name}</strong><span>{card.role}</span></article>)}
        </div>
        <h2>Feeding clues</h2>
        {practiceLinks.map((link) => <p>• {link}</p>)}
        <p><strong>Stress test:</strong> Cover the Grass card. Which connections are affected first?</p>
        <div class="print-lines"></div>
      </section>

      <section class="print-page ecosystem-map-sheet">
        <h1>Mission 3 — Ecosystem Map</h1>
        <p>Continent: ________________________________ &nbsp; Team: ________________________________</p>
        <div class="map-space"><strong>Build your food web here.</strong><span>Label producers, consumers and decomposer. Draw 5–7 arrows food → eater.</span></div>
        <div class="cycle-print-row"><div><strong>Water path</strong><p>environment → __________ → __________ → environment</p></div><div><strong>Carbon path</strong><p>carbon dioxide → __________ → __________ → decomposer → carbon dioxide</p></div></div>
        <p><strong>Connection we think should be protected:</strong></p><div class="print-lines"></div>
        <p><strong>If this changes, then __________________ may change because ________________________________.</strong></p>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ networkData: missionNetworks }}>
    (() => {
      const POSTING_KEY = 'jabberwocky-phase1-posting';
      const networks = Object.fromEntries(networkData.map((network) => [network.id, network]));
      const savedPosting = localStorage.getItem(POSTING_KEY);
      const network = savedPosting ? networks[savedPosting] : null;

      const assignmentResult = document.getElementById('assignment-result');
      const missingAssignment = document.getElementById('missing-assignment');
      const noContinent = document.getElementById('no-continent');
      const networkFiles = document.getElementById('network-files');
      const changeFiles = document.getElementById('change-files');
      const cycleFiles = document.getElementById('cycle-files');

      if (network) {
        assignmentResult.hidden = false;
        missingAssignment.hidden = true;
        document.getElementById('assignment-icon').textContent = network.icon;
        document.getElementById('assignment-name').textContent = network.name;
        document.getElementById('assignment-environment').textContent = `${network.baseCamp} · ${network.environment}`;
        document.getElementById('assignment-species').textContent = network.focalSpecies;
        noContinent.hidden = true;
        networkFiles.hidden = false;
        changeFiles.hidden = false;
        cycleFiles.hidden = false;
        document.querySelectorAll('[data-network]').forEach((el) => el.hidden = el.dataset.network !== savedPosting);
        document.querySelectorAll('[data-change]').forEach((el) => el.hidden = el.dataset.change !== savedPosting);
        document.querySelectorAll('[data-cycle]').forEach((el) => el.hidden = el.dataset.cycle !== savedPosting);
      } else {
        assignmentResult.hidden = true;
        missingAssignment.hidden = false;
        noContinent.hidden = false;
        networkFiles.hidden = true;
        changeFiles.hidden = true;
        cycleFiles.hidden = true;
      }

      document.getElementById('print-mission3-packet')?.addEventListener('click', () => {
        document.body.classList.add('print-mission3-packet');
        window.print();
      });
      window.addEventListener('afterprint', () => document.body.classList.remove('print-mission3-packet'));
    })();
  </script>
</BaseLayout>

<style>
