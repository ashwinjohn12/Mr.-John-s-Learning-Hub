---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;
const route = (part='') => `${base}courses/grade-7-science/jabberwocky/phase-1/${part}`;

const days = [
  {d:1,type:'CORE',focus:'M1 — Welcome + Team Setup',task:'Teams create and save Team Profile first. Teacher confirms Team Directory, assigns continent, students save it, then begin Mission 1.',record:'Team Profile; baseline prediction only.',sheet:'Team Directory one row/team; Team Profile ✓; continent appears after save.',cut:'Cut extended story/continent sharing. Protect Team Setup + continent save.'},
  {d:2,type:'CORE',focus:'M1 — Earth Environmental Survey',task:'Sample 3 microhabitats; record conditions, evidence of life and human impact; observation vs inference.',record:'Field sheet — formative.',sheet:'No new mission ✓ expected.',cut:'Drop optional instruments/extra sites.'},
  {d:3,type:'CORE',focus:'M1 — Explore Your Continent',task:'Analyze continent evidence using I noticed… / I think this means…; finish Environment Profile.',record:'Environment Profile — final M1 Team Record.',sheet:'M1 ✓.',cut:'Cut whole-class comparison.'},
  {d:4,type:'CORE',focus:'M2 — How Structures Help',task:'Survival Structures Lab; fair comparison of structure/function/adaptation.',record:'Lab observations — formative.',sheet:'No new ✓ expected.',cut:'Cut extended oral defence.'},
  {d:5,type:'CORE',focus:'M2 — First Contact',task:'Use four clues to infer structures/behaviours; begin species reconstruction.',record:'Reconstruction in progress.',sheet:'No new ✓ expected.',cut:'Cut artistic detail.'},
  {d:6,type:'CORE',focus:'M2 — Reconstruct the Species',task:'Finish reconstruction; Feature → Evidence → How it helps; complete Native Species Card.',record:'Native Species Card — final M2 Team Record.',sheet:'M2 ✓.',cut:'Move gallery walk/art polish/niche extension to flex.'},
  {d:7,type:'CORE',focus:'M3 — How Food Webs Work',task:'Physical food web; producer/consumer/decomposer; arrows food → eater; change one component.',record:'Quick formative explanation.',sheet:'No new ✓ expected.',cut:'Cut extra pathways/symbiosis terminology.'},
  {d:8,type:'CORE',focus:'M3 — Build Your Continent Food Web',task:'Build a correct 5–7-arrow network including focal species and decomposer.',record:'Ecosystem Map in progress.',sheet:'No new ✓ expected.',cut:'Cut extra organisms/links.'},
  {d:9,type:'CORE',focus:'M3 — What Happens When the Web Changes?',task:'Build one defensible cause-effect chain: If… then… because….',record:'Brief reasoning check.',sheet:'No new ✓ expected.',cut:'Cut multiple scenarios.'},
  {d:10,type:'CORE',focus:'M3 — Matter Moves Too',task:'Add water + carbon paths; distinguish energy flow from matter cycling; complete compact Teacher Report Copy.',record:'Full Ecosystem Map stays paper; digital Teacher Report Copy is M3 checkpoint.',sheet:'M3 ✓.',cut:'Cut decorative diagramming/extra cycles.'},
  {d:11,type:'CORE',focus:'M4 — Population Sampling',task:'Compare samples from spread-out vs clustered populations.',record:'Sampling record — formative.',sheet:'No new ✓ expected.',cut:'Cut repeated trials.'},
  {d:12,type:'CORE',focus:'M4 — Your Population Case',task:'Interpret two graphs + two field notes; connect population and environmental evidence.',record:'Quick team interpretation.',sheet:'No new ✓ expected.',cut:'Cut cross-continent comparison.'},
  {d:13,type:'CORE',focus:'M4 — Disturbance and Recovery',task:'Compare recovery timeline; succession is gradual and may be incomplete.',record:'Recovery evidence for M4 claim.',sheet:'No new ✓ expected.',cut:'Cut extra monitoring indicators.'},
  {d:14,type:'CORE',focus:'M4 — Earth Connection + Decision',task:'Use local evidence and a specific authentic community/Indigenous source where appropriate; finish evidence-based M4 claim.',record:'Ecosystem Change Record — final M4 Team Record.',sheet:'M4 ✓.',cut:'Move unfinished record to Day 15; cut formal presentation.'},
  {d:15,type:'FLEX',focus:'Fieldwork / M4 recovery',task:'Weather recovery, M4 absence recovery, sampling/succession reteach, then vocabulary if needed.',record:'Recover missing M1–M4 records only.',sheet:'Use Missing Records + Mission Progress.',cut:'Bank unused time as interruption buffer.'},
  {d:16,type:'CORE',focus:'M5 — The Incident',task:'Stowaway Spread simulation; compare spread without vs with early checkpoint; introduced ≠ invasive.',record:'Simulation record — formative.',sheet:'No M5 ✓ yet.',cut:'Cut repeated rounds.'},
  {d:17,type:'CORE',focus:'M5 — What Happens Next?',task:'Use spread + harm evidence; model biomagnification; distinguish local vs global extinction.',record:'No separate major submission.',sheet:'No M5 ✓ yet.',cut:'Cut extra clues/second pollutant scenario.'},
  {d:18,type:'CORE',focus:'M5 — What Should Humans Do?',task:'Use M1–M4 evidence to build Recommendation Board: importance, species, connection, risk, 3 evidence items, rule, recommendation.',record:'Recommendation Board in progress.',sheet:'No M5 ✓ yet.',cut:'Cut artistic polish/extended peer critique.'},
  {d:19,type:'CORE',focus:'M5 — JCEC Recommendation',task:'Finish Board; Decision → Evidence → Possible consequence; individual reflection; save digital Teacher Report Copy.',record:'Recommendation Board — major synthesis; digital M5 checkpoint.',sheet:'M5 ✓; complete teams show 6/6 Complete.',cut:'Move presentations to Day 24.'},
  {d:20,type:'FLEX',focus:'Completion / absence recovery',task:'Finish essential M5 synthesis or recover missed essential work.',record:'Complete missing Team Records.',sheet:'Missing Records; verify new ✓ and 6/6.',cut:'If complete, use for feedback instead of new required work.'},
  {d:21,type:'FLEX',focus:'Whole-unit science review',task:'Retrieval, diagrams, evidence interpretation and recurring misconceptions.',record:'No required team record.',sheet:'Missing Records only if needed.',cut:'Prioritize misconceptions over every term.'},
  {d:22,type:'FLEX',focus:'Short individual science check',task:'Optional concise individual evidence-interpretation assessment when a clean individual mark is needed.',record:'Individual science check.',sheet:'No team checkpoint expected.',cut:'Repurpose as review/catch-up if not needed.'},
  {d:23,type:'FLEX',focus:'Reteach + targeted catch-up',task:'Regroup by actual misconception and missing checkpoint.',record:'Recover missing checkpoints if any.',sheet:'Missing Records should be close to empty.',cut:'Do not add extension until essential gaps are resolved.'},
  {d:24,type:'FLEX',focus:'Optional gallery walk / continent briefing',task:'Compare recommendations and evidence across continents.',record:'Optional communication response.',sheet:'No new checkpoint; use Missing Records first.',cut:'Cut this entire activity before sacrificing core completion.'},
  {d:25,type:'FLEX',focus:'Final buffer / transition',task:'Make-up, final feedback and interruption recovery; no new required Phase 1 science.',record:'Final completion check.',sheet:'6/6 for cleared teams; Missing Records resolved; Class Summary matches roster.',cut:'Transition discussion is first to cut if recovery is needed.'}
];

const missionBins = [
  ['M1','Field sheets, clipboards, shared thermometer(s), string/markers; optional metre stick/light/moisture tools.'],
  ['M2','Shared spoons, tweezers, clothespins/tongs, chopsticks, counters/objects; reconstruction sheets; Native Species Cards.'],
  ['M3','Organism cards, yarn/string, arrow markers, Ecosystem Maps.'],
  ['M4','5×5 sampling grids, counters, Ecosystem Change Records, local source pack.'],
  ['M5','Six-zone mats, spread markers, pollutant tokens/cards, Recommendation Boards.']
];
---

<BaseLayout title="Phase 1 Teacher Launch Guide | Jabberwocky 2190" description="Final classroom implementation guide for Jabberwocky Phase 1." themeColor="#071b2e">
  <div class="teacher-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 1',href:route()},{label:'Teacher Launch Guide'}]} />

    <header class="hero">
      <div><p class="eyebrow">TEACHER GUIDE // FINAL LAUNCH</p><h1>FIRST CONTACT<br/><span>25-PERIOD RUNBOOK</span></h1><p>One operational plan for <strong>5 missions · 18 core classes · 7 flex classes</strong>, synchronized with Team Setup, the central teacher Sheet and Team Recovery.</p></div>
      <aside><strong>25 × ~45 MIN</strong><span>18 CORE + 7 FLEX</span></aside>
    </header>

    <section class="panel important" id="before-day-1">
      <p class="eyebrow">BEFORE DAY 1</p><h2>Use the live workflow — Team Setup comes first.</h2>
      <ol>
        <li>Open the teacher workbook and confirm <strong>Setup → Collection Status = Active</strong>.</li>
        <li>Plan teams of 3–5 and continent distribution, but <strong>do not pre-create Team IDs or assign continents yet</strong>.</li>
        <li>Students save their Team Profile using first names only. The system generates the stable Team ID.</li>
        <li>Confirm the team appears in <strong>Team Directory</strong> and has <strong>Team Profile ✓</strong> in Mission Progress.</li>
        <li>Assign one continent to that registered team; students save it on the same Chromebook.</li>
        <li>Students continue Mission 1. Their normal Save buttons handle the teacher copy; no repeated Google Form or separate submission portal is needed.</li>
      </ol>
      <div class="actions"><a class="button primary" href={route()}>Open Student Hub</a><a class="button secondary" href={route('team-recovery/')}>Open Team Recovery</a><button class="button secondary" id="print-guide" type="button">Print guide</button></div>
    </section>

    <section class="grid three quick">
      <article><strong>Student save rule</strong><p>Click Save before leaving. The Chromebook saves locally first, then sends the teacher copy. Do not clear browser/site data.</p></article>
      <article><strong>Main teacher dashboard</strong><p>Use Mission Progress day to day. Use Missing Records for catch-up and Intake only for troubleshooting.</p></article>
      <article><strong>Chromebook change</strong><p>Copy the existing Team ID from Team Directory and use Team Recovery. Never create a new ID for an existing team.</p></article>
    </section>

    <section class="section-head"><p class="eyebrow">DAILY RUNBOOK</p><h2>All 25 periods</h2><p>The Google Sheet’s <strong>25-Period Plan</strong> tab contains the expanded prep/materials/project/assessment version. This page is the quick classroom view.</p></section>
    <div class="days">
      {days.map((day) => (
        <article class:list={['day-card', day.type === 'FLEX' && 'flex']}>
          <div class="day-number"><span>DAY</span><strong>{day.d}</strong><b>{day.type}</b></div>
          <div class="day-main"><h3>{day.focus}</h3><p>{day.task}</p><dl><div><dt>Record</dt><dd>{day.record}</dd></div><div><dt>Teacher Sheet</dt><dd>{day.sheet}</dd></div><div><dt>If time runs long</dt><dd>{day.cut}</dd></div></dl></div>
        </article>
      ))}
    </div>

    <section class="panel" id="materials"><p class="eyebrow">MATERIALS</p><h2>Five bins, not twenty-five setups.</h2><p>Keep reusable manipulatives in team-count kits and print only consumable records.</p><div class="grid five">{missionBins.map(([m,items]) => <article><strong>{m}</strong><p>{items}</p></article>)}</div></section>

    <section class="panel" id="assessment"><p class="eyebrow">ASSESSMENT</p><h2>Five meaningful checkpoints</h2><div class="grid five">
      <article><strong>M1 Environment Profile</strong><p>Formative observation + inference.</p></article>
      <article><strong>M2 Native Species Card</strong><p>Formative adaptation + evidence.</p></article>
      <article><strong>M3 Ecosystem Map</strong><p>Formative connections + matter cycling; compact digital report is the central checkpoint.</p></article>
      <article><strong>M4 Ecosystem Change Record</strong><p>Stronger checkpoint; formative or lightly graded.</p></article>
      <article><strong>M5 Recommendation Board</strong><p>Major Phase 1 synthesis. Day 22 can provide optional individual evidence.</p></article>
    </div><p class="note">Do not grade every reflection. If percentages are required, a practical structure is Recommendation Board 55%, short individual science check 30%, selected individual reasoning/field evidence 15%.</p></section>

    <section class="panel" id="recovery"><p class="eyebrow">ABSENCE + RECOVERY</p><h2>Recover evidence, not busywork.</h2><div class="grid three">
      <article><strong>Missed hands-on class</strong><p>Use team data plus a short individual interpretation instead of recreating the whole lab.</p></article>
      <article><strong>Offline / weak Wi-Fi</strong><p>Students still Save. Keep the same Chromebook/browser profile; when online, reopen Phase 1 and let the retry queue send. Save once more if needed.</p></article>
      <article><strong>Different Chromebook</strong><p>Team Directory → existing Team ID → Team Recovery. Previously central-sent records remain safe; old-device-only work does not transfer automatically.</p></article>
    </div></section>

    <section class="panel" id="transition"><p class="eyebrow">END OF PHASE 1</p><h2>Transition gate</h2><ul><li>Team Directory identity and continent are correct.</li><li>Mission Progress shows <strong>6/6 — Complete</strong>.</li><li>Missing Records has no unresolved required checkpoint.</li><li>Recommendation Board is collected/assessed as intended.</li><li>Any required individual evidence/feedback is resolved.</li><li>Class Summary complete count matches the teams actually being cleared.</li></ul><p class="note"><strong>Flex rule:</strong> protect core science first. Absorb lost time in this order: Day 15 → Day 20 → Day 23 → Day 24 → Day 25. Day 24 is the first full activity to drop.</p></section>
  </div>

  <script is:inline>document.getElementById('print-guide')?.addEventListener('click',()=>window.print());</script>
  <style>
    .teacher-shell{max-width:1180px;margin:0 auto;padding:1rem 1rem 4rem;color:#dceef4}.hero{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;padding:1.5rem;margin:1rem 0;border:1px solid #31526a;border-radius:20px;background:linear-gradient(145deg,#071a2c,#0c2c3b)}.hero h1{margin:.2rem 0;font-size:clamp(2rem,5vw,4rem);line-height:.95;color:#fff}.hero h1 span{color:#91dfc6}.hero p{max-width:720px;color:#aec7d2}.hero aside{display:grid;gap:.2rem;padding:1rem;border:1px solid #466879;border-radius:14px;background:#061622;text-align:center}.hero aside strong{font-size:1.25rem;color:#fff}.hero aside span,.eyebrow{font:850 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;color:#7be2c1}.panel{margin:1rem 0;padding:1.2rem;border:1px solid #294b5c;border-radius:16px;background:#091d29}.important{border-color:#4b806e;background:#0a2828}.panel h2,.section-head h2{margin:.25rem 0 .65rem;color:#fff}.panel li{margin:.4rem 0;line-height:1.5}.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.button{padding:.7rem .9rem;border-radius:9px;text-decoration:none;font-weight:900;cursor:pointer}.primary{background:#b7e67d;color:#16320c;border:0}.secondary{background:#0a202b;color:#dbeef4;border:1px solid #466875}.grid{display:grid;gap:.75rem}.grid.three{grid-template-columns:repeat(3,1fr)}.grid.five{grid-template-columns:repeat(5,1fr)}.quick article,.grid.five article{padding:1rem;border:1px solid #294b5c;border-radius:14px;background:#081a25}.quick strong,.grid.five strong{color:#fff}.quick p,.grid.five p,.note{color:#a9c1cb;line-height:1.5}.section-head{margin:2rem 0 .8rem}.section-head p:last-child{color:#a9c1cb}.days{display:grid;gap:.65rem}.day-card{display:grid;grid-template-columns:85px 1fr;border:1px solid #2a5263;border-radius:14px;background:#081c28;overflow:hidden}.day-card.flex{border-color:#645f3b;background:#221f12}.day-number{display:grid;place-items:center;align-content:center;gap:.1rem;padding:.8rem;background:#0c2b39}.flex .day-number{background:#332f18}.day-number span,.day-number b{font-size:.65rem;letter-spacing:.08em;color:#8fc7d5}.day-number strong{font-size:1.8rem;color:#fff}.day-main{padding:.85rem 1rem}.day-main h3{margin:0 0 .35rem;color:#fff}.day-main>p{margin:.2rem 0 .65rem;color:#c2d8df;line-height:1.45}.day-main dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin:0}.day-main dl>div{padding:.55rem;border:1px solid #294754;border-radius:9px;background:#061620}.day-main dt{font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:#75d5bd}.day-main dd{margin:.2rem 0 0;color:#a9c4cd;font-size:.86rem;line-height:1.4}@media(max-width:900px){.grid.five{grid-template-columns:repeat(2,1fr)}.day-main dl{grid-template-columns:1fr}.hero{grid-template-columns:1fr}.grid.three{grid-template-columns:1fr}}@media(max-width:560px){.day-card{grid-template-columns:64px 1fr}.grid.five{grid-template-columns:1fr}}@media print{.actions{display:none}.teacher-shell{max-width:none;color:#111}.hero,.panel,.day-card,.quick article,.grid.five article{background:#fff;color:#111;border-color:#999}.hero h1,.panel h2,.section-head h2,.day-main h3,.quick strong,.grid.five strong,.day-number strong{color:#111}.day-main>p,.day-main dd,.quick p,.grid.five p,.note,.hero p{color:#222}.day-card{break-inside:avoid}}
  </style>
</BaseLayout>
