---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;

const coreDays = [
  {day:1,week:1,mission:'Mission 1 — Explore Your Environment',title:'Welcome to Jabberwocky',route:'mission-1/',prep:'Continent assignments + Team IDs ready; open Mission 1.',materials:'Devices; continent roster; notebook/Pathfinder Log if used.',student:'Story launch → select assigned continent → view preliminary rating → short starting prediction → four core science ideas.',science:'Biotic, abiotic, habitat, environmental conditions.',emphasis:'The preliminary JCEC rating is a starting idea, not the answer.',collect:'Baseline prediction only; no major grade.',cut:'Extended story discussion / continent sharing.'},
  {day:2,week:1,mission:'Mission 1 — Explore Your Environment',title:'Earth Environmental Survey',route:'mission-1/#investigate',prep:'Choose 3 safe microhabitats; check weather; stage one or a few shared field kits.',materials:'Shared thermometer(s); string/markers; metre stick if available; clipboards/pencils; field sheet. Light/moisture tools are optional.',student:'Sample 3 areas and record temperature, light/moisture, evidence of life, surface/soil, human impact.',science:'Biotic/abiotic evidence; observation vs inference; habitat variation.',emphasis:'Record what you observe before explaining it. Rotate shared tools rather than requiring one set per team.',collect:'Field sheet — formative.',cut:'Optional instruments / extra sites.'},
  {day:3,week:1,mission:'Mission 1 — Explore Your Environment',title:'Explore Your Continent',route:'mission-1/#decide',prep:'Return field sheets; confirm continent is saved on devices.',materials:'Device; Environment Profile if using paper.',student:'Analyze simplified continent scan → one team decision → I noticed / I think this means → profile + reflection.',science:'Environmental evidence supports ecological inference.',emphasis:'One strong observation beats several vague claims.',collect:'Environment Profile — formative.',cut:'Whole-class continent comparison.'},
  {day:4,week:1,mission:'Mission 2 — Meet a Native Species',title:'How Structures Help',route:'mission-2/#investigate',prep:'Set up 2–3 shared resource stations before students enter; use desks, paper zones or reused shallow containers instead of dedicated trays.',materials:'Shared spoons; tweezers; clothespins/tongs; chopsticks; one class timer; small classroom objects/counters; paper/desk resource zones; lab sheet.',student:'Learn structure/function/adaptation/needs → Survival Structures Lab.',science:'A structure helps differently depending on job + environment.',emphasis:'Same time, amount and rules; change the structure. Stations can rotate—no team needs a full duplicate kit.',collect:'Lab observations — formative.',cut:'Extended oral defence.'},
  {day:5,week:1,mission:'Mission 2 — Meet a Native Species',title:'First Contact',route:'mission-2/#investigate',prep:'Confirm continent assignment is saved.',materials:'Device; species reconstruction sheet; pencils.',student:'Examine 4 clues → infer features/behaviours → begin reconstruction.',science:'Adaptation claims require evidence.',emphasis:'EVIDENCE FIRST — IMAGINATION SECOND.',collect:'Check clue use; no major submission yet.',cut:'Artistic detail.'},
  {day:6,week:2,mission:'Mission 2 — Meet a Native Species',title:'Reconstruct the Species',route:'mission-2/#record',prep:'Return reconstruction work.',materials:'Device; Native Species Card.',student:'Complete reconstruction → choose most important adaptation → Feature / Evidence / How it helps → reflection.',science:'Structures/functions/behaviours can support survival in specific environments.',emphasis:'Assess reasoning, not drawing quality.',collect:'Native Species Card — formative.',cut:'Gallery walk / polish / formal niche vocabulary.'},
  {day:7,week:2,mission:'Mission 3 — Build the Ecosystem',title:'How Food Webs Work',route:'mission-3/#investigate',prep:'Prepare Earth ecosystem cards + string kits.',materials:'Organism cards; short yarn/string; arrow markers.',student:'Learn P/C/D/food web → physical string web → remove/change one part.',science:'food → eater; energy moves through feeding relationships.',emphasis:'A model predicts possible effects; it does not prove exactly what nature will do.',collect:'Quick exit explanation — formative.',cut:'Extra pathways / symbiosis terminology.'},
  {day:8,week:2,mission:'Mission 3 — Build the Ecosystem',title:'Build Your Continent Food Web',route:'mission-3/#investigate',prep:'Prepare continent organism cards or verify digital evidence.',materials:'Device; organism cards; Ecosystem Map; pencil.',student:'Classify organisms → build 5–7 arrows → include focal species + decomposer.',science:'Organisms are connected through energy relationships.',emphasis:'Repeatedly check food → eater arrow direction.',collect:'Ecosystem Map in progress.',cut:'Extra organisms/links.'},
  {day:9,week:2,mission:'Mission 3 — Build the Ecosystem',title:'What Happens When the Web Changes?',route:'mission-3/#decide',prep:'Verify continent change prompt.',materials:'Ecosystem Map; device.',student:'Change/remove one component → If this changes, then ___ may change because ___.',science:'Ecological changes can spread through connections.',emphasis:'Require one clear connection before distant effects.',collect:'Brief reasoning check — formative.',cut:'Multiple hypothetical scenarios.'},
  {day:10,week:2,mission:'Mission 3 — Build the Ecosystem',title:'Matter Moves Too',route:'mission-3/#record',prep:'Prepare one simple water + carbon example.',materials:'Ecosystem Map; pencils.',student:'Add one water path + one carbon path → distinguish energy flow from matter cycling → reflection.',science:'Energy flows; water and carbon cycle and can be reused.',emphasis:'Do not turn this into memorizing a detailed carbon-cycle diagram.',collect:'Ecosystem Map — formative.',cut:'Decorative diagramming / extra pathways.'},
  {day:11,week:3,mission:'Mission 4 — Watch the Ecosystem Change',title:'Population Sampling',route:'mission-4/#investigate',prep:'Place a 5×5 grid and one set of simple markers at each team; use beans, paper squares or existing counters.',materials:'Printed 5×5 grid; ~30–50 beans/paper markers/classroom counters per team; randomizer if used; calculator optional.',student:'Estimate spread-out population → true count → cluster same population → estimate again.',science:'Samples are useful, but distribution affects estimates.',emphasis:'The same total population can produce different sample results.',collect:'Sampling record — formative.',cut:'Repeated extra trials.'},
  {day:12,week:3,mission:'Mission 4 — Watch the Ecosystem Change',title:'Your Population Case',route:'mission-4/#investigate',prep:'Verify each continent shows 2 graphs + 2 field notes.',materials:'Device; Ecosystem Change Record in progress.',student:'Interpret 2 graphs + 2 notes → identify what changed and what supports it.',science:'Population evidence must be interpreted with environmental evidence.',emphasis:'Lower detections do not automatically prove the whole population shrank.',collect:'Quick team thought — formative.',cut:'Cross-continent comparison.'},
  {day:13,week:3,mission:'Mission 4 — Watch the Ecosystem Change',title:'Disturbance and Recovery',route:'mission-4/#investigate',prep:'Preview continent recovery timelines.',materials:'Device; Ecosystem Change Record.',student:'Compare Day 1 / Day 30 / Day 55 with nearby less-disturbed area.',science:'Succession is gradual; recovery may be incomplete.',emphasis:'Compare trends, not one snapshot.',collect:'Recovery evidence for Mission 4 claim.',cut:'Extra monitoring indicators.'},
  {day:14,week:3,mission:'Mission 4 — Watch the Ecosystem Change',title:'Earth Connection + Team Decision',route:'mission-4/#decide',prep:'Prepare short local source pack with photos/maps/data + authentic Indigenous/community source where appropriate.',materials:'Teacher-curated source cards; photos/maps/data; Ecosystem Change Record.',student:'Find one sign of local change + one important condition/action → read sources → finish Mission 4 claim.',science:'Monitoring and multiple credible sources support environmental decisions.',emphasis:'Use what the specific Indigenous/community source actually says; do not invent/generalize perspective.',collect:'Ecosystem Change Record — formative/light checkpoint.',cut:'Formal presentation; keep source analysis + final reasoning.'},
  {day:16,week:4,mission:'Mission 5 — Humans Have Arrived',title:'The Incident',route:'mission-5/#investigate',prep:'Print or draw one six-zone Stowaway Spread mat per team; no cups are required.',materials:'6-zone paper mat; neutral counters/beans/paper markers; 4 contrasting stowaway markers; spoon/scoop if useful; incident record.',student:'Human-impact reveal → compare spread without vs with early checkpoint.',science:'Human movement creates spread pathways; prevention can reduce spread.',emphasis:'Introduced does not automatically mean invasive. Move markers between printed zones instead of building a container setup.',collect:'Simulation record — formative.',cut:'Repeated simulation rounds.'},
  {day:17,week:4,mission:'Mission 5 — Humans Have Arrived',title:'What Happens Next?',route:'mission-5/#investigate',prep:'Prepare teacher-guided pollutant token model.',materials:'16 producer paper tokens/cards; 4 consumer cards; 1 predator card; continent incident evidence.',student:'Check spread + harm evidence → short pollutant model → connect conservation risk.',science:'Invasive requires spread + harm; persistent pollutants can biomagnify; local ≠ global extinction.',emphasis:'X-17 is fictional; the ecological pattern is the learning target. Printed paper tokens work as well as physical counters.',collect:'No separate major submission.',cut:'Extra clues / second pollutant scenario.'},
  {day:18,week:4,mission:'Mission 5 — Humans Have Arrived',title:'What Should Humans Do?',route:'mission-5/#decide',prep:'Make Missions 1–4 artifacts accessible; print Recommendation Boards if needed.',materials:'Environment Profile; Native Species Card; Ecosystem Map; Ecosystem Change Record; Recommendation Board.',student:'Choose ecosystem importance, native species, key connection, biggest risk, 3 evidence items, one rule + recommendation.',science:'Environmental decisions require evidence + consequence thinking.',emphasis:'Students do not need to match the preliminary JCEC rating.',collect:'Recommendation Board in progress.',cut:'Artistic polish / extended peer critique.'},
  {day:19,week:4,mission:'Mission 5 — Humans Have Arrived',title:'JCEC Recommendation',route:'mission-5/#record',prep:'Prepare collection/submission method.',materials:'Recommendation Board; earlier mission evidence.',student:'Finish Board → Decision / Evidence / Possible consequence → final individual reflection.',science:'Evidence from all five mission ideas supports responsible environmental decisions.',emphasis:'Three strong evidence items beat a long list of weak facts.',collect:'JCEC Recommendation Board — major synthesis + final reflection.',cut:'Presentations; move to Day 24 if desired.'}
];

const flexDays = [
  {day:15,title:'Fieldwork / Mission 4 recovery buffer',use:'Weather-rescheduled fieldwork, Mission 4 absences, sampling/succession reteach, or vocabulary review.',priority:'Protect the local environmental connection first.'},
  {day:20,title:'Recommendation Board completion / absence recovery',use:'Finish major synthesis work or recover a missed Mission 5 investigation.',priority:'Use for essential completion before enrichment.'},
  {day:21,title:'Whole-unit science review',use:'Retrieval, diagrams, evidence interpretation and recurring misconceptions.',priority:'Review science, not JCEC trivia.'},
  {day:22,title:'Short individual science check',use:'Optional concise individual assessment when a clean individual mark is needed.',priority:'Focus on evidence interpretation, not story memorization.'},
  {day:23,title:'Reteach + targeted catch-up',use:'Regroup by misconception; others finish missed reflections/artifacts.',priority:'Respond to actual assessment evidence.'},
  {day:24,title:'Optional gallery walk / continent briefing',use:'Compare Recommendation Boards and why different continents produced different decisions.',priority:'Optional — cut before core learning.'},
  {day:25,title:'Final buffer / transition',use:'Make-up, interruption recovery, final feedback or transition to Phase 2.',priority:'No new required Phase 1 content.'}
];

const missionMaterials = [
  {mission:'Mission 1',title:'Explore Your Environment',reuse:'Shared thermometer(s); string/markers; metre stick if available; clipboards. Hand lenses/light/moisture tools are optional.',print:'Continent roster; Earth Environmental Survey field sheet; Environment Profile.'},
  {mission:'Mission 2',title:'Meet a Native Species',reuse:'A few shared spoons, tweezers, clothespins/tongs and chopsticks; classroom objects/counters; paper/desk resource zones; one class timer.',print:'Survival Structures Lab sheet; reconstruction sheet; Native Species Card.'},
  {mission:'Mission 3',title:'Build the Ecosystem',reuse:'Earth ecosystem cards; yarn/string; arrow markers; continent organism cards if printed.',print:'Ecosystem Map.'},
  {mission:'Mission 4',title:'Watch the Ecosystem Change',reuse:'Printed/laminated 5×5 sampling grids; beans, paper markers or existing classroom counters.',print:'Sampling record; Ecosystem Change Record; local source cards/photos/maps/data; teacher-selected authentic Indigenous/community source.'},
  {mission:'Mission 5',title:'Humans Have Arrived',reuse:'No cups required: use a printed six-zone mat; neutral markers; 4 contrasting stowaway markers; optional scoop; printed producer/consumer/predator/pollutant tokens.',print:'Six-zone Stowaway mat or hand-drawn zones; incident record as needed; JCEC Recommendation Board; Missions 1–4 artifacts accessible for evidence review.'}
];

const route = (part='') => `${base}courses/grade-7-science/jabberwocky/phase-1/${part}`;
---

<BaseLayout title="Phase 1 Teacher Launch Guide | Jabberwocky 2190" description="Teacher implementation guide for the simplified five-mission Grade 7 Science Phase 1." themeColor="#071b2e">
  <div class="teacher-shell" id="five-mission-teacher-guide">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 1',href:route()},{label:'Teacher Launch Guide'}]} />

    <nav class="teacher-nav"><a href="#launch">Launch</a><a href="#core">18 Core</a><a href="#flex">7 Flex</a><a href="#materials">Materials</a><a href="#assessment">Assessment</a><a href="#local">Mission 4 Local</a><a href="#contingency">Contingency</a></nav>

    <header class="hero" id="launch">
      <div><p class="eyebrow">TEACHER GUIDE // PHASE 1</p><h1>FIRST CONTACT<br/><span>FIVE-MISSION LAUNCH</span></h1><p>The teacher plan now matches exactly what students see: <strong>5 missions · 18 core classes · 7 purposeful flex classes</strong>.</p></div>
      <aside><strong>25 × 45 MIN</strong><span>18 CORE + 7 FLEX</span></aside>
    </header>

    <section class="panel setup"><p class="eyebrow">BEFORE DAY 1</p><h2>Set the system once.</h2><div class="grid four"><article><strong>Assign continents</strong><p>Prepare student → continent → Team ID roster. Students should not manage backend metadata.</p></article><article><strong>Choose submission mode</strong><p>Team Records can be paper, digital or both. Keep routine JCEC metadata teacher-managed.</p></article><article><strong>Use low-material defaults</strong><p>Prefer shared stations, printed mats/cards, reused containers and ordinary classroom objects before buying dedicated kits.</p></article><article><strong>Plan Mission 4 local case</strong><p>Preselect the local issue and source cards before Week 3.</p></article></div><div class="actions"><a class="button primary" href={route()}>Open Student Hub</a><button class="button secondary" id="print-guide" type="button">Print guide</button></div></section>

    <section class="mission-strip">
      <article><b>M1 · 3 classes</b><strong>Explore Your Environment</strong><span>Place</span></article>
      <article><b>M2 · 3 classes</b><strong>Meet a Native Species</strong><span>Organism</span></article>
      <article><b>M3 · 4 classes</b><strong>Build the Ecosystem</strong><span>Ecosystem</span></article>
      <article><b>M4 · 4 classes</b><strong>Watch the Ecosystem Change</strong><span>Change</span></article>
      <article><b>M5 · 4 classes</b><strong>Humans Have Arrived</strong><span>Decision</span></article>
    </section>

    <section class="section-head" id="core"><p class="eyebrow">CORE PATH</p><h2>18 classes teachers should protect</h2><p>Each card uses the same planning questions: before class, materials, student work, science, emphasis, collect, and cut first.</p></section>
    <div class="days">
      {coreDays.map(d => <article class="day"><header><span>DAY {d.day}</span><div><small>WEEK {d.week} · {d.mission}</small><h3>{d.title}</h3></div><a href={route(d.route)}>Open →</a></header><div class="day-grid"><section><b>BEFORE CLASS</b><p>{d.prep}</p></section><section><b>MATERIALS</b><p>{d.materials}</p></section><section class="wide"><b>STUDENTS SEE / DO</b><p>{d.student}</p></section><section><b>KEY SCIENCE</b><p>{d.science}</p></section><section><b>TEACHER EMPHASIS</b><p>{d.emphasis}</p></section><section class="must"><b>COLLECT / ASSESS</b><p>{d.collect}</p></section><section class="cut"><b>IF TIME RUNS OUT</b><p>{d.cut}</p></section></div></article>)}
    </div>

    <section class="panel" id="flex"><p class="eyebrow">BUFFER IS A FEATURE</p><h2>7 purposeful flex classes</h2><p class="intro">These are not empty periods. They protect the core when weather, absences, school events or slower labs happen.</p><div class="grid flex-grid">{flexDays.map(f => <article><span>DAY {f.day}</span><strong>{f.title}</strong><p>{f.use}</p><small>{f.priority}</small></article>)}</div><div class="warning"><strong>Flex priority:</strong> missed core investigation → absence recovery → unfinished synthesis → reteach → individual check → review/presentation → early transition.</div></section>

    <section class="panel" id="materials"><p class="eyebrow">MISSION MATERIALS MASTER LIST</p><h2>Prepare by mission, using shared and printable materials first.</h2><div class="materials-list">{missionMaterials.map(m => <article><div><span>{m.mission}</span><h3>{m.title}</h3></div><section><b>REUSABLE / SHARED</b><p>{m.reuse}</p></section><section><b>PRINT / DIGITAL</b><p>{m.print}</p></section></article>)}</div></section>

    <section class="panel" id="assessment"><p class="eyebrow">MARK LESS · LEARN MORE</p><h2>Sensible Phase 1 assessment load</h2><div class="assessment-grid"><article><span>FORMATIVE</span><strong>M1 Environment Profile</strong><p>Observation + inference feedback.</p></article><article><span>FORMATIVE</span><strong>M2 Native Species Card</strong><p>Adaptation + evidence feedback.</p></article><article><span>FORMATIVE</span><strong>M3 Ecosystem Map</strong><p>Food-web + matter-cycle feedback.</p></article><article><span>CHECKPOINT</span><strong>M4 Ecosystem Change Record</strong><p>Stronger reasoning evidence; formative or lightly graded.</p></article><article class="major"><span>MAJOR SYNTHESIS</span><strong>M5 JCEC Recommendation Board</strong><p>Main Phase 1 summative task.</p></article></div><div class="weighting"><strong>If percentages are required</strong><span>Recommendation Board · 55%</span><span>Short individual science check · 30%</span><span>Selected individual reasoning / field evidence · 15%</span></div><p class="note">Lighter option: grade only the Recommendation Board + Day 22 individual science check. Do not turn all five Team Records or reflections into separate major grades.</p></section>

    <section class="panel local" id="local"><p class="eyebrow">MISSION 4 · LOCAL EARTH CONNECTION</p><h2>Teacher-curated Calgary-area source pack</h2><p>Keep this inside Mission 4. Students should use a few short source cards rather than conduct open web research.</p><div class="source-grid"><a href="https://www.calgary.ca/water/stormwater/source-water-protection.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary</strong><span>Source Water Protection ↗</span></a><a href="https://www.calgary.ca/water/stormwater/riparian-areas.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary</strong><span>Riparian Areas ↗</span></a><a href="https://tsuutina.com/wp-content/uploads/2025/06/Niska.Newsletter.June10.2025.final_.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut'ina Nation</strong><span>Niska Newsletter · June 2025 ↗</span></a><a href="https://tsuutina.com/wp-content/uploads/2023/10/Lands.Newsletter.FinalEditition.August2022.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut'ina Nation</strong><span>Lands Newsletter · Aug 2022 ↗</span></a></div><div class="warning"><strong>Authentic-source rule:</strong> do not invent or generalize an Indigenous perspective. Students describe what the specific source actually says and how it helps them understand the environmental issue.</div></section>

    <section class="panel" id="contingency"><p class="eyebrow">RECOVERY PLAN</p><h2>If real school life interrupts the unit</h2><div class="grid three"><article><strong>Lab runs long</strong><p>Protect the scientific conclusion. Move Team Record completion to the next opening/flex period.</p></article><article><strong>A class is lost</strong><p>Use flex in order: Day 15 → 20 → 23 → 24 → 25.</p></article><article><strong>Outdoor work cancelled</strong><p>Use three contrasting indoor microhabitats and discuss the limitation.</p></article><article><strong>Device failure</strong><p>Use printed artifacts and project/read continent evidence.</p></article><article><strong>Student misses a lab</strong><p>Use team data + a short individual interpretation; do not recreate every physical lab alone.</p></article><article><strong>Materials are limited</strong><p>Use shared stations, printed zones/cards, reused classroom objects and teacher demonstrations before purchasing duplicate kits.</p></article><article><strong>Students overwhelmed</strong><p>Return to the mission's one essential question + one reasoning scaffold.</p></article></div></section>

    <section class="panel readiness"><p class="eyebrow">FINAL LAUNCH-READINESS AUDIT</p><h2>Can I launch tomorrow?</h2><div class="check-grid"><article><b>✓</b><span><strong>Do I know what to prepare tomorrow?</strong><small>Every core day has a before-class + materials plan.</small></span></article><article><b>✓</b><span><strong>Do I know what students should finish?</strong><small>Each mission has one protected scientific endpoint and one final Team Record.</small></span></article><article><b>✓</b><span><strong>Do I know what to assess?</strong><small>M1–3 formative, M4 checkpoint, M5 major synthesis.</small></span></article><article><b>✓</b><span><strong>Can I recover if time is lost?</strong><small>Seven purposeful flex periods protect the core.</small></span></article><article><b>✓</b><span><strong>Do teacher and student systems match?</strong><small>Both now use the same five missions and 18-core-class pathway.</small></span></article></div></section>

    <section class="legacy-note"><strong>Legacy Operation 01–08 resources are preserved.</strong><p>Use them when you want deeper scientific interpretation, troubleshooting or an extension. They are archived reference resources, not the primary student route.</p></section>
  </div>

  <script is:inline>
    document.getElementById('print-guide')?.addEventListener('click',()=>window.print());
  </script>
</BaseLayout>

<style>
