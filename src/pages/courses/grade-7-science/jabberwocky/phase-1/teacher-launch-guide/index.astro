---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;
const route = (part='') => `${base}courses/grade-7-science/jabberwocky/phase-1/${part}`;

const missionNames = [
  'Explore Your Environment',
  'Meet a Native Species',
  'Build the Ecosystem',
  'Watch the Ecosystem Change',
  'Humans Have Arrived'
];

const planningFields = ['BEFORE CLASS','MATERIALS','STUDENTS SEE / DO','KEY SCIENCE','TEACHER EMPHASIS','COLLECT / ASSESS','IF TIME RUNS OUT'];

const days = [
  {day:1,type:'CORE',mission:'Mission 1 — Explore Your Environment',focus:'Welcome + Team Setup',prep:'Open Phase 1 Hub + teacher workbook. Plan teams/continent distribution, but do not pre-create Team IDs or assign continents yet.',materials:'Chromebook; optional notebook/Pathfinder Log.',project:'Phase 1 Hub → Team Setup, then Mission 1.',task:'Teams of 3–5 save Team Profile with first names only. Teacher confirms Team Directory, assigns one continent, students save it, then begin the story and environmental concepts.',science:'Biotic, abiotic, habitat, environmental conditions.',emphasis:'Team Setup comes first. The preliminary JCEC rating is a starting idea, not the answer.',record:'Team Profile central checkpoint; baseline prediction only.',sheet:'One Team Directory row/team; Team Profile ✓; continent appears after assignment.',cut:'Cut extended story/continent sharing. Protect Team Setup + continent save.'},
  {day:2,type:'CORE',mission:'Mission 1 — Explore Your Environment',focus:'Earth Environmental Survey',prep:'Choose 3 safe microhabitats or indoor fallback; check conditions; stage shared field kits.',materials:'Field sheet; clipboard; pencil; shared thermometer(s); string/markers; optional metre stick/light/moisture tools.',project:'Mission 1 → Investigate.',task:'Sample 3 locations and record temperature, light/moisture, evidence of life, surface/soil and human impact.',science:'Biotic vs abiotic evidence; observation vs inference; habitat variation.',emphasis:'Record what is observed before explaining it.',record:'Field sheet — FORMATIVE.',sheet:'No new mission ✓ expected.',cut:'Drop optional instruments and extra sites.'},
  {day:3,type:'CORE',mission:'Mission 1 — Explore Your Environment',focus:'Explore Your Continent',prep:'Return field sheets; verify continent remains saved.',materials:'Chromebook; Environment Profile if using paper; field evidence.',project:'Mission 1 → Decide / Record.',task:'Analyze continent scan; choose the most important condition using I noticed… / I think this means…; complete Environment Profile.',science:'Environmental evidence supports ecological inference.',emphasis:'One strong observation beats several vague claims.',record:'Environment Profile — final M1 Team Record.',sheet:'M1 ✓.',cut:'Cut whole-class continent comparison.'},
  {day:4,type:'CORE',mission:'Mission 2 — Meet a Native Species',focus:'How Structures Help',prep:'Set up 2–3 shared stations.',materials:'Lab sheet; shared spoons; tweezers; clothespins/tongs; chopsticks; counters/objects; timer.',project:'Mission 2 → Investigate.',task:'Run Survival Structures Lab with time/resources/rules held constant while structure changes.',science:'Structure, function, adaptation and needs; fair comparison.',emphasis:'The usefulness of a structure depends on job and environment.',record:'Lab observations — FORMATIVE.',sheet:'No new ✓ expected.',cut:'Cut extended oral defence.'},
  {day:5,type:'CORE',mission:'Mission 2 — Meet a Native Species',focus:'First Contact',prep:'Confirm continent saved; prepare reconstruction sheets.',materials:'Chromebook; species reconstruction sheet; pencil.',project:'Mission 2 → clue set.',task:'Examine 4 clues; infer possible structures/behaviours; begin reconstruction.',science:'Adaptation claims require evidence.',emphasis:'EVIDENCE FIRST — IMAGINATION SECOND.',record:'Reconstruction in progress.',sheet:'No new ✓ expected.',cut:'Cut artistic detail.'},
  {day:6,type:'CORE',mission:'Mission 2 — Meet a Native Species',focus:'Reconstruct the Species',prep:'Return reconstruction work; prepare Native Species Cards.',materials:'Chromebook; Native Species Card; reconstruction evidence.',project:'Mission 2 → Record.',task:'Finish reconstruction; choose most important adaptation; Feature → Evidence → How it helps.',science:'Structures/functions/behaviours can support survival in a specific environment.',emphasis:'Assess reasoning, not drawing quality.',record:'Native Species Card — final M2 Team Record.',sheet:'M2 ✓.',cut:'Move gallery walk/art polish/niche extension to flex.'},
  {day:7,type:'CORE',mission:'Mission 3 — Build the Ecosystem',focus:'How Food Webs Work',prep:'Prepare Earth ecosystem cards and yarn/string kits.',materials:'Organism cards; short yarn/string; arrow markers.',project:'Mission 3 → Investigate.',task:'Build a physical food web; remove/change one component.',science:'Producer, consumer, decomposer; food → eater; energy through feeding relationships.',emphasis:'A model predicts possible effects; it does not prove exactly what nature will do.',record:'Quick exit explanation — FORMATIVE.',sheet:'No new ✓ expected.',cut:'Cut extra pathways/symbiosis terminology.'},
  {day:8,type:'CORE',mission:'Mission 3 — Build the Ecosystem',focus:'Build Your Continent Food Web',prep:'Prepare continent organism cards or verify digital evidence.',materials:'Chromebook; organism cards; Ecosystem Map; pencil.',project:'Mission 3 → continent evidence.',task:'Classify organisms and build 5–7 arrows including focal species + decomposer.',science:'Organisms are connected through energy relationships.',emphasis:'Repeatedly check food → eater arrow direction.',record:'Ecosystem Map in progress.',sheet:'No new ✓ expected.',cut:'Cut extra organisms/links.'},
  {day:9,type:'CORE',mission:'Mission 3 — Build the Ecosystem',focus:'What Happens When the Web Changes?',prep:'Verify continent-specific change prompt.',materials:'Chromebook; Ecosystem Map.',project:'Mission 3 → Decide.',task:'Change/remove one component; write If this changes, then ___ may change because ___.',science:'Ecological changes can spread through connections.',emphasis:'Require one clear direct connection before distant effects.',record:'Brief reasoning check — FORMATIVE.',sheet:'No new ✓ expected.',cut:'Cut multiple scenarios.'},
  {day:10,type:'CORE',mission:'Mission 3 — Build the Ecosystem',focus:'Matter Moves Too',prep:'Prepare one simple water-path and carbon-path example.',materials:'Chromebook; Ecosystem Map; pencils.',project:'Mission 3 → Record + Teacher Report Copy.',task:'Add one water and one carbon path; distinguish energy flow from matter cycling; finish map and 3-box Teacher Report Copy.',science:'Energy flows; water/carbon cycle and can be reused.',emphasis:'Do not turn this into memorizing a detailed carbon-cycle diagram.',record:'Ecosystem Map + compact digital report — FORMATIVE central CHECKPOINT.',sheet:'M3 ✓.',cut:'Cut decorative diagramming and extra cycles.'},
  {day:11,type:'CORE',mission:'Mission 4 — Watch the Ecosystem Change',focus:'Population Sampling',prep:'Place a 5×5 grid and simple markers at each team.',materials:'Printed 5×5 grid; ~30–50 beans/paper markers/counters; optional randomizer/calculator.',project:'Mission 4 → Investigate.',task:'Estimate spread-out population, compare true count, cluster same total and sample again.',science:'Samples can be useful, but distribution affects estimates.',emphasis:'Same total population can produce different sample results.',record:'Sampling record — FORMATIVE.',sheet:'No new ✓ expected.',cut:'Cut repeated extra trials.'},
  {day:12,type:'CORE',mission:'Mission 4 — Watch the Ecosystem Change',focus:'Your Population Case',prep:'Verify each continent has 2 graphs + 2 field notes.',materials:'Chromebook; Ecosystem Change Record.',project:'Mission 4 → continent population evidence.',task:'Interpret graphs + notes; identify what changed and which evidence supports it.',science:'Population evidence must be interpreted with environmental evidence.',emphasis:'Lower detections do not automatically prove whole-population decline.',record:'Quick team interpretation — FORMATIVE.',sheet:'No new ✓ expected.',cut:'Cut cross-continent comparison.'},
  {day:13,type:'CORE',mission:'Mission 4 — Watch the Ecosystem Change',focus:'Disturbance and Recovery',prep:'Preview continent recovery timelines.',materials:'Chromebook; Ecosystem Change Record.',project:'Mission 4 → recovery timeline.',task:'Compare Day 1 / Day 30 / Day 55 with less-disturbed area.',science:'Succession is gradual; recovery may be incomplete.',emphasis:'Compare trends, not one snapshot.',record:'Recovery evidence for final M4 claim.',sheet:'No new ✓ expected.',cut:'Cut extra monitoring indicators.'},
  {day:14,type:'CORE',mission:'Mission 4 — Watch the Ecosystem Change',focus:'Earth Connection + Decision',prep:'Prepare short local source pack with photos/maps/data + specific authentic Indigenous/community source where appropriate.',materials:'Chromebook or printed excerpts; Ecosystem Change Record; local source cards.',project:'Mission 4 → Decide / Record.',task:'Identify local change and relevant condition/action; use specific source evidence; finish M4 claim.',science:'Monitoring and multiple credible sources support environmental decisions.',emphasis:'Students do not invent or generalize an Indigenous perspective; report what the specific source contributes.',record:'Ecosystem Change Record — stronger CHECKPOINT; formative/light grade.',sheet:'M4 ✓.',cut:'Move unfinished record to Day 15; cut formal presentation.'},
  {day:15,type:'FLEX',mission:'Mission 4 — Watch the Ecosystem Change',focus:'Fieldwork / M4 Recovery',prep:'Use Missing Records + formative observations to choose purpose.',materials:'Only materials needed for the chosen recovery.',project:'Targeted catch-up instructions.',task:'Priority: weather-rescheduled M1 fieldwork → missing M4 essential work → sampling/succession reteach → vocabulary.',science:'Recover essential Phase 1 evidence.',emphasis:'Protect local environmental connection first.',record:'Recover missing M1–M4 records only.',sheet:'Missing Records + Mission Progress.',cut:'Bank unused time as interruption buffer.'},
  {day:16,type:'CORE',mission:'Mission 5 — Humans Have Arrived',focus:'The Incident',prep:'Print/draw one six-zone Stowaway Spread mat per team; no cups required.',materials:'Printable six-zone mat; neutral counters/beans/paper; 4 contrasting markers; optional scoop; incident record.',project:'Mission 5 → Investigate.',task:'Compare spread without vs with an early checkpoint.',science:'Human movement creates spread pathways; prevention can reduce spread.',emphasis:'Introduced does not automatically mean invasive.',record:'Simulation record — FORMATIVE.',sheet:'No M5 ✓ yet.',cut:'Cut repeated rounds.'},
  {day:17,type:'CORE',mission:'Mission 5 — Humans Have Arrived',focus:'What Happens Next?',prep:'Prepare teacher-guided pollutant token model.',materials:'16 producer paper tokens/cards; 4 consumer cards; 1 predator card; Chromebook.',project:'Mission 5 → harm evidence + biomagnification model.',task:'Use spread + harm evidence; model biomagnification; connect conservation risk.',science:'Invasive requires spread + harm; persistent pollutants can biomagnify; local extinction ≠ global extinction.',emphasis:'X-17 is fictional; ecological pattern is the learning target.',record:'No separate major submission.',sheet:'No M5 ✓ yet.',cut:'Cut extra clues/second pollutant scenario.'},
  {day:18,type:'CORE',mission:'Mission 5 — Humans Have Arrived',focus:'What Should Humans Do?',prep:'Make M1–M4 artifacts accessible; print Recommendation Boards if needed.',materials:'Environment Profile; Native Species Card; Ecosystem Map; Ecosystem Change Record; JCEC Recommendation Board; Chromebook.',project:'Mission 5 → Decide.',task:'Choose ecosystem importance, native species, key connection, biggest risk, 3 evidence items, one rule + recommendation.',science:'Environmental decisions require evidence + consequence thinking.',emphasis:'Students do not need to match the preliminary JCEC rating.',record:'JCEC Recommendation Board in progress.',sheet:'No M5 ✓ yet.',cut:'Cut artistic polish/extended peer critique.'},
  {day:19,type:'CORE',mission:'Mission 5 — Humans Have Arrived',focus:'JCEC Recommendation',prep:'Prepare collection/submission space; ensure earlier evidence accessible.',materials:'JCEC Recommendation Board; earlier mission evidence; Chromebook.',project:'Mission 5 → Record / Teacher Report Copy.',task:'Finish Board; Decision → Evidence → Possible consequence; individual reflection; save concise digital report.',science:'Evidence across environment, organisms, interactions, change and human impacts supports responsible decisions.',emphasis:'Three strong evidence items beat a long list of weak facts.',record:'JCEC Recommendation Board — MAJOR SYNTHESIS + final reflection + digital M5 CHECKPOINT.',sheet:'M5 ✓; complete teams = 6/6 Complete.',cut:'Move presentations to Day 24.'},
  {day:20,type:'FLEX',mission:'Mission 5 — Humans Have Arrived',focus:'Completion / Absence Recovery',prep:'Open Missing Records and group by exact missing requirement.',materials:'Missing artifacts/Chromebooks as needed.',project:'Short catch-up menu.',task:'Finish essential M5 synthesis or recover missed essential work.',science:'Recover required evidence without recreating unnecessary procedure.',emphasis:'Completion before enrichment.',record:'Complete any missing Team Record.',sheet:'Missing Records; verify new ✓ and 6/6.',cut:'If complete, use for feedback rather than new required work.'},
  {day:21,type:'FLEX',mission:'Phase 1 Review',focus:'Whole-Unit Science Review',prep:'Choose retrieval prompts from observed misconceptions.',materials:'Chromebook/review sheet; diagrams/mini-whiteboards optional.',project:'Retrieval + evidence-interpretation prompts.',task:'Review biotic/abiotic, adaptations, food-web arrows, energy/matter, sampling, succession, invasive evidence, biomagnification, conservation decisions.',science:'Core Interactions & Ecosystems ideas.',emphasis:'Review science, not JCEC trivia.',record:'No required central Team Record.',sheet:'Missing Records only if needed.',cut:'Prioritize misconceptions over every term.'},
  {day:22,type:'FLEX',mission:'Phase 1 Review',focus:'Short Individual Science Check',prep:'Prepare concise assessment only if a clean individual mark is needed.',materials:'Assessment sheet/device.',project:'Assessment directions only.',task:'Individual evidence interpretation across core science ideas.',science:'Core concepts through evidence, not story memorization.',emphasis:'Use only if it adds needed individual evidence.',record:'Optional individual science check.',sheet:'No team checkpoint expected.',cut:'Repurpose as review/catch-up if not needed.'},
  {day:23,type:'FLEX',mission:'Phase 1 Review',focus:'Reteach + Targeted Catch-Up',prep:'Group by actual misconception and Missing Records.',materials:'Targeted cards/models + missing artifacts.',project:'Group-specific tasks.',task:'Reteach demonstrated needs and finish missing records.',science:'Targeted misconceptions only.',emphasis:'Respond to evidence, not a fixed extra lesson.',record:'Recover missing checkpoints if any.',sheet:'Missing Records should be close to empty.',cut:'Do not add extension until essential gaps are resolved.'},
  {day:24,type:'FLEX',mission:'Phase 1 Review',focus:'Optional Gallery Walk / Continent Briefing',prep:'Arrange Recommendation Boards only if core completion is secure.',materials:'JCEC Recommendation Boards; sticky notes optional.',project:'What evidence led to different recommendations?',task:'Compare evidence and recommendations across continents.',science:'Different evidence can support different responsible decisions.',emphasis:'Focus on reasoning, not whose answer is “right”.',record:'Optional communication response.',sheet:'No new checkpoint; use Missing Records first.',cut:'Cut this entire activity before sacrificing core completion.'},
  {day:25,type:'FLEX',mission:'Phase 1 Review',focus:'Final Buffer / Transition',prep:'Open Mission Progress, Missing Records and Class Summary.',materials:'Any outstanding artifact; Chromebook if recovery needed.',project:'Final checklist.',task:'Make-up, feedback, interruption recovery; no new required Phase 1 science.',science:'Consolidate evidence and readiness to transition.',emphasis:'No new required work.',record:'Final completion check.',sheet:'6/6 for cleared teams; Missing Records resolved; Class Summary matches roster.',cut:'Transition discussion is first to cut if recovery is needed.'}
];

const missionMaterials = [
  {mission:'Mission 1',title:'Explore Your Environment',items:'Shared thermometer access; field sheets; clipboards; string/markers; optional metre stick/light/moisture tools.'},
  {mission:'Mission 2',title:'Meet a Native Species',items:'Shared stations with spoons, tweezers, clothespins/tongs, chopsticks and counters; reconstruction sheets; Native Species Cards.'},
  {mission:'Mission 3',title:'Build the Ecosystem',items:'Organism cards; yarn/string; arrow markers; Ecosystem Maps.'},
  {mission:'Mission 4',title:'Watch the Ecosystem Change',items:'Printed/laminated 5×5 grid; counters; Ecosystem Change Records; local source pack.'},
  {mission:'Mission 5',title:'Humans Have Arrived',items:'Printable six-zone Stowaway mat — no cups required; neutral/contrasting markers; pollutant cards/tokens; JCEC Recommendation Board.'}
];

const contingencies = [
  ['Lab runs long','Protect the science conclusion and Save. Move repeats, polish or extension to flex.'],
  ['A class is lost','Absorb work first into Days 15, 20, 23, 24, then 25. Day 24 is the first full activity to drop.'],
  ['Outdoor work cancelled','Use the indoor fallback or move fieldwork to Day 15.'],
  ['Device failure','Keep paper/physical work. If an existing team changes Chromebooks, use Team Recovery with the existing Team ID.'],
  ['Student misses a lab','Use team data plus a short individual interpretation instead of recreating the whole lab.'],
  ['Materials are limited','Rotate shared stations and use reused and printed/printable substitutes.'],
  ['Students overwhelmed','Reduce to the strongest evidence and one clear relationship before adding complexity.']
];

const readinessQuestions = [
  'Do I know what to prepare tomorrow?',
  'Do I know what students should finish?',
  'Do I know what to assess?',
  'Can I recover if time is lost?',
  'Do teacher and student systems match?'
];

const localSources = [
  ['City of Calgary — Source Water Protection','https://www.calgary.ca/water/stormwater/source-water-protection.html'],
  ['City of Calgary — Riparian Areas','https://www.calgary.ca/water/stormwater/riparian-areas.html'],
  ["Tsuut'ina Nation — Niska Newsletter, June 2025",'https://tsuutina.com/wp-content/uploads/2025/06/Niska.Newsletter.June10.2025.final_.pdf']
];
---

<BaseLayout title="Phase 1 Teacher Launch Guide | Jabberwocky 2190" description="Final classroom implementation guide for Jabberwocky Phase 1." themeColor="#071b2e">
  <div class="teacher-shell" id="five-mission-teacher-guide">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 1',href:route()},{label:'Teacher Launch Guide'}]} />

    <nav class="teacher-nav"><a href="#before-day-1">Launch</a><a href="#daily">25 Periods</a><a href="#materials">Materials</a><a href="#assessment">Assessment</a><a href="#local">Mission 4 Local</a><a href="#contingency">Contingency</a><a href="#transition">Transition</a></nav>

    <header class="hero">
      <div><p class="eyebrow">TEACHER GUIDE // FINAL LAUNCH</p><h1>FIRST CONTACT<br/><span>25-PERIOD RUNBOOK</span></h1><p>One operational plan for <strong>5 missions · 18 core classes · 7 purposeful flex classes</strong>, synchronized with Team Setup, the central teacher Sheet and Team Recovery.</p><p class="mission-line">{missionNames.join(' → ')}</p></div>
      <aside><strong>25 × ~45 MIN</strong><span>18 CORE + 7 FLEX</span></aside>
    </header>

    <section class="panel important" id="before-day-1">
      <p class="eyebrow">BEFORE DAY 1</p><h2>Team Setup comes first.</h2>
      <ol>
        <li>Open the teacher workbook and confirm <strong>Setup → Collection Status = Active</strong>.</li>
        <li>Plan teams of 3–5 and continent distribution, but <strong>do not pre-create Team IDs or assign continents yet</strong>.</li>
        <li>Students save their Team Profile using first names only. The system generates the stable Team ID.</li>
        <li>Confirm the team appears in <strong>Team Directory</strong> and has <strong>Team Profile ✓</strong> in Mission Progress.</li>
        <li>Assign one continent to that registered team; students save it on the same Chromebook.</li>
        <li>Students continue Mission 1. Normal Save buttons handle the teacher copy; no repeated Google Form or separate submission portal is needed.</li>
      </ol>
      <div class="actions"><a class="button primary" href={route()}>Open Student Hub</a><a class="button secondary" href={route('team-recovery/')}>Open Team Recovery</a><button class="button secondary" id="print-guide" type="button">Print guide</button></div>
    </section>

    <section class="grid three quick">
      <article><strong>Student save rule</strong><p>Click Save before leaving. The Chromebook saves locally first, then sends the teacher copy. Do not clear browser/site data.</p></article>
      <article><strong>Main teacher dashboard</strong><p>Use Mission Progress day to day. Use Missing Records for catch-up and Intake only for troubleshooting.</p></article>
      <article><strong>Chromebook change</strong><p>Copy the existing Team ID from Team Directory and use Team Recovery. Never create a new ID for an existing team.</p></article>
    </section>

    <section class="panel planning-legend"><p class="eyebrow">DAILY PLANNING FIELDS</p><p>{planningFields.join(' · ')}</p></section>

    <section class="section-head" id="daily"><p class="eyebrow">DAILY RUNBOOK</p><h2>All 25 periods</h2><p>The teacher Sheet’s <strong>25-Period Plan</strong> tab is the expanded daily view. These cards preserve the same planning fields and cuts.</p></section>
    <div class="days">
      {days.map((day) => (
        <article class:list={['day-card', day.type === 'FLEX' && 'flex']}>
          <div class="day-number"><span>DAY</span><strong>{day.day}</strong><b>{day.type}</b></div>
          <div class="day-main">
            <p class="mission">{day.mission}</p><h3>{day.focus}</h3>
            <dl class="details">
              <div><dt>BEFORE CLASS</dt><dd>{day.prep}</dd></div>
              <div><dt>MATERIALS</dt><dd>{day.materials}</dd></div>
              <div><dt>STUDENTS SEE / DO</dt><dd>{day.task}</dd></div>
              <div><dt>KEY SCIENCE</dt><dd>{day.science}</dd></div>
              <div><dt>TEACHER EMPHASIS</dt><dd>{day.emphasis}</dd></div>
              <div><dt>COLLECT / ASSESS</dt><dd>{day.record}</dd></div>
              <div><dt>TEACHER SHEET</dt><dd>{day.sheet}</dd></div>
              <div><dt>IF TIME RUNS OUT</dt><dd>{day.cut}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>

    <section class="panel" id="materials"><p class="eyebrow">MISSION MATERIALS MASTER LIST</p><h2>Five bins, not twenty-five setups.</h2><p>Prioritize <strong>shared stations, reused classroom materials and printed/printable records</strong>. Keep reusable manipulatives in team-count kits and print only consumable records.</p><div class="grid five">{missionMaterials.map((m) => <article><strong>{m.mission} — {m.title}</strong><p>{m.items}</p></article>)}</div></section>

    <section class="panel" id="assessment"><p class="eyebrow">ASSESSMENT</p><h2>FORMATIVE → CHECKPOINT → MAJOR SYNTHESIS</h2><div class="grid five">
      <article><strong>M1 Environment Profile</strong><p>FORMATIVE observation + inference.</p></article>
      <article><strong>M2 Native Species Card</strong><p>FORMATIVE adaptation + evidence.</p></article>
      <article><strong>M3 Ecosystem Map</strong><p>FORMATIVE connections + matter cycling; compact digital report is the central CHECKPOINT.</p></article>
      <article><strong>M4 Ecosystem Change Record</strong><p>Stronger CHECKPOINT; formative or lightly graded.</p></article>
      <article><strong>M5 JCEC Recommendation Board</strong><p>MAJOR SYNTHESIS. Day 22 can provide optional individual evidence.</p></article>
    </div><p class="note">Do not grade every reflection. If percentages are required: Recommendation Board <strong>55%</strong>, short individual science check <strong>30%</strong>, selected individual reasoning/field evidence <strong>15%</strong>.</p></section>

    <section class="panel" id="local"><p class="eyebrow">MISSION 4 LOCAL SOURCES</p><h2>Use specific evidence, not generalized perspective.</h2><p>Students <strong>do not invent or generalize an Indigenous perspective</strong>. They describe what the specific source actually contributes.</p><ul>{localSources.map(([label,url]) => <li><a href={url}>{label}</a></li>)}</ul></section>

    <section class="panel" id="recovery"><p class="eyebrow">ABSENCE + RECOVERY</p><h2>Recover evidence, not busywork.</h2><div class="grid three"><article><strong>Missed hands-on class</strong><p>Use team data plus a short individual interpretation instead of recreating the whole lab.</p></article><article><strong>Offline / weak Wi-Fi</strong><p>Students still Save. Keep the same Chromebook/browser profile; when online, reopen Phase 1 and let the retry queue send. Save once more if needed.</p></article><article><strong>Different Chromebook</strong><p>Team Directory → existing Team ID → Team Recovery. Previously central-sent records remain safe; old-device-only work does not transfer automatically.</p></article></div></section>

    <section class="panel" id="contingency"><p class="eyebrow">CONTINGENCY PLAN</p><h2>Know what to do when class does not go to plan.</h2><div class="grid two">{contingencies.map(([title,text]) => <article><strong>{title}</strong><p>{text}</p></article>)}</div></section>

    <section class="panel readiness"><p class="eyebrow">TEACHER READINESS AUDIT</p><h2>Five questions before you teach tomorrow.</h2><ul>{readinessQuestions.map((q) => <li>{q}</li>)}</ul></section>

    <section class="panel" id="transition"><p class="eyebrow">END OF PHASE 1</p><h2>Transition gate</h2><ul><li>Team Directory identity and continent are correct.</li><li>Mission Progress shows <strong>6/6 — Complete</strong>.</li><li>Missing Records has no unresolved required checkpoint.</li><li>JCEC Recommendation Board is collected/assessed as intended.</li><li>Any required individual evidence/feedback is resolved.</li><li>Class Summary complete count matches the teams actually being cleared.</li></ul><p class="note"><strong>Flex rule:</strong> protect core science first. Absorb lost time in this order: Day 15 → Day 20 → Day 23 → Day 24 → Day 25. Day 24 is the first full activity to drop.</p></section>
  </div>

  <script is:inline>document.getElementById('print-guide')?.addEventListener('click',()=>window.print());</script>
  <style>
    .teacher-shell{max-width:1220px;margin:0 auto;padding:1rem 1rem 4rem;color:#dceef4}.teacher-nav{display:flex;flex-wrap:wrap;gap:.4rem;margin:.8rem 0}.teacher-nav a{padding:.45rem .6rem;border:1px solid #2e5060;border-radius:8px;color:#b9dce5;text-decoration:none}.hero{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;padding:1.5rem;margin:1rem 0;border:1px solid #31526a;border-radius:20px;background:linear-gradient(145deg,#071a2c,#0c2c3b)}.hero h1{margin:.2rem 0;font-size:clamp(2rem,5vw,4rem);line-height:.95;color:#fff}.hero h1 span{color:#91dfc6}.hero p{max-width:820px;color:#aec7d2}.mission-line{font-size:.86rem}.hero aside{display:grid;gap:.2rem;padding:1rem;border:1px solid #466879;border-radius:14px;background:#061622;text-align:center}.hero aside strong{font-size:1.25rem;color:#fff}.hero aside span,.eyebrow{font:850 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;color:#7be2c1}.panel{margin:1rem 0;padding:1.2rem;border:1px solid #294b5c;border-radius:16px;background:#091d29}.important{border-color:#4b806e;background:#0a2828}.panel h2,.section-head h2{margin:.25rem 0 .65rem;color:#fff}.panel li{margin:.4rem 0;line-height:1.5}.panel a{color:#9ce1cf}.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.button{padding:.7rem .9rem;border-radius:9px;text-decoration:none;font-weight:900;cursor:pointer}.primary{background:#b7e67d;color:#16320c!important;border:0}.secondary{background:#0a202b;color:#dbeef4!important;border:1px solid #466875}.grid{display:grid;gap:.75rem}.grid.three{grid-template-columns:repeat(3,1fr)}.grid.two{grid-template-columns:repeat(2,1fr)}.grid.five{grid-template-columns:repeat(5,1fr)}.quick article,.grid.five article,.grid.two article{padding:1rem;border:1px solid #294b5c;border-radius:14px;background:#081a25}.quick strong,.grid.five strong,.grid.two strong{color:#fff}.quick p,.grid.five p,.grid.two p,.note{color:#a9c1cb;line-height:1.5}.planning-legend p:last-child{font-weight:800;col