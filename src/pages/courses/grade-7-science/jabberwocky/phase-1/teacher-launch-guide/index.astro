---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;

const days = [
  { day: 1, week: 1, title: 'Op 01 — Mission Assignment', route: '', prep: 'Continent assignments + Team IDs ready.', materials: 'Devices; Pathfinder Logs.', flow: 'Launch story → explain teams/archive → open assigned posting → individual starting hypothesis.', finish: 'Correct posting + individual evidence-based hypothesis.', assess: 'Baseline only.', cut: 'Team branding / extended sharing.' },
  { day: 2, week: 1, title: 'Op 02 — Earth Environmental Survey', route: 'operation-02/', prep: 'Choose 3 safe sample areas; check weather.', materials: 'Thermometer; ~1 m² markers/string; clipboards; Field Sheet.', flow: 'Biotic/abiotic + safety → 3 microhabitat samples → compare → observation vs inference.', finish: 'Three complete sample records.', assess: 'Formative field skills.', cut: 'Extra sensors/sites.' },
  { day: 3, week: 1, title: 'Op 02 — Landing-Zone Analysis', route: 'operation-02/', prep: 'Return field sheets; JCEC Portal ready.', materials: 'Device; Field Sheet; Pathfinder Log.', flow: 'Classify scan evidence → landing-zone questions → Earth/Jabberwocky comparison → archive submission.', finish: 'Landing Site Profile with evidence + uncertainty.', assess: 'Formative archive reasoning.', cut: 'Whole-class continent comparison.' },
  { day: 4, week: 1, title: 'Op 03 — Survival Structures Lab', route: 'operation-03/', prep: 'Set up 3 comparable resource zones/team.', materials: 'Spoon; tweezers; clothespin/tongs; chopsticks; timer; trays; craft objects; packet.', flow: 'Fair-test briefing → trials → compare structures within zones → trade-off debrief.', finish: 'Data table + evidence-based trade-off.', assess: 'Formative fair testing.', cut: 'Extended oral defence.' },
  { day: 5, week: 1, title: 'Op 03 — First Contact Reconstruction', route: 'operation-03/', prep: 'Return reconstruction sheets; confirm stored continent.', materials: 'Device; reconstruction sheet.', flow: 'Read 6 clues → mark ≥3 key clues → reconstruction + adaptations → brief habitat/resource-use summary → archive.', finish: 'Evidence-linked organism profile.', assess: 'Formative; evidence over artwork.', cut: 'Gallery / polished art / extended niche vocabulary.' },
  { day: 6, week: 2, title: 'Op 04 — Earth String Web', route: 'operation-04/', prep: 'Card/yarn kits ready; Food Web V1 printed.', materials: '8 cards; short yarn; arrow markers; Food Web V1.', flow: 'P/C/D + arrow rule → build web → decomposers → Prairie Grass stress test → model limits.', finish: 'Food→eater rule + one indirect-effect explanation.', assess: 'Formative exit check.', cut: 'Extra pathways / formal symbiosis detail.' },
  { day: 7, week: 2, title: 'Op 04 — Continental Food Web V1', route: 'operation-04/', prep: 'Return Food Web V1.', materials: 'Device; Food Web V1.', flow: 'Classify organisms → infer arrows → decomposer + competition/relationship → change challenge → archive.', finish: 'Complete network + direct/indirect prediction + uncertainty.', assess: 'Formative network understanding.', cut: 'Cross-continent symbiosis share.' },
  { day: 8, week: 2, title: 'CORE — Carbon + Water Cycles', route: 'operation-04/#planetary-cycles-checkpoint', prep: 'Prepare one quick water + carbon pathway example.', materials: 'Back of Food Web V1 or blank paper.', flow: 'Energy vs matter → water cycle → carbon cycle → 5+ labelled steps for each → decomposer connection.', finish: 'Two cycle pathways + energy/matter explanation.', assess: 'Core curriculum check.', cut: 'Decorative diagramming.' },
  { day: 9, week: 2, title: 'Op 05 — Population Sampling Lab', route: 'operation-05/', prep: 'Unknown cups of ~30–50 counters/team.', materials: '5×5 grid; counters; randomizer; calculator optional; packet.', flow: 'Round 1 estimate + true count → cluster same population → Round 2 → sampling uncertainty.', finish: 'Two estimates, same true total, distribution explanation.', assess: 'Formative sampling/calculation.', cut: 'Extra repeated samples.' },
  { day: 10, week: 2, title: 'Op 05 — Population CER', route: 'operation-05/', prep: 'Case Record ready; set grading decision.', materials: 'Device; CER Case Record.', flow: 'Graph rule → 3 datasets → all evidence → compare plausible claims → CER + alternative + uncertainty → archive.', finish: 'CER with exact values from ≥2 datasets.', assess: 'Recommended Data Reasoning mark.', cut: 'Peer critique / cross-continent share.' },
  { day: 11, week: 3, title: 'Op 06 — Surface Cover & Erosion Lab', route: 'operation-06/', prep: 'Pre-measure soil/water; towels at stations.', materials: '2 trays; soil; cover; cups; water; slope blocks; packet.', flow: 'Fair-test setup → bare vs ~75% cover → runoff/turbidity → erosion observations → model limits → cleanup.', finish: 'Comparable A/B data + conclusion.', assess: 'Formative fair-test evidence.', cut: 'Extra trial.' },
  { day: 12, week: 3, title: 'Op 06 — Recovery Zone', route: 'operation-06/', prep: 'Return Recovery Record.', materials: 'Device; Recovery Record.', flow: 'Succession/reference site → Days 1/12/30/55 → Recovery Gap → management decision → archive.', finish: 'Succession evidence + incomplete-recovery evidence + recommendation + monitoring need.', assess: 'Formative/light.', cut: 'Cross-continent comparison.' },
  { day: 13, week: 3, title: 'CORE — Local Ecosystem Change Decision', route: 'operation-06/#earth-field-link-2', prep: 'Provide a local issue + ≥2 credible sources, including a specific authentic Indigenous source when available.', materials: 'Source pack; photos/maps/data; Pathfinder Log.', flow: 'Local evidence → ≥2 signs of change + abiotic factor → compare sources → action + benefit + unintended consequence + monitoring.', finish: 'Real local evidence-based decision.', assess: 'Core local-environment evidence.', cut: 'Formal presentation.' },
  { day: 14, week: 3, title: 'Op 07 — Classified Incident: Biosecurity', route: 'operation-07/', prep: 'Keep reveal hidden; spread kits + packets ready.', materials: '6 zones; neutral + stowaway counters; scoop; packet.', flow: 'Reveal → introduced/invasive → no-checkpoint vs checkpoint simulation → incident timeline + spread/impact evidence.', finish: 'Provisional classification using spread + harm evidence.', assess: 'Incident Record in progress.', cut: 'Long whole-class share.' },
  { day: 15, week: 3, title: 'Op 07 — X-17 Biomagnification', route: 'operation-07/#contamination', prep: 'Contaminant model kits ready.', materials: '16 producers/tokens; 4 consumers; 1 predator; packet page 2.', flow: 'Persistence → token model → assumptions/limits → continent X-17 pathway → food-web/human-impact explanation.', finish: 'Correct biomagnification explanation + model limits.', assess: 'Contamination Record in progress.', cut: 'Extra scenario.' },
  { day: 16, week: 4, title: 'Op 07 — Response + Conservation Risk', route: 'operation-07/#conservation-risk-checkpoint', prep: 'Return Incident Records; set grading decision.', materials: 'Device; Incident Packet / Pathfinder Log.', flow: 'Compare responses/trade-offs → conservation risk + local/global extinction → finalize response + monitoring → archive.', finish: 'Response + biomagnification + conservation-risk reasoning.', assess: 'Recommended Environmental Decision-Making mark.', cut: 'Cross-continent briefings / policy memo.' },
  { day: 17, week: 4, title: 'Op 08 — Evidence Audit', route: 'operation-08/', prep: 'All archive artifacts accessible; packet/digital template ready.', materials: 'Continental Archive; Evidence Matrix.', flow: 'Ecological-clearance scope → findings from Op02–07 → choose 4 strongest across ≥4 operations + quantitative evidence.', finish: 'Evidence Matrix + why each selected item matters.', assess: 'Major summative in progress.', cut: 'Extra facts beyond strong evidence set.' },
  { day: 18, week: 4, title: 'Op 08 — Protection Plan + Human Rules', route: 'operation-08/#protection-plan', prep: 'Return Evidence Matrix + map.', materials: 'Device; protection map/report packet.', flow: 'Access categories → 4 planning zones → 3 human rules → working status → consistency check.', finish: 'Protection plan + 3 rules + working GREEN/YELLOW/ORANGE/RED status.', assess: 'Major summative in progress.', cut: 'Artistic map polish.' },
  { day: 19, week: 4, title: 'Op 08 — Final Reasoning + Handoff', route: 'operation-08/#final-report', prep: 'Set full-report destination; JCEC Portal ready.', materials: 'Evidence Matrix; protection plan; executive summary.', flow: 'Quality check → final reasoning → archive handoff → full artifact submission → JCEC executive summary → Day1-vs-Day19 reflection.', finish: 'Final report + handoff + summary + individual reflection.', assess: 'Major Phase 1 summative.', cut: 'Presentations/public polish; use Day 20 if needed.' }
];

const opUrl = (route) => `${base}courses/grade-7-science/jabberwocky/phase-1/${route}`;
---

<BaseLayout title="Phase 1 Teacher Launch Guide | Jabberwocky 2190" description="Day-by-day 5-week implementation guide for Jabberwocky Mission 2190 Phase 1." themeColor="#071b2e">
  <div class="teacher-shell">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Science',href:`${base}courses/grade-7-science/`},{label:'Jabberwocky',href:`${base}courses/grade-7-science/jabberwocky/`},{label:'Phase 1',href:opUrl('')},{label:'Teacher Launch Guide'}]} />

    <nav class="teacher-nav"><a href="#launch">Launch</a><a href="#days">Days 1–19</a><a href="#flex">Flex</a><a href="#materials">Materials</a><a href="#assessment">Assessment</a><a href="#day13">Day 13</a><a href="#contingency">Contingency</a><a href="#verification">Verification</a></nav>

    <header class="hero" id="launch"><div><p class="eyebrow">TEACHER OPERATIONS // PHASE 1</p><h1>FIRST CONTACT<br/><span>LAUNCH GUIDE</span></h1><p>A practical command board for <strong>25 × 45-minute classes</strong>. Protect 19 core periods and preserve six periods as real flex time.</p></div><aside><strong>5 WEEKS</strong><span>19 CORE + 6 FLEX</span></aside></header>

    <section class="panel"><p class="eyebrow">BEFORE DAY 1</p><h2>Set the system once.</h2><div class="grid four"><article><strong>Teams</strong><p>Assign continents and Team IDs such as <code>P1-GY-01</code>.</p></article><article><strong>Pathfinder Logs</strong><p>Choose paper or digital. Most reflections stay here rather than becoming separate marked submissions.</p></article><article><strong>Submission flow</strong><p>Routine archive summaries use the JCEC Portal; the full Op08 artifact uses your normal major-assignment destination.</p></article><article><strong>Local planning</strong><p>Choose Day 2 sites/fallback and prepare the Day 13 local source pack.</p></article></div><div class="actions"><a class="button primary" href={opUrl('')}>Open Phase 1 Hub</a><a class="button secondary" href="https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform" target="_blank" rel="noopener noreferrer">Open JCEC Portal ↗</a><button class="button secondary" id="print-guide" type="button">Print guide</button></div></section>

    <section class="timeline"><article><b>WEEK 1</b><span>Days 1–5</span><strong>Arrival & First Contact</strong></article><article><b>WEEK 2</b><span>Days 6–10</span><strong>Networks & Populations</strong></article><article><b>WEEK 3</b><span>Days 11–15</span><strong>Change & Human Impact</strong></article><article><b>WEEK 4</b><span>Days 16–20</span><strong>Response & Final Report</strong></article><article><b>WEEK 5</b><span>Days 21–25</span><strong>Flex & Assessment</strong></article></section>

    <section class="section-head" id="days"><p class="eyebrow">CORE PATH</p><h2>Days 1–19</h2><p>Open a student page from any card. <strong>Must finish</strong> is the protected stopping point; <strong>cut first</strong> is what disappears when time is short.</p></section>
    <div class="days">{days.map(d => <article class="day"><header><span>DAY {d.day}</span><div><small>WEEK {d.week}</small><h3>{d.title}</h3></div><a href={opUrl(d.route)}>Open →</a></header><div class="day-grid"><section><b>BEFORE CLASS</b><p>{d.prep}</p></section><section><b>MATERIALS / PRINT</b><p>{d.materials}</p></section><section class="wide"><b>45-MIN FLOW</b><p>{d.flow}</p></section><section class="must"><b>MUST FINISH</b><p>{d.finish}</p></section><section><b>COLLECT / ASSESS</b><p>{d.assess}</p></section><section class="cut"><b>CUT FIRST</b><p>{d.cut}</p></section></div></article>)}</div>

    <section class="panel" id="flex"><p class="eyebrow">BUFFER IS A FEATURE</p><h2>Days 20–25</h2><div class="grid six"><article><strong>20 · Op08 completion</strong><p>Use first for spillover/absences.</p></article><article><strong>21 · Review</strong><p>Target recurring misconceptions.</p></article><article><strong>22 · Individual check</strong><p>Quiz/test only if needed.</p></article><article><strong>23 · Reteach</strong><p>Respond to assessment evidence.</p></article><article><strong>24 · Optional presentations</strong><p>Cross-continent briefings.</p></article><article><strong>25 · Buffer / Phase 2</strong><p>Make-up, interruption, or transition.</p></article></div><p class="warning"><strong>Do not pre-fill all six flex days.</strong> Their purpose is to protect the core sequence.</p></section>

    <section class="panel" id="materials"><p class="eyebrow">PREP / PRINT</p><h2>Master materials plan</h2><div class="grid two"><article><strong>Op02</strong><p>Thermometers, markers/string, clipboards. Print Field Sheet × teams.</p></article><article><strong>Op03</strong><p>Spoon, tweezers, tongs, chopsticks, timers, 3 trays, craft objects. Print 2-page packet × teams.</p></article><article><strong>Op04</strong><p>Laminated cards, short yarn, arrow markers. Print Food Web V1 × teams. Day 8 uses blank/back paper.</p></article><article><strong>Op05</strong><p>5×5 grids + unknown counter cups. Print 2-page population/CER packet × teams.</p></article><article><strong>Op06</strong><p>2 trays/team, soil, cover, cups, water, slope blocks, towels. Print 2-page packet × teams.</p></article><article><strong>Op07</strong><p>Spread kit + contaminant kit. Print 2-page Incident Packet × teams.</p></article><article><strong>Op08</strong><p>Entire Continental Archive. Print final packet × teams unless fully digital.</p></article></div></section>

    <section class="panel" id="assessment"><p class="eyebrow">MARK LESS, LEARN MORE</p><h2>Assessment load</h2><div class="grid five"><article><strong>Op02–04 · formative</strong><p>Field skills, adaptations, networks, cycles.</p></article><article><strong>Op05 · stronger mark</strong><p>Data Reasoning CER.</p></article><article><strong>Op06 · light/formative</strong><p>Recovery decision.</p></article><article><strong>Op07 · stronger mark</strong><p>Environmental Decision-Making.</p></article><article><strong>Op08 · major summative</strong><p>Science Understanding · Evidence · Reasoning · Communication/Decision-Making.</p></article></div></section>

    <section class="panel local" id="day13"><p class="eyebrow">DAY 13 // RECOMMENDED CALGARY DEFAULT</p><h2>Elbow River riparian health & source-water protection</h2><p>Use short teacher-selected excerpts rather than a broad student web search. This case connects restoration, monitoring, water, land use, and environmental decisions.</p><div class="sources"><a href="https://www.calgary.ca/water/stormwater/source-water-protection.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary — Source Water Protection</strong><span>Source watersheds and cooperation across jurisdictions.</span></a><a href="https://www.calgary.ca/water/stormwater/riparian-areas.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary — Riparian Areas</strong><span>Monitoring, health indicators and restoration approaches.</span></a><a href="https://tsuutina.com/wp-content/uploads/2025/06/Niska.Newsletter.June10.2025.final_.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut’ina Nation — Wolf Creek / Elbow watershed</strong><span>Authentic Nation source describing restoration, monitoring and watershed partnership work.</span></a><a href="https://tsuutina.com/wp-content/uploads/2023/10/Lands.Newsletter.FinalEditition.August2022.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut’ina Lands — Land & Environment</strong><span>Optional deeper source on land/environment planning and sustainability.</span></a></div><p class="source-rule"><strong>Source rule:</strong> do not invent a generic Indigenous perspective. Students report what the specific Tsuut’ina source actually contributes.</p><p class="question"><strong>Possible management question:</strong> How should Calgary protect and restore riparian areas while people continue to use the river corridor?</p></section>

    <section class="panel" id="contingency"><p class="eyebrow">WHEN SCHOOL HAPPENS</p><h2>Contingency playbook</h2><div class="grid two"><article><strong>30-minute period</strong><p>Do the concept launch + evidence task; move archive wording/reflection forward. Never rush lab safety/cleanup.</p></article><article><strong>1–2 lost days</strong><p>Use Day 20, then Day 21. Keep core order intact.</p></article><article><strong>3+ lost days</strong><p>Cut presentations → gallery walks → peer critique → extra samples/datasets → artistic polish → extension vocabulary.</p></article><article><strong>Op02 outdoors unavailable</strong><p>Use 3 contrasting indoor microhabitats and discuss limitations.</p></article><article><strong>Day13 field access unavailable</strong><p>Use maps, photos, monitoring data and supplied sources; a field trip is not required.</p></article><article><strong>Lost archive artifact</strong><p>Reconstruct the essential finding from the JCEC summary + site evidence rather than redoing the investigation.</p></article></div></section>

    <section class="panel verify" id="verification"><p class="eyebrow">FINAL RESOURCE CHECK</p><h2>What is being verified automatically</h2><div class="grid two"><article><strong>✓ Routes + data</strong><p>Phase 1 hub, Teacher Launch Guide, Op02–08 pages, data files and teacher guides must exist before the site build runs.</p></article><article><strong>✓ Print controls</strong><p>The build audit checks the core printable control on every Op02–08 page.</p></article><article><strong>✓ JCEC wiring</strong><p>The build audit checks Form references and Op02→03→04→05→06→07→08 navigation wiring.</p></article><article><strong>✓ Curriculum inserts</strong><p>Day 8 cycles, Day 13 local field link and Op07 conservation checkpoint are required by the build audit.</p></article><article><strong>✓ Launch Guide</strong><p>All Days 1–19 and the recommended Day 13 sources are required by the build audit.</p></article><article><strong>✓ External local sources</strong><p>City of Calgary + Tsuut’ina source URLs were rechecked while this guide was built.</p></article></div><p class="verify-note">The repository now runs the Phase 1 readiness audit before every Astro build. A failed required resource check stops deployment instead of silently publishing an incomplete Phase 1.</p></section>

    <section class="final"><p class="eyebrow">BEFORE DAY 1</p><h2>Seven final checks</h2><ol><li>Continent assignments + Team IDs ready.</li><li>Pathfinder Log format chosen.</li><li>JCEC Portal tested on a school device.</li><li>Day 2 locations or indoor fallback chosen.</li><li>Reusable Op03–07 lab kits planned.</li><li>Day 13 local source pack prepared.</li><li>Op05, Op07 and Op08 grading decisions made.</li></ol><p><strong>Do not try to complete every optional feature.</strong> Protect the scientific journey and the Continental Archive.</p></section>
  </div>
  <script is:inline>document.getElementById('print-guide')?.addEventListener('click',()=>window.print());</script>
</BaseLayout>

<style>
:global(body){background:#06111f}.teacher-shell{max-width:1160px;margin:auto;padding:0 1rem 5rem;color:#eaf5ff}.teacher-shell :global(.breadcrumbs){color:#9fb8c8}.teacher-shell :global(.breadcrumbs a){color:#d3eafa}.teacher-nav{position:sticky;top:.5rem;z-index:20;display:flex;gap:.3rem;overflow:auto;margin:1rem 0;padding:.4rem;border:1px solid #284c5e;border-radius:13px;background:rgba(5,20,33,.95)}.teacher-nav a{flex:0 0 auto;padding:.5rem .65rem;border-radius:8px;color:#bad0dc;text-decoration:none;font-size:.78rem;font-weight:850}.teacher-nav a:hover{background:#123348;color:#fff}.hero{display:grid;grid-template-columns:1fr auto;gap:1.2rem;margin:1rem 0;padding:clamp(1.3rem,4vw,2.5rem);border:1px solid #2d6270;border-radius:22px;background:radial-gradient(circle at 80% 18%,rgba(110,242,207,.16),transparent 25%),linear-gradient(145deg,#071727,#0b2b3d)}.eyebrow{margin:0;color:#74e9cb;font:850 .74rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.hero h1{margin:.45rem 0;color:#fff;font-size:clamp(2.8rem,7vw,5rem);line-height:.9;letter-spacing:-.05em}.hero h1 span{color:#6ef2cf}.hero>div>p:last-child{max-width:760px;color:#bdd2dd;line-height:1.6}.hero aside{align-self:end;display:grid;padding:1rem;border:1px solid #315d73;border-radius:12px;background:#071923}.hero aside strong{color:#6ef2cf;font-size:1.35rem}.hero aside span{color:#9db7c5;font-size:.8rem}.panel,.final{margin:1rem 0;padding:clamp(1rem,3vw,1.5rem);border:1px solid #23485a;border-radius:17px;background:#091c2a}.panel h2,.final h2,.section-head h2{margin:.3rem 0 .8rem;color:#fff;font-size:clamp(1.4rem,3vw,1.9rem)}.grid{display:grid;gap:.6rem}.grid.two,.grid.four{grid-template-columns:repeat(2,1fr)}.grid.five{grid-template-columns:repeat(5,1fr)}.grid.six{grid-template-columns:repeat(3,1fr)}.grid article{padding:.75rem;border:1px solid #284857;border-radius:10px;background:#071822}.grid strong{color:#fff}.grid p{margin:.3rem 0 0;color:#aec4cf;line-height:1.45}.actions{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.9rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:.6rem .85rem;border-radius:9px;text-decoration:none;font:inherit;font-weight:850;cursor:pointer}.button.primary{border:0;background:#6ef2cf;color:#052318}.button.secondary{border:1px solid #42677b;background:#071722;color:#e8f5fb}.timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:.5rem;margin:1rem 0}.timeline article{display:grid;gap:.15rem;padding:.7rem;border:1px solid #294a59;border-radius:10px;background:#071923}.timeline b{color:#6ef2cf;font-size:.7rem}.timeline span{color:#829fad;font-size:.72rem}.timeline strong{color:#fff;font-size:.82rem}.section-head{margin:2rem 0 .8rem}.section-head>p:last-child{color:#abc2cd}.days{display:grid;gap:.75rem}.day{overflow:hidden;border:1px solid #2a5264;border-radius:15px;background:#081a27}.day header{display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.8rem .9rem;border-bottom:1px solid #244453;background:#0b2634}.day header>span{padding:.4rem .5rem;border-radius:8px;background:#123b37;color:#8df1d4;font:900 .73rem ui-monospace,SFMono-Regular,monospace}.day small{color:#7f9dad;font-weight:800}.day h3{margin:.1rem 0;color:#fff;font-size:1.05rem}.day header a{color:#8cebd2;text-decoration:none;font-size:.8rem;font-weight:850}.day-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;padding:.65rem}.day-grid section{padding:.65rem;border:1px solid #203e4d;border-radius:9px;background:#071620}.day-grid .wide{grid-column:1/-1}.day-grid b{color:#80d9c5;font-size:.68rem;letter-spacing:.05em}.day-grid p{margin:.25rem 0 0;color:#aec4cf;font-size:.82rem;line-height:1.45}.day-grid .must{border-color:#39725e;background:#09251f}.day-grid .cut{border-color:#675934;background:#211d10}.warning,.source-rule,.question,.verify-note{margin:.8rem 0 0;padding:.75rem;border-left:3px solid #f1d578;background:#211e12;color:#d8cfad;line-height:1.5}.local{border-color:#416c61;background:linear-gradient(145deg,#092129,#0d2c2c)}.local>p:not(.eyebrow){color:#bad1d0;line-height:1.55}.sources{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.sources a{display:grid;gap:.2rem;padding:.75rem;border:1px solid #38645d;border-radius:10px;background:#071b22;color:#fff;text-decoration:none}.sources a:hover{border-color:#6ef2cf}.sources span{color:#a8c7c4;font-size:.8rem;line-height:1.4}.source-rule{border-color:#74e9cb;background:#0a2828;color:#c5dfda}.question{border-color:#5d8dac;background:#0b2434;color:#c5dbe8}.verify-note{border-color:#6ef2cf;background:#0a2828;color:#c5dfda}.final{border-color:#447966;background:linear-gradient(145deg,#0a2629,#071a25)}.final ol{columns:2;color:#bfd2dc;line-height:1.8}.final>p:last-child{color:#c5d8df}.final strong{color:#fff}@media(max-width:900px){.hero{grid-template-columns:1fr}.timeline{grid-template-columns:1fr 1fr}.grid.five{grid-template-columns:1fr 1fr}.day-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.teacher-shell{padding-inline:.65rem}.timeline,.grid.two,.grid.four,.grid.five,.grid.six,.day-grid,.sources{grid-template-columns:1fr}.day-grid .wide{grid-column:auto}.day header{grid-template-columns:auto 1fr}.day header a{grid-column:1/-1}.final ol{columns:1}.actions{display:grid}.button{width:100%}}@media print{.teacher-nav,.actions,:global(.site-header),:global(footer),:global(.jcec-submission-dock){display:none!important}:global(body){background:#fff!important}.teacher-shell{max-width:none;color:#111;padding:0}.hero,.panel,.final,.day,.timeline article{background:#fff!important;border-color:#aaa!important;break-inside:avoid}.hero h1,.hero h1 span,.panel h2,.final h2,.day h3,.grid strong,.day-grid b{color:#111!important}.grid p,.day-grid p,.hero>div>p:last-child{color:#333!important}.day header a,.sources{display:none}}
</style>
