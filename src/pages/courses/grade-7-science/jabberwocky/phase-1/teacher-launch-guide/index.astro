---
import BaseLayout from '../../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../../components/Breadcrumbs.astro';
const base = import.meta.env.BASE_URL;

const days = [
  { day: 1, week: 1, title: 'Operation 01 — Mission Assignment', href: `${base}courses/grade-7-science/jabberwocky/phase-1/`, prep: 'Have continent assignments + Team IDs ready. Decide whether the initial hypothesis is also submitted today.', materials: 'Devices; Pathfinder Log.', flow: 'Launch Mission 2190 → explain Archive vs Pathfinder Log → teams open assigned posting → each student records an evidence-based starting hypothesis.', finish: 'Assigned continent is correct; every student has an initial hypothesis; students know the preliminary rating is not an answer key.', collect: 'Low-stakes individual baseline.', cut: 'Team branding, logos, extended continent share.' },
  { day: 2, week: 1, title: 'Operation 02 — Earth Environmental Survey', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-02/`, prep: 'Choose safe sample locations / boundaries and check weather. Put one field kit + Field Sheet at each table.', materials: 'Thermometer; ~1 m² markers/string; clipboard; pencil; optional hand lens/light/moisture sensor; Op02 Field Sheet.', flow: '5 min biotic/abiotic + safety → roles → ~25 min three microhabitat samples → compare sites → observation vs inference debrief.', finish: 'Three sample records with abiotic evidence, organisms/signs of life, and human impact.', collect: 'Formative field skills + units.', cut: 'Extra sensors or extra sites; keep the three core samples.' },
  { day: 3, week: 1, title: 'Operation 02 — Jabberwocky Landing-Zone Analysis', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-02/`, prep: 'Return Day 2 field sheets. Have the JCEC Portal ready.', materials: 'Device; field sheet; Pathfinder Log.', flow: 'Revisit Earth evidence → classify continent scan → answer investigation questions → compare Earth/Jabberwocky → write + submit concise Landing Site Environmental Profile.', finish: 'Team archive entry includes biotic + abiotic evidence, limiting factor/reasoning, and one uncertainty.', collect: 'Formative archive reasoning.', cut: 'Whole-class comparison of all eight continents.' },
  { day: 4, week: 1, title: 'Operation 03 — Survival Structures Lab', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-03/`, prep: 'Prepare three resource zones per team and consistent starting conditions.', materials: 'Spoon; tweezers; clothespin/tongs; chopsticks; timer; 3 trays; craft resources; cup; Op03 packet.', flow: 'Structure/function + fair-test briefing → practice → test four structures in three zones → compare within each zone → identify trade-offs.', finish: 'Data table + one evidence-based structure/function trade-off.', collect: 'Formative fair testing.', cut: 'Extended oral defence; keep the debrief.' },
  { day: 5, week: 1, title: 'Operation 03 — First Contact Reconstruction', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-03/`, prep: 'Return reconstruction sheets and confirm stored continent.', materials: 'Device; reconstruction sheet; pencil; optional coloured pencils.', flow: 'Read all 6 clues → mark ≥3 key clues → reconstruct organism → 3 structural + 1 behavioural adaptation with evidence → brief habitat/resource-use summary → reveal field name → archive.', finish: 'Evidence-linked reconstruction + Native Organism Profile.', collect: 'Formative; grade evidence reasoning, not art or formal niche vocabulary.', cut: 'Polished drawing, gallery walk, extended niche terminology.' },
  { day: 6, week: 2, title: 'Operation 04 — Earth String Web', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-04/`, prep: 'Put laminated card/yarn kits at tables; print Food Web V1.', materials: '8 ecosystem cards; short yarn; arrow markers; Food Web V1.', flow: 'P/C/D retrieval + arrow rule → build web → trace energy → decomposers → remove Prairie Grass → direct/indirect/competition effects → model-limit debrief.', finish: 'Students can explain food → eater arrows and one indirect effect.', collect: 'Formative exit check.', cut: 'Extra pathways/formal symbiosis classification.' },
  { day: 7, week: 2, title: 'Operation 04 — Continental Food Web V1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-04/`, prep: 'Return Food Web V1 sheets.', materials: 'Device; Food Web V1.', flow: 'Classify organisms → infer feeding arrows → add decomposer + competition/relationship evidence → change challenge → archive summary.', finish: 'Complete Food Web V1 with focal species, P/C/D, arrows, decomposer, direct/indirect prediction, uncertainty.', collect: 'Formative network understanding.', cut: 'Cross-continent symbiosis share.' },
  { day: 8, week: 2, title: 'CORE Checkpoint — Carbon + Water Cycles', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-04/#planetary-cycles-checkpoint`, prep: 'Prepare a quick teacher model of one water pathway and one carbon pathway.', materials: 'Back of Food Web V1 or blank paper; pencil.', flow: 'Energy flows vs matter cycles → water through abiotic + biotic parts → carbon through producers/consumers/respiration/waste/decomposition → Cycle Overlay Challenge.', finish: '≥5 labelled steps for each cycle + explanation of why energy does not cycle the same way matter does.', collect: 'Core curriculum check; no extra Form.', cut: 'Decorative diagramming / extra examples.' },
  { day: 9, week: 2, title: 'Operation 05 — Population Sampling Lab', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-05/`, prep: 'Prepare one unknown cup of ~30–50 counters per team and print packet.', materials: '5×5 grid; counters; website randomizer; calculator optional; Op05 packet.', flow: 'Population/sample/distribution briefing → Round 1 random estimate + true count → cluster same population → Round 2 estimate → compare sampling uncertainty.', finish: 'Two estimates with same true total + explanation of distribution effect.', collect: 'Formative sampling/calculation evidence.', cut: 'Repeated extra samples; keep both rounds.' },
  { day: 10, week: 2, title: 'Operation 05 — Continental Population CER', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-05/`, prep: 'Have Case Record ready; decide whether this is a summative Data Reasoning mark.', materials: 'Device; CER Case Record.', flow: 'Graph detective + detections reminder → analyze 3 datasets → read all evidence → compare plausible claims → write CER with alternative + uncertainty → archive.', finish: 'Defensible CER using exact values from ≥2 datasets.', collect: 'Recommended stronger Data Reasoning assessment.', cut: 'Peer critique / cross-continent share.' },
  { day: 11, week: 3, title: 'Operation 06 — Surface Cover & Erosion Lab', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-06/`, prep: 'Pre-measure soil/water where possible and put towels at stations.', materials: '2 trays; equal soil; cover material; cups; measured water; blocks/books; Op06 packet.', flow: 'Disturbance/succession + fair test → build bare vs ~75% covered trays → runoff test → turbidity/erosion observations → model limits → cleanup.', finish: 'Comparable Tray A/B data + one conclusion about cover/runoff/erosion.', collect: 'Formative fair-test evidence.', cut: 'Extra trial; keep one fair comparison + debrief.' },
  { day: 12, week: 3, title: 'Operation 06 — Recovery Zone Investigation', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-06/`, prep: 'Return Recovery Record.', materials: 'Device; Recovery Record.', flow: 'Succession/species richness/reference site → Days 1/12/30/55 → Recovery Gap → strongest recovery + incomplete-recovery evidence → management recommendation → archive.', finish: 'Evidence of succession + recovery gap + recommendation + next-monitoring need.', collect: 'Formative or lightly graded.', cut: 'Cross-continent recovery comparison.' },
  { day: 13, week: 3, title: 'CORE Earth Field Link 2 — Local Ecosystem Change Decision', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-06/#earth-field-link-2`, prep: 'Select one local issue + at least two credible sources; provide excerpts/links/photos/maps. Use a specific authentic Indigenous source when available.', materials: 'Teacher-approved local sources; Pathfinder Log or local evidence record.', flow: 'Connect succession/monitoring to Earth → record ≥2 signs of change + 1 abiotic condition → compare sources → propose action + benefit + unintended consequence + next monitoring.', finish: 'A real local evidence-based decision using multiple sources.', collect: 'Core curriculum evidence; no JCEC Form required.', cut: 'Full presentation; keep evidence + source comparison + decision.' },
  { day: 14, week: 3, title: 'Operation 07 — Classified Incident: Biosecurity', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-07/`, prep: 'Keep incident reveal hidden until class. Prepare spread kits + packet.', materials: '6 cups/zones; ~30 neutral counters; 4 stowaway counters; scoop; Op07 packet.', flow: 'Classified reveal → introduced/invasive vocabulary → Spread Simulation no-checkpoint vs checkpoint → model limits → continent timeline + spread/impact evidence → provisional classification.', finish: 'Students distinguish origin from harm and cite spread + impact evidence.', collect: 'Incident Record in progress.', cut: 'Long whole-class share.' },
  { day: 15, week: 3, title: 'Operation 07 — X-17 Biomagnification', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-07/#contamination`, prep: 'Put contaminant-model kits at tables.', materials: '16 producer cards/tokens; 4 consumer cards; 1 predator card; packet page 2.', flow: 'Persistence/bioaccumulation/biomagnification → token model → assumptions/limits → continent X-17 pathway → connect to food web + human impact.', finish: 'Students explain higher concentration in top consumers and why not every substance biomagnifies.', collect: 'Contamination Record in progress.', cut: 'Additional contamination scenario.' },
  { day: 16, week: 4, title: 'Operation 07 — Response + Conservation Risk', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-07/#conservation-risk-checkpoint`, prep: 'Return Incident Records; decide whether Op07 is a stronger summative assessment.', materials: 'Device; Incident Packet / Pathfinder Log.', flow: 'Recap evidence → compare plausible responses/trade-offs → conservation risk + local/global extinction → finalize response + unintended consequence + monitoring → archive.', finish: 'Response, biomagnification reasoning, conservation-risk evidence, monitoring need.', collect: 'Recommended stronger Environmental Decision-Making assessment.', cut: 'Cross-continent briefings / policy memo.' },
  { day: 17, week: 4, title: 'Operation 08 — Evidence Audit', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-08/`, prep: 'Make sure teams can access all archive artifacts; print Op08 packet or assign digital equivalent.', materials: 'Continental Archive; Evidence Matrix.', flow: 'Ecological-clearance scope → one important finding from Op02–07 → select four strongest pieces from ≥4 operations including quantitative evidence → explain why each matters.', finish: 'Evidence Matrix + four strongest evidence selections.', collect: 'Part of major Phase 1 summative.', cut: 'Extra evidence beyond the strong required set.' },
  { day: 18, week: 4, title: 'Operation 08 — Protection Plan + Human Rules', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-08/#protection-plan`, prep: 'Return Evidence Matrix + planning map.', materials: 'Device; Protection Map / report packet.', flow: 'Access categories → assign four zones → write 3 human rules → choose working GREEN/YELLOW/ORANGE/RED status → check map/rules/status consistency.', finish: 'Protected-area plan + 3 specific rules + working status.', collect: 'Part of major Phase 1 summative.', cut: 'Artistic map polish.' },
  { day: 19, week: 4, title: 'Operation 08 — Final Reasoning + Archive Handoff', href: `${base}courses/grade-7-science/jabberwocky/phase-1/operation-08/#final-report`, prep: 'Set the full-report submission destination and have JCEC Portal ready.', materials: 'Evidence Matrix; Protection Plan; Executive Summary / digital report.', flow: 'Quality check → finalize status/evidence/reasoning/trade-offs/uncertainty → archive handoff → submit full artifact → one team JCEC executive summary → individual Day1-vs-Day19 reflection.', finish: 'Major report + archive handoff + executive summary + individual change-in-thinking reflection.', collect: 'Major Phase 1 summative synthesis.', cut: 'Presentations/public-facing polish; move unfinished report to Day 20.' }
];

const weeks = [
  { week: 1, label: 'Arrival & First Contact', days: '1–5' },
  { week: 2, label: 'Networks & Population Evidence', days: '6–10' },
  { week: 3, label: 'Environmental Change & Human Impact', days: '11–15' },
  { week: 4, label: 'Response & Final Ecological Report', days: '16–20' },
  { week: 5, label: 'Flex, Review & Selected Assessment', days: '21–25' }
];
---

<BaseLayout title="Phase 1 Teacher Launch Guide | Jabberwocky 2190" description="A 5-week, day-by-day implementation guide for teaching Jabberwocky Mission 2190 Phase 1 in 45-minute Grade 7 Science classes." themeColor="#071b2e">
  <div class="teacher-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Teacher Launch Guide' }
    ]} />

    <nav class="teacher-nav" aria-label="Teacher guide navigation">
      <a href="#launch">Launch</a><a href="#daily">Days 1–19</a><a href="#flex">Days 20–25</a><a href="#materials">Materials</a><a href="#assessment">Assessment</a><a href="#local-link">Day 13</a><a href="#contingency">Contingency</a><a href="#verification">Verification</a>
    </nav>

    <header class="teacher-hero" id="launch">
      <div><p>TEACHER OPERATIONS // PHASE 1</p><h1>FIRST CONTACT<br /><span>LAUNCH GUIDE</span></h1><p class="lead">A practical 25-day command board for 45-minute Grade 7 Science classes. Protect the 19 core periods; keep six periods as real flex time.</p></div>
      <aside><strong>5 WEEKS</strong><span>25 × 45 min</span><dl><div><dt>Core</dt><dd>19 periods</dd></div><div><dt>Flex</dt><dd>6 periods</dd></div><div><dt>Major summative</dt><dd>Op 08</dd></div></dl></aside>
    </header>

    <section class="command-panel">
      <div><p class="eyebrow">BEFORE DAY 1</p><h2>Do these once, then teach from the daily cards.</h2></div>
      <div class="setup-grid">
        <article><strong>Teams</strong><p>Assign continents and IDs such as <code>P1-GY-01</code>. Decide whether devices stay with teams so local progress remains available.</p></article>
        <article><strong>Pathfinder Logs</strong><p>Choose paper notebook or digital format. Most individual reflections stay here instead of becoming separate marked submissions.</p></article>
        <article><strong>Submission flow</strong><p>Routine archive summaries use the JCEC Portal. The full Operation 08 artifact should go to your normal major-assignment location.</p></article>
        <article><strong>Local planning</strong><p>Choose Day 2 field locations / indoor fallback and preselect the Day 13 local environmental case + authentic sources.</p></article>
      </div>
      <div class="actions"><a class="button primary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Open Phase 1 Hub</a><a class="button secondary" href="https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform" target="_blank" rel="noopener noreferrer">Open JCEC Portal ↗</a><button class="button secondary" id="print-guide" type="button">Print this guide</button></div>
    </section>

    <section class="week-strip" aria-label="Five week overview">
      {weeks.map(item => <article><b>WEEK {item.week}</b><strong>{item.label}</strong><span>Days {item.days}</span></article>)}
    </section>

    <section id="daily" class="section-heading"><p class="eyebrow">CORE TEACHING PATH</p><h2>Days 1–19</h2><p>Each card tells you what to prep, what must happen, what to collect, and what to cut first when the clock wins.</p></section>

    <div class="day-list">
      {days.map(item => (
        <article class="day-card" id={`day-${item.day}`}>
          <header><span>DAY {item.day}</span><div><small>WEEK {item.week}</small><h3>{item.title}</h3></div><a href={item.href}>Open student page →</a></header>
          <div class="day-grid">
            <section><b>BEFORE CLASS</b><p>{item.prep}</p></section>
            <section><b>MATERIALS / PRINT</b><p>{item.materials}</p></section>
            <section class="wide"><b>45-MINUTE FLOW</b><p>{item.flow}</p></section>
            <section class="must"><b>MUST FINISH</b><p>{item.finish}</p></section>
            <section><b>COLLECT / ASSESS</b><p>{item.collect}</p></section>
            <section class="cut"><b>IF BEHIND — CUT FIRST</b><p>{item.cut}</p></section>
          </div>
        </article>
      ))}
    </div>

    <section id="flex" class="teacher-section">
      <p class="eyebrow">BUFFER IS A FEATURE</p><h2>Days 20–25</h2>
      <div class="flex-grid"><article><span>20</span><strong>Op08 completion / absences</strong><p>Use this first when any earlier class runs long.</p></article><article><span>21</span><strong>Focused unit review</strong><p>Target recurring misconceptions instead of re-teaching every page.</p></article><article><span>22</span><strong>Selected individual assessment</strong><p>Short quiz/test if you need additional individual evidence.</p></article><article><span>23</span><strong>Reteach from evidence</strong><p>Use assessment results to target gaps.</p></article><article><span>24</span><strong>Optional presentations</strong><p>Cross-continent comparison or selected final briefings.</p></article><article><span>25</span><strong>Buffer / transition</strong><p>Make-up, school interruption buffer, or launch Phase 2.</p></article></div>
      <p class="warning"><strong>Do not pre-fill all six periods with required new work.</strong> Their job is to protect the 19-period core pathway.</p>
    </section>

    <section id="materials" class="teacher-section">
      <p class="eyebrow">PREP ONCE</p><h2>Master materials & printing plan</h2>
      <div class="materials-grid">
        <article><strong>Op02</strong><p>Thermometers, 1 m² markers/string, clipboards, pencils; optional field sensors. Print Field Sheet × teams.</p></article>
        <article><strong>Op03</strong><p>Spoon, tweezers, clothespin/tongs, chopsticks, timers, 3 resource trays, safe craft objects, cups. Print 2-page packet × teams.</p></article>
        <article><strong>Op04</strong><p>Laminated ecosystem cards, short yarn, arrow markers. Print Food Web V1 × teams. Day 8 uses blank/back paper.</p></article>
        <article><strong>Op05</strong><p>5×5 habitat grids, cups with ~30–50 counters. Print 2-page population/CER packet × teams.</p></article>
        <article><strong>Op06</strong><p>2 trays/team, soil, cover material, cups, measured water, slope blocks/books, towels. Print 2-page packet × teams.</p></article>
        <article><strong>Op07</strong><p>Spread: 6 zones, neutral + stowaway counters, scoop. Contaminant: 16 producers/tokens, 4 consumers, 1 predator. Print 2-page packet × teams.</p></article>
        <article><strong>Op08</strong><p>Entire Continental Archive. Print final packet × teams unless using a fully digital report.</p></article>
      </div>
    </section>

    <section id="assessment" class="teacher-section">
      <p class="eyebrow">MARK LESS, LEARN MORE</p><h2>Recommended assessment load</h2>
      <div class="assessment-grid"><article><span>FORMATIVE</span><strong>Operations 02–04</strong><p>Field skills, structure/function, Food Web V1, carbon/water cycles. Use quick checks and archive continuity rather than large marks.</p></article><article><span>STRONGER MARK</span><strong>Operation 05</strong><p>Data Reasoning CER: exact values, multiple datasets, mechanism, alternative explanation, uncertainty.</p></article><article><span>LIGHT / FORMATIVE</span><strong>Operation 06</strong><p>Succession/recovery decision. Grade lightly unless you need another individual evidence point.</p></article><article><span>STRONGER MARK</span><strong>Operation 07</strong><p>Environmental Decision-Making: spread + harm, biomagnification, trade-offs, monitoring, conservation risk.</p></article><article><span>MAJOR SUMMATIVE</span><strong>Operation 08</strong><p>Science Understanding · Evidence · Reasoning · Communication/Decision-Making.</p></article></div>
    </section>

    <section id="local-link" class="teacher-section local-case">
      <p class="eyebrow">DAY 13 // RECOMMENDED CALGARY DEFAULT</p><h2>Elbow River riparian health & source-water protection</h2>
      <p>This case keeps Day 13 genuinely local while connecting succession, restoration, monitoring, water, land use, and environmental decision-making. Use source excerpts rather than sending Grade 7 students into a broad web search.</p>
      <div class="source-grid">
        <a href="https://www.calgary.ca/water/stormwater/source-water-protection.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary — Source Water Protection</strong><span>Why source watersheds matter and why protection requires cooperation across jurisdictions.</span></a>
        <a href="https://www.calgary.ca/water/stormwater/riparian-areas.html" target="_blank" rel="noopener noreferrer"><strong>City of Calgary — Riparian Areas</strong><span>Riparian monitoring, health indicators, restoration and management approaches.</span></a>
        <a href="https://tsuutina.com/wp-content/uploads/2025/06/Niska.Newsletter.June10.2025.final_.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut’ina Nation — Wolf Creek / Elbow watershed source</strong><span>Authentic Nation source describing restoration, water monitoring and watershed partnership work.</span></a>
        <a href="https://tsuutina.com/wp-content/uploads/2023/10/Lands.Newsletter.FinalEditition.August2022.pdf" target="_blank" rel="noopener noreferrer"><strong>Tsuut’ina Lands — Land & Environment source</strong><span>Optional deeper source on land/environment planning and sustainability.</span></a>
      </div>
      <div class="source-rule"><strong>Source rule:</strong> do not ask students to invent a generic Indigenous perspective. Use the specific Tsuut’ina source and have students state what that source actually contributes to understanding the issue.</div>
      <div class="local-question"><strong>Possible management question</strong><p>How should Calgary protect and restore riparian areas while people continue to use the river corridor?</p></div>
    </section>

    <section id="contingency" class="teacher-section">
      <p class="eyebrow">WHEN SCHOOL HAPPENS</p><h2>Contingency playbook</h2>
      <div class="contingency-grid"><article><strong>30-minute class</strong><p>Do the concept launch + core evidence task. Move archive wording/reflection to the next entry routine. Do not rush lab safety/cleanup.</p></article><article><strong>1–2 lost days</strong><p>Consume Day 20, then Day 21. Keep the core Day 1–19 order intact.</p></article><article><strong>3+ lost days</strong><p>Cut presentations → gallery walks → peer critique → repeated samples/datasets → artistic polish → extension vocabulary.</p></article><article><strong>Outdoor Op02 unavailable</strong><p>Use three contrasting indoor microhabitats and explicitly discuss the limitations.</p></article><article><strong>Day13 field access unavailable</strong><p>Use maps, before/after images, monitoring data and supplied sources. The outcome is evidence-based local analysis, not a field trip.</p></article><article><strong>Lost archive artifact</strong><p>Reconstruct the essential finding from the JCEC submission + website evidence; do not redo the whole investigation.</p></article></div>
    </section>

    <section id="verification" class="teacher-section verification">
      <p class="eyebrow">FINAL RESOURCE CHECK</p><h2>Phase 1 route & resource verification</h2>
      <div class="verify-grid"><article><strong>✓ Student route structure</strong><p>Phase 1 hub and Operations 02–08 all exist as dedicated source routes.</p></article><article><strong>✓ Continent data</strong><p>Operation data files 02–08 are present and imported by their operation pages.</p></article><article><strong>✓ Printable core packets</strong><p>Op02 Field Sheet, Op03 packet, Op04 Food Web packet, Op05 population/CER packet, Op06 recovery packet, Op07 incident packet and Op08 final packet are embedded in the operation pages.</p></article><article><strong>✓ Navigation chain</strong><p>The shared mission integration connects Op02→03→04→05→06→07→08 and exposes the final operations on the Phase 1 hub.</p></article><article><strong>✓ Pacing inserts</strong><p>Day 8 carbon/water cycles, Day 13 Earth Field Link and Op07 conservation-risk checkpoint are loaded through the shared Phase 1 pacing component.</p></article><article><strong>✓ External Day13 sources</strong><p>The recommended City of Calgary and Tsuut’ina source pages were rechecked while preparing this guide.</p></article></div>
      <p class="verify-note">The deployment build remains the final automated check that all Astro source imports and routes compile together. Use the site links above as the classroom launch points; keep this page open as your teacher command board.</p>
    </section>

    <section class="final-check"><p class="eyebrow">BEFORE YOU TEACH DAY 1</p><h2>Final seven checks</h2><ol><li>Continent assignments + Team IDs ready.</li><li>Pathfinder Log format chosen.</li><li>JCEC Portal tested on a school device.</li><li>Day 2 outdoor locations or indoor fallback chosen.</li><li>Reusable Op03–07 lab kits planned.</li><li>Day 13 local source pack prepared.</li><li>Op05, Op07 and Op08 grading decisions made.</li></ol><p><strong>The goal is not to complete every feature on every page.</strong> Protect the core scientific journey and finish with a coherent Continental Archive that Phase 2 can inherit.</p></section>
  </div>

  <script is:inline>
    document.getElementById('print-guide')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>

<style>
:global(body){background:#06111f}.teacher-shell{max-width:1160px;margin:0 auto;padding:0 1rem 5rem;color:#eaf5ff}.teacher-shell :global(.breadcrumbs){color:#9fb8c8}.teacher-shell :global(.breadcrumbs a){color:#d3eafa}.teacher-nav{position:sticky;top:.5rem;z-index:20;display:flex;gap:.35rem;overflow:auto;margin:1rem 0;padding:.45rem;border:1px solid #284c5e;border-radius:14px;background:rgba(5,20,33,.95)}.teacher-nav a{flex:0 0 auto;padding:.55rem .7rem;border-radius:8px;color:#bad0dc;text-decoration:none;font-size:.8rem;font-weight:850}.teacher-nav a:hover{background:#123348;color:#fff}.teacher-hero{display:grid;grid-template-columns:1fr 260px;gap:1.5rem;margin:1rem 0;padding:clamp(1.4rem,4vw,2.7rem);border:1px solid #2d6270;border-radius:24px;background:radial-gradient(circle at 80% 18%,rgba(110,242,207,.16),transparent 25%),linear-gradient(145deg,#071727,#0b2b3d)}.teacher-hero p:first-child,.eyebrow{margin:0;color:#74e9cb;font:850 .76rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.teacher-hero h1{margin:.5rem 0;color:#fff;font-size:clamp(3rem,7vw,5.6rem);line-height:.88;letter-spacing:-.05em}.teacher-hero h1 span{color:#6ef2cf}.lead{max-width:760px;color:#bed4df;line-height:1.6}.teacher-hero aside{align-self:end;padding:1rem;border:1px solid #315d73;border-radius:14px;background:#071923}.teacher-hero aside>strong{display:block;color:#6ef2cf;font-size:1.5rem}.teacher-hero aside>span{color:#9eb9c7}.teacher-hero dl{margin:.8rem 0 0}.teacher-hero dl div{display:flex;justify-content:space-between;padding:.45rem 0;border-top:1px solid #244352}.teacher-hero dt{color:#90a8b6}.teacher-hero dd{margin:0;color:#fff;font-weight:800}.command-panel,.teacher-section,.final-check{margin:1rem 0;padding:clamp(1.1rem,3vw,1.6rem);border:1px solid #23485a;border-radius:18px;background:#091c2a}.command-panel h2,.teacher-section h2,.final-check h2,.section-heading h2{margin:.35rem 0 .8rem;color:#fff;font-size:clamp(1.5rem,3vw,2rem)}.setup-grid,.materials-grid,.co