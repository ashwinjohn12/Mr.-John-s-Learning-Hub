---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecWorkMode from '../../../../../../components/JcecWorkMode.astro';
import { operation07Incidents } from '../../../../../../data/jabberwockyOperation07';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';
---

<BaseLayout title="Operation 07: Classified Incident | Jabberwocky 2190" description="A Grade 7 Science biosecurity and contamination investigation using introduced species, human impacts, biomagnification, evidence, and management decisions." themeColor="#120b19">
  <div class="operation-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Operation 07' }
    ]} />

    <nav class="mission-nav" aria-label="Operation navigation">
      <a href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1</a>
      <a class="active" href="#briefing">Operation 07</a>
      <a href="#biosecurity-lab">Biosecurity</a>
      <a href="#incident-file">Incident File</a>
      <a href="#contamination">Contamination</a>
      <a href="#archive">Archive</a>
    </nav>

    <header class="operation-hero" id="briefing">
      <p class="system-label alert">CLASSIFIED // CLEARANCE GRANTED // OPERATION 07</p>
      <div class="hero-grid">
        <div>
          <p class="division">JCEC PLANETARY PROTECTION ALERT</p>
          <h1>THE<br /><span>STOWAWAY</span></h1>
          <p class="lead">The recovery pattern has changed. JCEC has confirmed that Earth material escaped containment—and a second signal suggests a human-made contaminant is moving through the food web. Your team must determine what the evidence supports and how JCEC should respond.</p>
        </div>
        <aside>
          <span>INCIDENT STATUS</span>
          <strong>BIOSECURITY BREACH</strong>
          <dl>
            <div><dt>Threat 1</dt><dd>Introduced organism</dd></div>
            <div><dt>Threat 2</dt><dd>Persistent contaminant</dd></div>
            <div><dt>Decision</dt><dd>Contain / monitor / restore</dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <section class="mission-question">
      <p>OPERATION QUESTION</p>
      <h2>How can human activity change an ecosystem in ways we did not intend—and what evidence should guide our response?</h2>
    </section>

    <section class="panel route-panel">
      <p class="system-label">MISSION ROUTE</p>
      <h2>Contain the incident scientifically.</h2>
      <div class="route-grid"><span><b>1</b> Model Stowaway Spread</span><i>→</i><span><b>2</b> Analyze Your Incident</span><i>→</i><span><b>3</b> Decide: Introduced or Invasive?</span><i>→</i><span><b>4</b> Trace X-17</span><i>→</i><span><b>5</b> Choose a Response</span><i>→</i><span><b>6</b> Archive</span></div>
    </section>

    <section class="panel operation-checklist">
      <p class="system-label">YOUR OPERATION 07 CHECKLIST</p>
      <h2>What do I have to complete?</h2>
      <div class="completion-grid">
        <article><span>👥</span><div><strong>As a team</strong><ul><li>Complete the Stowaway Spread Simulation.</li><li>Analyze your continent’s introduced-species evidence.</li><li>Complete the Contaminant Transfer Model.</li><li>Trace X-17 through your actual food-web samples.</li><li>Choose and defend one incident response.</li></ul></div></article>
        <article><span>🗂️</span><div><strong>One team member</strong><ul><li>Submit the official Biosecurity & Contamination Finding.</li><li>Keep the Incident Record in the Continental Archive.</li></ul></div></article>
        <article><span>👤</span><div><strong>Each Pathfinder</strong><ul><li>Complete the individual reflection.</li><li>Identify one human action that could prevent a repeat incident.</li></ul></div></article>
      </div>
      <p class="completion-rule"><strong>Operation 07 is complete when</strong> your team has explained the introduced-species risk, interpreted the contaminant pathway, defended a response, and left an official archive record.</p>
    </section>

    <section class="panel science-focus">
      <p class="system-label">SCIENCE YOU WILL USE</p>
      <h2>Introduced does not automatically mean invasive.</h2>
      <div class="science-grid">
        <article><strong>Introduced species</strong><p>An organism moved by humans to a place where it did not previously live.</p></article>
        <article><strong>Invasive species</strong><p>An introduced species that spreads and causes ecological, economic, or other significant harm. Evidence of both spread and impact matters.</p></article>
        <article><strong>Biosecurity</strong><p>Actions that prevent organisms, seeds, microbes, or other biological material from being moved where they could cause harm.</p></article>
        <article><strong>Pollutant</strong><p>A substance released into the environment that can harm organisms or change ecological conditions.</p></article>
        <article><strong>Bioaccumulation</strong><p>When a persistent substance builds up inside an organism over time because it enters faster than it leaves.</p></article>
        <article><strong>Biomagnification</strong><p>When the concentration of a persistent substance becomes greater at higher feeding levels in a food chain or web.</p></article>
      </div>
      <div class="science-warning"><strong>JCEC evidence rule:</strong> do not call an introduced organism invasive just because it came from Earth. Look for evidence that it is <strong>spreading</strong> and that it is <strong>changing native organisms, habitat, or ecosystem processes</strong>.</div>
      <div class="x17-note"><strong>About X-17:</strong> X-17 is a fictional JCEC maintenance tracer used in this mission. The numbers model how a <em>persistent pollutant</em> can move through a real food web; they are not measurements of a real chemical.</div>
    </section>

    <section class="panel lab-panel" id="biosecurity-lab">
      <JcecWorkMode mode="team" title="Model how a hidden stowaway can spread through human movement" />
      <div class="section-heading"><div><p class="system-label">HANDS-ON INVESTIGATION A // BIOSECURITY</p><h2>Stowaway Spread Simulation</h2></div><span class="duration">25–35 min</span></div>
      <p class="intro">A seed, egg, spore, or tiny organism does not need to move on purpose. Cargo, soil, boots, wheels, tools, and water can move it. Your team will compare spread <strong>without inspection</strong> and spread <strong>with a biosecurity checkpoint</strong>.</p>

      <div class="lab-grid">
        <article><h3>Equipment per team</h3><ul><li>6 cups or paper habitat zones labelled Cargo, A, B, C, D, E</li><li>about 30 neutral counters</li><li>4 clearly different “stowaway” counters</li><li>1 spoon or small scoop</li><li>Incident Record</li></ul></article>
        <article><h3>Model rule</h3><p>Neutral counters represent ordinary cargo/material. Different-coloured counters represent hidden biological stowaways. <strong>No counter represents a real organism in the classroom.</strong></p><p class="equipment-note">Random transfer matters: do not deliberately choose or avoid stowaway counters unless the procedure says to inspect them.</p></article>
      </div>

      <div class="procedure">
        <h3>Round A — No biosecurity checkpoint</h3>
        <ol>
          <li>Place all 30 neutral counters and 4 stowaway counters in <strong>Cargo</strong>. Mix without looking.</li>
          <li>Move exactly <strong>5 random counters</strong> from Cargo → A. Record whether A now contains a stowaway.</li>
          <li>Mix A and move 3 random counters A → B. Then B → C, C → D, and D → E using the same rule.</li>
          <li>Count how many habitat zones contain at least one stowaway.</li>
        </ol>
        <h3>Round B — Add a biosecurity checkpoint</h3>
        <ol>
          <li>Reset the counters exactly as they began.</li>
          <li>Repeat the same transfers, but <strong>inspect each transfer before it enters the next zone</strong>. Remove any visible stowaway counter to a quarantine cup.</li>
          <li>Count how many zones contain a stowaway now.</li>
          <li>Compare the two rounds. Which strategy prevented spread earlier?</li>
        </ol>
      </div>

      <div class="lab-record-grid">
        <article><strong>Round A</strong><p>Zones occupied: ______ / 5</p><p>Where did spread first occur? ____________________</p></article>
        <article><strong>Round B</strong><p>Zones occupied: ______ / 5</p><p>Stowaways intercepted: ______</p></article>
        <article><strong>Team conclusion</strong><p>Why can prevention be easier than removing an organism after it spreads?</p></article>
      </div>
      <p class="lab-connection"><strong>Model limitation:</strong> real organisms reproduce, die, disperse in different ways, and interact with habitat. This simulation isolates one idea: <strong>human movement can create pathways for spread, and checkpoints can interrupt those pathways.</strong></p>
    </section>

    <section class="panel incident-panel" id="incident-file">
      <JcecWorkMode mode="team" title="Open the classified incident for your assigned continent" />
      <p class="system-label alert">CLASSIFIED INCIDENT FILE // CONTINENT-SPECIFIC</p>
      <h2>Was the stowaway merely introduced—or is it becoming invasive?</h2>
      <p class="intro">Read the timeline and all supporting evidence before choosing a label. Your team must be able to point to <strong>spread evidence</strong> and <strong>impact evidence</strong>.</p>

      <div class="no-posting" id="no-posting" hidden><strong>No continental posting detected on this device.</strong><p>Return to Operation 01, select the continent your teacher assigned, then come back here.</p><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Return to Mission Assignment</a></div>

      <div id="incident-files" hidden>
        {operation07Incidents.map((item) => (
          <article class="incident-file" data-incident={item.id} hidden>
            <div class="case-heading"><div><p class="system-label alert">FILE 07-{item.code} // {item.baseCamp}</p><h3>{item.name}: {item.stowaway}</h3><small>{item.environment}</small></div><span class="case-status">BIOSECURITY ALERT</span></div>
            <div class="incident-grid">
              <article><span>SUSPECTED ENTRY</span><p>{item.suspectedEntry}</p></article>
              <article><span>FIRST DETECTION</span><p>{item.firstDetection}</p></article>
            </div>

            <section class="spread-section">
              <p class="system-label">STEP 1 // TRACE THE SPREAD</p>
              <h4>{item.nativeIndicatorLabel}</h4>
              <div class="spread-grid">
                {item.spread.map((stage) => <article><strong>{stage.label}</strong><dl><div><dt>Occupied zones</dt><dd>{stage.occupiedZones}</dd></div><div><dt>Native indicator</dt><dd>{stage.nativeIndicator}</dd></div></dl><p>{stage.note}</p></article>)}
              </div>
            </section>

            <section class="evidence-section">
              <p class="system-label">STEP 2 // CHECK IMPACT EVIDENCE</p>
              <div class="evidence-grid">{item.evidence.map((evidence,index)=><article><span>{String(index+1).padStart(2,'0')}</span><p>{evidence}</p></article>)}</div>
              <div class="classification-check"><strong>Team classification</strong><p>Choose one on your Incident Record and defend it:</p><span>INTRODUCED — spread/impact evidence is not yet enough</span><span>INVASIVE THREAT — evidence shows spread + ecological harm</span><span>UNCERTAIN — some evidence supports concern, but another explanation still needs testing</span></div>
            </section>
          </article>
        ))}
      </div>
    </section>

    <section class="panel contaminant-model" id="contamination">
      <JcecWorkMode mode="team" title="Model why a persistent contaminant can become more concentrated higher in a food chain" />
      <div class="section-heading"><div><p class="system-label">HANDS-ON INVESTIGATION B // CONTAMINANT TRANSFER</p><h2>Biomagnification Token Model</h2></div><span class="duration">20–30 min</span></div>
      <p class="intro">This model assumes the contaminant is persistent: organisms take it in and do not quickly remove it. The tokens show contaminant amount moving with food.</p>
      <div class="model-grid">
        <article><strong>1. Producers</strong><p>Create 16 producer cards. Give each producer <strong>1 contaminant token</strong>.</p></article>
        <article><strong>2. Primary consumers</strong><p>Create 4 consumer cards. Each consumer “eats” 4 producers and collects all 4 contaminant tokens.</p></article>
        <article><strong>3. Predator</strong><p>One predator “eats” all 4 consumers and collects all 16 contaminant tokens.</p></article>
        <article><strong>4. Compare</strong><p>Producer: 1 token each → Consumer: 4 each → Predator: 16. Explain why the concentration per organism increased.</p></article>
      </div>
      <p class="lab-connection"><strong>Important:</strong> biomagnification does not happen for every substance. It is most relevant when a contaminant persists in organisms and is transferred through feeding.</p>

      <div id="contaminant-files" hidden>
        {operation07Incidents.map((item) => (
          <article class="contaminant-file" data-contaminant={item.id} hidden>
            <p class="system-label">STEP 3 // YOUR CONTINENT’S X-17 SAMPLES</p>
            <h3>{item.name}: trace the actual pathway</h3>
            <p>{item.contaminantNote}</p>
            <div class="concentration-chain">
              {item.contaminantPath.map((level,index) => <><article><span>{level.trophicRole}</span><strong>{level.sample}</strong><b>{level.concentration} ppb</b></article>{index < item.contaminantPath.length-1 && <i>→</i>}</>)}
            </div>
            <div class="analysis-box"><strong>What pattern do you see?</strong><ol><li>Where is X-17 least concentrated?</li><li>Which organism has the highest measured concentration?</li><li>How does the food-web pathway help explain the pattern?</li><li>Why might a top consumer be at risk even when environmental concentration is low?</li></ol></div>
          </article>
        ))}
      </div>
    </section>

    <section class="panel response-panel">
      <JcecWorkMode mode="team" title="Choose the response that best balances protection, evidence, and unintended consequences" />
      <p class="system-label">STEP 4 // INCIDENT RESPONSE BOARD</p>
      <h2>What should JCEC do now?</h2>
      <div id="response-files" hidden>
        {operation07Incidents.map((item) => (
          <article class="response-file" data-response={item.id} hidden>
            <h3>{item.investigationQuestion}</h3>
            <p>All three responses have trade-offs. Your team must choose one, explain what evidence supports it, and identify one possible unintended consequence.</p>
            <div class="decision-grid">{item.responseChoices.map((choice,index)=><button type="button" class="decision-card" data-choice={choice}><span>RESPONSE {String.fromCharCode(65+index)}</span><strong>{choice}</strong><small>Select as working response</small></button>)}</div>
            <p class="working-decision" data-working-decision>No response selected yet.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="panel print-section">
      <div class="print-actions"><button class="button secondary" type="button" id="print-op7-packet">Print Operation 07 Incident Packet (if needed)</button><span><strong>Your teacher may already provide it.</strong> One packet per team is enough.</span></div>
      <section class="print-packet" aria-label="Operation 07 printable packet">
        <section class="print-page"><h2>JCEC OPERATION 07 — INCIDENT RECORD</h2><p>Continent: __________________ Team ID: __________</p><h3>Biosecurity</h3><p>Round A occupied zones: ____ / 5 &nbsp;&nbsp; Round B: ____ / 5</p><p>What did the checkpoint change? ____________________________________________________________</p><h3>Stowaway classification</h3><p>Introduced / Invasive Threat / Uncertain</p><p>Spread evidence: _________________________________________________________________________</p><p>Impact evidence: _________________________________________________________________________</p><p>Alternative explanation / uncertainty: ______________________________________________________</p><h3>Recommended response</h3><div class="writing-box"></div></section>
        <section class="print-page"><h2>JCEC CONTAMINATION RECORD</h2><p>Continent: __________________</p><h3>X-17 pathway</h3><p>Environment sample: __________________ concentration: ______ ppb</p><p>Producer: __________________ concentration: ______ ppb</p><p>Consumer: __________________ concentration: ______ ppb</p><p>Top consumer/predator: __________________ concentration: ______ ppb</p><p><strong>Explain the pattern:</strong></p><div class="writing-box"></div><p><strong>One action that could reduce future contamination:</strong> _____________________________________________</p><p><strong>One possible unintended consequence of your response:</strong> ________________________________________</p></section>
      </section>
    </section>

    <section class="panel archive-panel" id="archive">
      <JcecWorkMode mode="archive" title="Add the Biosecurity & Contamination Finding to the Continental Archive" />
      <p class="system-label">JCEC ARCHIVE TRANSMISSION</p>
      <h2>Record what humans changed—and how future teams must respond.</h2>
      <div class="archive-grid">
        <article><strong>Claim / Decision</strong><p>Classify the stowaway risk and state your chosen JCEC response.</p></article>
        <article><strong>Evidence</strong><p>Use at least one spread trend, one ecological-impact observation, and one X-17 concentration pattern.</p></article>
        <article><strong>Reasoning</strong><p>Explain why the evidence supports your classification and response, including the biomagnification pattern.</p></article>
        <article><strong>Uncertainty</strong><p>State one thing JCEC still needs to monitor and one possible unintended consequence.</p></article>
      </div>
      <div class="submission-guide">
        <div class="guide-heading"><span>📡</span><div><strong>Submit to the JCEC Portal</strong><small>One designated team member submits.</small></div></div>
        <dl><div><dt>Submission Type</dt><dd>Continental Archive</dd></div><div><dt>Mission Phase</dt><dd>01 First Contact</dd></div><div><dt>Operation / Task</dt><dd>Classified Incident — Biosecurity & Contamination Finding</dd></div><div><dt>Continent</dt><dd id="archive-continent">Your assigned continent</dd></div><div><dt>Team ID</dt><dd id="archive-team-id">Use the ID your teacher gives you</dd></div><div><dt>Team Members</dt><dd>List everyone represented</dd></div></dl>
        <p><strong>Form mapping:</strong> classification + response in <em>Claim / Decision</em>; spread/impact/X-17 values in <em>Evidence</em>; mechanism + biomagnification + trade-off in <em>Reasoning</em>; leave Pathfinder Reflection blank unless directed.</p>
        <a class="button primary" href={portalUrl} target="_blank" rel="noopener noreferrer">Submit Incident Finding ↗</a>
      </div>
    </section>

    <section class="panel reflection">
      <JcecWorkMode mode="individual" title="Update your Pathfinder Log" />
      <h2>Humans did not intend either incident. Does intention change ecological responsibility?</h2>
      <ol><li>Which piece of evidence most strongly affected your team’s decision?</li><li>Why is “introduced” different from “invasive”?</li><li>Explain biomagnification in your own words using your continent’s X-17 pathway.</li><li>Identify one concrete biosecurity or pollution-prevention rule humans should follow from now on.</li></ol>
    </section>

    <section class="next-operation">
      <div><span>08</span><strong>FINAL OPERATION</strong></div>
      <section><p class="system-label">PHASE 1 // FINAL REPORT</p><h2>JCEC Ecological Report</h2><p>Your team now has enough ecological evidence to make a Phase 1 recommendation and prepare the continent archive for the next scientific division.</p><div class="locked"><span>🔒</span><strong>Await final-report activation.</strong></div></section>
    </section>

    <div class="bottom-actions"><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/operation-06/`}>← Operation 06</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1 Operations</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a></div>
  </div>

  <script is:inline>
    (() => {
      const posting = localStorage.getItem('jabberwocky-phase1-posting');
      const noPosting = document.getElementById('no-posting');
      const incidentFiles = document.getElementById('incident-files');
      const contaminantFiles = document.getElementById('contaminant-files');
      const responseFiles = document.getElementById('response-files');
      const incident = posting ? document.querySelector(`[data-incident="${posting}"]`) : null;
      const contaminant = posting ? document.querySelector(`[data-contaminant="${posting}"]`) : null;
      const response = posting ? document.querySelector(`[data-response="${posting}"]`) : null;
      if (!posting || !incident || !contaminant || !response) {
        if (noPosting) noPosting.hidden = false;
      } else {
        if (incidentFiles) incidentFiles.hidden = false;
        if (contaminantFiles) contaminantFiles.hidden = false;
        if (responseFiles) responseFiles.hidden = false;
        incident.hidden = false; contaminant.hidden = false; response.hidden = false;
        const continentName = incident.querySelector('.case-heading h3')?.textContent?.split(':')[0]?.trim() || posting;
        const archiveContinent = document.getElementById('archive-continent');
        if (archiveContinent) archiveContinent.textContent = continentName;
        const signal = incident.querySelector('.system-label')?.textContent || '';
        const codeMatch = signal.match(/07-([A-Z]{2})/);
        const teamId = document.getElementById('archive-team-id');
        if (teamId) teamId.textContent = `P1-${codeMatch?.[1] || 'XX'}-__ (use the number your teacher assigns)`;
      }

      document.querySelectorAll('.response-file').forEach((file) => {
        const buttons = [...file.querySelectorAll('.decision-card')];
        const status = file.querySelector('[data-working-decision]');
        const key = `jabberwocky-op7-response-${file.dataset.response}`;
        const select = (button) => {
          buttons.forEach((other) => other.classList.remove('selected'));
          button.classList.add('selected');
          const choice = button.dataset.choice || '';
          localStorage.setItem(key, choice);
          if (status) status.textContent = `Working response saved on this device: ${choice}`;
        };
        buttons.forEach((button) => button.addEventListener('click', () => select(button)));
        const saved = localStorage.getItem(key);
        if (saved) {
          const match = buttons.find((button) => button.dataset.choice === saved);
          if (match) select(match);
        }
      });

      document.getElementById('print-op7-packet')?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

<style>
  :global(body){background:#080d18}.operation-shell{max-width:1120px;margin:0 auto;padding:0 1.1rem 5rem;color:#eaf5ff}.system-label{margin:0;color:#74e9cb;font:800 .79rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;text-transform:uppercase}.system-label.alert{color:#ff9fb4}.mission-nav{position:sticky;top:.6rem;z-index:20;display:flex;gap:.35rem;overflow:auto;margin:1rem 0;padding:.45rem;border:1px solid #55344d;border-radius:14px;background:rgba(12,13,24,.95);backdrop-filter:blur(12px)}.mission-nav a{flex:0 0 auto;padding:.65rem .78rem;border-radius:9px;color:#c8b8c8;text-decoration:none;font-size:.87rem;font-weight:800}.mission-nav a:hover,.mission-nav a.active{background:#332033;color:#fff}.mission-nav a.active{box-shadow:inset 0 -2px #ff8daf}.operation-hero{margin:1.2rem 0;padding:clamp(1.5rem,5vw,3rem);border:1px solid #713e61;border-radius:26px;background:radial-gradient(circle at 82% 20%,rgba(255,77,120,.18),transparent 25%),linear-gradient(145deg,#150c1b,#23132b 58%,#071522)}.hero-grid{display:grid;grid-template-columns:1fr 300px;gap:1.5rem;align-items:end}.division{margin:1.3rem 0 .35rem;color:#d0b8cb;font-weight:850;letter-spacing:.1em}.operation-hero h1{margin:0;color:#fff;font-size:clamp(3rem,8vw,6rem);line-height:.85;letter-spacing:-.06em}.operation-hero h1 span{color:#ff8daf}.lead{max-width:720px;margin:1.3rem 0 0;color:#d6c8d7;font-size:1.08rem;line-height:1.65}.operation-hero aside{padding:1rem;border:1px solid #68465f;border-radius:16px;background:#110b17}.operation-hero aside>span{color:#a7899f;font:800 .72rem ui-monospace,monospace}.operation-hero aside>strong{display:block;margin:.25rem 0 .9rem;color:#ff9fb4}.operation-hero dl{margin:0}.operation-hero dl div{display:flex;justify-content:space-between;gap:.7rem;padding:.5rem 0;border-top:1px solid #3d2938}.operation-hero dt{color:#a991a4}.operation-hero dd{margin:0;color:#fff;text-align:right}.mission-question,.panel,.next-operation{margin:1.2rem 0;padding:clamp(1.2rem,4v