---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import JcecWorkMode from '../../../../../../components/JcecWorkMode.astro';
import { operation04Networks } from '../../../../../../data/jabberwockyOperation04';

const base = import.meta.env.BASE_URL;
const portalUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdziTI_SBqRzQbIWU3ZDtZrNtCG3WB78ttvZdtEmq29kapujg/viewform';
---

<BaseLayout title="Operation 04: Ecosystem Network | Jabberwocky 2190" description="A hands-on Grade 7 Science mission using physical and digital food-web models to investigate energy flow, interdependence, competition, symbiosis, and decomposers." themeColor="#071b2e">
  <div class="operation-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: base },
      { label: 'Grade 7 Science', href: `${base}courses/grade-7-science/` },
      { label: 'Jabberwocky', href: `${base}courses/grade-7-science/jabberwocky/` },
      { label: 'Phase 1', href: `${base}courses/grade-7-science/jabberwocky/phase-1/` },
      { label: 'Operation 04' }
    ]} />

    <nav class="mission-nav" aria-label="Operation navigation">
      <a href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a>
      <a href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1</a>
      <a class="active" href="#briefing">Operation 04</a>
      <a href="#web-lab">String Web Lab</a>
      <a href="#planetary-network">Planetary Network</a>
      <a href="#archive">Archive</a>
    </nav>

    <header class="operation-hero" id="briefing">
      <p class="system-label">MISSION PHASE 01 // OPERATION 04</p>
      <div class="hero-grid">
        <div>
          <p class="division">JCEC ECOLOGICAL SURVEY DIVISION</p>
          <h1>ECOSYSTEM<br /><span>NETWORK</span></h1>
          <p class="lead">One organism is never the whole story. JCEC now needs your team to map the feeding relationships, competition, symbiosis, and decomposition that connect life across your continent.</p>
        </div>
        <aside>
          <span>MISSION PURPOSE</span>
          <strong>Build Food Web V1</strong>
          <dl>
            <div><dt>Science focus</dt><dd>Interdependence + energy</dd></div>
            <div><dt>Hands-on work</dt><dd>String food web</dd></div>
            <div><dt>Official record</dt><dd>Team archive</dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <section class="mission-question">
      <p>OPERATION QUESTION</p>
      <h2>How can one change in an ecosystem affect organisms that are connected in different ways?</h2>
    </section>

    <section class="panel operation-checklist" aria-labelledby="operation-checklist-heading">
      <p class="system-label">YOUR OPERATION 04 CHECKLIST</p>
      <h2 id="operation-checklist-heading">What do I have to complete?</h2>
      <div class="completion-grid">
        <article class="team-completion"><span aria-hidden="true">👥</span><div><strong>As a team</strong><ul><li>Complete the String Web Investigation.</li><li>Analyze your continent’s organism and relationship evidence.</li><li>Build one evidence-based Food Web V1.</li><li>Predict what happens when one part of the web changes.</li></ul></div></article>
        <article class="archive-completion"><span aria-hidden="true">🗂️</span><div><strong>One team member</strong><ul><li>Submit the official Ecosystem Network Summary to JCEC.</li><li>Keep your team’s Food Web V1 with the Continental Archive.</li></ul></div></article>
        <article class="individual-completion"><span aria-hidden="true">👤</span><div><strong>Each Pathfinder</strong><ul><li>Complete the individual reflection when directed.</li></ul></div></article>
      </div>
      <p class="completion-rule"><strong>Operation 04 is complete when</strong> your team has a finished Food Web V1, the written archive summary is submitted, and you have completed your Pathfinder reflection.</p>
    </section>

    <section class="mission-route" aria-labelledby="route-heading">
      <div><p class="system-label">MISSION ROUTE</p><h2 id="route-heading">Where are we going?</h2></div>
      <ol>
        <li><span>1</span><strong>Build Earth Web</strong></li>
        <li><span>2</span><strong>Classify Organisms</strong></li>
        <li><span>3</span><strong>Infer Feeding Arrows</strong></li>
        <li><span>4</span><strong>Analyze Interactions</strong></li>
        <li><span>5</span><strong>Stress the Network</strong></li>
        <li><span>6</span><strong>Archive</strong></li>
      </ol>
    </section>

    <section class="panel science-focus" aria-labelledby="science-focus-heading">
      <p class="system-label">SCIENCE YOU WILL USE</p>
      <h2 id="science-focus-heading">A food web is a network, not a list.</h2>
      <div class="science-grid">
        <article><strong>Producer</strong><p>An organism that captures energy—usually sunlight—to make its own food. Producers begin most feeding pathways.</p></article>
        <article><strong>Consumer</strong><p>An organism that gets energy by eating producers or other consumers.</p></article>
        <article><strong>Decomposer</strong><p>An organism such as a fungus or bacterium that obtains energy by breaking down dead material and wastes.</p></article>
        <article><strong>Food web</strong><p>A model showing many connected feeding relationships. The arrow points from the food or energy source <strong>toward the organism receiving the energy</strong>.</p></article>
        <article><strong>Competition</strong><p>Two organisms use the same limited resource, such as food, water, shelter, space, or light.</p></article>
        <article><strong>Symbiosis</strong><p>A close relationship between species. It can include mutualism, commensalism, or parasitism.</p></article>
      </div>
      <div class="flow-rule"><strong>Remember:</strong> energy <em>flows</em> through an ecosystem and is eventually released as heat. Matter such as water and nutrients can be <em>cycled</em> and reused. Do not draw an energy arrow from a decomposer back to a producer.</div>
      <a class="text-link" href={`${base}courses/grade-7-science/interactions-ecosystems/`}>Need a refresher? Open Interactions & Ecosystems resources →</a>
    </section>

    <section class="panel web-lab" id="web-lab" aria-labelledby="web-lab-heading">
      <JcecWorkMode mode="team" title="Build and disturb a physical food web" />
      <div class="section-heading"><div><p class="system-label">HANDS-ON INVESTIGATION // MODEL LAB</p><h2 id="web-lab-heading">String Web Investigation</h2></div><span class="duration">35–45 min</span></div>
      <p class="intro">Before mapping an alien ecosystem, your team will build a physical Earth food web. The goal is to see how quickly one change can spread through a connected system.</p>

      <div class="lab-grid">
        <article>
          <h3>Equipment per team</h3>
          <ul><li>8 printed ecosystem cards</li><li>Several short pieces of yarn or string</li><li>Small paper arrows, sticky-note arrows, or pencil arrows on the table</li><li>Operation 04 field sheet</li></ul>
          <p class="equipment-note"><strong>Reusable setup:</strong> laminate one card set per team and keep short yarn pieces in envelopes for future classes.</p>
        </article>
        <article>
          <h3>Earth model cards</h3>
          <ul><li>Sunlight — energy source</li><li>Prairie Grass — producer</li><li>Wildflower — producer</li><li>Grasshopper — consumer</li><li>Rabbit — consumer</li><li>Mouse — consumer</li><li>Hawk — consumer</li><li>Fungi & Bacteria — decomposers</li></ul>
        </article>
      </div>

      <div class="setup-callout"><strong>How to arrange the model:</strong> lay all cards flat on the table. Use a <em>separate piece of yarn</em> for each connection. Place an arrow marker beside each yarn piece to show energy direction. Do not hold one giant string around the group.</div>

      <div class="procedure">
        <h3>Build the web</h3>
        <ol>
          <li><strong>Place the cards</strong> where everyone can reach them. Keep Sunlight to one side because it is an energy source, not an organism.</li>
          <li><strong>Start with producers.</strong> Connect Sunlight to Prairie Grass and Wildflower.</li>
          <li><strong>Add feeding connections</strong> using separate yarn pieces: Prairie Grass → Grasshopper, Rabbit, and Mouse; Wildflower → Grasshopper and Rabbit; Grasshopper → Mouse; Mouse → Hawk; Rabbit → Hawk.</li>
          <li><strong>Show direction.</strong> Add an arrow marker so every feeding arrow points from the food toward the organism receiving energy.</li>
          <li><strong>Add decomposers.</strong> Use a different placement or label to show that dead material and wastes from every organism can provide resources to Fungi & Bacteria.</li>
          <li><strong>Trace three pathways</strong> from Sunlight to a consumer. Notice that one organism can belong to more than one pathway.</li>
        </ol>
      </div>

      <div class="stress-test">
        <p class="system-label">NETWORK STRESS TEST</p>
        <h3>Temporarily remove Prairie Grass.</h3>
        <p>Remove the Prairie Grass card and the yarn pieces touching it. Leave the rest of the web in place. Follow the remaining strings and predict what may happen.</p>
        <div class="stress-grid">
          <article><strong>Direct effects</strong><p>Which organisms lose a food source immediately?</p></article>
          <article><strong>Indirect effects</strong><p>Which organisms might be affected later even though they do not eat Prairie Grass?</p></article>
          <article><strong>Competition</strong><p>Would any consumers depend more heavily on Wildflower? What could that change?</p></article>
        </div>
        <p class="model-warning"><strong>Model limit:</strong> removing a card does not prove exactly what would happen in a real ecosystem. It helps us make a testable prediction about possible effects.</p>
      </div>

      <div class="print-actions">
        <button class="button secondary" type="button" id="print-op4-packet">Print Operation 04 Field Packet (if needed)</button>
        <span><strong>Your teacher may already provide the packet.</strong> One physical model card set can be reused; one Food Web V1 sheet per team is enough.</span>
      </div>

      <section class="print-packet" aria-label="Operation 04 printable field packet">
        <section class="print-page card-page">
          <div class="print-header"><div><strong>JCEC ECOLOGICAL MODEL KIT</strong><h3>String Web Investigation Cards</h3></div><div>Cut apart or laminate for reuse</div></div>
          <div class="cut-grid">
            <article><strong>☀ SUNLIGHT</strong><span>Energy source — not an organism</span></article><article><strong>PRAIRIE GRASS</strong><span>Producer</span></article><article><strong>WILDFLOWER</strong><span>Producer</span></article><article><strong>GRASSHOPPER</strong><span>Consumer</span></article><article><strong>RABBIT</strong><span>Consumer</span></article><article><strong>MOUSE</strong><span>Consumer</span></article><article><strong>HAWK</strong><span>Consumer</span></article><article><strong>FUNGI & BACTERIA</strong><span>Decomposers</span></article>
          </div>
          <div class="print-prompts"><p><strong>Arrow rule:</strong> food / energy source → organism receiving energy.</p><p><strong>Stress-test notes — direct effects:</strong> ________________________________________________________________</p><p><strong>Possible indirect effects:</strong> ________________________________________________________________________</p></div>
        </section>
        <section class="print-page food-web-sheet">
          <div class="print-header"><div><strong>JCEC CONTINENTAL ARCHIVE</strong><h3>Food Web V1</h3></div><div>Continent: ____________________ &nbsp; Team ID: ____________</div></div>
          <div class="web-canvas"><strong>Build your continent food web here.</strong><span>Write organism names, label P / C / D, and draw arrows from food → eater.</span></div>
          <div class="network-record">
            <p><strong>Focal species:</strong> _________________________ <strong>Its role:</strong> _________________________</p>
            <p><strong>Competition:</strong> __________________________ compete for ______________________________________________</p>
            <p><strong>Symbiosis partners:</strong> __________________________________ <strong>Type:</strong> _____________________________</p>
            <p><strong>One decomposer connection:</strong> ________________________________________________________________________</p>
            <p><strong>Change prediction — direct effect:</strong> _________________________________________________________________</p>
            <p><strong>Possible indirect effect:</strong> __________________________________________________________________________</p>
            <p><strong>One uncertainty:</strong> ____________________________________________________________________________________</p>
          </div>
        </section>
      </section>
    </section>

    <section class="panel checkpoint" aria-labelledby="checkpoint-heading">
      <p class="system-label">MISSION CHECKPOINT // BEFORE PLANETARY ANALYSIS</p>
      <h2 id="checkpoint-heading">Four rules your team must use.</h2>
      <div class="checkpoint-grid">
        <article><span>1</span><p><strong>Arrows show energy transfer:</strong> food → eater.</p></article><article><span>2</span><p><strong>A food web can have many pathways.</strong> Do not force every organism into one straight chain.</p></article><article><span>3</span><p><strong>Decomposers are part of the web.</strong> They obtain energy from dead material and wastes.</p></article><article><span>4</span><p><strong>A prediction is not a certainty.</strong> Use words such as may, could, likely, and because when evidence is incomplete.</p></article>
      </div>
    </section>

    <section class="panel team-launch" aria-labelledby="team-jobs-heading">
      <JcecWorkMode mode="team" title="Everyone helps build the planetary network" />
      <h2 id="team-jobs-heading">Use four jobs so one person does not run the whole investigation.</h2>
      <div class="roles-grid">
        <article><span>📄</span><strong>Evidence Reader</strong><small>Reads each organism and feeding observation aloud before the team decides.</small></article>
        <article><span>✏️</span><strong>Network Mapper</strong><small>Draws the team’s agreed organisms, arrows, and annotations on Food Web V1.</small></article>
        <article><span>💻</span><strong>JCEC Operator</strong><small>Clicks the website choices only after the team has discussed them.</small></article>
        <article><span>🧠</span><strong>Skeptic / Checker</strong><small>Challenges unsupported arrows, checks energy direction, and asks “What evidence supports that?”</small></article>
      </div>
      <p class="role-note">Your teacher may assign these jobs or your team may divide them when instructed. If your team has fewer than four people, combine jobs.</p>
    </section>

    <section class="panel planetary-network" id="planetary-network" aria-labelledby="planetary-network-heading">
      <JcecWorkMode mode="team" title="Build your continent’s Food Web V1" />
      <p class="system-label">JCEC ECOSYSTEM RECORDS // NEW CONNECTIONS DETECTED</p>
      <h2 id="planetary-network-heading">Open your assigned ecosystem network.</h2>
      <p class="intro">Operation 03 identified one focal species. New surveys now show organisms around it. Classify the evidence, infer feeding arrows, identify competition and symbiosis, then test how one change might spread.</p>

      <div class="no-posting" id="no-posting" hidden><strong>No continental posting detected on this device.</strong><p>Return to Operation 01, open the continent your teacher assigned, then come back here.</p><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Return to Mission Assignment</a></div>

      <div id="network-files" hidden>
        {operation04Networks.map((network) => (
          <article class="network-file" data-network={network.id} hidden>
            <div class="network-heading"><div><p class="system-label">NETWORK 04-{network.code} // {network.baseCamp}</p><h3>{network.name}: Ecosystem Network Evidence</h3><small>{network.environment} · Focal species: {network.focalSpecies}</small></div><span class="network-status">FOOD WEB V1</span></div>

            <section class="role-sort" aria-labelledby={`roles-${network.id}`}>
              <h4 id={`roles-${network.id}`}>Step 1 — Classify each organism’s ecological role.</h4>
              <p>Read the evidence before choosing. The JCEC Operator clicks only after the team agrees.</p>
              <div class="organism-grid">
                {network.nodes.map((node) => (
                  <article class="organism-card" data-role={node.role}><strong>{node.name}</strong><p>{node.evidence}</p><div class="role-buttons" role="group" aria-label={`Classify ${node.name}`}><button type="button" data-role-choice="producer">Producer</button><button type="button" data-role-choice="consumer">Consumer</button><button type="button" data-role-choice="decomposer">Decomposer</button></div><small class="role-feedback" role="status"></small></article>
                ))}
              </div>
              <p class="role-counter" data-role-counter>Classify all organism records.</p>
            </section>

            <section class="feeding-evidence">
              <h4>Step 2 — Infer each feeding arrow from evidence.</h4>
              <p><strong>Do not copy an answer list.</strong> Read the observation, decide who is the food and who receives the energy, then check your direction. Record the confirmed arrow on Food Web V1.</p>
              <div class="feeding-grid">
                {network.feedingLinks.map((link, index) => (
                  <article class="feeding-clue" data-food={link.food} data-eater={link.eater}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <div class="feeding-clue-body"><p>{link.evidence}</p><strong>Which direction should the energy arrow point?</strong><div class="feeding-choice" role="group" aria-label={`Choose arrow direction for feeding clue ${index + 1}`}><button type="button" data-feed-choice="correct">{link.food} → {link.eater}</button><button type="button" data-feed-choice="wrong">{link.eater} → {link.food}</button></div><small data-feed-feedback role="status"></small></div>
                  </article>
                ))}
              </div>
              <p class="feeding-counter" data-feeding-counter>Confirm every feeding connection before calling Food Web V1 complete.</p>
              <p class="decomposer-note"><strong>Add decomposers to your drawing:</strong> show that dead material and wastes from producers and consumers can become resources for <strong>{network.nodes.find((node) => node.role === 'decomposer')?.name}</strong>. Do not draw an energy arrow from decomposers back to producers.</p>
            </section>

            <section class="interaction-lab">
              <div class="interaction-card symbiosis-card" data-symbiosis={network.symbiosis.type}>
                <p class="system-label">STEP 3 // SYMBIOSIS SIGNAL</p><h4>{network.symbiosis.partners}</h4><p>{network.symbiosis.evidence}</p>
                <div class="symbiosis-reference"><strong>Quick reference:</strong> Mutualism = both benefit · Commensalism = one benefits, other unaffected · Parasitism = one benefits, other harmed</div>
                <div class="interaction-buttons" role="group" aria-label="Classify symbiosis"><button type="button" data-symbiosis-choice="mutualism">Mutualism</button><button type="button" data-symbiosis-choice="commensalism">Commensalism</button><button type="button" data-symbiosis-choice="parasitism">Parasitism</button></div><small data-symbiosis-feedback role="status"></small>
              </div>
              <div class="interaction-card competition-card"><p class="system-label">STEP 4 // COMPETITION SIGNAL</p><h4>{network.competition.organisms}</h4><p>{network.competition.evidence}</p><div class="shared-resource"><span>SHARED LIMITED RESOURCE</span><strong>{network.competition.sharedResource}</strong></div><p class="record-note">Record this competition relationship beside your Food Web V1. Competition is important even though it is not shown with a feeding arrow.</p></div>
            </section>

            <section class="change-challenge"><p class="system-label">STEP 5 // NETWORK CHANGE CHALLENGE</p><h4>{network.changeChallenge}</h4><p class="record-instruction"><strong>Discuss all three prompts as a team.</strong> Then the Network Mapper records your agreed answers in the Direct Effect, Indirect Effect, and Uncertainty spaces on Food Web V1.</p><div class="change-prompts"><article><strong>Direct effect</strong><p>Name one organism connected immediately to the change. Predict what may happen and why.</p></article><article><strong>Indirect effect</strong><p>Name one organism that may be affected later through another organism.</p></article><article><strong>Uncertainty</strong><p>What information would help you make a stronger prediction?</p></article></div></section>

            <section class="team-question"><p class="system-label">TEAM INVESTIGATION QUESTION</p><h4>{network.investigationQuestion}</h4></section>

            <section class="web-requirements"><h4>Before your team calls Food Web V1 complete, check all seven requirements.</h4><ol><li>Include every organism record from your network file.</li><li>Label organisms as <strong>P</strong> producer, <strong>C</strong> consumer, or <strong>D</strong> decomposer.</li><li>Confirm and draw every feeding arrow from <strong>food → eater</strong>.</li><li>Clearly mark your focal species: <strong>{network.focalSpecies}</strong>.</li><li>Record the competition relationship and shared resource.</li><li>Record the symbiosis relationship and classify its type.</li><li>Write one direct-effect prediction, one indirect-effect prediction, and one uncertainty.</li></ol></section>
          </article>
        ))}
      </div>
    </section>

    <section class="panel archive-panel" id="archive" aria-labelledby="archive-heading">
      <JcecWorkMode mode="archive" title="Add Food Web V1 to the Continental Archive" />
      <p class="system-label">JCEC ARCHIVE TRANSMISSION</p><h2 id="archive-heading">Your drawing stays with the team archive. JCEC also needs a written network summary.</h2><p>Keep the completed Food Web V1 as your continent’s official visual evidence. One team member submits the written summary below so your teacher can review the scientific reasoning.</p>

      <div class="archive-checklist"><article><span>1</span><div><strong>Claim / Main Finding</strong><p>Summarize the focal species’ role and explain why this ecosystem is a network rather than one simple food chain.</p></div></article><article><span>2</span><div><strong>Evidence</strong><p>Describe at least three specific feeding, competition, symbiosis, or decomposition connections from your evidence.</p></div></article><article><span>3</span><div><strong>Reasoning</strong><p>Explain how energy moves through the web and use your change challenge to show why interdependence matters.</p></div></article><article><span>4</span><div><strong>Uncertainty</strong><p>Identify one important relationship, population response, or resource condition that still needs more evidence.</p></div></article></div>

      <div class="submission-guide">
        <div class="guide-heading"><span aria-hidden="true">📡</span><div><strong>Submit to the JCEC Portal</strong><small>This written summary becomes teacher-visible.</small></div></div>
        <dl><div><dt>Submission Type</dt><dd>Continental Archive</dd></div><div><dt>Mission Phase</dt><dd>01 First Contact</dd></div><div><dt>Operation / Task</dt><dd>Ecosystem Network — Food Web V1</dd></div><div><dt>Continent</dt><dd id="archive-continent">Your assigned continent</dd></div><div><dt>Team ID</dt><dd id="archive-team-id">Use the ID your teacher gives you</dd></div><div><dt>Team Members</dt><dd>List everyone represented</dd></div></dl>
        <div class="form-map"><strong>What goes in each Form field?</strong><div><span>Claim / Decision</span><p>Focal species role + why your ecosystem is a web, not one chain.</p></div><div><span>Evidence</span><p>At least three important feeding, competition, symbiosis, or decomposition connections.</p></div><div><span>Reasoning</span><p>Explain energy flow + your direct and indirect change predictions. Add your uncertainty at the end.</p></div><div><span>Pathfinder Reflection</span><p>Leave blank for this team archive submission unless your teacher tells you otherwise.</p></div></div>
        <p><strong>Only one team member submits.</strong> Your Food Web V1 drawing is part of the team archive but is not uploaded through this form. Read the written summary aloud before submitting so everyone agrees that it matches the web.</p>
        <a class="button primary" href={portalUrl} target="_blank" rel="noopener noreferrer">Submit Ecosystem Network Summary to JCEC ↗</a>
        <p class="return-note"><strong>After submitting:</strong> return to this page or Mission Control. Your teacher dashboard—not this webpage—is the official record of the written submission.</p>
      </div>
    </section>

    <section class="panel reflection" aria-labelledby="reflection-heading"><JcecWorkMode mode="individual" title="Update your Pathfinder Log" /><h2 id="reflection-heading">What did the network show that a food chain would miss?</h2><p>Answer these on your own after the team archive is complete:</p><ol><li>Choose one organism in your web. Name at least two different ways it is connected to other organisms.</li><li>Explain the arrow direction in a food web using the word <strong>energy</strong>.</li><li>Which predicted indirect effect from your team’s change challenge seems most reasonable? What evidence supports it?</li><li>What relationship in your ecosystem would you most want JCEC to measure next?</li></ol><p class="reflection-note">This reflection is individual. Keep it in your Pathfinder Log unless your teacher directs you to submit it to JCEC.</p></section>

    <section class="next-operation" aria-labelledby="next-operation-heading"><div><span>05</span><strong>NEXT OPERATION</strong></div><section><p class="system-label">ACCESS PENDING</p><h2 id="next-operation-heading">Population Investigation</h2><p>Your food web predicts that connected populations should respond when conditions change. Next, JCEC will send real population data and ask your team to explain a mystery.</p><div class="locked"><span>🔒</span><strong>Await JCEC activation.</strong></div></section></section>

    <div class="bottom-actions"><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/operation-03/`}>← Operation 03</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/phase-1/`}>Phase 1 Operations</a><a class="button secondary" href={`${base}courses/grade-7-science/jabberwocky/`}>Mission Control</a></div>
  </div>

  <script is:inline>
    (() => {
      const posting = localStorage.getItem('jabberwocky-phase1-posting');
      const noPosting = document.getElementById('no-posting');
      const files = document.getElementById('network-files');
      const file = posting ? document.querySelector(`[data-network="${posting}"]`) : null;

      if (!posting || !file) {
        if (noPosting) noPosting.hidden = false;
      } else {
        if (files) files.hidden = false;
        file.hidden = false;
        const continentName = file.querySelector('.network-heading h3')?.textContent?.split(':')[0]?.trim() || posting;
        const archiveContinent = document.getElementById('archive-continent');
        const archiveTeamId = document.getElementById('archive-team-id');
        if (archiveContinent) archiveContinent.textContent = continentName;
        const signal = file.querySelector('.system-label')?.textContent || '';
        const codeMatch = signal.match(/04-([A-Z]{2})/);
        const code = codeMatch?.[1] || 'XX';
        if (archiveTeamId) archiveTeamId.textContent = `P1-${code}-__ (use the number your teacher assigns)`;
      }

      document.querySelectorAll('.network-file').forEach((networkFile) => {
        const organismCards = [...networkFile.querySelectorAll('.organism-card')];
        const roleCounter = networkFile.querySelector('[data-role-counter]');
        const updateRoleCounter = () => {
          const complete = organismCards.filter((card) => card.dataset.complete === 'true').length;
          if (roleCounter) roleCounter.textContent = complete === organismCards.length ? '✓ Ecological-role classification complete. Use these roles on Food Web V1.' : `${complete} of ${organismCards.length} correctly classified.`;
        };
        organismCards.forEach((card) => {
          const correctRole = card.dataset.role;
          card.querySelectorAll('[data-role-choice]').forEach((button) => {
            button.addEventListener('click', () => {
              card.querySelectorAll('[data-role-choice]').forEach((other) => other.classList.remove('correct', 'incorrect'));
              const choice = button.dataset.roleChoice;
              const feedback = card.querySelector('.role-feedback');
              if (choice === correctRole) { button.classList.add('correct'); card.dataset.complete = 'true'; if (feedback) feedback.textContent = `✓ ${choice}`; }
              else { button.classList.add('incorrect'); card.dataset.complete = 'false'; if (feedback) feedback.textContent = 'Re-read the evidence: how does this organism obtain energy?'; }
              updateRoleCounter();
            });
          });
        });
        updateRoleCounter();

        const feedingClues = [...networkFile.querySelectorAll('.feeding-clue')];
        const feedingCounter = networkFile.querySelector('[data-feeding-counter]');
        const updateFeedingCounter = () => {
          const complete = feedingClues.filter((clue) => clue.dataset.complete === 'true').length;
          if (feedingCounter) feedingCounter.textContent = complete === feedingClues.length ? '✓ All feeding arrows confirmed. Make sure they are recorded on Food Web V1.' : `${complete} of ${feedingClues.length} feeding arrows confirmed.`;
        };
        feedingClues.forEach((clue) => {
          clue.querySelectorAll('[data-feed-choice]').forEach((button) => {
            button.addEventListener('click', () => {
              clue.querySelectorAll('[data-feed-choice]').forEach((other) => other.classList.remove('correct', 'incorrect'));
              const feedback = clue.querySelector('[data-feed-feedback]');
              if (button.dataset.feedChoice === 'correct') { button.classList.add('correct'); clue.dataset.complete = 'true'; if (feedback) feedback.textContent = `✓ Confirmed: ${clue.dataset.food} → ${clue.dataset.eater}. Record this arrow on Food Web V1.`; }
              else { button.classList.add('incorrect'); clue.dataset.complete = 'false'; if (feedback) feedback.textContent = 'Not quite. Ask: which organism is the food, and which organism receives that energy?'; }
              updateFeedingCounter();
            });
          });
        });
        updateFeedingCounter();

        const symbiosisCard = networkFile.querySelector('.symbiosis-card');
        symbiosisCard?.querySelectorAll('[data-symbiosis-choice]').forEach((button) => {
          button.addEventListener('click', () => {
            symbiosisCard.querySelectorAll('[data-symbiosis-choice]').forEach((other) => other.classList.remove('correct', 'incorrect'));
            const correct = symbiosisCard.dataset.symbiosis;
            const feedback = symbiosisCard.querySelector('[data-symbiosis-feedback]');
            if (button.dataset.symbiosisChoice === correct) { button.classList.add('correct'); if (feedback) feedback.textContent = `✓ ${correct}. Use the evidence to explain who benefits or is harmed.`; }
            else { button.classList.add('incorrect'); if (feedback) feedback.textContent = 'Try again. Ask: who benefits, who is unaffected, and who is harmed?'; }
          });
        });
      });

      document.getElementById('print-op4-packet')?.addEventListener('click', () => window.print());
    })();
  </script>
</BaseLayout>

