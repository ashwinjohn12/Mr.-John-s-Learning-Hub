---
import MarsProjectShell from '../../../../../components/MarsProjectShell.astro';
import MarsReadinessDashboard from '../../../../../components/MarsReadinessDashboard.astro';
import MarsIntelLegend from '../../../../../components/MarsIntelLegend.astro';
const base = import.meta.env.BASE_URL;
const understandHref = base + 'courses/grade-9-science/space-exploration/mars-readiness/understand/';
const travelHref = base + 'courses/grade-9-science/space-exploration/mars-readiness/travel/';
const surviveHref = base + 'courses/grade-9-science/space-exploration/mars-readiness/survive/';
const operateHref = base + 'courses/grade-9-science/space-exploration/mars-readiness/operate/';
const heroImage = 'https://d2pn8kiwq2w21t.cloudfront.net/original_images/jpegPIA26378.jpg';

const phaseCards = [
  { number: '01', title: 'UNDERSTAND', question: 'What do we know—and how do we know it?', status: 'AVAILABLE', href: understandHref },
  { number: '02', title: 'TRAVEL', question: 'Can we actually get there?', status: 'AVAILABLE', href: travelHref },
  { number: '03', title: 'SURVIVE', question: 'Can humans stay alive?', status: 'AVAILABLE', href: surviveHref },
  { number: '04', title: 'OPERATE & DECIDE', question: 'Could the mission work—and what should happen next?', status: 'AVAILABLE', href: operateHref }
];

const operationProgress = [
  { number: '01', title: 'Locate Mars', copy: 'Place Mars in the larger structure of the universe and build the evidence skills needed for the rest of the mission.', href: understandHref + '#operation-01' },
  { number: '02', title: 'Trust the Evidence', copy: 'Use observations to test how scientific models of space become stronger or change.', href: understandHref + '#operation-02' },
  { number: '03', title: 'Read the Light', copy: 'Use different kinds of electromagnetic evidence to infer properties of objects in space.', href: understandHref + '#operation-03' },
  { number: '04', title: 'Profile Mars', copy: 'Turn evidence about Mars and other Solar System bodies into mission constraints.', href: understandHref + '#operation-04' },
  { number: '05', title: 'Predict the Target', copy: 'Model a moving Mars and predict where the destination will be when a spacecraft arrives.', href: travelHref + '#operation-05' },
  { number: '06', title: 'Find Your Position', copy: 'Connect angular coordinates, parallax, and Doppler evidence to position, distance, and motion.', href: travelHref + '#operation-06' },
  { number: '07', title: 'Choose the Transport', copy: 'Compare transportation approaches using mission trade-offs rather than a single automatic winner.', href: travelHref + '#operation-07' },
  { number: '08', title: 'Land the Payload', copy: 'Plan, test, and improve a physical landing system while recognizing the limits of the model.', href: travelHref + '#operation-08' },
  { number: '09', title: 'Identify the Hazards', copy: 'Connect Mars and deep-space hazards to the human needs and systems they threaten.', href: surviveHref + '#operation-09' },
  { number: '10', title: 'Close the Loop', copy: 'Trace how life-support subsystems keep air and water moving through a closed environment.', href: surviveHref + '#operation-10' },
  { number: '11', title: 'Use What Mars Provides', copy: 'Compare what should be brought from Earth with what could be produced or extracted on Mars.', href: surviveHref + '#operation-11' },
  { number: '12', title: 'Recover the Water', copy: 'Test a physical water-recovery model and distinguish recovery, clarity, and potability.', href: surviveHref + '#operation-12' },
  { number: '13', title: 'Send the Robots', copy: 'Choose the investigation platform that best matches the evidence a mission needs.', href: operateHref + '#operation-13' },
  { number: '14', title: 'Build the Network', copy: 'Build a simplified Mars communications and positioning network.', href: operateHref + '#operation-14' },
  { number: '15', title: 'Respond to the Crisis', copy: 'Allocate limited mission power and justify the consequences your team accepts.', href: operateHref + '#operation-15' },
  { number: '16', title: 'Make the Call', copy: 'Review the full seven-system evidence record and make your final individual Mars readiness judgement.', href: operateHref + '#operation-16' }
];
---

<MarsProjectShell
  title="MISSION: MARS — Are We Ready? | Grade 9 Science"
  description="A Grade 9 Science Mars Readiness Program using real evidence to judge what humanity can do now and what still needs to be solved."
  activePhase="hub"
>
  <section class="mars-hero" aria-labelledby="mars-title">
    <div class="mars-hero-copy">
      <p class="mars-kicker">GRADE 9 SCIENCE // SPACE EXPLORATION</p>
      <h1 id="mars-title">MISSION: <span>MARS</span></h1>
      <p class="hero-question"><strong>Are we ready?</strong> Use real science, test real problems, and decide what humanity still needs to solve before people can safely travel to and live on Mars.</p>
      <ul class="mars-hero-list">
        <li>Robots are exploring Mars now.</li>
        <li>Some future-Mars technologies have been demonstrated only at small scale.</li>
        <li>Human Mars travel and permanent settlement remain future goals, not accomplished missions.</li>
      </ul>
      <div style="margin-top:1.2rem">
        <a class="mars-action" href={understandHref} data-hub-primary-action>Begin systems review →</a>
      </div>
    </div>
    <figure>
      <img src={heroImage} alt="Wide Perseverance rover view across the rocky floor and rim of Jezero Crater on Mars" loading="eager" />
      <figcaption>
        Perseverance Mastcam-Z mosaic, Jezero Crater. Credit: NASA/JPL-Caltech/ASU/MSSS.
        <a href="https://www.jpl.nasa.gov/images/pia26378-perseverances-mid-climb-view-of-jezero-crater/" target="_blank" rel="noreferrer">View source ↗</a>
      </figcaption>
    </figure>
  </section>

  <MarsReadinessDashboard />

  <MarsIntelLegend />

  <section class="phase-intro" aria-labelledby="program-path">
    <div>
      <p class="mars-kicker">FOUR-WEEK PROGRAM</p>
      <h2 id="program-path">One question. Four reviews.</h2>
      <p>Each phase adds evidence to the same seven-system readiness picture. Your class will move through one phase at a time, so focus on the evidence available now.</p>
    </div>
  </section>

  <section class="phase-index" aria-label="Mars Readiness Program phase overview">
    {phaseCards.map((phase) => (
      phase.href ? (
        <a href={phase.href}>
          <span>{phase.number} // {phase.status}</span>
          <strong>{phase.title}</strong>
          <small>{phase.question}</small>
        </a>
      ) : (
        <div class="phase-preview-card" aria-disabled="true">
          <span>{phase.number} // {phase.status}</span>
          <strong>{phase.title}</strong>
          <small>{phase.question}</small>
        </div>
      )
    ))}
  </section>

  <section class="current-review-panel" data-current-review>
    <div>
      <p class="mars-kicker">YOUR CURRENT REVIEW</p>
      <h2 data-current-review-title>Operation 01 — Locate Mars</h2>
      <p data-current-review-copy>Place Mars in the larger structure of the universe and build the evidence skills needed for the rest of the mission.</p>
    </div>
    <a class="mars-action" href={understandHref + '#operation-01'} data-current-review-link>Continue to Operation 01 →</a>
  </section>
</MarsProjectShell>

<script define:vars={{ operationProgress }}>
  const STORAGE_KEY = 'mrjohn-mars-readiness-v1';

  function readCompletedOperations() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      return new Set(Object.keys(saved.operations || {}));
    } catch {
      return new Set();
    }
  }

  const completed = readCompletedOperations();
  const nextOperation =
    operationProgress.find((operation) => operation.number === '16' || !completed.has(operation.number))
    || operationProgress[operationProgress.length - 1];

  const title = document.querySelector('[data-current-review-title]');
  const copy = document.querySelector('[data-current-review-copy]');
  const link = document.querySelector('[data-current-review-link]');
  const primary = document.querySelector('[data-hub-primary-action]');

  if (title && copy && link) {
    title.textContent = 'Operation ' + nextOperation.number + ' — ' + nextOperation.title;
    copy.textContent = nextOperation.copy;
    link.href = nextOperation.href;
    link.textContent = 'Continue to Operation ' + nextOperation.number + ' →';
  }

  if (primary && completed.size > 0) {
    primary.href = nextOperation.href;
    primary.textContent = 'Continue systems review →';
  }
</script>

<style>
  .phase-preview-card{min-height:112px;padding:.8rem;border:1px dashed #b9bdc0;border-radius:10px;background:rgba(255,255,255,.45);opacity:.62}
  .phase-preview-card span{color:#6f7579;font:800 .66rem 'IBM Plex Mono',monospace}
  .phase-preview-card strong{display:block;margin-top:.3rem}
  .phase-preview-card small{display:block;margin-top:.25rem;color:#62686d;line-height:1.35}
  .current-review-panel{display:flex;justify-content:space-between;gap:1.2rem;align-items:center;margin:1.4rem 0;padding:1.2rem 1.3rem;border:1px solid #b9c7d0;border-radius:12px;background:#edf5f9}
  .current-review-panel h2{margin:.25rem 0}
  .current-review-panel p:last-child{max-width:720px;margin:.3rem 0;color:#4c5b65}
  @media(max-width:680px){.current-review-panel{display:grid}.current-review-panel .mars-action{width:100%}}
</style>
