---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { courses, type Course } from '../../data/courses';
export function getStaticPaths() { return courses.map((course) => ({ params: { course: course.slug }, props: { course } })); }
interface Props { course: Course }
const { course } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${course.grade} ${course.shortSubject} | Mr. John’s Learning Hub`} description={course.description} themeColor={course.color}>
  <div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`}]} />
    <header class="course-hero">
      <div><p class="eyebrow">{course.subject.toUpperCase()}</p><h1>{course.grade}<br /><span>{course.shortSubject}</span></h1><p>{course.description}</p></div>
      <div class="course-stamp"><strong>{course.units.length}</strong><span>learning<br />units</span></div>
    </header>
    {course.slug === 'grade-6-math' && (
      <section class="year-review-cta" aria-labelledby="year-review-heading">
        <div><p class="eyebrow">CUMULATIVE REVIEW</p><h2 id="year-review-heading">Grade 6 Math Year Review & PAT Prep</h2><p>Mix all nine units with balanced supported practice, a unit-by-unit diagnostic, reasoning prompts, and calculator-free PAT-style sets.</p></div>
        <a class="button" href={`${base}courses/${course.slug}/year-review/`}>Open Year Review →</a>
      </section>
    )}
    <section class="unit-list" aria-labelledby="units-heading">
      <div class="section-heading"><div><p class="eyebrow">COURSE MAP</p><h2 id="units-heading">Choose a unit</h2></div><p>Work in order or jump directly to the topic you need.</p></div>
      {course.units.map((unit) => (
        <a class="unit-row" href={`${base}courses/${course.slug}/${unit.slug}/`}>
          <span class="unit-index">{unit.number}</span><span><strong>{unit.title}</strong><small>{unit.description}</small></span><span class="unit-count">{unit.topics.length || '—'}<small>topics</small></span><span class="round-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>
<style>
.year-review-cta{display:grid;grid-template-columns:1fr auto;gap:1.25rem;align-items:center;margin:1.2rem 0 2rem;padding:1.2rem 1.3rem;border:1px solid #d8e2ef;border-radius:18px;background:linear-gradient(135deg,#fff,var(--course-soft));box-shadow:0 10px 28px rgba(15,45,80,.06)}.year-review-cta h2{margin:.2rem 0 .45rem;font-size:clamp(1.5rem,3vw,2rem)}.year-review-cta p:last-child{max-width:760px;margin:0;color:#526174;line-height:1.55}.year-review-cta a{text-decoration:none;white-space:nowrap}@media(max-width:700px){.year-review-cta{grid-template-columns:1fr}.year-review-cta a{justify-self:start}}
</style>
