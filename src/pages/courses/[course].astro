---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { courses, type Course } from '../../data/courses';
export function getStaticPaths() { return courses.map((course) => ({ params: { course: course.slug }, props: { course } })); }
interface Props { course: Course }
const { course } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${course.grade} ${course.shortSubject} | Mr. John’s Learning Hub`} description={course.description} themeColor={course.color}>
  <div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`}]} />
    <header class="course-hero">
      <div><p class="eyebrow">{course.subject.toUpperCase()}</p><h1>{course.grade}<br /><span>{course.shortSubject}</span></h1><p>{course.description}</p></div>
      <div class="course-stamp"><strong>{course.units.length}</strong><span>learning<br />units</span></div>
    </header>
    {course.slug === 'grade-6-math' && (
      <section class="year-review-cta" aria-labelledby="year-review-heading">
        <div><p class="eyebrow">CUMULATIVE REVIEW</p><h2 id="year-review-heading">Grade 6 Math Year Review & PAT Prep</h2><p>Mix all nine units with balanced supported practice, a unit-by-unit diagnostic, reasoning prompts, and calculator-free PAT-style sets.</p></div>
        <a class="button" href={`${base}courses/${course.slug}/year-review/`}>Open Year Review →</a>
      </section>
    )}
    {course.slug === 'grade-7-science' && (
      <section class="jabberwocky-cta" aria-labelledby="jabberwocky-heading">
        <div class="mission-copy">
          <p class="mission-label">YEAR-LONG SCIENCE EXPEDITION</p>
          <h2 id="jabberwocky-heading">Jabberwocky: Mission 2190</h2>
          <p>Enter JCEC Mission Control, explore eight continents, change scientific roles each unit, inherit evidence from earlier teams, and help decide the future of an unexplored planet.</p>
          <div class="mission-tags" aria-label="Mission features">
            <span>5 mission phases</span><span>8 continents</span><span>Changing teams</span><span>Year-long story</span>
          </div>
        </div>
        <div class="mission-action">
          <span class="mission-status">● MISSION ACTIVE</span>
          <a class="mission-button" href={`${base}courses/${course.slug}/jabberwocky/`}>Enter Mission Control →</a>
        </div>
      </section>
    )}
    <section class="unit-list" aria-labelledby="units-heading">
      <div class="section-heading"><div><p class="eyebrow">COURSE MAP</p><h2 id="units-heading">Choose a unit</h2></div><p>Work in order or jump directly to the topic you need.</p></div>
      {course.units.map((unit) => (
        <a class="unit-row" href={`${base}courses/${course.slug}/${unit.slug}/`}>
          <span class="unit-index">{unit.number}</span><span><strong>{unit.title}</strong><small>{unit.description}</small></span><span class="unit-count">{unit.topics.length || '—'}<small>topics</small></span><span class="round-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>
<style>
.year-review-cta{display:grid;grid-template-columns:1fr auto;gap:1.25rem;align-items:center;margin:1.2rem 0 2rem;padding:1.2rem 1.3rem;border:1px solid #d8e2ef;border-radius:18px;background:linear-gradient(135deg,#fff,var(--course-soft));box-shadow:0 10px 28px rgba(15,45,80,.06)}.year-review-cta h2{margin:.2rem 0 .45rem;font-size:clamp(1.5rem,3vw,2rem)}.year-review-cta p:last-child{max-width:760px;margin:0;color:#526174;line-height:1.55}.year-review-cta a{text-decoration:none;white-space:nowrap}
.jabberwocky-cta{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:center;margin:1.2rem 0 2rem;padding:clamp(1.3rem,4vw,2rem);border:1px solid #164b4d;border-radius:20px;background:radial-gradient(circle at 90% 15%,rgba(101,240,207,.22),transparent 28%),linear-gradient(135deg,#071827,#0b3140);box-shadow:0 16px 38px rgba(8,42,54,.18);color:#eaf8f6}.jabberwocky-cta:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,.28) 1px,transparent 1px);background-size:30px 30px;opacity:.12}.mission-copy,.mission-action{position:relative;z-index:1}.mission-label{margin:0;color:#72efd0;font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em}.jabberwocky-cta h2{margin:.35rem 0 .45rem;color:#fff;font-size:clamp(1.7rem,4vw,2.35rem)}.jabberwocky-cta .mission-copy>p:last-of-type{max-width:760px;margin:.2rem 0 .85rem;color:#c5dce2;line-height:1.6}.mission-tags{display:flex;flex-wrap:wrap;gap:.4rem}.mission-tags span{padding:.3rem .55rem;border:1px solid #28596a;border-radius:999px;background:rgba(255,255,255,.04);color:#b8d4da;font-size:.78rem;font-weight:750}.mission-action{display:grid;justify-items:end;gap:.65rem}.mission-status{color:#72efd0;font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.mission-button{display:inline-flex;align-items:center;justify-content:center;padding:.8rem 1rem;border-radius:12px;background:#72efd0;color:#06231b;text-decoration:none;font-weight:900;white-space:nowrap}.mission-button:hover{transform:translateY(-1px)}
@media(max-width:700px){.year-review-cta,.jabberwocky-cta{grid-template-columns:1fr}.year-review-cta a{justify-self:start}.mission-action{justify-items:start}}
</style>
