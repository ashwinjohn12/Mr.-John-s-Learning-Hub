---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { courses, type Course, type Unit } from '../../../data/courses';
export function getStaticPaths() { return courses.flatMap((course) => course.units.map((unit) => ({ params: { course: course.slug, unit: unit.slug }, props: { course, unit } }))); }
interface Props { course: Course; unit: Unit }
const { course, unit } = Astro.props;
const base = import.meta.env.BASE_URL;
const builtGrade6Override = course.slug === 'grade-6-math' && ['patterns','statistics'].includes(unit.slug);
const reviewInfo = course.slug === 'grade-6-math' && unit.slug === 'positive-negative-numbers'
  ? { title:'Unit 1 Review & Math Arcade', summary:'Mix all five skills, take a randomized unit check, and complete free-response integer missions.' }
  : course.slug === 'grade-6-math' && unit.slug === 'coordinates-design'
    ? { title:'Unit 2 Review & Math Arcade', summary:'Review all six lessons, mix coordinates and transformations, and complete the Transformation Mission Arcade.' }
    : course.slug === 'grade-6-math' && unit.slug === 'number-operations'
      ? { title:'Unit 3 Review & Math Arcade', summary:'Mix prime factors, powers, and order of operations, then complete the Number Lab Quest.' }
      : course.slug === 'grade-6-math' && unit.slug === 'decimals-fractions'
        ? { title:'Unit 4 Review & Math Arcade', summary:'Review all six fraction and decimal lessons, take a balanced Unit Check, and complete the Fraction & Decimal City Quest.' }
        : course.slug === 'grade-6-math' && unit.slug === 'ratios-rates'
          ? { title:'Unit 5 Review & Math Arcade', summary:'Connect percent, equivalent ratios, proportions, and unit rates, take a balanced Unit Check, and complete the Ratio & Rate Expedition.' }
          : course.slug === 'grade-6-math' && unit.slug === 'algebra'
            ? { title:'Unit 6 Review & Math Arcade', summary:'Connect simplifying expressions, balance models, inverse operations, and verification, then complete the Algebra Lab Escape.' }
            : course.slug === 'grade-6-math' && unit.slug === 'measurement'
              ? { title:'Unit 7 Review & Math Arcade', summary:'Connect parallelogram and triangle area, composite shapes, and volume, take a balanced Unit Check, and complete the Measurement Design Arcade.' }
              : course.slug === 'grade-6-math' && unit.slug === 'patterns'
                ? { title:'Unit 8 Review & Math Arcade', summary:'Connect function rules, tables, ordered pairs, graphs, equations, predictions, and backward reasoning, then complete the Function Lab Arcade.' }
                : course.slug === 'grade-6-math' && unit.slug === 'statistics'
                  ? { title:'Unit 9 Review & Statistics Arcade', summary:'Connect fair experiments, relative frequency, sample size, predictions, and data reliability, then complete the Statistics Lab Arcade.' }
                  : null;
---
<BaseLayout title={`${unit.title} | ${course.grade} ${course.shortSubject}`} description={unit.description} themeColor={course.color}>
  <div class="page-wrap" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`,href:`${base}courses/${course.slug}/`},{label:unit.title}]} />
    <header class="unit-hero">
      <p class="eyebrow">UNIT {unit.number}</p><h1>{unit.title}</h1><p>{unit.description}</p>
      {reviewInfo && <a class="unit-review-cta" href={`${base}courses/${course.slug}/${unit.slug}/unit-review/`}>★ {reviewInfo.title} →</a>}
    </header>
    {unit.topics.length ? (
      <section class="topic-list">
        <p class="eyebrow">TOPICS</p>
        {unit.topics.map((topic) => {
          const topicLive = topic.status === 'ready' || builtGrade6Override;
          return (
          <a class={`topic-row ${!topicLive ? 'is-planned' : ''}`} href={topicLive ? `${base}courses/${course.slug}/${unit.slug}/${topic.slug}/` : undefined} aria-disabled={!topicLive ? 'true' : undefined}>
            <span>{topic.number}</span><span><strong>{topic.title}</strong><small>{topic.summary}</small></span><em>{topicLive ? 'Open topic' : 'Coming next'}</em>
          </a>
          );
        })}
        {reviewInfo && (
          <a id="unit-review-link" class="topic-row review-row" href={`${base}courses/${course.slug}/${unit.slug}/unit-review/`} aria-label={`${reviewInfo.title} — open unit review`}>
            <span>★</span><span><strong>{reviewInfo.title}</strong><small>{reviewInfo.summary}</small></span><em>Review unit</em>
          </a>
        )}
      </section>
    ) : (
      <section class="empty-unit"><span aria-hidden="true">✦</span><h2>This unit is mapped and ready for content.</h2><p>Topics will use the same Learn → Explore → Practise → Review structure as the working Grade 6 example.</p></section>
    )}
  </div>
</BaseLayout>
<style>
.review-row{border-width:2px;background:linear-gradient(135deg,#fff,#f3effb)}.review-row>span:first-child{font-size:1.25rem}
.unit-review-cta{display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;padding:.75rem 1rem;border-radius:12px;background:#fff;color:var(--course);font-weight:900;text-decoration:none;box-shadow:0 1px 0 rgba(15,23,42,.08)}
.unit-review-cta:hover{text-decoration:underline}
</style>
