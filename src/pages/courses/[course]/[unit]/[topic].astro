---
import Unit1LessonPage from '../../../../components/Unit1LessonPage.astro';
import { courses, type Course, type Unit, type Topic } from '../../../../data/courses';
import { topicContent, type TopicContent } from '../../../../data/topicContent';

export function getStaticPaths() {
  return courses.flatMap((course) =>
    course.units.flatMap((unit) =>
      unit.topics
        .filter((topic) => `${course.slug}/${unit.slug}/${topic.slug}` in topicContent)
        .map((topic) => ({
          params: { course: course.slug, unit: unit.slug, topic: topic.slug },
          props: {
            course,
            unit,
            topic,
            content: topicContent[`${course.slug}/${unit.slug}/${topic.slug}`]
          }
        }))
    )
  );
}
interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content } = Astro.props;
---
<Unit1LessonPage {course} {unit} {topic} {content} />
