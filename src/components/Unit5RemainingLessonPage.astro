---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit5EquivalentRatioLab from './Unit5EquivalentRatioLab.astro';
import Unit5RecipeRemixGame from './Unit5RecipeRemixGame.astro';
import Unit5UnitRateLab from './Unit5UnitRateLab.astro';
import Unit5RateRaceGame from './Unit5RateRaceGame.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';
interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent; variant: 'ratios' | 'rates' }
const { course, unit, topic, content, variant } = Astro.props;
const base = import.meta.env.BASE_URL;
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const visiblePrerequisites = content.prerequisites.slice(0, 3);
const visibleGoals = content.goals.slice(0, 4);
const coreConcepts = content.concepts.slice(0, 5);
const appliedConcepts = content.concepts.slice(5);
const coreExamples = content.examples.slice(0, 2);
const advancedExamples = content.examples.slice(2);
const labTitle = variant === 'ratios' ? 'Equivalent Ratio Builder' : 'Unit Rate Lab';
const gameTitle = variant === 'ratios' ? 'Recipe Remix' : 'Rate Race';
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} compactMobileHero mobileHeroSize="clamp(1.9rem,9vw,2.9rem)">
  <LearningSection id="overview" eyebrow="GET READY" title={`Get ready for ${variant === 'ratios' ? 'equivalent ratios' : 'unit rates'}`} icon="🎯" tone="idea">
    <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{visiblePrerequisites.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">TODAY'S MISSION</p><ul>{visibleGoals.map((goal)=><li>{goal}</li>)}</ul></div></div>
    <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
    <p class="start-note"><strong>Best place to begin:</strong> Read the Big Idea, then work through Understand and Examples before opening the interactive lab.</p>
    <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map((item)=><li>{item}</li>)}</ul></details>
  </LearningSection>

  <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
    <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
    <div class="three-step-rule">
      {variant === 'ratios' ? <><div><span>1</span><strong>Keep the order</strong><small>Label what each term represents.</small></div><div><span>2</span><strong>Find the factor</strong><small>How did one known term change?</small></div><div><span>3</span><strong>Scale both terms</strong><small>Use the same factor and interpret.</small></div></> : <><div><span>1</span><strong>Name the units</strong><small>What two quantities are being compared?</small></div><div><span>2</span><strong>Make it per 1</strong><small>Scale the second term to 1.</small></div><div><span>3</span><strong>Use the rate</strong><small>Compare or extend the relationship.</small></div></>}
    </div>
    <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
  </LearningSection>

  <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
    <div class="concept-grid detailed">{coreConcepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
    {appliedConcepts.length > 0 && <details class="applied-concepts"><summary>{variant === 'ratios' ? 'Rates are ratios too' : 'Using a unit rate to extend a relationship'}</summary><div class="applied-grid">{appliedConcepts.map((concept)=><div><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div></details>}
    {variant === 'ratios' ? <article class="relationship-card"><p class="eyebrow">VISUAL MODEL · SAME RELATIONSHIP</p><h3>Both terms scale together</h3><div class="ratio-scale"><span>2 : 3</span><b>×4</b><span>8 : 12</span></div><div class="ratio-arrows"><span>2 → 8</span><strong>same factor ×4</strong><span>3 → 12</span></div><p class="model-note">The numbers changed. The comparison did not.</p></article> : <article class="relationship-card"><p class="eyebrow">VISUAL MODEL · PER 1</p><h3>Unit rate is an equivalent rate</h3><div class="ratio-scale"><span>$20 : 5 notebooks</span><b>÷5</b><span>$4 : 1 notebook</span></div><p class="model-note">Both quantities were divided by 5, so the relationship stayed equivalent while the second term became 1.</p></article>}
    <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map((item)=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
  </LearningSection>

  <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
    <p class="section-lead">Start with the two core examples. Open the next examples when you are ready to apply the same reasoning in a new situation.</p>
    <div class="example-stack">{coreExamples.map((example)=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map((step)=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
    <details class="advanced-examples"><summary>Ready for more? Open Examples 3 and 4</summary><div class="example-stack advanced-stack">{advancedExamples.map((example)=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map((step)=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>
  </LearningSection>

  <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

  <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore"><p class="section-lead">{content.explorePrompt}</p><div class="explore-stack"><div><h3>{labTitle}</h3>{variant === 'ratios' ? <Unit5EquivalentRatioLab /> : <Unit5UnitRateLab />}</div></div><article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map((item)=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p></article></LearningSection>

  <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><p class="practice-goal-copy"><strong>Your goal:</strong> complete six questions. Then move to Check Yourself or choose More Practice for a fresh set.</p><PracticeEngine questions={content.questions} sessionCount={6} /></LearningSection>

  <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. This bank is separate from supported practice and has no hints.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>

  <LearningSection id="apply" eyebrow="PLAY & APPLY" title={gameTitle} icon="🎮" tone="play"><p class="section-lead">Use the math in a short mission that feels different from practice and Check Yourself.</p>{variant === 'ratios' ? <Unit5RecipeRemixGame /> : <Unit5RateRaceGame />}</LearningSection>

  <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
    <div class="summary-card"><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map((item)=><li>{item}</li>)}</ul></div>
    <div class="review-options"><details><summary>Need more help?</summary><ul>{content.support.map((item)=><li>{item}</li>)}</ul></details><details><summary>Want an extra challenge?</summary><ul>{content.extension.map((item)=><li>{item}</li>)}</ul></details></div>
    <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show a strong answer</summary><p>{content.pat.answer}</p></details></article>
    <div class="review-grid">{content.review.map((item)=><label><input type="checkbox" /> {item}</label>)}</div>
    <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>Continue when you are ready.</small></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span class="coming-next">Coming next</span>}</div>
  </LearningSection>
</Grade6LessonFrame>
<style>
.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.summary-card{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.summary-card ul,.worked-example ol,.hands-on-card ol,.review-options ul{padding-left:1.2rem}.overview-grid li,.summary-card li,.worked-example li,.hands-on-card li,.review-options li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.start-note,.practice-goal-copy{margin:1rem 0 0;padding:.75rem .85rem;border-radius:11px;background:#fff8db}.success-box{margin-top:1rem}.three-step-rule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1rem 0}.three-step-rule>div{display:grid;gap:.25rem;padding:.8rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.three-step-rule small{color:#526174}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.applied-concepts{margin-top:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.applied-concepts>summary,.advanced-examples>summary,.review-options summary{cursor:pointer;padding:1rem;font-weight:900}.applied-grid{padding:0 1rem 1rem}.worked-example,.hands-on-card,.pat-card,.relationship-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.example-stack,.explore-stack{display:grid;gap:1rem}.example-answer{margin-top:.8rem;padding:.75rem;border-radius:10px;background:var(--course-soft)}.advanced-examples{margin-top:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.advanced-stack{padding:0 1rem 1rem}.relationship-card{margin-top:1rem}.ratio-scale{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center;margin:.8rem 0}.ratio-scale span{padding:.9rem;border-radius:12px;background:var(--course-soft);font-weight:900;text-align:center}.ratio-arrows{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;text-align:center;color:#526174;font-weight:800}.model-note{padding:.75rem;border-radius:10px;background:#f7f9fc}.mixups,.hands-on-card,.pat-card,.review-options{margin-top:1rem}.review-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.review-options details{border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.pat-card{background:#f8fafc}.next-step small{display:block;margin-top:.2rem;color:#64748b}.coming-next{font-weight:900;color:#64748b}@media(max-width:760px){.overview-grid,.three-step-rule,.review-options,.ratio-scale,.ratio-arrows{grid-template-columns:1fr}}
</style>