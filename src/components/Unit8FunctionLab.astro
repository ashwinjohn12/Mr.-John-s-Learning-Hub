---
interface Props { variant:'investigate'|'represent'|'solve' }
const { variant }=Astro.props;
---
<div class="function-lab" data-unit8-lab={variant}>
 {variant==='investigate'&&<>
  <div class="lab-head"><div><p class="eyebrow">MYSTERY FUNCTION MACHINE</p><h3>Test inputs. Collect evidence. Discover the rule.</h3></div><strong data-mystery-count>0 distinct tests</strong></div>
  <div class="investigation-steps"><span class="active" data-investigate-step="1">1 · Test 3 inputs</span><span data-investigate-step="2">2 · Predict</span><span data-investigate-step="3">3 · Reveal</span></div>
  <div class="machine-flow"><label>INPUT <input type="number" value="2" data-mystery-input/></label><div class="machine-box"><span>?</span><strong>SECRET RULE</strong></div><div class="output-card"><small>OUTPUT</small><strong data-mystery-output>?</strong></div></div>
  <div class="lab-actions"><button type="button" data-run-machine>Run machine →</button><button type="button" class="soft" data-reveal-rule disabled>Reveal rule · investigate first</button><button type="button" class="soft" data-new-machine>New mystery</button></div>
  <div class="evidence-grid"><div><p class="mini-label">EVIDENCE TABLE</p><table><thead><tr><th>Input x</th><th>Output y</th></tr></thead><tbody data-evidence></tbody></table></div><div><p class="mini-label">YOUR RULE TEST</p><label>Predict output for input <strong data-predict-target>6</strong> <input type="number" data-predict-output/></label><button type="button" class="small-btn" data-check-prediction disabled>Check prediction</button><p class="feedback" data-predict-feedback>Collect three different input-output pairs before you predict.</p></div></div>
  <div class="function-check"><p class="mini-label">FUNCTION OR NOT?</p><div class="mini-tables"><button type="button" data-function-case="yes"><strong>Table A</strong><span>1→5 · 2→7 · 3→7 · 1→5</span></button><button type="button" data-function-case="no"><strong>Table B</strong><span>1→5 · 2→7 · 1→9 · 3→11</span></button></div><p class="feedback" data-function-feedback>Choose a table to explain whether it is a function.</p></div>
 </>}

 {variant==='represent'&&<>
  <div class="lab-head"><div><p class="eyebrow">FUNCTION REPRESENTATION STUDIO</p><h3>One relationship. Five connected views.</h3></div><label class="rule-picker">Rule <select data-rule-select><option value="2,1">y = 2x + 1</option><option value="3,2">y = 3x + 2</option><option value="4,-1">y = 4x − 1</option><option value="1,5">y = x + 5</option></select></label></div>
  <p class="studio-tip"><strong>Prediction challenge:</strong> Hide any view, use the others to predict it, then reveal the hidden view to check.</p>
  <div class="representation-studio">
   <article data-view-card="table"><div class="rep-card-head"><p class="mini-label">TABLE OF VALUES</p><button type="button" class="view-toggle" data-toggle-view>Hide this view</button></div><div data-view-content><table><thead><tr><th>x</th><th>y</th></tr></thead><tbody data-rep-table></tbody></table></div></article>
   <article data-view-card="pairs"><div class="rep-card-head"><p class="mini-label">ORDERED PAIRS</p><button type="button" class="view-toggle" data-toggle-view>Hide this view</button></div><div data-view-content><div class="pair-list" data-pairs></div></div></article>
   <article class="graph-card wide-card" data-view-card="graph"><div class="rep-card-head"><p class="mini-label">CARTESIAN GRAPH</p><button type="button" class="view-toggle" data-toggle-view>Hide this view</button></div><div data-view-content><svg viewBox="0 0 500 340" role="img" aria-label="Function graph with labelled x and y axes"><g data-graph-grid></g><g data-graph-points></g></svg></div></article>
   <article class="equation-card" data-view-card="equation"><div class="rep-card-head"><p class="mini-label">ALGEBRAIC EQUATION</p><button type="button" class="view-toggle" data-toggle-view>Hide this view</button></div><div data-view-content><strong data-equation>y = 2x + 1</strong><p>Use the equation to generate every pair.</p></div></article>
   <article class="pattern-card" data-view-card="pattern"><div class="rep-card-head"><p class="mini-label">GROWING PATTERN</p><button type="button" class="view-toggle" data-toggle-view>Hide this view</button></div><div data-view-content><p class="pattern-note">Each step number is x. The number of tiles is y.</p><div class="pattern-steps" data-growing-pattern></div></div></article>
  </div>
  <div class="predict-strip"><label>Predict y when x = <input type="number" value="5" min="0" max="5" data-rep-input/></label><label>Your y <input type="number" data-rep-answer/></label><button type="button" data-rep-check>Check across the views</button></div>
  <p class="feedback" data-rep-feedback>Change the rule and watch every representation update together.</p>
 </>}

 {variant==='solve'&&<>
  <div class="lab-head"><div><p class="eyebrow">FUNCTION DETECTIVE</p><h3>Travel forward to outputs—or work backward to inputs.</h3></div><label class="rule-picker">Situation <select data-scenario><option value="rides">Fair rides</option><option value="taxi">Taxi trip</option><option value="savings">Savings plan</option></select></label></div>
  <div class="scenario-card"><p class="mini-label" data-scenario-label>FAIR RIDES</p><h3 data-scenario-story>$5 per ride plus a $2 entrance fee.</h3><div class="equation-banner" data-scenario-equation>y = 5x + 2</div><div class="variable-key"><span data-x-key>x = number of rides</span><span data-y-key>y = total cost ($)</span></div></div>
  <div class="solve-grid">
   <article><p class="mini-label">FORWARD · INPUT → OUTPUT</p><label><span data-forward-name>number of rides (x)</span><input type="number" value="4" data-forward-input/></label><button type="button" data-forward-run>Find output →</button><p class="feedback" data-forward-feedback>Substitute the input into the function.</p></article>
   <article><p class="mini-label">BACKWARD · OUTPUT → INPUT</p><label><span data-backward-name>total cost ($) (y)</span><input type="number" value="27" data-backward-output/></label><button type="button" data-backward-run>Find input ←</button><p class="feedback" data-backward-feedback>Use inverse operations, then verify.</p></article>
  </div>
  <div class="detective-views"><div class="detective-table"><p class="mini-label">MATCHING PAIRS</p><table><thead><tr><th>x</th><th>y</th></tr></thead><tbody data-solve-table></tbody></table></div><div class="detective-graph"><p class="mini-label">SYNCHRONIZED GRAPH</p><p class="graph-note">The highlighted point is the pair you just solved.</p><svg viewBox="0 0 500 320" role="img" aria-label="Graph of the current function situation"><g data-solve-grid></g><g data-solve-points></g></svg></div></div>
 </>}
</div>

<script>
const labs=document.querySelectorAll<HTMLElement>('[data-unit8-lab]');
labs.forEach(lab=>{
 const variant=lab.dataset.unit8Lab;
 const q=(s:string)=>lab.querySelector<any>(s);
 if(variant==='investigate'){
  const rules=[{a:2,b:3,label:'multiply by 2, then add 3'},{a:3,b:1,label:'multiply by 3, then add 1'},{a:1,b:5,label:'add 5'},{a:4,b:-2,label:'multiply by 4, then subtract 2'},{a:0,b:3,label:'always output 3'}];
  let rule=rules[Math.floor(Math.random()*rules.length)],tests:{x:number,y:number}[]=[],predictionTarget=6,predictionAttempted=false;
  const distinctCount=()=>new Set(tests.map(t=>t.x)).size;
  const setStep=(step:number)=>lab.querySelectorAll<HTMLElement>('[data-investigate-step]').forEach((el,i)=>el.classList.toggle('active',i===step-1));
  const chooseTarget=()=>{const used=new Set(tests.map(t=>t.x));predictionTarget=[6,7,8,9].find(v=>!used.has(v))??10;q('[data-predict-target]').textContent=predictionTarget;};
  const renderEvidence=()=>{
   q('[data-evidence]').innerHTML=tests.map(t=>`<tr><td>${t.x}</td><td>${t.y}</td></tr>`).join('');
   const distinct=distinctCount();q('[data-mystery-count]').textContent=`${distinct} distinct test${distinct===1?'':'s'}`;
   const ready=distinct>=3;q('[data-check-prediction]').disabled=!ready;
   if(ready&&!predictionAttempted){chooseTarget();q('[data-predict-feedback]').innerHTML='<strong>Evidence collected.</strong> Now predict a new output before revealing the rule.';setStep(2);}else if(!ready){q('[data-predict-feedback]').textContent=`Collect ${3-distinct} more different input${3-distinct===1?'':'s'} before you predict.`;setStep(1);}
  };
  const reset=()=>{rule=rules[Math.floor(Math.random()*rules.length)];tests=[];predictionTarget=6;predictionAttempted=false;q('[data-mystery-output]').textContent='?';q('[data-predict-output]').value='';q('[data-predict-target]').textContent='6';q('[data-reveal-rule]').textContent='Reveal rule · investigate first';q('[data-reveal-rule]').disabled=true;q('[data-check-prediction]').disabled=true;renderEvidence();};
  q('[data-run-machine]').addEventListener('click',()=>{const x=Number(q('[data-mystery-input]').value),y=rule.a*x+rule.b;q('[data-mystery-output]').textContent=y;tests.push({x,y});renderEvidence();});
  q('[data-reveal-rule]').addEventListener('click',()=>{if(!predictionAttempted)return;q('[data-reveal-rule]').textContent=`Rule: ${rule.label}`;setStep(3);});
  q('[data-new-machine]').addEventListener('click',reset);
  q('[data-check-prediction]').addEventListener('click',()=>{if(distinctCount()<3)return;predictionAttempted=true;const ans=Number(q('[data-predict-output]').value),actual=rule.a*predictionTarget+rule.b;q('[data-predict-feedback]').innerHTML=ans===actual?`<strong>Matches!</strong> For input ${predictionTarget}, the output is ${actual}. Your evidence is consistent.`:`<strong>Not yet.</strong> Input ${predictionTarget} outputs ${actual}. Compare this with the pattern in your evidence table.`;q('[data-reveal-rule]').disabled=false;q('[data-reveal-rule]').textContent='Reveal rule';setStep(3);});
  lab.querySelectorAll<HTMLButtonElement>('[data-function-case]').forEach(btn=>btn.addEventListener('click',()=>{const yes=btn.dataset.functionCase==='yes';q('[data-function-feedback]').innerHTML=yes?'<strong>Table A is a function.</strong> Input 1 repeats, but it keeps output 5. Different inputs 2 and 3 may both output 7.':'<strong>Table B is not a function.</strong> Input 1 has two different outputs: 5 and 9.';}));
  reset();
 }
 if(variant==='represent'){
  const select=q('[data-rule-select]');let extraPoint:{x:number,y:number}|null=null;
  const left=55,top=20,width=420,height=276,xMin=0,xMax=5,yMin=-2,yMax=20;
  const xPx=(x:number)=>left+((x-xMin)/(xMax-xMin))*width;
  const yPx=(y:number)=>top+((yMax-y)/(yMax-yMin))*height;
  const equationText=(a:number,b:number)=>b===0?`y = ${a===1?'':a}x`:`y = ${a===1?'':a}x ${b<0?'−':'+'} ${Math.abs(b)}`;
  const renderGraphGrid=()=>{
   let html='';for(let x=0;x<=5;x++)html+=`<line class="grid-line" x1="${xPx(x)}" y1="${top}" x2="${xPx(x)}" y2="${top+height}"/><text class="tick" x="${xPx(x)}" y="${top+height+22}" text-anchor="middle">${x}</text>`;
   for(let y=-2;y<=20;y+=2)html+=`<line class="grid-line" x1="${left}" y1="${yPx(y)}" x2="${left+width}" y2="${yPx(y)}"/><text class="tick" x="${left-9}" y="${yPx(y)+4}" text-anchor="end">${y}</text>`;
   html+=`<line class="axis" x1="${left}" y1="${yPx(0)}" x2="${left+width}" y2="${yPx(0)}"/><line class="axis" x1="${xPx(0)}" y1="${top}" x2="${xPx(0)}" y2="${top+height}"/><text class="axis-name" x="${left+width+10}" y="${yPx(0)+5}">x</text><text class="axis-name" x="${xPx(0)+8}" y="${top+4}">y</text>`;q('[data-graph-grid]').innerHTML=html;
  };
  const draw=()=>{
   const [a,b]=select.value.split(',').map(Number);const basePts=Array.from({length:5},(_,x)=>({x,y:a*x+b}));const points=[...basePts];if(extraPoint&&!points.some(p=>p.x===extraPoint!.x))points.push(extraPoint);
   q('[data-rep-table]').innerHTML=points.map(p=>`<tr class="${extraPoint?.x===p.x?'highlight-row':''}"><td>${p.x}</td><td>${p.y}</td></tr>`).join('');
   q('[data-pairs]').innerHTML=points.map(p=>`<span class="${extraPoint?.x===p.x?'highlight-pair':''}">(${p.x}, ${p.y})</span>`).join('');
   q('[data-equation]').textContent=equationText(a,b);
   q('[data-graph-points]').innerHTML=points.filter(p=>p.x>=xMin&&p.x<=xMax&&p.y>=yMin&&p.y<=yMax).map(p=>`<circle class="${extraPoint?.x===p.x?'highlight-point':''}" cx="${xPx(p.x)}" cy="${yPx(p.y)}" r="7"/><text class="point-label" x="${xPx(p.x)+9}" y="${yPx(p.y)-8}">(${p.x},${p.y})</text>`).join('');
   const patternXs=[1,2,3,4];if(extraPoint&&extraPoint.x===5)patternXs.push(5);q('[data-growing-pattern]').innerHTML=patternXs.map(x=>{const y=a*x+b;const count=Math.max(0,Math.min(20,y));return `<div class="pattern-step ${extraPoint?.x===x?'highlight-pattern':''}"><strong>Step ${x}</strong><div class="tiles">${Array.from({length:count},()=>'<span></span>').join('')}</div><small>y = ${y}</small></div>`;}).join('');
  };
  renderGraphGrid();
  lab.querySelectorAll<HTMLButtonElement>('[data-toggle-view]').forEach(btn=>btn.addEventListener('click',()=>{const card=btn.closest<HTMLElement>('[data-view-card]');const content=card?.querySelector<HTMLElement>('[data-view-content]');if(!card||!content)return;content.hidden=!content.hidden;card.classList.toggle('is-hidden',content.hidden);btn.textContent=content.hidden?'Reveal view':'Hide this view';}));
  select.addEventListener('change',()=>{extraPoint=null;q('[data-rep-answer]').value='';draw();q('[data-rep-feedback]').textContent='New rule loaded. The growing pattern, table, pairs, graph, and equation changed together.';});
  q('[data-rep-check]').addEventListener('click',()=>{const [a,b]=select.value.split(',').map(Number),x=Number(q('[data-rep-input]').value),ans=Number(q('[data-rep-answer]').value),y=a*x+b;extraPoint={x,y};draw();q('[data-rep-feedback]').innerHTML=ans===y?`<strong>Correct.</strong> The new pair (${x},${y}) is now highlighted across the table, ordered pairs, graph, and pattern when it fits the display.`:`<strong>Check the connection.</strong> For x=${x}, the rule gives y=${y}. The correct pair is now highlighted across the views.`;});
  draw();
 }
 if(variant==='solve'){
  const scenarios:any={
   rides:{label:'FAIR RIDES',story:'$5 per ride plus a $2 entrance fee.',a:5,b:2,x:'number of rides',y:'total cost ($)',forward:4,backward:27},
   taxi:{label:'TAXI TRIP',story:'$3 per kilometre plus a $5 starting fee.',a:3,b:5,x:'kilometres travelled',y:'fare ($)',forward:6,backward:26},
   savings:{label:'SAVINGS PLAN',story:'Start with $25, then save $10 each week.',a:10,b:25,x:'weeks',y:'total savings ($)',forward:5,backward:95}
  };
  let data=scenarios.rides,highlight:{x:number,y:number}|null=null;
  const graphLeft=55,graphTop=18,graphWidth=420,graphHeight=250,xMax=10;
  const xPx=(x:number)=>graphLeft+(x/xMax)*graphWidth;
  const renderSolveViews=()=>{
   const base=Array.from({length:6},(_,x)=>({x,y:data.a*x+data.b}));const rows=[...base];if(highlight&&!rows.some(p=>Math.abs(p.x-highlight!.x)<0.0001))rows.push(highlight);q('[data-solve-table]').innerHTML=rows.map(p=>`<tr class="${highlight&&Math.abs(p.x-highlight.x)<0.0001?'highlight-row':''}"><td>${Number.isInteger(p.x)?p.x:p.x.toFixed(2)}</td><td>${Number.isInteger(p.y)?p.y:p.y.toFixed(2)}</td></tr>`).join('');
   const rawMax=data.a*xMax+data.b;const yMax=Math.ceil(rawMax/10)*10;const yStep=yMax>80?20:10;const yPx=(y:number)=>graphTop+((yMax-y)/yMax)*graphHeight;let grid='';for(let x=0;x<=10;x++){grid+=`<line class="grid-line" x1="${xPx(x)}" y1="${graphTop}" x2="${xPx(x)}" y2="${graphTop+graphHeight}"/>`;if(x%2===0)grid+=`<text class="tick" x="${xPx(x)}" y="${graphTop+graphHeight+20}" text-anchor="middle">${x}</text>`;}for(let y=0;y<=yMax;y+=yStep)grid+=`<line class="grid-line" x1="${graphLeft}" y1="${yPx(y)}" x2="${graphLeft+graphWidth}" y2="${yPx(y)}"/><text class="tick" x="${graphLeft-8}" y="${yPx(y)+4}" text-anchor="end">${y}</text>`;grid+=`<line class="axis" x1="${graphLeft}" y1="${yPx(0)}" x2="${graphLeft+graphWidth}" y2="${yPx(0)}"/><line class="axis" x1="${graphLeft}" y1="${graphTop}" x2="${graphLeft}" y2="${graphTop+graphHeight}"/><text class="axis-name" x="${graphLeft+graphWidth+8}" y="${yPx(0)+4}">x</text><text class="axis-name" x="${graphLeft+8}" y="${graphTop+4}">y</text>`;q('[data-solve-grid]').innerHTML=grid;
   const pts=Array.from({length:11},(_,x)=>({x,y:data.a*x+data.b}));q('[data-solve-points]').innerHTML=pts.map(p=>`<circle cx="${xPx(p.x)}" cy="${yPx(p.y)}" r="5"/>`).join('')+(highlight&&highlight.x>=0&&highlight.x<=10&&highlight.y>=0&&highlight.y<=yMax?`<circle class="highlight-point" cx="${xPx(highlight.x)}" cy="${yPx(highlight.y)}" r="9"/><text class="point-label" x="${xPx(highlight.x)+10}" y="${yPx(highlight.y)-10}">(${Number.isInteger(highlight.x)?highlight.x:highlight.x.toFixed(2)},${Number.isInteger(highlight.y)?highlight.y:highlight.y.toFixed(2)})</text>`:'');
  };
  const render=()=>{highlight=null;q('[data-scenario-label]').textContent=data.label;q('[data-scenario-story]').textContent=data.story;q('[data-scenario-equation]').textContent=`y = ${data.a}x + ${data.b}`;q('[data-x-key]').textContent=`x = ${data.x}`;q('[data-y-key]').textContent=`y = ${data.y}`;q('[data-forward-name]').textContent=`${data.x} (x)`;q('[data-backward-name]').textContent=`${data.y} (y)`;q('[data-forward-input]').value=data.forward;q('[data-backward-output]').value=data.backward;q('[data-forward-feedback]').textContent='Substitute the input into the function.';q('[data-backward-feedback]').textContent='Use inverse operations, then verify.';renderSolveViews();};
  q('[data-scenario]').addEventListener('change',(e:any)=>{data=scenarios[e.target.value];render();});
  q('[data-forward-run]').addEventListener('click',()=>{const x=Number(q('[data-forward-input]').value),y=data.a*x+data.b;highlight={x,y};q('[data-forward-feedback]').innerHTML=`<strong>${y}</strong>. Substitute: ${data.a}(${x}) + ${data.b} = ${y}. The matching point is highlighted below.`;renderSolveViews();});
  q('[data-backward-run]').addEventListener('click',()=>{const y=Number(q('[data-backward-output]').value),x=(y-data.b)/data.a;highlight={x,y};q('[data-backward-feedback]').innerHTML=Number.isInteger(x)?`<strong>x = ${x}</strong>. Undo +${data.b}, then ÷${data.a}. Check: ${data.a}(${x})+${data.b}=${y}. The point (${x},${y}) is highlighted below.`:`<strong>x = ${x}</strong>. The math works, but think about whether a fractional ${data.x} makes sense in this context. The pair is shown on the graph when it fits the display.`;renderSolveViews();});
  render();
 }
});
</script>
<style>
.function-lab{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1rem}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.lab-head h3{margin:.15rem 0}.lab-head>strong,.rule-picker{padding:.5rem .65rem;border-radius:10px;background:var(--course-soft);font-weight:900}.investigation-steps{display:flex;gap:.45rem;flex-wrap:wrap;margin:.9rem 0}.investigation-steps span{padding:.42rem .6rem;border-radius:999px;background:#eef3f9;color:#64748b;font-size:.78rem;font-weight:900}.investigation-steps span.active{background:var(--course-soft);color:var(--course)}.machine-flow{display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:.8rem;align-items:center;margin:1rem 0}.machine-flow label,.output-card,.machine-box{display:grid;gap:.4rem;padding:1rem;border:1px solid #dbe3ec;border-radius:15px;text-align:center}.machine-flow input,.predict-strip input,.evidence-grid input,.solve-grid input{width:100%;max-width:180px;margin:auto;border:2px solid #ccd6e2;border-radius:10px;padding:.65rem;font:inherit}.machine-box{background:var(--course-soft)}.machine-box span{font-size:2rem}.output-card strong{font-size:1.8rem;color:var(--course)}.lab-actions,.predict-strip{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:.8rem 0}.lab-actions button,.small-btn,.predict-strip button,.solve-grid button{border:0;border-radius:10px;padding:.68rem .9rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.lab-actions .soft{background:#eef3f9;color:#25364f}.lab-actions button:disabled,.small-btn:disabled{opacity:.45;cursor:not-allowed}.evidence-grid,.solve-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem}.evidence-grid>div,.function-check,.representation-studio article,.scenario-card,.solve-grid article,.detective-table,.detective-graph{border:1px solid #dbe3ec;border-radius:14px;padding:.85rem;background:#f9fbfd}.mini-label{font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#64748b}table{width:100%;border-collapse:collapse}th,td{padding:.4rem .5rem;border-bottom:1px solid #e4e9f0;text-align:center}.feedback{padding:.7rem .8rem;border-radius:10px;background:#eef5ff}.mini-tables{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.mini-tables button{display:grid;gap:.3rem;text-align:left;padding:.75rem;border:1px solid #dbe3ec;border-radius:11px;background:#fff;cursor:pointer}.studio-tip{margin:.8rem 0;padding:.7rem .8rem;border-radius:11px;background:#fff8db}.representation-studio{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem}.representation-studio .wide-card{grid-column:span 2}.rep-card-head{display:flex;align-items:center;justify-content:space-between;gap:.6rem;margin-bottom:.55rem}.rep-card-head .mini-label{margin:0}.view-toggle{border:0;border-radius:9px;padding:.4rem .55rem;background:#eef3f9;color:#34465e;font-size:.75rem;font-weight:850;cursor:pointer}.representation-studio article.is-hidden{background:#f5f7fa;border-style:dashed}.pair-list{display:flex;flex-wrap:wrap;gap:.4rem}.pair-list span{padding:.45rem .55rem;border-radius:9px;background:var(--course-soft);font-weight:800}.pair-list span.highlight-pair,.highlight-row{outline:2px solid var(--course);outline-offset:-2px}.equation-card>div[data-view-content]{display:grid;place-items:center;min-height:95px}.equation-card strong{font-size:1.7rem;color:var(--course)}.graph-card svg,.detective-graph svg{width:100%;min-height:300px}.graph-card :global(.grid-line),.detective-graph :global(.grid-line){stroke:#dce4ee;stroke-width:1}.graph-card :global(.axis),.detective-graph :global(.axis){stroke:#334155;stroke-width:2}.graph-card :global(.tick),.detective-graph :global(.tick){font-size:11px;fill:#64748b}.graph-card :global(.axis-name),.detective-graph :global(.axis-name){font-size:14px;font-weight:900;fill:#334155}.graph-card :global(circle),.detective-graph :global(circle){fill:var(--course)}.graph-card :global(.highlight-point),.det