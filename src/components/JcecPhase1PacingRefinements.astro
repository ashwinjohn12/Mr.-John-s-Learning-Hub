<script is:inline>
  (() => {
    const path = window.location.pathname;
    if (!path.includes('/courses/grade-7-science/jabberwocky/phase-1')) return;

    // The simplified five-mission pages contain their own current pacing.
    // Legacy Operation 02–08 routes remain available only as teacher/reference resources.
    const operationMatch = path.match(/\/phase-1\/operation-(\d{2})\/?$/);
    if (!operationMatch || document.getElementById('jcec-legacy-operation-note')) return;

    const map = {
      '02': { mission: 1, title: 'Explore Your Environment', href: '../mission-1/' },
      '03': { mission: 2, title: 'Meet a Native Species', href: '../mission-2/' },
      '04': { mission: 3, title: 'Build the Ecosystem', href: '../mission-3/' },
      '05': { mission: 4, title: 'Watch the Ecosystem Change', href: '../mission-4/' },
      '06': { mission: 4, title: 'Watch the Ecosystem Change', href: '../mission-4/' },
      '07': { mission: 5, title: 'Humans Have Arrived', href: '../mission-5/' },
      '08': { mission: 5, title: 'Humans Have Arrived', href: '../mission-5/' }
    };

    const current = map[operationMatch[1]];
    if (!current) return;

    const anchor = document.querySelector('.mission-question') || document.querySelector('header');
    if (!anchor) return;

    const note = document.createElement('section');
    note.id = 'jcec-legacy-operation-note';
    note.className = 'jcec-legacy-operation-note';
    note.innerHTML = `
      <div>
        <p>ARCHIVED REFERENCE ROUTE</p>
        <strong>Operation ${operationMatch[1]} is preserved for teacher reference.</strong>
        <span>The current student pathway uses Mission ${current.mission} — ${current.title}. This page may contain deeper or older versions of activities, evidence and teacher supports.</span>
      </div>
      <a href="${current.href}">Open current Mission ${current.mission} →</a>`;
    anchor.insertAdjacentElement('afterend', note);
  })();
</script>

<style is:global>
  .jcec-legacy-operation-note{max-width:1120px;margin:1rem auto;padding:.9rem 1rem;border:1px dashed #58707c;border-radius:13px;background:#0b1820;color:#c7d6dc;display:flex;justify-content:space-between;gap:1rem;align-items:center}.jcec-legacy-operation-note div{display:grid;gap:.2rem}.jcec-legacy-operation-note p{margin:0;color:#d9ba76;font:850 .7rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.jcec-legacy-operation-note strong{color:#fff}.jcec-legacy-operation-note span{color:#9eb2bb;font-size:.82rem;line-height:1.45}.jcec-legacy-operation-note a{flex:0 0 auto;padding:.62rem .75rem;border-radius:8px;background:#173b36;color:#b6e9dc!important;text-decoration:none;font-size:.78rem;font-weight:900;white-space:nowrap}@media(max-width:650px){.jcec-legacy-operation-note{display:grid}.jcec-legacy-operation-note a{text-align:center}}
</style>
