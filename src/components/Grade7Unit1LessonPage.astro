---
import Grade7LessonFrame from './Grade7LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import Grade7Unit1Explore from './Grade7Unit1Explore.astro';
import Grade7Unit1Practice from './Grade7Unit1Practice.astro';
import Grade7Unit1Check from './Grade7Unit1Check.astro';
import type { Course,Unit,Topic } from '../data/courses';
import type { LessonSpec } from '../data/grade7Unit1';
import { grade7Unit1ApplySupport } from '../data/grade7Unit1Apply';
interface Props{course:Course;unit:Unit;topic:Topic;lesson:LessonSpec}
const {course,unit,topic,lesson}=Astro.props;
const previousBySlug:Record<string,{title:string;href:string}>={
 'more-patterns-in-division':{title:'Lesson 1.1 · Patterns in Division',href:'../patterns-in-division/'},
 'algebraic-expressions':{title:'Lesson 1.2 · More Patterns in Division',href:'../more-patterns-in-division/'},
 'relationships-in-patterns':{title:'Lesson 1.3 · Algebraic Expressions',href:'../algebraic-expressions/'},
 'patterns-tables':{title:'Lesson 1.4 · Relationships in Patterns',href:'../relationships-in-patterns/'},
 'graphing-relations':{title:'Lesson 1.5 · Patterns and Relationships in Tables',href:'../patterns-tables/'},
 'reading-writing-equations':{title:'Lesson 1.6 · Graphing Relations',href:'../graphing-relations/'},
 'equations-algebra-tiles':{title:'Lesson 1.7 · Reading and Writing Equations',href:'../reading-writing-equations/'}
};
const previous=previousBySlug[lesson.slug];
const warmups:Record<string,{prompt:string;choices:string[];answer:number;success:string;review:string}>={
 'more-patterns-in-division':{prompt:'Which evidence proves that 4,320 is divisible by 6?',choices:['It is even only.','Its digit sum is 9 only.','It is even and its digit sum is divisible by 3.','It ends in 0.'],answer:2,success:'You combined the tests for 2 and 3.',review:'Divisibility by 6 requires both an even number and a digit sum divisible by 3.'},
 'algebraic-expressions':{prompt:'Evaluate 4(3 + 2).',choices:['14','20','24','9'],answer:1,success:'You handled grouping before multiplication.',review:'Calculate inside the parentheses first: 3 + 2 = 5, then 4 × 5 = 20.'},
 'relationships-in-patterns':{prompt:'What comes next: 5, 8, 11, …?',choices:['12','13','14','16'],answer:2,success:'You found the constant change of +3.',review:'Compare consecutive terms: each term is 3 more than the one before.'},
 'patterns-tables':{prompt:'For y = 2x + 3, what is y when x = 4?',choices:['8','9','11','14'],answer:2,success:'You substituted the input into the rule.',review:'Replace x with 4: y = 2(4) + 3 = 11.'},
 'graphing-relations':{prompt:'Which ordered pair represents the table row x = 2, y = 7?',choices:['(7, 2)','(2, 7)','2 + 7','[7, 2]'],answer:1,success:'You kept the input first and output second.',review:'Ordered pairs are written (x, y), so the row becomes (2, 7).'},
 'reading-writing-equations':{prompt:'Which statement says that two quantities have the same value?',choices:['4n + 3','4n + 3 = 27','n − 5','12 > 9'],answer:1,success:'You recognized a complete equality claim.',review:'An equation uses = to state that the expressions on both sides have equal value.'},
 'equations-algebra-tiles':{prompt:'Which operation undoes adding 6?',choices:['Add 6','Subtract 6','Multiply by 6','Divide by 6'],answer:1,success:'You identified the inverse operation.',review:'Subtraction undoes addition, so subtracting 6 isolates a value with +6.'}
};
const warmup=warmups[lesson.slug] ?? warmups['more-patterns-in-division'];
const application=grade7Unit1ApplySupport[lesson.slug];
---
<Grade7LessonFrame {course} {unit} {topic}>
 <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
  <div class="two-grid"><article class="lesson-card"><p class="mini-label">BEFORE YOU START</p><ul>{lesson.prerequisites.map(x=><li>{x}</li>)}</ul></article><article class="lesson-card"><p class="mini-label">BY THE END, I CAN…</p><ul>{lesson.goals.map(x=><li>{x}</li>)}</ul></article></div>
  <div class="lesson-meta"><span><strong>Time:</strong> {lesson.duration}</span><span><strong>Curriculum:</strong> {lesson.outcome}</span></div>
  <details class="pacing-guide"><summary>Suggested two-session plan</summary><p><strong>Session 1:</strong> learn the ideas, complete Explore phases 1–2, and practise questions 1–4. <strong>Session 2:</strong> finish Explore and practice, then complete Check Yourself, Apply, and the exit ticket. Your teacher may choose a shorter route when you are already secure.</p></details>
  <div class="warmup" data-warmup data-answer={warmup.answer} data-success={warmup.success} data-review={warmup.review}><p class="mini-label">QUICK READINESS</p><h3>{warmup.prompt}</h3><p>Choose one answer. This does not count toward your lesson score.</p><fieldset><legend class="sr-only">Warm-up choices</legend><div class="warm-choices">{warmup.choices.map((choice,index)=><label><input type="radio" name={`${lesson.slug}-warmup`} value={index}/><span>{choice}</span></label>)}</div></fieldset><button type="button" data-warmup-check>Check readiness</button><p data-warmup-feedback role="status">Use what you remember before opening a reminder.</p><details><summary>Review a prerequisite</summary><ul>{lesson.prerequisites.map(x=><li>{x}</li>)}</ul></details></div>
 </LearningSection>
 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big ideas" icon="🌎" tone="idea">
  <p class="big-statement">{lesson.promise}</p><div class="idea-grid">{lesson.bigIdeas.map(x=><article><strong>{x.title}</strong><p>{x.body}</p></article>)}</div>
  <div class="reasoning-frame"><strong>Explain with evidence</strong><span><b>Represent</b> the relationship</span><span><b>Calculate</b> carefully</span><span><b>Conclude</b> in context</span></div>
 </LearningSection>
 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
  <p>Open each idea, study the model, and compare it with the common mix-up.</p><div class="understand-grid">{lesson.understand.map((x,i)=><details id={`understand-${i+1}`} open={i===0}><summary><span>{i+1}</span>{x.title}</summary><div><p>{x.body}</p><p class="model"><strong>Model:</strong> {x.model}</p><p class="mistake"><strong>Common mix-up:</strong> {x.mistake}</p></div></details>)}</div>
 </LearningSection>
 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <div class="examples">{lesson.examples.map((x,i)=><details open={i===0}><summary><span>{x.label}</span>{x.question}</summary><ol>{x.steps.map(step=><li>{step}</li>)}</ol><p class="answer"><strong>Conclusion:</strong> {x.answer}</p></details>)}</div>
 </LearningSection>
 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={lesson.vocabulary}/><p class="use-it"><strong>Use it:</strong> Choose two terms and write one sentence that connects them to today’s mathematics.</p></LearningSection>
 <LearningSection id="explore" eyebrow="INVESTIGATE" title={lesson.explore.title} icon="🔬" tone="explore"><Grade7Unit1Explore {lesson}/></LearningSection>
 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>Complete all eight. Check each response immediately, use the hint when needed, and revise until the idea is secure.</p><Grade7Unit1Practice questions={lesson.practice} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>This independent set comes from a separate 30-question bank. It does not repeat the supported-practice questions.</p><Grade7Unit1Check bank={lesson.check} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="apply" eyebrow="PLAY & APPLY" title={lesson.apply.title} icon="🎮" tone="play">
  <div class="application" data-unit-apply><div class="apply-head"><p class="eyebrow">MAKE A DECISION</p><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></div><p class="apply-instruction"><strong>Your mission:</strong> {lesson.apply.instructions}</p>{application&&<div class="apply-resources" aria-label="Application information">{application.resources.map(item=><article><strong>{item.title}</strong><p>{item.body}</p></article>)}</div>}<ol class="task-list">{lesson.apply.tasks.map((task,i)=><li><label><span><b>Task {i+1}</b>{task}</span><textarea rows="3" data-task-response aria-label={`Evidence for task ${i+1}`} placeholder="Show the calculation, model, or reasoning you used."></textarea></label></li>)}</ol>{application&&<fieldset class="apply-checkpoints"><legend>Mathematical checkpoints</legend>{application.checks.map((check,i)=><div data-apply-checkpoint data-answer={check.answer} data-feedback={check.feedback}><strong>{i+1}. {check.prompt}</strong>{check.choices.map((choice,j)=><label><input type="radio" name={`${lesson.slug}-apply-check-${i}`} value={j}/>{choice}</label>)}<p data-checkpoint-status role="status">Not checked yet.</p></div>)}</fieldset>}<label class="explanation">Your mathematical recommendation<textarea rows="6" data-apply-text placeholder="My decision is… My representation shows… Therefore…"></textarea></label><button type="button" data-apply-check>Check mathematics and completion evidence</button><p data-apply-status role="status">Complete each task, pass both checkpoints, and explain your decision.</p><details><summary>Success checklist</summary><ul>{lesson.apply.success.map(x=><li>{x}</li>)}</ul></details></div>
 </LearningSection>
 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
  <div class="review-summary"><article><p class="mini-label">RETRIEVE</p><ul>{lesson.bigIdeas.map(x=><li>{x.title}</li>)}</ul></article><article><p class="mini-label">BE READY TO EXPLAIN</p><ul>{lesson.readiness.map(x=><li>{x}</li>)}</ul></article></div>
  <div class="exit-ticket" data-exit-ticket><p class="eyebrow">3-QUESTION EXIT TICKET</p><p>Answer all three without hints, then submit together.</p>{lesson.exit.map((item,index)=><fieldset data-exit-item data-answer={item.answer} data-feedback={item.feedback}><legend>{index+1}. {item.prompt}</legend><div>{item.choices.map((choice,i)=><label><input type="radio" name={`${lesson.slug}-exit-${index}`} value={i}/>{choice}</label>)}</div><p data-exit-reveal hidden></p></fieldset>)}<button type="button" data-exit-submit>Submit exit ticket</button><p data-exit-result role="status">No answers submitted.</p><div class="exit-routes" data-exit-routes hidden><a href="#understand">Review lesson ideas</a><a href="#practise">Return to supported practice</a></div></div>
  <div class="lesson-nav">{previous&&<a class="next-step previous-step" href={previous.href}><div><p class="eyebrow">PREVIOUS</p><strong>{previous.title}</strong></div><b>← Go back</b></a>}{lesson.next&&<a class="next-step" href={lesson.next.href}><div><p class="eyebrow">NEXT</p><strong>{lesson.next.title}</strong><span>{lesson.next.body}</span></div><b>Continue →</b></a>}</div>
 </LearningSection>
</Grade7LessonFrame>
<script>
 document.querySelectorAll<HTMLElement>('[data-warmup]').forEach(root=>root.querySelector('[data-warmup-check]')?.addEventListener('click',()=>{const chosen=root.querySelector<HTMLInputElement>('input:checked'),feedback=root.querySelector<HTMLElement>('[data-warmup-feedback]');if(!chosen){if(feedback)feedback.textContent='Choose one answer first.';root.querySelector<HTMLInputElement>('input')?.focus();return}const correct=Number(chosen.value)===Number(root.dataset.answer);if(feedback)feedback.innerHTML=`<strong>${correct?'Ready.':'Review first.'}</strong> ${correct?root.dataset.success:root.dataset.review}`;}));
 document.querySelectorAll<HTMLElement>('[data-unit-apply]').forEach(root=>root.querySelector('[data-apply-check]')?.addEventListener('click',()=>{const tasks=[...root.querySelectorAll<HTMLTextAreaElement>('[data-task-response]')],incomplete=tasks.map((task,index)=>task.value.trim().length>=20?null:index+1).filter(Boolean),checkpoints=[...root.querySelectorAll<HTMLElement>('[data-apply-checkpoint]')],failed:number[]=[];checkpoints.forEach((item,index)=>{const selected=item.querySelector<HTMLInputElement>('input:checked'),ok=!!selected&&Number(selected.value)===Number(item.dataset.answer);if(!ok)failed.push(index+1);const checkpointStatus=item.querySelector<HTMLElement>('[data-checkpoint-status]');if(checkpointStatus)checkpointStatus.innerHTML=selected?`<strong>${ok?'Correct.':'Revise.'}</strong> ${item.dataset.feedback}`:'Choose an answer for this checkpoint.'});const text=(root.querySelector<HTMLTextAreaElement>('[data-apply-text]')?.value||'').trim(),status=root.querySelector<HTMLElement>('[data-apply-status]'),evidence=text.length>=80&&/(because|evidence|shows|therefore|so|since)/i.test(text);if(status)status.innerHTML=incomplete.length?`<strong>Tasks needing evidence: ${incomplete.join(', ')}.</strong> Show a calculation, model, or mathematical reason.`:failed.length?`<strong>Checkpoint${failed.length>1?'s':''} ${failed.join(', ')} need revision.</strong> Use the feedback, correct the mathematics, and check again.`:evidence?'<strong>Application mathematics and evidence complete.</strong> Use the success checklist for a final self-review or ask your teacher to review your reasoning.':'<strong>Your task evidence and checkpoints are complete.</strong> Strengthen the final recommendation with a because, shows, since, so, evidence, or therefore statement.';if(incomplete.length)tasks[Number(incomplete[0])-1]?.focus();else if(failed.length)checkpoints[failed[0]-1]?.querySelector<HTMLInputElement>('input')?.focus();else if(!evidence)root.querySelector<HTMLTextAreaElement>('[data-apply-text]')?.focus()}));
 document.querySelectorAll<HTMLElement>('[data-exit-ticket]').forEach(root=>root.querySelector('[data-exit-submit]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-exit-item]')],firstUnanswered=items.find(x=>!x.querySelector('input:checked'));if(firstUnanswered){const result=root.querySelector('[data-exit-result]');if(result)result.textContent='Answer all three before submitting.';firstUnanswered.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach(item=>{const ok=Number(item.querySelector<HTMLInputElement>('input:checked')?.value)===Number(item.dataset.answer);if(ok)score++;item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);const reveal=item.querySelector<HTMLElement>('[data-exit-reveal]');if(reveal){reveal.hidden=false;reveal.innerHTML=`<strong>${ok?'Correct.':'Review:'}</strong> ${item.dataset.feedback||''}`}});const result=root.querySelector('[data-exit-result]');if(result)result.innerHTML=`<strong>${score} / 3.</strong> ${score>=2?'Use this result with your Check Yourself score to decide whether to continue.':'Review the lesson ideas and supported practice, then try again.'}`;const routes=root.querySelector<HTMLElement>('[data-exit-routes]');if(routes)routes.hidden=score>=2}));
</script>
<style>
.two-grid,.idea-grid,.review-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.lesson-card,.idea-grid article,.review-summary article{padding:1rem;border:1px solid #e0e7ef;border-radius:14px;background:#fff}.idea-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.idea-grid article{border-top:4px solid #9a6700}.idea-grid p{color:#526174}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.lesson-card ul,.review-summary ul{padding-left:1.2rem}.lesson-meta{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1rem;padding:.8rem 1rem;border-radius:12px;background:#f3f7fb}.warmup{margin-top:1rem;padding:1rem;border:1px solid #e5d598;border-radius:14px;background:#fffdf5}.warmup h3{margin:.15rem 0}.warm-options{display:grid;gap:.45rem}.warm-options details{padding:.55rem .7rem;border-radius:9px;background:#fff}.warm-options summary{font-weight:750;cursor:pointer}.big-statement{font:800 clamp(1.2rem,3vw,1.65rem) 'Manrope';max-width:760px}.reasoning-frame{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:.5rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:13px;background:#fff7d6}.reasoning-frame span{display:grid}.understand-grid,.examples{display:grid;gap:.75rem}.understand-grid details,.examples details{border:1px solid #dbe4ef;border-radius:13px;background:#fff;overflow:hidden}.understand-grid summary,.examples summary{display:flex;gap:.65rem;padding:.85rem 1rem;font-weight:850;cursor:pointer}.understand-grid summary span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:99px;background:#2457c5;color:#fff}.understand-grid details>div,.examples details>ol,.examples details>.answer{margin:.2rem 1rem 1rem}.model,.answer{padding:.7rem;border-radius:9px;background:#eef6ff}.mistake{padding:.7rem;border-radius:9px;background:#fff5ed}.examples summary{display:grid}.examples summary span{font-size:.75rem;letter-spacing:.08em;color:#2457c5}.use-it{padding:.8rem;border-radius:10px;background:#f8f5ff}.application{border-radius:16px;overflow:hidden;background:#21133d;color:#fff}.apply-head{padding:1.2rem;background:linear-gradient(135deg,#21133d,#493173)}.apply-head h3{margin:.15rem 0;font-size:1.55rem}.apply-instruction{margin:1rem}.task-list{display:grid;gap:.5rem;padding:0 1rem;list-style:none}.task-list label{display:flex;gap:.65rem;padding:.7rem;border-radius:10px;background:#ffffff12}.task-list span{display:grid}.explanation{display:grid;gap:.4rem;margin:1rem;font-weight:800}.explanation textarea{font:inherit;padding:.7rem;border:1px solid #c9c2d6;border-radius:9px}.application button{margin:0 1rem;border:0;border-radius:9px;padding:.65rem .85rem;background:#f4c95d;color:#21133d;font-weight:900}.application [data-apply-status],.application details{margin:1rem;padding:.7rem;border-radius:9px;background:#ffffff12}.exit-ticket{margin-top:1rem;padding:1rem;border:1px solid #c8e7d0;border-radius:14px;background:#f7fcf8}.exit-ticket fieldset{border:0;border-top:1px solid #dce9df;padding:.8rem 0}.exit-ticket legend{font-weight:850}.exit-ticket fieldset>div{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;margin-top:.5rem}.exit-ticket label{display:flex;gap:.45rem;padding:.55rem;border-radius:8px;background:#fff}.exit-ticket fieldset.correct{background:#effaf2}.exit-ticket fieldset.incorrect{background:#fff7ed}.exit-ticket [data-exit-reveal],.exit-ticket [data-exit-result]{padding:.6rem;background:#fff;border-radius:8px}.exit-ticket button{border:0;border-radius:9px;background:#2b6e3f;color:#fff;padding:.65rem .85rem;font-weight:850}.next-step{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:14px;background:linear-gradient(135deg,#eef5ff,#f8f5ff);text-decoration:none;color:inherit}.next-step>div{display:grid}.next-step span{color:#526174}.next-step>b{color:#2457c5;white-space:nowrap}.application button:focus-visible,.application input:focus-visible,.application textarea:focus-visible,.exit-ticket button:focus-visible,.exit-ticket input:focus-visible,.next-step:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}@media(max-width:820px){.idea-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.two-grid,.idea-grid,.review-summary,.reasoning-frame,.lesson-meta,.exit-ticket fieldset>div{grid-template-columns:1fr}.next-step{align-items:flex-start;flex-direction:column}}
.task-list{gap:.7rem}.task-list label{display:grid;gap:.6rem;padding:.8rem}.task-list textarea{font:inherit;padding:.7rem;border:1px solid #c9c2d6;border-radius:9px}.application input:focus-visible{outline:0}.lesson-nav{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:.7rem}.previous-step{background:#f5f7fa}.previous-step>b{order:-1}.warmup fieldset{border:0;margin:0;padding:0}.warm-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}.warm-choices label{display:flex;gap:.5rem;padding:.6rem;border:1px solid #e1d39b;border-radius:9px;background:#fff}.warmup button{margin-top:.7rem;border:0;border-radius:9px;padding:.6rem .8rem;background:#7a5b00;color:#fff;font-weight:850}.warmup [data-warmup-feedback]{padding:.6rem;border-radius:8px;background:#fff}.warmup button:focus-visible,.warmup input:focus-visible{outline:3px solid #2563eb;outline-offset:2px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.lesson-nav,.warm-choices{grid-template-columns:1fr}}
.pacing-guide{margin-top:.7rem;padding:.7rem .9rem;border:1px solid #dbe4ef;border-radius:11px;background:#fff}.pacing-guide summary{font-weight:850;cursor:pointer}.pacing-guide p{margin-bottom:0}.apply-resources{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:1rem}.apply-resources article{padding:.8rem;border-radius:10px;background:#fff;color:#21133d}.apply-resources p{margin:.35rem 0 0}.apply-checkpoints{display:grid;gap:.8rem;margin:1rem;padding:1rem;border:1px solid #ffffff38;border-radius:11px}.apply-checkpoints legend{font-weight:900}.apply-checkpoints>div{display:grid;gap:.4rem}.apply-checkpoints label{padding:.45rem;border-radius:8px;background:#ffffff12}.apply-checkpoints p{margin:0;padding:.5rem;border-radius:7px;background:#ffffff12}.exit-routes{display:flex;gap:.5rem;flex-wrap:wrap}.exit-routes a{padding:.55rem .7rem;border-radius:8px;background:#fff;color:#205d34;font-weight:800}@media(max-width:700px){.apply-resources{grid-template-columns:1fr}}
</style>
