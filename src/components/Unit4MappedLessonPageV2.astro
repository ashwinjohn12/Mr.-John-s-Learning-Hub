---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit4MultiplierLab from './Unit4MultiplierLab.astro';
import Unit4FairShareLab from './Unit4FairShareLab.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent; variant: 'multiply' | 'share' }
const { course, unit, topic, content, variant } = Astro.props;
const base = import.meta.env.BASE_URL;
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const coreExamples = content.examples.slice(0,2);
const advancedExamples = content.examples.slice(2);

const multiply = variant === 'multiply';
const routine = multiply
  ? [['1','Interpret it','Groups-of or part-of?'],['2','Model it','Show the fraction units or split the quantity.'],['3','Calculate & check','Simplify and compare with your prediction.']]
  : [['1','Identify the sharing','What total is shared? How many equal shares?'],['2','Write the quotient','total ÷ shares = numerator/denominator.'],['3','Choose the best form','Fraction, mixed number, or decimal?']];
const decisions = multiply
  ? [['Natural number first?','Think repeated groups of the fraction.'],['Fraction of a quantity?','Divide by the denominator, then take the numerator number of parts.'],['Need an error check?','Compare the fractional factor with 1 before calculating.']]
  : [['Food or visual pieces?','A fraction or mixed number often shows the share clearly.'],['Money or metric measurement?','A decimal may be more practical.'],['Repeating decimal?','The fraction may be the clearest exact form.']];
const flow = multiply ? ['2/5 + 2/5 + 2/5','3 × 2/5','6/5 = 1 1/5'] : ['5 ÷ 4','5/4','1 1/4 = 1.25'];
const snapshot = multiply ? ['4 × 2/5','8/5','2/5 × 4'] : ['total quantity','÷ number of shares','numerator/denominator'];
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} hookWidth="210px">

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{content.goals.map(goal=><li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <div class="student-path"><p class="mini-label">A GOOD WAY TO WORK THROUGH THIS LESSON</p><div class="path-steps"><div><strong>1 · Learn</strong><span>Big Ideas → Understand → Examples</span></div><div><strong>2 · Explore</strong><span>Vocabulary → {multiply ? 'Fraction Multiplier Lab → counters' : 'Fair Share Studio → paper models'}</span></div><div><strong>3 · Show it</strong><span>Practise → Check Yourself → Apply → Review</span></div></div><p class="path-note"><strong>Working on your own?</strong> Stop after Explore if you need a break. Return to Practice and Check Yourself when you are ready.</p></div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item=><li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
        <div class="three-step-rule">{routine.map(row=><div><span>{row[0]}</span><strong>{row[1]}</strong><small>{row[2]}</small></div>)}</div>
        <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,i)=><div><span class="concept-number">{String(i+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
        <article class="meaning-model">
          <p class="eyebrow">{multiply ? 'VISUAL MODEL · GROUPS OF A FRACTION' : 'VISUAL MODEL · ONE SHARE, MANY FORMS'}</p>
          <h3>{multiply ? 'The number of pieces changes; the piece size does not' : 'A fraction is a division statement'}</h3>
          <p>{multiply ? 'Three groups of 2/5 can be read as repeated addition. Every piece is still a fifth.' : 'Five pizzas shared among four families can be described with division, an improper fraction, a mixed number, or a decimal.'}</p>
          <div class="visual-flow">{flow.map(item=><span>{item}</span>)}</div>
          <p class="model-note"><strong>Why this matters:</strong> {multiply ? 'The denominator stays 5 because the units are still fifths. Only the count of fifths changes.' : 'The amount does not change when the representation changes. Context helps decide which form communicates the answer best.'}</p>
        </article>
        <article class="decision-card"><p class="eyebrow">QUICK DECISION GUIDE</p><h3>{multiply ? 'Which multiplication meaning fits?' : 'How should I represent the share?'}</h3><div class="decision-steps">{decisions.map(row=><div><strong>{row[0]}</strong><span>{row[1]}</span></div>)}</div></article>
        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
        <p class="section-lead">{multiply ? 'Start with repeated groups and fraction-of-a-quantity. Open the next examples when you are ready for prediction, division, and multi-step reasoning.' : 'Start with one whole and several wholes being shared. Open the next examples when you are ready to connect exact fractions, decimals, money, and complete expressions.'}</p>
        <div class="example-stack">{coreExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
        {advancedExamples.length > 0 && <details class="advanced-examples"><summary>{multiply ? 'Ready for the next level? Open Examples 3–6' : 'Ready for more representations? Open Examples 3–6'}</summary><div class="example-stack advanced-stack">{advancedExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>}
        <article class="snapshot-card"><p class="eyebrow">STRATEGY SNAPSHOT</p><h3>{multiply ? 'Same product, different model' : 'Keep the order straight'}</h3><div class="visual-flow">{snapshot.map(item=><span>{item}</span>)}</div><p>{multiply ? 'The commutative property gives the same product, but “four groups of 2/5” and “two-fifths of 4” tell different stories and can use different diagrams.' : 'For 7 items shared among 4 people, write 7 ÷ 4 = 7/4. Reversing the numbers changes the meaning of the share.'}</p></article>
      </LearningSection>

      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack"><div><h3>{multiply ? 'Fraction Multiplier Lab' : 'Fair Share Studio'}</h3><p>{multiply ? 'Work from A to D: groups, part-of, product size, then division.' : 'Work from A to D: share, compare methods, translate, then choose the best representation.'}</p>{multiply && <Unit4MultiplierLab />}{!multiply && <Unit4FairShareLab />}</div></div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> {multiply ? 'Use counters, paper strips, or a hand-drawn number line. Focus on what the multiplication means before writing a rule.' : 'Rectangles and strips are easy to partition accurately. Label the total and number of shares before drawing.'}</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={content.questions} /></LearningSection>
      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. There are no Practice hints here. Choose <strong>New set</strong> for another mix.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>
      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map(task=><li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map(item=><li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map(item=><label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>{content.next.status === 'planned' ? 'This lesson is coming soon. Use the checklist above to decide what you want to practise again first.' : 'Continue when you are ready.'}</small></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span class="coming-next">Coming soon</span>}</div>
      </LearningSection>
 </Grade6LessonFrame>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft,#eef4ff);line-height:1.55}.hook-card>div{display:grid;align-content:start;gap:.2rem}.hook-card small{display:block;max-width:210px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.wrap-grid ul,.worked-example ol,.hands-on-card ol,.lesson-challenge ol{padding-left:1.2rem}.overview-grid li,.wrap-grid li,.worked-example li,.hands-on-card li,.lesson-challenge li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.student-path{margin-top:1rem;padding:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#fff}.path-steps,.three-step-rule,.decision-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.path-steps>div,.three-step-rule>div,.decision-steps>div{display:grid;gap:.25rem;padding:.8rem;border-radius:12px;background:#f7f9fc}.path-steps strong,.three-step-rule strong,.decision-steps strong{font-weight:900}.path-steps span,.three-step-rule small,.decision-steps span{color:#526174;line-height:1.45}.path-note{margin:.8rem 0 0;padding:.7rem;border-radius:10px;background:#fff8db}.success-box{margin-top:1rem}.three-step-rule{margin:1rem 0}.three-step-rule>div{border:1px solid #dfe5ee;background:#fff}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.mixups{margin-top:1.2rem}.example-stack,.explore-stack{display:grid;gap:1rem}.worked-example,.hands-on-card,.pat-card,.meaning-model,.snapshot-card,.decision-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.worked-example h3,.hands-on-card h3,.meaning-model h3,.snapshot-card h3,.decision-card h3{margin:.25rem 0 .75rem}.example-answer{padding:.7rem;border-radius:10px;background:#f2f7ff}.advanced-examples{margin-top:1rem;border:1px solid #dce5ef;border-radius:14px;padding:.8rem;background:#fafcff}.advanced-examples>summary{cursor:pointer;font-weight:900}.advanced-stack{margin-top:.8rem}.meaning-model,.snapshot-card,.decision-card{margin-top:1rem}.visual-flow{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;margin:1rem 0}.visual-flow span{padding:.7rem .9rem;border:1px solid #b9c9dc;border-radius:10px;background:#f7fbff;font-weight:900}.visual-flow span+span::before{content:'→';margin-right:.7rem;color:#60758d}.model-note,.home-note{padding:.7rem;border-radius:10px;background:#fff8db}.misconception{margin:.45rem 0;border:1px solid #e2e8f0;border-radius:12px;padding:.65rem .8rem;background:#fff}.misconception summary{cursor:pointer;font-weight:850}.lesson-challenge{display:grid;gap:.8rem}.pat-card{margin-top:1rem}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:1rem 0}.review-grid label{padding:.7rem;border:1px solid #e2e8f0;border-radius:10px;background:#fff}.next-step{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1rem;padding:1rem;border-radius:14px;background:#f5f7fa}.next-step>div{display:grid;gap:.2rem}.next-step small{color:#526174}.coming-next{font-weight:900;color:#66778b}@media(max-width:760px){.hook-card,.overview-grid,.wrap-grid,.path-steps,.three-step-rule,.decision-steps,.review-grid{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.next-step{align-items:flex-start;flex-direction:column}}
</style>
