<section class="tess-builder" data-tess-builder>
  <div class="builder-head"><div><p>DESIGN LAB</p><h4>Tessellation Builder</h4></div><span data-status aria-live="polite">No gaps or overlaps ✓</span></div>
  <p>Choose a tile, adjust the spacing, and decide when the pattern is a tessellation.</p>
  <div class="builder-layout">
    <svg data-canvas viewBox="0 0 600 360" role="img" aria-label="A repeating pattern made from congruent tiles"></svg>
    <div class="builder-controls"><fieldset><legend>Base tile</legend><label><input type="radio" name="tile-shape" value="square" checked /> Square</label><label><input type="radio" name="tile-shape" value="triangle" /> Triangle</label><label><input type="radio" name="tile-shape" value="hexagon" /> Hexagon</label></fieldset><label>Spacing <strong data-gap-output>0</strong><input data-gap type="range" min="-12" max="18" value="0" /></label><label>Colour pattern<select data-colour><option value="alternating">Alternating</option><option value="rows">Rows</option><option value="single">Single colour</option></select></label><button type="button" data-random>Surprise me</button><div class="builder-note"><strong data-classification>Tessellation</strong><span data-explain>Congruent tiles cover the plane with no gaps or overlaps.</span></div></div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-tess-builder]').forEach(builder=>{const svg=builder.querySelector<SVGSVGElement>('[data-canvas]')!,gapInput=builder.querySelector<HTMLInputElement>('[data-gap]')!,colour=builder.querySelector<HTMLSelectElement>('[data-colour]')!;const colors=['#2471c8','#ffb703'];const fill=(r:number,c:number)=>colour.value==='single'?colors[0]:colour.value==='rows'?colors[r%2]:colors[(r+c)%2];const update=()=>{const shape=(builder.querySelector('input[name="tile-shape"]:checked') as HTMLInputElement).value,gap=Number(gapInput.value);let html='<rect width="600" height="360" fill="#f8fbff"/>';if(shape==='square'){const size=60,step=size+gap;for(let r=-1;r<9;r++)for(let c=-1;c<12;c++)html+=`<rect x="${c*step}" y="${r*step}" width="${size}" height="${size}" fill="${fill(r,c)}" stroke="#153e70"/>`}else if(shape==='triangle'){const side=70,h=60.6,step=side+gap;for(let r=-1;r<8;r++)for(let c=-1;c<12;c++){const x=c*step/2,y=r*(h+gap);const up=(r+c)%2===0;html+=`<polygon points="${up?`${x},${y+h} ${x+side/2},${y} ${x+side},${y+h}`:`${x},${y} ${x+side},${y} ${x+side/2},${y+h}`}" fill="${fill(r,c)}" stroke="#153e70"/>`}}else{const s=38,h=Math.sqrt(3)*s,stepX=1.5*s+gap,stepY=h+gap;for(let c=-1;c<13;c++)for(let r=-1;r<9;r++){const x=c*stepX,y=r*stepY+(c%2?h/2:0);html+=`<polygon points="${x+s},${y} ${x+1.5*s},${y+h/2} ${x+s},${y+h} ${x},${y+h} ${x-.5*s},${y+h/2} ${x},${y}" fill="${fill(r,c)}" stroke="#153e70"/>`}}svg.innerHTML=html;builder.querySelector('[data-gap-output]')!.textContent=String(gap);const status=gap===0?'No gaps or overlaps ✓':gap>0?'Gaps appear':'Tiles overlap';builder.querySelector('[data-status]')!.textContent=status;builder.querySelector('[data-classification]')!.textContent=gap===0?'Tessellation':'Not a tessellation';builder.querySelector('[data-explain]')!.textContent=gap===0?'Congruent tiles cover the plane with no gaps or overlaps.':gap>0?'The uncovered spaces mean the plane is not fully tiled.':'The tiles cover parts of each other, so this is not a tessellation.'};builder.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',update));builder.querySelector('[data-random]')!.addEventListener('click',()=>{const shapes=['square','triangle','hexagon'];(builder.querySelector(`input[value="${shapes[Math.floor(Math.random()*3)]}"]`) as HTMLInputElement).checked=true;gapInput.value=String([-8,0,0,6,12][Math.floor(Math.random()*5)]);colour.value=['alternating','rows','single'][Math.floor(Math.random()*3)];update()});update()});
</script>
<style>
.tess-builder{border:1px solid #d7e1ee;border-radius:18px;padding:1rem;background:#fff}.builder-head{display:flex;justify-content:space-between;gap:1rem}.builder-head p{margin:0;font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.builder-head h4{margin:.2rem 0}.builder-head>span{height:max-content;padding:.45rem .65rem;border-radius:999px;background:#edf9f0;color:#24623b;font-weight:800}.builder-layout{display:grid;grid-template-columns:1.4fr .6fr;gap:1rem}.builder-layout svg{width:100%;border:1px solid #dce4ed;border-radius:14px}.builder-controls{display:grid;gap:.8rem}.builder-controls fieldset{display:grid;gap:.35rem;border:1px solid #dce4ed;border-radius:10px}.builder-controls>label{display:grid;gap:.35rem;font-weight:800}.builder-controls button{border:1px solid #174ea6;border-radius:9px;padding:.65rem;background:#174ea6;color:#fff;font-weight:800}.builder-note{display:grid;gap:.25rem;padding:.75rem;border-radius:10px;background:#f5f7fa}@media(max-width:760px){.builder-layout{grid-template-columns:1fr}.builder-head{display:grid}}
</style>
