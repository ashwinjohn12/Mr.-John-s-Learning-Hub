ointer;font-weight:850}.error-work{white-space:pre-wrap;font:800 1.05rem/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;padding:.8rem;border-radius:12px;background:#f7f9fc;border:1px solid #e2e8f0}.feedback{min-height:1.5rem;margin:.65rem 0 0;font-weight:750}.feedback.good{color:#17633b}.feedback.try{color:#8a4b08}.practice-bridge{border:2px solid #abc6e6;background:#f4f9ff}.practice-bridge ol{padding-left:1.2rem}.practice-bridge li{margin:.4rem 0}.paper-check{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin:.75rem 0}.paper-check code,.paper-check strong{padding:.55rem .7rem;border-radius:9px;background:#fff;border:1px solid #d3deea;font-size:1.05rem}@media(max-width:700px){.mobile-cue{display:inline}.control-row button,.choice-row button{width:100%;text-align:left}.dock-wrap{padding:.45rem}.place-grid{grid-template-columns:repeat(7,78px);min-width:546px}.number-line{grid-template-columns:30px 546px;min-width:576px}.place-cell{min-height:52px;font-size:1.15rem}.place-head span{font-size:.66rem}}
</style>
