<section class="decimal-lab" data-decimal-lab>
  <div class="lab-head">
    <p class="eyebrow">DECIMAL ALIGNMENT LAB</p>
    <h3>Match the place-value units before you calculate</h3>
    <p>Work from A to D. In every part, ask the same question: <strong>what does each digit represent?</strong></p>
  </div>

  <article class="lab-part">
    <div class="part-tag">A · PLACE-VALUE DOCK</div>
    <h4>Dock the second number in the correct place-value columns</h4>
    <p class="prompt" data-align-prompt></p>
    <p class="micro-note">Use the <strong>decimal-point column</strong> as your landmark. When the decimal points match, ones are under ones, tenths are under tenths, and so on. <span class="mobile-cue">On a small screen, swipe the grid sideways to see every column.</span></p>

    <div class="dock-wrap" aria-label="Place-value alignment board">
      <div class="place-grid place-head" aria-hidden="true">
        <span>Tens</span><span>Ones</span><span>·</span><span>Tenths</span><span>Hundredths</span><span>Thousandths</span><span>Ten-thousandths</span>
      </div>
      <div class="number-line">
        <span class="operation-space" aria-hidden="true"></span>
        <div class="place-grid" data-align-top></div>
      </div>
      <div class="number-line">
        <span class="operation" data-align-op></span>
        <div class="place-grid movable" data-align-bottom></div>
      </div>
    </div>

    <div class="control-row">
      <button type="button" data-shift-left>← Shift left</button>
      <button type="button" data-check-align>Check my alignment</button>
      <button type="button" data-shift-right>Shift right →</button>
    </div>
    <details class="hint-box"><summary>Need a hint?</summary><p>Ignore the last digits. Find the decimal point in each number and move the second number until both decimal points are in the same vertical column.</p></details>
    <p class="feedback" data-align-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-align>New alignment</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">B · ZERO PLACEHOLDER TEST</div>
    <h4>Does the value change?</h4>
    <p class="prompt" data-zero-prompt></p>
    <div class="choice-row">
      <button type="button" data-zero-answer="same">Same value</button>
      <button type="button" data-zero-answer="different">Different value</button>
    </div>
    <p class="feedback" data-zero-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-zero>New zero test</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">C · DECIMAL ERROR DETECTIVE</div>
    <h4>Find the first place-value mistake</h4>
    <div class="error-work" data-error-work></div>
    <p class="prompt" data-error-prompt></p>
    <div class="choice-row" data-error-choices></div>
    <p class="feedback" data-error-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-error>New error</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">D · SCALE CONNECTION</div>
    <h4>Predict the decimal answer from a familiar calculation</h4>
    <p class="prompt" data-scale-prompt></p>
    <div class="choice-row" data-scale-choices></div>
    <p class="feedback" data-scale-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-scale>New scale challenge</button>
  </article>

  <article class="practice-bridge">
    <p class="eyebrow">READY FOR PRACTICE?</p>
    <h4>Move the lab thinking onto paper</h4>
    <p>Before you leave Explore, set up <strong>6.2 + 0.47</strong> on paper. Do these three things:</p>
    <ol>
      <li>Estimate the answer first. It should be close to 7.</li>
      <li>Rename 6.2 if a placeholder zero helps you see the columns.</li>
      <li>Line up equal place-value units before calculating.</li>
    </ol>
    <details>
      <summary>Check my setup</summary>
      <div class="paper-check"><code>6.20 + 0.47</code><span>→</span><strong>6.67</strong></div>
      <p>If your setup matches, you are ready for supported Practice. If not, try Part A and Part B once more before moving on.</p>
    </details>
  </article>
</section>

<script>
  const root = document.querySelector('[data-decimal-lab]');
  if (root) {
    const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
    const shuffle = (arr) => [...arr].sort(() => Math.random() - .5);
    const placeNames = ['tens', 'ones', 'decimal point', 'tenths', 'hundredths', 'thousandths', 'ten-thousandths'];

    const alignBank = [
      { a: '3.4', b: '0.056', op: '+', result: '3.456' },
      { a: '7.3', b: '0.845', op: '−', result: '6.455' },
      { a: '5.8', b: '0.47', op: '+', result: '6.27' },
      { a: '6.25', b: '0.8', op: '+', result: '7.05' }
    ];

    const canonicalCells = (text) => {
      const [whole, fraction = ''] = text.split('.');
      const cells = Array(7).fill('');
      const wholeDigits = whole.split('');
      cells[1] = wholeDigits[wholeDigits.length - 1] || '';
      cells[0] = wholeDigits[wholeDigits.length - 2] || '';
      cells[2] = '.';
      for (let i = 0; i < Math.min(4, fraction.length); i++) cells[3 + i] = fraction[i];
      return cells;
    };

    const shiftedCells = (text, shift) => {
      const source = canonicalCells(text);
      const output = Array(7).fill('');
      source.forEach((value, index) => {
        if (!value) return;
        const target = index + shift;
        if (target >= 0 && target < output.length) output[target] = value;
      });
      return output;
    };

    const renderCells = (container, cells) => {
      container.innerHTML = '';
      cells.forEach((value, index) => {
        const cell = document.createElement('span');
        cell.className = `place-cell ${index === 2 ? 'decimal-column' : ''}`;
        cell.textContent = value;
        cell.setAttribute('aria-label', value ? `${value}, ${placeNames[index]}` : `empty ${placeNames[index]}`);
        container.appendChild(cell);
      });
    };

    let alignQ;
    let shift = 0;
    const renderAlignRows = () => {
      renderCells(root.querySelector('[data-align-top]'), canonicalCells(alignQ.a));
      renderCells(root.querySelector('[data-align-bottom]'), shiftedCells(alignQ.b, shift));
      root.querySelector('[data-align-op]').textContent = alignQ.op;
    };
    const renderAlign = () => {
      alignQ = pick(alignBank);
      shift = pick([-1, 1]);
      root.querySelector('[data-align-prompt]').textContent = `${alignQ.a} ${alignQ.op} ${alignQ.b}. The second number starts in the wrong columns. Shift it until the place values match.`;
      root.querySelector('[data-align-feedback]').textContent = '';
      renderAlignRows();
    };
    root.querySelector('[data-shift-left]').addEventListener('click', () => { shift = Math.max(-1, shift - 1); renderAlignRows(); });
    root.querySelector('[data-shift-right]').addEventListener('click', () => { shift = Math.min(1, shift + 1); renderAlignRows(); });
    root.querySelector('[data-check-align]').addEventListener('click', () => {
      const fb = root.querySelector('[data-align-feedback]');
      if (shift === 0) {
        fb.textContent = `✓ Docked! The decimal points share one column, so equal place-value units match. Now calculate: ${alignQ.a} ${alignQ.op} ${alignQ.b} = ${alignQ.result}.`;
        fb.className = 'feedback good';
      } else {
        const direction = shift < 0 ? 'right' : 'left';
        fb.textContent = `Not yet. The second number is one place-value column too far ${shift < 0 ? 'left' : 'right'}. Shift it ${direction}.`;
        fb.className = 'feedback try';
      }
    });

    const zeroBank = [
      { prompt: '5.8 and 5.80', same: true, why: '5.80 has 0 extra hundredths, so it is the same value as 5.8.' },
      { prompt: '12.45 and 12.4500', same: true, why: 'Trailing zeros can show empty thousandths and ten-thousandths without changing 12.45.' },
      { prompt: '3.7 and 3.07', same: false, why: '3.7 has 7 tenths, while 3.07 has 7 hundredths.' },
      { prompt: '0.6 and 0.600', same: true, why: 'Both represent 6 tenths.' },
      { prompt: '8.05 and 8.50', same: false, why: '8.05 has 5 hundredths; 8.50 has 5 tenths.' }
    ];
    let zeroQ;
    const renderZero = () => {
      zeroQ = pick(zeroBank);
      root.querySelector('[data-zero-prompt]').textContent = `Compare ${zeroQ.prompt}.`;
      root.querySelector('[data-zero-feedback]').textContent = '';
    };
    root.querySelectorAll('[data-zero-answer]').forEach(btn => btn.addEventListener('click', () => {
      const fb = root.querySelector('[data-zero-feedback]');
      const saysSame = btn.dataset.zeroAnswer === 'same';
      if (saysSame === zeroQ.same) {
        fb.textContent = `✓ Correct. ${zeroQ.why}`;
        fb.className = 'feedback good';
      } else {
        fb.textContent = `Look at the place value of each digit. ${zeroQ.why}`;
        fb.className = 'feedback try';
      }
    }));

    const errorBank = [
      {
        work: '  5.8\n+0.47',
        prompt: 'Before calculating, what is wrong with this setup?',
        choices: ['The decimal points are not aligned, so equal place values are in different columns.', 'A zero must never be added to a decimal.', 'Addition cannot be used with decimals.'],
        answer: 0,
        why: 'Rewrite 5.8 as 5.80, then put 0.47 underneath with decimal points aligned. The sum is 6.27.'
      },
      {
        work: ' 12.45\n− 8.7632',
        prompt: 'What should happen before using the subtraction algorithm?',
        choices: ['Rewrite 12.45 as 12.4500 and align decimal points.', 'Move 8.7632 until the final 2 is under the final 5.', 'Delete the decimal points.'],
        answer: 0,
        why: '12.45 = 12.4500. Placeholder zeros make all place-value columns visible.'
      },
      {
        work: '3.8 < 3.745\n“745 has more digits than 8.”',
        prompt: 'What is wrong with the comparison?',
        choices: ['More digits do not automatically mean a larger decimal.', 'The comparison is correct.', 'Tenths are smaller than thousandths.'],
        answer: 0,
        why: 'Write 3.8 as 3.800. Then compare equal place values: 3.800 > 3.745.'
      }
    ];
    let errorQ;
    const renderError = () => {
      errorQ = pick(errorBank);
      root.querySelector('[data-error-work]').textContent = errorQ.work;
      root.querySelector('[data-error-prompt]').textContent = errorQ.prompt;
      const box = root.querySelector('[data-error-choices]');
      box.innerHTML = '';
      shuffle(errorQ.choices.map((text, index) => ({ text, index }))).forEach(choice => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = choice.text;
        b.onclick = () => {
          const fb = root.querySelector('[data-error-feedback]');
          if (choice.index === errorQ.answer) {
            fb.textContent = `✓ Correct. ${errorQ.why}`;
            fb.className = 'feedback good';
          } else {
            fb.textContent = `Try again. Focus on which place-value units are being compared or combined. ${errorQ.why}`;
            fb.className = 'feedback try';
          }
        };
        box.appendChild(b);
      });
      root.querySelector('[data-error-feedback]').textContent = '';
    };

    const scaleBank = [
      { prompt: '153 + 481 = 634. What is 15.3 + 48.1?', correct: '63.4', choices: ['6.34', '63.4', '634'], why: 'Both addends are one tenth as large, so the sum is one tenth as large.' },
      { prompt: '481 − 153 = 328. What is 48.1 − 15.3?', correct: '32.8', choices: ['3.28', '32.8', '328'], why: 'Both numbers are one tenth as large, so the difference is one tenth as large.' },
      { prompt: '62 + 35 = 97. What is 0.62 + 0.35?', correct: '0.97', choices: ['0.097', '0.97', '9.7'], why: 'Both addends are one hundredth as large, so the sum is one hundredth as large.' },
      { prompt: '900 − 275 = 625. What is 9.00 − 2.75?', correct: '6.25', choices: ['0.625', '6.25', '62.5'], why: 'Both values are one hundredth as large, so the difference is one hundredth as large.' }
    ];
    let scaleQ;
    const renderScale = () => {
      scaleQ = pick(scaleBank);
      root.querySelector('[data-scale-prompt]').textContent = scaleQ.prompt;
      const box = root.querySelector('[data-scale-choices]');
      box.innerHTML = '';
      shuffle(scaleQ.choices).forEach(text => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = text;
        b.onclick = () => {
          const fb = root.querySelector('[data-scale-feedback]');
          if (text === scaleQ.correct) {
            fb.textContent = `✓ Correct. ${scaleQ.why}`;
            fb.className = 'feedback good';
          } else {
            fb.textContent = `Check how the place values changed before calculating. ${scaleQ.why}`;
            fb.className = 'feedback try';
          }
        };
        box.appendChild(b);
      });
      root.querySelector('[data-scale-feedback]').textContent = '';
    };

    root.querySelector('[data-new-align]').addEventListener('click', renderAlign);
    root.querySelector('[data-new-zero]').addEventListener('click', renderZero);
    root.querySelector('[data-new-error]').addEventListener('click', renderError);
    root.querySelector('[data-new-scale]').addEventListener('click', renderScale);
    renderAlign(); renderZero(); renderError(); renderScale();
  }
</script>

<style>
