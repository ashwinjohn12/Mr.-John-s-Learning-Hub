---
interface Props { variant:'parallelogram'|'triangle'|'composite'|'volume' }
const { variant } = Astro.props;
const title = variant==='parallelogram'?'Glass Wall Mission':variant==='triangle'?'Pennant Designer':variant==='composite'?'Park Planner Challenge':'Storage Stack Challenge';
---
<div class="measurement-game" data-unit7-game={variant}>
  <div class="game-top"><div><p class="eyebrow">{title.toUpperCase()}</p><h3 data-game-title>Round 1 of 3</h3></div><span data-game-score>0 points</span></div>
  <div class="progress"><span data-game-progress></span></div>
  <div data-game-stage aria-live="polite"></div>
  <div class="game-actions"><button type="button" data-game-next hidden>Next round →</button><button type="button" class="soft" data-game-restart>Play again</button></div>
</div>
<script>
const banks:any={
 parallelogram:[
  [
   {prompt:'A glass panel has base 12 m, perpendicular height 5 m, and slanted side 7 m. How much glass is needed?',choices:['35 m²','60 m²','84 m²'],answer:1,explain:'Use base × perpendicular height: 12 × 5 = 60 m².'},
   {prompt:'A mural panel has base 9 m and perpendicular height 6 m. Its slanted side is 8 m. Area?',choices:['48 m²','54 m²','72 m²'],answer:1,explain:'The slanted side is not used. 9 × 6 = 54 m².'},
   {prompt:'A solar panel is a parallelogram with base 14 m and perpendicular height 4 m. Area?',choices:['18 m²','56 m²','72 m²'],answer:1,explain:'14 × 4 = 56 m².'}
  ],
  [
   {prompt:'A panel must have area 72 m² and perpendicular height 6 m. What base should the designer use?',choices:['10 m','12 m','18 m'],answer:1,explain:'72 ÷ 6 = 12 m.'},
   {prompt:'A window has area 63 m² and base 9 m. What perpendicular height is needed?',choices:['7 m','8 m','9 m'],answer:0,explain:'63 ÷ 9 = 7 m.'},
   {prompt:'A flower bed has area 52.5 m² and base 7 m. Height?',choices:['6.5 m','7.5 m','8.5 m'],answer:1,explain:'52.5 ÷ 7 = 7.5 m.'}
  ],
  [
   {prompt:'You keep base 10 m and perpendicular height 4 m but increase the slant. What happens to area?',choices:['It increases','It decreases','It stays 40 m²'],answer:2,explain:'Slant changes appearance, not base × perpendicular height.'},
   {prompt:'Two panels have equal base and perpendicular height but different slants. Which needs more glass?',choices:['First','Second','They need the same amount'],answer:2,explain:'Equal base and perpendicular height means equal area.'},
   {prompt:'Which measurement should a designer highlight before calculating area?',choices:['Slanted side','Perpendicular height','Perimeter only'],answer:1,explain:'The perpendicular height is the 90° distance used with the base.'}
  ]
 ],
 triangle:[
  [
   {prompt:'A school pennant has base 10 in and perpendicular height 8 in. How much felt is needed?',choices:['40 in²','80 in²','90 in²'],answer:0,explain:'10 × 8 ÷ 2 = 40 in².'},
   {prompt:'A triangular flag has base 12 cm and height 7 cm. Area?',choices:['42 cm²','84 cm²','19 cm²'],answer:0,explain:'12 × 7 ÷ 2 = 42 cm².'},
   {prompt:'A triangular sail has base 9 ft and height 6 ft. Area?',choices:['27 ft²','54 ft²','15 ft²'],answer:0,explain:'9 × 6 ÷ 2 = 27 ft².'}
  ],
  [
   {prompt:'A matching parallelogram has area 70 cm². What is the area of one triangle made by its diagonal?',choices:['35 cm²','70 cm²','140 cm²'],answer:0,explain:'A diagonal makes two congruent triangles, so each is half.'},
   {prompt:'A matching parallelogram has area 48 m². One diagonal creates two equal triangles. Each area?',choices:['12 m²','24 m²','48 m²'],answer:1,explain:'48 ÷ 2 = 24 m².'},
   {prompt:'A triangle is paired with a congruent copy to make a 60 yd² parallelogram. Triangle area?',choices:['20 yd²','30 yd²','60 yd²'],answer:1,explain:'One of two congruent halves is 30 yd².'}
  ],
  [
   {prompt:'The top vertex slides sideways but base and perpendicular height stay fixed. What happens to area?',choices:['It changes','It stays the same','It doubles'],answer:1,explain:'Triangle area depends on base and perpendicular height, not horizontal position of the top vertex.'},
   {prompt:'Why do we divide base × height by 2?',choices:['Triangles have 2 dimensions','One triangle is half a matching parallelogram','The base is always even'],answer:1,explain:'Two congruent triangles form the matching parallelogram.'},
   {prompt:'Which measurement must meet the base at 90°?',choices:['Slanted side','Perpendicular height','Diagonal'],answer:1,explain:'The perpendicular height forms a right angle with the base.'}
  ]
 ],
 composite:[
  [
   {prompt:'A sign is a 10×4 rectangle plus a roof triangle with b=10,h=3. Total area?',choices:['40','55','70'],answer:1,explain:'40 + 15 = 55 square units.'},
   {prompt:'A garden is a 6×5 rectangle plus a triangle with b=6,h=4. Total?',choices:['36','42','48'],answer:1,explain:'30 + 12 = 42.'},
   {prompt:'A logo combines parallelogram b=8,h=5 and triangle b=6,h=4. Total?',choices:['46','52','64'],answer:1,explain:'40 + 12 = 52.'}
  ],
  [
   {prompt:'A 12×8 field has a 4×3 rectangular corner removed. Remaining area?',choices:['84','92','96'],answer:0,explain:'96 − 12 = 84.'},
   {prompt:'A 15×10 stage has a 5×4 cutout. Remaining area?',choices:['120','130','150'],answer:1,explain:'150 − 20 = 130.'},
   {prompt:'A 14×9 wall has two 3×2 windows removed. Paintable area?',choices:['108','114','120'],answer:1,explain:'126 − 12 = 114.'}
  ],
  [
   {prompt:'Two teams use different valid decompositions and get the same total. Is that possible?',choices:['No','Yes, if both cover the original region exactly once','Only on grid paper'],answer:1,explain:'Different decomposition lines can organize the same fixed area.'},
   {prompt:'What should you do before calculating a composite area?',choices:['Guess missing lengths','Identify pieces and needed dimensions','Add every side'],answer:1,explain:'A useful decomposition and labelled dimensions prevent errors.'},
   {prompt:'What is a strong way to check a composite-area answer?',choices:['Try another decomposition or estimate','Change the units','Count vertices'],answer:0,explain:'A second method or estimate checks whether the total is reasonable.'}
  ]
 ],
 volume:[
  [
   {prompt:'A storage box has a 4×3 base and is 5 layers high. Volume?',choices:['12 cm³','20 cm³','60 cm³'],answer:2,explain:'Base area 12 × 5 layers = 60 cm³.'},
   {prompt:'A crate measures 5×2×4 cm. Volume?',choices:['20 cm³','40 cm³','80 cm³'],answer:1,explain:'5 × 2 × 4 = 40 cm³.'},
   {prompt:'A prism has 8 cubes in each layer and 6 layers. Volume?',choices:['14','48','64'],answer:1,explain:'8 × 6 = 48 cubic units.'}
  ],
  [
   {prompt:'A container has volume 72 cm³ and base area 24 cm². Height?',choices:['2 cm','3 cm','4 cm'],answer:1,explain:'72 ÷ 24 = 3 cm.'},
   {prompt:'A box volume is 84 m³ with base area 28 m². Height?',choices:['3 m','4 m','6 m'],answer:0,explain:'84 ÷ 28 = 3 m.'},
   {prompt:'A prism volume is 60 cm³. It has a 5×3 base. Height?',choices:['3 cm','4 cm','5 cm'],answer:1,explain:'Base area 15; 60 ÷ 15 = 4 cm.'}
  ],
  [
   {prompt:'A 2×3×4 prism is rebuilt as 1×6×4. Compare volume.',choices:['First is larger','Second is larger','Both are 24'],answer:2,explain:'Both products equal 24 cubic units.'},
   {prompt:'If a prism height doubles while base area stays fixed, volume...',choices:['halves','stays the same','doubles'],answer:2,explain:'Volume = base area × height, so doubling one factor doubles the volume.'},
   {prompt:'Why should you not count only visible cubes?',choices:['Hidden cubes also occupy space','Visible cubes are smaller','Only top cubes count'],answer:0,explain:'A solid prism contains cubes inside and behind the visible faces.'}
  ]
 ]
};

document.querySelectorAll<HTMLElement>('[data-unit7-game]').forEach(game=>{
 const variant=game.dataset.unit7Game||'parallelogram';const rounds=banks[variant];const stage=game.querySelector<HTMLElement>('[data-game-stage]');const scoreEl=game.querySelector('[data-game-score]');const titleEl=game.querySelector('[data-game-title]');const progress=game.querySelector<HTMLElement>('[data-game-progress]');const next=game.querySelector<HTMLButtonElement>('[data-game-next]');const restart=game.querySelector<HTMLButtonElement>('[data-game-restart]');let selected:any[]=[];let round=0;let score=0;let locked=false;
 const choose=()=>rounds.map((bank:any[])=>bank[Math.floor(Math.random()*bank.length)]);
 const render=()=>{const q=selected[round];locked=false;if(titleEl)titleEl.textContent=`Round ${round+1} of 3`;if(scoreEl)scoreEl.textContent=`${score} points`;if(progress)progress.style.width=`${(round/3)*100}%`;if(next)next.hidden=true;if(stage)stage.innerHTML=`<p class="round-label">MISSION ${round+1}</p><h3>${q.prompt}</h3><div class="game-choices">${q.choices.map((c:string,i:number)=>`<button type="button" data-choice="${i}">${c}</button>`).join('')}</div><div class="game-feedback" data-game-feedback hidden></div>`;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>answer(Number(b.dataset.choice))));};
 const answer=(choice:number)=>{if(locked)return;locked=true;const q=selected[round],ok=choice===q.answer;if(ok)score+=100;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect')});const f=stage?.querySelector<HTMLElement>('[data-game-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>${ok?'Mission solved!':'Try this reasoning:'}</strong> ${q.explain}`;}if(scoreEl)scoreEl.textContent=`${score} points`;if(progress)progress.style.width=`${((round+1)/3)*100}%`;if(next){next.hidden=false;next.textContent=round===2?'Finish mission':'Next round →';}};
 const finish=()=>{if(stage)stage.innerHTML=`<div class="game-finish"><div class="trophy">🏆</div><p class="eyebrow">MISSION COMPLETE</p><h3>${score===300?'Measurement Master':'Mission Complete'}</h3><p>You earned ${score} / 300 points. Play again for a fresh set of measurement decisions.</p></div>`;if(next)next.hidden=true;if(progress)progress.style.width='100%';};
 const reset=()=>{selected=choose();round=0;score=0;render();};next?.addEventListener('click',()=>{if(round===2){finish();return;}round++;render();});restart?.addEventListener('click',reset);reset();
});
</script>
<style>
.measurement-game{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.game-top{display:flex;justify-content:space-between;gap:1rem;align-items:start}.game-top h3{margin:.15rem 0}.game-top>span{font-weight:900;padding:.45rem .65rem;border-radius:10px;background:var(--course-soft)}.progress{height:9px;border-radius:99px;background:#e9eef5;overflow:hidden;margin:.8rem 0}.progress span{display:block;height:100%;width:0;background:var(--course);transition:width .25s}.round-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#64748b}.game-choices{display:grid;gap:.55rem;margin:1rem 0}.game-choices button{border:1px solid #dbe3ec;border-radius:12px;padding:.75rem;text-align:left;background:#fff;font-weight:800;cursor:pointer}.game-choices button.correct{background:#f0fdf4;border-color:#22c55e}.game-choices button.incorrect{background:#fef2f2;border-color:#ef4444}.game-feedback{padding:.75rem .85rem;border-radius:11px;background:#f7f9fc}.game-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.game-actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.game-actions .soft{background:#eef3f9;color:#25364f}.game-finish{text-align:center;padding:1.1rem}.trophy{font-size:2.4rem}@media(max-width:650px){.game-top{display:grid}.game-top>span{justify-self:start}}
</style>
