---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit8FunctionLab from './Unit8FunctionLab.astro';
import Unit8PatternsGame from './Unit8PatternsGame.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';
interface Props { course:Course; unit:Unit; topic:Topic; content:TopicContent; variant:'investigate'|'represent'|'solve' }
const { course,unit,topic,content,variant }=Astro.props;
const base=import.meta.env.BASE_URL;
const nextHref=content.next.slug&&content.next.status==='ready'?`${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/`:null;
const visiblePrerequisites=content.prerequisites.slice(0,3);
const visibleGoals=content.goals.slice(0,4);
const coreConcepts=content.concepts.slice(0,5);
const appliedConcepts=content.concepts.slice(5);
const coreExamples=content.examples.slice(0,2);
const advancedExamples=content.examples.slice(2);
const heroTitle=variant==='investigate'?'Function Machines & Relationships':variant==='represent'?'Representing Functions':'Solving with Functions';
const heroSubtitle=variant==='investigate'?'Discover how inputs, outputs, and rules create functions.':variant==='represent'?'Connect one relationship across tables, ordered pairs, graphs, and equations.':'Use the same function forward to predict and backward to solve.';
const appliedLabel=variant==='investigate'?'Testing rules carefully':variant==='represent'?'Extending and predicting':'Building and checking rules';
const gameTitle=variant==='investigate'?'Function Machine Inspector':variant==='represent'?'Representation Relay':'Function Detective Mission';
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} {heroTitle} {heroSubtitle} compactMobileHero mobileHeroSize="clamp(1.9rem,9vw,2.9rem)">
 <LearningSection id="overview" eyebrow="GET READY" title="Get ready for functions" icon="🎯" tone="idea">
  <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{visiblePrerequisites.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">TODAY'S MISSION</p><ul>{visibleGoals.map(goal=><li>{goal}</li>)}</ul></div></div>
  <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
  <p class="break-note"><strong>Suggested break point:</strong> Pause after Explore if you are working independently. Return for Practise, Check Yourself, and Play & Apply when you are ready.</p>
  <p class="start-note"><strong>Best place to begin:</strong> Follow the input → relationship → output story. Do not try to memorize table, graph, and equation rules as separate topics.</p>
  <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item=><li>{item}</li>)}</ul></details>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
  <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
  <div class="three-step-rule">
   {variant==='investigate'?<><div><span>1</span><strong>Choose an input</strong><small>The independent value starts the relationship.</small></div><div><span>2</span><strong>Apply one rule</strong><small>The function determines what happens.</small></div><div><span>3</span><strong>Get one output</strong><small>The dependent value is the result.</small></div></>:variant==='represent'?<><div><span>1</span><strong>Find the pairs</strong><small>Match every input with its output.</small></div><div><span>2</span><strong>Switch the view</strong><small>Table ↔ pairs ↔ graph ↔ equation.</small></div><div><span>3</span><strong>Check agreement</strong><small>Every representation should tell the same story.</small></div></>:<><div><span>1</span><strong>What is known?</strong><small>Input or output?</small></div><div><span>2</span><strong>Move the right way</strong><small>Forward to output; backward to input.</small></div><div><span>3</span><strong>Verify</strong><small>Check the pair in the original function.</small></div></>}
  </div><div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
  <div class="concept-grid detailed">{coreConcepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
  {appliedConcepts.length>0&&<details class="applied-concepts"><summary>{appliedLabel}</summary><div class="applied-grid">{appliedConcepts.map(concept=><div><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div></details>}
  {variant==='investigate'?<article class="relationship-card"><p class="eyebrow">FUNCTION STORY</p><h3>Input → rule → output</h3><div class="flow-model"><span>x = 4</span><b>×2 + 3 →</b><span>y = 11</span></div><p>Repeat input 4 and a true function must still return the same output.</p></article>:variant==='represent'?<article class="relationship-card"><p class="eyebrow">SAME FUNCTION · FOUR VIEWS</p><h3>y = 2x + 1</h3><div class="representation-row"><span>Table<br/>1→3 · 2→5</span><span>(1,3)<br/>(2,5)</span><span>Graph<br/>• • •</span><span>y=2x+1</span></div><p>These look different, but they encode the same input-output pairs.</p></article>:<article class="relationship-card"><p class="eyebrow">TWO DIRECTIONS</p><h3>y = 4x + 3</h3><div class="flow-model"><span>x = 5</span><b>forward →</b><span>y = 23</span></div><div class="flow-model reverse"><span>x = ?</span><b>← backward</b><span>y = 31</span></div><p>When the output is known, use inverse reasoning to find the input.</p></article>}
  <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <p class="section-lead">Start with the two core examples. Open Examples 3 and 4 when you are ready for a deeper connection.</p>
  <div class="example-stack">{coreExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
  <details class="advanced-examples"><summary>Ready for more? Open Examples 3 and 4</summary><div class="example-stack advanced-stack">{advancedExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary}/></LearningSection>

 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore"><p class="section-lead">{content.explorePrompt}</p><Unit8FunctionLab {variant}/><article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p></article></LearningSection>

 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><p class="practice-goal-copy"><strong>Your goal:</strong> complete the set shown below. If you choose a difficulty with fewer available questions, the goal adjusts automatically.</p><PracticeEngine questions={content.questions} sessionCount={6}/></LearningSection>

 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. This bank is separate from supported practice and has no hints.</p><CheckYourself questions={content.checkQuestions} count={5}/></LearningSection>

 <LearningSection id="apply" eyebrow="PLAY & APPLY" title={gameTitle} icon="🎮" tone="play"><p class="section-lead">Rounds 1 and 2 are quick function decisions. Round 3 asks you to build, match, or solve a relationship for a purpose.</p><Unit8PatternsGame {variant}/></LearningSection>

 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="summary-card"><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item=><li>{item}</li>)}</ul></div><div class="review-options"><details><summary>Need more help?</summary><ul>{content.support.map(item=><li>{item}</li>)}</ul></details><details><summary>Want an extra challenge?</summary><ul>{content.extension.map(item=><li>{item}</li>)}</ul></details></div><article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show a strong answer</summary><p>{content.pat.answer}</p></details></article><div class="review-grid">{content.review.map(item=><label><input type="checkbox"/> {item}</label>)}</div><div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>Continue when you are ready.</small></div>{nextHref?<a class="button" href={nextHref}>Open →</a>:<span class="coming-next">Coming next</span>}</div></LearningSection>
</Grade6LessonFrame>
<style>
.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.summary-card{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.summary-card ul,.worked-example ol,.hands-on-card ol,.review-options ul{padding-left:1.2rem}.overview-grid li,.summary-card li,.worked-example li,.hands-on-card li,.review-options li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.start-note,.practice-goal-copy,.break-note{margin:1rem 0 0;padding:.75rem .85rem;border-radius:11px;background:#fff8db}.break-note{background:#f0fdf4}.success-box{margin-top:1rem}.three-step-rule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1rem 0}.three-step-rule>div{display:grid;gap:.25rem;padding:.8rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.three-step-rule small{color:#526174}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.applied-concepts,.advanced-examples{margin-top:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.applied-concepts>summary,.advanced-examples>summary,.review-options summary{cursor:pointer;padding:1rem;font-weight:900}.applied-grid,.advanced-stack{padding:0 1rem 1rem}.worked-example,.hands-on-card,.pat-card,.relationship-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.example-stack{display:grid;gap:1rem}.example-answer{margin-top:.8rem;padding:.75rem;border-radius:10px;background:var(--course-soft)}.relationship-card{margin-top:1rem;background:#fbfdff}.flow-model{display:flex;align-items:center;justify-content:center;gap:.7rem;flex-wrap:wrap;margin:.8rem 0}.flow-model span,.representation-row span{padding:.65rem .8rem;border-radius:11px;background:var(--course-soft);font-weight:900}.flow-model b{color:#526174}.reverse{direction:rtl}.representation-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;text-align:center;margin:.8rem 0}.mixups,.hands-on-card,.pat-card,.review-options{margin-top:1rem}.review-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.review-options details{border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.pat-card{background:#f8fafc}.next-step small{display:block;margin-top:.2rem;color:#64748b}.coming-next{font-weight:900;color:#64748b}@media(max-width:760px){.overview-grid,.three-step-rule,.review-options,.representation-row{grid-template-columns:1fr}}
</style>
