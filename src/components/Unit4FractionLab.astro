<div class="fraction-lab" data-fraction-lab>
  <section class="lab-panel" data-lcd-panel>
    <div class="lab-head"><div><p class="eyebrow">PART A · DENOMINATOR DETECTIVE</p><h3>Find the shared unit</h3></div><button type="button" class="secondary" data-lcd-new>New pair</button></div>
    <p data-lcd-question></p>
    <div class="bar-stage" data-lcd-bars></div>
    <div class="choice-grid" data-lcd-choices></div>
    <div class="lab-feedback" data-lcd-feedback aria-live="polite"></div>
  </section>

  <section class="lab-panel" data-equivalent-panel>
    <div class="lab-head"><div><p class="eyebrow">PART B · EQUIVALENT FRACTION BUILDER</p><h3>Rename without changing the value</h3></div><button type="button" class="secondary" data-equivalent-new>New fraction</button></div>
    <p data-equivalent-question></p>
    <div class="bar-stage" data-equivalent-bars></div>
    <div class="choice-grid" data-equivalent-choices></div>
    <div class="lab-feedback" data-equivalent-feedback aria-live="polite"></div>
  </section>

  <section class="lab-panel" data-solve-panel>
    <div class="lab-head"><div><p class="eyebrow">PART C · FRACTION SOLVER</p><h3>Choose a common unit and solve</h3></div><button type="button" class="secondary" data-solve-new>New challenge</button></div>
    <p data-solve-question></p>
    <div class="choice-grid" data-solve-choices></div>
    <div class="lab-feedback" data-solve-feedback aria-live="polite"></div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fraction-lab]').forEach((lab) => {
    const lcdTasks = [
      { a:[1,2], b:[1,6], answer:'6', choices:['4','6','8','12'], explain:'6 is the first shared multiple of 2 and 6. Halves can be renamed as sixths because 1/2 = 3/6.' },
      { a:[3,4], b:[1,8], answer:'8', choices:['4','8','16','32'], explain:'4 and 8 are related denominators. Since 4 × 2 = 8, eighths are already the lowest shared unit.' },
      { a:[1,3], b:[1,4], answer:'12', choices:['7','8','12','24'], explain:'3 and 4 are unrelated. Their first shared multiple is 12, so twelfths are the lowest common unit.' },
      { a:[5,6], b:[1,4], answer:'12', choices:['10','12','18','24'], explain:'The first shared multiple of 6 and 4 is 12. That lets both fractions be renamed in twelfths.' }
    ];
    const equivalentTasks = [
      { from:[2,3], target:12, answer:'8', choices:['4','6','8','9'], explain:'3 × 4 = 12, so multiply the numerator by the same factor: 2 × 4 = 8. Therefore 2/3 = 8/12.' },
      { from:[3,4], target:12, answer:'9', choices:['6','8','9','10'], explain:'4 × 3 = 12, so 3 × 3 = 9. Therefore 3/4 = 9/12.' },
      { from:[5,6], target:18, answer:'15', choices:['10','12','15','16'], explain:'6 × 3 = 18, so 5 × 3 = 15. Therefore 5/6 = 15/18.' },
      { from:[3,5], target:20, answer:'12', choices:['8','10','12','15'], explain:'5 × 4 = 20, so 3 × 4 = 12. Therefore 3/5 = 12/20.' }
    ];
    const solveTasks = [
      { prompt:'3/4 + 1/8', answer:'7/8', choices:['4/12','7/8','4/8','1'], explain:'Use eighths: 3/4 = 6/8. Then 6/8 + 1/8 = 7/8.' },
      { prompt:'5/6 − 1/4', answer:'7/12', choices:['4/2','7/12','4/10','3/8'], explain:'Use twelfths: 5/6 = 10/12 and 1/4 = 3/12. Then 10/12 − 3/12 = 7/12.' },
      { prompt:'2/3 + 3/4', answer:'1 5/12', choices:['5/7','11/12','1 5/12','1 1/7'], explain:'Use twelfths: 2/3 = 8/12 and 3/4 = 9/12. The sum is 17/12 = 1 5/12.' },
      { prompt:'7/10 − 1/5', answer:'1/2', choices:['6/5','1/2','6/10','3/10'], explain:'Use tenths: 1/5 = 2/10. Then 7/10 − 2/10 = 5/10 = 1/2.' }
    ];

    const shuffle = <T,>(items:T[]) => [...items].sort(() => Math.random() - .5);
    const chooseTask = <T,>(items:T[], current:number) => {
      if (items.length < 2) return 0;
      let next = Math.floor(Math.random() * items.length);
      while (next === current) next = Math.floor(Math.random() * items.length);
      return next;
    };

    const makeBar = (numerator:number, denominator:number, label:string) => {
      const row = document.createElement('div'); row.className='fraction-row';
      const name = document.createElement('span'); name.className='fraction-row-label'; name.textContent=label;
      const bar = document.createElement('div'); bar.className='fraction-bar'; bar.style.gridTemplateColumns=`repeat(${denominator}, minmax(0,1fr))`;
      for (let i=0;i<denominator;i++) { const piece=document.createElement('span'); piece.className=i<numerator?'filled':''; bar.appendChild(piece); }
      row.append(name,bar); return row;
    };

    const renderChoices = (host:Element | null, choices:string[], answer:string, feedback:HTMLElement | null, explain:string) => {
      if (!host) return;
      host.replaceChildren();
      shuffle(choices).forEach((choice) => {
        const button=document.createElement('button'); button.type='button'; button.textContent=choice;
        button.addEventListener('click', () => {
          host.querySelectorAll('button').forEach((item) => item.classList.remove('correct','wrong'));
          if (choice === answer) {
            button.classList.add('correct');
            if (feedback) feedback.innerHTML=`<strong>Yes.</strong> ${explain}`;
          } else {
            button.classList.add('wrong');
            if (feedback) feedback.innerHTML='<strong>Not yet.</strong> Check whether your fractions are being renamed with the same-sized unit.';
          }
        });
        host.appendChild(button);
      });
    };

    const lcdQuestion=lab.querySelector<HTMLElement>('[data-lcd-question]');
    const lcdBars=lab.querySelector('[data-lcd-bars]');
    const lcdChoices=lab.querySelector('[data-lcd-choices]');
    const lcdFeedback=lab.querySelector<HTMLElement>('[data-lcd-feedback]');
    const lcdNew=lab.querySelector<HTMLButtonElement>('[data-lcd-new]');
    let lcdIndex=-1;
    const renderLCD=()=>{
      lcdIndex=chooseTask(lcdTasks,lcdIndex); const task=lcdTasks[lcdIndex];
      if (lcdQuestion) lcdQuestion.textContent=`What is the lowest common denominator for ${task.a[0]}/${task.a[1]} and ${task.b[0]}/${task.b[1]}?`;
      if (lcdBars) { lcdBars.replaceChildren(makeBar(task.a[0],task.a[1],`${task.a[0]}/${task.a[1]}`),makeBar(task.b[0],task.b[1],`${task.b[0]}/${task.b[1]}`)); }
      if (lcdFeedback) lcdFeedback.textContent='Choose the first shared multiple, not just any large number.';
      renderChoices(lcdChoices,task.choices,task.answer,lcdFeedback,task.explain);
    };
    lcdNew?.addEventListener('click',renderLCD); renderLCD();

    const eqQuestion=lab.querySelector<HTMLElement>('[data-equivalent-question]');
    const eqBars=lab.querySelector('[data-equivalent-bars]');
    const eqChoices=lab.querySelector('[data-equivalent-choices]');
    const eqFeedback=lab.querySelector<HTMLElement>('[data-equivalent-feedback]');
    const eqNew=lab.querySelector<HTMLButtonElement>('[data-equivalent-new]');
    let eqIndex=-1;
    const renderEquivalent=()=>{
      eqIndex=chooseTask(equivalentTasks,eqIndex); const task=equivalentTasks[eqIndex];
      if (eqQuestion) eqQuestion.textContent=`Rename ${task.from[0]}/${task.from[1]} with denominator ${task.target}. What numerator belongs in ?/${task.target}?`;
      if (eqBars) { eqBars.replaceChildren(makeBar(task.from[0],task.from[1],`${task.from[0]}/${task.from[1]}`)); }
      if (eqFeedback) eqFeedback.textContent='Find the factor that changes the old denominator into the target denominator. Use that same factor on the numerator.';
      renderChoices(eqChoices,task.choices,task.answer,eqFeedback,task.explain);
    };
    eqNew?.addEventListener('click',renderEquivalent); renderEquivalent();

    const solveQuestion=lab.querySelector<HTMLElement>('[data-solve-question]');
    const solveChoices=lab.querySelector('[data-solve-choices]');
    const solveFeedback=lab.querySelector<HTMLElement>('[data-solve-feedback]');
    const solveNew=lab.querySelector<HTMLButtonElement>('[data-solve-new]');
    let solveIndex=-1;
    const renderSolve=()=>{
      solveIndex=chooseTask(solveTasks,solveIndex); const task=solveTasks[solveIndex];
      if (solveQuestion) solveQuestion.textContent=`Solve ${task.prompt}.`;
      if (solveFeedback) solveFeedback.textContent='Before choosing, decide what common denominator you would use and rename both fractions mentally or on paper.';
      renderChoices(solveChoices,task.choices,task.answer,solveFeedback,task.explain);
    };
    solveNew?.addEventListener('click',renderSolve); renderSolve();
  });
</script>

<style>
.fraction-lab{display:grid;gap:1rem}.lab-panel{border:1px solid #dfe7f1;border-radius:16px;padding:1rem;background:#fff}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.lab-head h3{margin:.15rem 0}.lab-head .eyebrow{margin:0}.secondary{border:1px solid #cbd5e1;background:#fff;border-radius:10px;padding:.55rem .75rem;font-weight:800;cursor:pointer}.bar-stage{display:grid;gap:.55rem;margin:.9rem 0}.fraction-row{display:grid;grid-template-columns:54px 1fr;gap:.7rem;align-items:center}.fraction-row-label{font-weight:900}.fraction-bar{display:grid;border:2px solid #26354a;border-radius:8px;overflow:hidden;min-height:38px}.fraction-bar span{border-right:1px solid #9aa8bb;background:#fff}.fraction-bar span:last-child{border-right:0}.fraction-bar span.filled{background:var(--course-soft,#dbeafe)}.choice-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;margin:.8rem 0}.choice-grid button{border:1px solid #cbd5e1;background:#fff;border-radius:10px;padding:.7rem .5rem;font-weight:900;cursor:pointer}.choice-grid button:hover{border-color:var(--course)}.choice-grid button.correct{border-color:#15803d;background:#eefbf2}.choice-grid button.wrong{border-color:#b91c1c;background:#fff1f1}.lab-feedback{min-height:48px;padding:.7rem .8rem;border-radius:10px;background:#f7f9fc;line-height:1.5}@media(max-width:680px){.lab-head{display:grid}.choice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
