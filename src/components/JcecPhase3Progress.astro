---
interface Props {
  active?: number;
  compact?: boolean;
}

const { active = 1, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
// Mission 4 is the current release gate; Mission 5 stays unlinked until teacher approval.
const missions = [
  { number: 1, short: 'Temperature', title: 'Read the Thermal Warning' },
  { number: 2, short: 'Heat Transfer', title: 'Follow the Heat' },
  { number: 3, short: 'Thermal Barrier', title: 'Hold the Temperature' },
  { number: 4, short: 'Habitat Control', title: 'Control the Habitat' },
  { number: 5, short: 'Sustainable Survival', title: 'Survive Without Wasting It' }
];
---

<nav class:list={['phase3-progress', { compact }]} aria-label="Phase 3 mission progress">
  {missions.map((mission) => (
    <div class:list={['phase3-step', { current: mission.number === active, done: mission.number < active, future: mission.number > active }]} aria-current={mission.number === active ? 'step' : undefined}>
      <span class="mission-number">{mission.number}</span>
      <span class="mission-copy"><strong>{mission.short}</strong>{!compact && <small>{mission.title}</small>}</span>
    </div>
  ))}
</nav>

<script is:inline define:vars={{ base }}>
  (() => {
    const path = window.location.pathname;
    const releases = [
      {
        match: '/phase-3/mission-1/',
        root: '#phase3-mission1',
        note: 'Mission 2 is ready. Next, trace how thermal energy is moving into or out of the habitat.',
        href: `${base}courses/grade-7-science/jabberwocky/phase-3/mission-2/`,
        label: 'Next Mission → Follow the Heat'
      },
      {
        match: '/phase-3/mission-2/',
        root: '#phase3-mission2',
        note: 'Mission 3 is ready. Next, use fair-test evidence to slow the unwanted thermal-energy transfer.',
        href: `${base}courses/grade-7-science/jabberwocky/phase-3/mission-3/`,
        label: 'Next Mission → Hold the Temperature'
      },
      {
        match: '/phase-3/mission-3/',
        root: '#phase3-mission3',
        note: 'Mission 4 is ready. Next, build a feedback rule that responds when temperature changes anyway.',
        href: `${base}courses/grade-7-science/jabberwocky/phase-3/mission-4/`,
        label: 'Next Mission → Control the Habitat'
      }
    ];
    const release = releases.find((item) => path.includes(item.match));
    if (!release) return;
    const finished = document.querySelector(`${release.root} .finished-box`);
    if (!finished || finished.querySelector('.phase3-next-mission-link')) return;
    const note = finished.querySelector('p');
    if (note) note.textContent = release.note;
    const next = document.createElement('a');
    next.className = 'phase3-next-mission-link';
    next.href = release.href;
    next.textContent = release.label;
    finished.appendChild(next);
  })();
</script>

<style>
  .phase3-progress{display:grid;grid-template-columns:repeat(5,1fr);gap:.45rem;margin:1rem 0 1.4rem}.phase3-step{position:relative;display:flex;gap:.5rem;align-items:center;min-width:0;padding:.65rem;border:1px solid #344f62;border-radius:11px;background:#09151d;color:#91aabd}.phase3-step:not(:last-child)::after{content:'→';position:absolute;right:-.39rem;z-index:2;color:#536f82;font-weight:900}.mission-number{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#132c3a;color:#b3c8d4;font-size:.78rem;font-weight:900}.mission-copy{display:grid;min-width:0}.mission-copy strong{color:inherit;font-size:.82rem;white-space:nowrap}.mission-copy small{margin-top:.08rem;color:#7892a2;font-size:.67rem;line-height:1.25}.phase3-step.current{border-color:#f0a85b;background:#252018;color:#fff4e6}.phase3-step.current .mission-number{background:#ffb25f;color:#311b05}.phase3-step.current .mission-copy strong{color:#ffd3a4}.phase3-step.done{border-color:#47738f;background:#102331;color:#c5e3f4}.phase3-step.done .mission-number{background:#24516b;color:#e0f4ff}.phase3-step.done .mission-number::after{content:'✓';font-size:.72rem}.phase3-step.done .mission-number{font-size:0}.compact .mission-copy small{display:none}
  :global(.phase3-next-mission-link){display:inline-flex;align-items:center;justify-content:center;width:max-content;max-width:100%;margin-top:.25rem;padding:.65rem .8rem;border-radius:8px;background:#ffb25f;color:#2d1906!important;text-decoration:none;font-size:.8rem;font-weight:900}:global(.phase3-next-mission-link:hover){filter:brightness(1.05);transform:translateY(-1px)}
  @media(max-width:900px){.phase3-progress{grid-template-columns:repeat(5,minmax(110px,1fr));overflow-x:auto;padding-bottom:.3rem}.phase3-step{min-width:110px}.mission-copy small{display:none}}
  @media(max-width:560px){.phase3-progress{grid-template-columns:repeat(5,96px)}.phase3-step{display:grid;justify-items:center;text-align:center;padding:.55rem .35rem}.mission-copy strong{font-size:.7rem;white-space:normal}.phase3-step:not(:last-child)::after{display:none}:global(.phase3-next-mission-link){width:100%;box-sizing:border-box;text-align:center}}
</style>
