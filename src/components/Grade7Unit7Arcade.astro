---
const stages=[
 {title:'1 · Calibrate the score dashboard',calc:'12',calcLabel:'Mean score',representation:'bar graph from zero with score labels',interpretation:'The mean is a fair-share centre, not every player’s score.',prediction:'Future scores may be near the centre but are not guaranteed.',decision:'Keep the labelled zero-based dashboard.'},
 {title:'2 · Audit the tournament outlier',calc:'18',calcLabel:'Median attendance',representation:'dot plot showing the unusual championship crowd',interpretation:'The high championship value can pull the mean while median better tracks the ordinary centre.',prediction:'Ordinary rounds may resemble the main cluster; championship rounds can differ.',decision:'Report the median for ordinary planning and disclose the outlier.'},
 {title:'3 · Certify the prize spinner',calc:'25',calcLabel:'Prize probability (%)',representation:'12 equal sectors with 3 prize sectors',interpretation:'3/12 = 1/4 = 25%; unequal sectors would invalidate simple sector counting.',prediction:'About 25% is a long-run expectation, not an every-four-spins rule.',decision:'Approve only the equal-sector 25% design.'},
 {title:'4 · Map the two-event bonus',calc:'8',calcLabel:'Complete ordered outcomes',representation:'2×4 table containing every coin-spinner ordered pair',interpretation:'The independent coin and spinner create 8 complete ordered pairs.',prediction:'A 2-of-8 bonus event has theoretical probability 25%.',decision:'Use the complete sample space before judging the bonus.'},
 {title:'5 · Test game fairness',calc:'27',calcLabel:'Experimental win rate (%)',representation:'comparison table: theoretical 25%, experimental 27%',interpretation:'A 27% trial result can be reasonably close to 25% theory without matching exactly.',prediction:'Larger repeated trials should often stabilize nearer the theoretical rate.',decision:'Keep testing; this result alone is not evidence of an unfair model.'}
];
---
<div class="arcade" data-unit7-arcade data-stages={JSON.stringify(stages)}><header><p class="eyebrow">BOARD GAME FAIRNESS LAB</p><h3>Five-stage Math Arcade</h3><p>Design, audit, and test a game night system. Each stage depends on the previous verified evidence.</p></header><div class="stages">{stages.map((s,i)=><section data-stage={i} class={i?'locked':''} aria-disabled={i?'true':'false'}><h4>{s.title}</h4><label>{s.calcLabel}<input data-calc inputmode="decimal" disabled={i>0}/></label><label>Representation<select data-representation disabled={i>0}><option value="">Choose</option><option>{s.representation}</option><option>an unlabelled or incomplete decorative model</option></select></label><label>Interpretation<select data-interpretation disabled={i>0}><option value="">Choose</option><option>{s.interpretation}</option><option>a conclusion that the summary guarantees every outcome</option></select></label><label>Prediction<select data-prediction disabled={i>0}><option value="">Choose</option><option>{s.prediction}</option><option>an exact future result is guaranteed</option></select></label><label>Decision<select data-decision disabled={i>0}><option value="">Choose</option><option>{s.decision}</option><option>approve the model even if calculation and representation disagree</option></select></label><label>Optional reasoning notes<textarea rows="2" data-note disabled={i>0}></textarea></label><button type="button" data-check disabled={i>0}>Verify stage</button><p data-status role="status">{i?'Complete the previous stage first.':'Ready.'}</p></section>)}</div><section class="final locked" data-final aria-disabled="true"><h4>Final synthesis · Issue the fairness recommendation</h4><label>Verified numerical chain<input data-final-values placeholder="12, 18, 25, 8, 27"/></label><label>Evidence chain<select data-final-representation><option value="">Choose</option><option>centre → outlier audit → fair spinner → complete sample space → theory/experiment comparison</option><option>five unrelated numbers with no representation checks</option></select></label><label>Interpretation<select data-final-interpretation><option value="">Choose</option><option>Every conclusion is limited to what its verified data or probability model supports.</option><option>One correct calculation makes every graph and conclusion valid.</option></select></label><label>Prediction<select data-final-prediction><option value="">Choose</option><option>Use observed evidence and theoretical probability to make cautious, testable expectations.</option><option>Guarantee the next result from the average or probability.</option></select></label><label>Decision<select data-final-decision><option value="">Choose</option><option>Approve the game only when calculations, complete representations, labels/scales, and fairness evidence all agree.</option><option>Approve whenever the final percent looks close enough.</option></select></label><label>Optional synthesis notes<textarea rows="3" data-plan></textarea></label><button type="button" data-final-check>Verify final synthesis</button><p data-final-status role="status" tabindex="-1">Verify all five stages first.</p></section><p class="policy">Written notes are never auto-graded. Verification uses the mathematical controls only.</p></div>
<script>document.querySelectorAll<HTMLElement>('[data-unit7-arcade]').forEach(root=>{const data=JSON.parse(root.dataset.stages||'[]'),stages=[...root.querySelectorAll<HTMLElement>('[data-stage]')],verified=new Set<number>();const unlock=(i:number)=>{const s=stages[i];if(!s)return;s.classList.remove('locked');s.setAttribute('aria-disabled','false');s.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|HTMLButtonElement>('input,select,textarea,button').forEach(x=>x.disabled=false);s.querySelector<HTMLElement>('[data-status]')!.textContent='Ready.'};const lockFinal=()=>{const f=root.querySelector<HTMLElement>('[data-final]')!;f.classList.add('locked');f.setAttribute('aria-disabled','true');root.querySelector<HTMLElement>('[data-final-status]')!.textContent='Verify all five stages first.'};const invalidate=(i:number)=>{for(let j=i;j<stages.length;j++){verified.delete(j);if(j>i){stages[j].classList.add('locked');stages[j].setAttribute('aria-disabled','true');stages[j].querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|HTMLButtonElement>('input,select,textarea,button').forEach(x=>x.disabled=true)}stages[j].querySelector<HTMLElement>('[data-status]')!.textContent=j===i?'Evidence changed. Verify this stage again.':'Earlier evidence changed. Complete dependencies again.'}lockFinal()};stages.forEach((s,i)=>{s.querySelectorAll('input,select').forEach(x=>{const change=()=>{if([...verified].some(j=>j>=i))invalidate(i)};x.addEventListener('input',change);x.addEventListener('change',change)});s.querySelector('[data-check]')?.addEventListener('click',()=>{const d=data[i],calc=s.querySelector<HTMLInputElement>('[data-calc]')!.value.trim(),rep=s.querySelector<HTMLSelectElement>('[data-representation]')!.value,interpret=s.querySelector<HTMLSelectElement>('[data-interpretation]')!.value,predict=s.querySelector<HTMLSelectElement>('[data-prediction]')!.value,decision=s.querySelector<HTMLSelectElement>('[data-decision]')!.value,status=s.querySelector<HTMLElement>('[data-status]')!;const checks=[calc===d.calc,rep===d.representation,interpret===d.interpretation,predict===d.prediction,decision===d.decision];if(!checks.every(Boolean)){status.textContent=!checks[0]?'Repair the numerical checkpoint.':!checks[1]?'Repair the representation before interpreting it.':!checks[2]?'Choose an interpretation supported by the verified evidence.':!checks[3]?'Use a cautious prediction rather than a guarantee.':'Make the decision depend on all verified evidence.';return}verified.add(i);status.textContent='Stage verified: calculation, representation, interpretation, prediction, and decision agree.';unlock(i+1);if(verified.size===stages.length){const f=root.querySelector<HTMLElement>('[data-final]')!;f.classList.remove('locked');f.setAttribute('aria-disabled','false');root.querySelector<HTMLElement>('[data-final-status]')!.textContent='All five stages verified. Complete the dependent synthesis.'}})});root.querySelector('[data-final-check]')?.addEventListener('click',()=>{const out=root.querySelector<HTMLElement>('[data-final-status]')!,values=root.querySelector<HTMLInputElement>('[data-final-values]')!.value.replace(/\s/g,''),rep=root.querySelector<HTMLSelectElement>('[data-final-representation]')!.value,interpret=root.querySelector<HTMLSelectElement>('[data-final-interpretation]')!.value,predict=root.querySelector<HTMLSelectElement>('[data-final-prediction]')!.value,decision=root.querySelector<HTMLSelectElement>('[data-final-decision]')!.value;const ok=verified.size===5&&values==='12,18,25,8,27'&&rep==='centre → outlier audit → fair spinner → complete sample space → theory/experiment comparison'&&interpret==='Every conclusion is limited to what its verified data or probability model supports.'&&predict==='Use observed evidence and theoretical probability to make cautious, testable expectations.'&&decision==='Approve the game only when calculations, complete representations, labels/scales, and fairness evidence all agree.';out.textContent=ok?'Board Game Fairness Lab complete. The dependent synthesis validates calculations, representations, evidence, interpretations, predictions, and decisions.':'Recheck the numerical chain and every dependent evidence, interpretation, prediction, and decision control.';out.focus({preventScroll:true})})});</script>
<style>.arcade{overflow:hidden;border-radius:18px;background:#10203a;color:#fff}.arcade header{padding:1.2rem;background:#173f70}.stages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;padding:1rem}.arcade section{padding:1rem;border:1px solid #45698f;border-radius:12px;background:#172e4e}.arcade label{display:grid;gap:.25rem;margin:.45rem 0}.arcade input,.arcade select,.arcade textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.6rem;font:inherit}.arcade button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#64e2bf;color:#0b2930;font-weight:850}.locked{opacity:.55}.final{margin:0 1rem 1rem}.policy{padding:0 1rem 1rem}.arcade :focus-visible{outline:3px solid #ffd75e;outline-offset:2px}@media(max-width:700px){.stages{grid-template-columns:1fr}}@media(max-width:390px){.stages,.final{padding:.7rem;margin:.7rem;overflow-wrap:anywhere}}@media(max-width:375px){.stages{gap:.6rem}}@media(max-width:320px){.arcade section{padding:.6rem}}@media(prefers-reduced-motion:reduce){.arcade *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>