---
import type { ChoiceQuestion } from '../data/grade7Unit1';
interface Props{bank:ChoiceQuestion[];lesson:string;count?:number}
const {bank,lesson,count=5}=Astro.props;
const encoded=JSON.stringify(bank);
---
<div class="independent" data-independent-check data-bank={encoded} data-lesson={lesson} data-count={count}>
 <div class="check-head"><div><strong>Fresh {count}-question set</strong><span>Balanced across the available idea groups.</span></div><button type="button" data-new>Generate new set</button></div>
 <p class="privacy-note">Complete the full set before submitting. Correctness and explanations stay hidden until then.</p>
 <div data-check-list></div>
 <button class="submit-all" type="button" data-submit>Submit all {count}</button>
 <p class="check-result" data-result role="status">No answers submitted yet.</p>
 <div class="review-routes" data-routes hidden></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-independent-check]').forEach(root=>{
  const bank=JSON.parse(root.dataset.bank||'[]');const list=root.querySelector<HTMLElement>('[data-check-list]');const count=Number(root.dataset.count||5);let set:any[]=[];
  const escape=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]||c));
  const graphVisual=(item:any)=>{const isGraph=root.dataset.lesson==='graphing-relations'||item.category==='Lesson 1.6';if(!isGraph)return'';const correct=String(item.choices?.[item.answer]||'');const match=correct.match(/\((-?\d+),\s*(-?\d+)\)/)||String(item.prompt).match(/\((-?\d+),\s*(-?\d+)\)/);if(!match)return'';const x=Number(match[1]),y=Number(match[2]),xMax=Math.max(5,x),yStep=Math.max(1,Math.ceil(y/5)),yMax=yStep*5,cx=32+(x/xMax)*190,cy=174-(y/yMax)*140;return`<div class="check-graph"><svg viewBox="0 0 250 205" role="img" aria-label="Coordinate graph. Horizontal input axis 0 to ${xMax}. Vertical output axis 0 to ${yMax} by ${yStep}. One point is plotted; read its coordinates."><line class="axis" x1="32" y1="174" x2="230" y2="174"></line><line class="axis" x1="32" y1="180" x2="32" y2="22"></line>${Array.from({length:6},(_,i)=>`<line x1="${32+i*38}" y1="170" x2="${32+i*38}" y2="178"></line><text x="${32+i*38}" y="194" text-anchor="middle">${Math.round(i*xMax/5)}</text>`).join('')}${Array.from({length:6},(_,i)=>`<line x1="28" y1="${174-i*28}" x2="36" y2="${174-i*28}"></line><text x="24" y="${178-i*28}" text-anchor="end">${i*yStep}</text>`).join('')}<circle cx="${cx}" cy="${cy}" r="7"></circle><text x="130" y="204" text-anchor="middle">Input x</text><text x="178" y="20">Output y</text></svg></div>`};
  const ideaRoutes:Record<string,Record<string,number>>={
   'more-patterns-in-division':{'digit sum':1,'combined rules':3,'construct and factors':1,zero:4,reasoning:2},
   'algebraic-expressions':{anatomy:1,translation:2,evaluation:3,context:4,reasoning:2},
   'relationships-in-patterns':{identify:1,extend:2,rule:3,compare:4,reason:2},
   'patterns-tables':{complete:2,rule:3,reverse:4,error:3,context:1},
   'graphing-relations':{plot:3,read:1,interpret:4,compare:4,reason:2},
   'reading-writing-equations':{identify:1,translate:3,context:3,substitute:4,truth:4,reason:2},
   'equations-algebra-tiles':{additive:1,model:2,verify:4,multiplicative:3,reason:2}
  };
  const sample=()=>{const groups=new Map<string,any[]>();bank.forEach((item:any)=>{const key=item.category||'mixed';groups.set(key,[...(groups.get(key)||[]),item])});const chosen=[...groups.values()].map(g=>g[Math.floor(Math.random()*g.length)]);const rest=bank.filter((x:any)=>!chosen.includes(x)).sort(()=>Math.random()-.5);set=[...chosen,...rest].slice(0,count).sort(()=>Math.random()-.5)};
  const render=()=>{sample();if(!list)return;list.innerHTML=set.map((item,index)=>`<fieldset data-check-item data-answer="${item.answer}" data-category="${escape(item.category||'mixed')}"><legend><span>${index+1}</span>${escape(item.prompt)}</legend>${graphVisual(item)}<div class="check-choices">${item.choices.map((choice:string,i:number)=>`<label><input type="radio" name="${root.dataset.lesson}-check-${index}" value="${i}"><span>${escape(choice)}</span></label>`).join('')}</div><p data-reveal hidden></p></fieldset>`).join('');const result=root.querySelector('[data-result]');if(result)result.textContent=`New set ready. Complete all ${count}.`;const routes=root.querySelector<HTMLElement>('[data-routes]');if(routes){routes.hidden=true;routes.innerHTML=''}};
  root.querySelector('[data-new]')?.addEventListener('click',render);
  root.querySelector('[data-submit]')?.addEventListener('click',()=>{
   const items=[...root.querySelectorAll<HTMLElement>('[data-check-item]')];const firstUnanswered=items.find(x=>!x.querySelector('input:checked'));
   if(firstUnanswered){const result=root.querySelector('[data-result]');if(result)result.textContent='Answer the full set before submitting. Your completed choices are still here.';firstUnanswered.querySelector<HTMLInputElement>('input')?.focus();return}
   let score=0;const missed:string[]=[];
   items.forEach((item,index)=>{const selected=Number(item.querySelector<HTMLInputElement>('input:checked')?.value);const ok=selected===Number(item.dataset.answer);if(ok)score++;else missed.push(set[index].category||'mixed');item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);const reveal=item.querySelector<HTMLElement>('[data-reveal]');const correctChoice=set[index].choices[set[index].answer];if(reveal){reveal.hidden=false;reveal.innerHTML=`<strong>${ok?'Correct.':'Review this one.'}</strong> ${escape(set[index].feedback)}${ok?'':` <span>Correct answer: ${escape(correctChoice)}.</span>`}`}});
   const result=root.querySelector('[data-result]');const ratio=score/items.length;if(result)result.innerHTML=`<strong>${score} / ${items.length}.</strong> ${ratio===1?'Ready to extend.':ratio>=.8?'Ready—review the linked ideas you missed.':ratio>=.4?'Revisit the named Understand cards, then try a new set.':'Restart with targeted review, then return to supported practice.'}`;
   const routes=root.querySelector<HTMLElement>('[data-routes]');
   if(routes&&missed.length){const routeMap:Record<string,string>={'Lesson 1.1':'patterns-in-division','Lesson 1.2':'more-patterns-in-division','Lesson 1.3':'algebraic-expressions','Lesson 1.4':'relationships-in-patterns','Lesson 1.5':'patterns-tables','Lesson 1.6':'graphing-relations','Lesson 1.7':'reading-writing-equations','Lesson 1.8':'equations-algebra-tiles'};const unique=[...new Set(missed)];routes.hidden=false;const lessonIdeas=ideaRoutes[root.dataset.lesson||'']||{};routes.innerHTML=root.dataset.lesson==='unit-1-check'?`<strong>Review these lessons next:</strong>${unique.map(category=>routeMap[category]?`<a href="../${routeMap[category]}/#understand">${escape(category)} · Understand</a>`:`<span>${escape(category)}</span>`).join('')}`:`<strong>Review these ideas next:</strong>${unique.map(category=>`<a href="#understand-${lessonIdeas[category]||1}">${escape(category)}</a>`).join('')}`}else if(routes){routes.hidden=true;routes.innerHTML=''}
   result?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});
  });
  render();
 });
</script>
<style>
.independent{border:1px solid #bdd7c5;border-radius:15px;padding:1rem;background:#f8fcf9}.check-head{display:flex;justify-content:space-between;gap:1rem;align-items:center}.check-head>div{display:grid}.check-head span{color:#526174}.check-head button,.submit-all{border:0;border-radius:9px;background:#2b6e3f;color:#fff;padding:.65rem .85rem;font-weight:800}.privacy-note{padding:.7rem;border-left:4px solid #2b6e3f;background:#fff}.independent fieldset{border:0;border-top:1px solid #dce9df;padding:1rem 0;margin:0}.independent legend{display:flex;gap:.6rem;font-weight:850}.independent legend>span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:99px;background:#2b6e3f;color:#fff}.check-choices{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.7rem 0}.check-choices label{display:flex;gap:.5rem;padding:.6rem;border:1px solid #d7e2da;border-radius:9px;background:#fff}.independent fieldset.correct{background:#effaf2}.independent fieldset.incorrect{background:#fff7ed}.independent [data-reveal],.check-result{padding:.65rem;border-radius:9px;background:#fff}.review-routes{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:.65rem;padding:.7rem;border-radius:9px;background:#eaf4ed}.review-routes a{padding:.45rem .6rem;border-radius:7px;background:#fff;color:#205d34;font-weight:800}.independent button:focus-visible,.independent input:focus-visible,.review-routes a:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}@media(max-width:620px){.check-head{align-items:flex-start;flex-direction:column}.check-choices{grid-template-columns:1fr}.review-routes{align-items:stretch;flex-direction:column}}
.check-graph{max-width:330px;margin:.7rem 0;padding:.5rem;border:1px solid #d7e2da;border-radius:10px;background:#fff}.check-graph svg{display:block;width:100%;height:auto}.check-graph line{stroke:#718096}.check-graph .axis{stroke:#263447;stroke-width:2}.check-graph text{fill:#263447;font:700 11px system-ui}.check-graph circle{fill:#c64632;stroke:#fff;stroke-width:2}
</style>
