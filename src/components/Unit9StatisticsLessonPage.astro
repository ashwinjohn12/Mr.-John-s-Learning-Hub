---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit9StatisticsLab from './Unit9StatisticsLab.astro';
import Unit9StatisticsGame from './Unit9StatisticsGame.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';
interface Props { course:Course; unit:Unit; topic:Topic; content:TopicContent; variant:'experiment'|'relative'|'analyze' }
const { course,unit,topic,content,variant }=Astro.props;
const base=import.meta.env.BASE_URL;
const nextHref=content.next.slug&&content.next.status==='ready'?`${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/`:null;
const heroTitle=variant==='experiment'?'Conducting Experiments':variant==='relative'?'Relative Frequency':'Analyzing Relative Frequency';
const heroSubtitle=variant==='experiment'?'Separate what could happen, what is equally likely, and what actually happened.':variant==='relative'?'Turn counts into part-to-whole information you can compare and predict with.':'Use sample size and relative frequency together to judge how much confidence the data deserves.';
const coreConcepts=content.concepts.slice(0,5);const appliedConcepts=content.concepts.slice(5);const coreExamples=content.examples.slice(0,2);const advancedExamples=content.examples.slice(2);
const gameTitle=variant==='experiment'?'Carnival Experiment Inspector':variant==='relative'?'Data Reporter Challenge':'Sample Size Detective';
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} {heroTitle} {heroSubtitle} compactMobileHero mobileHeroSize="clamp(1.9rem,9vw,2.9rem)">
 <LearningSection id="overview" eyebrow="GET READY" title="Get ready for statistics" icon="🎯" tone="idea">
  <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.slice(0,3).map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">TODAY'S MISSION</p><ul>{content.goals.slice(0,4).map(goal=><li>{goal}</li>)}</ul></div></div>
  <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
  <p class="start-note"><strong>Best place to begin:</strong> {variant==='experiment'?'Keep “possible outcomes” separate from the frequencies you actually collect.':variant==='relative'?'Write category count ÷ total before converting anything.':'Compare the relative frequencies first, then ask how much data supports each one.'}</p>
  <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item=><li>{item}</li>)}</ul></details>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
  <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
  <div class="three-step-rule">{variant==='experiment'?<><div><span>1</span><strong>List outcomes</strong><small>What could happen?</small></div><div><span>2</span><strong>Check fairness</strong><small>Do outcomes have equal chance?</small></div><div><span>3</span><strong>Collect data</strong><small>What happened in this sample?</small></div></>:variant==='relative'?<><div><span>1</span><strong>Find the count</strong><small>Frequency for the category.</small></div><div><span>2</span><strong>Compare to total</strong><small>Part ÷ whole.</small></div><div><span>3</span><strong>Represent & use</strong><small>Fraction ↔ decimal ↔ percent.</small></div></>:<><div><span>1</span><strong>Compare proportions</strong><small>Use relative frequency.</small></div><div><span>2</span><strong>Check sample size</strong><small>How much evidence?</small></div><div><span>3</span><strong>Conclude carefully</strong><small>Estimate, don't guarantee.</small></div></>}</div>
  <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
  <div class="concept-grid detailed">{coreConcepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
  {appliedConcepts.length>0&&<details class="applied-concepts"><summary>{variant==='analyze'?'Careful conclusions':'Take the idea further'}</summary><div class="applied-grid">{appliedConcepts.map(concept=><div><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div></details>}
  {variant==='experiment'?<article class="model-card"><p class="eyebrow">KEEP THESE APART</p><div class="model-flow"><span>Possible outcomes<br/><strong>H, T</strong></span><b>≠</b><span>One sample<br/><strong>H,H,T,H,T</strong></span></div><p>A fair coin can produce an uneven sample without changing the possible outcomes or their equal chance.</p></article>:variant==='relative'?<article class="model-card"><p class="eyebrow">PART → WHOLE</p><div class="model-flow"><span>10 out of 40</span><b>=</b><span>10/40</span><b>=</b><span>0.25</span><b>=</b><span>25%</span></div><p>Every form describes the same relative frequency.</p></article>:<article class="model-card"><p class="eyebrow">SAME EXPERIMENT · DIFFERENT EVIDENCE</p><div class="model-flow"><span>8/10<br/><strong>80%</strong></span><b>vs.</b><span>51/100<br/><strong>51%</strong></span></div><p>Percentage matters, but sample size tells you how much data supports that estimate.</p></article>}
  {variant==='analyze'&&<article class="language-card"><p class="eyebrow">STATISTICS SENTENCE STARTER</p><h3>The data suggests…</h3><div><p><strong>Instead of:</strong> “The spinner is unfair.”</p><p><strong>Try:</strong> “The data suggests the spinner may be unfair because…”</p></div><div><p><strong>Instead of:</strong> “Red will happen 25 times.”</p><p><strong>Try:</strong> “Based on the data, we would expect about 25 red outcomes.”</p></div><small>Statistics describes evidence and uncertainty. Strong conclusions avoid words such as “proves,” “always,” and “guaranteed” unless the mathematics truly guarantees the result.</small></article>}
  <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <p class="section-lead">Start with the two core examples. Open Examples 3 and 4 when you are ready for a deeper connection.</p>
  <div class="example-stack">{coreExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
  <details class="advanced-examples"><summary>Ready for more? Open Examples 3 and 4</summary><div class="example-stack advanced-stack">{advancedExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary}/></LearningSection>
 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore"><p class="section-lead">{content.explorePrompt}</p><Unit9StatisticsLab {variant}/><article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p></article></LearningSection>
 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><p class="practice-goal-copy"><strong>Your goal:</strong> complete the set shown below. If you choose a difficulty with fewer available questions, the goal adjusts automatically.</p><PracticeEngine questions={content.questions} sessionCount={6}/></LearningSection>
 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. This bank is separate from supported practice and has no hints.</p><CheckYourself questions={content.checkQuestions} count={5}/></LearningSection>
 <LearningSection id="apply" eyebrow="PLAY & APPLY" title={gameTitle} icon="🎮" tone="play"><p class="section-lead">Rounds 1 and 2 build fast decisions. Round 3 asks you to use the statistics for a real decision or design.</p><Unit9StatisticsGame {variant}/></LearningSection>
 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="summary-card"><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item=><li>{item}</li>)}</ul></div><div class="review-options"><details><summary>Need more help?</summary><ul>{content.support.map(item=><li>{item}</li>)}</ul></details><details><summary>Want an extra challenge?</summary><ul>{content.extension.map(item=><li>{item}</li>)}</ul></details></div><article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show a strong answer</summary><p>{content.pat.answer}</p></details></article><div class="review-grid">{content.review.map(item=><label><input type="checkbox"/> {item}</label>)}</div><div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>Continue when you are ready.</small></div>{nextHref?<a class="button" href={nextHref}>Open →</a>:<span class="coming-next">Coming next</span>}</div></LearningSection>
</Grade6LessonFrame>
<style>
.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.summary-card{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.summary-card ul,.worked-example ol,.hands-on-card ol,.review-options ul{padding-left:1.2rem}.overview-grid li,.summary-card li,.worked-example li,.hands-on-card li,.review-options li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.start-note,.practice-goal-copy{margin:1rem 0 0;padding:.75rem .85rem;border-radius:11px;background:#fff8db}.success-box{margin-top:1rem}.three-step-rule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1rem 0}.three-step-rule>div{display:grid;gap:.25rem;padding:.8rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.three-step-rule span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.three-step-rule small{color:#526174}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.applied-concepts,.advanced-examples{margin-top:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.applied-concepts>summary,.advanced-examples>summary,.review-options summary{cursor:pointer;padding:1rem;font-weight:900}.applied-grid,.advanced-stack{padding:0 1rem 1rem}.worked-example,.hands-on-card,.pat-card,.model-card,.language-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.example-stack{display:grid;gap:1rem}.example-answer{margin-top:.8rem;padding:.75rem;border-radius:10px;background:var(--course-soft)}.model-card{margin-top:1rem;background:#fbfdff}.model-flow{display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap;margin:.8rem 0}.model-flow span{padding:.65rem .8rem;border-radius:11px;background:var(--course-soft);text-align:center}.language-card{margin-top:1rem;background:linear-gradient(135deg,#fff,var(--course-soft))}.language-card h3{margin:.2rem 0 .8rem}.language-card>div{padding:.6rem .7rem;border-radius:10px;background:rgba(255,255,255,.78);margin:.55rem 0}.language-card p{margin:.2rem 0}.language-card small{display:block;margin-top:.7rem;color:#526174}.mixups,.hands-on-card,.pat-card,.review-options{margin-top:1rem}.review-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.review-options details{border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.pat-card{background:#f8fafc}.next-step small{display:block;margin-top:.2rem;color:#64748b}.coming-next{font-weight:900;color:#64748b}@media(max-width:760px){.overview-grid,.three-step-rule,.review-options{grid-template-columns:1fr}}
</style>
