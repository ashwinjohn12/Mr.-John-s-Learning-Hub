<div class="game" data-ratio-game>
  <div class="game-head"><div><p class="eyebrow">RECIPE REMIX</p><h3>Keep the flavour the same</h3><p>Scale each recipe without changing the ingredient relationship.</p></div><div class="meter"><strong data-round-label>Round 1 of 3</strong><span><i data-progress></i></span></div></div>
  <section data-round="1" class="round active"><p class="round-tag">ROUND 1 · SCALE UP</p><h3>A smoothie uses 2 scoops fruit for every 3 scoops yogurt. You want 8 scoops of fruit. How much yogurt?</h3><div class="choices"><button data-choice="9">9 scoops</button><button data-choice="10">10 scoops</button><button data-choice="12">12 scoops</button><button data-choice="14">14 scoops</button></div><p class="feedback" data-feedback></p></section>
  <section data-round="2" class="round" hidden><p class="round-tag">ROUND 2 · KEEP THE MIX</p><h3>A trail mix uses 3 cups cereal for every 2 cups raisins. Which larger batch has the same relationship?</h3><div class="choices"><button data-choice="a">6 cereal : 5 raisins</button><button data-choice="b">9 cereal : 6 raisins</button><button data-choice="c">12 cereal : 10 raisins</button><button data-choice="d">15 cereal : 8 raisins</button></div><p class="feedback" data-feedback></p></section>
  <section data-round="3" class="round" hidden><p class="round-tag">ROUND 3 · FIX THE RECIPE</p><h3>A soup recipe is 4 cups broth : 3 cups vegetables. Someone writes 12 : 8 for a triple batch. What should the second term be?</h3><div class="answer-row"><input type="number" data-final-answer aria-label="Correct vegetable amount"><button data-final-check>Check recipe</button></div><p class="feedback" data-feedback></p></section>
  <div class="complete" data-complete hidden><p class="eyebrow">MISSION COMPLETE</p><h3>🏆 Ratio Recipe Master</h3><p>You kept every recipe proportional by scaling both terms together.</p><button type="button" data-restart>Play again</button></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-ratio-game]').forEach(game=>{let round=1;const progress=game.querySelector<HTMLElement>('[data-progress]');const label=game.querySelector('[data-round-label]');const show=(n:number)=>{round=n;game.querySelectorAll<HTMLElement>('[data-round]').forEach(el=>{const active=Number(el.dataset.round)===n;el.hidden=!active;el.classList.toggle('active',active)});if(progress)progress.style.width=`${(n-1)/3*100}%`;if(label)label.textContent=`Round ${n} of 3`;};const advance=(section:HTMLElement,msg:string)=>{const f=section.querySelector<HTMLElement>('[data-feedback]');if(f)f.innerHTML=`<strong>Correct.</strong> ${msg}`;setTimeout(()=>show(round+1),450)};game.querySelector('[data-round="1"]')?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="1"]')!;if(b.dataset.choice==='12')advance(s,'2 became 8 by ×4, so 3 × 4 = 12.');else{s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> Find the scale factor from 2 to 8 first.';}}));game.querySelector('[data-round="2"]')?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="2"]')!;if(b.dataset.choice==='b')advance(s,'3 : 2 scaled by ×3 becomes 9 : 6.');else{s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> Both terms need the same scale factor.';}}));const final=game.querySelector<HTMLInputElement>('[data-final-answer]');game.querySelector('[data-final-check]')?.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="3"]')!;if(Number(final?.value)===9){s.hidden=true;game.querySelector<HTMLElement>('[data-complete]')!.hidden=false;if(progress)progress.style.width='100%';if(label)label.textContent='3 rounds complete';}else{s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> A triple batch multiplies both 4 and 3 by 3.';}});game.querySelector('[data-restart]')?.addEventListener('click',()=>{game.querySelector<HTMLElement>('[data-complete]')!.hidden=true;if(final)final.value='';game.querySelectorAll<HTMLElement>('[data-feedback]').forEach(f=>f.textContent='');show(1)});show(1);});
</script>
<style>.game{border:1px solid #d9e2ec;border-radius:18px;background:#fff;padding:1rem}.game-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.game-head h3{margin:.2rem 0}.meter{min-width:170px;display:grid;gap:.35rem;font-size:.78rem;font-weight:900}.meter>span{height:9px;background:#e8edf3;border-radius:999px;overflow:hidden}.meter i{display:block;height:100%;background:var(--course);transition:width .25s}.round{margin-top:1rem;padding:1rem;border-radius:14px;background:#f8fafc}.round-tag{font-size:.72rem;font-weight:900;letter-spacing:.06em;color:#64748b}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.choices button,.answer-row button,.complete button{border:0;border-radius:11px;padding:.75rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.answer-row{display:flex;gap:.6rem}.answer-row input{flex:1;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.feedback{min-height:26px;padding-top:.6rem}.complete{text-align:center;padding:1.4rem}.complete h3{font-size:1.5rem}@media(max-width:650px){.game-head,.choices{display:grid}.answer-row{display:grid}}</style>