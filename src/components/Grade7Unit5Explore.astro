---
import type{Unit5Lesson}from'../data/grade7Unit5';const{lesson}=Astro.props as{lesson:Unit5Lesson};
const C:any={
'models-add-fractions':['strips','add',[[1,2,1,4],[2,3,1,6],[3,8,1,4],[1,3,1,6],[1,4,1,8]],['3/4','5/6','5/8','1/2','3/8'],'unequal parts'],
'other-models-add-fractions':['line and set','add',[[1,3,1,4],[2,5,1,10],[1,2,1,8],[3,8,1,6],[4,7,1,14]],['7/12','1/2','5/8','13/24','9/14'],'scale'],
'symbols-add-fractions':['equivalence table','add',[[3,4,5,6],[2,5,3,7],[5,12,1,4],[7,9,5,12],[5,16,7,24]],['19/12','29/35','2/3','43/36','29/48'],'renaming'],
'models-subtract-fractions':['take-away strip','subtract',[[5,8,1,4],[3,4,2,5],[7,10,1,5],[11,12,1,3],[5,6,1,4]],['3/8','7/20','1/2','7/12','7/12'],'direction'],
'symbols-subtract-fractions':['inverse board','subtract',[[7,8,1,6],[11,12,1,3],[5,6,1,2],[4,5,3,10],[13,14,2,7]],['17/24','7/12','1/3','1/2','9/14'],'common denominator'],
'adding-mixed-numbers':['composition tray','add',[[9,4,3,2],[11,6,8,3],[11,5,7,4],[27,8,9,4],[17,6,14,9]],['15/4','9/2','79/20','45/8','79/18'],'composed whole'],
'subtracting-mixed-numbers':['regrouping blocks','subtract',[[21,4,11,4],[19,3,11,4],[38,5,11,5],[30,7,12,7],[17,2,29,8]],['5/2','43/12','27/5','18/7','39/8'],'regrouped whole']};const c=C[lesson.slug];
---
<div class="lab" data-unit5-explore data-config={JSON.stringify(c)}><header><p>{lesson.explore.launch}</p><strong>Core: Predict → Build → Verify · Consolidation: Repair · Extension: Create</strong></header><div class="tabs" role="tablist" aria-label={`${lesson.explore.title} phases`}>{lesson.explore.phases.map((p,i)=><button id={`${lesson.slug}-tab-${i}`} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${lesson.slug}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{i+1}. {p.title}</button>)}</div>
{lesson.explore.phases.map((p,i)=><section id={`${lesson.slug}-panel-${i}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${i}`} data-phase={i} hidden={i!==0}><h3 tabindex="-1">{p.title}</h3><p>{p.instruction}</p><p><b>Target:</b> {c[2][i][0]}/{c[2][i][1]} {c[1]==='add'?'+':'−'} {c[2][i][2]}/{c[2][i][3]} → {c[3][i]}</p>{i===0?<label>Checkable decimal estimate<input data-predict inputmode="decimal"/></label>:<fieldset><legend>Operable fraction controls</legend>{['First numerator','First denominator','Second numerator','Second denominator'].map((x,j)=><label>{x}<input data-value={j} inputmode="numeric" value={i===3&&j===1?c[2][i][j]+1:''}/></label>)}<button type="button" data-build>Build model</button><button type="button" data-operate disabled>Operate</button></fieldset>}<div class={`fraction-model ${c[0]}`} data-model role="img" aria-label="Model not built"><div data-visual></div><p data-transcript>Model transcript: not built.</p></div>{i===3&&<label>First mathematical error<select data-repair><option value="">Choose</option><option>{c[4]}</option><option>colour choice</option><option>page title</option></select></label>}{i>0&&<label>Exact simplified checkpoint<input data-checkpoint placeholder="for example 7/12"/></label>}<label>Evidence for student or teacher review<textarea data-evidence rows="2"></textarea></label><button type="button" data-verify>Verify phase</button><p data-status role="status">Not verified.</p></section>)}<p data-progress role="status">0 of 3 core phases verified.</p></div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit5-explore]').forEach(root=>{const c=JSON.parse(root.dataset.config||'[]'),tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-tab]')],panels=[...root.querySelectorAll<HTMLElement>('[data-phase]')],passed=new Set<number>(),built=new Set<number>(),operated=new Set<number>(),g=(a:number,b:number):number=>b?g(b,a%b):Math.abs(a),pf=(v:string)=>{const m=v.trim().match(/^(?:(\d+)\s+)?(\d+)\/(\d+)$/);if(m)return Number(m[3])?Number(m[1]||0)+Number(m[2])/Number(m[3]):NaN;return /^\d+(?:\.\d+)?$/.test(v.trim())?Number(v):NaN},eq=(a:string,b:string)=>Math.abs(pf(a)-pf(b))<1e-6,progress=()=>{const n=[0,1,2].filter(x=>passed.has(x)).length;root.querySelector<HTMLElement>('[data-progress]')!.textContent=`${n} of 3 core phases verified.${n===3?' Core Explore complete.':''}`},activate=(i:number,focus=true)=>{tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1});panels.forEach((p,j)=>p.hidden=i!==j);if(focus)panels[i].querySelector<HTMLElement>('h3')?.focus()};tabs.forEach((t,i)=>{t.onclick=()=>activate(i);t.onkeydown=e=>{let j=i;if(e.key==='ArrowRight')j=(i+1)%5;else if(e.key==='ArrowLeft')j=(i+4)%5;else if(e.key==='Home')j=0;else if(e.key==='End')j=4;else return;e.preventDefault();activate(j,false);tabs[j].focus()}});const invalidate=(i:number)=>{for(let j=i;j<5;j++){passed.delete(j);built.delete(j);operated.delete(j);const p=panels[j];p.querySelector<HTMLElement>('[data-visual]')!.innerHTML='';p.querySelector<HTMLElement>('[data-transcript]')!.textContent='Model transcript: not built.';p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label','Model not built.');p.querySelector<HTMLElement>('[data-status]')!.textContent=j===i?'Evidence changed. Rebuild and verify.':'Earlier evidence changed. Reverify dependencies.'}progress()};panels.forEach((p,i)=>{p.querySelectorAll('input,select,textarea').forEach(x=>{x.addEventListener('input',()=>{if([...passed,...built,...operated].some(j=>j>=i))invalidate(i)});x.addEventListener('change',()=>{if([...passed,...built,...operated].some(j=>j>=i))invalidate(i)})});const vals=()=>[...p.querySelectorAll<HTMLInputElement>('[data-value]')].map(x=>Number(x.value));p.querySelector('[data-build]')?.addEventListener('click',()=>{const v=vals(),target=c[2][i],repair=p.querySelector<HTMLSelectElement>('[data-repair]')?.value,result=c[1]==='add'?v[0]/v[1]+v[2]/v[3]:Math.abs(v[0]/v[1]-v[2]/v[3]),positive=v.length===4&&v.every(x=>Number.isInteger(x)&&x>0)&&(/composition|regrouping/.test(c[0])||(v[0]<v[1]&&v[2]<v[3])),matches=v.every((x,j)=>x===target[j]),valid=i===4?positive&&Math.abs(result-pf(c[3][i]))<1e-6&&!matches:positive&&matches&&(i!==3||repair===c[4]);if(!valid){p.querySelector<HTMLElement>('[data-status]')!.textContent=i===4?'Create different positive proper fractions whose operation reaches the exact target.':i===3?'Identify the first error and restore all target values.':'Controls must match the stated fractions.';return}built.add(i);const common=v[1]*v[3]/g(v[1],v[3]),n1=v[0]*common/v[1],n2=v[2]*common/v[3];p.querySelector<HTMLElement>('[data-visual]')!.innerHTML=`<div class="strip" style="--parts:${common}">${Array.from({length:common},(_,k)=>`<i class="${k<n1?'a':k<(c[1]==='add'?n1+n2:n1)?'b':''}"></i>`).join('')}</div><b>${n1}/${common} ${c[1]==='add'?'+':'−'} ${n2}/${common}</b>`;const text=`${c[0]} model: ${v[0]}/${v[1]} ${c[1]} ${v[2]}/${v[3]}, renamed in ${common} equal parts.`;p.querySelector<HTMLElement>('[data-transcript]')!.textContent=`Model transcript: ${text}`;p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label',text);p.querySelector<HTMLButtonElement>('[data-operate]')!.disabled=false;p.querySelector<HTMLElement>('[data-status]')!.textContent='Model built. Operate, then verify.'});p.querySelector('[data-operate]')?.addEventListener('click',()=>{if(built.has(i)){operated.add(i);p.querySelector<HTMLElement>('[data-status]')!.textContent=`Operation completed. Enter ${c[3][i]} or an equivalent exact form.`}});p.querySelector('[data-verify]')?.addEventListener('click',()=>{const evidence=p.querySelector<HTMLTextAreaElement>('[data-evidence]')!.value.trim();let ok=i===0?Math.abs(Number(p.querySelector<HTMLInputElement>('[data-predict]')!.value)-pf(c[3][i]))<=.25:built.has(i)&&operated.has(i)&&eq(p.querySelector<HTMLInputElement>('[data-checkpoint]')!.value,c[3][i]);if(!evidence){p.querySelector<HTMLElement>('[data-status]')!.textContent='Record evidence for review; wording is not graded.';return}if(ok){passed.add(i);p.dataset.verified='true';p.querySelector<HTMLElement>('[data-status]')!.textContent='Verified. Model, operation, checkpoint, and evidence agree.'}else p.querySelector<HTMLElement>('[data-status]')!.textContent=i===0?'Enter a specific reasonable estimate.':'Build and operate the target, then enter an equivalent exact fraction.';progress()})})});
</script>
<style>.lab{border:1px solid #c8d8ea;border-radius:15px;overflow:hidden;background:#f8fbff}.lab header,.lab section,.lab>[data-progress]{padding:1rem}.tabs{display:flex;overflow-x:auto;border-block:1px solid #c8d8ea}.tabs button{min-height:48px;min-width:145px;border:0;background:#eaf2fb;font-weight:800}.tabs button[aria-selected=true]{background:#2457c5;color:#fff}.lab label{display:grid;gap:.3rem;margin:.55rem 0;font-weight:750}.lab input,.lab select,.lab textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.6rem;font:inherit}.lab fieldset{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.lab button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#2457c5;color:#fff;font-weight:800}.fraction-model{padding:.75rem;border-radius:10px;background:#fff}.strip{display:grid;grid-template-columns:repeat(var(--parts),minmax(8px,1fr));height:58px;border:2px solid #20344a}.strip i{border-right:1px solid #60758a}.strip .a{background:#6aa7e8}.strip .b{background:#f4c95d}.lab :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:620px){.lab fieldset{grid-template-columns:1fr}.tabs button{min-width:132px}}@media(max-width:390px){.lab header,.lab section{padding:.75rem}.strip{overflow-x:auto}}@media(prefers-reduced-motion:reduce){.lab *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>
