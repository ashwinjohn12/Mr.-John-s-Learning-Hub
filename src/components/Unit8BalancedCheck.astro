---
import type { PracticeQuestion } from '../data/topicContent';
interface Group { label:string; questions:readonly PracticeQuestion[]; count:number }
interface Props { groups:Group[] }
const { groups }=Astro.props;const total=groups.reduce((s,g)=>s+g.count,0);
---
<div class="check-widget" data-unit8-balanced-check data-count={total}>
 <div class="check-top"><div><p class="eyebrow">WHOLE-UNIT CHECK</p><h3>Balanced {total}-question check</h3><p>Every set includes exactly 3 questions from 8.1, 8.2, and 8.3.</p></div><span data-score>0 / {total}</span></div>
 <div data-stage aria-live="polite"></div><div class="actions"><button type="button" data-next disabled>Next</button><button type="button" class="soft" data-restart>New balanced set</button></div><script type="application/json" data-data set:html={JSON.stringify(groups)}></script>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit8-balanced-check]').forEach(widget=>{const groups=JSON.parse(widget.querySelector('[data-data]')?.textContent||'[]'),total=Number(widget.dataset.count||9),stage=widget.querySelector<HTMLElement>('[data-stage]'),score=widget.querySelector('[data-score]'),next=widget.querySelector<HTMLButtonElement>('[data-next]'),restart=widget.querySelector<HTMLButtonElement>('[data-restart]');let pool:any[]=[],index=0,correct=0,answered=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(groups.flatMap((g:any)=>shuffle(g.questions).slice(0,Math.min(g.count,g.questions.length)).map((q:any)=>({...q,lessonLabel:g.label}))));const render=()=>{if(index>=pool.length){if(stage)stage.innerHTML=`<div class="finish"><p class="eyebrow">SET COMPLETE</p><h3>You scored ${correct} / ${pool.length}</h3><p>${correct===pool.length?'Excellent. You connected functions across the entire unit.':correct>=Math.ceil(pool.length*.75)?'Strong work. Use the lesson label on anything you missed, then target that lesson from the map above.':'Use the lesson labels on missed questions and review those ideas before trying a new balanced set.'}</p></div>`;if(next)next.disabled=true;return;}const q=pool[index];answered=false;if(next)next.disabled=true;if(stage)stage.innerHTML=`<div class="meta"><span>Question ${index+1} of ${pool.length}</span><span>${q.lessonLabel}</span></div><h3>${q.prompt}</h3><div class="choices">${q.choices.map((c:string,i:number)=>`<button type="button" data-choice="${i}"><span>${String.fromCharCode(65+i)}</span>${c}</button>`).join('')}</div><div class="feedback" data-feedback></div>`;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>answer(Number(b.dataset.choice))));if(score)score.textContent=`${correct} / ${pool.length}`;};const answer=(choice:number)=>{if(answered)return;answered=true;const q=pool[index],ok=choice===q.answer;if(ok)correct++;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect')});const f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f)f.innerHTML=`<strong>${ok?'Correct!':'Not quite.'}</strong> ${q.explain}`;if(score)score.textContent=`${correct} / ${pool.length}`;if(next)next.disabled=false;};const reset=()=>{pool=build().slice(0,total);index=0;correct=0;render();};next?.addEventListener('click',()=>{index++;render();});restart?.addEventListener('click',reset);reset();});
</script>
<style>.check-widget{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.check-top{display:flex;justify-content:space-between;gap:1rem;align-items:start;border-bottom:1px solid #e8edf3;padding-bottom:.8rem}.check-top h3{margin:.2rem 0}.check-top p{margin:.2rem 0;color:#64748b}.check-top>span{font-weight:900;white-space:nowrap}.meta{display:flex;justify-content:space-between;gap:.8rem;margin:1rem 0 .2rem;color:#5f6f84;font-size:.78rem;font-weight:900;text-transform:uppercase}.choices{display:grid;gap:.55rem;margin:1rem 0}.choices button{display:flex;gap:.65rem;align-items:center;text-align:left;border:1px solid #d9e1eb;border-radius:12px;background:#fff;padding:.72rem;cursor:pointer}.choices button span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#eef3f9;font-weight:800}.choices button.correct{border-color:#22c55e;background:#f0fdf4}.choices button.incorrect{border-color:#ef4444;background:#fef2f2}.feedback{min-height:28px}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.actions .soft{background:#eef3f9;color:#25364f}.actions button:disabled{opacity:.45}.finish{padding:1rem 0}@media(max-width:650px){.check-top,.meta{display:grid}}</style>
