<div class="arcade" data-unit8-arcade>
 <div class="arcade-head"><div><p class="eyebrow">FUNCTION LAB ARCADE</p><h3>6 free-response missions · 2 from each lesson</h3><p>No answer choices. Trace the relationship, calculate, and enter the number only.</p></div><div class="stats"><span data-score>0 pts</span><span data-streak>0 streak</span></div></div>
 <div class="progress"><span data-progress></span></div><div data-stage aria-live="polite"></div><div class="actions"><button type="button" data-check>Check mission</button><button type="button" data-next hidden>Next mission →</button><button type="button" class="soft" data-restart>New quest</button></div>
</div>
<script>
const banks:any[]=[
 {label:'8.1 · Function Relationships',missions:[
  {prompt:'In a function, how many different outputs may one specific input have?',answer:1,explain:'Exactly one. That is the defining input-output condition.'},
  {prompt:'Inputs 1, 2, 3 produce outputs 5, 8, 11. If the same rule continues, what output should input 4 produce?',answer:14,explain:'The outputs increase by 3 each time, so 11+3=14.'},
  {prompt:'Rule y=3x+2. What output is produced by input 6?',answer:20,explain:'3(6)+2=20.'},
  {prompt:'A constant-output function always gives y=7. What output does input −50 produce?',answer:7,explain:'Every input maps to the one output 7.'}
 ]},
 {label:'8.2 · Representing Functions',missions:[
  {prompt:'The point for x=5 follows y=2x+1. Enter its y-coordinate.',answer:11,explain:'2(5)+1=11, so the point is (5,11).'},
  {prompt:'A table has outputs 5, 9, 13 for inputs 1, 2, 3. If the same pattern continues, what output belongs to input 5?',answer:21,explain:'The outputs rise by 4: 13, 17, 21. So the pair is (5,21).'},
  {prompt:'A table follows y=3x−2. Enter y when x=4.',answer:10,explain:'3(4)−2=10.'},
  {prompt:'A graph should follow y=x+6. A point is plotted at (4,9). What y-coordinate should it have?',answer:10,explain:'4+6=10, so the point should be (4,10).'}
 ]},
 {label:'8.3 · Solving with Functions',missions:[
  {prompt:'For y=5x+2, the output is 42. Find the input x.',answer:8,explain:'42−2=40; 40÷5=8.'},
  {prompt:'A taxi costs $3 per kilometre plus $5. The total fare is $29. How many kilometres?',answer:8,explain:'29−5=24; 24÷3=8 km.'},
  {prompt:'For y=4x+3, find y when x=7.',answer:31,explain:'4(7)+3=31.'},
  {prompt:'Savings follow y=10x+25. Total savings are $105. Find x.',answer:8,explain:'105−25=80; 80÷10=8.'}
 ]}
];
document.querySelectorAll<HTMLElement>('[data-unit8-arcade]').forEach(widget=>{const stage=widget.querySelector<HTMLElement>('[data-stage]'),scoreEl=widget.querySelector('[data-score]'),streakEl=widget.querySelector('[data-streak]'),progress=widget.querySelector<HTMLElement>('[data-progress]'),check=widget.querySelector<HTMLButtonElement>('[data-check]'),next=widget.querySelector<HTMLButtonElement>('[data-next]'),restart=widget.querySelector<HTMLButtonElement>('[data-restart]');let pool:any[]=[],index=0,score=0,streak=0,locked=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(banks.flatMap(group=>shuffle(group.missions).slice(0,2).map((m:any)=>({...m,label:group.label}))));const norm=(v:string)=>Number(v.trim().replace(/,/g,''));const render=()=>{if(index>=pool.length){if(stage)stage.innerHTML=`<div class="finish"><div class="trophy">🏆</div><p class="eyebrow">QUEST COMPLETE</p><h3>${score>=550?'Function Master':'Function Explorer'}</h3><p>You earned ${score} points across all three lessons. Start a new quest for different missions.</p></div>`;if(check)check.hidden=true;if(next)next.hidden=true;if(progress)progress.style.width='100%';return;}const q=pool[index];locked=false;if(check){check.hidden=false;check.disabled=false;}if(next)next.hidden=true;if(stage)stage.innerHTML=`<div class="meta"><span>Mission ${index+1} of ${pool.length}</span><span>${q.label}</span></div><h3>${q.prompt}</h3><label class="answer-box">Your answer <input type="text" inputmode="decimal" data-answer autocomplete="off"/></label><div class="feedback" data-feedback hidden></div>`;if(progress)progress.style.width=`${(index/pool.length)*100}%`;};const submit=()=>{if(locked)return;const input=stage?.querySelector<HTMLInputElement>('[data-answer]');if(!input||input.value.trim()==='')return;locked=true;const q=pool[index],value=norm(input.value),ok=Math.abs(value-q.answer)<0.001;if(ok){streak++;score+=100+Math.max(0,streak-1)*10;}else streak=0;const f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>${ok?'Mission solved!':'Not yet.'}</strong> ${q.explain}`;}input.disabled=true;if(scoreEl)scoreEl.textContent=`${score} pts`;if(streakEl)streakEl.textContent=`${streak} streak`;if(check)check.disabled=true;if(next){next.hidden=false;next.textContent=index===pool.length-1?'Finish quest':'Next mission →';}if(progress)progress.style.width=`${((index+1)/pool.length)*100}%`;};const reset=()=>{pool=build();index=0;score=0;streak=0;if(scoreEl)scoreEl.textContent='0 pts';if(streakEl)streakEl.textContent='0 streak';if(check)check.hidden=false;render();};check?.addEventListener('click',submit);next?.addEventListener('click',()=>{index++;render();});restart?.addEventListener('click',reset);reset();});
</script>
<style>.arcade{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.arcade-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.arcade-head h3{margin:.2rem 0}.arcade-head p{margin:.2rem 0;color:#64748b}.stats{display:flex;gap:.45rem;flex-wrap:wrap}.stats span{padding:.4rem .55rem;border-radius:9px;background:var(--course-soft);font-weight:900;white-space:nowrap}.progress{height:9px;border-radius:99px;background:#e9eef5;overflow:hidden;margin:.8rem 0}.progress span{display:block;height:100%;width:0;background:var(--course);transition:width .25s}.meta{display:flex;justify-content:space-between;gap:.8rem;margin:.8rem 0 .2rem;color:#64748b;font-size:.78rem;font-weight:900;text-transform:uppercase}.answer-box{display:grid;gap:.35rem;margin:1rem 0;font-weight:850}.answer-box input{max-width:260px;border:2px solid #ccd6e2;border-radius:11px;padding:.72rem;font:inherit}.feedback{padding:.75rem;border-radius:11px;background:#f7f9fc}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.actions .soft{background:#eef3f9;color:#25364f}.actions button:disabled{opacity:.45}.finish{text-align:center;padding:1.2rem}.trophy{font-size:2.4rem}@media(max-width:650px){.arcade-head,.meta{display:grid}.stats{justify-content:start}}</style>
