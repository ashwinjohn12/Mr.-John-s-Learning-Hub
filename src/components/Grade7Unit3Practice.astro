---
import type { Unit3Question } from '../data/grade7Unit3';
interface Props{questions:Unit3Question[];lesson:string}
const {questions,lesson}=Astro.props;
const rotate=(item:Unit3Question,shift:number):Unit3Question=>{const n=shift%item.choices.length;return n?{...item,choices:[...item.choices.slice(-n),...item.choices.slice(0,-n)],answer:(item.answer+n)%item.choices.length}:item};
const displayQuestions=questions.map((item,index)=>rotate(item,index+lesson.length));
const hintTwo=(item:Unit3Question)=>item.hint2||(()=>{const numbers=item.prompt.match(/[+−-]?\d+/g)?.slice(0,3).join(', ')||'the named values',topic=`${item.prompt} ${item.category||''}`;if(/chip|tile|pair|model/i.test(topic))return `For ${numbers}, write positive and negative chip counts separately. Cancel or add only complete zero pairs, then inspect the remaining chip type before choosing.`;if(/line|route|endpoint|change|distance/i.test(topic))return `Mark the starting value and turn the signed action into a direction and interval count. Compute the landing point before comparing choices.`;if(/subtract|opposite|rewrite/i.test(topic))return `Keep the first integer unchanged, replace subtraction with addition of the opposite, and calculate that intermediate expression before selecting.`;return `Translate ${numbers} into signed quantities and calculate one intermediate result. Use its sign and magnitude to eliminate choices without revealing the final response.`;})();
---
<div class="supported" data-unit3-practice data-lesson={lesson}>
 <div class="practice-progress"><strong data-practice-count>0 / {displayQuestions.length} complete</strong><span>One question at a time · {displayQuestions.length===20?'five sets of four':'two stages of four'}</span></div>
 {displayQuestions.map((item,index)=><fieldset class="practice-item" data-item data-answer={item.answer} data-explanation={item.feedback} data-misconception={hintTwo(item)} data-route={item.route} hidden={index!==0}><legend tabindex="-1"><span>{index+1}</span><span>{item.prompt}<small>{displayQuestions.length===20?`Set ${Math.floor(index/4)+1} of 5`:`Stage ${Math.floor(index/4)+1} of 2`}</small></span></legend><div class="choice-grid">{item.choices.map((choice,i)=><label><input type="radio" name={`${lesson}-practice-${index}`} value={i}/><span>{choice}</span></label>)}</div><div class="practice-actions"><button type="button" data-check>Check answer</button><button type="button" class="hint" data-hint="1" aria-expanded="false">Hint 1</button><button type="button" class="hint" data-hint="2" aria-expanded="false">Hint 2</button></div><p class="item-feedback" data-feedback role="status">Choose an answer, then check it.</p><div class="hint-ladder"><p data-hint-copy="1" hidden>{item.hint||'Name what each signed number represents before calculating.'}</p><p data-hint-copy="2" hidden>{hintTwo(item)}</p></div></fieldset>)}
 <div class="practice-navigation"><button type="button" data-practice-prev disabled>← Previous</button><span data-practice-position>Question 1 of {displayQuestions.length}</span><button type="button" data-practice-next>Next →</button></div>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit3-practice]').forEach(root=>{const items=[...root.querySelectorAll<HTMLElement>('[data-item]')];let current=0;const update=()=>{const label=root.querySelector<HTMLElement>('[data-practice-count]');if(label)label.textContent=`${items.filter(x=>x.dataset.complete==='true').length} / ${items.length} complete`;};const show=(index:number,focus=false)=>{current=Math.max(0,Math.min(items.length-1,index));items.forEach((item,i)=>item.hidden=i!==current);const position=root.querySelector<HTMLElement>('[data-practice-position]');if(position)position.textContent=`Question ${current+1} of ${items.length}${items.length===20?` · Set ${Math.floor(current/4)+1}`:''}`;const prev=root.querySelector<HTMLButtonElement>('[data-practice-prev]'),next=root.querySelector<HTMLButtonElement>('[data-practice-next]');if(prev)prev.disabled=current===0;if(next)next.disabled=current===items.length-1;if(focus)items[current]?.querySelector<HTMLElement>('legend')?.focus();};items.forEach(item=>{item.querySelectorAll<HTMLInputElement>('input').forEach(input=>input.addEventListener('change',()=>{if(item.dataset.complete!==undefined){item.dataset.complete='false';item.classList.remove('correct','incorrect');const feedback=item.querySelector<HTMLElement>('[data-feedback]');if(feedback)feedback.textContent='Answer changed. Check the new response.';update();}}));item.querySelectorAll<HTMLButtonElement>('[data-hint]').forEach(button=>button.addEventListener('click',()=>{const level=button.dataset.hint,hint=item.querySelector<HTMLElement>(`[data-hint-copy="${level}"]`);if(!hint)return;hint.hidden=!hint.hidden;button.setAttribute('aria-expanded',String(!hint.hidden));button.textContent=hint.hidden?`Hint ${level}`:`Hide hint ${level}`;}));item.querySelector('[data-check]')?.addEventListener('click',()=>{const selected=item.querySelector<HTMLInputElement>('input:checked'),feedback=item.querySelector<HTMLElement>('[data-feedback]');if(!selected){if(feedback)feedback.textContent='Choose one response first.';item.querySelector<HTMLInputElement>('input')?.focus();return;}const ok=Number(selected.value)===Number(item.dataset.answer);item.dataset.complete=String(ok);item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);const correct=item.querySelectorAll<HTMLLabelElement>('.choice-grid label')[Number(item.dataset.answer)]?.textContent?.trim();if(feedback)feedback.innerHTML=ok?`<strong>Correct.</strong> ${item.dataset.explanation} <span>Verified answer: ${correct}.</span>`:`<strong>Not yet.</strong> ${item.dataset.misconception} Revise before revealing the answer. ${item.dataset.route?`<a href="${item.dataset.route}">Review the exact lesson section</a>.`:""}`;update();});});root.querySelector('[data-practice-prev]')?.addEventListener('click',()=>show(current-1,true));root.querySelector('[data-practice-next]')?.addEventListener('click',()=>show(current+1,true));show(0);});
</script>
<style>
.supported{display:grid;gap:1rem}.practice-progress{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:.85rem 1rem;border-radius:12px;background:#eef6ff}.practice-progress span{color:#526174}.practice-item{border:1px solid #dbe4ef;border-radius:14px;padding:1rem;margin:0;background:#fff}.practice-item.correct{border-left:6px solid #2b6e3f;background:#f2fbf5}.practice-item.incorrect{border-left:6px solid #b85c1e;background:#fff9f3}.practice-item legend{display:flex;gap:.65rem;align-items:flex-start;font-weight:850}.practice-item legend>span:first-child{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:50%;background:#2457c5;color:#fff}.practice-item legend small{display:block;color:#617086;font-weight:650}.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem;margin:.8rem 0}.choice-grid label{display:flex;align-items:center;gap:.55rem;padding:.65rem;border:1px solid #dce3eb;border-radius:10px;background:#fff}.practice-actions,.practice-navigation{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.practice-actions button,.practice-navigation button{border:0;border-radius:9px;background:#2457c5;color:#fff;padding:.65rem .8rem;font-weight:800;min-height:44px}.practice-actions .hint,.practice-navigation button{background:#e8edf4;color:#24344a}.practice-navigation{justify-content:space-between}.practice-navigation button:disabled{opacity:.45}.item-feedback,.hint-ladder p{margin:.7rem 0 0;padding:.65rem;border-radius:9px;background:#f5f7fa}.supported button:focus-visible,.supported input:focus-visible,.practice-item legend:focus-visible{outline:3px solid #2563eb;outline-offset:2px}@media(max-width:620px){.practice-progress,.choice-grid{grid-template-columns:1fr}.practice-navigation{align-items:stretch;flex-direction:column}.practice-navigation button{width:100%}.practice-actions button{flex:1 1 100%}}
</style>
