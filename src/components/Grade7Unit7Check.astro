---
import type{Unit7Question}from'../data/grade7Unit7';
interface Props{bank:Unit7Question[];lesson:string;count?:number;balancedUnit?:boolean}
const{bank,lesson,count=5,balancedUnit=false}=Astro.props;
---
<div class="independent" data-unit7-check data-bank={JSON.stringify(bank)} data-lesson={lesson} data-count={count} data-balanced={String(balancedUnit)}>
 <div class="check-head"><div><strong>Fresh {count}-question set</strong><span>{balancedUnit?'Every attempt represents all six lessons; four lessons receive a second question and the extra positions rotate.':'A varied sample from this lesson’s separate 30-question bank.'}</span></div><button type="button" data-new>Generate new set</button></div>
 <p>Submit the complete set before any result, answer, or explanation appears.</p><div data-list></div><button class="submit" type="button" data-submit>Submit all {count}</button><p data-result role="status" tabindex="-1">No answers submitted yet.</p><div data-scores hidden></div><div data-routes hidden></div>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit7-check]').forEach(root=>{const source=JSON.parse(root.dataset.bank||'[]'),list=root.querySelector<HTMLElement>('[data-list]')!,count=Number(root.dataset.count||5),balanced=root.dataset.balanced==='true';let set:any[]=[];let generation=0;
 const esc=(s:any)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]||c));
 const shuffle=(a:any[])=>{const x=[...a];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}return x};
 const typeOf=(q:any)=>q.responseType||'choice';
 const randomize=(q:any)=>{if(typeOf(q)==='number')return{...q};const correct=new Set(q.answers||[q.answer]),opts=q.choices.map((label:string,i:number)=>({label,ok:correct.has(i)})),mix=shuffle(opts);return{...q,choices:mix.map((x:any)=>x.label),answer:mix.findIndex((x:any)=>x.ok),answers:mix.map((x:any,i:number)=>x.ok?i:-1).filter((i:number)=>i>=0)}};
 const visual=(v:any)=>{if(!v)return'';if(v.type==='bars'){const max=Math.max(...v.values,1);return`<figure class="q-model"><figcaption>${esc(v.title)}</figcaption><div class="bars" role="img" aria-label="${esc(v.transcript)}">${v.values.map((n:number,i:number)=>`<span><i style="height:${Math.max(8,n/max*96)}px"></i><b>${esc(v.labels?.[i]??i+1)}</b><em>${n}</em></span>`).join('')}</div><p>${esc(v.transcript)}</p></figure>`}if(v.type==='table'){return`<figure class="q-model"><figcaption>${esc(v.title)}</figcaption><table><tbody>${v.rows.map((r:string[])=>`<tr>${r.map((c:string)=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table><p>${esc(v.transcript)}</p></figure>`}if(v.type==='tree'){return`<figure class="q-model"><figcaption>${esc(v.title)}</figcaption><div class="tree" role="img" aria-label="${esc(v.transcript)}">${v.branches.map((b:string)=>`<span>${esc(b)}</span>`).join('<b>→</b>')}</div><p>${esc(v.transcript)}</p></figure>`}if(v.type==='spinner'){const total=(v.values||[]).reduce((a:number,b:number)=>a+b,0);return`<figure class="q-model"><figcaption>${esc(v.title)}</figcaption><div class="spinner" role="img" aria-label="${esc(v.transcript)}"><strong>${total}</strong><span>equal sectors</span></div><p>${esc(v.transcript)}</p></figure>`}return`<figure class="q-model"><figcaption>${esc(v.title)}</figcaption><p role="img" aria-label="${esc(v.transcript)}">${esc(v.transcript)}</p></figure>`};
 const sample=()=>{if(balanced){const cats=[...new Set(source.map((q:any)=>q.category))].sort(),groups=new Map(cats.map((c:any)=>[c,source.filter((q:any)=>q.category===c)]));const extra=new Set(Array.from({length:Math.max(0,count-cats.length)},(_,i)=>cats[(generation+i)%cats.length]));set=cats.flatMap((c:any)=>shuffle(groups.get(c)||[]).slice(0,extra.has(c)?2:1));generation++;set=shuffle(set).slice(0,count).map(randomize)}else set=shuffle(source).slice(0,count).map(randomize)};
 const answerUI=(q:any,i:number)=>{const name=`${root.dataset.lesson}-${i}`,t=typeOf(q);if(t==='number')return`<label class="number">Enter a number${q.unit?` (${esc(q.unit)})`:''}<input name="${name}" inputmode="decimal" data-number></label>`;if(t==='multi-select')return`<div class="choices"><p>Select all that apply.</p>${q.choices.map((c:string,j:number)=>`<label><input type="checkbox" name="${name}" value="${j}"><span>${esc(c)}</span></label>`).join('')}</div>`;return`<div class="choices ${t==='model-select'?'model-select':''}">${q.choices.map((c:string,j:number)=>`<label><input type="radio" name="${name}" value="${j}"><span>${esc(c)}</span></label>`).join('')}</div>`};
 const render=(focus=false)=>{sample();list.innerHTML=set.map((q,i)=>`<fieldset data-item data-i="${i}"><legend tabindex="-1"><b>${i+1}</b> ${esc(q.prompt)} <small>${esc(typeOf(q).replace('-',' '))}</small></legend>${visual(q.visual)}${answerUI(q,i)}<p data-reveal hidden></p></fieldset>`).join('');const result=root.querySelector<HTMLElement>('[data-result]')!;result.textContent=`New set ready. Complete all ${count} before submitting.`;for(const box of[root.querySelector<HTMLElement>('[data-scores]')!,root.querySelector<HTMLElement>('[data-routes]')!]){box.hidden=true;box.innerHTML=''}if(focus)root.querySelector<HTMLElement>('legend')?.focus()};
 const num=(s:string)=>{const x=s.trim().replace(/−/g,'-').replace(/%$/,'').replace(/,/g,'');return /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(x)?Number(x):NaN};
 const complete=(item:HTMLElement,q:any)=>typeOf(q)==='number'?Number.isFinite(num(item.querySelector<HTMLInputElement>('input')?.value||'')):typeOf(q)==='multi-select'?!!item.querySelector('input:checked'):!!item.querySelector('input:checked');
 const correct=(item:HTMLElement,q:any)=>{const t=typeOf(q);if(t==='number')return Math.abs(num(item.querySelector<HTMLInputElement>('input')?.value||'')-Number(q.numericAnswer))<=Number(q.tolerance??1e-6);const chosen=[...item.querySelectorAll<HTMLInputElement>('input:checked')].map(x=>Number(x.value)).sort((a,b)=>a-b),expected=[...(q.answers||[q.answer])].sort((a:number,b:number)=>a-b);return chosen.length===expected.length&&chosen.every((x,i)=>x===expected[i])};
 root.querySelector('[data-new]')?.addEventListener('click',()=>render(true));root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find((x,i)=>!complete(x,set[i])),result=root.querySelector<HTMLElement>('[data-result]')!;if(missing){result.textContent='Complete every question before submitting. No correctness has been revealed.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;const missed:any[]=[],lesson:Record<string,{r:number,t:number}>={};items.forEach((item,i)=>{const q=set[i],ok=correct(item,q);if(ok)score++;else missed.push(q);lesson[q.category]??={r:0,t:0};lesson[q.category].t++;if(ok)lesson[q.category].r++;item.classList.add(ok?'correct':'incorrect');item.dataset.state=ok?'correct':'incorrect';item.querySelectorAll<HTMLInputElement>('input').forEach(x=>x.disabled=true);const reveal=item.querySelector<HTMLElement>('[data-reveal]')!,answer=typeOf(q)==='number'?String(q.numericAnswer):(q.answers||[q.answer]).map((j:number)=>q.choices[j]).join('; ');reveal.hidden=false;reveal.innerHTML=`<strong>${ok?'Correct.':'Review.'}</strong> ${esc(q.feedback)}${ok?'':` <span>Correct response: ${esc(answer)}.</span> <a href="${esc(q.route)}">Exact repair: ${esc(q.repairLabel||q.category)}</a>.`}`});const pct=Math.round(score/items.length*100);result.innerHTML=`<strong>${pct}% · ${score}/${items.length}</strong> ${pct>=90?'Ready for transfer.':pct>=70?'Close: repair the lowest percentage first, then regenerate.':pct>=50?'Repair the weakest lesson before another attempt.':'Return to the earliest linked model and supported practice.'}`;const scores=root.querySelector<HTMLElement>('[data-scores]')!;scores.hidden=false;scores.innerHTML=`<strong>Lesson percentages</strong><div>${Object.entries(lesson).sort().map(([k,v])=>`<span><b>${esc(k)}</b> ${Math.round(v.r/v.t*100)}% (${v.r}/${v.t})</span>`).join('')}</div>`;const routes=root.querySelector<HTMLElement>('[data-routes]')!;if(missed.length){const unique=[...new Map(missed.map(q=>[`${q.category}-${q.route}`,q])).values()].sort((a:any,b:any)=>{const aa=lesson[a.category],bb=lesson[b.category];return aa.r/aa.t-bb.r/bb.t});routes.hidden=false;routes.innerHTML=`<strong>Repair destinations, lowest lesson percentage first:</strong>${unique.map((q:any)=>`<a href="${esc(q.route)}">${esc(q.repairLabel||q.category)}</a>`).join('')}`}result.focus({preventScroll:true});result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'})});render();});
</script>
<style>.independent{border:1px solid #bfd6c7;border-radius:15px;padding:1rem;background:#f7fcf8}.check-head{display:flex;justify-content:space-between;gap:1rem;align-items:center}.check-head>div{display:grid}.check-head span{color:#526174}.independent button{min-height:44px;border:0;border-radius:9px;padding:.65rem .8rem;background:#2457c5;color:#fff;font-weight:850}.submit{margin-top:.7rem}.independent fieldset{margin:.8rem 0;padding:1rem;border:1px solid #dbe4ed;border-radius:12px;background:#fff}.independent fieldset.correct{border-left:6px solid #2b6e3f}.independent fieldset.incorrect{border-left:6px solid #a44820}.independent legend{font-weight:850}.independent legend b{display:inline-grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;background:#2457c5;color:#fff}.independent small{display:block;color:#5f6f82}.choices{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-top:.7rem}.choices label{display:flex;gap:.5rem;align-items:center;min-height:44px;padding:.6rem;border:1px solid #dbe4ed;border-radius:9px}.number{display:grid;gap:.35rem;max-width:22rem}.number input{min-height:44px;padding:.55rem;font:inherit}.q-model{margin:.75rem 0;padding:.75rem;border-radius:10px;background:#eef5ff}.q-model figcaption{font-weight:850}.bars{display:flex;align-items:end;gap:.45rem;min-height:130px;padding:.5rem;border-bottom:2px solid #26384d}.bars span{display:grid;grid-template-rows:96px auto auto;align-items:end;text-align:center;min-width:38px}.bars i{display:block;width:30px;justify-self:center;background:#497bc1;border:2px solid #173867}.bars em{font-style:normal}.q-model table{border-collapse:collapse}.q-model td{border:1px solid #718196;padding:.4rem}.tree{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}.tree span{padding:.45rem;background:#fff;border:1px solid #718196}.spinner{width:110px;height:110px;border-radius:50%;border:8px double #2457c5;display:grid;place-content:center;text-align:center;background:conic-gradient(#dbeafe 0 25%,#fff 25% 50%,#dbeafe 50% 75%,#fff 75%)}[data-scores],[data-routes]{margin-top:.7rem;padding:.7rem;background:#eef5ff}[data-scores] div{display:flex;gap:.5rem;flex-wrap:wrap}[data-scores] span{padding:.45rem;background:#fff}[data-routes] a{display:block;margin:.35rem 0;font-weight:750}.independent :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:650px){.check-head{align-items:stretch;flex-direction:column}.choices{grid-template-columns:1fr}}@media(max-width:390px){.independent{padding:.7rem;overflow-wrap:anywhere}.q-model{overflow-x:auto}.bars span{min-width:32px}}@media(max-width:375px){.independent fieldset{padding:.7rem}}@media(max-width:320px){.independent{padding:.55rem}.choices label{padding:.5rem}}@media(prefers-reduced-motion:reduce){.independent *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>