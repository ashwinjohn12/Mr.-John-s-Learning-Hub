---
import type{Unit3Lesson}from'../data/grade7Unit3';const{lesson}=Astro.props as{lesson:Unit3Lesson};
const modelNames:Record<string,[string,string,string]>={
'fractions-to-decimals':['fraction strip','division record','equivalent fraction'],
'compare-order-rational':['benchmark line','ordered cards','common decimals'],
'decimal-add-subtract':['place-value grid','aligned columns','estimate band'],
'multiplying-decimals':['area model','partial-products table','factor estimate'],
'dividing-decimals':['sharing trays','grouping containers','multiplication check'],
'decimal-order-operations':['expression tree','rewritten steps','estimate'],
'relating-fractions-decimals-percents':['hundred grid','fraction strip','double number line'],
'solving-percent-problems':['percent bar','double number line','benchmark strategy']};const models=modelNames[lesson.slug];const modelPairs:Record<string,[number,number]>={'fractions-to-decimals':[3,4],'compare-order-rational':[7,8],'decimal-add-subtract':[12.45,7.8],'multiplying-decimals':[3.6,2.5],'dividing-decimals':[18.9,.45],'decimal-order-operations':[6.4,2.1],'relating-fractions-decimals-percents':[18,30],'solving-percent-problems':[65,240]};const pair=modelPairs[lesson.slug];const decisions:Record<string,[string,string,string[]]>={'fractions-to-decimals':['Which amount is greatest?','3/4 cup',['3/4 cup','5/8 cup','7/20 cup']],'compare-order-rational':['Which listed time is fastest?','0.82 hour',['0.82 hour','7/8 hour','0.9 hour']],'decimal-add-subtract':['Is the $30 budget sufficient?','Yes',['Yes','No']],'multiplying-decimals':['Is $40 enough for the fabric?','Yes',['Yes','No']],'dividing-decimals':['Which calculation counts 0.45 L bottles?','18.9 ÷ 0.45',['18.9 ÷ 0.45','18.9 ÷ 7','0.45 ÷ 18.9']],'decimal-order-operations':['What is the verified profit?','$51',['$51','$25.50','$76.50']],'relating-fractions-decimals-percents':['Which display states the result most directly?','60%',['60%','18%','30%']],'solving-percent-problems':['Is the 70% attendance target met?','Yes',['Yes','No']]};const decision=decisions[lesson.slug];
---
<div class="apply" data-unit3-apply data-lesson={lesson.slug} data-model-a-answer={pair[0]} data-model-b-answer={pair[1]}><header><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></header>
 <fieldset><legend>Independently verified calculations</legend>{lesson.apply.values.map(v=><label>{v.label}{v.kind==='choice'?<select data-value data-answer={v.answer}><option value="">Choose</option>{v.options?.map(x=><option>{x}</option>)}</select>:<input data-value data-answer={v.answer} inputmode="decimal" autocomplete="off"/>}</label>)}</fieldset>
 <fieldset class="model-builder"><legend>Required mathematical representation</legend><label>Model type<select data-model-type data-required={models[0]}><option value="">Choose</option>{models.map(x=><option value={x}>{x}</option>)}</select></label><label>First labelled quantity<input data-model-a inputmode="decimal"/></label><label>Second labelled quantity<input data-model-b inputmode="decimal"/></label><button type="button" data-build-model>Build representation</button><div data-model-display role="img" aria-label="Application model not built."><span></span></div><p data-model-transcript>Model transcript: not built.</p></fieldset><fieldset><legend>Verified decision</legend><label>{decision[0]}<select data-decision data-answer={decision[1]}><option value="">Choose</option>{decision[2].map(x=><option>{x}</option>)}</select></label></fieldset>
 <ol>{lesson.apply.tasks.map((task,i)=><li><label><b>Task {i+1}: {task}</b><textarea data-evidence rows="3"></textarea></label></li>)}</ol>
 <p class="note">Your written explanations are saved as evidence for self or teacher review. They are not graded by word count, digits, keywords, or similarity.</p><button type="button" data-check>Verify calculations, model, and evidence</button><p data-status role="status" tabindex="-1">Complete each calculation, build a labelled model, and record evidence.</p><details><summary>Success checklist</summary><ul>{lesson.apply.success.map(x=><li>{x}</li>)}</ul></details>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit3-apply]').forEach(root=>{const status=root.querySelector<HTMLElement>('[data-status]'),display=root.querySelector<HTMLElement>('[data-model-display]'),transcript=root.querySelector<HTMLElement>('[data-model-transcript]');let modelBuilt=false;
 const normalize=(v:string)=>v.trim().toLowerCase().replace(/\s/g,'').replace(/\$/g,'').replace(/,/g,''),fraction=(v:string)=>{const m=v.match(/^(-?\d+(?:\.\d+)?)\/(-?\d+(?:\.\d+)?)$/);return m?Number(m[1])/Number(m[2]):Number(v.replace(/%$/,''))};
 const equal=(value:string,expected:string)=>{const a=normalize(value),b=normalize(expected);if(a===b)return true;if(b.includes('/'))return Math.abs(fraction(a)-fraction(b))<.0001;if(b.endsWith('%'))return Math.abs(Number(a.replace('%',''))-Number(b.replace('%','')))<.0001;return Number.isFinite(Number(a))&&Math.abs(Number(a)-Number(b))<.0001};
 const invalidate=(event?:Event)=>{root.dataset.verified='false';if((event?.target as HTMLElement)?.matches('[data-model-type],[data-model-a],[data-model-b]')){modelBuilt=false;if(display)display.innerHTML='<span></span>';if(transcript)transcript.textContent='Model transcript: not built.';display?.setAttribute('aria-label','Application model not built.')}if(status)status.textContent='Evidence changed. Verify the complete application again.';};
 root.querySelectorAll('input,textarea,select').forEach(c=>{c.addEventListener('input',invalidate);c.addEventListener('change',invalidate)});
 root.querySelector('[data-build-model]')?.addEventListener('click',()=>{const select=root.querySelector<HTMLSelectElement>('[data-model-type]'),type=select?.value,a=root.querySelector<HTMLInputElement>('[data-model-a]')?.value.trim(),b=root.querySelector<HTMLInputElement>('[data-model-b]')?.value.trim();modelBuilt=type===select?.dataset.required&&!!a&&!!b&&Number.isFinite(fraction(a))&&Number.isFinite(fraction(b))&&Math.abs(fraction(a)-Number(root.dataset.modelAAnswer))<.001&&Math.abs(fraction(b)-Number(root.dataset.modelBAnswer))<.001;if(modelBuilt&&display&&transcript){const p=Math.max(8,Math.min(100,Math.abs(fraction(a))/(Math.abs(fraction(a))+Math.abs(fraction(b))||1)*100));display.innerHTML=`<b>${type}</b><span class="${type?.replace(/\s/g,'-')}" style="width:${p}%"></span><i>${a} · ${b}</i>`;const text=`${type} with labelled quantities ${a} and ${b}.`;display.setAttribute('aria-label',text);transcript.textContent=`Model transcript: ${text}`;if(status)status.textContent='Representation built. Verify it with the calculations and decision.';}else if(status)status.textContent=`Build the required ${select?.dataset.required} using the exact lesson quantities.`;});
 root.querySelector('[data-check]')?.addEventListener('click',()=>{const bad=[...root.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-value]')].find(x=>!equal(x.value,x.dataset.answer||'')),decisionBox=root.querySelector<HTMLSelectElement>('[data-decision]'),badDecision=decisionBox?.value!==decisionBox?.dataset.answer,missing=[...root.querySelectorAll<HTMLTextAreaElement>('[data-evidence]')].find(x=>!x.value.trim()),ok=!bad&&!badDecision&&!missing&&modelBuilt;root.dataset.verified=String(ok);if(status)status.innerHTML=bad?'<strong>Revise a calculation.</strong> Each required value is checked separately.':!modelBuilt?'<strong>Build the required representation.</strong> Use the named lesson model and exact labelled quantities.':badDecision?'<strong>Revise the decision.</strong> It must follow from the verified calculations.':missing?'<strong>Record evidence for every task.</strong> Your writing is stored, not automatically judged.':'<strong>Application complete.</strong> Every calculation, model state, unit, and decision are verified.';(bad||decisionBox||missing||status)?.focus({preventScroll:true});});
});
</script>
<style>.apply{overflow:hidden;border-radius:16px;background:#251545;color:#fff}.apply header{padding:1rem;background:#493173}.apply fieldset,.apply ol,.apply details,.apply .note,.apply>[data-status]{margin:1rem}.apply fieldset{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;border:1px solid #ffffff44;border-radius:10px}.apply label{display:grid;gap:.35rem}.apply input,.apply textarea,.apply select{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #b9acd0;font:inherit}.model-builder button,.apply>button{min-height:44px;padding:.7rem;border:0;border-radius:9px;background:#f4c95d;color:#251545;font-weight:900}.model-builder [data-model-display]{grid-column:1/-1;display:grid;gap:.4rem;padding:.7rem;border-radius:9px;background:#fff;color:#251545}.model-builder [data-model-display] span{display:block;height:20px;max-width:100%;background:#7858a6;border-radius:4px}.model-builder [data-model-transcript]{grid-column:1/-1}.apply ol{display:grid;gap:.65rem;padding:0;list-style:none}.apply li,.apply .note,.apply>[data-status]{padding:.75rem;border-radius:9px;background:#ffffff12}.apply>button{margin:0 1rem}.apply :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:700px){.apply fieldset{grid-template-columns:1fr}.apply>button{width:calc(100% - 2rem)}}@media(max-width:390px){.apply fieldset,.apply ol,.apply details,.apply .note,.apply>[data-status]{margin:.75rem}}</style>
