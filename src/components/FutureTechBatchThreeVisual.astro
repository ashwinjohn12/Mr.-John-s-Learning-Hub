---
interface Props { id: string; file: string; width: number; height: number; alt: string; companion: string; label: string; }
const { id, file, width, height, alt, companion, label } = Astro.props;
const src = `${import.meta.env.BASE_URL}resources/futuretech/level1/batch-3/${file}`;
---
<figure id={id} class="batch-three-visual">
  <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  <figcaption><p>{companion}</p><a href={src} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a></figcaption>
</figure>
<style>
.batch-three-visual{margin:1rem 0;border:1px solid #c7d2fe;border-radius:16px;background:#f8fafc;overflow:hidden;max-width:100%}
.batch-three-visual img{display:block;width:100%;max-width:100%;height:auto}
.batch-three-visual figcaption{padding:.8rem 1rem;color:#334155;line-height:1.55;overflow-wrap:anywhere}
.batch-three-visual p{margin:0 0 .5rem}
.batch-three-visual a{color:#3730a3;text-decoration:underline;font-weight:700}
.batch-three-visual a:focus-visible{outline:3px solid #3730a3;outline-offset:3px;border-radius:2px}
</style>
