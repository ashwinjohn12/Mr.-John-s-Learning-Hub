---
import type { Unit5Question } from '../data/grade7Unit5';
interface Props{bank:Unit5Question[];lesson:string;count?:number;balancedUnit?:boolean}
const {bank,lesson,count=5,balancedUnit=false}=Astro.props;
---
<div class="independent" data-unit5-check data-bank={JSON.stringify(bank)} data-lesson={lesson} data-count={count} data-balanced={String(balancedUnit)}>
  <div class="check-head"><div><strong>Fresh {count}-question set</strong><span>{balancedUnit?'One from every lesson, plus one from each of three different lessons.':'A varied sample from the 30-question lesson bank.'}</span></div><button type="button" data-new>Generate new set</button></div>
  <p class="privacy-note">Complete the full set before submitting. Results, correct answers, and explanations stay hidden until then.</p>
  <div data-check-list></div><button class="submit-all" type="button" data-submit>Submit all {count}</button>
  <p class="check-result" data-result role="status" tabindex="-1">No answers submitted yet.</p>
  <div class="lesson-scores" data-lesson-scores hidden></div><div class="review-routes" data-routes hidden></div>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit5-check]').forEach(root=>{
 const bank=JSON.parse(root.dataset.bank||'[]'),list=root.querySelector<HTMLElement>('[data-check-list]'),count=Number(root.dataset.count||5),balanced=root.dataset.balanced==='true';let set:any[]=[];
 const escape=(s:string)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]||c));
 const shuffle=(items:any[])=>{const out=[...items];for(let i=out.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[out[i],out[j]]=[out[j],out[i]];}return out;};
 const numericKinds=new Set(['number','directed change','distance','minimum pairs','missing jump','missing start','missing subtrahend']);
 const typeOf=(item:any)=>item.responseType||(numericKinds.has(item.kind)?'number':item.kind==='multi-select'?'multi-select':item.kind==='order'?'order':'choice');
 const parseNumber=(value:string,item:any={})=>{const raw=value.trim().replace(/−/g,'-'),percent=raw.endsWith('%'),currency=raw.startsWith('$');if(currency||(percent&&item.unit!=='%'))return NaN;const clean=raw.replace(/%$/,'').replace(/,/g,'');return /^[+\-]?(?:\d+\.\d+|\d+|\.\d+)$/.test(clean)?Number(clean):NaN;};
 const modelMarkup=(label:string)=>{const key=/fraction strips/i.test(label)?'strips':/number line/i.test(label)?'line':/equivalence table/i.test(label)?'table':/take-away/i.test(label)?'remove':/inverse-check/i.test(label)?'inverse':/composition/i.test(label)?'compose':/regroup/i.test(label)?'regroup':'generic';const pictures:Record<string,string>={strips:'<i class="on"></i><i class="on"></i><i></i><i></i>',line:'<i></i><i class="on"></i><i></i><i class="on"></i>',table:'<i class="on"></i><i></i><i class="on"></i><i></i>',remove:'<i class="on"></i><i class="on"></i><i class="off"></i><i></i>',inverse:'<i class="on"></i><i></i><i class="on"></i><i class="on"></i>',compose:'<i class="on"></i><i class="on"></i><i class="on"></i><i></i>',regroup:'<i class="on"></i><i class="on"></i><i></i><i class="on"></i>',generic:'<i></i><i></i><i></i><i></i>'};return `<span class="model-option" role="img" aria-label="${escape(label)}"><span class="model-picture ${key}">${pictures[key]}</span><b>${escape(label)}</b></span>`;};
 const randomizeChoices=(item:any)=>{const type=typeOf(item);if(['number','order','matching'].includes(type))return{...item};const correct=new Set(item.answers||[item.answer]);const options=item.choices.map((label:string,index:number)=>({label,correct:correct.has(index)})),mixed=shuffle(options);return{...item,choices:mixed.map((x:any)=>x.label),answer:mixed.findIndex((x:any)=>x.correct),answers:mixed.map((x:any,i:number)=>x.correct?i:-1).filter((i:number)=>i>=0)};};
 const sample=()=>{if(balanced){const byLesson=new Map<string,any[]>();bank.forEach((item:any)=>byLesson.set(item.category,[...(byLesson.get(item.category)||[]),item]));const groups=[...byLesson.values()];const first=groups.map(group=>shuffle(group)[0]);const extras=shuffle(groups).slice(0,Math.max(0,count-groups.length)).map(group=>shuffle(group.filter((x:any)=>!first.some((y:any)=>y.id===x.id)))[0]);set=[...first,...extras].filter(Boolean);}else{const groups=new Map<string,any[]>();bank.forEach((item:any)=>{const key=item.category||'mixed';groups.set(key,[...(groups.get(key)||[]),item]);});set=shuffle(bank).slice(0,count);}set=shuffle(set).slice(0,count).map(randomizeChoices);};
 const numericAnswer=(item:any)=>Number(String(item.choices[item.answer]).replace(/−/g,'-').replace(/[$,%]/g,'').match(/[+-]?(?:\d+(?:\.\d*)?|\.\d+)/)?.[0]);
 const responseMarkup=(item:any,index:number)=>{
  const name=`${escape(root.dataset.lesson||'unit5')}-check-${index}`;
  const type=typeOf(item);
  if(type==='multi-select')return `<div class="check-choices" data-response="multi"><p class="select-note">Select all that apply.</p>${item.choices.map((choice:string,i:number)=>`<label><input type="checkbox" name="${name}" value="${i}"><span>${escape(choice)}</span></label>`).join('')}</div>`;
  if(type==='number')return `<label class="numeric-response">Enter a number${item.unit?` (${escape(item.unit)})`:''}<input class="signed-entry" inputmode="decimal" autocomplete="off" name="${name}" data-response="number"></label>`;
  if(type==='order'){const tokens=shuffle(item.orderTokens||String(item.choices[item.answer]).split(',')),answer=item.orderAnswer||String(item.choices[item.answer]).split(',');return `<div class="order-response" data-response="order" data-order-answer="${escape(answer.join('|'))}"><p>Choose one item for each position.</p>${answer.map((_:string,rank:number)=>`<label>${rank+1}<select name="${name}-${rank}"><option value="">Choose</option>${tokens.map((token:string)=>`<option value="${escape(token)}">${escape(token)}</option>`).join('')}</select></label>`).join('')}</div>`;}
  if(type==='matching')return `<div class="matching-response" data-response="matching">${item.matchRows.map((row:string,rank:number)=>`<label>${escape(row)}<select name="${name}-${rank}" data-match-answer="${item.matchAnswers[rank]}"><option value="">Choose a match</option>${item.matchOptions.map((option:string,i:number)=>`<option value="${i}">${escape(option)}</option>`).join('')}</select></label>`).join('')}</div>`;
  if(type==='model-select')return `<div class="check-choices model-select" data-response="model-select">${item.choices.map((choice:string,i:number)=>`<label><input type="radio" name="${name}" value="${i}">${modelMarkup(choice)}</label>`).join('')}</div>`;
  return `<div class="check-choices" data-response="choice">${item.choices.map((choice:string,i:number)=>`<label><input type="radio" name="${name}" value="${i}"><span>${escape(choice)}</span></label>`).join('')}</div>`;
 };
 const render=(focus=false)=>{sample();if(!list)return;list.innerHTML=set.map((item,index)=>`<fieldset data-check-item data-answer="${item.answer}" data-category="${escape(item.category||'mixed')}"><legend tabindex="-1"><span>${index+1}</span><span>${escape(item.prompt)} <small>${escape(typeOf(item).replace('-',' '))}</small></span></legend>${responseMarkup(item,index)}<p data-reveal hidden></p></fieldset>`).join('');const result=root.querySelector<HTMLElement>('[data-result]');if(result)result.textContent=`New set ready. Complete all ${count}. Focus moved to question 1.`;const routes=root.querySelector<HTMLElement>('[data-routes]'),scores=root.querySelector<HTMLElement>('[data-lesson-scores]');if(routes){routes.hidden=true;routes.innerHTML=''}if(scores){scores.hidden=true;scores.innerHTML=''}if(focus)root.querySelector<HTMLElement>('[data-check-item] legend')?.focus();};
 root.querySelector('[data-new]')?.addEventListener('click',()=>render(true));
 root.querySelector('[data-submit]')?.addEventListener('click',()=>{
  const items=[...root.querySelectorAll<HTMLElement>('[data-check-item]')];
  const selectedValues=(item:HTMLElement)=>[...item.querySelectorAll<HTMLInputElement>('input:checked')].map(x=>Number(x.value)).sort((a,b)=>a-b);
  const isComplete=(item:HTMLElement,index:number)=>{const source=set[index],type=typeOf(source);if(type==='order')return[...item.querySelectorAll<HTMLSelectElement>('select')].every(x=>x.value)&&new Set([...item.querySelectorAll<HTMLSelectElement>('select')].map(x=>x.value)).size===[...item.querySelectorAll('select')].length;if(type==='matching')return[...item.querySelectorAll<HTMLSelectElement>('select')].every(x=>x.value!=='');if(type==='number')return Number.isFinite(parseNumber(item.querySelector<HTMLInputElement>('input')?.value||'',source));return !!item.querySelector('input:checked');};
  const incomplete=items.find((item,index)=>!isComplete(item,index));
  if(incomplete){const result=root.querySelector<HTMLElement>('[data-result]');if(result)result.textContent='Answer the full set before submitting. No correctness has been revealed.';incomplete.querySelector<HTMLInputElement|HTMLSelectElement>('input,select')?.focus();return;}
  let score=0;const missed:any[]=[];const lessonScores:Record<string,{right:number,total:number}>={};
  items.forEach((item,index)=>{const source=set[index],type=typeOf(source);let ok=false,correctText=source.choices[source.answer];if(type==='multi-select'){const expected=[...(source.answers||[source.answer])].sort((a:number,b:number)=>a-b);const chosen=selectedValues(item);ok=expected.length===chosen.length&&expected.every((x:number,i:number)=>x===chosen[i]);correctText=expected.map((i:number)=>source.choices[i]).join(', ');}else if(type==='number'){const expected=source.numericAnswer??numericAnswer(source);ok=Math.abs(parseNumber(item.querySelector<HTMLInputElement>('input')?.value||'',source)-expected)<=(source.tolerance??1e-6);correctText=String(expected);}else if(type==='order'){const box=item.querySelector<HTMLElement>('[data-order-answer]'),chosen=[...item.querySelectorAll<HTMLSelectElement>('select')].map(x=>x.value),expected=String(box?.dataset.orderAnswer||'').split('|');correctText=expected.join(' → ');ok=chosen.length===expected.length&&chosen.every((x,i)=>x===expected[i]);}else if(type==='matching'){const selects=[...item.querySelectorAll<HTMLSelectElement>('select')];ok=selects.every(x=>Number(x.value)===Number(x.dataset.matchAnswer));correctText=source.matchRows.map((row:string,i:number)=>`${row} → ${source.matchOptions[source.matchAnswers[i]]}`).join('; ');}else ok=Number(item.querySelector<HTMLInputElement>('input:checked')?.value)===Number(item.dataset.answer);
   if(ok)score++;else missed.push(source);if(balanced){lessonScores[source.category]??={right:0,total:0};lessonScores[source.category].total++;if(ok)lessonScores[source.category].right++;}item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);item.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select').forEach(control=>control.disabled=true);const reveal=item.querySelector<HTMLElement>('[data-reveal]');if(reveal){reveal.hidden=false;reveal.innerHTML=`<strong>${ok?'Correct.':'Review this one.'}</strong> ${escape(source.feedback)}${ok?'':` <span>Correct answer: ${escape(correctText)}.</span>`}`;}
  });
  const result=root.querySelector<HTMLElement>('[data-result]'),ratio=score/items.length;if(result)result.innerHTML=`<strong>${score} / ${items.length}.</strong> ${ratio>=.9?'Ready to transfer your learning in Fraction Fair Arcade.':ratio>=.7?'Nearly ready. Review each linked idea, then generate a fresh set.':ratio>=.5?'Repair the lowest lesson strand before retrying.':'Rebuild from the earliest linked model, then return to supported practice.'}`;
  const scores=root.querySelector<HTMLElement>('[data-lesson-scores]');if(scores&&balanced){const ordered=Object.entries(lessonScores).sort(([a],[b])=>a.localeCompare(b));scores.hidden=false;scores.innerHTML=`<strong>Lesson scores</strong><div>${ordered.map(([name,value])=>`<span><b>${escape(name)}</b> ${value.right}/${value.total}</span>`).join('')}</div>`;}
const routes=root.querySelector<HTMLElement>('[data-routes]');if(routes&&missed.length){
 const unique=[...new Map(missed.map(x=>[`${x.category}-${x.route}`,x])).values()].sort((a:any,b:any)=>{const aa=lessonScores[a.category]||{right:0,total:1},bb=lessonScores[b.category]||{right:0,total:1};return aa.right/aa.total-bb.right/bb.total||(bb.total-bb.right)-(aa.total-aa.right)||a.category.localeCompare(b.category)});
 const routeParts=(route:string)=>{const match=route.match(/(?:\.\.\/)?([^/#]+)\/?#([^/]+)$/);return{slug:match?.[1]||root.dataset.lesson||'',anchor:match?.[2]||route.replace(/^#/,'')}};
 const lessonNames:Record<string,string>={'Lesson 5.1':'Using Models to Add Fractions','Lesson 5.2':'Using Other Models to Add Fractions','Lesson 5.3':'Using Symbols to Add Fractions','Lesson 5.4':'Using Models to Subtract Fractions','Lesson 5.5':'Using Symbols to Subtract Fractions','Lesson 5.6':'Adding With Mixed Numbers','Lesson 5.7':'Subtracting With Mixed Numbers'},slugLabels:Record<string,string>={'models-add-fractions':'Lesson 5.1 — Using Models to Add Fractions','other-models-add-fractions':'Lesson 5.2 — Using Other Models to Add Fractions','symbols-add-fractions':'Lesson 5.3 — Using Symbols to Add Fractions','models-subtract-fractions':'Lesson 5.4 — Using Models to Subtract Fractions','symbols-subtract-fractions':'Lesson 5.5 — Using Symbols to Subtract Fractions','adding-mixed-numbers':'Lesson 5.6 — Adding With Mixed Numbers','subtracting-mixed-numbers':'Lesson 5.7 — Subtracting With Mixed Numbers'};
 const conceptTitles:Record<string,string[]>={'models-add-fractions':['Like denominators','Related denominators','Estimate first','Simplify and interpret'],'other-models-add-fractions':['Number-line jumps','Area overlays','Set models','Compare representations'],'symbols-add-fractions':['Choose the denominator','Rename both fractions','Add and simplify','Check the result'],'models-subtract-fractions':['Like-denominator removal','Unlike denominators','Comparison model','Check positivity and simplify'],'symbols-subtract-fractions':['Plan the shared unit','Rename accurately','Subtract and simplify','Verify symbolically and visually'],'adding-mixed-numbers':['Model wholes and parts','Part-by-part','Improper fractions','Estimate and choose form'],'subtracting-mixed-numbers':['No regrouping','Regroup one whole','Unlike denominators','Interpret and verify']};
 const sectionName=(route:string)=>{const {slug,anchor}=routeParts(route);if(anchor.startsWith('understand-')){const index=Number(anchor.split('-').pop())-1;return `Understand: ${conceptTitles[slug]?.[index]||'Build the idea'}`;}if(anchor==='examples')return 'Examples: Worked examples';if(anchor==='explore')return 'Explore: Representation lab';if(anchor==='practise')return 'Practise: Supported practice';return 'Review: Readiness and repair';};
 routes.hidden=false;routes.innerHTML=`<strong>Prioritized repair route${unique.length>1?'s':''}:</strong>${unique.map((item:any)=>{const lessonLabel=balanced?`${item.category} — ${lessonNames[item.category]}`:(slugLabels[root.dataset.lesson||'']||'Unit 5 — Operations with Fractions');return `<a href="${balanced?item.route:`#${item.route||'understand'}`}">${escape(item.repairLabel||`${lessonLabel} · ${sectionName(String(item.route||'understand'))}`)}</a>`}).join('')}`;
}else if(routes){routes.hidden=true;routes.innerHTML='';}
  result?.focus({preventScroll:true});result?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});
 });render();
});
</script>
<style>
.independent{border:1px solid #bdd7c5;border-radius:15px;padding:1rem;background:#f8fcf9}.check-head{display:flex;justify-content:space-between;gap:1rem;align-items:center}.check-head>div{display:grid}.check-head span{color:#526174}.check-head button,.submit-all{border:0;border-radius:9px;background:#2b6e3f;color:#fff;padding:.7rem .9rem;font-weight:800;min-height:44px}.privacy-note{padding:.7rem;border-left:4px solid #2b6e3f;background:#fff}.independent fieldset{border:0;border-top:1px solid #dce9df;padding:1rem 0;margin:0}.independent legend{display:flex;gap:.6rem;font-weight:850}.independent legend>span:first-child{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:99px;background:#2b6e3f;color:#fff}.independent legend small{display:block;color:#5d6d63;font-weight:650}.check-choices{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.7rem 0}.check-choices label{display:flex;align-items:center;gap:.5rem;padding:.65rem;border:1px solid #d7e2da;border-radius:9px;background:#fff;min-height:44px}.numeric-response{display:grid;gap:.35rem;max-width:320px;margin:.7rem 0;font-weight:800}.numeric-response input,.order-response select{font:inherit;min-height:44px;padding:.6rem;border:1px solid #8aa095;border-radius:8px;background:#fff}.order-response{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin:.7rem 0}.order-response p{grid-column:1/-1;margin:0}.order-response label{display:grid;gap:.3rem;font-weight:800}.independent fieldset.correct{border-left:5px solid #2b6e3f}.independent fieldset.incorrect{border-left:5px solid #b85c1e}.independent [data-reveal],.check-result{padding:.7rem;border-radius:9px;background:#fff}.lesson-scores{margin-top:.7rem;padding:.75rem;border-radius:10px;background:#fff}.lesson-scores>div{display:grid;grid-template-columns:repeat(5,1fr);gap:.45rem;margin-top:.5rem}.lesson-scores span{display:grid;padding:.55rem;border-radius:8px;background:#eaf4ed}.review-routes{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:.65rem;padding:.7rem;border-radius:9px;background:#eaf4ed}.review-routes a{padding:.5rem .65rem;border-radius:7px;background:#fff;color:#205d34;font-weight:800}.independent button:focus-visible,.independent input:focus-visible,.independent select:focus-visible,.review-routes a:focus-visible,.check-result:focus-visible,.independent legend:focus-visible{outline:3px solid #2563eb;outline-offset:2px}@media(max-width:760px){.lesson-scores>div{grid-template-columns:1fr 1fr}.order-response{grid-template-columns:1fr 1fr}}@media(max-width:620px){.check-head{align-items:flex-start;flex-direction:column}.check-choices,.order-response,.lesson-scores>div{grid-template-columns:1fr}.review-routes{align-items:stretch;flex-direction:column}.check-head button,.submit-all{width:100%}}@media(max-width:390px){.independent{padding:.75rem}.check-choices label{overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
<style>
.matching-response{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin:.7rem 0}.matching-response label{display:grid;gap:.3rem;font-weight:800}.matching-response select{font:inherit;min-height:44px;padding:.6rem;border:1px solid #8aa095;border-radius:8px;background:#fff}.select-note{grid-column:1/-1;margin:0}@media(max-width:760px){.matching-response{grid-template-columns:1fr}}
</style>
<style>.model-option{display:grid;gap:.45rem;width:100%}.model-picture{display:grid;grid-template-columns:repeat(4,1fr);min-height:48px;border:2px solid #60758a;background:#fff}.model-picture i{border:1px solid #aab8c6}.model-picture i.on{background:#2457c5}.model-picture.line{display:flex;min-height:28px;border:0;border-bottom:3px solid #20344a}.model-picture.line i{width:12px;height:12px;margin-top:17px;border-radius:50%}.model-picture.area{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}.model-picture.groups{display:flex;flex-wrap:wrap;gap:.25rem;border:0}.model-picture.groups i{width:24px;height:24px;border:2px solid #2457c5;border-radius:6px}.model-picture.tree{clip-path:polygon(45% 0,55% 0,55% 40%,90% 90%,78% 100%,50% 58%,22% 100%,10% 90%,45% 40%)}.model-picture.hundred{grid-template-columns:repeat(10,1fr)}.model-picture.percent{grid-template-columns:3fr 2fr}.model-picture.percent i.on{background:#207c91}.model-picture.generic i{background:#eef2f6} .model-picture.circle,.model-picture.pie,.model-picture.graph{position:relative;display:block;border:0;background:transparent}.disc,.pie-disc,.graph-disc,.sliced{position:absolute;left:10px;top:3px;width:44px;height:44px;border:2px solid #20344a;border-radius:50%;background:#dbeafe}.diameter,.radius,.height,.unwrapped{position:absolute;display:block;border:0;background:#20344a}.circle .diameter{left:11px;top:24px;width:44px;height:2px}.circle .radius{left:32px;top:9px;width:2px;height:17px}.wrap .diameter{left:5px;top:9px;width:28px;height:3px}.wrap .unwrapped{left:5px;top:34px;width:88px;height:3px}.model-picture em{align-self:end;font-size:.72rem;font-style:normal;font-weight:800}.slanted{transform:skew(-20deg);background:#dbeafe}.para .height{width:2px;height:42px;left:50%;top:3px;border-left:2px dashed #20344a;background:transparent}.tri{position:relative}.tri .triangle{display:block;min-height:44px;clip-path:polygon(50% 0,100% 100%,0 100%);background:#2457c5}.tri .two{transform:rotate(180deg);background:#f4c95d}.sector{position:relative}.sector .sliced{position:static;background:repeating-conic-gradient(#2457c5 0 22.5deg,#dbeafe 22.5deg 45deg)}.sector .rearranged{background:repeating-linear-gradient(135deg,#2457c5 0 8px,#dbeafe 8px 16px)}.pie-disc{background:conic-gradient(#2457c5 0 126deg,#dbeafe 126deg)}.graph-disc{background:conic-gradient(#2457c5 0 144deg,#f4c95d 144deg 252deg,#5da271 252deg 324deg,#dbeafe 324deg)} </style>
