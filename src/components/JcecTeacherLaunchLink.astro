<script is:inline>
  (() => {
    const path = window.location.pathname;
    if (!/\/courses\/grade-7-science\/jabberwocky\/phase-1\/?$/.test(path)) return;
    const plan = document.getElementById('jcec-five-week-plan');
    if (!plan || document.getElementById('jcec-teacher-launch-link')) return;
    const link = document.createElement('a');
    link.id = 'jcec-teacher-launch-link';
    link.className = 'jcec-teacher-launch-link';
    link.href = './teacher-launch-guide/';
    link.innerHTML = '<span aria-hidden="true">🧭</span><div><strong>Teacher Planning</strong><small>Open the day-by-day Phase 1 Launch Guide</small></div><b>Open →</b>';
    plan.append(link);
  })();
</script>

