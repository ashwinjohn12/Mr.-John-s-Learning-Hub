---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit4FractionLab from './Unit4FractionLab.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionLinks = [['overview','🎯','Overview'],['big-ideas','🌎','Big Ideas'],['understand','📘','Understand'],['examples','🧩','Examples'],['vocabulary','🧠','Vocabulary'],['explore','🔬','Explore'],['practise','✏️','Practise'],['check','✅','Check Yourself'],['apply','🎮','Apply'],['review','🏁','Review']];
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
---
<BaseLayout title={`${topic.title} | ${course.grade} ${course.shortSubject}`} description={topic.summary} themeColor={course.color}>
  <div class="topic-shell" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <aside class="topic-sidebar">
      <a class="back-course" href={`${base}courses/${course.slug}/${unit.slug}/`}>← {unit.title}</a>
      <p class="eyebrow">ON THIS PAGE</p>
      <p class="scroll-cue">Swipe sections →</p>
      <nav aria-label="Lesson sections">{sectionLinks.map(([id,icon,label]) => <a href={`#${id}`}><span>{icon}</span>{label}</a>)}</nav>
    </aside>

    <article class="topic-content">
      <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`,href:`${base}courses/${course.slug}/`},{label:unit.title,href:`${base}courses/${course.slug}/${unit.slug}/`},{label:topic.title}]} />

      <header class="topic-hero">
        <p class="eyebrow">LESSON {topic.number} · {course.grade.toUpperCase()} {course.shortSubject.toUpperCase()}</p>
        <h1>{topic.title}</h1>
        <p>{topic.summary}</p>
        <div class="hook-card"><div><strong>Start with this</strong><small>Make a prediction. You are not expected to know the answer yet.</small></div><span>{content.hook}</span></div>
      </header>

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{content.goals.map((goal)=><li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map((item)=><li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p>
        <p>{content.bigIdeaDetail}</p>
        <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>

        <article class="fraction-meaning-model">
          <p class="eyebrow">VISUAL MODEL · SAME VALUE, NEW NAME</p>
          <h3>Equivalent fractions let us rename the pieces</h3>
          <p>Both bars show one-half of the same whole. The number of pieces changed, but the amount did not.</p>
          <div class="equivalent-model" aria-label="One half is equal to two fourths">
            <div class="model-fraction"><strong>1/2</strong><div class="static-fraction two"><span class="fill"></span><span></span></div></div>
            <span class="equals">=</span>
            <div class="model-fraction"><strong>2/4</strong><div class="static-fraction four"><span class="fill"></span><span class="fill"></span><span></span><span></span></div></div>
          </div>
          <p class="model-note"><strong>Why this matters:</strong> finding a common denominator is really finding a new name for each fraction so both use the same-sized pieces.</p>
        </article>

        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map((item)=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
        <div class="example-stack">{content.examples.map((example)=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map((step)=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
        <article class="rename-flow-card">
          <p class="eyebrow">STRATEGY SNAPSHOT</p>
          <h3>Do not combine different-sized pieces</h3>
          <div class="rename-flow"><span>3/4 + 1/8</span><b>→</b><span>6/8 + 1/8</span><b>→</b><span>7/8</span></div>
          <p>The middle step is the important thinking: <strong>3/4 and 6/8 are equal values</strong>, but 6/8 uses the same unit as 1/8.</p>
        </article>
      </LearningSection>

      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack"><div><h3>Fraction Lab</h3><p>Find a shared unit, build an equivalent fraction, and solve a fraction operation. Each part gives you a new challenge so you can focus on the reasoning instead of memorizing one example.</p><Unit4FractionLab /></div></div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map((item)=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> Use strips of scrap paper. Make every strip the same length before folding so each one represents the same whole.</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={content.questions} /></LearningSection>

      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>This bank is separate from Practice. Each new set randomly selects five questions from a larger 18-question bank, so repeated attempts should test a different mix of skills and reasoning.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>

      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map((task)=><li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map((item)=><li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map((item)=><label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>{content.next.status === 'planned' ? 'This lesson is next in the Unit 4 build.' : 'Continue when you are ready.'}</small></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span class="coming-next">Coming next</span>}</div>
      </LearningSection>
    </article>
  </div>
</BaseLayout>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft,#eef4ff);line-height:1.55}.hook-card>div{display:grid;align-content:start;gap:.2rem}.hook-card small{display:block;max-width:200px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.wrap-grid ul,.worked-example ol,.hands-on-card ol,.lesson-challenge ol{padding-left:1.2rem}.overview-grid li,.wrap-grid li,.worked-example li,.hands-on-card li,.lesson-challenge li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.success-box{margin-top:1rem}.concept-grid.detailed>div{position:relative}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.mixups{margin-top:1.2rem}.example-stack,.explore-stack{display:grid;gap:1rem}.worked-example,.hands-on-card,.pat-card,.fraction-meaning-model,.rename-flow-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.worked-example h3,.hands-on-card h3,.fraction-meaning-model h3,.rename-flow-card h3{margin:.25rem 0 .75rem}.example-answer{margin-top:.8rem;padding:.75rem;border-radius:10px;background:var(--course-soft)}.fraction-meaning-model,.rename-flow-card{margin-top:1rem}.equivalent-model{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:end;margin:1rem 0}.model-fraction{display:grid;gap:.4rem}.model-fraction strong{font-size:1.2rem}.static-fraction{display:grid;min-height:52px;border:2px solid #24364d;border-radius:9px;overflow:hidden}.static-fraction.two{grid-template-columns:repeat(2,1fr)}.static-fraction.four{grid-template-columns:repeat(4,1fr)}.static-fraction span{border-right:1px solid #94a3b8}.static-fraction span:last-child{border-right:0}.static-fraction .fill{background:var(--course-soft)}.equals{font-size:1.6rem;font-weight:900;padding-bottom:.55rem}.model-note{padding:.75rem;border-radius:10px;background:#f7f9fc}.rename-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.6rem;align-items:center;margin:.9rem 0}.rename-flow span{padding:.8rem;border-radius:12px;background:var(--course-soft);text-align:center;font-weight:900;font-size:1.15rem}.rename-flow b{text-align:center}.section-lead{margin-bottom:1rem}.hands-on-card{margin-top:1rem}.home-note{padding:.75rem;border-radius:10px;background:#fff8db}.challenge-card details,.pat-card details{margin-top:.8rem}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:1rem}.review-grid label{display:flex;gap:.55rem;padding:.8rem;border:1px solid #dfe5ee;border-radius:11px}.next-step{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:14px;background:#edf9f0}.next-step>div{display:grid;gap:.2rem}.next-step .eyebrow{margin:0}.next-step small{color:#526174}.coming-next{font-weight:900;color:#526174}.scroll-cue{display:none}@media(max-width:760px){.hook-card,.overview-grid,.wrap-grid,.review-grid,.next-step,.equivalent-model{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.hook-card small{max-width:none}.rename-flow{grid-template-columns:1fr}.rename-flow b{transform:rotate(90deg)}.equals{text-align:center;padding:0}.topic-hero{padding-top:2rem;padding-bottom:3rem}.topic-hero h1{font-size:clamp(2.15rem,10vw,3.1rem);line-height:1.04}.scroll-cue{display:block;margin:-.35rem 0 .45rem;color:#64748b;font-size:.76rem;font-weight:700}}
</style>
