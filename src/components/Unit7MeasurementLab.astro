---
interface Props { variant:'parallelogram'|'triangle'|'composite'|'volume' }
const { variant } = Astro.props;
---
<div class="measurement-lab" data-unit7-lab={variant}>
  {variant === 'parallelogram' && (
    <>
      <div class="lab-head"><div><p class="eyebrow">PARALLELOGRAM TRANSFORMER</p><h3>Change the slant. Keep your eye on the area.</h3></div><strong data-area-readout>Area = 40 units²</strong></div>
      <svg class="shape-canvas" viewBox="0 0 520 260" role="img" aria-label="Interactive parallelogram and perpendicular height">
        <g class="grid-lines" data-grid></g>
        <polygon data-para-shape points="120,190 360,190 420,70 180,70" />
        <line class="height-line" data-height-line x1="180" y1="70" x2="180" y2="190" />
        <path class="right-angle" data-right-angle d="M180 178 h12 v12" />
        <text data-base-label x="240" y="220">base = 8</text><text data-height-label x="188" y="132">height = 5</text>
        <text class="slant-label" data-slant-label x="395" y="132">slant changes</text>
      </svg>
      <div class="controls three"><label>Base <input data-base type="range" min="4" max="12" value="8" /><output data-base-out>8</output></label><label>Perpendicular height <input data-height type="range" min="2" max="8" value="5" /><output data-height-out>5</output></label><label>Slant <input data-slant type="range" min="0" max="5" value="2" /><output data-slant-out>2</output></label></div>
      <div class="lab-actions"><button type="button" data-transform>Rearrange into rectangle →</button><button type="button" class="soft" data-para-challenge>Which measurement is ignored?</button></div>
      <p class="feedback" data-feedback>Move the slant slider first. The shape changes, but base × perpendicular height controls the area.</p>
    </>
  )}

  {variant === 'triangle' && (
    <>
      <div class="lab-head"><div><p class="eyebrow">TRIANGLE AREA LAB</p><h3>Move the top vertex without changing the height.</h3></div><strong data-tri-readout>Triangle area = 24 units²</strong></div>
      <svg class="shape-canvas" viewBox="0 0 520 260" role="img" aria-label="Interactive triangle with base and perpendicular height">
        <line class="base-guide" x1="80" y1="205" x2="440" y2="205" />
        <polygon data-triangle points="120,205 400,205 280,75" />
        <polygon class="ghost-triangle" data-tri-copy points="120,205 400,205 240,335" hidden />
        <line class="height-line" data-tri-height x1="280" y1="75" x2="280" y2="205" />
        <path class="right-angle" data-tri-angle d="M280 193 h12 v12" />
        <text data-tri-base-label x="235" y="232">base = 8</text><text data-tri-height-label x="290" y="142">height = 6</text>
      </svg>
      <div class="controls three"><label>Base <input data-tri-base type="range" min="4" max="12" value="8" /><output data-tri-base-out>8</output></label><label>Perpendicular height <input data-tri-h type="range" min="2" max="8" value="6" /><output data-tri-h-out>6</output></label><label>Slide top vertex <input data-apex type="range" min="-4" max="4" value="0" /><output data-apex-out>0</output></label></div>
      <div class="lab-actions"><button type="button" data-pair>Show the matching second triangle</button><button type="button" class="soft" data-tri-challenge>Why divide by 2?</button></div>
      <p class="feedback" data-feedback>Slide the top vertex left and right. If base and perpendicular height stay the same, the area stays the same too.</p>
    </>
  )}

  {variant === 'composite' && (
    <>
      <div class="lab-head"><div><p class="eyebrow">SHAPE SPLITTER</p><h3>One shape. More than one useful decomposition.</h3></div><strong data-comp-total>Total area = 52 units²</strong></div>
      <div class="scenario-tabs" role="group" aria-label="Composite shape scenario"><button type="button" data-scenario="house" class="active">House</button><button type="button" data-scenario="notch">Notched field</button><button type="button" data-scenario="park">Park</button></div>
      <svg class="shape-canvas composite" viewBox="0 0 520 280" role="img" aria-label="Composite shape with optional decomposition lines">
        <g data-comp-shape></g><g class="decomp-lines" data-decomp-lines></g><g class="dimension-labels" data-comp-labels></g>
      </svg>
      <div class="lab-actions"><button type="button" data-method="a">Show decomposition A</button><button type="button" data-method="b">Show decomposition B</button><button type="button" class="soft" data-calc>Calculate pieces</button></div>
      <div class="piece-cards" data-piece-cards></div>
      <p class="feedback" data-feedback>Choose a decomposition. The internal lines can change, but the outside region—and therefore its total area—does not.</p>
    </>
  )}

  {variant === 'volume' && (
    <>
      <div class="lab-head"><div><p class="eyebrow">VOLUME BUILDER</p><h3>Build one layer, then stack it.</h3></div><strong data-volume-readout>Volume = 24 cubes</strong></div>
      <div class="volume-stage"><div><p class="mini-label">ONE BASE LAYER</p><div class="cube-grid" data-cube-grid></div><strong data-layer-count>8 cubes per layer</strong></div><div class="stack-visual" data-stack-visual aria-label="Stacked volume layers"></div><div class="volume-math"><span data-base-area>Base area = 4 × 2 = 8</span><b>×</b><span data-layers>3 layers</span><b>=</b><strong data-volume-math>24 cm³</strong></div></div>
      <div class="controls three"><label>Length <input data-v-l type="range" min="1" max="6" value="4" /><output data-v-l-out>4</output></label><label>Width <input data-v-w type="range" min="1" max="5" value="2" /><output data-v-w-out>2</output></label><label>Height / layers <input data-v-h type="range" min="1" max="6" value="3" /><output data-v-h-out>3</output></label></div>
      <div class="lab-actions"><button type="button" data-show-hidden>Reveal why hidden cubes count</button><button type="button" class="soft" data-equal-volume>Find a same-volume prism</button></div>
      <p class="feedback" data-feedback>Each layer repeats the same base area. That is why volume = base area × height.</p>
    </>
  )}
</div>

<script>
const $all=(sel:string)=>document.querySelectorAll<HTMLElement>(sel);
$all('[data-unit7-lab="parallelogram"]').forEach(lab=>{
 const q=(s:string)=>lab.querySelector<any>(s); const base=q('[data-base]'),height=q('[data-height]'),slant=q('[data-slant]'); let rect=false;
 const update=()=>{const b=Number(base.value),h=Number(height.value),s=Number(slant.value);q('[data-base-out]').textContent=b;q('[data-height-out]').textContent=h;q('[data-slant-out]').textContent=s;q('[data-area-readout]').textContent=`Area = ${b*h} units²`;const x=110,y=205,w=b*27,hh=h*24,shift=rect?0:s*24; q('[data-para-shape]').setAttribute('points',`${x},${y} ${x+w},${y} ${x+w+shift},${y-hh} ${x+shift},${y-hh}`);const hx=x+shift;q('[data-height-line]').setAttribute('x1',hx);q('[data-height-line]').setAttribute('x2',hx);q('[data-height-line]').setAttribute('y1',y-hh);q('[data-height-line]').setAttribute('y2',y);q('[data-right-angle]').setAttribute('d',`M${hx} ${y-12} h12 v12`);q('[data-base-label]').textContent=`base = ${b}`;q('[data-base-label]').setAttribute('x',x+w/2-30);q('[data-height-label]').textContent=`height = ${h}`;q('[data-height-label]').setAttribute('x',hx+8);q('[data-height-label]').setAttribute('y',y-hh/2);q('[data-slant-label]').textContent=rect?'same pieces → rectangle':`slant = ${s}`;q('[data-transform]').textContent=rect?'Return to parallelogram':'Rearrange into rectangle →';};
 [base,height,slant].forEach((el:any)=>el.addEventListener('input',()=>{rect=false;update();q('[data-feedback]').textContent='Notice: changing slant alone changes the look, not the area.';})); q('[data-transform]').addEventListener('click',()=>{rect=!rect;update();q('[data-feedback]').innerHTML=rect?'<strong>Same area.</strong> You moved a piece; you did not add or remove any space.':'The rectangle and parallelogram use the same base and perpendicular height.';});q('[data-para-challenge]').addEventListener('click',()=>q('[data-feedback]').innerHTML='<strong>The slanted side is ignored.</strong> Area needs the perpendicular distance from base to opposite side.');update();
});

$all('[data-unit7-lab="triangle"]').forEach(lab=>{
 const q=(s:string)=>lab.querySelector<any>(s); const bEl=q('[data-tri-base]'),hEl=q('[data-tri-h]'),aEl=q('[data-apex]');let paired=false;
 const update=()=>{const b=Number(bEl.value),h=Number(hEl.value),off=Number(aEl.value);q('[data-tri-base-out]').textContent=b;q('[data-tri-h-out]').textContent=h;q('[data-apex-out]').textContent=off>0?`+${off}`:off;q('[data-tri-readout]').textContent=`Triangle area = ${b*h/2} units²`;const x=100,y=205,w=b*28,hh=h*22,ap=x+w/2+off*22;q('[data-triangle]').setAttribute('points',`${x},${y} ${x+w},${y} ${ap},${y-hh}`);q('[data-tri-height]').setAttribute('x1',ap);q('[data-tri-height]').setAttribute('x2',ap);q('[data-tri-height]').setAttribute('y1',y-hh);q('[data-tri-height]').setAttribute('y2',y);q('[data-tri-angle]').setAttribute('d',`M${ap} ${y-12} h12 v12`);q('[data-tri-base-label]').textContent=`base = ${b}`;q('[data-tri-base-label]').setAttribute('x',x+w/2-30);q('[data-tri-height-label]').textContent=`height = ${h}`;q('[data-tri-height-label]').setAttribute('x',ap+8);q('[data-tri-height-label]').setAttribute('y',y-hh/2); if(paired){q('[data-tri-copy]').hidden=false;q('[data-tri-copy]').setAttribute('points',`${x},${y} ${x+w},${y} ${x+w+(x-ap)},${y+hh}`);} else q('[data-tri-copy]').hidden=true;};
 [bEl,hEl,aEl].forEach((el:any)=>el.addEventListener('input',()=>{update();q('[data-feedback]').textContent='The top vertex moved, but base and perpendicular height still control the area.';}));q('[data-pair]').addEventListener('click',()=>{paired=!paired;update();q('[data-pair]').textContent=paired?'Hide second triangle':'Show the matching second triangle';q('[data-feedback]').innerHTML=paired?'<strong>Two congruent triangles make a parallelogram.</strong> One triangle is half the combined area.':'One triangle keeps half the area of its matching parallelogram.';});q('[data-tri-challenge]').addEventListener('click',()=>q('[data-feedback]').innerHTML='<strong>Because a diagonal creates two congruent triangles.</strong> Each gets one-half of the parallelogram area.');update();
});

$all('[data-unit7-lab="composite"]').forEach(lab=>{
 const q=(s:string)=>lab.querySelector<any>(s);let scenario='house';let method='a';
 const data:any={
  house:{total:52,shape:'<polygon points="120,225 120,105 260,45 400,105 400,225" />',labels:'<text x="215" y="248">8</text><text x="88" y="170">5</text><text x="250" y="82">roof h=3</text>',a:'<line x1="120" y1="105" x2="400" y2="105" />',b:'<line x1="260" y1="45" x2="260" y2="225" />',piecesA:[['Rectangle','8×5','40'],['Triangle','8×3÷2','12']],piecesB:[['Two half-rectangles + roof halves','same region','52']]},
  notch:{total:84,shape:'<path d="M100 60 H420 V230 H260 V170 H100 Z" />',labels:'<text x="240" y="48">12</text><text x="70" y="145">8</text><text x="285" y="194">cutout 4×3</text>',a:'<rect x="260" y="170" width="160" height="60" class="cutout" />',b:'<line x1="260" y1="60" x2="260" y2="170" />',piecesA:[['Whole rectangle','12×8','96'],['Subtract cutout','4×3','−12']],piecesB:[['Left rectangle + top-right rectangle','two pieces','84']]},
  park:{total:108,shape:'<polygon points="90,220 170,80 350,80 430,220 340,220 300,150 220,150 180,220" />',labels:'<text x="235" y="68">parallelogram b=12,h=7</text><text x="220" y="255">two triangles b=6,h=4</text>',a:'<line x1="180" y1="220" x2="220" y2="150" /><line x1="340" y1="220" x2="300" y2="150" />',b:'<line x1="170" y1="150" x2="350" y2="150" />',piecesA:[['Parallelogram','12×7','84'],['Two triangles','2×(6×4÷2)','24']],piecesB:[['Alternative bands','same region','108']]}
 };
 const render=()=>{const d=data[scenario];q('[data-comp-total]').textContent=`Total area = ${d.total} units²`;q('[data-comp-shape]').innerHTML=d.shape;q('[data-comp-labels]').innerHTML=d.labels;q('[data-decomp-lines]').innerHTML=method==='a'?d.a:d.b;q('[data-piece-cards]').innerHTML='';lab.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(b=>b.classList.toggle('active',b.dataset.scenario===scenario));};
 lab.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(b=>b.addEventListener('click',()=>{scenario=b.dataset.scenario||'house';method='a';render();q('[data-feedback]').textContent='New shape loaded. Choose a decomposition and predict the component shapes before calculating.';}));lab.querySelectorAll<HTMLButtonElement>('[data-method]').forEach(b=>b.addEventListener('click',()=>{method=b.dataset.method||'a';render();q('[data-feedback]').innerHTML=`<strong>Decomposition ${method.toUpperCase()}.</strong> Different internal lines can organize the same outside region.`;}));q('[data-calc]').addEventListener('click',()=>{const d=data[scenario];const pieces=method==='a'?d.piecesA:d.piecesB;q('[data-piece-cards]').innerHTML=pieces.map((p:any)=>`<div><strong>${p[0]}</strong><span>${p[1]}</span><b>${p[2]} units²</b></div>`).join('');q('[data-feedback]').innerHTML=`<strong>Total = ${d.total} units².</strong> Every piece is counted once, with no gaps or overlaps.`;});render();
});

$all('[data-unit7-lab="volume"]').forEach(lab=>{
 const q=(s:string)=>lab.querySelector<any>(s);const l=q('[data-v-l]'),w=q('[data-v-w]'),h=q('[data-v-h]');
 const update=()=>{const L=Number(l.value),W=Number(w.value),H=Number(h.value),base=L*W,v=base*H;q('[data-v-l-out]').textContent=L;q('[data-v-w-out]').textContent=W;q('[data-v-h-out]').textContent=H;q('[data-volume-readout]').textContent=`Volume = ${v} cubes`;q('[data-layer-count]').textContent=`${base} cubes per layer`;q('[data-base-area]').textContent=`Base area = ${L} × ${W} = ${base}`;q('[data-layers]').textContent=`${H} layer${H===1?'':'s'}`;q('[data-volume-math]').textContent=`${v} cm³`;const grid=q('[data-cube-grid]');grid.style.gridTemplateColumns=`repeat(${L},24px)`;grid.innerHTML=Array.from({length:base},()=>'<span></span>').join('');const stack=q('[data-stack-visual]');stack.innerHTML=Array.from({length:H},(_,i)=>`<div style="--i:${i};--cols:${L};--rows:${W}"><span>${base}</span></div>`).join('');};
 [l,w,h].forEach((el:any)=>el.addEventListener('input',()=>{update();q('[data-feedback]').textContent='Changing any dimension changes how many unit cubes fit in the prism.';}));q('[data-show-hidden]').addEventListener('click',()=>q('[data-feedback]').innerHTML='<strong>Hidden cubes still occupy space.</strong> Count a complete base layer, then multiply by the number of identical layers instead of counting only visible cubes.');q('[data-equal-volume]').addEventListener('click',()=>{const target=Number(l.value)*Number(w.value)*Number(h.value);let found='';outer:for(let a=1;a<=6;a++)for(let b=1;b<=6;b++)for(let c=1;c<=6;c++)if(a*b*c===target&&(a!==Number(l.value)||b!==Number(w.value)||c!==Number(h.value))){found=`${a} × ${b} × ${c}`;break outer;}q('[data-feedback]').innerHTML=found?`<strong>Same volume:</strong> ${found} also makes ${target} cubic units. Different dimensions can rearrange the same product.`:'Try a larger volume to find another whole-number prism with the same product.';});update();
});
</script>

<style>
.measurement-lab{border:1px solid #d9e2ec;border-radius:20px;padding:1rem;background:#fff}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.lab-head h3{margin:.15rem 0}.lab-head>strong{padding:.6rem .8rem;border-radius:12px;background:var(--course-soft);white-space:nowrap}.shape-canvas{width:100%;min-height:250px;margin:.8rem 0;border:1px solid #e3e9f0;border-radius:16px;background:linear-gradient(#fbfdff,#f5f9fd)}.shape-canvas polygon,.shape-canvas path:not(.right-angle){fill:color-mix(in srgb,var(--course) 22%,white);stroke:var(--course);stroke-width:3}.shape-canvas .cutout{fill:#fff;stroke:#94a3b8;stroke-dasharray:7 5}.height-line,.base-guide,.decomp-lines line{stroke:#d97706;stroke-width:3;stroke-dasharray:7 5}.right-angle{fill:none;stroke:#d97706;stroke-width:2}.shape-canvas text{font-size:15px;font-weight:800;fill:#334155}.ghost-triangle{fill:color-mix(in srgb,#8b5cf6 14%,white)!important;stroke:#8b5cf6!important;stroke-dasharray:7 5}.controls{display:grid;gap:.7rem}.controls.three{grid-template-columns:repeat(3,minmax(0,1fr))}.controls label{display:grid;gap:.35rem;padding:.7rem;border-radius:12px;background:#f7f9fc;font-weight:800}.controls output{font-weight:900}.lab-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.lab-actions button,.scenario-tabs button{border:0;border-radius:11px;padding:.68rem .9rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.lab-actions .soft,.scenario-tabs button{background:#eef3f9;color:#25364f}.scenario-tabs{display:flex;gap:.5rem;flex-wrap:wrap;margin:.8rem 0}.scenario-tabs button.active{background:var(--course);color:#fff}.feedback{min-height:2.6rem;margin:.8rem 0 0;padding:.75rem .85rem;border-radius:11px;background:#fff8db}.piece-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:.7rem}.piece-cards>div{display:grid;gap:.2rem;padding:.7rem;border:1px solid #dfe5ee;border-radius:12px}.piece-cards span{color:#64748b}.volume-stage{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;margin:.8rem 0;padding:1rem;border:1px solid #e3e9f0;border-radius:16px;background:#f8fbff}.cube-grid{display:grid;gap:3px;margin:.5rem 0}.cube-grid span{width:24px;height:24px;border:1px solid #6b8ec8;background:var(--course-soft);border-radius:3px}.stack-visual{position:relative;min-height:170px}.stack-visual>div{position:absolute;left:50%;top:50%;width:clamp(110px,28vw,190px);height:72px;border:2px solid var(--course);border-radius:8px;background:color-mix(in srgb,var(--course-soft) 75%,white);transform:translate(-50%,calc(-50% - var(--i)*15px)) translateX(calc(var(--i)*12px));box-shadow:4px 4px 0 rgba(23,78,166,.08)}.stack-visual span{position:absolute;right:.4rem;top:.25rem;font-size:.75rem;font-weight:900}.volume-math{grid-column:1/-1;display:flex;gap:.6rem;align-items:center;justify-content:center;flex-wrap:wrap;padding:.7rem;border-radius:12px;background:#fff}.volume-math span,.volume-math strong{padding:.45rem .6rem;border-radius:9px;background:var(--course-soft)}@media(max-width:760px){.lab-head,.controls.three,.volume-stage{display:grid;grid-template-columns:1fr}.lab-head>strong{justify-self:start}.piece-cards{grid-template-columns:1fr}.shape-canvas{min-height:210px}.volume-math{justify-content:flex-start}}
</style>
