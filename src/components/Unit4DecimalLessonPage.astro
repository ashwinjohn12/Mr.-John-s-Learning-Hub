---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit4DecimalAlignmentLab from './Unit4DecimalAlignmentLab.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionLinks = [['overview','🎯','Overview'],['big-ideas','🌎','Big Ideas'],['understand','📘','Understand'],['examples','🧩','Examples'],['vocabulary','🧠','Vocabulary'],['explore','🔬','Explore'],['practise','✏️','Practise'],['check','✅','Check Yourself'],['apply','🎮','Apply'],['review','🏁','Review']];
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const coreExamples = content.examples.slice(0, 2);
const advancedExamples = content.examples.slice(2);
---
<BaseLayout title={`${topic.title} | ${course.grade} ${course.shortSubject}`} description={topic.summary} themeColor={course.color}>
  <div class="topic-shell" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <aside class="topic-sidebar">
      <a class="back-course" href={`${base}courses/${course.slug}/${unit.slug}/`}>← {unit.title}</a>
      <p class="eyebrow">ON THIS PAGE</p>
      <p class="scroll-cue">Swipe sections →</p>
      <nav aria-label="Lesson sections">{sectionLinks.map(([id,icon,label]) => <a href={`#${id}`}><span>{icon}</span>{label}</a>)}</nav>
    </aside>

    <article class="topic-content">
      <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`,href:`${base}courses/${course.slug}/`},{label:unit.title,href:`${base}courses/${course.slug}/${unit.slug}/`},{label:topic.title}]} />

      <header class="topic-hero">
        <p class="eyebrow">LESSON {topic.number} · {course.grade.toUpperCase()} {course.shortSubject.toUpperCase()}</p>
        <h1>{topic.title}</h1>
        <p>{topic.summary}</p>
        <div class="hook-card"><div><strong>Start with this</strong><small>Make a prediction. You are not expected to know the answer yet.</small></div><span>{content.hook}</span></div>
      </header>

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map(item => <li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{content.goals.map(goal => <li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <div class="student-path">
          <p class="mini-label">A GOOD WAY TO WORK THROUGH THIS LESSON</p>
          <div class="path-steps"><div><strong>1 · Learn</strong><span>Big Ideas → Understand → Examples</span></div><div><strong>2 · Explore</strong><span>Vocabulary → Decimal Alignment Lab → place-value mat</span></div><div><strong>3 · Show it</strong><span>Practise → Check Yourself → Apply → Review</span></div></div>
          <p class="path-note"><strong>Working on your own?</strong> Stop after Explore if you need a break. Return to Practice and Check Yourself when you are ready.</p>
        </div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item => <li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p>
        <p>{content.bigIdeaDetail}</p>
        <div class="three-step-rule">
          <div><span>1</span><strong>Name the units</strong><small>Ones? Tenths? Hundredths?</small></div>
          <div><span>2</span><strong>Align equal units</strong><small>Use the decimal point as a place-value guide.</small></div>
          <div><span>3</span><strong>Calculate & check</strong><small>Regroup if needed, then compare with an estimate.</small></div>
        </div>
        <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,index) => <div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>

        <article class="bridge-card">
          <p class="eyebrow">UNIT 4 CONNECTION · SAME-SIZED UNITS</p>
          <h3>Fractions and decimals use the same big idea</h3>
          <div class="bridge-grid">
            <div><strong>Lesson 4.1 · Fractions</strong><span>Rename fractions so both use the same-sized pieces before combining them.</span><code>3/4 + 1/8 → 6/8 + 1/8</code></div>
            <div><strong>Lesson 4.4 · Decimals</strong><span>Line up digits that represent the same place-value units before combining them.</span><code>5.80 + 0.47</code></div>
          </div>
          <p class="model-note"><strong>Same principle:</strong> combine like units with like units.</p>
        </article>

        <article class="alignment-card">
          <p class="eyebrow">VISUAL MODEL · PLACE VALUE</p>
          <h3>The decimal points line up because the place values line up</h3>
          <div class="alignment-demo"><pre> 12.4500
+ 8.7632
─────────
 21.2132</pre></div>
          <p>Writing 12.45 as 12.4500 does not change its value. It simply makes the hundredths, thousandths, and ten-thousandths columns easier to see.</p>
        </article>

        <article class="decision-card">
          <p class="eyebrow">QUICK DECISION GUIDE</p>
          <h3>What should I think about before calculating?</h3>
          <div class="decision-steps"><div><strong>Finding a total?</strong><span>Combine quantities with addition.</span></div><div><strong>Finding a change or comparison?</strong><span>Use subtraction in the order that matches the story.</span></div><div><strong>Checking your answer?</strong><span>Estimate with friendly numbers and compare sizes.</span></div></div>
        </article>

        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item => <details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
        <p class="section-lead">Start with the place-value connection and a direct decimal sum. Open the next examples when you are ready for subtraction, money, race times, and a larger data comparison.</p>
        <div class="example-stack">{coreExamples.map(example => <article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step => <li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
        {advancedExamples.length > 0 && <details class="advanced-examples"><summary>Ready for the next level? Open Examples 3–6</summary><div class="example-stack advanced-stack">{advancedExamples.map(example => <article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step => <li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>}
        <article class="snapshot-card"><p class="eyebrow">STRATEGY SNAPSHOT</p><h3>Alignment is really unit matching</h3><div class="snapshot-flow"><span>5.8</span><b>→</b><span>5.80</span><b>+</b><span>0.47</span><b>→</b><span>6.27</span></div><p>The zero helps show that 8 tenths belongs above 4 tenths and 0 hundredths belongs above 7 hundredths.</p></article>
      </LearningSection>

      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack"><div><h3>Decimal Alignment Lab</h3><p>Work from A to D: align, test zeros, diagnose errors, then connect scaled calculations.</p><Unit4DecimalAlignmentLab /></div></div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item => <li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> Use lined or grid paper if you have it. One digit per column makes place-value alignment much easier to see.</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={content.questions} /></LearningSection>
      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. There are no Practice hints here. Choose <strong>New set</strong> when you want another mix.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>
      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map(task => <li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item => <li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map(item => <li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map(item => <li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map(item => <label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>{content.next.status === 'planned' ? 'Lesson 4.5 is coming soon. Use the checklist above to decide what you want to practise again first.' : 'Continue when you are ready.'}</small></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span class="coming-next">Coming soon</span>}</div>
      </LearningSection>
    </article>
  </div>
</BaseLayout>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft,#eef4ff);line-height:1.55}.hook-card>div{display:grid;align-content:start;gap:.2rem}.hook-card small{display:block;max-width:210px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.wrap-grid ul,.worked-example ol,.hands-on-card ol,.lesson-challenge ol{padding-left:1.2rem}.overview-grid li,.wrap-grid li,.worked-example li,.hands-on-card li,.lesson-challenge li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.student-path{margin-top:1rem;padding:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#fff}.path-steps,.three-step-rule,.decision-steps,.bridge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.bridge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.path-steps>div,.three-step-rule>div,.decision-steps>div,.bridge-grid>div{display:grid;gap:.25rem;padding:.8rem;border-radius:12px;background:#f7f9fc}.three-step-rule{margin:1rem 0}.three-step-rule>div{border:1px solid #dfe5ee;background:#fff}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.path-note{margin:.8rem 0 0;padding:.7rem;border-radius:10px;background:#fff8db}.success-box{margin-top:1rem}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.bridge-card,.alignment-card,.decision-card,.worked-example,.hands-on-card,.pat-card,.snapshot-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff;margin-top:1rem}.bridge-card h3,.alignment-card h3,.decision-card h3,.worked-example h3,.hands-on-card h3,.snapshot-card h3{margin:.25rem 0 .75rem}.bridge-grid code{margin-top:.35rem;padding:.5rem;border-radius:8px;background:#edf3fa;font:800 .95rem ui-monospace,monospace}.alignment-demo{display:grid;place-items:center;margin:.8rem 0;padding:1rem;border-radius:12px;background:#101828;color:#fff}.alignment-demo pre{margin:0;font:800 1.25rem/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.model-note{padding:.7rem;border-radius:10px;background:#eef6ff}.mixups{margin-top:1.2rem}.example-stack,.explore-stack{display:grid;gap:1rem}.example-answer{margin-top:.8rem;padding:.7rem;border-radius:10px;background:var(--course-soft,#eef4ff)}.advanced-examples{margin-top:1rem}.advanced-examples summary{cursor:pointer;font-weight:900}.advanced-stack{margin-top:1rem}.snapshot-flow{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap}.snapshot-flow span{padding:.55rem .7rem;border-radius:10px;background:#eef4ff;font-weight:900}.home-note{padding:.65rem;border-radius:10px;background:#fff8db}.lesson-challenge{display:grid;gap:1rem}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:1rem 0}.review-grid label{padding:.75rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.next-step{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:1rem;padding:1rem;border-radius:16px;background:#f5f7fa}.next-step>div{display:grid;gap:.2rem}.next-step small{color:#526174}.coming-next{font-weight:900;color:#64748b}.section-lead{color:#48576b;line-height:1.6}@media(max-width:760px){.overview-grid,.wrap-grid,.path-steps,.three-step-rule,.decision-steps,.bridge-grid,.review-grid{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.hook-card{grid-template-columns:1fr}.next-step{align-items:flex-start;flex-direction:column}}
</style>
