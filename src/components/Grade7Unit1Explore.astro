---
import type { LessonSpec } from '../data/grade7Unit1';
interface Props { lesson: LessonSpec }
const { lesson } = Astro.props;
const gridLines = Array.from({ length: 7 }, (_, index) => 24 + index * 36);
---

<div class="explore-lab" data-explore-lab data-variant={lesson.slug}>
  <div class="lab-launch"><p class="eyebrow">YOUR MISSION</p><h3>{lesson.explore.title}</h3><p>{lesson.explore.launch}</p></div>
  <div class="lab-tabs" role="tablist" aria-label="Investigation phases">
    {lesson.explore.phases.map((phase, index) => <button id={`${lesson.slug}-tab-${index}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`${lesson.slug}-phase-${index}`} tabindex={index === 0 ? '0' : '-1'} data-tab={index}><span>{index + 1}</span>{phase.title}</button>)}
  </div>
  <div class="lab-panels">
    {lesson.explore.phases.map((phase, index) => <section id={`${lesson.slug}-phase-${index}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${index}`} data-panel={index} hidden={index !== 0}>
      <p class="phase-instruction">{phase.instruction}</p>
      <div class="tool-surface">
        {lesson.slug === 'more-patterns-in-division' && <><label>{index === 3 ? 'Dividend to examine' : 'Whole number to test'}<input type="number" inputmode="numeric" min="0" max="99999" step="1" value={index === 3 ? 18 : 468} data-tool-input /></label><button type="button" data-tool-run>{index === 3 ? 'Compare the zero cases' : 'Reveal divisibility evidence'}</button><div class="digit-model" data-model aria-label="Digit-sum model"></div><output data-tool-output aria-live="polite">Predict first, then reveal the evidence.</output></>}
        {lesson.slug === 'algebraic-expressions' && <><label>Number of shifts: <output data-range-value>5</output><input type="range" min="0" max="12" step="1" value="5" data-tool-input /></label><button type="button" data-tool-run>Evaluate both plans</button><div class="bar-model" data-model aria-label="Comparison of plan totals"><span data-bar-a></span><span data-bar-b></span></div><output data-tool-output aria-live="polite">Plan A is 18s. Plan B is 30 + 12s.</output></>}
        {lesson.slug === 'relationships-in-patterns' && <><label>Figure number<input type="number" inputmode="numeric" min="1" max="20" step="1" value="4" data-tool-input /></label><button type="button" data-tool-run>Build the figure</button><div class="tile-model" data-model aria-label="Growing tile pattern"></div><output data-tool-output aria-live="polite">The design follows 3n + 2: repeated groups plus fixed tiles.</output></>}
        {lesson.slug === 'patterns-tables' && <><label>Mystery input<input type="number" inputmode="numeric" min="0" max="30" step="1" value="6" data-tool-input /></label><button type="button" data-tool-run>Send through the machine</button><div class="machine-model" data-model aria-label="Input-output machine"><b>INPUT</b><span>× 2, then + 1</span><b>OUTPUT</b></div><div class="pair-table" data-pair-table aria-label="Recorded input-output pairs"><span>Input</span><span>Output</span></div><output data-tool-output aria-live="polite">Collect at least three pairs before naming the rule.</output></>}
        {lesson.slug === 'graphing-relations' && <><label>x-coordinate<input type="number" inputmode="numeric" min="0" max="6" step="1" value="3" data-tool-input /></label><button type="button" data-tool-run>Plot relation point</button><div class="graph-wrap" data-model><svg viewBox="0 0 272 272" role="img" aria-label="Coordinate graph for y equals 3x plus 2">{gridLines.map(value => <line x1={value} y1="24" x2={value} y2="240" />)}{gridLines.map(value => <line x1="24" y1={value} x2="240" y2={value} />)}<line class="axis" x1="24" y1="240" x2="248" y2="240" /><line class="axis" x1="24" y1="248" x2="24" y2="16" /><circle data-graph-point cx="132" cy="141" r="7" /><text data-graph-label x="142" y="133">(3, 11)</text><text x="250" y="254">x</text><text x="10" y="18">y</text></svg></div><output data-tool-output aria-live="polite">The studio uses y = 3x + 2. Input comes first in every ordered pair.</output></>}
        {lesson.slug === 'reading-writing-equations' && <><div class="case-card" data-case>4n + 3 = 27</div><div class="case-actions" role="group" aria-label="Classify the case"><button type="button" data-classify="expression">Expression</button><button type="button" data-classify="equation">Equation</button><button type="button" data-classify="neither">Neither</button></div><button type="button" class="secondary" data-next-case>Next case</button><output data-tool-output aria-live="polite">Decide what the statement communicates—not only which symbols it contains.</output></>}
        {lesson.slug === 'equations-algebra-tiles' && <><label>Units beside x<input type="number" inputmode="numeric" min="1" max="10" step="1" value="4" data-tool-input /></label><button type="button" data-tool-run>Apply the same move</button><div class="balance-model" data-model aria-label="Balanced equation model"><div><span class="x-tile">x</span><span data-left-units></span></div><b>=</b><div data-right-units></div></div><output data-tool-output aria-live="polite">The model begins with x + 4 = 11.</output></>}
      </div>
      <p class="phase-target"><strong>Evidence to record:</strong> {phase.target}</p><label class="lab-note">My evidence<textarea rows="3" placeholder="I notice… because…" data-note></textarea></label><button class="phase-complete" type="button" data-complete>Mark phase complete</button><p data-phase-status role="status">Not completed yet.</p>
    </section>)}
  </div>
  <div class="lab-reflection"><strong>Convince a skeptic</strong>{lesson.explore.reflection.map(question => <span>{question}</span>)}</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-explore-lab]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const clampWhole = (input: HTMLInputElement | null, min: number, max: number) => { const raw = Number(input?.value); const safe = Number.isFinite(raw) ? Math.min(max, Math.max(min, Math.round(raw))) : min; if (input) input.value = String(safe); return safe; };
    const activate = (index: number, moveFocus = false) => { tabs.forEach((tab, tabIndex) => { const active = tabIndex === index; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; }); panels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== index); if (moveFocus) tabs[index]?.focus(); };
    tabs.forEach((tab, index) => { tab.addEventListener('click', () => activate(index)); tab.addEventListener('keydown', (event) => { if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return; event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : ['ArrowRight', 'ArrowDown'].includes(event.key) ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length; activate(next, true); }); });
    const cases = [{ text: '4n + 3 = 27', answer: 'equation', why: 'It claims that two expressions have the same value.' }, { text: '7x − 5', answer: 'expression', why: 'It names a value but makes no equality claim.' }, { text: '12 > 9', answer: 'neither', why: 'It is an inequality, not an expression alone or an equation.' }, { text: '18 = 3(6)', answer: 'equation', why: 'Different-looking expressions can still have equal value.' }];
    panels.forEach((panel) => {
      const input = panel.querySelector<HTMLInputElement>('[data-tool-input]'); const output = panel.querySelector<HTMLOutputElement>('[data-tool-output]'); const range = panel.querySelector<HTMLOutputElement>('[data-range-value]'); const pairTable = panel.querySelector<HTMLElement>('[data-pair-table]'); const recorded = new Map<number, number>(); let caseIndex = Number(panel.dataset.panel || 0) % cases.length;
      const setOutput = (message: string) => { if (output) output.textContent = message; };
      const renderCase = () => { const card = panel.querySelector<HTMLElement>('[data-case]'); if (card) card.textContent = cases[caseIndex].text; setOutput('Classify the statement, then explain what the symbols communicate.'); };
      const units = (count: number) => Array.from({ length: count }, () => '<i aria-hidden="true"></i>').join('');
      const renderBalance = (n: number) => { const left = panel.querySelector<HTMLElement>('[data-left-units]'); const right = panel.querySelector<HTMLElement>('[data-right-units]'); if (left) left.innerHTML = units(n); if (right) right.innerHTML = units(11); };
      const renderPattern = (n: number) => { const model = panel.querySelector<HTMLElement>('.tile-model'); if (model) model.innerHTML = `${Array.from({ length: n }, (_, group) => `<span class="tile-group" aria-label="growth group ${group + 1}"><i></i><i></i><i></i></span>`).join('')}<span class="fixed-tiles" aria-label="two fixed tiles"><i></i><i></i></span>`; };
      const renderGraph = (n: number, y: number) => { const point = panel.querySelector<SVGCircleElement>('[data-graph-point]'); const label = panel.querySelector<SVGTextElement>('[data-graph-label]'); const cx = 24 + n * 36; const cy = 240 - (y / 4) * 36; point?.setAttribute('cx', String(cx)); point?.setAttribute('cy', String(cy)); if (label) { label.setAttribute('x', String(Math.min(205, cx + 10))); label.setAttribute('y', String(Math.max(24, cy - 8))); label.textContent = `(${n}, ${y})`; } };
      input?.addEventListener('input', () => { if (range) range.textContent = input.value; });
      panel.querySelector('[data-tool-run]')?.addEventListener('click', () => {
        switch (root.dataset.variant) {
          case 'more-patterns-in-division': { const n = clampWhole(input, 0, 99999); const digits = String(n).split('').map(Number); const sum = digits.reduce((total, digit) => total + digit, 0); const model = panel.querySelector<HTMLElement>('[data-model]'); if (panel.dataset.panel === '3') { if (model) model.innerHTML = '<span>0 × ? = dividend</span><span>0 ÷ nonzero = 0</span>'; setOutput(n === 0 ? '0 ÷ 0 is undefined because every value of q makes 0 × q = 0, so division cannot select one unique quotient.' : `${n} ÷ 0 is undefined because no value of q makes 0 × q = ${n}. By contrast, 0 ÷ ${n} = 0 because the divisor is nonzero.`); } else { if (model) model.innerHTML = `${digits.map(digit => `<span>${digit}</span>`).join('')}<b>= ${sum}</b>`; setOutput(`Digit sum ${sum}. Divisible by 3: ${n % 3 === 0 ? 'yes' : 'no'}; by 6: ${n % 6 === 0 ? 'yes' : 'no'}; by 9: ${n % 9 === 0 ? 'yes' : 'no'}.`); } break; }
          case 'algebraic-expressions': { const n = clampWhole(input, 0, 12); const a = 18 * n; const b = 30 + 12 * n; const scale = Math.max(a, b, 1); const barA = panel.querySelector<HTMLElement>('[data-bar-a]'); const barB = panel.querySelector<HTMLElement>('[data-bar-b]'); if (barA) { barA.style.width = `${a / scale * 100}%`; barA.textContent = `18s = $${a}`; } if (barB) { barB.style.width = `${b / scale * 100}%`; barB.textContent = `30 + 12s = $${b}`; } setOutput(`At ${n} shifts, Plan A is $${a} and Plan B is $${b}. ${a === b ? 'The plans match.' : a > b ? 'Plan A is greater.' : 'Plan B is greater.'}`); break; }
          case 'relationships-in-patterns': { const n = clampWhole(input, 1, 20); renderPattern(n); setOutput(`Figure ${n} has ${3 * n + 2} tiles: ${n} groups of 3 plus 2 fixed tiles.`); break; }
          case 'patterns-tables': { const n = clampWhole(input, 0, 30); const y = 2 * n + 1; recorded.set(n, y); if (pairTable) pairTable.innerHTML = `<span>Input</span><span>Output</span>${[...recorded].map(([x, value]) => `<b>${x}</b><b>${value}</b>`).join('')}`; setOutput(`Input ${n} produces output ${y}. ${recorded.size < 3 ? `Collect ${3 - recorded.size} more distinct pair${recorded.size === 2 ? '' : 's'} before naming the rule.` : 'Now test whether y = 2x + 1 matches every recorded pair.'}`); break; }
          case 'graphing-relations': { const n = clampWhole(input, 0, 6); const y = 3 * n + 2; renderGraph(n, y); setOutput(`Plotted (${n}, ${y}). Move ${n} along x, then locate ${y} on the y-scale. This point is known data, not a prediction.`); break; }
          case 'equations-algebra-tiles': { const n = clampWhole(input, 1, 10); renderBalance(n); setOutput(`Remove ${n} units from both sides. From x + ${n} = 11, x = ${11 - n}. Check: ${11 - n} + ${n} = 11.`); break; }
        }
      });
      panel.querySelectorAll<HTMLButtonElement>('[data-classify]').forEach(button => button.addEventListener('click', () => { const current = cases[caseIndex]; const correct = button.dataset.classify === current.answer; setOutput(`${correct ? 'Correct.' : 'Not yet.'} ${current.why}`); }));
      panel.querySelector('[data-next-case]')?.addEventListener('click', () => { caseIndex = (caseIndex + 1) % cases.length; renderCase(); });
      panel.querySelector('[data-complete]')?.addEventListener('click', () => { const note = panel.querySelector<HTMLTextAreaElement>('[data-note]'); const status = panel.querySelector<HTMLElement>('[data-phase-status]'); if ((note?.value.trim().length || 0) < 20 || !/(because|shows|so|therefore|since|evidence)/i.test(note?.value || '')) { if (status) status.textContent = 'Add a complete evidence sentence using because, shows, so, since, or therefore.'; note?.focus(); return; } panel.dataset.complete = 'true'; if (status) status.textContent = 'Phase complete. Your evidence is saved on this page.'; });
      if (root.dataset.variant === 'reading-writing-equations') renderCase(); if (root.dataset.variant === 'relationships-in-patterns') renderPattern(4); if (root.dataset.variant === 'equations-algebra-tiles') renderBalance(4);
    });
  });
</script>

<style>
  .explore-lab{border-radius:16px;overflow:hidden;background:#102b32;color:#fff}.lab-launch{padding:1.2rem;background:linear-gradient(135deg,#143d46,#285867)}.lab-launch h3{margin:.15rem 0;font-size:1.55rem}.lab-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ffffff26}.lab-tabs button{display:grid;gap:.25rem;border:0;padding:.75rem;background:#183942;color:#dceff2;font-weight:750;text-align:left;cursor:pointer}.lab-tabs button span{display:grid;place-items:center;width:1.5rem;height:1.5rem;border-radius:99px;background:#ffffff1f}.lab-tabs button[aria-selected=true]{background:#fff;color:#17343c}.lab-panels{background:#fff;color:#18283b}.lab-panels section{padding:1.2rem}.phase-instruction{font-size:1.07rem}.tool-surface{display:grid;grid-template-columns:minmax(180px,1fr) auto;gap:.75rem;align-items:end;padding:1rem;border:1px solid #d5e3e7;border-radius:13px;background:#f1f8fa}.tool-surface label{display:grid;gap:.3rem;font-weight:800}.tool-surface input{font:inherit;padding:.55rem;border:1px solid #78909c;border-radius:8px;min-height:42px}.tool-surface button,.phase-complete{border:0;border-radius:9px;background:#176b77;color:#fff;padding:.65rem .8rem;font-weight:850;cursor:pointer}.tool-surface button.secondary{background:#e4edf0;color:#17343c}.tool-surface output{grid-column:1/-1;padding:.75rem;border-radius:9px;background:#fff;min-height:2.75rem}.digit-model,.tile-model,.machine-model,.bar-model,.balance-model,.graph-wrap,.pair-table{grid-column:1/-1;padding:.8rem;border:1px solid #d2e1e5;border-radius:11px;background:#fff}.digit-model{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}.digit-model span{display:grid;place-items:center;min-width:2.2rem;height:2.2rem;border-radius:8px;background:#dff3ee;font-weight:900}.tile-model{display:flex;gap:.55rem;align-items:center;overflow-x:auto}.tile-group,.fixed-tiles{display:flex;gap:.18rem;padding:.3rem;border-radius:7px;background:#e6f2ff;flex:0 0 auto}.fixed-tiles{background:#fff0c9}.tile-model i,.balance-model i{display:block;width:20px;height:20px;border:2px solid #176b77;border-radius:4px;background:#bde9df}.bar-model{display:grid;gap:.5rem}.bar-model span{display:block;min-width:8rem;padding:.45rem .6rem;border-radius:7px;background:#68c7b4;color:#102b32;font-weight:850;transition:width .2s}.bar-model span+span{background:#f1cb70}.machine-model{display:grid;grid-template-columns:auto 1fr auto;gap:.7rem;align-items:center;text-align:center}.machine-model span{padding:.65rem;border-radius:9px;background:#173f49;color:#fff}.pair-table{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#cbdde2;padding:1px}.pair-table>*{padding:.45rem;background:#fff;text-align:center}.graph-wrap{max-width:430px}.graph-wrap svg{display:block;width:100%;height:auto}.graph-wrap line{stroke:#d4e2e6;stroke-width:1}.graph-wrap .axis{stroke:#17343c;stroke-width:2}.graph-wrap circle{fill:#c64632;stroke:#fff;stroke-width:2}.graph-wrap text{font:700 12px system-ui;fill:#17343c}.case-card{grid-column:1/-1;padding:1rem;border:2px dashed #176b77;border-radius:10px;font-size:1.35rem;font-weight:900;text-align:center}.case-actions{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.5rem}.balance-model{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.8rem;border-bottom:6px solid #586b75}.balance-model>div{display:flex;flex-wrap:wrap;justify-content:center;gap:.22rem;min-height:54px;padding:.55rem;border-bottom:3px solid #176b77}.x-tile{display:grid;place-items:center;width:42px;height:48px;border:2px solid #2457c5;border-radius:6px;background:#dbeafe;font-weight:900}.phase-target{padding:.7rem;background:#eaf7f3;border-radius:9px}.lab-note{display:grid;gap:.35rem;font-weight:800}.lab-note textarea{font:inherit;padding:.65rem;border:1px solid #78909c;border-radius:9px}.lab-reflection{display:grid;grid-template-columns:auto repeat(3,1fr);gap:.65rem;align-items:center;padding:1rem;background:#102b32}.lab-reflection span{padding:.55rem;border-radius:8px;background:#ffffff12}.explore-lab button:focus-visible,.explore-lab input:focus-visible,.explore-lab textarea:focus-visible{outline:3px solid #f5c451;outline-offset:2px}@media(max-width:760px){.lab-tabs{display:flex;overflow-x:auto}.lab-tabs button{min-width:155px;min-height:74px}.tool-surface,.lab-reflection{grid-template-columns:1fr}.tool-surface output,.digit-model,.tile-model,.machine-model,.bar-model,.balance-model,.graph-wrap,.pair-table,.case-card,.case-actions{grid-column:1}.machine-model{grid-template-columns:1fr}.balance-model{grid-template-columns:1fr}.lab-panels section{padding:.85rem}}@media(prefers-reduced-motion:reduce){.bar-model span{transition:none}}
</style>
