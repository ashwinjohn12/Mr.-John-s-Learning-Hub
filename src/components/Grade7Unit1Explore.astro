---
import type { LessonSpec } from '../data/grade7Unit1';
import { grade7Unit1ExploreChecks } from '../data/grade7Unit1ExploreChecks';
interface Props { lesson: LessonSpec }
const { lesson } = Astro.props;
const gridLines = Array.from({ length: 7 }, (_, index) => 24 + index * 36);
const phaseChecks=grade7Unit1ExploreChecks[lesson.slug];
---

<div class="explore-lab" data-explore-lab data-variant={lesson.slug}>
  <div class="lab-launch"><p class="eyebrow">YOUR MISSION</p><h3>{lesson.explore.title}</h3><p>{lesson.explore.launch}</p></div>
  <div class="lab-tabs" role="tablist" aria-label="Investigation phases">
    {lesson.explore.phases.map((phase, index) => <button id={`${lesson.slug}-tab-${index}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`${lesson.slug}-phase-${index}`} tabindex={index === 0 ? '0' : '-1'} data-tab={index}><span>{index + 1}</span>{phase.title}</button>)}
  </div>
  <div class="lab-panels">
    {lesson.explore.phases.map((phase, index) => <section id={`${lesson.slug}-phase-${index}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${index}`} data-panel={index} hidden={index !== 0}>
      <p class="phase-instruction">{phase.instruction}</p>
      <div class="tool-surface">
        {lesson.slug === 'more-patterns-in-division' && <><label>{index === 3 ? 'Dividend to examine' : 'Whole number to test'}<input type="number" inputmode="numeric" min="0" max="99999" step="1" value={index === 3 ? 18 : 468} data-tool-input /></label><button type="button" data-tool-run>{index === 3 ? 'Compare the zero cases' : 'Reveal divisibility evidence'}</button><div class="digit-model" data-model aria-label="Digit-sum model"></div><output data-tool-output aria-live="polite">Predict first, then reveal the evidence.</output></>}
        {lesson.slug === 'algebraic-expressions' && <><label>Number of shifts: <output data-range-value>5</output><input type="range" min="0" max="12" step="1" value="5" data-tool-input /></label><button type="button" data-tool-run>Evaluate both plans</button><div class="bar-model" data-model aria-label="Comparison of plan totals"><span data-bar-a></span><span data-bar-b></span></div><output data-tool-output aria-live="polite">Plan A is 18s. Plan B is 30 + 12s.</output></>}
        {lesson.slug === 'relationships-in-patterns' && <><label>Figure number<input type="number" inputmode="numeric" min="1" max="20" step="1" value="4" data-tool-input /></label><button type="button" data-tool-run>Build the figure</button><div class="tile-model" data-model aria-label="Growing tile pattern"></div><output data-tool-output aria-live="polite">The design follows 3n + 2: repeated groups plus fixed tiles.</output></>}
        {lesson.slug === 'patterns-tables' && <><label>Mystery input<input type="number" inputmode="numeric" min="0" max="30" step="1" value="6" data-tool-input /></label><button type="button" data-tool-run>Send through the machine</button><div class="machine-model" data-model aria-label="Input-output machine with hidden rule"><b>INPUT</b><span data-machine-rule>Rule hidden—collect evidence</span><b>OUTPUT</b></div><div class="pair-table" data-pair-table role="table" aria-label="Recorded input-output pairs"><span role="columnheader">Input</span><span role="columnheader">Output</span></div><output data-tool-output aria-live="polite">Collect at least three distinct pairs before naming the rule.</output></>}
        {lesson.slug === 'graphing-relations' && <><div class="coordinate-inputs"><label>x-coordinate<input type="number" inputmode="numeric" min="0" max="6" step="1" value="3" data-tool-input /></label><label>y-coordinate<input type="number" inputmode="numeric" min="0" max="20" step="1" value="11" data-graph-y /></label></div><button type="button" data-tool-run>Check and plot point</button><div class="graph-wrap" data-model><svg viewBox="0 0 290 285" role="img" aria-labelledby={`${lesson.slug}-graph-title-${index} ${lesson.slug}-graph-desc-${index}`}><title id={`${lesson.slug}-graph-title-${index}`}>Graph of y equals 3x plus 2</title><desc id={`${lesson.slug}-graph-desc-${index}`} data-graph-summary>Horizontal x-axis from 0 to 6 by 1. Vertical y-axis from 0 to 24 by 4. No student points plotted yet.</desc>{gridLines.map(value => <line x1={value} y1="24" x2={value} y2="240" />)}{gridLines.map(value => <line x1="24" y1={value} x2="240" y2={value} />)}<line class="axis" x1="24" y1="240" x2="248" y2="240" /><line class="axis" x1="24" y1="248" x2="24" y2="16" />{Array.from({length:7},(_,i)=><text x={24+i*36} y="258" text-anchor="middle">{i}</text>)}{Array.from({length:7},(_,i)=><text x="17" y={244-i*36} text-anchor="end">{i*4}</text>)}<text x="136" y="278" text-anchor="middle">Input, x</text><text x="262" y="25">Output, y</text><g data-graph-points></g></svg></div><output data-tool-output aria-live="polite">Enter both coordinates for a point on y = 3x + 2. Input comes first.</output></>}
        {lesson.slug === 'reading-writing-equations' && index===0 && <><div class="case-card" data-case>4n + 3 = 27</div><div class="case-actions" role="group" aria-label="Classify the case"><button type="button" data-classify="expression">Expression</button><button type="button" data-classify="equation">Equation</button><button type="button" data-classify="neither">Neither</button></div><button type="button" class="secondary" data-next-case>Next case</button><output data-tool-output aria-live="polite">Classify several statements by what they communicate.</output></>}
        {lesson.slug === 'reading-writing-equations' && index===1 && <><div class="case-card">Repair “n+8” for “a number plus 8 equals 25.”</div><div class="case-actions" role="group" aria-label="Choose the repaired statement"><button type="button" data-phase-option="0">n+8=25</button><button type="button" data-phase-option="1">n=8+25</button><button type="button" data-phase-option="2">8n=25</button></div><output data-tool-output aria-live="polite">Choose the statement that preserves the complete meaning.</output></>}
        {lesson.slug === 'reading-writing-equations' && index===2 && <><div class="case-card">Three times a number plus 2 is 20.</div><div class="case-actions" role="group" aria-label="Translate the testimony"><button type="button" data-phase-option="1">3(n+2)=20</button><button type="button" data-phase-option="0">3n+2=20</button><button type="button" data-phase-option="2">3+n+2=20</button></div><output data-tool-output aria-live="polite">Translate every operation and the equality claim.</output></>}
        {lesson.slug === 'reading-writing-equations' && index===3 && <><div class="case-card">Proposed value: n=6 for 3n+2=20</div><div class="case-actions" role="group" aria-label="Verify the proposed value"><button type="button" data-phase-option="0">Accept</button><button type="button" data-phase-option="1">Reject</button></div><output data-tool-output aria-live="polite">Evaluate the left-hand and right-hand sides before deciding.</output></>}
        {lesson.slug === 'equations-algebra-tiles' && index===0 && <><label>Units beside x<input type="number" inputmode="numeric" min="1" max="10" step="1" value="4" data-tool-input /></label><button type="button" data-tool-run>Remove from both sides</button><div class="balance-model" data-model aria-label="Balance model for x plus 4 equals 11"><div><span class="x-tile">x</span><span data-left-units></span></div><b>=</b><div data-right-units></div></div><output data-tool-output aria-live="polite">The model begins with x + 4 = 11.</output></>}
        {lesson.slug === 'equations-algebra-tiles' && index===1 && <><label>Number of equal x-groups<input type="number" value="3" min="2" max="6" step="1" data-tool-input /></label><button type="button" data-tool-run>Partition both sides</button><div class="balance-model" data-model aria-label="Balance model for 3x equals 18"><div data-equation-left><span class="x-tile">x</span><span class="x-tile">x</span><span class="x-tile">x</span></div><b>=</b><div data-equation-right>18 unit tiles</div></div><output data-tool-output aria-live="polite">Partition 3x = 18 into three equal groups.</output></>}
        {lesson.slug === 'equations-algebra-tiles' && index===2 && <><label>Units to remove from 2x+5=19<input type="number" value="5" min="0" max="19" step="1" data-tool-input /></label><button type="button" data-tool-run>Test the legal move</button><div class="balance-model" data-model aria-label="Balance model for 2x plus 5 equals 19"><div data-equation-left><span class="x-tile">x</span><span class="x-tile">x</span><span>+ 5 units</span></div><b>=</b><div data-equation-right>19 units</div></div><output data-tool-output aria-live="polite">Choose an amount to remove from both sides.</output></>}
        {lesson.slug === 'equations-algebra-tiles' && index===3 && <><label>Equation form<select data-equation-type><option value="add">x+4=11</option><option value="multiply">3x=18</option><option value="two-step">2x+5=19</option><option value="divide">x÷4=5</option></select></label><label>Proposed value of x<input type="number" value="7" min="0" max="50" step="1" data-tool-input /></label><button type="button" data-tool-run>Verify in the original equation</button><div class="equation-forms" data-model aria-label="Four equation forms">x+4=11 · 3x=18 · 2x+5=19 · x÷4=5</div><output data-tool-output aria-live="polite">Select a form and verify a value by substitution.</output></>}
      </div>
      {phaseChecks?.[index]&&<fieldset class="phase-check" data-phase-check data-answer={phaseChecks[index].answer} data-feedback={phaseChecks[index].feedback}><legend>Checkpoint: {phaseChecks[index].prompt}</legend>{phaseChecks[index].choices.map((choice,choiceIndex)=><label><input type="radio" name={`${lesson.slug}-phase-check-${index}`} value={choiceIndex}/>{choice}</label>)}<button type="button" data-phase-check-button>Check the mathematics</button><p data-phase-check-status role="status">Use the investigation before answering.</p></fieldset>}
      <p class="phase-target"><strong>Evidence to record:</strong> {phase.target}</p><label class="lab-note">My evidence<textarea rows="3" placeholder="I notice… because…" data-note></textarea></label><button class="phase-complete" type="button" data-complete>Mark phase complete</button><p data-phase-status role="status">Not completed yet.</p>
    </section>)}
  </div>
  <div class="lab-reflection"><strong>Convince a skeptic</strong>{lesson.explore.reflection.map(question => <span>{question}</span>)}</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-explore-lab]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const clampWhole = (input: HTMLInputElement | null, min: number, max: number) => { const raw = Number(input?.value); const safe = Number.isFinite(raw) ? Math.min(max, Math.max(min, Math.round(raw))) : min; if (input) input.value = String(safe); return safe; };
    const activate = (index: number, moveFocus = false) => { tabs.forEach((tab, tabIndex) => { const active = tabIndex === index; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; }); panels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== index); if (moveFocus) tabs[index]?.focus(); };
    tabs.forEach((tab, index) => { tab.addEventListener('click', () => activate(index)); tab.addEventListener('keydown', (event) => { if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return; event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : ['ArrowRight', 'ArrowDown'].includes(event.key) ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length; activate(next, true); }); });
    const cases = [{ text: '4n + 3 = 27', answer: 'equation', why: 'It claims that two expressions have the same value.' }, { text: '7x − 5', answer: 'expression', why: 'It names a value but makes no equality claim.' }, { text: '12 > 9', answer: 'neither', why: 'It is an inequality, not an expression alone or an equation.' }, { text: '18 = 3(6)', answer: 'equation', why: 'Different-looking expressions can still have equal value.' }];
    panels.forEach((panel) => {
      const input = panel.querySelector<HTMLInputElement>('[data-tool-input]'); const output = panel.querySelector<HTMLOutputElement>('[data-tool-output]'); const range = panel.querySelector<HTMLOutputElement>('[data-range-value]'); const pairTable = panel.querySelector<HTMLElement>('[data-pair-table]'); const recorded = new Map<number, number>(); let caseIndex = Number(panel.dataset.panel || 0) % cases.length;
      const setOutput = (message: string) => { if (output) output.textContent = message; };
      const renderCase = () => { const card = panel.querySelector<HTMLElement>('[data-case]'); if (card) card.textContent = cases[caseIndex].text; setOutput('Classify the statement, then explain what the symbols communicate.'); };
      const units = (count: number) => Array.from({ length: count }, () => '<i aria-hidden="true"></i>').join('');
      const renderBalance = (n: number) => { const left = panel.querySelector<HTMLElement>('[data-left-units]'); const right = panel.querySelector<HTMLElement>('[data-right-units]'); if (left) left.innerHTML = units(n); if (right) right.innerHTML = units(11); };
      const renderPattern = (n: number) => { const model = panel.querySelector<HTMLElement>('.tile-model'); if (model) model.innerHTML = `${Array.from({ length: n }, (_, group) => `<span class="tile-group" aria-label="growth group ${group + 1}"><i></i><i></i><i></i></span>`).join('')}<span class="fixed-tiles" aria-label="two fixed tiles"><i></i><i></i></span>`; };
      const plotted=new Map<number,number>();const renderGraph = (n: number, y: number) => { plotted.set(n,y);const group=panel.querySelector<SVGGElement>('[data-graph-points]');if(group)group.innerHTML=[...plotted].map(([x,value])=>{const cx=24+x*36,cy=240-(value/4)*36;return `<circle cx="${cx}" cy="${cy}" r="7"></circle><text x="${Math.min(218,cx+9)}" y="${Math.max(22,cy-8)}">(${x}, ${value})</text>`}).join('');const summary=panel.querySelector<SVGDescElement>('[data-graph-summary]');if(summary)summary.textContent=`Horizontal x-axis from 0 to 6 by 1. Vertical y-axis from 0 to 24 by 4. Plotted points: ${[...plotted].map(([x,value])=>`(${x}, ${value})`).join(', ')}.`; };
      input?.addEventListener('input', () => { if (range) range.textContent = input.value; });
      panel.querySelector('[data-tool-run]')?.addEventListener('click', () => {
        panel.dataset.toolUsed = 'true';
        switch (root.dataset.variant) {
          case 'more-patterns-in-division': { const n = clampWhole(input, 0, 99999); const digits = String(n).split('').map(Number); const sum = digits.reduce((total, digit) => total + digit, 0); const model = panel.querySelector<HTMLElement>('[data-model]'); if (panel.dataset.panel === '3') { if (model) model.innerHTML = '<span>0 × ? = dividend</span><span>0 ÷ nonzero = 0</span>'; setOutput(n === 0 ? '0 ÷ 0 is undefined because every value of q makes 0 × q = 0, so division cannot select one unique quotient.' : `${n} ÷ 0 is undefined because no value of q makes 0 × q = ${n}. By contrast, 0 ÷ ${n} = 0 because the divisor is nonzero.`); } else { if (model) model.innerHTML = `${digits.map(digit => `<span>${digit}</span>`).join('')}<b>digit sum = ${sum}</b>`; const phase=Number(panel.dataset.panel||0);setOutput(phase===0?`${n} and its digit sum ${sum} leave matching remainders: ${n%3} when divided by 3 and ${n%9} when divided by 9.`:phase===1?`${n}: divisible by 3 ${n%3===0?'yes':'no'}, by 9 ${n%9===0?'yes':'no'}, and by 6 ${n%6===0?'yes':'no'}. Change digits to meet another target.`:`Sort ${n}: 6 only ${n%6===0&&n%9!==0?'yes':'no'}; 9 only ${n%9===0&&n%6!==0?'yes':'no'}; both ${n%18===0?'yes':'no'}; neither ${n%6!==0&&n%9!==0?'yes':'no'}.`); } break; }
          case 'algebraic-expressions': { const n = clampWhole(input, 0, 12); const a = 18 * n; const b = 30 + 12 * n;recorded.set(n,b); const scale = Math.max(a, b, 1); const barA = panel.querySelector<HTMLElement>('[data-bar-a]'); const barB = panel.querySelector<HTMLElement>('[data-bar-b]'); if (barA) { barA.style.width = `${a / scale * 100}%`; barA.textContent = `18s = $${a}`; } if (barB) { barB.style.width = `${b / scale * 100}%`; barB.textContent = `30 + 12s = $${b}`; } setOutput(`At ${n} shifts, Plan A is $${a} and Plan B is $${b}. ${a === b ? 'The plans match.' : a > b ? 'Plan A is greater.' : 'Plan B is greater.'} ${recorded.size<4?`Compare ${4-recorded.size} more input${recorded.size===3?'':'s'}.`:'You have four comparison rows.'}`); break; }
          case 'relationships-in-patterns': { const n = clampWhole(input, 1, 20); renderPattern(n); setOutput(`Figure ${n} has ${3 * n + 2} tiles: ${n} groups of 3 plus 2 fixed tiles.`); break; }
          case 'patterns-tables': { const n = clampWhole(input, 0, 30); const y = 2 * n + 1; recorded.set(n, y); if (pairTable) pairTable.innerHTML = `<span role="columnheader">Input</span><span role="columnheader">Output</span>${[...recorded].map(([x, value]) => `<b role="cell">${x}</b><b role="cell">${value}</b>`).join('')}`;const machineRule=panel.querySelector<HTMLElement>('[data-machine-rule]');if(machineRule&&recorded.size>=3){machineRule.textContent='Possible rule: ×2, then +1';machineRule.parentElement?.setAttribute('aria-label','Input-output machine; possible rule multiply by 2, then add 1')} setOutput(`Input ${n} produces output ${y}. ${recorded.size < 3 ? `Collect ${3 - recorded.size} more distinct pair${recorded.size === 2 ? '' : 's'} before naming the rule.` : 'Test whether y = 2x + 1 matches every recorded pair.'}`); break; }
          case 'graphing-relations': { const n = clampWhole(input, 0, 6);const yInput=panel.querySelector<HTMLInputElement>('[data-graph-y]');const proposed=clampWhole(yInput,0,20);const y=3*n+2;if(proposed!==y){panel.dataset.toolUsed='false';setOutput(`(${n}, ${proposed}) is not on y=3x+2. Calculate 3(${n})+2, revise y, and try again.`);break}renderGraph(n,y);setOutput(`Plotted (${n}, ${y}). The x-axis counts by 1 and the y-axis counts by 4. ${plotted.size>=4?'You now have enough points to analyze the discrete relation.':'Plot another table row to strengthen the graph.'}`); break; }
          case 'equations-algebra-tiles': {const phase=Number(panel.dataset.panel||0);const n=clampWhole(input,phase===2?0:1,50);if(phase===0){renderBalance(n);setOutput(`Remove ${n} units from both sides. From x + ${n} = 11, x = ${11-n}. Check: ${11-n}+${n}=11.`)}else if(phase===1){if(n!==3){panel.dataset.toolUsed='false';setOutput('The equation has 3 equal x-groups. Enter 3 so both sides can be partitioned the same way.')}else setOutput('3x÷3 = 18÷3, so x=6. Each of the three equal groups contains 6 units.')}else if(phase===2){if(n!==5){panel.dataset.toolUsed='false';setOutput(`Removing ${n} would not undo +5. Use the inverse of +5 on both sides.`)}else setOutput('Subtract 5 from both sides: 2x=14. Then divide both sides by 2, so x=7.')}else{const kind=panel.querySelector<HTMLSelectElement>('[data-equation-type]')?.value||'add';const answers:Record<string,number>={add:7,multiply:6,'two-step':7,divide:20};if(n!==answers[kind]){panel.dataset.toolUsed='false';setOutput(`${n} does not make both sides equal. Substitute carefully and revise.`)}else setOutput(`Verified: x=${n} makes the selected equation true on both sides.`)}break; }
        }
      });
      panel.querySelectorAll<HTMLButtonElement>('[data-classify]').forEach(button => button.addEventListener('click', () => { const current = cases[caseIndex]; const correct = button.dataset.classify === current.answer; if(correct)panel.dataset.toolUsed='true'; setOutput(`${correct ? 'Correct.' : 'Not yet.'} ${current.why}`); }));
      panel.querySelectorAll<HTMLButtonElement>('[data-phase-option]').forEach(button=>button.addEventListener('click',()=>{const phase=Number(panel.dataset.panel||0);const correct=button.dataset.phaseOption==='0';panel.dataset.toolUsed=String(correct);const feedback=phase===1?'The equals sign and right-hand value complete the claim.':phase===2?'3n represents three times the number; then add 2 and use = for “is.”':'3(6)+2=20, so both sides have the same value.';setOutput(`${correct?'Correct.':'Not yet.'} ${feedback}`)}));
      panel.querySelector('[data-next-case]')?.addEventListener('click', () => { caseIndex = (caseIndex + 1) % cases.length; renderCase(); });
      panel.querySelector('[data-phase-check-button]')?.addEventListener('click',()=>{const check=panel.querySelector<HTMLElement>('[data-phase-check]');const selected=check?.querySelector<HTMLInputElement>('input:checked');const status=check?.querySelector<HTMLElement>('[data-phase-check-status]');if(!selected){if(status)status.textContent='Choose an answer first.';check?.querySelector<HTMLInputElement>('input')?.focus();return}const correct=Number(selected.value)===Number(check?.dataset.answer);panel.dataset.checkpointPassed=String(correct);if(status)status.innerHTML=`<strong>${correct?'Correct.':'Revise.'}</strong> ${check?.dataset.feedback||''}`;});
      panel.querySelector('[data-complete]')?.addEventListener('click', () => { const note = panel.querySelector<HTMLTextAreaElement>('[data-note]'); const status = panel.querySelector<HTMLElement>('[data-phase-status]'); if(panel.dataset.toolUsed!=='true'){if(status)status.textContent='Use the investigation tool before marking this phase complete.';panel.querySelector<HTMLElement>('.tool-surface button,.tool-surface input')?.focus();return}if(panel.dataset.checkpointPassed!=='true'){if(status)status.textContent='Pass the mathematical checkpoint before marking this phase complete.';panel.querySelector<HTMLInputElement>('[data-phase-check] input')?.focus();return}if ((note?.value.trim().length || 0) < 20 || !/(because|shows|so|therefore|since|evidence)/i.test(note?.value || '')) { if (status) status.textContent = 'Add a complete evidence sentence using because, shows, so, since, or therefore.'; note?.focus(); return; } panel.dataset.complete = 'true'; if (status) status.textContent = 'Phase complete. You used the tool, passed the checkpoint, and recorded evidence.'; });
      if (root.dataset.variant === 'reading-writing-equations'&&panel.dataset.panel==='0') renderCase(); if (root.dataset.variant === 'relationships-in-patterns') renderPattern(4); if (root.dataset.variant === 'equations-algebra-tiles'&&panel.dataset.panel==='0') renderBalance(4);
    });
  });
</script>

<style>
  .explore-lab{border-radius:16px;overflow:hidden;background:#102b32;color:#fff}.lab-launch{padding:1.2rem;background:linear-gradient(135deg,#143d46,#285867)}.lab-launch h3{margin:.15rem 0;font-size:1.55rem}.lab-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ffffff26}.lab-tabs button{display:grid;gap:.25rem;border:0;padding:.75rem;background:#183942;color:#dceff2;font-weight:750;text-align:left;cursor:pointer}.lab-tabs button span{display:grid;place-items:center;width:1.5rem;height:1.5rem;border-radius:99px;background:#ffffff1f}.lab-tabs button[aria-selected=true]{background:#fff;color:#17343c}.lab-panels{background:#fff;color:#18283b}.lab-panels section{padding:1.2rem}.phase-instruction{font-size:1.07rem}.tool-surface{display:grid;grid-template-columns:minmax(180px,1fr) auto;gap:.75rem;align-items:end;padding:1rem;border:1px solid #d5e3e7;border-radius:13px;background:#f1f8fa}.tool-surface label{display:grid;gap:.3rem;font-weight:800}.tool-surface input{font:inherit;padding:.55rem;border:1px solid #78909c;border-radius:8px;min-height:42px}.tool-surface button,.phase-complete{border:0;border-radius:9px;background:#176b77;color:#fff;padding:.65rem .8rem;font-weight:850;cursor:pointer}.tool-surface button.secondary{background:#e4edf0;color:#17343c}.tool-surface output{grid-column:1/-1;padding:.75rem;border-radius:9px;background:#fff;min-height:2.75rem}.digit-model,.tile-model,.machine-model,.bar-model,.balance-model,.graph-wrap,.pair-table{grid-column:1/-1;padding:.8rem;border:1px solid #d2e1e5;border-radius:11px;background:#fff}.digit-model{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}.digit-model span{display:grid;place-items:center;min-width:2.2rem;height:2.2rem;border-radius:8px;background:#dff3ee;font-weight:900}.tile-model{display:flex;gap:.55rem;align-items:center;overflow-x:auto}.tile-group,.fixed-tiles{display:flex;gap:.18rem;padding:.3rem;border-radius:7px;background:#e6f2ff;flex:0 0 auto}.fixed-tiles{background:#fff0c9