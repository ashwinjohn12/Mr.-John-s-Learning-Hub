<div class="arcade" data-unit7-arcade>
 <div class="arcade-head"><div><p class="eyebrow">MEASUREMENT DESIGN ARCADE</p><h3>8 free-response missions · 2 from each lesson</h3><p>No answer choices. Sketch, calculate, and enter the number only.</p></div><div class="stats"><span data-score>0 pts</span><span data-streak>0 streak</span></div></div>
 <div class="progress"><span data-progress></span></div><div data-stage aria-live="polite"></div><div class="actions"><button type="button" data-check>Check mission</button><button type="button" data-next hidden>Next mission →</button><button type="button" class="soft" data-restart>New quest</button></div>
</div>
<script>
const banks:any[]=[
 {label:'7.1 · Parallelograms',missions:[
  {prompt:'A parallelogram has base 13 cm and perpendicular height 6 cm. Find the area in cm².',answer:78,explain:'13 × 6 = 78 cm².'},
  {prompt:'A parallelogram has area 96 m² and height 8 m. Find the base in metres.',answer:12,explain:'96 ÷ 8 = 12 m.'},
  {prompt:'A glass parallelogram has base 20.2 in and height 9 in. Find its area in in².',answer:181.8,explain:'20.2 × 9 = 181.8 in².'},
  {prompt:'Area is 90 ft² and base is 8 ft. Find perpendicular height in feet.',answer:11.25,explain:'90 ÷ 8 = 11.25 ft.'}
 ]},
 {label:'7.2 · Triangles',missions:[
  {prompt:'A triangle has base 14 cm and height 9 cm. Find its area in cm².',answer:63,explain:'14 × 9 ÷ 2 = 63 cm².'},
  {prompt:'A triangular sail has base 7 ft and height 16.2 ft. Find area in ft².',answer:56.7,explain:'7 × 16.2 ÷ 2 = 56.7 ft².'},
  {prompt:'A parallelogram has area 72 m² and is split by a diagonal. Find one triangle area.',answer:36,explain:'Each congruent triangle is half: 72 ÷ 2 = 36 m².'},
  {prompt:'A triangle has area 32 in² and height 4 in. Find its base in inches.',answer:16,explain:'32 = b × 4 ÷ 2, so b = 16 in.'}
 ]},
 {label:'7.3 · Composite Shapes',missions:[
  {prompt:'A 10×4 rectangle is topped by a triangle with base 10 and height 3. Find total area.',answer:55,explain:'40 + 15 = 55 square units.'},
  {prompt:'A 12×8 rectangle has a 4×3 corner removed. Find remaining area.',answer:84,explain:'96 − 12 = 84.'},
  {prompt:'A parallelogram b=8,h=5 and triangle b=6,h=4 form one shape. Find total area.',answer:52,explain:'40 + 12 = 52.'},
  {prompt:'A 15×10 rectangle has a 5×4 cutout and a triangle b=6,h=4 added. Find total area.',answer:142,explain:'150 − 20 + 12 = 142.'}
 ]},
 {label:'7.4 · Volume',missions:[
  {prompt:'A prism measures 4 cm × 3 cm × 6 cm. Find its volume in cm³.',answer:72,explain:'4 × 3 × 6 = 72 cm³.'},
  {prompt:'A prism has base area 15 cm² and height 4 cm. Find volume in cm³.',answer:60,explain:'15 × 4 = 60 cm³.'},
  {prompt:'Volume is 84 m³ and base area is 28 m². Find height in metres.',answer:3,explain:'84 ÷ 28 = 3 m.'},
  {prompt:'A candle has a 9 cm by 9 cm square base and height 15 cm. Find volume in cm³.',answer:1215,explain:'9 × 9 × 15 = 1215 cm³.'}
 ]}
];
document.querySelectorAll<HTMLElement>('[data-unit7-arcade]').forEach(widget=>{const stage=widget.querySelector<HTMLElement>('[data-stage]'),scoreEl=widget.querySelector('[data-score]'),streakEl=widget.querySelector('[data-streak]'),progress=widget.querySelector<HTMLElement>('[data-progress]'),check=widget.querySelector<HTMLButtonElement>('[data-check]'),next=widget.querySelector<HTMLButtonElement>('[data-next]'),restart=widget.querySelector<HTMLButtonElement>('[data-restart]');let pool:any[]=[],index=0,score=0,streak=0,locked=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(banks.flatMap(group=>shuffle(group.missions).slice(0,2).map((m:any)=>({...m,label:group.label}))));const norm=(v:string)=>Number(v.trim().replace(/,/g,''));const render=()=>{if(index>=pool.length){if(stage)stage.innerHTML=`<div class="finish"><div class="trophy">🏆</div><p class="eyebrow">QUEST COMPLETE</p><h3>${score>=700?'Measurement Master':'Measurement Explorer'}</h3><p>You earned ${score} points across all four lessons. Start a new quest for different missions.</p></div>`;if(check)check.hidden=true;if(next)next.hidden=true;if(progress)progress.style.width='100%';return;}const q=pool[index];locked=false;if(check){check.hidden=false;check.disabled=false;}if(next)next.hidden=true;if(stage)stage.innerHTML=`<div class="meta"><span>Mission ${index+1} of ${pool.length}</span><span>${q.label}</span></div><h3>${q.prompt}</h3><label class="answer-box">Your answer <input type="text" inputmode="decimal" data-answer autocomplete="off" /></label><div class="feedback" data-feedback hidden></div>`;if(progress)progress.style.width=`${(index/pool.length)*100}%`;};const submit=()=>{if(locked)return;const input=stage?.querySelector<HTMLInputElement>('[data-answer]');if(!input||input.value.trim()==='')return;locked=true;const q=pool[index],value=norm(input.value),ok=Math.abs(value-q.answer)<0.001;if(ok){streak++;score+=100+Math.max(0,streak-1)*10;}else streak=0;const f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>${ok?'Mission solved!':'Not yet.'}</strong> ${q.explain}`;}input.disabled=true;if(scoreEl)scoreEl.textContent=`${score} pts`;if(streakEl)streakEl.textContent=`${streak} streak`;if(check)check.disabled=true;if(next){next.hidden=false;next.textContent=index===pool.length-1?'Finish quest':'Next mission →';}if(progress)progress.style.width=`${((index+1)/pool.length)*100}%`;};const reset=()=>{pool=build();index=0;score=0;streak=0;if(scoreEl)scoreEl.textContent='0 pts';if(streakEl)streakEl.textContent='0 streak';if(check)check.hidden=false;render();};check?.addEventListener('click',submit);next?.addEventListener('click',()=>{index++;render();});restart?.addEventListener('click',reset);reset();});
</script>
<style>.arcade{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.arcade-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.arcade-head h3{margin:.2rem 0}.arcade-head p{margin:.2rem 0;color:#64748b}.stats{display:flex;gap:.45rem;flex-wrap:wrap}.stats span{padding:.4rem .55rem;border-radius:9px;background:var(--course-soft);font-weight:900;white-space:nowrap}.progress{height:9px;border-radius:99px;background:#e9eef5;overflow:hidden;margin:.8rem 0}.progress span{display:block;height:100%;width:0;background:var(--course);transition:width .25s}.meta{display:flex;justify-content:space-between;gap:.8rem;margin:.8rem 0 .2rem;color:#64748b;font-size:.78rem;font-weight:900;text-transform:uppercase}.answer-box{display:grid;gap:.35rem;margin:1rem 0;font-weight:850}.answer-box input{max-width:260px;border:2px solid #ccd6e2;border-radius:11px;padding:.72rem;font:inherit}.feedback{padding:.75rem;border-radius:11px;background:#f7f9fc}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.actions .soft{background:#eef3f9;color:#25364f}.actions button:disabled{opacity:.45}.finish{text-align:center;padding:1.2rem}.trophy{font-size:2.4rem}@media(max-width:650px){.arcade-head,.meta{display:grid}.stats{justify-content:start}}</style>
