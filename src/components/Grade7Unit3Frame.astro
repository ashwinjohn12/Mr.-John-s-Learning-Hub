---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumbs from './Breadcrumbs.astro';import type{Course,Unit,Topic}from'../data/courses';
const{course,unit,topic}=Astro.props;const base=import.meta.env.BASE_URL;const links=[['overview','🎯','Overview'],['big-ideas','🌎','Big Ideas'],['understand','📘','Understand'],['examples','🧩','Examples'],['vocabulary','🧠','Vocabulary'],['explore','🔬','Explore'],['practise','✏️','Practise'],['check','✅','Check Yourself'],['apply','🎮','Apply'],['review','🏁','Review']];
---
<BaseLayout title={`${topic.title} | ${course.grade} ${course.shortSubject}`} description={topic.summary} themeColor={course.color}><div class="topic-shell" style={`--course:${course.color};--course-soft:${course.accent}`}><aside class="topic-sidebar"><a class="back-course" href={`${base}courses/${course.slug}/${unit.slug}/`}>← {unit.title}</a><p class="eyebrow">ON THIS PAGE</p><p class="scroll-cue">Swipe sections →</p><nav aria-label="Lesson sections">{links.map(([id,icon,label])=><a href={`#${id}`}><span aria-hidden="true">{icon}</span>{label}</a>)}</nav></aside><article class="topic-content"><Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:unit.title,href:`${base}courses/grade-7-math/${unit.slug}/`},{label:topic.title}]}/><header class="topic-hero"><p class="eyebrow">LESSON {topic.number} · GRADE 7 MATH</p><h1>{topic.title}</h1><p>{topic.summary}</p><div class="lesson-hook"><strong>Represent → calculate → check → interpret</strong><span>Use a model before trusting a rule.</span></div></header><slot/></article></div></BaseLayout>
<style>.lesson-hook{display:flex;justify-content:space-between;gap:1rem;margin-top:1.2rem;padding:1rem;border-radius:16px;background:var(--course-soft)}.scroll-cue{display:none}@media(max-width:760px){.lesson-hook{display:grid}.scroll-cue{display:block;color:#64748b;font-size:.78rem}.topic-sidebar nav{scrollbar-width:thin}.topic-hero{padding-top:2rem;padding-bottom:3rem}}@media(max-width:390px){.lesson-hook{overflow-wrap:anywhere}}</style>
