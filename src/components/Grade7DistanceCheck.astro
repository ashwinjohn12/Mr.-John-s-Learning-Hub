---
type Level=1|2|3; type P={x:number;y:number}; type Visual={start:P;finish:P;startLabel?:string;finishLabel?:string}; type Q={id:string;level:Level;prompt:string;correct:string;distractors:string[];feedback:string;visual?:Visual};
const qs:Q[]=[];const fmt=(p:P)=>`(${p.x}, ${p.y})`.replaceAll('-','−');const unique=(correct:string,pool:string[])=>[...new Set(pool)].filter(x=>x!==correct).slice(0,3);const move=(a:number,b:number,pos:string,neg:string)=>b===a?'0 units':`${Math.abs(b-a)} ${Math.abs(b-a)===1?'unit':'units'} ${b>a?pos:neg}`;
[
 ['Horizontal movement compares…','x-coordinates',['y-coordinates only','the quadrant numbers','the distance from the origin']],
 ['Vertical movement compares…','y-coordinates',['x-coordinates only','the axis labels','the angle of rotation']],
 ['A horizontal distance is…','a non-negative number of horizontal units',['a direction only','always an x-coordinate','a signed negative number when moving left']],
 ['“6 units left” describes…','movement because it includes direction',['distance only because 6 is positive','a coordinate pair','a rotation']],
 ['“Horizontal distance = 6 units” tells you…','how far horizontally, not left or right by itself',['the point moved left','the point moved right','the y-coordinate changed by 6']],
 ['After a second transformation, A″ is…','the image corresponding to A after two transformations',['the same as the original A','a horizontal distance','the centre of rotation']],
 ['To compare A with its corresponding final image, compare…','A with A′ or A″ that came from A',['A with any nearby vertex','only the quadrants','only the shape centre']],
 ['If two points share the same y-coordinate, their separation is…','horizontal',['vertical','diagonal only','impossible to determine']]
].forEach((x,i)=>qs.push({id:`f-${i}`,level:1,prompt:x[0],correct:x[1],distractors:x[2] as string[],feedback:`${x[1][0].toUpperCase()+x[1].slice(1)}.`}));
const movementCases=[
 {a:{x:-5,y:4},b:{x:2,y:-1}},{a:{x:6,y:-3},b:{x:-2,y:5}},{a:{x:-4,y:-6},b:{x:3,y:-2}},{a:{x:5,y:7},b:{x:1,y:-4}},{a:{x:-7,y:1},b:{x:-1,y:6}},{a:{x:2,y:-5},b:{x:8,y:-1}},{a:{x:4,y:3},b:{x:-3,y:3}},{a:{x:-2,y:-4},b:{x:-2,y:5}}
];
movementCases.forEach((c,i)=>{const h=move(c.a.x,c.b.x,'right','left'),v=move(c.a.y,c.b.y,'up','down'),correct=`${h}; ${v}`;qs.push({id:`c-move-${i}`,level:2,prompt:`Point A starts at ${fmt(c.a)} and its corresponding image finishes at ${fmt(c.b)}. What is the net horizontal and vertical movement?`,correct,distractors:unique(correct,[`${move(c.a.x,c.b.x,'left','right')}; ${v}`,`${h}; ${move(c.a.y,c.b.y,'down','up')}`,`${Math.abs(c.b.x)} units horizontally; ${Math.abs(c.b.y)} units vertically`,`horizontal distance ${Math.abs(c.b.x-c.a.x)}; vertical distance ${Math.abs(c.b.y-c.a.y)}`]),feedback:`Compare x with x and y with y: ${correct}.`,visual:{start:c.a,finish:c.b}})});
const distanceCases=[
 {a:{x:-6,y:3},b:{x:4,y:3},axis:'horizontal'},{a:{x:7,y:-2},b:{x:-1,y:-2},axis:'horizontal'},{a:{x:-3,y:-7},b:{x:-3,y:5},axis:'vertical'},{a:{x:5,y:6},b:{x:5,y:-4},axis:'vertical'},{a:{x:-8,y:1},b:{x:-2,y:1},axis:'horizontal'},{a:{x:2,y:-5},b:{x:2,y:3},axis:'vertical'}
];
distanceCases.forEach((c,i)=>{const d=c.axis==='horizontal'?Math.abs(c.b.x-c.a.x):Math.abs(c.b.y-c.a.y),correct=`${d} units`;qs.push({id:`c-dist-${i}`,level:2,prompt:`What is the ${c.axis} distance between ${fmt(c.a)} and ${fmt(c.b)}?`,correct,distractors:unique(correct,[`${-d} units`,`${d+1} units`,`${Math.max(0,d-1)} units`,`${Math.abs(c.b.x-c.a.x)+Math.abs(c.b.y-c.a.y)} units`]),feedback:`Distance is a non-negative magnitude. The ${c.axis} distance is ${d} units.`,visual:{start:c.a,finish:c.b,startLabel:'P',finishLabel:'Q'}})});
[
 {start:{x:-4,y:2},mid:{x:3,y:2},finish:{x:1,y:-5},label:'A → A′ → A″'},
 {start:{x:5,y:-4},mid:{x:-5,y:-4},finish:{x:-2,y:3},label:'B → B′ → B″'},
 {start:{x:-6,y:-1},mid:{x:-1,y:4},finish:{x:4,y:4},label:'C → C′ → C″'},
 {start:{x:2,y:6},mid:{x:2,y:-2},finish:{x:-5,y:-2},label:'D → D′ → D″'}
].forEach((c,i)=>{const h=move(c.start.x,c.finish.x,'right','left'),v=move(c.start.y,c.finish.y,'up','down'),correct=`${h}; ${v}`;qs.push({id:`c-success-${i}`,level:2,prompt:`${c.label} has coordinates ${fmt(c.start)} → ${fmt(c.mid)} → ${fmt(c.finish)}. Describe the positional change from the original point to the final image.`,correct,distractors:unique(correct,[`${move(c.start.x,c.mid.x,'right','left')}; ${move(c.start.y,c.mid.y,'up','down')}`,`${move(c.mid.x,c.finish.x,'right','left')}; ${move(c.mid.y,c.finish.y,'up','down')}`,`${Math.abs(c.finish.x-c.start.x)} units horizontally; ${Math.abs(c.finish.y-c.start.y)} units vertically`,`0 units; 0 units`]),feedback:`For the final positional change, compare the original coordinate directly with the final image: ${correct}.`,visual:{start:c.start,finish:c.finish,startLabel:c.label[0],finishLabel:`${c.label[0]}″`}})});
[
 ['Route 1 goes from (−4, −3) to (3, 4) directly. Route 2 goes (−4, −3) → (6, −1) → (3, 4). What must be the same for both routes?','the net horizontal and vertical movement from start to finish',['the total horizontal distance travelled','the number of transformations','the total route distance in each direction']],
 ['A student says the horizontal distance from x = 5 to x = −3 is −8 units. What is the best repair?','Distance is 8 units; “8 units left” describes the movement.',['Distance is −8 because the finish is negative.','Distance is 3 because −3 is the final coordinate.','Distance cannot cross the y-axis.']],
 ['Two routes end at the same final coordinate. Why can their total horizontal distances differ?','One route may backtrack horizontally even though the net positional change is the same.',['Horizontal distance depends only on the final x-coordinate.','Any two routes to the same point must have equal distance.','Distance becomes negative when moving left.']],
 ['A(−2, 5) becomes A″(4, −1). Which statement is most precise?','A moved 6 units right and 6 units down; the horizontal and vertical distances are each 6 units.',['A moved 4 right and 1 down.','The horizontal distance is −6 units.','A moved diagonally 12 units using the distance formula.']],
 ['A student compares vertex B to image A″ because the points are close. What should they do?','Compare each original vertex with its corresponding image vertex.',['Compare whichever points are nearest.','Compare only the centres of the shapes.','Use only the quadrant numbers.']],
 ['A route has steps 8 right, 3 left, then 2 right. What is true?','Horizontal distance travelled is 13 units, but net movement is 7 units right.',['Distance travelled is 7 units because directions cancel.','Net movement is 13 units right.','Horizontal distance is −13 units.']],
 ['Why does A → A′ → A″ notation help with successive transformations?','It preserves which image corresponds to the original point at each stage.',['It gives a distance formula.','It shows every move is a translation.','It removes the need for coordinates.']],
 ['Which method best describes positional change without introducing diagonal distance?','Compare the start and finish x-coordinates for horizontal change and y-coordinates for vertical change.',['Use the Pythagorean theorem.','Calculate slope between the points.','Use a vector magnitude formula.']]
].forEach((x,i)=>qs.push({id:`r-${i}`,level:3,prompt:x[0],correct:x[1],distractors:x[2] as string[],feedback:x[1]}));
---
<div class="distance-check" data-distance-check>
 <div class="check-head"><div><p class="mini-label">8-QUESTION INDEPENDENT CHECK</p><h3>Movement, distance, correspondence, and route reasoning</h3><p>Each attempt contains <strong>2 foundational, 4 core, and 2 reasoning</strong> questions with balanced A–D answer positions.</p></div><div class="bank-badge"><strong>{qs.length}</strong><span>question bank</span></div></div>
 <div class="check-items" data-items></div><div class="actions"><button type="button" data-submit>Submit all 8</button><button type="button" class="secondary" data-new>New question set</button></div><p class="result" data-result role="status" tabindex="-1">A new set is ready.</p>
 <script type="application/json" data-bank set:html={JSON.stringify(qs)}></script>
</div>
<script>
type VP={x:number;y:number};const shuffle=<T,>(a:T[])=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
const visual=(v:{start:VP;finish:VP;startLabel?:string;finishLabel?:string})=>{const px=(n:number)=>130+n*9,py=(n:number)=>130-n*9;let grid='';for(let i=0;i<=20;i++){const p=40+i*9;grid+=`<line x1="${p}" y1="40" x2="${p}" y2="220" stroke="#e1e8f0"/><line x1="40" y1="${p}" x2="220" y2="${p}" stroke="#e1e8f0"/>`}return`<svg class="mini-distance" viewBox="0 0 260 260" role="img" aria-label="Coordinate grid showing a blue start point and gold finish point."><rect x="40" y="40" width="180" height="180" rx="8" fill="#f8fbff" stroke="#b9c8da"/><g>${grid}</g><path d="M40 130H220M130 40V220" stroke="#1d3557" stroke-width="2" fill="none"/><line x1="${px(v.start.x)}" y1="${py(v.start.y)}" x2="${px(v.finish.x)}" y2="${py(v.start.y)}" stroke="#6d28d9" stroke-width="3" stroke-dasharray="7 5"/><line x1="${px(v.finish.x)}" y1="${py(v.start.y)}" x2="${px(v.finish.x)}" y2="${py(v.finish.y)}" stroke="#6d28d9" stroke-width="3" stroke-dasharray="7 5"/><circle cx="${px(v.start.x)}" cy="${py(v.start.y)}" r="7" fill="#dbeafe" stroke="#2457c5" stroke-width="3"/><circle cx="${px(v.finish.x)}" cy="${py(v.finish.y)}" r="7" fill="#ffedb0" stroke="#b76e00" stroke-width="3"/><text x="${px(v.start.x)+10}" y="${py(v.start.y)-10}" fill="#174ea6" font-weight="900">${v.startLabel||'A'}</text><text x="${px(v.finish.x)+10}" y="${py(v.finish.y)-10}" fill="#714500" font-weight="900">${v.finishLabel||'A′'}</text></svg>`};
document.querySelectorAll<HTMLElement>('[data-distance-check]').forEach(root=>{const bank=JSON.parse(root.querySelector<HTMLScriptElement>('[data-bank]')!.textContent||'[]'),box=root.querySelector<HTMLElement>('[data-items]')!,result=root.querySelector<HTMLElement>('[data-result]')!;let attempt:any[]=[];const build=()=>{const chosen=[...shuffle(bank.filter((q:any)=>q.level===1)).slice(0,2),...shuffle(bank.filter((q:any)=>q.level===2)).slice(0,4),...shuffle(bank.filter((q:any)=>q.level===3)).slice(0,2)],positions=shuffle([0,0,1,1,2,2,3,3]);attempt=shuffle(chosen).map((q:any,i:number)=>{const pos=positions[i],wrong=[...new Set<string>(q.distractors.filter((x:string)=>x!==q.correct))];if(wrong.length<3)throw new Error(`${q.id} needs three unique distractors`);const choices=shuffle(wrong).slice(0,3);choices.splice(pos,0,q.correct);return{...q,choices,answer:pos}});box.innerHTML=attempt.map((q:any,i:number)=>`<fieldset data-item data-answer="${q.answer}"><legend><span>${i+1}</span><em>${q.prompt}</em></legend>${q.visual?visual(q.visual):''}<div class="choices">${q.choices.map((c:string,j:number)=>`<label><input type="radio" name="distance-q-${i}" value="${j}"><b>${'ABCD'[j]}</b><span>${c}</span></label>`).join('')}</div><p data-feedback hidden></p></fieldset>`).join('');result.textContent='A new set is ready.';result.focus()};root.querySelector('[data-new]')?.addEventListener('click',build);root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...box.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){result.textContent='Answer all 8 questions before submitting.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach((item,i)=>{const chosen=Number(item.querySelector<HTMLInputElement>('input:checked')!.value),answer=Number(item.dataset.answer),ok=chosen===answer;if(ok)score++;item.querySelectorAll<HTMLInputElement>('input').forEach(x=>x.disabled=true);const p=item.querySelector<HTMLElement>('[data-feedback]')!;p.hidden=false;p.textContent=ok?`Correct. ${attempt[i].feedback}`:`Repair: ${attempt[i].feedback} Correct answer: ${attempt[i].choices[answer]}.`});result.textContent=`${score}/8. ${score>=7?'Ready for the Unit 1 review.':score>=5?'Nearly there. Repair missed ideas, then try a fresh set.':'Return to Understand and the Grid Navigator before retrying.'}`;result.focus()});build()});
</script>
<style>
.distance-check{display:grid;gap:1rem}.check-head{display:grid;grid-template-columns:1fr auto;gap:1rem}.check-head h3{margin:.1rem 0}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.bank-badge{display:grid;place-items:center;min-width:88px;padding:.6rem;border-radius:14px;background:#eef6ff;color:#174ea6}.bank-badge strong{font-size:1.8rem}.bank-badge span{font-size:.75rem;font-weight:800}.check-items{display:grid;gap:.8rem;min-width:0}.check-items fieldset{min-width:0;margin:0;padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}.check-items legend{display:grid;grid-template-columns:28px minmax(0,1fr);gap:.55rem;width:100%;font-weight:850;line-height:1.45}.check-items legend>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#2457c5;color:#fff}.check-items legend em{font-style:normal;overflow-wrap:anywhere}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-top:.75rem}.choices label{display:grid;grid-template-columns:auto auto minmax(0,1fr);gap:.5rem;align-items:center;min-height:48px;padding:.55rem;border:1px solid #d9e2ec;border-radius:10px;cursor:pointer}.choices label:focus-within{outline:3px solid #ffbf47;outline-offset:2px}.choices b{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#eef3fb;color:#2457c5}.choices span,[data-feedback]{overflow-wrap:anywhere}.mini-distance{display:block;width:min(270px,100%);margin:.75rem auto;background:#f8fbff;border-radius:12px}.actions{display:flex;gap:.65rem;flex-wrap:wrap}.actions button{min-height:44px;border:0;border-radius:9px;padding:.65rem .85rem;background:#2457c5;color:#fff;font-weight:850;cursor:pointer}.actions .secondary{background:#fff;color:#2457c5;border:1px solid #2457c5}.actions button:focus-visible,.choices input:focus-visible{outline:3px solid #ffbf47;outline-offset:2px}.result,[data-feedback]{padding:.65rem;border-radius:10px;background:#eef6ff}.result{font-weight:800;margin:0}@media(max-width:620px){.choices{grid-template-columns:1fr}.check-head{grid-template-columns:1fr}.bank-badge{justify-self:start}}@media(max-width:390px){.check-items fieldset{padding:.75rem}.choices label{overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){.distance-check *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>