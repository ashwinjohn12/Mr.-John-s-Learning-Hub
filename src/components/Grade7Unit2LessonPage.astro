---
import Grade7Unit2Frame from './Grade7Unit2Frame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import Grade7Unit2Practice from './Grade7Unit2Practice.astro';
import Grade7Unit2Check from './Grade7Unit2Check.astro';
import Grade7Unit2Explore from './Grade7Unit2Explore.astro';
import Grade7Unit2Apply from './Grade7Unit2Apply.astro';
import type { Course,Unit,Topic } from '../data/courses';
import type { Unit2Lesson, Unit2Question } from '../data/grade7Unit2';
interface Props{course:Course;unit:Unit;topic:Topic;lesson:Unit2Lesson}
const {course,unit,topic,lesson}=Astro.props;
const previousBySlug:Record<string,{title:string;href:string}>={
  'representing-integers':{title:'Unit 2 · Integers',href:'../'},
  'adding-integers-tiles':{title:'Lesson 2.1 · Representing Integers',href:'../representing-integers/'},
  'adding-integers-number-line':{title:'Lesson 2.2 · Adding Integers with Tiles',href:'../adding-integers-tiles/'},
  'subtracting-integers-tiles':{title:'Lesson 2.3 · Adding Integers on a Number Line',href:'../adding-integers-number-line/'},
  'subtracting-integers-number-line':{title:'Lesson 2.4 · Subtracting Integers with Tiles',href:'../subtracting-integers-tiles/'}
};
const previous=previousBySlug[lesson.slug];
const rotate=(item:Unit2Question,shift:number):Unit2Question=>{const n=shift%item.choices.length;return n?{...item,choices:[...item.choices.slice(-n),...item.choices.slice(0,-n)],answer:(item.answer+n)%item.choices.length}:item};
const offset=Number(lesson.number.split('.')[1]);
const applyChecks=lesson.applySupport.checks.map((item,index)=>rotate(item,index+offset));
const exitQuestions=lesson.exit.map((item,index)=>rotate(item,index+offset+1));
const repairLabel=(route:string)=>{if(route.startsWith('understand-')){const index=Number(route.split('-').pop())-1;return `Lesson ${lesson.number} — Understand: ${lesson.understand[index]?.title||'Build the idea'}`;}if(route==='examples')return `Lesson ${lesson.number} — Examples: Worked examples`;if(route==='explore')return `Lesson ${lesson.number} — Explore: ${lesson.explore.title}`;if(route==='practise')return `Lesson ${lesson.number} — Practise: Supported practice`;return `Lesson ${lesson.number} — Review: Readiness and repair`;};
---
<Grade7Unit2Frame {course} {unit} {topic}>
  <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
    <div class="two-grid"><article class="lesson-card"><p class="mini-label">BEFORE YOU START</p><ul>{lesson.prerequisites.map(x=><li>{x}</li>)}</ul></article><article class="lesson-card"><p class="mini-label">BY THE END, I CAN…</p><ul>{lesson.goals.map(x=><li>{x}</li>)}</ul></article></div>
    <div class="lesson-meta"><span><strong>Time:</strong> {lesson.duration}</span><span><strong>Curriculum:</strong> {lesson.outcome}</span></div>
    <details class="pacing-guide"><summary>Suggested two-session core route</summary><p><strong>Session 1:</strong> readiness warm-up, Big Ideas, Understand cards 1–3, two worked examples, Explore core phases 1–3, and supported questions 1–4. <strong>Session 2:</strong> use the remaining Understand cards as needed, complete supported questions 5–8, Check Yourself, and the exit ticket. <strong>Consolidation or extension:</strong> additional examples, Explore phase 4 and later phases, vocabulary writing, and Apply.</p></details>
    <div class="warmup" data-warmup data-answer={lesson.warmup.answer} data-success={lesson.warmup.feedback} data-route={lesson.warmup.route} data-route-label={repairLabel(lesson.warmup.route||'understand')}><p class="mini-label">QUICK READINESS</p><h3>{lesson.warmup.prompt}</h3><p>This does not count toward your lesson score.</p><fieldset><legend class="sr-only">Warm-up choices</legend><div class="warm-choices">{lesson.warmup.choices.map((choice,index)=><label><input type="radio" name={`${lesson.slug}-warmup`} value={index}/><span>{choice}</span></label>)}</div></fieldset><button type="button" data-warmup-check>Check readiness</button><p data-warmup-feedback role="status">Choose an answer when you are ready.</p></div>
  </LearningSection>
  <LearningSection id="big-ideas" eyebrow="START HERE" title="The big ideas" icon="🌎" tone="idea"><p class="big-statement">{lesson.promise}</p><div class="idea-grid">{lesson.bigIdeas.map(x=><article><strong>{x.title}</strong><p>{x.body}</p></article>)}</div><div class="reasoning-frame"><strong>Explain with evidence</strong><span><b>Represent</b> the signed quantities</span><span><b>Calculate</b> with a model</span><span><b>Conclude</b> in context</span></div></LearningSection>
  <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn"><p>Open one idea at a time. Compare the model with the common mix-up.</p><div class="understand-grid">{lesson.understand.map((x,i)=><details id={`understand-${i+1}`} open={i===0}><summary><span>{i+1}</span>{x.title}</summary><div><p>{x.body}</p><p class="model-copy"><strong>Model:</strong> {x.model}</p><p class="mistake"><strong>Common mix-up:</strong> {x.mistake}</p></div></details>)}</div></LearningSection>
  <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn"><div class="examples">{lesson.examples.map((x,i)=><details open={i===0}><summary><span>{x.label}</span>{x.question}</summary><ol>{x.steps.map(step=><li>{step}</li>)}</ol><p class="answer"><strong>Conclusion:</strong> {x.answer}</p></details>)}</div></LearningSection>
  <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={lesson.vocabulary}/><p class="use-it"><strong>Use it:</strong> Write one sentence that connects a signed value, its model, and its meaning.</p></LearningSection>
  <LearningSection id="explore" eyebrow="INVESTIGATE" title={lesson.explore.title} icon="🔬" tone="explore"><Grade7Unit2Explore {lesson}/></LearningSection>
  <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>Complete all eight in order. Check each answer immediately, open the hint ladder when needed, and revise before moving on.</p><Grade7Unit2Practice questions={lesson.practice} lesson={lesson.slug}/></LearningSection>
  <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>Five questions are sampled from a separate 30-question bank. Results remain hidden until the whole set is submitted.</p><Grade7Unit2Check bank={lesson.check} lesson={lesson.slug}/></LearningSection>
  <LearningSection id="apply" eyebrow="PLAY & APPLY" title={lesson.apply.title} icon="🎮" tone="play"><Grade7Unit2Apply {lesson} checks={applyChecks}/></LearningSection>
  <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="review-summary"><article><p class="mini-label">RETRIEVE</p><ul>{lesson.bigIdeas.map(x=><li>{x.title}</li>)}</ul></article><article><p class="mini-label">BE READY TO EXPLAIN</p><ul>{lesson.readiness.map(x=><li>{x}</li>)}</ul></article></div><div class="exit-ticket" data-exit-ticket><p class="eyebrow">3-QUESTION EXIT TICKET</p><p>Answer all three without hints, then submit together.</p>{exitQuestions.map((item,index)=><fieldset data-exit-item data-answer={item.answer} data-feedback={item.feedback} data-route={item.route} data-route-label={repairLabel(item.route||'understand')}><legend>{index+1}. {item.prompt}</legend><div>{item.choices.map((choice,i)=><label><input type="radio" name={`${lesson.slug}-exit-${index}`} value={i}/><span>{choice}</span></label>)}</div><p data-exit-reveal hidden></p></fieldset>)}<button type="button" data-exit-submit>Submit exit ticket</button><p data-exit-result role="status" tabindex="-1">No answers submitted.</p><div class="exit-routes" data-exit-routes hidden></div></div><div class="lesson-nav"><a class="next-step previous-step" href={previous.href}><div><p class="eyebrow">PREVIOUS</p><strong>{previous.title}</strong></div><b>← Go back</b></a>{lesson.next&&<a class="next-step" href={lesson.next.href}><div><p class="eyebrow">NEXT</p><strong>{lesson.next.title}</strong><span>{lesson.next.body}</span></div><b>Continue →</b></a>}</div></LearningSection>
</Grade7Unit2Frame>
<script>
document.querySelectorAll<HTMLElement>('[data-warmup]').forEach(root=>root.querySelector('[data-warmup-check]')?.addEventListener('click',()=>{const chosen=root.querySelector<HTMLInputElement>('input:checked'),feedback=root.querySelector<HTMLElement>('[data-warmup-feedback]');if(!chosen){if(feedback)feedback.textContent='Choose one answer first.';root.querySelector<HTMLInputElement>('input')?.focus();return;}const ok=Number(chosen.value)===Number(root.dataset.answer);if(feedback)feedback.innerHTML=`<strong>${ok?'Ready.':'Review first.'}</strong> ${ok?root.dataset.success:`Open ${root.dataset.routeLabel||'the named lesson section'} and repair the model before continuing.`}`;}));
document.querySelectorAll<HTMLElement>('[data-exit-ticket]').forEach(root=>root.querySelector('[data-exit-submit]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-exit-item]')],first=items.find(x=>!x.querySelector('input:checked')),result=root.querySelector<HTMLElement>('[data-exit-result]');if(first){if(result)result.textContent='Answer all three before submitting.';first.querySelector<HTMLInputElement>('input')?.focus();return;}let score=0;const routes:{route:string;label:string}[]=[];items.forEach(item=>{const selected=Number(item.querySelector<HTMLInputElement>('input:checked')?.value),ok=selected===Number(item.dataset.answer);if(ok)score++;else routes.push({route:item.dataset.route||'understand',label:item.dataset.routeLabel||'the named lesson section'});item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);item.querySelectorAll<HTMLInputElement>('input').forEach(input=>input.disabled=true);const reveal=item.querySelector<HTMLElement>('[data-exit-reveal]'),correct=item.querySelectorAll<HTMLLabelElement>('label')[Number(item.dataset.answer)]?.textContent?.trim();if(reveal){reveal.hidden=false;reveal.innerHTML=`<strong>${ok?'Correct.':'Repair this idea.'}</strong> ${item.dataset.feedback||''}${ok?'':` Correct answer: ${correct}.`}`;}});if(result)result.innerHTML=`<strong>${score}/3.</strong> ${score===3?'Ready for the next lesson.':score===2?'Review the named card, then continue.':'Redo the linked Explore or Understand work before continuing.'}`;const links=root.querySelector<HTMLElement>('[data-exit-routes]');if(links&&routes.length){const unique=[...new Map(routes.map(item=>[item.route,item])).values()];links.hidden=false;links.innerHTML=unique.map(item=>`<a href="#${item.route}">${item.label}</a>`).join('');}else if(links){links.hidden=true;links.innerHTML='';}result?.focus({preventScroll:true});}));
</script>
<script>
document.querySelectorAll<HTMLElement>('[data-warmup]').forEach(root=>root.querySelectorAll('input').forEach(input=>input.addEventListener('change',()=>{const feedback=root.querySelector<HTMLElement>('[data-warmup-feedback]');if(feedback)feedback.textContent='Answer changed. Check readiness again.';})));
</script>
<style>
.two-grid,.idea-grid,.review-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.lesson-card,.idea-grid article,.review-summary article{padding:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#fff}.lesson-meta,.reasoning-frame{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem;margin-top:1rem}.lesson-meta span,.reasoning-frame{padding:.8rem;border-radius:11px;background:#eef5ff}.reasoning-frame{grid-template-columns:auto repeat(3,1fr);background:#fff7d6}.reasoning-frame span{display:grid}.pacing-guide,.warmup{margin-top:1rem;padding:1rem;border:1px solid #e1d39b;border-radius:13px;background:#fff9dc}.pacing-guide summary{font-weight:850}.warmup fieldset{border:0;padding:0}.warm-choices{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem}.warm-choices label,.exit-ticket label{display:flex;gap:.5rem;padding:.6rem;border:1px solid #dce3eb;border-radius:9px;background:#fff}.warmup button,.exit-ticket button{border:0;border-radius:9px;background:#2457c5;color:#fff;padding:.7rem .9rem;font-weight:850;min-height:44px}.understand-grid,.examples{display:grid;gap:.75rem}.understand-grid details,.examples details{border:1px solid #dbe4ef;border-radius:13px;background:#fff;overflow:hidden}.understand-grid summary,.examples summary{display:flex;gap:.65rem;padding:.9rem 1rem;font-weight:850;cursor:pointer}.understand-grid summary span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:50%;background:#2457c5;color:#fff}.understand-grid details>div,.examples details>ol,.examples details>.answer{margin:.2rem 1rem 1rem}.model-copy,.answer{padding:.7rem;border-radius:9px;background:#eef6ff}.mistake{padding:.7rem;border-radius:9px;background:#fff5ed}.examples summary{display:grid}.examples summary span{font-size:.75rem;letter-spacing:.08em;color:#2457c5}.use-it{padding:.8rem;border-radius:10px;background:#f8f5ff}.application{border-radius:16px;overflow:hidden;background:#21133d;color:#fff}.apply-head{padding:1.2rem;background:linear-gradient(135deg,#21133d,#493173)}.apply-head h3{margin:.15rem 0;font-size:1.55rem}.apply-instruction,.application details{margin:1rem}.apply-resources{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;margin:1rem}.apply-resources article{padding:.8rem;border-radius:10px;background:#fff;color:#21133d}.task-list{display:grid;gap:.7rem;padding:0 1rem;list-style:none}.task-list label{display:grid;gap:.5rem;padding:.8rem;border-radius:10px;background:#ffffff12}.task-list span{display:grid}.task-list textarea,.explanation textarea{font:inherit;padding:.7rem;border:1px solid #c9c2d6;border-radius:9px}.apply-checkpoints{display:grid;gap:.9rem;margin:1rem;padding:1rem;border:1px solid #ffffff38;border-radius:11px}.apply-checkpoints>div{display:grid;gap:.4rem}.apply-checkpoints label{padding:.5rem;border-radius:8px;background:#ffffff12}.apply-checkpoints p{margin:0;padding:.55rem;background:#ffffff12}.explanation{display:grid;gap:.4rem;margin:1rem;font-weight:800}.application>button{margin:0 1rem;border:0;border-radius:9px;padding:.7rem .9rem;background:#f4c95d;color:#21133d;font-weight:900;min-height:44px}.application [data-apply-status]{margin:1rem;padding:.7rem;border-radius:9px;background:#ffffff12}.exit-ticket{margin-top:1rem;padding:1rem;border:1px solid #c8e7d0;border-radius:14px;background:#f7fcf8}.exit-ticket fieldset{border:0;border-top:1px solid #dce9df;padding:.8rem 0}.exit-ticket legend{font-weight:850}.exit-ticket fieldset>div{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;margin-top:.5rem}.exit-ticket fieldset.correct{border-left:5px solid #2b6e3f}.exit-ticket fieldset.incorrect{border-left:5px solid #b85c1e}.exit-ticket [data-exit-reveal],.exit-ticket [data-exit-result]{padding:.65rem;background:#fff;border-radius:8px}.exit-routes{display:flex;gap:.5rem;flex-wrap:wrap}.exit-routes a{padding:.55rem .7rem;border-radius:8px;background:#fff;color:#205d34;font-weight:800}.lesson-nav{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:.7rem}.next-step{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:14px;background:linear-gradient(135deg,#eef5ff,#f8f5ff);text-decoration:none;color:inherit}.next-step>div{display:grid}.next-step span{color:#526174}.next-step>b{color:#2457c5;white-space:nowrap}.previous-step{background:#f5f7fa}.previous-step>b{order:-1}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.application button:focus-visible,.application input:focus-visible,.application textarea:focus-visible,.exit-ticket button:focus-visible,.exit-ticket input:focus-visible,.next-step:focus-visible,.warmup button:focus-visible,.warmup input:focus-visible{outline:3px solid #2563eb;outline-offset:2px}@media(max-width:700px){.two-grid,.idea-grid,.review-summary,.reasoning-frame,.lesson-meta,.warm-choices,.apply-resources,.exit-ticket fieldset>div,.lesson-nav{grid-template-columns:1fr}.next-step{align-items:flex-start;flex-direction:column}.application>button{width:calc(100% - 2rem)}}
.apply-review-note{margin:1rem;padding:.7rem;border-left:4px solid #f4c95d;background:#ffffff12}.apply-checkpoints label,.warm-choices label,.exit-ticket label{min-height:44px;align-items:center;box-sizing:border-box}@media(max-width:390px){.application,.exit-ticket,.lesson-card{overflow-wrap:anywhere}.task-list textarea,.explanation textarea{width:100%;box-sizing:border-box}}
</style>
<style>
.apply-math{margin:1rem;padding:1rem;border:1px solid #ffffff45;border-radius:11px}.apply-math legend{font-weight:900}.apply-math>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.apply-math label{display:grid;gap:.35rem;font-weight:800}.apply-math input{font:inherit;min-height:44px;padding:.65rem;border:1px solid #78909c;border-radius:9px}.apply-math [data-apply-math-status]{padding:.65rem;background:#ffffff12;border-radius:8px}@media(max-width:700px){.apply-math>div{grid-template-columns:1fr}}@media(max-width:390px){.apply-math{margin:.75rem;padding:.75rem}.apply-math input{width:100%;box-sizing:border-box}}
</style>
