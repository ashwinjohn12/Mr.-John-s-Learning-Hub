---
interface Props { variant:'experiment'|'relative'|'analyze' }
const { variant }=Astro.props;
---
<div class="stats-lab" data-unit9-lab={variant}>
 {variant==='experiment'&&<>
  <div class="lab-head"><div><p class="eyebrow">EXPERIMENT LAB</p><h3>See the setup. Predict. Then run the trials.</h3></div><label>Experiment <select data-exp-select><option value="coin">Fair coin</option><option value="die">Fair number cube</option><option value="spinner">4-section fair spinner</option><option value="uneven">Unequal spinner</option></select></label></div>
  <div class="experiment-visual" data-exp-object aria-label="Visual model of the selected experiment"></div>
  <div class="setup-grid"><article><p class="mini-label">POSSIBLE OUTCOMES</p><strong data-exp-outcomes>Heads · Tails</strong></article><article><p class="mini-label">SETUP</p><strong data-exp-fair>Equally likely</strong><small data-exp-why>Two equal coin faces.</small></article><article><p class="mini-label">TRIALS COLLECTED</p><strong data-exp-total>0</strong></article></div>
  <div class="prediction-card"><div><p class="mini-label">PREDICT BEFORE YOU SIMULATE</p><strong data-exp-predict-label>About how many Heads do you predict in 20 trials?</strong></div><label>Your prediction <input type="number" min="0" max="20" data-exp-prediction /></label><button type="button" data-exp-save>Save prediction</button><span data-exp-prediction-note>Save a prediction to unlock the trial buttons.</span></div>
  <div class="lab-actions"><button type="button" data-run="1" disabled>Run 1 trial</button><button type="button" data-run="10" disabled>Run 10</button><button type="button" data-run="20" disabled>Run 20</button><button type="button" data-run="50" disabled>Run 50</button><button type="button" class="soft" data-exp-reset>Reset data</button></div>
  <div class="experiment-results"><div><p class="mini-label">RECENT OUTCOMES</p><div class="outcome-stream" data-exp-stream>Save a prediction, then run the experiment.</div></div><div><p class="mini-label">FREQUENCY TABLE</p><div data-exp-table></div></div></div>
  <p class="feedback" data-exp-feedback>Fair describes the chance built into the setup, not a promise that the counts will be equal.</p>
 </>}

 {variant==='relative'&&<>
  <div class="lab-head"><div><p class="eyebrow">RELATIVE FREQUENCY DASHBOARD</p><h3>Turn a count into a part of the whole.</h3></div><label>Data set <select data-rf-dataset><option value="pets">Pet preferences</option><option value="cards">Card draws</option><option value="fruit">Fruit survey</option><option value="custom">Use my own data</option></select></label></div>
  <div class="custom-data" data-rf-custom hidden><div><p class="mini-label">BRING IN YOUR OWN 9.1 DATA</p><strong>Enter one category count and the total sample size.</strong></div><label>Category count <input type="number" min="0" value="12" data-rf-custom-count /></label><label>Total <input type="number" min="1" value="30" data-rf-custom-total /></label><button type="button" data-rf-custom-use>Use this data</button><span data-rf-custom-note></span></div>
  <div class="rf-layout"><div><p class="mini-label">FREQUENCY TABLE</p><div data-rf-table></div></div><div class="rf-focus"><p class="mini-label">SELECTED CATEGORY</p><label>Category <select data-rf-category></select></label><div class="conversion-chain"><span data-rf-count>20 out of 50</span><b>=</b><span data-rf-fraction>2/5</span><b>=</b><span data-rf-decimal>0.40</span><b>=</b><span data-rf-percent>40%</span></div><div class="hundred-grid" data-rf-grid aria-label="100-grid model"></div></div></div>
  <div class="prediction-strip"><label>Similar future sample <input type="number" min="1" value="100" data-rf-target/></label><label>Your prediction <input type="number" min="0" data-rf-guess placeholder="?" /></label><button type="button" data-rf-predict>Check prediction</button><strong data-rf-prediction>Enter a prediction first.</strong></div>
  <p class="feedback" data-rf-check>Check the whole: the category percentages in a complete data set add to 100%.</p>
 </>}

 {variant==='analyze'&&<>
  <div class="lab-head"><div><p class="eyebrow">SAMPLE SIZE LAB</p><h3>Same fair experiment. Four different amounts of evidence.</h3></div><label>Track <select data-size-exp><option value="coin">Heads on a fair coin</option><option value="spinner">Red on a fair 4-colour spinner</option><option value="die">Six on a fair number cube</option></select></label></div>
  <div class="expected-card"><span>Expected likelihood</span><strong data-size-expected>50%</strong><small>Run each sample again. The exact percentages change because the trials are random.</small></div>
  <div class="sample-grid" data-size-grid></div>
  <div class="lab-actions"><button type="button" data-size-run>Run all sample sizes</button><button type="button" data-size-many>Run 20 experiments at each size</button><button type="button" class="soft" data-size-run-one="10">Rerun 10</button><button type="button" class="soft" data-size-run-one="1000">Rerun 1000</button></div>
  <div class="stability-track"><div data-stability-bars></div></div>
  <div class="many-results" data-many-results hidden><p class="mini-label">20 EXPERIMENTS AT EACH SAMPLE SIZE</p><h4>Average distance from the expected likelihood</h4><div data-many-table></div><p data-many-summary></p></div>
  <p class="feedback" data-size-feedback>Larger samples generally give more stable estimates, but one rerun can still move farther from the expected value. Look for a long-run pattern, not a guarantee.</p>
 </>}
</div>

<script>
document.querySelectorAll<HTMLElement>('[data-unit9-lab]').forEach(lab=>{
 const variant=lab.dataset.unit9Lab;const q=(s:string)=>lab.querySelector<any>(s);
 if(variant==='experiment'){
  const configs:any={coin:{out:['Heads','Tails'],weights:[.5,.5],fair:true,why:'Two equal coin faces.',track:'Heads'},die:{out:['1','2','3','4','5','6'],weights:[1/6,1/6,1/6,1/6,1/6,1/6],fair:true,why:'Six equal faces.',track:'1'},spinner:{out:['Red','Blue','Green','Yellow'],weights:[.25,.25,.25,.25],fair:true,why:'Four equal sections.',track:'Red'},uneven:{out:['Red','Blue','Green'],weights:[.5,.25,.25],fair:false,why:'Red takes half the spinner; blue and green take one quarter each.',track:'Red'}};
  let key='coin',data=configs.coin,counts:any={},total=0,recent:string[]=[],history:string[]=[],prediction:number|null=null;
  const visual=()=>key==='coin'?`<div class="coin-pair"><span>H</span><span>T</span></div><small>Two equal faces → equal chance</small>`:key==='die'?`<div class="die-faces">${[1,2,3,4,5,6].map(n=>`<span>${n}</span>`).join('')}</div><small>Six equal faces → each number has the same chance</small>`:key==='spinner'?`<div class="spinner-object fair"></div><div class="spinner-legend"><span>Red 25%</span><span>Blue 25%</span><span>Green 25%</span><span>Yellow 25%</span></div>`:`<div class="spinner-object uneven"></div><div class="spinner-legend"><span>Red 50%</span><span>Blue 25%</span><span>Green 25%</span></div>`;
  const choose=()=>{const r=Math.random();let sum=0;for(let i=0;i<data.out.length;i++){sum+=data.weights[i];if(r<sum)return data.out[i];}return data.out[data.out.length-1];};
  const setRunState=()=>lab.querySelectorAll<HTMLButtonElement>('[data-run]').forEach(b=>b.disabled=prediction===null);
  const resetCounts=(clearPrediction=false)=>{counts=Object.fromEntries(data.out.map((o:string)=>[o,0]));total=0;recent=[];history=[];if(clearPrediction){prediction=null;q('[data-exp-prediction]').value='';q('[data-exp-prediction-note]').textContent='Save a prediction to unlock the trial buttons.';}setRunState();render();};
  const render=()=>{q('[data-exp-object]').innerHTML=visual();q('[data-exp-outcomes]').textContent=data.out.join(' · ');q('[data-exp-fair]').textContent=data.fair?'Equally likely':'Not equally likely';q('[data-exp-why]').textContent=data.why;q('[data-exp-total]').textContent=total;q('[data-exp-predict-label]').textContent=`About how many ${data.track} do you predict in 20 trials?`;q('[data-exp-stream]').innerHTML=recent.length?recent.slice(-20).map(o=>`<span>${o}</span>`).join(''):(prediction===null?'Save a prediction, then run the experiment.':'Run the experiment to collect data.');const max=Math.max(1,...Object.values(counts).map(Number));q('[data-exp-table]').innerHTML=data.out.map((o:string)=>`<div class="freq-row"><strong>${o}</strong><div><i style="width:${(counts[o]/max)*100}%"></i></div><b>${counts[o]}</b></div>`).join('');if(history.length>=20&&prediction!==null){const observed=history.slice(0,20).filter(o=>o===data.track).length;q('[data-exp-feedback]').innerHTML=`<strong>Your prediction: ${prediction} ${data.track} in 20.</strong> The first 20 trials produced ${observed}. ${data.fair?'A difference does not make the setup unfair; random samples can vary.':'The unequal setup already gives some outcomes more chance than others.'}`;}else if(total>0&&prediction!==null){q('[data-exp-feedback]').innerHTML=`<strong>${total} trials collected.</strong> Keep going until you have at least 20, then compare the first 20 trials with your prediction.`;}else q('[data-exp-feedback]').textContent='Fair describes the chance built into the setup, not a promise that the counts will be equal.';};
  q('[data-exp-save]').addEventListener('click',()=>{const v=Number(q('[data-exp-prediction]').value);if(!Number.isFinite(v)||v<0||v>20){q('[data-exp-prediction-note]').textContent='Enter a whole-number prediction from 0 to 20.';return;}prediction=Math.round(v);q('[data-exp-prediction]').value=String(prediction);q('[data-exp-prediction-note]').textContent=`Prediction saved: ${prediction} ${data.track} in 20 trials.`;setRunState();render();});
  q('[data-exp-select]').addEventListener('change',(e:any)=>{key=e.target.value;data=configs[key];resetCounts(true);});lab.querySelectorAll<HTMLButtonElement>('[data-run]').forEach(b=>b.addEventListener('click',()=>{const n=Number(b.dataset.run);for(let i=0;i<n;i++){const o=choose();counts[o]++;total++;recent.push(o);history.push(o);}render();}));q('[data-exp-reset]').addEventListener('click',()=>resetCounts(false));resetCounts(true);
 }
 if(variant==='relative'){
  const datasets:any={pets:{rows:[['Dogs',20],['Cats',15],['Fish',5],['No pet',10]]},cards:{rows:[['Clubs',6],['Diamonds',8],['Hearts',10],['Spades',16]]},fruit:{rows:[['Apples',7],['Bananas',4],['Grapes',5],['Oranges',4]]},custom:{rows:[['My category',12],['Other',18]]}};let data=datasets.pets;
  const gcd=(a:number,b:number):number=>b?gcd(b,a%b):a;const total=()=>data.rows.reduce((s:number,r:any[])=>s+r[1],0);const category=()=>{const name=q('[data-rf-category]').value;return data.rows.find((r:any[])=>r[0]===name)||data.rows[0];};
  const clearPrediction=()=>{q('[data-rf-guess]').value='';q('[data-rf-prediction]').textContent='Enter a prediction first.';};
  const render=()=>{const t=total();const previous=q('[data-rf-category]').value;q('[data-rf-category]').innerHTML=data.rows.map((r:any[])=>`<option>${r[0]}</option>`).join('');if(data.rows.some((r:any[])=>r[0]===previous))q('[data-rf-category]').value=previous;q('[data-rf-table]').innerHTML=data.rows.map((r:any[])=>`<div class="data-row"><strong>${r[0]}</strong><span>${r[1]}</span><b>${Math.round(r[1]/t*1000)/10}%</b></div>`).join('');renderFocus();};
  const renderFocus=()=>{const [,count]=category(),t=total(),d=count/t,pct=d*100,g=gcd(count,t);q('[data-rf-count]').textContent=`${count} out of ${t}`;q('[data-rf-fraction]').textContent=`${count/g}/${t/g}`;q('[data-rf-decimal]').textContent=d.toFixed(2);q('[data-rf-percent]').textContent=`${Math.round(pct*10)/10}%`;q('[data-rf-grid]').innerHTML=Array.from({length:100},(_,i)=>`<i class="${i<Math.round(pct)?'filled':''}"></i>`).join('');clearPrediction();};
  const checkPrediction=()=>{const [name,count]=category(),t=total(),d=count/t,target=Math.max(1,Number(q('[data-rf-target]').value)||100),guess=Number(q('[data-rf-guess]').value),expected=Math.round(d*target);if(!Number.isFinite(guess)){q('[data-rf-prediction]').textContent='Enter your prediction first.';return;}const ok=Math.round(guess)===expected;q('[data-rf-prediction]').innerHTML=`${ok?'✓ ':''}About ${expected} ${name}`;q('[data-rf-check]').innerHTML=`You predicted ${Math.round(guess)}. ${count}/${t} is about ${(d*100).toFixed(1)}%, so ${(d*100).toFixed(1)}% of ${target} is about ${expected}. A prediction is an estimate, not a guarantee.`;};
  q('[data-rf-dataset]').addEventListener('change',(e:any)=>{const key=e.target.value;data=datasets[key];q('[data-rf-custom]').hidden=key!=='custom';render();});q('[data-rf-category]').addEventListener('change',renderFocus);q('[data-rf-predict]').addEventListener('click',checkPrediction);q('[data-rf-target]').addEventListener('input',clearPrediction);q('[data-rf-custom-use]').addEventListener('click',()=>{const count=Math.max(0,Math.round(Number(q('[data-rf-custom-count]').value)||0)),t=Math.max(1,Math.round(Number(q('[data-rf-custom-total]').value)||1));if(count>t){q('[data-rf-custom-note]').textContent='Category count cannot be greater than the total.';return;}datasets.custom={rows:[['My category',count],['Other',t-count]]};data=datasets.custom;q('[data-rf-custom-note]').textContent=`Using ${count} out of ${t}.`;render();});render();
 }
 if(variant==='analyze'){
  const configs:any={coin:{p:.5,label:'Heads'},spinner:{p:.25,label:'Red'},die:{p:1/6,label:'Six'}};let data=configs.coin;const sizes=[10,50,200,1000];let results:any={};
  const simulate=(n:number)=>{let count=0;for(let i=0;i<n;i++)if(Math.random()<data.p)count++;return {n,count,pct:count/n*100,gap:Math.abs(count/n-data.p)*100};};
  const render=()=>{q('[data-size-expected]').textContent=`${(data.p*100).toFixed(data.p===1/6?1:0)}%`;q('[data-size-grid]').innerHTML=sizes.map(n=>{const r=results[n];return `<article><p class="mini-label">${n} TRIALS</p><strong>${r.count} ${data.label}</strong><span>${r.pct.toFixed(1)}%</span><small>${r.gap.toFixed(1)} percentage points from expected</small></article>`}).join('');q('[data-stability-bars]').innerHTML=sizes.map(n=>{const r=results[n];return `<div><span>${n}</span><div><i style="width:${Math.min(100,r.pct)}%"></i><b style="left:${Math.min(98,data.p*100)}%"></b></div><em>${r.pct.toFixed(1)}%</em></div>`}).join('');};
  const runAll=()=>{sizes.forEach(n=>results[n]=simulate(n));render();};
  const runMany=()=>{const avgs=sizes.map(n=>{let gap=0;for(let i=0;i<20;i++)gap+=simulate(n).gap;return {n,gap:gap/20};});const box=q('[data-many-results]');box.hidden=false;q('[data-many-table]').innerHTML=avgs.map(r=>`<div class="many-row"><strong>${r.n} trials</strong><div><i style="width:${Math.min(100,r.gap*5)}%"></i></div><span>${r.gap.toFixed(1)} pp</span></div>`).join('');const first=avgs[0].gap,last=avgs[avgs.length-1].gap;q('[data-many-summary]').innerHTML=`Across 20 experiments per size, the 1000-trial samples averaged ${last.toFixed(1)} percentage points from expected, compared with ${first.toFixed(1)} for 10 trials. The gaps do not have to shrink perfectly every run, but the long-run pattern usually becomes more stable.`;};
  q('[data-size-exp]').addEventListener('change',(e:any)=>{data=configs[e.target.value];q('[data-many-results]').hidden=true;runAll();});q('[data-size-run]').addEventListener('click',runAll);q('[data-size-many]').addEventListener('click',runMany);lab.querySelectorAll<HTMLButtonElement>('[data-size-run-one]').forEach(b=>b.addEventListener('click',()=>{const n=Number(b.dataset.sizeRunOne);results[n]=simulate(n);render();}));runAll();
 }
});
</script>
<style>
.stats-lab{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1rem}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.lab-head h3{margin:.15rem 0}.lab-head label{padding:.5rem .65rem;border-radius:10px;background:var(--course-soft);font-weight:850}.lab-head select,.rf-focus select,.prediction-strip input,.prediction-card input,.custom-data input{margin-left:.35rem;border:1px solid #cbd5e1;border-radius:8px;padding:.4rem;font:inherit}.experiment-visual{min-height:150px;margin:1rem 0;padding:1rem;border:1px solid #dbe3ec;border-radius:16px;background:#f8fafc;display:grid;place-items:center;text-align:center}.coin-pair{display:flex;gap:1rem;justify-content:center}.coin-pair span{display:grid;place-items:center;width:76px;height:76px;border-radius:50%;border:6px double #64748b;background:#fff;font-size:1.7rem;font-weight:900}.die-faces{display:grid;grid-template-columns:repeat(6,48px);gap:.45rem}.die-faces span{display:grid;place-items:center;aspect-ratio:1;border:2px solid #64748b;border-radius:10px;background:#fff;font-weight:900}.spinner-object{width:145px;height:145px;border-radius:50%;border:6px solid #fff;box-shadow:0 0 0 2px #64748b;position:relative}.spinner-object:after{content:'▲';position:absolute;top:-25px;left:50%;transform:translateX(-50%) rotate(180deg);font-size:1.3rem}.spinner-object.fair{background:conic-gradient(#ef4444 0 25%,#3b82f6 25% 50%,#22c55e 50% 75%,#facc15 75%)}.spinner-object.uneven{background:conic-gradient(#ef4444 0 50%,#3b82f6 50% 75%,#22c55e 75%)}.spinner-legend{display:flex;gap:.45rem;flex-wrap:wrap;justify-content:center;margin-top:.75rem}.spinner-legend span{padding:.3rem .45rem;border-radius:8px;background:#fff;border:1px solid #dbe3ec;font-size:.82rem;font-weight:800}.setup-grid{display:grid;grid-template-columns:2fr 1.4fr 1fr;gap:.7rem;margin:1rem 0}.setup-grid article,.rf-layout>div,.expected-card,.sample-grid article,.many-results{border:1px solid #dbe3ec;border-radius:14px;padding:.85rem;background:#f9fbfd}.setup-grid article{display:grid;gap:.25rem}.setup-grid small{color:#64748b}.mini-label{font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#64748b;margin:.1rem 0}.prediction-card,.custom-data{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap;margin:.8rem 0;padding:.8rem;border-radius:13px;background:#fff8db;border:1px solid #f1df9c}.prediction-card>div,.custom-data>div{flex:1 1 260px}.prediction-card button,.custom-data button,.lab-actions button,.prediction-strip button{border:0;border-radius:10px;padding:.68rem .9rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.prediction-card button:disabled,.lab-actions button:disabled{opacity:.45;cursor:not-allowed}.prediction-card span,.custom-data span{font-size:.88rem;color:#526174}.lab-actions,.prediction-strip{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:.8rem 0}.lab-actions .soft{background:#eef3f9;color:#25364f}.experiment-results,.rf-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:.8rem;margin-top:1rem}.experiment-results>div{border:1px solid #dbe3ec;border-radius:14px;padding:.85rem}.outcome-stream{display:flex;flex-wrap:wrap;gap:.35rem}.outcome-stream span{padding:.35rem .5rem;border-radius:8px;background:var(--course-soft);font-weight:850}.freq-row{display:grid;grid-template-columns:100px 1fr 35px;align-items:center;gap:.5rem;margin:.45rem 0}.freq-row>div,.stability-track>div>div>div,.many-row>div{height:12px;background:#e8edf3;border-radius:99px;overflow:hidden}.freq-row i,.many-row i{display:block;height:100%;background:var(--course);border-radius:99px}.feedback{padding:.75rem .85rem;border-radius:11px;background:#eef5ff}.data-row{display:grid;grid-template-columns:1fr auto auto;gap:.7rem;padding:.5rem 0;border-bottom:1px solid #e3e8ef}.data-row b{color:var(--course)}.rf-focus{display:grid;gap:.8rem}.conversion-chain{display:flex;align-items:center;justify-content:center;gap:.35rem;flex-wrap:wrap}.conversion-chain span{padding:.55rem .65rem;border-radius:10px;background:var(--course-soft);font-weight:900}.hundred-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:2px;max-width:260px}.hundred-grid i{aspect-ratio:1;border-radius:2px;background:#e6ebf2}.hundred-grid i.filled{background:var(--course)}.prediction-strip{padding:.8rem;border-radius:12px;background:#f8fafc}.prediction-strip strong{margin-left:auto}.expected-card{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;margin:1rem 0}.expected-card strong{font-size:1.7rem;color:var(--course)}.expected-card small{margin-left:auto;max-width:520px;color:#64748b}.sample-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem}.sample-grid article{display:grid;gap:.35rem}.sample-grid article strong{font-size:1.2rem}.sample-grid article span{font-size:1.6rem;font-weight:900;color:var(--course)}.sample-grid small{color:#64748b}.stability-track{margin-top:1rem;padding:.8rem;border:1px solid #dbe3ec;border-radius:14px}.stability-track>div>div{display:grid;grid-template-columns:50px 1fr 58px;gap:.5rem;align-items:center;margin:.5rem 0}.stability-track>div>div>div{position:relative}.stability-track i{display:block;height:100%;background:var(--course)}.stability-track b{position:absolute;top:-3px;height:18px;width:2px;background:#111827}.stability-track em{font-style:normal;font-weight:850;text-align:right}.many-results{margin-top:1rem}.many-results h4{margin:.2rem 0 .8rem}.many-row{display:grid;grid-template-columns:90px 1fr 70px;gap:.6rem;align-items:center;margin:.55rem 0}.many-row span{text-align:right;font-weight:850}.many-results>p:last-child{margin-bottom:0;color:#526174}@media(max-width:760px){.lab-head,.setup-grid,.experiment-results,.rf-layout,.sample-grid{display:grid;grid-template-columns:1fr}.prediction-strip strong,.expected-card small{margin-left:0}.freq-row{grid-template-columns:78px 1fr 32px}.die-faces{grid-template-columns:repeat(3,48px)}}
</style>
