---

<div class="independent-check" data-independent-check>
  <div class="check-top"><div><p class="eyebrow">FRESH 5-QUESTION SET</p><h3 data-check-heading tabindex="-1">Answer everything before feedback appears</h3></div><span data-check-status aria-live="polite">0 of 5 answered</span></div>
  <div data-check-form></div>
  <div class="check-actions"><button type="button" data-check-submit disabled>Submit all 5</button><button type="button" data-check-new>Replace set</button></div>
  <div class="check-results" data-check-results aria-live="polite" tabindex="-1"></div>
  <script is:inline type="application/json" data-check-bank set:html={JSON.stringify(bank)}></script>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-independent-check]').forEach(widget=>{
    const bank=JSON.parse(widget.querySelector('[data-check-bank]')?.textContent||'[]');
    const form=widget.querySelector<HTMLElement>('[data-check-form]');
    const status=widget.querySelector('[data-check-status]');
    const heading=widget.querySelector<HTMLElement>('[data-check-heading]');
    const submit=widget.querySelector<HTMLButtonElement>('[data-check-submit]');
    const newButton=widget.querySelector<HTMLButtonElement>('[data-check-new]');
    const results=widget.querySelector<HTMLElement>('[data-check-results]');
    let set:any[]=[]; let answers:(number|null)[]=[]; let lastIds:string[]=[];
    const pick=(type:string,used:Set<number>)=>{const candidates=bank.map((q:any,i:number)=>({q,i})).filter((x:any)=>x.q.type===type&&!used.has(x.i)&&!lastIds.includes(x.q.p));const source=candidates.length?candidates:bank.map((q:any,i:number)=>({q,i})).filter((x:any)=>x.q.type===type&&!used.has(x.i));const item=source[Math.floor(Math.random()*source.length)];used.add(item.i);return item.q};
    const newSet=(moveFocus=false)=>{const used=new Set<number>();set=[pick('foundation',used),pick('standard',used),pick('standard',used),pick('reasoning',used),Math.random()>.5?pick('construct',used):pick('applied',used)];lastIds=set.map(q=>q.p);answers=Array(5).fill(null);render();if(moveFocus)heading?.focus();};
    const render=()=>{if(!form)return;form.innerHTML=set.map((q,i)=>`<fieldset class="check-question"><legend><span>${i+1}</span>${q.p}</legend><div>${q.c.map((c:string,j:number)=>`<label><input type="radio" name="check-${i}" value="${j}" /> ${c}</label>`).join('')}</div><p data-explanation="${i}" role="status"></p></fieldset>`).join('');if(results)results.innerHTML='';if(submit)submit.disabled=true;if(newButton)newButton.textContent='Replace set';if(status)status.textContent='0 of 5 answered';form.querySelectorAll<HTMLInputElement>('input').forEach(input=>input.addEventListener('change',()=>{const i=Number(input.name.split('-')[1]);answers[i]=Number(input.value);const done=answers.filter(a=>a!==null).length;if(status)status.textContent=`${done} of 5 answered`;if(submit)submit.disabled=done<5}))};
    submit?.addEventListener('click',()=>{let score=0;set.forEach((q,i)=>{const correct=answers[i]===q.a;if(correct)score++;const field=form?.querySelectorAll<HTMLElement>('.check-question')[i];field?.classList.add(correct?'correct':'incorrect');field?.querySelectorAll<HTMLInputElement>('input').forEach(input=>input.disabled=true);const explanation=field?.querySelector<HTMLElement>(`[data-explanation="${i}"]`);if(explanation)explanation.innerHTML=`<strong>${correct?'Correct.':'Review this one.'}</strong> ${q.e}`});const message=score===5?'Ready: your decisions and explanations are strong.':score===4?'Nearly ready: review the one explanation you missed, then try a fresh set.':score>=2?'Review the ending rules, then use supported practice before another set.':'Restart with the ones-digit rules for 2, 5, and 10.';if(results)results.innerHTML=`<p class="eyebrow">SET COMPLETE</p><h3>${score} / 5</h3><p>${message}</p>`;if(status)status.textContent=`${score} of 5 correct`;if(newButton)newButton.textContent='Try a new set';submit.disabled=true;results?.focus()});
    newButton?.addEventListener('click',()=>newSet(true));newSet();
  });
</script>

<style>
  .independent-check{border:1px solid #cde3d3;border-radius:18px;background:#fbfffc;padding:1.15rem}.check-top{display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid #dfebe2;padding-bottom:.8rem}.check-top h3{margin:.15rem 0}.check-top h3:focus,.check-results:focus{outline:none}.check-top>span{font-weight:900;color:#2b6e3f}.check-question{border:0;border-bottom:1px solid #e2e9e4;padding:1.1rem 0}.check-question legend{display:flex;gap:.65rem;align-items:start;width:100%;font-weight:850;font-size:1.05rem}.check-question legend span{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:#edf9f0;color:#2b6e3f}.check-question>div{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin:.8rem 0}.check-question label{padding:.6rem .7rem;border:1px solid #dce5df;border-radius:9px;background:#fff;cursor:pointer}.check-question label:focus-within,.check-actions button:focus-visible{outline:3px solid #2457c5;outline-offset:2px}.check-question p{margin:.5rem 0 0;padding:.65rem;border-radius:9px}.check-question p:empty{display:none}.check-question.correct p{background:#edf9f0;color:#176235}.check-question.incorrect p{background:#fff7d6;color:#705000}.check-actions{display:flex;gap:.6rem;justify-content:flex-end;margin-top:1rem}.check-actions button{border:0;border-radius:9px;background:#2b6e3f;color:#fff;padding:.7rem .95rem;font-weight:800;cursor:pointer}.check-actions button:last-child{background:#fff;color:#25364f;border:1px solid #d8e2dc}.check-actions button:disabled{opacity:.45;cursor:not-allowed}.check-results{margin-top:1rem;padding:1rem;border-radius:13px;background:#edf9f0}.check-results:empty{display:none}.check-results h3{font-size:2rem;margin:.2rem 0}
  @media(max-width:650px){.check-top{align-items:start}.check-question>div{grid-template-columns:1fr}.check-actions{justify-content:stretch}.check-actions button{flex:1}}
</style>
