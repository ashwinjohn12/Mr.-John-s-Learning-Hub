  {type:'foundation',p:'Is 6,124 divisible by 4?',c:['Yes','No'],a:0,e:'The last two digits, 24, are divisible by 4.'},
  {type:'foundation',p:'Is 23,416 divisible by 8?',c:['Yes','No'],a:0,e:'The last three digits are 416 = 8 × 52.'},
  {type:'foundation',p:'Is 4,738 divisible by 4?',c:['Yes','No'],a:1,e:'The last two digits, 38, are not divisible by 4.'},
