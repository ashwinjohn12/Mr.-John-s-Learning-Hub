---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isMission3 = pathname.includes('/courses/grade-7-science/jabberwocky/phase-3/mission-3/');
const isTeacherGuide = pathname.includes('/courses/grade-7-science/jabberwocky/phase-3/teacher-launch-guide/');
const showPacket = isMission3 || isTeacherGuide;
const packetHref = `${base}resources/jcec/JCEC_Thermos_Challenge_Printable_Packet.pdf`;
---

{showPacket && (
  <aside class:list={["jcec-thermos-packet", { teacher: isTeacherGuide }]} aria-label="JCEC Thermos Challenge printable packet">
    <div class="packet-copy">
      <small>{isTeacherGuide ? 'PHASE 3 · MISSION 3 RESOURCE' : 'PRINTABLE CLASSROOM RESOURCE'}</small>
      <strong>{isTeacherGuide ? 'Student Investigation Packet — 7 pages' : 'JCEC Thermos Challenge Packet'}</strong>
      <span>{isTeacherGuide ? 'Design sheet · data tables · graph · redesign · final report · reflection/rubric · teacher safety card' : 'Use this 7-page packet for the design, Prototype Test, graph, redesign, Final Test, Team Record and reflection.'}</span>
    </div>
    <a class="packet-button" href={packetHref} target="_blank" rel="noopener">{isTeacherGuide ? 'Open / Print Student Packet' : 'Download / Print the JCEC Thermos Challenge Packet'}</a>
  </aside>
)}

<style>
  .jcec-thermos-packet {
    width: min(1160px, calc(100% - 2rem));
    margin: 1rem auto 0;
    padding: .9rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(52, 211, 153, .42);
    border-left: 5px solid #34d399;
    border-radius: 14px;
    background: linear-gradient(135deg, #0b2530, #0f3540);
    color: #f4fbfb;
    box-shadow: 0 10px 28px rgba(0,0,0,.14);
  }
  .jcec-thermos-packet.teacher {
    border-left-color: #fbbf24;
    border-color: rgba(251, 191, 36, .4);
  }
  .packet-copy { display: grid; gap: .15rem; }
  .packet-copy small {
    font-size: .72rem;
    letter-spacing: .09em;
    font-weight: 800;
    color: #9de7d0;
  }
  .teacher .packet-copy small { color: #fde68a; }
  .packet-copy strong { font-size: 1rem; }
  .packet-copy span { font-size: .82rem; line-height: 1.35; color: #d6e8ea; }
  .packet-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: .65rem .9rem;
    border-radius: 10px;
    background: #ecfdf5;
    color: #064e3b;
    font-weight: 850;
    font-size: .82rem;
    text-decoration: none;
    text-align: center;
  }
  .teacher .packet-button { background: #fffbeb; color: #78350f; }
  .packet-button:hover, .packet-button:focus-visible { outline: 3px solid rgba(255,255,255,.35); outline-offset: 2px; }
  @media (max-width: 760px) {
    .jcec-thermos-packet { align-items: stretch; flex-direction: column; }
    .packet-button { width: 100%; }
  }
  @media print {
    .jcec-thermos-packet { display: none !important; }
  }
</style>
