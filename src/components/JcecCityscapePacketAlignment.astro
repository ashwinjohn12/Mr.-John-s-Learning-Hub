---
const pathname = Astro.url.pathname;
const phase4Root = '/courses/grade-7-science/jabberwocky/phase-4/';
const missionMatch = pathname.match(/\/phase-4\/mission-([1-5])\//);
const missionNumber = missionMatch ? Number(missionMatch[1]) : null;
const isTeacherGuide = pathname.includes(`${phase4Root}teacher-launch-guide/`);
const show = missionNumber !== null || isTeacherGuide;
---

{show && (
  <script is:inline define:vars={{ missionNumber, isTeacherGuide }}>
    (() => {
      const packetRecords = {
        1: `
          <div class="record-heading"><div><p class="mini-label">TEAM RECORD · FIELD FILE PAGE 2</p><h3>New Horizon Requirements Card</h3></div><span>ONE PER TEAM</span></div>
          <p class="jcec-record-note">Use the inherited briefing. Do not reopen old mission archives.</p>
          <div class="jcec-packet-grid two">
            <label><strong>CONTINENT</strong><span>____________________________</span></label>
            <label><strong>OUR DISTRICT'S JOB</strong><span>Small long-term JCEC research district prototype</span></label>
          </div>
          <div class="jcec-packet-grid four inherited-grid">
            <label><strong>ENVIRONMENT</strong><span>____________________________</span></label>
            <label><strong>THERMAL REQUIREMENT</strong><span>____________________________</span></label>
            <label><strong>ECOLOGICAL RESTRICTION</strong><span>____________________________</span></label>
            <label><strong>SITE / LOAD WARNING</strong><span>____________________________</span></label>
          </div>
          <div class="jcec-requirements-table">
            <div class="head"><strong>PERFORMANCE REQUIREMENT</strong><strong>WHY DOES THE CONTINENT MAKE THIS IMPORTANT?</strong></div>
            <div><span>1. Our district must ____________________</span><span>________________________________</span></div>
            <div><span>2. Our district must ____________________</span><span>________________________________</span></div>
            <div><span>3. Our district must ____________________</span><span>________________________________</span></div>
          </div>
          <div class="jcec-packet-grid two">
            <label><strong>STRUCTURAL THINKING</strong><span>□ Frame &nbsp; □ Shell &nbsp; □ Frame + shell &nbsp; □ Not enough evidence yet</span></label>
            <label><strong>ONE LIKELY FAILURE POINT WE NEED TO INVESTIGATE</strong><span>________________________________</span></label>
            <label><strong>PRIMARY STRUCTURAL TEST BUILDING · TENTATIVE CHOICE</strong><span>□ Circular building &nbsp; □ Triangular building &nbsp; □ Parallelogram building</span></label>
            <label><strong>WHY MIGHT THIS BE AN IMPORTANT STRUCTURE TO TEST?</strong><span>________________________________</span></label>
          </div>`,
        2: `
          <div class="record-heading"><div><p class="mini-label">TEAM RECORD · FIELD FILE PAGE 7</p><h3>Structural Force Map</h3></div><span>PRIMARY BUILDING</span></div>
          <p class="jcec-record-note">Draw the structural system, not the decoration. Show the forces that matter for your Primary Structural Test Building.</p>
          <div class="jcec-force-map-box">
            <strong>PRIMARY STRUCTURAL TEST BUILDING · FORCE MAP</strong>
            <span>Show: at least one important external load · force-direction arrows · internal-force labels where evidence supports them · one likely failure point</span>
            <div>Diagram / force map: ________________________________________________________________</div>
          </div>
          <div class="jcec-packet-grid two">
            <label><strong>MASS TELLS US</strong><span>__________________ &nbsp; Units: __________</span></label>
            <label><strong>FORCE TELLS US</strong><span>__________________ &nbsp; Unit: __________</span></label>
            <label><strong>OUR PRIORITY LOAD / FORCE RISK IS</strong><span>________________________________</span></label>
            <label><strong>BECAUSE</strong><span>________________________________</span></label>
          </div>`,
        3: `
          <div class="record-heading"><div><p class="mini-label">TEAM RECORD · FIELD FILE PAGES 8–9</p><h3>Material & Joint Recommendation</h3></div><span>SCIENCE CHECKPOINT</span></div>
          <p class="jcec-record-note">Carry forward the fair-test data, graph and joint evidence from the investigation above.</p>
          <div class="jcec-packet-grid two">
            <label><strong>FOR THIS PART OF OUR PRIMARY BUILDING</strong><span>________________________________</span></label>
            <label><strong>WE RECOMMEND MATERIAL</strong><span>________________________________</span></label>
            <label><strong>JOINT</strong><span>________________________________</span></label>
            <label><strong>OUR STRONGEST NUMERICAL EVIDENCE IS</strong><span>________________________________</span></label>
            <label><strong>THIS MATTERS BECAUSE THE STRUCTURE NEEDS</strong><span>________________________________</span></label>
            <label><strong>THIS MATERIAL / JOINT FITS THE JOB BECAUSE</strong><span>________________________________</span></label>
            <label class="wide"><strong>ONE THING OUR TEST DOES NOT PROVE IS</strong><span>________________________________</span></label>
          </div>
          <p class="jcec-record-note"><strong>Math boundary:</strong> Field File Page 10 is separate individual Resource Mathematics evidence. It is not an added Science lesson or Science grade.</p>`,
        4: `
          <div class="record-heading"><div><p class="mini-label">TEAM RECORD · FIELD FILE PAGE 13</p><h3>New Horizon Safety Protocol</h3></div><span>PRIMARY BUILDING → DISTRICT</span></div>
          <p class="jcec-record-note">Use the Primary Building baseline/retest evidence from Pages 11–12 to set the rule.</p>
          <div class="jcec-packet-grid two">
            <label><strong>STABILITY RULE · JCEC SHOULD REQUIRE</strong><span>________________________________</span></label>
            <label><strong>FOUNDATION / MASS RULE</strong><span>________________________________</span></label>
            <label><strong>STRENGTHENING RULE</strong><span>________________________________</span></label>
            <label><strong>ENVIRONMENTAL / SITE CONDITION</strong><span>________________________________</span></label>
            <label><strong>MARGIN-OF-SAFETY RULE</strong><span>________________________________</span></label>
            <label><strong>ONE IMPORTANT UNCERTAINTY</strong><span>________________________________</span></label>
          </div>
          <div class="jcec-readiness">
            <strong>FINAL CITYSCAPE READINESS CHECK</strong>
            <span>□ Circular-base building complete &nbsp; □ Triangular-base building complete &nbsp; □ Parallelogram-base building complete &nbsp; □ Primary Test Building identified</span>
            <span>□ Model reflects M1 requirements &nbsp; □ Primary Building responds to M2 Force Map &nbsp; □ Material choice matches M3 evidence &nbsp; □ M4 redesign visible or documented</span>
            <span>□ Model reasonably matches blueprint &nbsp; □ Protected/restricted area respected &nbsp; □ Simple energy plan shown &nbsp; □ Simple transportation plan shown</span>
          </div>`,
        5: `
          <div class="record-heading"><div><small>MAJOR PHASE 4 SYNTHESIS · FIELD FILE PAGE 14</small><h3>JCEC NEW HORIZON STRUCTURAL AUTHORIZATION</h3></div><button type="button" data-jcec-print>Print / Save PDF</button></div>
          <p class="jcec-record-note"><strong>This is structural authorization.</strong> You are deciding whether the prototype works structurally—not whether humans should settle Jabberwocky.</p>
          <div class="jcec-locker-grid">
            <label><strong>M1 · REQUIREMENTS</strong><span>Strongest evidence: ______________________________</span></label>
            <label><strong>M2 · FORCES</strong><span>Strongest evidence: ______________________________</span></label>
            <label><strong>M3 · MATERIALS</strong><span>Strongest evidence: ______________________________</span></label>
            <label><strong>M4 · SAFETY</strong><span>Strongest evidence: ______________________________</span></label>
          </div>
          <div class="jcec-review-table">
            <div class="head"><strong>REVIEW LENS</strong><strong>EVIDENCE STRONG ENOUGH?</strong><strong>CONCERN / REQUIRED REVISION</strong></div>
            <div><span>FUNCTION</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
            <div><span>RELIABILITY</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
            <div><span>SAFETY</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
            <div><span>MATERIAL EFFICIENCY</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
            <div><span>COST / COMPLEXITY</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
            <div><span>ENVIRONMENTAL IMPACT</span><span>□ Yes &nbsp; □ Not yet</span><span>________________________</span></div>
          </div>
          <div class="jcec-authorization-choice"><strong>FINAL STRUCTURAL AUTHORIZATION</strong><span>□ PROCEED &nbsp; □ PROCEED AFTER REQUIRED MODIFICATIONS &nbsp; □ LIMIT THE BUILD &nbsp; □ HOLD FOR MORE EVIDENCE</span></div>
          <div class="jcec-packet-grid one">
            <label><strong>REQUIRED MODIFICATION / RESTRICTION / NEXT EVIDENCE</strong><span>________________________________________________________________</span></label>
            <label><strong>FINAL JCEC MESSAGE · 3–5 SENTENCES</strong><span>Explain your authorization using evidence from at least three different missions.<br/>________________________________________________________________<br/>________________________________________________________________<br/>________________________________________________________________</span></label>
          </div>`
      };

      const replaceText = (root, replacements) => {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        for (const node of nodes) {
          let next = node.nodeValue || '';
          for (const [from, to] of replacements) next = next.replace(from, to);
          if (next !== node.nodeValue) node.nodeValue = next;
        }
      };

      const alignTeacherGuide = () => {
        replaceText(document.body, [
          ['Prepare one standardized small baseline model per team or shared station; choose stability comparison and test ceiling.', 'Confirm each team’s Primary Structural Test Building is ready for safe testing; keep one standardized reference model or fallback dataset available when team models cannot support a fair comparison.'],
          ['Set identical/near-identical baseline models; choose one repeatable disturbance; post maximum load.', 'Use each team’s Primary Structural Test Building when a fair comparison is possible; choose one repeatable disturbance, post the maximum load, and keep the standardized reference model / fallback dataset ready if needed.'],
          ['Standardized small models; small loads; string/tilt method; evidence sheet.', 'Primary Structural Test Buildings; small safe loads; string/tilt method; evidence sheet; standardized reference model / fallback dataset if needed.'],
          ['Compare base/support or high-vs-low mass using one factor at a time → identify a weakness.', 'Baseline test the Primary Structural Test Building with the teacher-selected repeatable procedure → identify a weakness; use reference/fallback evidence only when fair testing is not possible.'],
          ['Standardized Stability & Improvement Investigation', 'Primary Building Stability & Improvement Investigation'],
          ['No final physical habitat build.', 'No new physical build in Mission 5; use the completed CityScape and Phase 4 records.']
        ]);
      };

      const alignMission = () => {
        if (!missionNumber) return;
        const root = document.getElementById(`phase4-mission${missionNumber}`);
        if (!root) return;
        const record = missionNumber === 5 ? root.querySelector('.record-card') : root.querySelector('.team-record');
        if (record && packetRecords[missionNumber]) {
          record.innerHTML = packetRecords[missionNumber];
          record.classList.add('jcec-packet-record');
          record.querySelector('[data-jcec-print]')?.addEventListener('click', () => window.print());
        }

        if (missionNumber === 4) {
          const briefing = root.querySelector('#your-mission .briefing p');
          if (briefing) briefing.innerHTML = 'Mission 3 tested material samples and joint behaviour. Now JCEC needs to know whether the <strong>Primary Structural Test Building</strong> stays stable as a whole system. Baseline test your Primary Building when a fair comparison is possible, identify one weakness, propose two alternatives, make one evidence-based change and retest it. If team models are too different for a useful comparison, your teacher may use the standardized reference model / fallback dataset first, then you will apply that stability evidence back to your CityScape.';
          const investigation = root.querySelector('#investigate .investigation-block');
          const title = investigation?.querySelector('.block-title h3');
          if (title) title.textContent = 'Primary Building Stability & Improvement Investigation';
          const intro = investigation ? Array.from(investigation.children).find((el) => el.tagName === 'P') : null;
          if (intro) intro.innerHTML = 'Your <strong>Primary Structural Test Building is the default test object</strong> when the teacher-selected procedure can be kept fair. Use the standardized reference model / fallback dataset only when team models differ too much for a meaningful comparison.';
          const classTwo = root.querySelector('.class-plan .class-grid article:nth-child(2) p');
          if (classTwo) classTwo.textContent = 'Baseline test the Primary Structural Test Building when a fair comparison is possible; use the standardized reference model / fallback dataset only when needed.';
          const reflection = root.querySelector('.reflection-card h3');
          if (reflection) reflection.textContent = 'Why can adding more material make a structure less efficient—or even create a new problem?';
        }

        if (missionNumber === 5) {
          const materials = root.querySelector('.materials-panel p');
          if (materials) materials.textContent = 'Use the completed CityScape as the application object. Mission 5 requires no new physical build: the structural decision comes from the completed district plus the M1–M4 evidence.';
          const fallback = root.querySelector('.fallback-panel p');
          if (fallback) fallback.textContent = 'If a team lacks usable model evidence, use its Phase 4 records plus the shared/reference evidence. Do not start a replacement build just for Mission 5.';
        }
      };

      const run = () => {
        if (isTeacherGuide) alignTeacherGuide();
        alignMission();
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run, { once:true });
      else run();
    })();
  </script>
)}

<style is:global>
  .jcec-packet-record .jcec-record-note { margin:.65rem 0; padding:.65rem .75rem; border-radius:9px; background:#202a32; color:#bdc6ce; font-size:.78rem; line-height:1.45; }
  .jcec-packet-grid { display:grid; gap:.55rem; margin-top:.7rem; }
  .jcec-packet-grid.one { grid-template-columns:1fr; }
  .jcec-packet-grid.two { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .jcec-packet-grid.four { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .jcec-packet-grid label,.jcec-locker-grid label { display:grid; gap:.3rem; padding:.65rem; border:1px solid #44515b; border-radius:9px; background:#141c22; color:#c7d0d6; font-size:.75rem; }
  .jcec-packet-grid label strong,.jcec-locker-grid label strong { color:#f3b55f; font-size:.66rem; }
  .jcec-packet-grid label span,.jcec-locker-grid label span { color:#d5dce1; line-height:1.45; }
  .jcec-requirements-table,.jcec-review-table { display:grid; margin-top:.7rem; border:1px solid #44515b; border-radius:9px; overflow:hidden; }
  .jcec-requirements-table>div { display:grid; grid-template-columns:1fr 1fr; }
  .jcec-review-table>div { display:grid; grid-template-columns:.9fr .9fr 1.3fr; }
  .jcec-requirements-table>div>*,.jcec-review-table>div>* { padding:.55rem; border-right:1px solid #38444e; border-bottom:1px solid #38444e; color:#c8d1d7; font-size:.73rem; }
  .jcec-requirements-table .head,.jcec-review-table .head { background:#25313b; }
  .jcec-requirements-table .head strong,.jcec-review-table .head strong { color:#fff; }
  .jcec-force-map-box,.jcec-readiness,.jcec-authorization-choice { display:grid; gap:.45rem; margin-top:.7rem; padding:.75rem; border:1px solid #48555f; border-radius:9px; background:#151d24; color:#cbd4da; font-size:.75rem; line-height:1.45; }
  .jcec-force-map-box strong,.jcec-readiness strong,.jcec-authorization-choice strong { color:#f3b55f; }
  .jcec-locker-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.5rem; margin-top:.7rem; }
  .jcec-authorization-choice { border-color:#7d5b2f; background:#21190f; }
  @media (max-width:760px){
    .jcec-packet-grid.two,.jcec-packet-grid.four,.jcec-locker-grid { grid-template-columns:1fr; }
    .jcec-requirements-table>div,.jcec-review-table>div { grid-template-columns:1fr; }
  }
  @media print { .jcec-packet-record { break-inside:avoid; } }
</style>
