---
import type { PracticeQuestion } from '../data/topicContent';
interface Group { label:string; questions:readonly PracticeQuestion[]; count:number }
interface Props { groups:Group[] }
const { groups }=Astro.props;const total=groups.reduce((s,g)=>s+g.count,0);
---
<div class="practice-widget" data-unit7-balanced-practice data-count={total}>
 <div class="practice-top"><div><p class="eyebrow">SUPPORTED WHOLE-UNIT PRACTICE</p><h3>Balanced {total}-question practice set</h3><p>Every set includes exactly 3 questions from each Measurement lesson. Hints and explanations are available.</p></div><span data-score>0 / 0</span></div>
 <div data-stage aria-live="polite"></div><div class="actions"><button type="button" class="hint" data-hint>Show hint</button><button type="button" data-next disabled>Next question</button></div><script type="application/json" data-data set:html={JSON.stringify(groups)}></script>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit7-balanced-practice]').forEach(widget=>{const groups=JSON.parse(widget.querySelector('[data-data]')?.textContent||'[]'),total=Number(widget.dataset.count||12),stage=widget.querySelector<HTMLElement>('[data-stage]'),score=widget.querySelector('[data-score]'),hint=widget.querySelector<HTMLButtonElement>('[data-hint]'),next=widget.querySelector<HTMLButtonElement>('[data-next]');let pool:any[]=[],index=0,correct=0,answered=0,locked=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(groups.flatMap((g:any)=>shuffle(g.questions).slice(0,Math.min(g.count,g.questions.length)).map((q:any)=>({...q,lessonLabel:g.label}))));const update=()=>{if(score)score.textContent=`${correct} / ${answered}`;};const render=()=>{if(index>=pool.length){if(stage)stage.innerHTML=`<div class="finish"><p class="eyebrow">PRACTICE SET COMPLETE</p><h3>You scored ${correct} / ${pool.length}</h3><p>${correct===pool.length?'Excellent. You are ready for the Unit Check.':correct>=Math.ceil(pool.length*.67)?'Good progress. Review the explanations you missed, then try the Unit Check or choose More Practice.':'Use the lesson label on missed questions and return to the lesson map above for targeted review.'}</p></div>`;if(hint)hint.hidden=true;if(next){next.disabled=false;next.textContent='More Practice';}if(score)score.textContent=`${correct} / ${pool.length}`;return;}const q=pool[index];locked=false;if(stage)stage.innerHTML=`<div class="meta"><span>Question ${index+1} of ${pool.length}</span><span>${q.lessonLabel}</span></div><h3>${q.prompt}</h3><div class="choices">${q.choices.map((c:string,i:number)=>`<button type="button" data-choice="${i}"><span>${String.fromCharCode(65+i)}</span>${c}</button>`).join('')}</div><div class="feedback" data-feedback hidden></div>`;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>answer(Number(b.dataset.choice))));if(hint){hint.hidden=false;hint.disabled=false;hint.textContent='Show hint';}if(next){next.disabled=true;next.textContent=index===pool.length-1?'Finish practice':'Next question';}update();};const answer=(choice:number)=>{if(locked)return;locked=true;answered++;const q=pool[index],ok=choice===q.answer;if(ok)correct++;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect')});const f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>${ok?'Correct!':'Not quite yet.'}</strong> ${q.explain}`;}if(hint)hint.disabled=true;if(next)next.disabled=false;update();};hint?.addEventListener('click',()=>{if(index>=pool.length||locked)return;const q=pool[index],f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>Hint:</strong> ${q.hint||'Draw the measurement relationship before calculating.'}`;}hint.textContent='Hint shown';});next?.addEventListener('click',()=>{if(index>=pool.length){reset();return;}index++;render();});const reset=()=>{pool=build().slice(0,total);index=0;correct=0;answered=0;render();};reset();});
</script>
<style>.practice-widget{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.practice-top{display:flex;justify-content:space-between;gap:1rem;align-items:start;border-bottom:1px solid #e8edf3;padding-bottom:.8rem}.practice-top h3{margin:.2rem 0}.practice-top p{margin:.2rem 0;color:#64748b}.practice-top>span{font-weight:900;white-space:nowrap}.meta{display:flex;justify-content:space-between;gap:.8rem;margin:1rem 0 .2rem;color:#5f6f84;font-size:.78rem;font-weight:900;text-transform:uppercase}.choices{display:grid;gap:.55rem;margin:1rem 0}.choices button{display:flex;gap:.65rem;align-items:center;text-align:left;border:1px solid #d9e1eb;border-radius:12px;background:#fff;padding:.72rem;cursor:pointer}.choices button span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#eef3f9;font-weight:800}.choices button.correct{border-color:#22c55e;background:#f0fdf4}.choices button.incorrect{border-color:#ef4444;background:#fef2f2}.feedback{padding:.75rem;border-radius:11px;background:#f7f9fc}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.actions .hint{background:#eef3f9;color:#25364f}.actions button:disabled{opacity:.45}.finish{padding:1rem 0}@media(max-width:650px){.practice-top,.meta{display:grid}}</style>
