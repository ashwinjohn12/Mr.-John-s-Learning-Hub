---
const practice=[
 {lesson:'1.1',prompt:'Point R is 6 units left and 4 units up from the origin. Which ordered pair locates R?',choices:['(−6, 4)','(6, −4)','(−4, 6)','(6, 4)'],answer:0,feedback:'x comes first. Left gives x = −6; up gives y = 4.'},
 {lesson:'1.1',prompt:'A point is at (0, −7). Where is it located?',choices:['on the y-axis','on the x-axis','Quadrant III','Quadrant IV'],answer:0,feedback:'x = 0 means the point lies on the y-axis.'},
 {lesson:'1.1',prompt:'An axis is labelled by 2s. A point is two intervals left and three intervals down from the origin. What is the point?',choices:['(−4, −6)','(−2, −3)','(−6, −4)','(4, 6)'],answer:0,feedback:'Each interval is worth 2: x = −4 and y = −6.'},
 {lesson:'1.2',prompt:'A design uses A(−4, 4), B(3, 4), C(3, −2), D(−4, −2). Which instruction reproduces the boundary?',choices:['Connect A→B→C→D→A.','Connect A→C→B→D→A.','Connect only A→C.','Connect points in any order.'],answer:0,feedback:'Exact connection order is part of the design instructions.'},
 {lesson:'1.2',prompt:'Rectangle A(−5, 2), B(1, 2), C(1, −3) has sides parallel to the axes. What is D?',choices:['(−5, −3)','(5, −3)','(−3, −5)','(1, 5)'],answer:0,feedback:'D shares x = −5 with A and y = −3 with C.'},
 {lesson:'1.2',prompt:'Two students plot the same labelled vertices but get different designs. What should they audit first?',choices:['the connection order','the quadrant names','the colour choice','the page orientation'],answer:0,feedback:'If the locations match, the next likely difference is how the labels were connected.'},
 {lesson:'1.3',prompt:'Translate P(−3, 5) 6 units right and 4 units down. Where is P′?',choices:['(3, 1)','(−9, 9)','(3, 9)','(1, 3)'],answer:0,feedback:'−3 + 6 = 3 and 5 − 4 = 1.'},
 {lesson:'1.3',prompt:'Reflect A(−4, −6) in the x-axis. Where is A′?',choices:['(−4, 6)','(4, −6)','(4, 6)','(−6, −4)'],answer:0,feedback:'Reflection in the x-axis keeps the horizontal position and mirrors the vertical position.'},
 {lesson:'1.3',prompt:'A point at (−2, 5) is rotated 180° about the origin. What is its image?',choices:['(2, −5)','(−2, −5)','(5, −2)','(2, 5)'],answer:0,feedback:'A 180° rotation places the point directly opposite the origin.'},
 {lesson:'1.4',prompt:'Point A moves from (5, −4) to (−2, 3). What is the net positional change?',choices:['7 left; 7 up','7 right; 7 down','3 left; 2 up','7 left; 1 down'],answer:0,feedback:'x changes from 5 to −2: 7 left. y changes from −4 to 3: 7 up.'},
 {lesson:'1.4',prompt:'What is the horizontal distance between (−8, 2) and (5, 2)?',choices:['13 units','13 units right','−13 units','10 units'],answer:0,feedback:'Distance is non-negative and does not include direction.'},
 {lesson:'1.4',prompt:'A route goes 9 right, 4 left, then 2 right. What are the horizontal distance travelled and net movement?',choices:['15 units travelled; 7 right net','7 units travelled; 15 right net','15 units travelled; 15 right net','7 units travelled; 7 left net'],answer:0,feedback:'Travel distance is 9+4+2=15. Net movement is 9−4+2=7 right.'}
];
const exit=[
 {lesson:'1.1',prompt:'Which point is in Quadrant III?',choices:['(−5, −2)','(−5, 2)','(5, −2)','(0, −2)'],answer:0},
 {lesson:'1.2',prompt:'Which information is essential for another student to reproduce a coordinate design?',choices:['labelled vertex coordinates plus connection order','colour only','quadrant only','number of vertices only'],answer:0},
 {lesson:'1.3',prompt:'A(3, 2) is reflected in the y-axis. Where is A′?',choices:['(−3, 2)','(3, −2)','(−2, 3)','(−3, −2)'],answer:0},
 {lesson:'1.4',prompt:'Two routes share the same start and finish. What must match?',choices:['net horizontal and vertical change','total distance travelled','number of steps','transformation types'],answer:0}
];
---
<div class="review-practice" data-unit1-review-practice>
 <section class="supported" aria-labelledby="supported-title"><div class="section-head"><div><p class="mini-label">SUPPORTED MIXED PRACTICE</p><h3 id="supported-title">Twelve questions across all four lessons</h3></div><span class="counter" data-count>0 / 12 secure</span></div><p>Check one question at a time. You can revise an answer after feedback; the goal is repair, not a one-shot score.</p><div class="questions">{practice.map((q,i)=><fieldset data-practice data-answer={q.answer} data-secure="false"><legend><span>{i+1}</span><em>Lesson {q.lesson} · {q.prompt}</em></legend><div class="choices">{q.choices.map((c,j)=><label><input type="radio" name={`u1-review-${i}`} value={j}/><b>{'ABCD'[j]}</b><span>{c}</span></label>)}</div><button type="button" data-check>Check this question</button><p data-feedback role="status">Choose an answer, then check it.</p></fieldset>)}</div></section>
 <section class="exit" aria-labelledby="exit-title"><p class="mini-label">FINAL READINESS</p><h3 id="exit-title">Four-part exit check</h3><p>Complete one question from each lesson. Submit all four together so this remains a final readiness signal rather than another supported hint cycle.</p><div class="exit-grid">{exit.map((q,i)=><fieldset data-exit data-answer={q.answer}><legend>Lesson {q.lesson} · {q.prompt}</legend>{q.choices.map((c,j)=><label><input type="radio" name={`u1-exit-${i}`} value={j}/><span>{c}</span></label>)}</fieldset>)}</div><button type="button" data-exit-submit>Check readiness</button><p class="readiness" data-exit-status role="status" tabindex="-1">Complete all four when you are ready.</p></section>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit1-review-practice]').forEach(root=>{const count=root.querySelector<HTMLElement>('[data-count]')!,practice=[...root.querySelectorAll<HTMLElement>('[data-practice]')];const update=()=>{const secure=practice.filter(x=>x.dataset.secure==='true').length;count.textContent=`${secure} / ${practice.length} secure`};practice.forEach(item=>{item.querySelector('[data-check]')?.addEventListener('click',()=>{const selected=item.querySelector<HTMLInputElement>('input:checked'),out=item.querySelector<HTMLElement>('[data-feedback]')!;if(!selected){out.textContent='Choose an answer first.';item.querySelector<HTMLInputElement>('input')?.focus();return}const qIndex=practice.indexOf(item),ok=Number(selected.value)===Number(item.dataset.answer);item.dataset.secure=String(ok);item.classList.toggle('secure',ok);item.classList.toggle('repair',!ok);out.textContent=ok?`Correct. ${JSON.parse(JSON.stringify([]))&&''}${['x comes first. Left gives x = −6; up gives y = 4.','x = 0 means the point lies on the y-axis.','Each interval is worth 2: x = −4 and y = −6.','Exact connection order is part of the design instructions.','D shares x = −5 with A and y = −3 with C.','If the locations match, the next likely difference is how the labels were connected.','−3 + 6 = 3 and 5 − 4 = 1.','Reflection in the x-axis keeps the horizontal position and mirrors the vertical position.','A 180° rotation places the point directly opposite the origin.','x changes from 5 to −2: 7 left. y changes from −4 to 3: 7 up.','Distance is non-negative and does not include direction.','Travel distance is 9+4+2=15. Net movement is 9−4+2=7 right.'][qIndex]}`:`Repair: ${['Read x first, then y.','A zero x-coordinate identifies the y-axis.','Read the scale before counting intervals.','Use the labelled connection order exactly.','Match horizontal and vertical side coordinates.','Keep plotted points fixed and compare the segment order.','Apply the horizontal and vertical translation to the original coordinates.','An x-axis reflection keeps x and mirrors the vertical position.','A 180° turn places the point opposite the origin.','Compare start and finish x-values, then y-values.','Distance is a non-negative amount; movement carries direction.','Add each step for distance travelled; combine directions for net movement.'][qIndex]}`;update()})});root.querySelector('[data-exit-submit]')?.addEventListener('click',()=>{const items=[...root.querySelectorAll<HTMLElement>('[data-exit]')],out=root.querySelector<HTMLElement>('[data-exit-status]')!,missing=items.find(x=>!x.querySelector('input:checked'));if(missing){out.textContent='Complete all four exit questions before checking readiness.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach(item=>{const ok=Number(item.querySelector<HTMLInputElement>('input:checked')!.value)===Number(item.dataset.answer);if(ok)score++;item.classList.toggle('secure',ok);item.classList.toggle('repair',!ok)});const supported=practice.filter(x=>x.dataset.secure==='true').length;out.textContent=score===4&&supported>=10?`Ready for the independent Unit Check: ${score}/4 exit and ${supported}/12 supported questions secure.`:score>=3?`Nearly ready: ${score}/4 exit and ${supported}/12 supported questions secure. Repair any highlighted lesson before the Unit Check.`:`Not yet: ${score}/4 exit and ${supported}/12 supported questions secure. Revisit the matching review stations, then retry.`;out.focus({preventScroll:true})});update()});
</script>
<style>
.review-practice{display:grid;gap:1.2rem}.section-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.section-head h3,.exit h3{margin:.15rem 0}.counter{padding:.45rem .65rem;border-radius:999px;background:#eef6ff;color:#174ea6;font-weight:850;white-space:nowrap}.questions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.review-practice fieldset{min-width:0;margin:0;padding:.9rem;border:1px solid #d7e1ee;border-radius:12px;background:#fff}.review-practice fieldset.secure{border-left:6px solid #2b6e3f}.review-practice fieldset.repair{border-left:6px solid #a44820}.review-practice legend{font-weight:850;line-height:1.4}.questions legend{display:grid;grid-template-columns:28px minmax(0,1fr);gap:.5rem;width:100%}.questions legend>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#2457c5;color:#fff}.questions legend em{font-style:normal;overflow-wrap:anywhere}.choices{display:grid;gap:.4rem;margin:.65rem 0}.choices label,.exit-grid label{display:flex;gap:.5rem;align-items:center;min-height:44px;padding:.5rem;border:1px solid #e0e6ee;border-radius:8px}.choices label:focus-within,.exit-grid label:focus-within{outline:3px solid #ffbf47;outline-offset:2px}.choices b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#eef3fb;color:#2457c5}.review-practice button{min-height:44px;border:0;border-radius:9px;padding:.6rem .8rem;background:#2457c5;color:#fff;font-weight:850}.questions [data-feedback],.readiness{margin:.6rem 0 0;padding:.65rem;border-radius:9px;background:#eef6ff}.exit{padding:1rem;border:1px solid #cddced;border-radius:16px;background:#f8fbff}.exit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:.8rem 0}.exit-grid fieldset{display:grid;gap:.35rem}.review-practice :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:760px){.questions,.exit-grid{grid-template-columns:1fr}}@media(max-width:390px){.section-head{display:grid}.counter{justify-self:start}.review-practice fieldset,.exit{padding:.7rem}}@media(prefers-reduced-motion:reduce){.review-practice *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
