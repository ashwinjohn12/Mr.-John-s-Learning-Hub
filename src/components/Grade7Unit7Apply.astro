---
import type{Unit7Lesson}from'../data/grade7Unit7';const{lesson}=Astro.props as{lesson:Unit7Lesson};
---
<div class="apply" data-unit7-apply data-config={JSON.stringify(lesson.apply)}><header><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></header><fieldset><legend>1 · Verify every calculation</legend>{lesson.apply.calculations.map((x,i)=><label>{x.label}<input data-calc={i} inputmode="decimal"/></label>)}</fieldset><fieldset><legend>2 · Build a valid representation</legend><label>Representation<select data-representation><option value="">Choose</option>{lesson.apply.representations.map(x=><option>{x}</option>)}</select></label><label>Label<select data-label><option value="">Choose</option>{lesson.apply.labels.map(x=><option>{x}</option>)}</select></label><label>Scale<select data-scale><option value="">Choose</option>{lesson.apply.scales.map(x=><option>{x}</option>)}</select></label><button type="button" data-build>Build verified representation</button><div class="display" data-display role="img" aria-label="Application representation not built."></div><p data-transcript>Model transcript: not built.</p></fieldset><fieldset><legend>3 · Interpret before deciding</legend><label>Unit<select data-unit><option value="">Choose</option>{lesson.apply.units.map(x=><option>{x}</option>)}</select></label><label>Comparison<select data-comparison><option value="">Choose</option>{lesson.apply.comparisons.map(x=><option>{x}</option>)}</select></label><label>Interpretation<select data-interpretation><option value="">Choose</option>{lesson.apply.interpretations.map(x=><option>{x}</option>)}</select></label><label>Prediction<select data-prediction><option value="">Choose</option>{lesson.apply.predictions.map(x=><option>{x}</option>)}</select></label><label>Decision<select data-decision><option value="">Choose</option>{lesson.apply.decisions.map(x=><option>{x}</option>)}</select></label></fieldset><ol>{lesson.apply.tasks.map((x,i)=><li><label><b>{x}</b><textarea rows="2" data-note={i} placeholder="Optional notes for you or your teacher"></textarea></label></li>)}</ol><p class="note"><strong>Reasoning-note policy:</strong> these written notes are never auto-graded by length, keywords, digits, or similarity. The validator checks the mathematical controls above.</p><button type="button" data-check>Verify the complete application</button><p data-status role="status" tabindex="-1">{lesson.apply.success}</p></div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit7-apply]').forEach(root=>{const c=JSON.parse(root.dataset.config||'{}'),status=root.querySelector<HTMLElement>('[data-status]')!,display=root.querySelector<HTMLElement>('[data-display]')!,transcript=root.querySelector<HTMLElement>('[data-transcript]')!;let built=false;const near=(a:number,b:number,t=1e-6)=>Number.isFinite(a)&&Math.abs(a-b)<=t,valid=(v:string,a:string[])=>a.includes(v),allCalcs=()=>[...root.querySelectorAll<HTMLInputElement>('[data-calc]')].every((x,i)=>near(Number(x.value),Number(c.calculations[i].answer),Number(c.calculations[i].tolerance??1e-6))),invalidate=()=>{built=false;root.dataset.verified='false';display.innerHTML='';display.setAttribute('aria-label','Application representation not built.');transcript.textContent='Model transcript: not built.';status.textContent='Evidence changed. Rebuild the representation and verify again.'};
 root.querySelectorAll('input,select,textarea').forEach(x=>{x.addEventListener('input',invalidate);x.addEventListener('change',invalidate)});
 root.querySelector('[data-build]')?.addEventListener('click',()=>{const rep=root.querySelector<HTMLSelectElement>('[data-representation]')!.value,label=root.querySelector<HTMLSelectElement>('[data-label]')!.value,scale=root.querySelector<HTMLSelectElement>('[data-scale]')!.value;if(!allCalcs()){status.textContent='Calculation check failed. Verify every requested value independently before building.';return}if(!valid(rep,c.validRepresentations)){status.textContent='Representation check failed. A mathematically unsuitable or misleading representation cannot pass.';return}if(!valid(label,c.validLabels)){status.textContent='Label check failed. The representation must identify the measured quantity and unit where required.';return}if(!valid(scale,c.validScales)){status.textContent='Scale check failed. Correct numbers paired with a misleading scale cannot pass.';return}built=true;const calc=c.calculations.map((x:any,i:number)=>`${x.label}=${root.querySelectorAll<HTMLInputElement>('[data-calc]')[i].value}`).join('; '),text=`${rep}; label ${label}; scale ${scale}; ${calc}.`;display.innerHTML=`<div class="model-card"><strong>${rep}</strong><span>${label}</span><span>${scale}</span><div>${c.calculations.map((x:any,i:number)=>`<b>${x.label}: ${root.querySelectorAll<HTMLInputElement>('[data-calc]')[i].value}</b>`).join('')}</div></div>`;display.setAttribute('aria-label',text);transcript.textContent=`Model transcript: ${text}`;status.textContent='Calculation, representation, label, and scale verified. Complete the contextual checks.'});
 root.querySelector('[data-check]')?.addEventListener('click',()=>{const unit=root.querySelector<HTMLSelectElement>('[data-unit]')!.value,comparison=root.querySelector<HTMLSelectElement>('[data-comparison]')!.value,interpretation=root.querySelector<HTMLSelectElement>('[data-interpretation]')!.value,prediction=root.querySelector<HTMLSelectElement>('[data-prediction]')!.value,decision=root.querySelector<HTMLSelectElement>('[data-decision]')!.value;let message='';if(!allCalcs())message='Calculation check failed: repair every numerical checkpoint.';else if(!built)message='Representation dependency failed: build and verify the calculation, representation, label, and scale first.';else if(!valid(unit,c.validUnits))message='Unit check failed: interpret the quantity in its real context.';else if(!valid(comparison,c.validComparisons))message='Comparison check failed: the statement must follow from the verified calculations.';else if(!valid(interpretation,c.validInterpretations))message='Interpretation check failed: reject claims that overstate, hide, or distort the data/probability evidence.';else if(!valid(prediction,c.validPredictions))message='Prediction check failed: a statistic or probability supports a reasoned expectation, not an unsupported guarantee.';else if(!valid(decision,c.validDecisions))message='Decision check failed: the choice must depend on the verified evidence and representation.';else{root.dataset.verified='true';message='Application complete. Every calculation, representation, label, scale, unit, comparison, interpretation, prediction, and decision passed independently.'}status.textContent=message;status.focus({preventScroll:true});status.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'})})});
</script>
<style>.apply{overflow:hidden;border-radius:16px;background:#241640;color:#fff}.apply header{padding:1rem;background:#47306e}.apply fieldset,.apply ol,.apply .note,.apply>[data-status]{margin:1rem}.apply fieldset{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;border:1px solid #ffffff45;border-radius:10px}.apply label{display:grid;gap:.3rem}.apply input,.apply select,.apply textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #c4b5d8;font:inherit}.apply button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#f3ca63;color:#21123b;font-weight:850}.display{grid-column:1/-1;padding:.8rem;background:#fff;color:#17243a}.model-card{display:grid;gap:.45rem}.model-card div{display:flex;gap:.5rem;flex-wrap:wrap}.model-card b{padding:.45rem;background:#e8f1ff}.note{color:#eee5f8}.apply :focus-visible{outline:3px solid #ffd75e;outline-offset:2px}@media(max-width:650px){.apply fieldset{grid-template-columns:1fr}}@media(max-width:390px){.apply fieldset,.apply ol{margin:.7rem;padding:.75rem;overflow-wrap:anywhere}}@media(max-width:375px){.apply fieldset{padding:.65rem}}@media(max-width:320px){.apply fieldset,.apply ol,.apply .note,.apply>[data-status]{margin:.55rem}}@media(prefers-reduced-motion:reduce){.apply *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>