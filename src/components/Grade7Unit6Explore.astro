---
import type{Unit6Lesson}from'../data/grade7Unit6';const{lesson}=Astro.props as{lesson:Unit6Lesson};
const C:any={'solving-equations':['2x+3=17',2,3,17,7,'trial table','changing trials without comparing high or low'],'model-solving-equations':['3x+5=20',3,5,20,5,'balance scale','removing 5 from only one side'],'equations-involving-integers':['x+5=-2',1,5,-2,-7,'integer tiles','using positive tiles for a negative constant'],'solving-equations-algebraically':['5x-4=26',5,-4,26,6,'algebra steps','dividing before undoing the constant correctly'],'different-methods-equations':['2x+1=9',2,1,9,4,'strategy comparison','changing one side without preserving equality']};const c=C[lesson.slug];
---
<div class="lab" data-unit6-explore data-config={JSON.stringify(c)}><header><p>{lesson.explore.launch}</p><strong>Core: Predict → Build → Verify · Consolidation: Repair · Extension: Create</strong></header><div class="tabs" role="tablist" aria-label={`${lesson.explore.title} phases`}>{lesson.explore.phases.map((p,i)=><button id={`${lesson.slug}-tab-${i}`} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${lesson.slug}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{i+1}. {p.title}</button>)}</div>
{lesson.explore.phases.map((p,i)=><section id={`${lesson.slug}-panel-${i}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${i}`} data-phase={i} hidden={i!==0}><h3 tabindex="-1">{p.title}</h3><p>{p.instruction}</p><p><b>{i===4?'Constraint':'Target'}:</b> {i===4?`Create a different ax+b=c equation with solution x=${c[4]}.`:`${c[0]} using a ${c[5]}.`}</p>{i===0?<><label>Predicted solution<input data-predict inputmode="numeric"/></label><label>What does x represent?<input data-meaning/></label></>:<fieldset><legend>Operable equation controls</legend>{['Coefficient of x','Constant with x','Other side','Proposed solution'].map((x,j)=><label>{x}<input data-value={j} inputmode="numeric" value={i===3&&j===1?c[j+1]+1:i===4?'':c[j+1]}/></label>)}<button type="button" data-build>Build both sides</button><button type="button" data-operate disabled>Apply valid equality move</button></fieldset>}<div class="equation-model" data-model role="img" aria-label="Equation model not built."><div data-visual></div><p data-transcript>Model transcript: not built.</p></div>{i===3&&<label>First mathematical error<select data-repair><option value="">Choose</option><option>{c[6]}</option><option>the colour palette</option><option>the heading size</option></select></label>}{i>0&&<><label>Verified solution<input data-checkpoint inputmode="numeric"/></label><label>Substitution LHS<input data-lhs inputmode="numeric"/></label><label>Substitution RHS<input data-rhs inputmode="numeric"/></label></>}<label>Evidence for student or teacher review<textarea data-evidence rows="2"></textarea></label><button type="button" data-verify>Verify phase</button><p data-status role="status">Not verified.</p></section>)}<p data-progress role="status">0 of 3 core phases verified.</p></div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit6-explore]').forEach(root=>{const c=JSON.parse(root.dataset.config||'[]'),tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-tab]')],panels=[...root.querySelectorAll<HTMLElement>('[data-phase]')],passed=new Set<number>(),built=new Set<number>(),operated=new Set<number>(),progress=()=>{const n=[0,1,2].filter(x=>passed.has(x)).length;root.querySelector<HTMLElement>('[data-progress]')!.textContent=`${n} of 3 core phases verified.${n===3?' Core Explore complete.':''}`},activate=(i:number,focus=true)=>{tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1});panels.forEach((p,j)=>p.hidden=i!==j);if(focus)panels[i].querySelector<HTMLElement>('h3')?.focus()};tabs.forEach((t,i)=>{t.onclick=()=>activate(i);t.onkeydown=e=>{let j=i;if(e.key==='ArrowRight')j=(i+1)%5;else if(e.key==='ArrowLeft')j=(i+4)%5;else if(e.key==='Home')j=0;else if(e.key==='End')j=4;else return;e.preventDefault();activate(j,false);tabs[j].focus()}});
const invalidate=(i:number)=>{for(let j=i;j<5;j++){passed.delete(j);built.delete(j);operated.delete(j);const p=panels[j];p.dataset.verified='false';p.querySelector<HTMLElement>('[data-visual]')!.innerHTML='';p.querySelector<HTMLElement>('[data-transcript]')!.textContent='Model transcript: not built.';p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label','Equation model not built.');p.querySelector<HTMLElement>('[data-status]')!.textContent=j===i?'Evidence changed. Rebuild and verify.':'Earlier evidence changed. Reverify dependencies.'}progress()};
panels.forEach((p,i)=>{p.querySelectorAll('input,select,textarea').forEach(el=>{el.addEventListener('input',()=>{if([...passed,...built,...operated].some(j=>j>=i))invalidate(i)});el.addEventListener('change',()=>{if([...passed,...built,...operated].some(j=>j>=i))invalidate(i)})});const vals=()=>[...p.querySelectorAll<HTMLInputElement>('[data-value]')].map(x=>Number(x.value));p.querySelector('[data-build]')?.addEventListener('click',()=>{const v=vals(),valid=v.length===4&&v.every(Number.isFinite)&&v[0]!==0&&Math.abs(v[0]*v[3]+v[1]-v[2])<1e-9,target=v.every((x,j)=>x===c[j+1]),repair=p.querySelector<HTMLSelectElement>('[data-repair]')?.value,ok=i===4?valid&&!target:valid&&target&&(i!==3||repair===c[6]);if(!ok){p.querySelector<HTMLElement>('[data-status]')!.textContent=i===4?`Create a different equation true for x=${c[4]}.`:i===3?'Identify the first error and restore every target value.':'Every term, side, sign, and solution must match the target.';return}built.add(i);const lhs=v[0]*v[3]+v[1],text=`${c[5]}: ${v[0]}x${v[1]>=0?'+':''}${v[1]}=${v[2]}; x=${v[3]}; LHS ${lhs}, RHS ${v[2]}.`;p.querySelector<HTMLElement>('[data-visual]')!.innerHTML=`<div class="balance"><span>${v[0]}x ${v[1]>=0?'+ '+v[1]:'− '+Math.abs(v[1])}</span><b>=</b><span>${v[2]}</span></div><div class="steps">x=${v[3]} · LHS=${lhs} · RHS=${v[2]}</div>`;p.querySelector<HTMLElement>('[data-transcript]')!.textContent=`Model transcript: ${text}`;p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label',text);p.querySelector<HTMLButtonElement>('[data-operate]')!.disabled=false;p.querySelector<HTMLElement>('[data-status]')!.textContent='Both sides built. Apply the equality move, then verify.'});p.querySelector('[data-operate]')?.addEventListener('click',()=>{if(built.has(i)){operated.add(i);p.querySelector<HTMLElement>('[data-status]')!.textContent='Valid move recorded on both sides. Enter the substitution check.'}});p.querySelector('[data-verify]')?.addEventListener('click',()=>{const evidence=p.querySelector<HTMLTextAreaElement>('[data-evidence]')!.value.trim(),v=vals(),ok=i===0?Number(p.querySelector<HTMLInputElement>('[data-predict]')!.value)===c[4]&&!!p.querySelector<HTMLInputElement>('[data-meaning]')?.value.trim():built.has(i)&&operated.has(i)&&Number(p.querySelector<HTMLInputElement>('[data-checkpoint]')!.value)===v[3]&&Number(p.querySelector<HTMLInputElement>('[data-lhs]')!.value)===v[2]&&Number(p.querySelector<HTMLInputElement>('[data-rhs]')!.value)===v[2];if(!evidence){p.querySelector<HTMLElement>('[data-status]')!.textContent='Record evidence for review; wording is not graded.';return}if(ok){passed.add(i);p.dataset.verified='true';p.querySelector<HTMLElement>('[data-status]')!.textContent='Verified. Equation, model, solution, and LHS = RHS agree.'}else p.querySelector<HTMLElement>('[data-status]')!.textContent=i===0?'Record the exact prediction and identify the unknown.':'Build, operate, and substitute in the original equation.';progress()})})});
</script>
<style>.lab{border:1px solid #c8d8ea;border-radius:15px;overflow:hidden;background:#f8fbff}.lab header,.lab section,.lab>[data-progress]{padding:1rem}.tabs{display:flex;overflow-x:auto;border-block:1px solid #c8d8ea}.tabs button{min-height:48px;min-width:145px;border:0;background:#eaf2fb;font-weight:800}.tabs button[aria-selected=true]{background:#2457c5;color:#fff}.lab label{display:grid;gap:.3rem;margin:.55rem 0;font-weight:750}.lab input,.lab select,.lab textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.6rem;font:inherit}.lab fieldset{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.lab button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#2457c5;color:#fff;font-weight:800}.equation-model{padding:.8rem;border-radius:10px;background:#fff}.balance{display:grid;grid-template-columns:1fr 50px 1fr;align-items:center;text-align:center;font-weight:850}.steps{margin-top:.6rem;padding:.6rem;background:#e6f0ff;text-align:center}.lab :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:620px){.lab fieldset{grid-template-columns:1fr}.tabs button{min-width:132px}}@media(max-width:390px){.lab header,.lab section{padding:.75rem}.balance{grid-template-columns:1fr 40px 1fr;overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){.lab *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>
