---
type Level=1|2|3;
type Visual={x:number;y:number;scale:number};
type Q={id:string;level:Level;prompt:string;correct:string;distractors:string[];feedback:string;visual?:Visual};
const q:Q[]=[];
const quadrantSigns=[['I','(+ , +)'],['II','(− , +)'],['III','(− , −)'],['IV','(+ , −)']];
quadrantSigns.forEach(([name,correct],i)=>q.push({id:`f-sign-${i}`,level:1,prompt:`Which sign pattern belongs to Quadrant ${name}?`,correct,distractors:quadrantSigns.filter((_,j)=>j!==i).map(x=>x[1]),feedback:`Quadrants are numbered counterclockwise from the upper right. Quadrant ${name} uses ${correct}.`}));
[
 ['x-axis','horizontal number line','vertical number line','the point (0, 0)','one of the four regions'],
 ['y-axis','vertical number line','horizontal number line','the point (0, 0)','an ordered pair'],
 ['origin','the point (0, 0)','the horizontal axis','the vertical axis','Quadrant I'],
 ['ordered pair','an address written (x, y)','the horizontal axis','a quadrant number','a grid scale']
].forEach((x,i)=>q.push({id:`f-vocab-${i}`,level:1,prompt:`Which description matches ${x[0]}?`,correct:x[1],distractors:x.slice(2),feedback:`${x[0]}: ${x[1]}.`}));
[
 [0,6,'on the y-axis'],[-8,0,'on the x-axis'],[0,0,'at the origin'],[4,-7,'in Quadrant IV']
].forEach((x,i)=>q.push({id:`f-location-${i}`,level:1,prompt:`Where is the point (${x[0]}, ${x[1]})?`,correct:x[2] as string,distractors:['in Quadrant I','in Quadrant II','in Quadrant III','in Quadrant IV','on the x-axis','on the y-axis','at the origin'].filter(a=>a!==x[2]).slice(0,3),feedback:`A zero coordinate places a point on an axis. Otherwise, use the signs of x and y.`}));
const corePoints=[[-7,4,1],[6,5,1],[-4,-6,1],[8,-3,1],[0,7,1],[-9,0,1],[-12,8,2],[10,-14,2],[-25,15,5],[20,-35,5],[-60,40,10],[30,-70,10]];
corePoints.forEach((p,i)=>{const [x,y,scale]=p;const loc=x===0?'on the y-axis':y===0?'on the x-axis':x>0&&y>0?'in Quadrant I':x<0&&y>0?'in Quadrant II':x<0&&y<0?'in Quadrant III':'in Quadrant IV';const correct=`(${x}, ${y})`;const candidates=[`(${y}, ${x})`,`(${-x}, ${y})`,`(${x}, ${-y})`,`(${-x}, ${-y})`,`(${y}, ${-x})`,`(${-y}, ${x})`];const distractors=[...new Set(candidates)].filter(a=>a!==correct).slice(0,3);q.push({id:`c-read-${i}`,level:2,prompt:`What ordered pair is shown? Each grid square represents ${scale}.`,correct,distractors,feedback:`Read x first, then y. The point is ${loc}. Count using the stated scale.`,visual:{x,y,scale}})});
[
 [3,4,'3 units right, then 4 units up'],[-5,2,'5 units left, then 2 units up'],[-4,-6,'4 units left, then 6 units down'],[7,-3,'7 units right, then 3 units down'],[0,5,'stay at x = 0, then 5 units up'],[-6,0,'6 units left, then stay at y = 0']
].forEach((x,i)=>q.push({id:`c-dir-${i}`,level:2,prompt:`Which directions correctly plot (${x[0]}, ${x[1]}) from the origin?`,correct:x[2] as string,distractors:[`${Math.abs(Number(x[1]))} units ${Number(x[1])>=0?'right':'left'}, then ${Math.abs(Number(x[0]))} units ${Number(x[0])>=0?'up':'down'}`,'move y first, then x','the signs do not affect direction'],feedback:`The first coordinate controls horizontal movement. The second controls vertical movement.`}));
[
 [2,'Quadrant I','both coordinates are positive'],[-2,'Quadrant II','x is negative and y is positive'],[-3,'Quadrant III','both coordinates are negative'],[4,'Quadrant IV','x is positive and y is negative'],[0,'an axis','one coordinate is zero'],[5,'Quadrant I','both coordinates are positive']
].forEach((x,i)=>{const pts=[[6,4],[-6,4],[-6,-4],[6,-4],[0,4],[10,5]][i];q.push({id:`c-quad-${i}`,level:2,prompt:`Where is (${pts[0]}, ${pts[1]}) located?`,correct:x[1] as string,distractors:['Quadrant I','Quadrant II','Quadrant III','Quadrant IV','an axis'].filter(a=>a!==x[1]).slice(0,3),feedback:`${x[2]}.`})});
[
 [5,-3,2,'(−15, 10)','3 squares left gives −15 and 2 squares up gives 10.'],
 [10,4,-6,'(40, −60)','4 squares right gives 40 and 6 squares down gives −60.'],
 [2,-5,-4,'(−10, −8)','5 squares left gives −10 and 4 squares down gives −8.'],
 [5,6,0,'(30, 0)','Six squares right is 30; staying on the x-axis makes y = 0.']
].forEach((x,i)=>q.push({id:`r-scale-${i}`,level:3,prompt:`A grid uses ${x[0]} per square. From the origin, move ${Math.abs(Number(x[1]))} squares ${Number(x[1])>=0?'right':'left'} and ${Math.abs(Number(x[2]))} squares ${Number(x[2])>=0?'up':'down'}. What is the coordinate?`,correct:x[3] as string,distractors:[`(${x[1]}, ${x[2]})`,`(${Number(x[1])*Number(x[0])}, ${x[2]})`,`(${x[2]}, ${x[1]})`],feedback:x[4] as string}));
[
 ['Sam plotted (−3, 5) by moving 3 right and 5 up.','Sam used the wrong direction for x. Move 3 left, then 5 up.'],
 ['Maya says (0, −6) is in Quadrant IV.','A point with x = 0 is on the y-axis, not in a quadrant.'],
 ['Noah read a plotted point as (4, −7), but he counted y before x.','Read horizontal x first, then vertical y.'],
 ['A grid is labelled by 5s, but Priya counted each square as 1.','Use the axis scale: each square represents 5.']
].forEach((x,i)=>q.push({id:`r-error-${i}`,level:3,prompt:`Which feedback best repairs this mistake? ${x[0]}`,correct:x[1],distractors:['The answer is fine as written.','Change both coordinate signs.','Always count the vertical coordinate first.'],feedback:x[1]}));
[
 ['Which point cannot belong to any quadrant?','(0, 8)',['(3, 8)','(−3, 8)','(−3, −8)'],'A point on either axis is not inside a quadrant.'],
 ['Two points have coordinates (0, 3) and (3, 0). What is true?','One is on the y-axis and one is on the x-axis.',['Both are in Quadrant I.','They are the same point.','Both are on the y-axis.'],'Coordinate order matters: (0, 3) and (3, 0) are different locations.'],
 ['A point is in Quadrant II and has y = 7. Which x-value is possible?','−4',['4','0','7'],'Quadrant II needs negative x and positive y.'],
 ['A point is on the x-axis. Which statement must be true?','Its y-coordinate is 0.',['Its x-coordinate is 0.','Both coordinates are positive.','It is in Quadrant I.'],'Every point on the x-axis has the form (x, 0).']
].forEach((x,i)=>q.push({id:`r-reason-${i}`,level:3,prompt:x[0] as string,correct:x[1] as string,distractors:x[2] as string[],feedback:x[3] as string}));
---
<div class="cartesian-check" data-cartesian-check>
  <div class="check-head"><div><p class="mini-label">8-QUESTION INDEPENDENT CHECK</p><h3>Fresh questions every attempt</h3><p>Each set includes 2 foundational, 4 core, and 2 reasoning questions. Correct-answer positions are balanced across A–D.</p></div><div class="bank-badge"><strong>{q.length}</strong><span>question bank</span></div></div>
  <div data-items class="check-items"></div>
  <div class="check-actions"><button type="button" data-submit>Submit all 8</button><button type="button" class="secondary" data-new>New question set</button></div>
  <p data-result role="status" tabindex="-1" class="result">A new set is ready.</p>
  <script type="application/json" data-bank set:html={JSON.stringify(q)}></script>
</div>
<script>
const shuffle=<T,>(a:T[])=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
const miniGrid=(v:{x:number;y:number;scale:number})=>{const px=130+(v.x/v.scale)*10,py=130-(v.y/v.scale)*10;let lines='';for(let i=0;i<=20;i++){const p=30+i*10;lines+=`<line x1="${p}" y1="30" x2="${p}" y2="230"/><line x1="30" y1="${p}" x2="230" y2="${p}"/>`}return`<svg class="mini-grid" viewBox="0 0 260 260" role="img" aria-label="Coordinate grid with a point to identify. Each square represents ${v.scale}."><rect x="30" y="30" width="200" height="200" rx="8"/><g>${lines}</g><path d="M30 130H230M130 30V230"/><circle cx="${px}" cy="${py}" r="7"/></svg>`};
document.querySelectorAll<HTMLElement>('[data-cartesian-check]').forEach(root=>{const bank=JSON.parse(root.querySelector<HTMLScriptElement>('[data-bank]')!.textContent||'[]');const box=root.querySelector<HTMLElement>('[data-items]')!,result=root.querySelector<HTMLElement>('[data-result]')!;let attempt:any[]=[];
 const build=()=>{const l1=shuffle(bank.filter((x:any)=>x.level===1)).slice(0,2),l2=shuffle(bank.filter((x:any)=>x.level===2)).slice(0,4),l3=shuffle(bank.filter((x:any)=>x.level===3)).slice(0,2);const positions=shuffle([0,0,1,1,2,2,3,3]);attempt=shuffle([...l1,...l2,...l3]).map((item:any,i:number)=>{const pos=positions[i],wrongPool=[...new Set<string>(item.distractors.filter((x:string)=>x!==item.correct))];if(wrongPool.length<3)throw new Error(`Question ${item.id} needs three unique distractors.`);const wrong=shuffle(wrongPool).slice(0,3),choices=[...wrong];choices.splice(pos,0,item.correct);return{...item,choices,answer:pos}});box.innerHTML=attempt.map((item:any,i:number)=>`<fieldset data-item data-answer="${item.answer}" data-feedback="${String(item.feedback).replaceAll('&','&amp;').replaceAll('"','&quot;')}"><legend><span>${i+1}</span>${item.prompt}</legend>${item.visual?miniGrid(item.visual):''}<div class="choices">${item.choices.map((c:string,j:number)=>`<label><input type="radio" name="cart-q-${i}" value="${j}"><b>${'ABCD'[j]}</b><span>${c}</span></label>`).join('')}</div><p data-feedback hidden></p></fieldset>`).join('');result.textContent='A new set is ready.';result.focus()};
 root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...box.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){result.textContent='Answer all 8 questions before submitting.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach((item,i)=>{const chosen=Number(item.querySelector<HTMLInputElement>('input:checked')?.value),answer=Number(item.dataset.answer),ok=chosen===answer;if(ok)score++;item.querySelectorAll<HTMLInputElement>('input').forEach(x=>x.disabled=true);const p=item.querySelector<HTMLElement>('[data-feedback]')!;p.hidden=false;p.innerHTML=ok?`<strong>Correct.</strong> ${item.dataset.feedback}`:`<strong>Repair:</strong> ${item.dataset.feedback} Correct answer: ${attempt[i].choices[answer]}.`});result.textContent=`${score}/8. ${score>=7?'Ready for the lesson review.':score>=5?'Nearly there. Repair the missed ideas, then try a fresh set.':'Return to the matching Understand cards and Coordinate Explorer before retrying.'}`;result.focus()});
 root.querySelector('[data-new]')?.addEventListener('click',build);build();});
</script>
<style>
.cartesian-check{display:grid;gap:1rem}.check-head{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:start}.check-head h3{margin:.1rem 0}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.bank-badge{display:grid;place-items:center;min-width:88px;padding:.6rem;border-radius:14px;background:#eef6ff;color:#174ea6}.bank-badge strong{font-size:1.8rem}.bank-badge span{font-size:.75rem;font-weight:800}.check-items{display:grid;gap:.8rem}.check-items fieldset{min-width:0;margin:0;padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}.check-items legend{display:flex;gap:.55rem;align-items:flex-start;font-weight:850;line-height:1.45}.check-items legend span{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:#2457c5;color:#fff}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-top:.75rem}.choices label{display:grid;grid-template-columns:auto auto 1fr;gap:.5rem;align-items:center;min-height:48px;padding:.55rem;border:1px solid #d9e2ec;border-radius:10px;cursor:pointer}.choices label:focus-within{outline:3px solid #ffbf47;outline-offset:2px}.choices b{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#eef3fb;color:#2457c5}.mini-grid{display:block;width:min(260px,100%);margin:.75rem auto;background:#f8fbff;border-radius:12px}.mini-grid rect{fill:#f8fbff;stroke:#b9c8da}.mini-grid g{stroke:#e1e8f0;stroke-width:1}.mini-grid path{stroke:#1d3557;stroke-width:2}.mini-grid circle{fill:#ffb703;stroke:#714500;stroke-width:2}.check-items [data-feedback]{padding:.65rem;border-radius:10px;background:#eef6ff}.check-actions{display:flex;gap:.6rem;flex-wrap:wrap}.check-actions button{min-height:44px;border-radius:9px;padding:.65rem .85rem;font-weight:850;cursor:pointer}.check-actions button:first-child{border:0;background:#2457c5;color:#fff}.check-actions .secondary{border:1px solid #2457c5;background:#fff;color:#2457c5}.result{padding:.75rem;border-radius:10px;background:#f5f7fa;font-weight:750}@media(max-width:620px){.choices{grid-template-columns:1fr}.check-head{grid-template-columns:1fr}.bank-badge{justify-self:start;grid-auto-flow:column;gap:.5rem}.bank-badge strong{font-size:1.25rem}}@media(max-width:390px){.check-items fieldset{padding:.75rem}.choices label{overflow-wrap:anywhere}}
</style>
