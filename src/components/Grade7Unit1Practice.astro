---
import type { ChoiceQuestion } from '../data/grade7Unit1';
interface Props{questions:ChoiceQuestion[]; lesson:string}
const {questions,lesson}=Astro.props;
---
<div class="supported" data-supported-practice data-lesson={lesson}>
 <div class="practice-progress"><strong data-practice-count>0 / {questions.length} complete</strong><span>Work on one question at a time. Revise as often as you need.</span></div>
 {questions.map((item,index)=><fieldset class="practice-item" data-item data-answer={item.answer} data-explanation={item.feedback} hidden={index!==0}>
  <legend tabindex="-1"><span>{index+1}</span>{item.prompt}</legend>
  <div class="choice-grid">{item.choices.map((choice,choiceIndex)=><label><input type="radio" name={`${lesson}-practice-${index}`} value={choiceIndex}/><span>{choice}</span></label>)}</div>
  <div class="practice-actions"><button type="button" data-check>Check answer</button><button type="button" class="hint" data-hint aria-expanded="false" aria-controls={`${lesson}-hint-${index}`}>Hint</button></div>
  <p class="item-feedback" data-feedback role="status">Choose an answer, then check it.</p>
  <p class="hint-copy" id={`${lesson}-hint-${index}`} data-hint-copy hidden>{item.hint || 'Represent the problem in a second way and check what each number means.'}</p>
 </fieldset>)}
 <div class="practice-navigation"><button type="button" data-practice-prev disabled>← Previous</button><span data-practice-position>Question 1 of {questions.length}</span><button type="button" data-practice-next>Next →</button></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-supported-practice]').forEach(root=>{
  const items=[...root.querySelectorAll<HTMLElement>('[data-item]')];let current=0;
  const update=()=>{const done=items.filter(x=>x.dataset.complete==='true').length;const label=root.querySelector('[data-practice-count]');if(label)label.textContent=`${done} / ${items.length} complete`};
  const show=(index:number,focus=false)=>{current=Math.max(0,Math.min(items.length-1,index));items.forEach((item,i)=>item.hidden=i!==current);const position=root.querySelector('[data-practice-position]');if(position)position.textContent=`Question ${current+1} of ${items.length}`;const prev=root.querySelector<HTMLButtonElement>('[data-practice-prev]');const next=root.querySelector<HTMLButtonElement>('[data-practice-next]');if(prev)prev.disabled=current===0;if(next)next.disabled=current===items.length-1;if(focus)items[current]?.querySelector<HTMLElement>('legend')?.focus()};
  items.forEach(item=>{
   item.querySelector('[data-hint]')?.addEventListener('click',()=>{const hint=item.querySelector<HTMLElement>('[data-hint-copy]');const button=item.querySelector<HTMLButtonElement>('[data-hint]');if(hint&&button){hint.hidden=!hint.hidden;button.textContent=hint.hidden?'Hint':'Hide hint';button.setAttribute('aria-expanded',String(!hint.hidden))}});
   item.querySelector('[data-check]')?.addEventListener('click',()=>{const selected=item.querySelector<HTMLInputElement>('input:checked');const feedback=item.querySelector<HTMLElement>('[data-feedback]');if(!selected){if(feedback)feedback.textContent='Choose one response first.';item.querySelector<HTMLInputElement>('input')?.focus();return}const ok=Number(selected.value)===Number(item.dataset.answer);item.dataset.complete=String(ok);item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);const correctLabel=item.querySelectorAll<HTMLLabelElement>('.choice-grid label')[Number(item.dataset.answer)]?.textContent?.trim();if(feedback)feedback.innerHTML=ok?`<strong>Correct.</strong> ${item.dataset.explanation||'Your evidence matches the relation.'} <span>Verified answer: ${correctLabel}.</span>`:`<strong>Not yet.</strong> ${item.querySelector<HTMLElement>('[data-hint-copy]')?.textContent||'Identify the relevant relationship and revise.'} The correct choice stays hidden while you revise.`;update()});
  });
  root.querySelector('[data-practice-prev]')?.addEventListener('click',()=>show(current-1,true));
  root.querySelector('[data-practice-next]')?.addEventListener('click',()=>show(current+1,true));
  show(0);
 });
</script>
<style>
.supported{display:grid;gap:1rem}.practice-progress{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:.85rem 1rem;border-radius:12px;background:#eef6ff}.practice-progress span{color:#526174}.practice-item{border:1px solid #dbe4ef;border-radius:14px;padding:1rem;margin:0;background:#fff}.practice-item.correct{border-color:#44a065;background:#f2fbf5}.practice-item.incorrect{border-color:#d18a48;background:#fff9f3}.practice-item legend{display:flex;gap:.65rem;align-items:flex-start;font-weight:850}.practice-item legend span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:99px;background:#2457c5;color:#fff}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:.8rem 0}.choice-grid label{display:flex;align-items:center;gap:.55rem;padding:.65rem;border:1px solid #dce3eb;border-radius:10px;background:#fff;cursor:pointer}.choice-grid label:has(input:checked){border-color:#2457c5;background:#eef5ff}.practice-actions,.practice-navigation{display:flex;gap:.5rem;align-items:center}.practice-actions button,.practice-navigation button{border:0;border-radius:9px;background:#2457c5;color:#fff;padding:.6rem .8rem;font-weight:800}.practice-actions .hint,.practice-navigation button{background:#e8edf4;color:#24344a}.practice-navigation{justify-content:space-between}.practice-navigation button:disabled{opacity:.45;cursor:not-allowed}.item-feedback,.hint-copy{margin:.7rem 0 0;padding:.65rem;border-radius:9px;background:#f5f7fa}.supported button:focus-visible,.supported input:focus-visible,.practice-item legend:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}@media(max-width:620px){.practice-progress,.choice-grid{grid-template-columns:1fr}.practice-navigation{align-items:stretch;flex-direction:column}.practice-navigation button{width:100%}}
</style>
