---
import type { ChoiceQuestion } from '../data/grade7Unit1';
interface Props{questions:ChoiceQuestion[]; lesson:string}
const {questions,lesson}=Astro.props;
---
<div class="supported" data-supported-practice data-lesson={lesson}>
 <div class="practice-progress"><strong data-practice-count>0 / {questions.length} complete</strong><span>Immediate feedback is for learning; revise as often as you need.</span></div>
 {questions.map((item,index)=><fieldset class="practice-item" data-item data-answer={item.answer} data-explanation={item.feedback}>
  <legend><span>{index+1}</span>{item.prompt}</legend>
  <div class="choice-grid">{item.choices.map((choice,choiceIndex)=><label><input type="radio" name={`${lesson}-practice-${index}`} value={choiceIndex}/><span>{choice}</span></label>)}</div>
  <div class="practice-actions"><button type="button" data-check>Check answer</button><button type="button" class="hint" data-hint>Hint</button></div>
  <p class="item-feedback" data-feedback role="status">Choose an answer, then check it.</p>
  <p class="hint-copy" data-hint-copy hidden>{item.hint || 'Represent the problem in a second way and check what each number means.'}</p>
 </fieldset>)}
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-supported-practice]').forEach(root=>{
  const items=[...root.querySelectorAll<HTMLElement>('[data-item]')];
  const update=()=>{const done=items.filter(x=>x.dataset.complete==='true').length;const label=root.querySelector('[data-practice-count]');if(label)label.textContent=`${done} / ${items.length} complete`};
  items.forEach(item=>{
   item.querySelector('[data-hint]')?.addEventListener('click',()=>{const hint=item.querySelector<HTMLElement>('[data-hint-copy]');if(hint){hint.hidden=!hint.hidden;(item.querySelector('[data-hint]') as HTMLButtonElement).textContent=hint.hidden?'Hint':'Hide hint'}});
   item.querySelector('[data-check]')?.addEventListener('click',()=>{const selected=item.querySelector<HTMLInputElement>('input:checked');const feedback=item.querySelector<HTMLElement>('[data-feedback]');if(!selected){if(feedback)feedback.textContent='Choose one response first.';return}const ok=Number(selected.value)===Number(item.dataset.answer);item.dataset.complete=String(ok);item.classList.toggle('correct',ok);item.classList.toggle('incorrect',!ok);if(feedback)feedback.innerHTML=ok?`<strong>Correct.</strong> ${item.dataset.explanation||'Your evidence matches the relation.'}`:`<strong>Not yet.</strong> ${item.querySelector<HTMLElement>('[data-hint-copy]')?.textContent||'Identify the relevant relationship and revise.'}`;update()});
  });
 });
</script>
<style>
.supported{display:grid;gap:1rem}.practice-progress{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:.85rem 1rem;border-radius:12px;background:#eef6ff}.practice-progress span{color:#526174}.practice-item{border:1px solid #dbe4ef;border-radius:14px;padding:1rem;margin:0;background:#fff}.practice-item.correct{border-color:#44a065;background:#f2fbf5}.practice-item.incorrect{border-color:#d18a48;background:#fff9f3}.practice-item legend{display:flex;gap:.65rem;align-items:flex-start;font-weight:850}.practice-item legend span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:99px;background:#2457c5;color:#fff}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:.8rem 0}.choice-grid label{display:flex;align-items:center;gap:.55rem;padding:.65rem;border:1px solid #dce3eb;border-radius:10px;background:#fff;cursor:pointer}.choice-grid label:has(input:checked){border-color:#2457c5;background:#eef5ff}.practice-actions{display:flex;gap:.5rem}.practice-actions button{border:0;border-radius:9px;background:#2457c5;color:#fff;padding:.6rem .8rem;font-weight:800}.practice-actions .hint{background:#e8edf4;color:#24344a}.item-feedback,.hint-copy{margin:.7rem 0 0;padding:.65rem;border-radius:9px;background:#f5f7fa}.supported button:focus-visible,.supported input:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}@media(max-width:620px){.practice-progress,.choice-grid{grid-template-columns:1fr}}
</style>
