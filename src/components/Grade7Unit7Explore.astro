---
import type{Unit7Lesson}from'../data/grade7Unit7';const{lesson}=Astro.props as{lesson:Unit7Lesson};
---
<div class="lab" data-unit7-explore data-config={JSON.stringify(lesson.explore.config)}><header><p>{lesson.explore.launch}</p><strong>Core pathway: Predict → Build → Verify · Consolidation: Repair · Extension: Create</strong></header><div class="tabs" role="tablist" aria-label={`${lesson.explore.title} phases`}>{lesson.explore.phases.map((p,i)=><button id={`${lesson.slug}-tab-${i}`} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${lesson.slug}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{i+1}. {p.title}</button>)}</div>
{lesson.explore.phases.map((p,i)=><section id={`${lesson.slug}-panel-${i}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${i}`} data-phase={i} hidden={i!==0}><h3 tabindex="-1">{p.title}</h3><p>{p.instruction}</p>
{i===0&&<label>Prediction<select data-predict><option value="">Choose a prediction</option><option>{lesson.explore.config.prediction}</option><option>The result is guaranteed on every future observation or trial.</option><option>No mathematical prediction is possible.</option></select></label>}
{i===1&&<><fieldset><legend>Calculation checkpoints</legend>{lesson.explore.config.targetNumbers.map((n,j)=><label>{lesson.explore.config.numberLabels[j]}<input data-number={j} inputmode="decimal"/></label>)}</fieldset><label>Representation<select data-representation><option value="">Choose</option>{lesson.explore.config.representations.map(x=><option>{x}</option>)}</select></label><label>Scale<select data-scale><option value="">Choose</option>{lesson.explore.config.scales.map(x=><option>{x}</option>)}</select></label><label>Required label<select data-label><option value="">Choose</option><option>{lesson.explore.config.axisLabel}</option><option>Unlabelled values</option></select></label><label>Unit<select data-unit><option value="">Choose</option><option>{lesson.explore.config.unit}</option><option>unrelated units</option></select></label></>}
{i===2&&<><fieldset><legend>Independent verification</legend>{lesson.explore.config.targetNumbers.map((n,j)=><label>Verified {lesson.explore.config.numberLabels[j]}<input data-verify-number={j} inputmode="decimal"/></label>)}</fieldset><label>Interpretation<select data-interpretation><option value="">Choose</option>{lesson.explore.config.interpretations.map(x=><option>{x}</option>)}</select></label></>}
{i===3&&<><label>First mathematical problem<select data-issue><option value="">Choose</option><option>{lesson.explore.config.repairIssue}</option><option>The colour palette is not bright enough.</option><option>The heading should be larger.</option></select></label><label>Repair<select data-fix><option value="">Choose</option><option>{lesson.explore.config.repairFix}</option><option>Keep the mathematical flaw and add decoration.</option></select></label></>}
{i===4&&<><label>Different valid representation<select data-create><option value="">Choose</option>{lesson.explore.config.createRepresentations.map(x=><option>{x}</option>)}</select></label><fieldset><legend>Transfer checkpoints</legend>{lesson.explore.config.targetNumbers.map((n,j)=><label>{lesson.explore.config.numberLabels[j]}<input data-create-number={j} inputmode="decimal"/></label>)}</fieldset></>}
<label>Reasoning notes (optional; never auto-graded)<textarea rows="2" data-notes></textarea></label><button type="button" data-check>Verify {p.title}</button><div class="model" data-model role="img" aria-label="No verified representation yet."><div data-visual></div><p data-transcript>Model transcript: not built.</p></div><p data-status role="status">{i?'Complete the earlier verified phase before this one can pass.':'Ready for your prediction.'}</p></section>)}<p class="progress" data-progress role="status">0 of 3 core phases verified.</p></div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit7-explore]').forEach(root=>{const c=JSON.parse(root.dataset.config||'{}'),tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-tab]')],panels=[...root.querySelectorAll<HTMLElement>('[data-phase]')],passed=new Set<number>();
 const near=(a:number,b:number)=>Math.abs(a-b)<=Math.max(1e-6,Math.abs(b)*1e-5),valid=(value:string,list:string[])=>list.includes(value),escape=(s:any)=>String(s).replace(/[&<>]/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[x]||x));
 const progress=()=>{const core=[0,1,2].filter(i=>passed.has(i)).length;root.querySelector<HTMLElement>('[data-progress]')!.textContent=`${core} of 3 core phases verified.${core===3?' Core Explore complete; Repair and Create remain available.':''}`};
 const activate=(i:number,focus=true)=>{tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1});panels.forEach((p,j)=>p.hidden=i!==j);if(focus)panels[i].querySelector<HTMLElement>('h3')?.focus()};tabs.forEach((t,i)=>{t.onclick=()=>activate(i);t.onkeydown=e=>{let j=i;if(e.key==='ArrowRight')j=(i+1)%5;else if(e.key==='ArrowLeft')j=(i+4)%5;else if(e.key==='Home')j=0;else if(e.key==='End')j=4;else return;e.preventDefault();activate(j,false);tabs[j].focus()}});
 const clearModel=(p:HTMLElement)=>{p.querySelector<HTMLElement>('[data-visual]')!.innerHTML='';p.querySelector<HTMLElement>('[data-transcript]')!.textContent='Model transcript: not built.';p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label','No verified representation yet.')};
 const invalidate=(i:number)=>{for(let j=i;j<5;j++){if(passed.has(j)){passed.delete(j);panels[j].dataset.verified='false';clearModel(panels[j]);panels[j].querySelector<HTMLElement>('[data-status]')!.textContent=j===i?'Evidence changed. Verify this phase again.':'Earlier evidence changed. Reverify this dependent phase.'}}progress()};
 const model=(p:HTMLElement,i:number,label:string)=>{const max=Math.max(...c.data,1),visual=c.kind==='data'?`<div class="bars" aria-hidden="true">${c.data.map((n:number,j:number)=>`<span><i style="height:${Math.max(8,n/max*105)}px"></i><b>${escape(c.labels[j])}</b><em>${n}</em></span>`).join('')}</div>`:`<div class="prob-model" aria-hidden="true"><strong>${escape(c.labels[0])}: ${c.data[0]}</strong><b>×</b><strong>${escape(c.labels[1])}: ${c.data[1]}</strong></div>`;p.querySelector<HTMLElement>('[data-visual]')!.innerHTML=`<strong>${escape(label)}</strong>${visual}`;const text=`${c.transcript} Verified phase ${i+1}: ${label}.`;p.querySelector<HTMLElement>('[data-transcript]')!.textContent=`Model transcript: ${text}`;p.querySelector<HTMLElement>('[data-model]')!.setAttribute('aria-label',text)};
 panels.forEach((p,i)=>{p.querySelectorAll('input,select,textarea').forEach(el=>{const listener=()=>{if(passed.has(i)||[...passed].some(x=>x>i))invalidate(i)};el.addEventListener('input',listener);el.addEventListener('change',listener)});p.querySelector('[data-check]')?.addEventListener('click',()=>{const status=p.querySelector<HTMLElement>('[data-status]')!;if(i>0&&!passed.has(i-1)){status.textContent=`Verify ${['Predict','Build','Verify','Repair'][i-1]} first; this phase depends on it.`;return}let ok=false,label='';if(i===0){const v=p.querySelector<HTMLSelectElement>('[data-predict]')!.value;ok=v===c.prediction;label='prediction linked to the data/model'}else if(i===1){const nums=[...p.querySelectorAll<HTMLInputElement>('[data-number]')].map(x=>Number(x.value)),rep=p.querySelector<HTMLSelectElement>('[data-representation]')!.value,scale=p.querySelector<HTMLSelectElement>('[data-scale]')!.value,axis=p.querySelector<HTMLSelectElement>('[data-label]')!.value,unit=p.querySelector<HTMLSelectElement>('[data-unit]')!.value;ok=nums.length===c.targetNumbers.length&&nums.every((x,j)=>Number.isFinite(x)&&near(x,c.targetNumbers[j]))&&valid(rep,c.validRepresentations)&&valid(scale,c.validScales)&&axis===c.axisLabel&&unit===c.unit;label=`${rep}; ${scale}; ${axis}; ${unit}`}else if(i===2){const nums=[...p.querySelectorAll<HTMLInputElement>('[data-verify-number]')].map(x=>Number(x.value)),interpret=p.querySelector<HTMLSelectElement>('[data-interpretation]')!.value;ok=nums.every((x,j)=>Number.isFinite(x)&&near(x,c.targetNumbers[j]))&&valid(interpret,c.validInterpretations);label=`independent calculations agree; ${interpret}`}else if(i===3){const issue=p.querySelector<HTMLSelectElement>('[data-issue]')!.value,fix=p.querySelector<HTMLSelectElement>('[data-fix]')!.value;ok=issue===c.repairIssue&&fix===c.repairFix;label=`repaired: ${fix}`}else{const rep=p.querySelector<HTMLSelectElement>('[data-create]')!.value,nums=[...p.querySelectorAll<HTMLInputElement>('[data-create-number]')].map(x=>Number(x.value));ok=valid(rep,c.validCreateRepresentations)&&nums.every((x,j)=>Number.isFinite(x)&&near(x,c.targetNumbers[j]));label=`alternate valid representation: ${rep}`}
 if(ok){passed.add(i);p.dataset.verified='true';model(p,i,label);status.textContent=`${['Prediction','Build','Verification','Repair','Creation'][i]} verified. Calculation, representation, and interpretation dependencies agree.`}else{status.textContent=i===0?'Revise the prediction so it follows from the model without claiming certainty.':i===1?'Check every calculation, representation, scale, label, and unit. A correct number with a misleading display cannot pass.':i===2?'Recalculate independently and choose only an interpretation supported by the evidence.':i===3?'Identify and repair the mathematical flaw, not a cosmetic feature.':'Use a genuinely different valid representation and preserve the verified numerical evidence.'}progress()})});progress()});
</script>
<style>.lab{border:1px solid #c8d8ea;border-radius:16px;overflow:hidden;background:#f8fbff}.lab header,.lab section,.progress{padding:1rem}.tabs{display:flex;overflow-x:auto;border-block:1px solid #c8d8ea}.tabs button{min-width:145px;min-height:48px;border:0;background:#eaf2fb;font-weight:850}.tabs button[aria-selected=true]{background:#2457c5;color:#fff}.lab label{display:grid;gap:.3rem;margin:.55rem 0;font-weight:750}.lab input,.lab select,.lab textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.6rem;font:inherit}.lab fieldset{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;border:1px solid #b8cadb;border-radius:10px}.lab button[data-check]{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#2457c5;color:#fff;font-weight:850}.model{margin-top:.8rem;padding:.8rem;border-radius:10px;background:#fff}.bars{display:flex;align-items:end;gap:.45rem;min-height:140px;border-bottom:2px solid #26384d;overflow-x:auto}.bars span{display:grid;grid-template-rows:105px auto auto;align-items:end;text-align:center;min-width:45px}.bars i{display:block;width:34px;justify-self:center;background:#497bc1;border:2px solid #173867}.bars em{font-style:normal}.prob-model{display:grid;grid-template-columns:1fr auto 1fr;gap:.6rem;align-items:center;text-align:center;padding:1rem;border:2px solid #2c4c70}.lab :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:650px){.lab fieldset{grid-template-columns:1fr}.tabs button{min-width:132px}}@media(max-width:390px){.lab header,.lab section{padding:.75rem}.bars span{min-width:38px}.prob-model{grid-template-columns:1fr}}@media(max-width:375px){.tabs button{min-width:124px}}@media(max-width:320px){.lab header,.lab section{padding:.6rem}.tabs button{min-width:116px}}@media(prefers-reduced-motion:reduce){.lab *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>