---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title:string; summary:string; lesson:string; unitTitle:string; }
const {title,summary,lesson,unitTitle}=Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['overview','🎯','Overview'],['big-ideas','🌎','Big Ideas'],['understand','📘','Understand'],['examples','🧩','Examples'],['vocabulary','🧠','Vocabulary'],['explore','🔬','Explore'],['practise','✏️','Practise'],['check','✅','Check Yourself'],['apply','🎮','Apply'],['review','🏁','Review']];
---
<BaseLayout title={`${title} | Grade 7 Math`} description={summary} themeColor="#2457c5">
  <div class="topic-shell" style="--course:#2457c5;--course-soft:#dbeafe">
    <aside class="topic-sidebar">
      <a class="back-course" href={`${base}courses/grade-7-math/`}>← Grade 7 Math</a>
      <p class="eyebrow">ON THIS PAGE</p>
      <p class="scroll-cue">Swipe sections →</p>
      <nav aria-label="Lesson sections">{links.map(([id,icon,label])=><a href={`#${id}`}><span aria-hidden="true">{icon}</span>{label}</a>)}</nav>
    </aside>
    <article class="topic-content">
      <Breadcrumbs items={[{label:'Home',href:base},{label:'Grade 7 Math',href:`${base}courses/grade-7-math/`},{label:unitTitle},{label:title}]}/>
      <header class="topic-hero rebuild-hero">
        <p class="eyebrow">LESSON {lesson} · GRADE 7 MATH · REBUILD PROTOTYPE</p>
        <h1>{title}</h1>
        <p>{summary}</p>
        <div class="lesson-hook"><div><strong>Across first. Then up or down.</strong><span>Every ordered pair is an exact address on the plane.</span></div><code>(x, y)</code></div>
      </header>
      <slot />
    </article>
  </div>
</BaseLayout>
<style>
.lesson-hook{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft)}.lesson-hook>div{display:grid;gap:.22rem}.lesson-hook span{color:#526174;font-weight:650}.lesson-hook code{font-size:clamp(1.5rem,4vw,2.2rem);font-weight:900;color:#174ea6;background:#fff;border:1px solid #c9daf7;border-radius:12px;padding:.55rem .75rem}.scroll-cue{display:none}
:global(.cartesian-check),:global(.cartesian-check .check-items),:global(.cartesian-check fieldset),:global(.cartesian-check .choices),:global(.cartesian-check .choices label),:global(.cartesian-check .choices label span){min-width:0;max-width:100%}
:global(.cartesian-check .check-items){display:grid;gap:.8rem}
:global(.cartesian-check .check-items fieldset){width:100%;min-inline-size:0;margin:0;padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}
:global(.cartesian-check .check-items legend){display:grid!important;grid-template-columns:28px minmax(0,1fr);gap:.55rem;align-items:start;width:100%;max-width:100%;font-weight:850;line-height:1.45;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
:global(.cartesian-check .check-items legend span){display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#2457c5;color:#fff}
:global(.cartesian-check .choices){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-top:.75rem}
:global(.cartesian-check .choices label){display:grid;grid-template-columns:auto auto minmax(0,1fr);gap:.5rem;align-items:center;min-height:48px;padding:.55rem;border:1px solid #d9e2ec;border-radius:10px;cursor:pointer}
:global(.cartesian-check .choices label:focus-within){outline:3px solid #ffbf47;outline-offset:2px}
:global(.cartesian-check .choices b){display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#eef3fb;color:#2457c5}
:global(.cartesian-check .choices label span),:global(.cartesian-check [data-feedback]){overflow-wrap:anywhere;word-break:break-word}
:global(.cartesian-check .mini-grid){display:block;width:min(260px,100%);margin:.75rem auto;background:#f8fbff;border-radius:12px}
:global(.cartesian-check .mini-grid rect){fill:#f8fbff;stroke:#b9c8da}
:global(.cartesian-check .mini-grid g){stroke:#e1e8f0;stroke-width:1}
:global(.cartesian-check .mini-grid path){stroke:#1d3557;stroke-width:2}
:global(.cartesian-check .mini-grid circle){fill:#ffb703;stroke:#714500;stroke-width:2}
:global(.cartesian-check .check-items [data-feedback]){padding:.65rem;border-radius:10px;background:#eef6ff}
@media(max-width:900px){.topic-sidebar{min-width:0;max-width:100%}.topic-sidebar nav{max-width:100%}}
@media(max-width:760px){.lesson-hook{grid-template-columns:1fr}.lesson-hook code{justify-self:start}.scroll-cue{display:block;color:#64748b;font-size:.78rem}.topic-sidebar nav{scrollbar-width:thin}.rebuild-hero{padding-top:2rem;padding-bottom:3rem}}
@media(max-width:620px){:global(.cartesian-check .choices){grid-template-columns:1fr}}
@media(max-width:390px){.lesson-hook{overflow-wrap:anywhere;padding:.85rem}.rebuild-hero h1{font-size:clamp(2.15rem,11vw,3.1rem);line-height:1.04}:global(.cartesian-check .check-items fieldset){padding:.75rem}:global(.cartesian-check .choices label){overflow-wrap:anywhere}}
</style>
