---
import type { Unit2Lesson, Unit2Question } from '../data/grade7Unit2';
interface Props { lesson: Unit2Lesson; checks: Unit2Question[] }
const { lesson, checks } = Astro.props;
const signedField=(name:string,label:string,expected?:number)=>({name,label,expected});
const fields:Record<string,ReturnType<typeof signedField>[]>= {
  'adding-integers-tiles':[
    signedField('a1','Addend 1',12),signedField('a2','Addend 2',-7),signedField('a3','Addend 3',-9),signedField('a4','Addend 4',6),
    signedField('t1','Running total 1',12),signedField('t2','Running total 2',5),signedField('t3','Running total 3',-4),signedField('t4','Running total 4',2),
    signedField('pairs','Zero pairs in (+12)+(−9)',9),signedField('remainder','Signed remainder',3),signedField('reported','Corrected reported total',2)
  ],
  'adding-integers-number-line':[
    signedField('start','Starting position',-6),signedField('c1','Change 1',14),signedField('c2','Change 2',-9),signedField('c3','Change 3',5),
    signedField('e1','Endpoint 1',8),signedField('e2','Endpoint 2',-1),signedField('e3','Endpoint 3',4),signedField('chipP','Positive chips for the +5 segment',5),signedField('chipN','Negative chips for the +5 segment',0),signedField('designed','Final change from +4 to 0',-4)
  ],
  'subtracting-integers-number-line':[
    signedField('r1','Morning reading',-16),signedField('r2','Loading reading',-9),signedField('r3','Transit reading',-14),signedField('r4','Arrival reading',-11),
    signedField('c1','Morning → loading change',7),signedField('c2','Loading → transit change',-5),signedField('c3','Transit → arrival change',3),
    signedField('unsafe','Unsafe reading',-9),signedField('boundaryDistance','Distance to −10 boundary',1),signedField('lineStart','Modelled line start',-16),signedField('lineEnd','Modelled line endpoint',-11),signedField('chipResult','Chip-model result',-11)
  ]
};
---
<div class="application" data-unit2-apply data-lesson={lesson.slug}>
  <div class="apply-head"><p class="eyebrow">CONSOLIDATION OR EXTENSION</p><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></div>
  <p class="apply-instruction"><strong>Your mission:</strong> {lesson.apply.instructions}</p>
  <div class="apply-resources" aria-label="Application information">{lesson.applySupport.resources.map(item=><article><strong>{item.title}</strong><p>{item.body}</p></article>)}</div>

  {lesson.slug==='representing-integers'&&<fieldset class="apply-math"><legend>Context, models, and relationships</legend>
    <div class="context-grid">
      {[-12,-7,-85,36,9,0].map((value,index)=><label>{value>0?`+${value}`:value}: role<select data-context-role data-expected={['position','change','position','position','change','position'][index]}><option value="">Choose</option><option value="position">Position relative to a reference</option><option value="change">Directed change</option></select><select data-context-direction data-expected={['below','decrease','below','above','increase','reference'][index]}><option value="">Choose direction</option><option value="below">Below reference</option><option value="above">Above reference</option><option value="decrease">Decrease</option><option value="increase">Increase</option><option value="reference">At reference</option></select></label>)}
    </div>
    <p>Build four models. Chip counts are unsigned; their difference gives the signed value.</p>
    <div class="model-grid">
      <label>−12 model: positive chips<input type="number" min="0" step="1" data-model-p="-12"/></label><label>−12 model: negative chips<input type="number" min="0" step="1" data-model-n="-12"/></label>
      <label>+9 model: positive chips<input type="number" min="0" step="1" data-model-p="9"/></label><label>+9 model: negative chips<input type="number" min="0" step="1" data-model-n="9"/></label>
      <label>Number-line point for −85<input class="signed-entry" inputmode="text" data-exact="-85"/></label><label>Number-line point for +36<input class="signed-entry" inputmode="text" data-exact="36"/></label>
    </div>
    <label>Choose a value for two equivalent chip models<select data-equivalent-target><option value="">Choose</option><option value="-6">−6</option><option value="4">+4</option></select></label>
    <div class="model-grid"><label>Model A positives<input type="number" min="0" step="1" data-eq-p="a"/></label><label>Model A negatives<input type="number" min="0" step="1" data-eq-n="a"/></label><label>Model B positives<input type="number" min="0" step="1" data-eq-p="b"/></label><label>Model B negatives<input type="number" min="0" step="1" data-eq-n="b"/></label></div>
    <div class="model-grid"><label>Magnitude of −12<input type="number" min="0" step="1" data-exact="12"/></label><label>Opposite of +9<input class="signed-entry" inputmode="text" data-exact="-9"/></label><label>Missing information<select data-exact-text="starting-temperature"><option value="">Choose</option><option value="change">Another change</option><option value="starting-temperature">Starting temperature</option><option value="magnitude">Magnitude only</option></select></label></div>
    <div class="apply-visual" data-apply-visual role="img" aria-label="No application models verified yet."></div><p data-apply-math-status role="status">Complete every context and model requirement.</p>
  </fieldset>}

  {lesson.slug==='subtracting-integers-tiles'&&<fieldset class="apply-math"><legend>Subtraction workshop record</legend>
    <div class="subtraction-table">
      {[['8','11','-3','3'],['-6','-9','3','3'],['5','-4','9','4'],['-7','3','-10','3']].map((row,index)=><div class="sub-row" data-sub-row data-a={row[0]} data-b={row[1]}><strong>{row[0]} − ({row[1]})</strong><label>Result<input class="signed-entry" inputmode="text" data-sub-result data-exact={row[2]}/></label><label>Starting model ready?<select data-ready data-expected="no"><option value="">Choose</option><option value="yes">Yes</option><option value="no">No</option></select></label><label>Minimum zero pairs<input type="number" min="0" step="1" data-pair-count data-exact={row[3]}/></label></div>)}
    </div>
    <fieldset><legend>Which subtractions increase the value?</legend><label><input type="checkbox" data-increase value="0"/>(+8)−(+11)</label><label><input type="checkbox" data-increase value="1"/>(−6)−(−9)</label><label><input type="checkbox" data-increase value="2"/>(+5)−(−4)</label><label><input type="checkbox" data-increase value="3"/>(−7)−(+3)</label></fieldset>
    <p>Create any subtraction equal to −5, then model it with chips.</p><div class="model-grid"><label>Minuend<input class="signed-entry" inputmode="text" data-design-a/></label><label>Subtrahend<input class="signed-entry" inputmode="text" data-design-b/></label><label>Starting positive chips<input type="number" min="0" step="1" data-design-p/></label><label>Starting negative chips<input type="number" min="0" step="1" data-design-n/></label><label>Zero pairs added<input type="number" min="0" step="1" data-design-pairs/></label></div>
    <div class="apply-visual" data-apply-visual role="img" aria-label="No subtraction model verified yet."></div><p data-apply-math-status role="status">Verify all four examples and your created subtraction.</p>
  </fieldset>}

  {fields[lesson.slug]&&<fieldset class="apply-math"><legend>Independent calculation and model record</legend><div class="model-grid">{fields[lesson.slug].map(field=><label>{field.label}<input class={field.name==='pairs'||field.name==='chipP'||field.name==='chipN'||field.name==='boundaryDistance'?'':'signed-entry'} type={field.name==='pairs'||field.name==='chipP'||field.name==='chipN'||field.name==='boundaryDistance'?'number':undefined} min={field.name==='pairs'||field.name==='chipP'||field.name==='chipN'||field.name==='boundaryDistance'?'0':undefined} step="1" inputmode={field.name==='pairs'||field.name==='chipP'||field.name==='chipN'||field.name==='boundaryDistance'?undefined:'text'} data-field={field.name} data-exact={field.expected}/></label>)}</div>
    {lesson.slug==='adding-integers-tiles'&&<><label>Predicted final sign<select data-exact-text="positive"><option value="">Choose</option><option value="positive">Positive</option><option value="negative">Negative</option><option value="zero">Zero</option></select></label><label>Valid reordered expression<select data-exact-text="-9,+12,+6,-7"><option value="">Choose</option><option value="-9,+12,+6,-7">(−9)+(+12)+(+6)+(−7)</option><option value="9,-12,6,-7">(+9)+(−12)+(+6)+(−7)</option><option value="12,-7,9,6">(+12)+(−7)+(+9)+(+6)</option></select></label><label>Overall-change decision<select data-exact-text="increase"><option value="">Choose</option><option value="increase">Overall increase of 2</option><option value="decrease">Overall decrease of 2</option><option value="zero">No change</option></select></label></>}
    {lesson.slug==='adding-integers-number-line'&&<><label>Expression<select data-exact-text="-6,+14,-9,+5"><option value="">Choose</option><option value="-6,+14,-9,+5">(−6)+(+14)+(−9)+(+5)</option><option value="14,-9,5">(+14)+(−9)+(+5)</option><option value="-6,+8,-1,+4">(−6)+(+8)+(−1)+(+4)</option></select></label><label>Repair the route log<select data-exact-text="changes-endpoints"><option value="">Choose</option><option value="changes-endpoints">+14, −9, +5 are changes; +8, −1, +4 are endpoints</option><option value="all-endpoints">Every listed number is an endpoint</option></select></label><label>Does the route stay above base?<select data-exact-text="no"><option value="">Choose</option><option value="yes">Yes</option><option value="no">No; it starts below and later reaches −1</option></select></label></>}
    {lesson.slug==='subtracting-integers-number-line'&&<><label>Safe-range membership for −16, −9, −14, −11<select data-exact-text="yes,no,yes,yes"><option value="">Choose</option><option value="yes,no,yes,yes">safe, unsafe, safe, safe</option><option value="no,yes,no,no">unsafe, safe, unsafe, unsafe</option></select></label><label>Correct the colder/warmer claim<select data-exact-text="minus16-colder"><option value="">Choose</option><option value="minus16-colder">−16°C is colder than −11°C, so arrival is 5°C warmer</option><option value="minus11-colder">−11°C is colder than −16°C</option></select></label><div class="model-grid"><label>Chip start positive count<input type="number" min="0" step="1" data-cold-p="start"/></label><label>Chip start negative count<input type="number" min="0" step="1" data-cold-n="start"/></label><label>Chip change positive count<input type="number" min="0" step="1" data-cold-p="change"/></label><label>Chip change negative count<input type="number" min="0" step="1" data-cold-n="change"/></label></div><label>Shipment decision<select data-exact-text="reject"><option value="">Choose</option><option value="accept">Accept: all readings are safe</option><option value="reject">Reject or investigate: −9°C is outside the −18°C to −10°C safe range</option></select></label></>}
    <div class="apply-visual" data-apply-visual role="img" aria-label="No application model verified yet."></div><p data-apply-math-status role="status">Complete every required value and decision.</p>
  </fieldset>}

  <ol class="task-list">{lesson.apply.tasks.map((task,i)=><li><label><span><b>Task {i+1}</b>{task}</span><textarea rows="3" data-task-response aria-label={`Evidence for task ${i+1}`} placeholder="Record your reasoning for self or teacher review."></textarea></label></li>)}</ol>
  <p class="apply-review-note">Written explanations are recorded as evidence. They are not graded by word count, digits, keywords, or matching a prepared sentence.</p>
  <fieldset class="apply-checkpoints"><legend>Independent decision checkpoints</legend>{checks.map((check,i)=><div data-apply-checkpoint data-answer={check.answer} data-feedback={check.feedback}><strong>{i+1}. {check.prompt}</strong>{check.choices.map((choice,j)=><label><input type="radio" name={`${lesson.slug}-apply-${i}`} value={j}/><span>{choice}</span></label>)}<p data-checkpoint-status role="status">Not checked yet.</p></div>)}</fieldset>
  <label class="explanation">Your final mathematical decision<textarea rows="5" data-apply-text placeholder="State your decision and explain how the verified mathematics supports it."></textarea></label>
  <button type="button" data-apply-check>Verify mathematics and record evidence</button><p data-apply-status role="status" tabindex="-1">Complete every mathematical field, checkpoint, and evidence record.</p>
  <details><summary>Success checklist</summary><ul>{lesson.apply.success.map(x=><li>{x}</li>)}</ul></details>
</div>

<script>
const parseInteger=(value:string)=>/^[+\-−]?\d+$/.test(value.trim())?Number(value.trim().replace('−','-')):null;
const signed=(n:number)=>n>0?`+${n}`:`${n}`;
document.querySelectorAll<HTMLElement>('[data-unit2-apply]').forEach(root=>{
 const status=root.querySelector<HTMLElement>('[data-apply-status]'),mathStatus=root.querySelector<HTMLElement>('[data-apply-math-status]'),visual=root.querySelector<HTMLElement>('[data-apply-visual]');
 const invalidate=()=>{root.dataset.verified='false';if(mathStatus)mathStatus.textContent='Evidence changed. Verify every mathematical requirement again.';if(status)status.textContent='Work changed. Recheck the application before completion.';};
 root.querySelectorAll('input,select,textarea').forEach(control=>{control.addEventListener('input',invalidate);control.addEventListener('change',invalidate)});
 const exactOk=()=>[...root.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-exact]')].every(x=>parseInteger(x.value)===Number(x.dataset.exact))&&[...root.querySelectorAll<HTMLSelectElement>('[data-exact-text]')].every(x=>x.value===x.dataset.exactText);
 const verifyMath=()=>{
  const lesson=root.dataset.lesson;let ok=exactOk();let transcript='';
  if(lesson==='representing-integers'){
   ok=ok&&[...root.querySelectorAll<HTMLSelectElement>('[data-context-role],[data-context-direction]')].every(x=>x.value===x.dataset.expected);
   const targets=[-12,9];for(const target of targets){const p=Number(root.querySelector<HTMLInputElement>(`[data-model-p="${target}"]`)?.value),n=Number(root.querySelector<HTMLInputElement>(`[data-model-n="${target}"]`)?.value);ok=ok&&Number.isInteger(p)&&p>=0&&Number.isInteger(n)&&n>=0&&p-n===target;}
   const target=parseInteger(root.querySelector<HTMLSelectElement>('[data-equivalent-target]')?.value||''),ap=Number(root.querySelector<HTMLInputElement>('[data-eq-p="a"]')?.value),an=Number(root.querySelector<HTMLInputElement>('[data-eq-n="a"]')?.value),bp=Number(root.querySelector<HTMLInputElement>('[data-eq-p="b"]')?.value),bn=Number(root.querySelector<HTMLInputElement>('[data-eq-n="b"]')?.value);ok=ok&&target!==null&&ap-an===target&&bp-bn===target&&(ap!==bp||an!==bn)&&[ap,an,bp,bn].every(x=>Number.isInteger(x)&&x>=0);transcript=`Four models verified. Equivalent chip models ${ap}P/${an}N and ${bp}P/${bn}N both represent ${signed(target??0)}.`;
  }
  if(lesson==='subtracting-integers-tiles'){
   ok=ok&&[...root.querySelectorAll<HTMLElement>('[data-sub-row]')].every(row=>{const a=Number(row.dataset.a),b=Number(row.dataset.b),res=parseInteger(row.querySelector<HTMLInputElement>('[data-sub-result]')?.value||''),pairs=Number(row.querySelector<HTMLInputElement>('[data-pair-count]')?.value),needed=b>0?Math.max(0,b-Math.max(a,0)):Math.max(0,-b-Math.max(-a,0));return res===a-b&&pairs===needed&&row.querySelector<HTMLSelectElement>('[data-ready]')?.value===(needed===0?'yes':'no')});
   const inc=[...root.querySelectorAll<HTMLInputElement>('[data-increase]:checked')].map(x=>x.value).sort().join(',');ok=ok&&inc==='1,2';
   const a=parseInteger(root.querySelector<HTMLInputElement>('[data-design-a]')?.value||''),b=parseInteger(root.querySelector<HTMLInputElement>('[data-design-b]')?.value||''),p=Number(root.querySelector<HTMLInputElement>('[data-design-p]')?.value),n=Number(root.querySelector<HTMLInputElement>('[data-design-n]')?.value),pairs=Number(root.querySelector<HTMLInputElement>('[data-design-pairs]')?.value);if(a===null||b===null)ok=false;else{const needed=b>0?Math.max(0,b-p):Math.max(0,-b-n);ok=ok&&a-b===-5&&p-n===a&&pairs===needed&&[p,n,pairs].every(x=>Number.isInteger(x)&&x>=0);transcript=`Created model: ${p}P/${n}N has value ${signed(a)}; add ${pairs} zero pairs, remove ${signed(b)}, and −5 remains.`;}
  }
  if(lesson==='adding-integers-tiles'){const v=(n:string)=>parseInteger(root.querySelector<HTMLInputElement>(`[data-field="${n}"]`)?.value||'');ok=ok&&v('a1')!+v('a2')!+v('a3')!+v('a4')===2;transcript='Four addends, every running total, cancellation, reordering, correction, and overall increase are verified.';}
  if(lesson==='adding-integers-number-line'){transcript='Line: start −6; jumps +14, −9, +5; endpoints +8, −1, +4. Chip segment +5 and designed change −4 verified.';}
  if(lesson==='subtracting-integers-number-line'){const sp=Number(root.querySelector<HTMLInputElement>('[data-cold-p="start"]')?.value),sn=Number(root.querySelector<HTMLInputElement>('[data-cold-n="start"]')?.value),cp=Number(root.querySelector<HTMLInputElement>('[data-cold-p="change"]')?.value),cn=Number(root.querySelector<HTMLInputElement>('[data-cold-n="change"]')?.value);ok=ok&&[sp,sn,cp,cn].every(x=>Number.isInteger(x)&&x>=0)&&sp-sn===-16&&cp-cn===5&&(sp+cp)-(sn+cn)===-11;transcript=`Readings −16, −9, −14, −11; changes +7, −5, +3. Chip model ${sp}P/${sn}N plus ${cp}P/${cn}N ends at −11; the coordinated line and safe-range decision are verified.`;}
  if(visual){
   if(ok&&lesson==='adding-integers-number-line')visual.innerHTML='<div class="apply-line"><span style="--p:20%">−6</span><i style="--from:20%;--to:80%">+14</i><span style="--p:80%">+8</span><i style="--from:80%;--to:45%">−9</i><span style="--p:45%">−1</span><i style="--from:45%;--to:65%">+5</i><span style="--p:65%">+4</span></div><p>'+transcript+'</p>';
   else if(ok&&lesson==='subtracting-integers-number-line')visual.innerHTML='<div class="apply-line"><span style="--p:10%">−16</span><i style="--from:10%;--to:75%">+5</i><span style="--p:75%">−11</span></div><p>'+transcript+'</p>';
   else visual.textContent=transcript||'Application model needs revision.';
   visual.setAttribute('aria-label',transcript||'Application model needs revision.');
  }
  return ok;
 };
 root.querySelector('[data-apply-check]')?.addEventListener('click',()=>{
  const mathOk=verifyMath();root.dataset.verified=String(mathOk);if(mathStatus)mathStatus.innerHTML=mathOk?'<strong>Mathematics verified.</strong> Every required calculation, model, and decision is valid.':'<strong>Revise the mathematical record.</strong> One or more required values, model relationships, or decisions do not agree.';
  const tasks=[...root.querySelectorAll<HTMLTextAreaElement>('[data-task-response]')],missing=tasks.map((x,i)=>x.value.trim()?null:i+1).filter(Boolean),checks=[...root.querySelectorAll<HTMLElement>('[data-apply-checkpoint]')],failed:number[]=[];checks.forEach((item,i)=>{const selected=item.querySelector<HTMLInputElement>('input:checked'),ok=!!selected&&Number(selected.value)===Number(item.dataset.answer);if(!ok)failed.push(i+1);const out=item.querySelector<HTMLElement>('[data-checkpoint-status]');if(out)out.innerHTML=selected?`<strong>${ok?'Correct.':'Revise.'}</strong> ${item.dataset.feedback||''}`:'Choose an answer for this checkpoint.';});const final=!!root.querySelector<HTMLTextAreaElement>('[data-apply-text]')?.value.trim();
  if(status)status.innerHTML=!mathOk?'<strong>Mathematical evidence needs revision.</strong>':missing.length?`<strong>Record evidence for task${missing.length>1?'s':''} ${missing.join(', ')}.</strong>`:failed.length?`<strong>Decision checkpoint${failed.length>1?'s':''} ${failed.join(', ')} need revision.</strong>`:!final?'<strong>Record your final mathematical decision.</strong>':'<strong>Application complete.</strong> The mathematics is verified; the written reasoning is recorded for review.';status?.focus({preventScroll:true});
 });
});
</script>

<style>
.application{border-radius:16px;overflow:hidden;background:#21133d;color:#fff}.apply-head{padding:1.2rem;background:linear-gradient(135deg,#21133d,#493173)}.apply-head h3{margin:.15rem 0;font-size:1.55rem}.apply-instruction,.application details{margin:1rem}.apply-resources{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:1rem}.apply-resources article{padding:.8rem;border-radius:10px;background:#fff;color:#21133d}.apply-math,.apply-checkpoints{display:grid;gap:.8rem;margin:1rem;padding:1rem;border:1px solid #ffffff45;border-radius:11px}.context-grid,.model-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.context-grid label,.model-grid label,.apply-math>label{display:grid;gap:.35rem;font-weight:800}.context-grid label{grid-template-columns:1fr}.apply-math input,.apply-math select,.apply-math textarea{width:100%;box-sizing:border-box;min-height:44px;padding:.6rem;border:1px solid #8e83a3;border-radius:8px;font:inherit}.subtraction-table{display:grid;gap:.7rem}.sub-row{display:grid;grid-template-columns:1fr repeat(3,minmax(0,1fr));gap:.5rem;align-items:end;padding:.65rem;background:#ffffff10;border-radius:9px}.sub-row label{display:grid;gap:.3rem}.apply-visual,.apply-review-note{padding:.75rem;border-left:4px solid #f4c95d;background:#ffffff12}.task-list{display:grid;gap:.7rem;padding:0 1rem;list-style:none}.task-list label{display:grid;gap:.5rem;padding:.8rem;border-radius:10px;background:#ffffff12}.task-list span{display:grid}.task-list textarea,.explanation textarea{width:100%;box-sizing:border-box;font:inherit;padding:.7rem;border:1px solid #c9c2d6;border-radius:9px}.apply-checkpoints>div{display:grid;gap:.4rem}.apply-checkpoints label{display:flex;gap:.45rem;align-items:center;min-height:44px;padding:.5rem;border-radius:8px;background:#ffffff12}.apply-checkpoints p{margin:0;padding:.55rem;background:#ffffff12}.explanation{display:grid;gap:.4rem;margin:1rem;font-weight:800}.application>button{margin:0 1rem;min-height:44px;border:0;border-radius:9px;padding:.7rem .9rem;background:#f4c95d;color:#21133d;font-weight:900}.application [data-apply-status],.application [data-apply-math-status]{margin:1rem;padding:.7rem;border-radius:9px;background:#ffffff12}.application :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:700px){.apply-resources,.context-grid,.model-grid,.sub-row{grid-template-columns:1fr}.application>button{width:calc(100% - 2rem)}}@media(max-width:390px){.application{overflow-wrap:anywhere}.apply-math,.apply-checkpoints{margin:.75rem;padding:.75rem}}
</style>
<style>
.apply-line{position:relative;height:95px;margin:2.5rem .75rem 0;border-top:3px solid #263447;background:#fff}.apply-line span{position:absolute;left:var(--p);top:-12px;transform:translateX(-50%);padding-top:22px;color:#172738}.apply-line span:before{content:'';position:absolute;top:4px;left:50%;width:13px;height:13px;border-radius:50%;transform:translate(-50%,-50%);background:#2457c5}.apply-line i{position:absolute;left:min(var(--from),var(--to));width:calc(max(var(--from),var(--to)) - min(var(--from),var(--to)));top:-25px;border-top:4px solid #d76a20;text-align:center;color:#8b3e0e;font-size:.72rem}@media(max-width:390px){.apply-line{transform:scale(.82);transform-origin:left center;width:120%}}
</style>
