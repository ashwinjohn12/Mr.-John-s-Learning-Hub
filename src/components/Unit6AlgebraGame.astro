---
interface Props { variant: 'expressions' | 'models' | 'algebraic' }
const { variant } = Astro.props;
const title = variant === 'expressions' ? 'EXPRESSION CODEBREAKER' : variant === 'models' ? 'BALANCE RESCUE' : 'EQUATION ESCAPE';
---
<div class="game" data-unit6-game data-variant={variant}>
  <div class="game-head"><div><p class="eyebrow">{title}</p><h3 data-game-title></h3><p data-game-subtitle></p></div><div class="meter"><strong data-round-label>Round 1 of 3</strong><span><i data-progress></i></span></div></div>
  <section class="round"><p class="round-tag" data-round-tag></p><h3 data-prompt></h3><div class="choices" data-choices></div><div class="answer-row" data-answer-row hidden><input type="number" step="0.1" data-number-answer aria-label="Your answer"><button type="button" data-check-number>Check answer</button></div><p class="feedback" data-feedback></p><button type="button" class="next" data-next disabled>Next round →</button></section>
  <div class="complete" data-complete hidden><p class="eyebrow">MISSION COMPLETE</p><h3 data-complete-title></h3><p data-complete-text></p><button type="button" data-restart>Play again with new challenges</button></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-unit6-game]').forEach(game=>{
  const variant=game.dataset.variant||'expressions';
  const banks:any={
   expressions:[
    [{tag:'ROUND 1 · LIKE-TERM LOCK',q:'Which term can combine with 7x?',choices:['−3x','4y','x²'],a:0,e:'−3x has the same variable part x.'},{tag:'ROUND 1 · LIKE-TERM LOCK',q:'Which pair are like terms?',choices:['5m and −2m','3x and 3y','x and x²'],a:0,e:'5m and −2m both use the same variable part m.'},{tag:'ROUND 1 · LIKE-TERM LOCK',q:'Which term is like the constant −8?',choices:['12','8x','−8y'],a:0,e:'All constant terms are like terms.'}],
    [{tag:'ROUND 2 · SIMPLIFY CODE',q:'Simplify 4x + 3x − 2.',choices:['7x − 2','7x','5x − 2'],a:0,e:'4x + 3x = 7x; the constant −2 stays separate.'},{tag:'ROUND 2 · SIMPLIFY CODE',q:'Simplify 6y − 2y + 5.',choices:['4y + 5','8y + 5','4y'],a:0,e:'6y − 2y = 4y, then keep +5.'},{tag:'ROUND 2 · SIMPLIFY CODE',q:'Simplify 2(x + 3) + x.',choices:['3x + 6','3x + 3','2x + 6'],a:0,e:'Distribute first: 2x + 6 + x = 3x + 6.'}],
    [{tag:'ROUND 3 · VALUE VAULT',q:'If x = 3, what is the value of 2x + 4x + 1?',numeric:19,e:'2x + 4x = 6x. Then 6(3)+1 = 19.'},{tag:'ROUND 3 · VALUE VAULT',q:'If m = 4, what is the value of 3m − m + 5?',numeric:13,e:'3m − m = 2m. Then 2(4)+5 = 13.'},{tag:'ROUND 3 · VALUE VAULT',q:'If a = −2, what is the value of 5a + 2a − 1?',numeric:-15,e:'5a + 2a = 7a. Then 7(−2)−1 = −15.'}]
   ],
   models:[
    [{tag:'ROUND 1 · KEEP IT BALANCED',q:'For x + 5 = 12, which move is legal?',choices:['Subtract 5 from both sides','Subtract 5 only from the left','Add 5 only to the right'],a:0,e:'The same subtraction on both sides preserves equality.'},{tag:'ROUND 1 · KEEP IT BALANCED',q:'For 3x = 18, which move isolates one x?',choices:['Divide both sides by 3','Divide only the left by 3','Subtract 3 from both sides'],a:0,e:'Equal sharing on both sides gives x = 6.'},{tag:'ROUND 1 · KEEP IT BALANCED',q:'For n − 4 = 7, which move creates a zero pair?',choices:['Add 4 to both sides','Subtract 4 from both sides','Add 4 only to the left'],a:0,e:'Adding 4 to both sides removes −4 while preserving equality.'}],
    [{tag:'ROUND 2 · FIND THE VARIABLE',q:'Solve 2x + 3 = 13.',numeric:5,e:'Subtract 3 from both sides, then divide 10 by 2.'},{tag:'ROUND 2 · FIND THE VARIABLE',q:'Solve 3n − 1 = 14.',numeric:5,e:'Add 1 to both sides to get 3n = 15, then divide by 3.'},{tag:'ROUND 2 · FIND THE VARIABLE',q:'Solve p + 7 = 2.',numeric:-5,e:'Subtract 7 from both sides: p = −5.'}],
    [{tag:'ROUND 3 · STORY BALANCE',q:'Three equal hourly wages total $45. What is the hourly wage?',numeric:15,e:'3w = 45, so equal sharing gives w = 15.'},{tag:'ROUND 3 · STORY BALANCE',q:'A temperature rises 4°C and ends at −3°C. What was the starting temperature?',numeric:-7,e:'t + 4 = −3, so subtract 4 from both sides.'},{tag:'ROUND 3 · STORY BALANCE',q:'Two equal boxes plus 6 loose items total 20. How many items are in each box?',numeric:7,e:'2b + 6 = 20 → 2b = 14 → b = 7.'}]
   ],
   algebraic:[
    [{tag:'ROUND 1 · INVERSE MOVE',q:'Solve 3x − 6 = 12.',numeric:6,e:'Add 6 to both sides, then divide 18 by 3.'},{tag:'ROUND 1 · INVERSE MOVE',q:'Solve 2x + 5 = 17.',numeric:6,e:'Subtract 5 from both sides, then divide 12 by 2.'},{tag:'ROUND 1 · INVERSE MOVE',q:'Solve 4x = −20.',numeric:-5,e:'Divide both sides by 4.'}],
    [{tag:'ROUND 2 · VERIFY THE KEY',q:'Does x = 4 solve 2x + 3 = 11?',choices:['Yes','No'],a:0,e:'2(4)+3 = 11, so LHS = RHS.'},{tag:'ROUND 2 · VERIFY THE KEY',q:'Does x = 3 solve 2x + 5 = 12?',choices:['Yes','No'],a:1,e:'2(3)+5 = 11, so LHS ≠ RHS.'},{tag:'ROUND 2 · VERIFY THE KEY',q:'Does x = −4 solve x − 1 = −5?',choices:['Yes','No'],a:0,e:'−4 − 1 = −5, so the equation is true.'}],
    [{tag:'ROUND 3 · WORD-PROBLEM DOOR',q:'Five times the sum of a number and 7 is 60. What is the number?',numeric:5,e:'5(n+7)=60 → n+7=12 → n=5.'},{tag:'ROUND 3 · WORD-PROBLEM DOOR',q:'Subtract 1.8 from a number to get 2.6. What is the number?',numeric:4.4,e:'n−1.8=2.6 → n=4.4.'},{tag:'ROUND 3 · WORD-PROBLEM DOOR',q:'A rectangle problem simplifies to 4n + 30 = 94. What is n?',numeric:16,e:'4n=64, so n=16.'}]
   ]
  };
  const titles:any={expressions:['Break the expression code','Use like terms and equivalence to clear three locks.','🏆 Expression Decoder','You identified, simplified, and evaluated algebraic expressions.'],models:['Save the balance','Keep equality true while you isolate the unknown.','🏆 Balance Keeper','You used legal balance moves, zero pairs, and equal sharing.'],algebraic:['Escape with algebra','Solve, verify, and translate equations to clear three doors.','🏆 Equation Navigator','You used inverse operations and verification to solve efficiently.']};
  const title=game.querySelector('[data-game-title]');const sub=game.querySelector('[data-game-subtitle]');const roundLabel=game.querySelector('[data-round-label]');const progress=game.querySelector<HTMLElement>('[data-progress]');const tag=game.querySelector('[data-round-tag]');const prompt=game.querySelector('[data-prompt]');const choices=game.querySelector<HTMLElement>('[data-choices]');const answerRow=game.querySelector<HTMLElement>('[data-answer-row]');const numberAnswer=game.querySelector<HTMLInputElement>('[data-number-answer]');const checkNumber=game.querySelector<HTMLButtonElement>('[data-check-number]');const feedback=game.querySelector<HTMLElement>('[data-feedback]');const next=game.querySelector<HTMLButtonElement>('[data-next]');const complete=game.querySelector<HTMLElement>('[data-complete]');let round=0;let selected:any[]=[];let locked=false;
  if(title)title.textContent=titles[variant][0];if(sub)sub.textContent=titles[variant][1];game.querySelector('[data-complete-title]')!.textContent=titles[variant][2];game.querySelector('[data-complete-text]')!.textContent=titles[variant][3];
  const choose=()=>{selected=banks[variant].map((bank:any[])=>bank[Math.floor(Math.random()*bank.length)]);};
  const render=()=>{if(round>=3){game.querySelector<HTMLElement>('.round')!.hidden=true;if(complete)complete.hidden=false;if(roundLabel)roundLabel.textContent='3 rounds complete';if(progress)progress.style.width='100%';return;}const t=selected[round];locked=false;if(tag)tag.textContent=t.tag;if(prompt)prompt.textContent=t.q;if(feedback)feedback.textContent='Make a prediction before you answer.';if(next){next.disabled=true;next.textContent=round===2?'See results →':'Next round →';}if(progress)progress.style.width=`${round/3*100}%`;if(roundLabel)roundLabel.textContent=`Round ${round+1} of 3`;if(choices)choices.innerHTML='';if(numberAnswer)numberAnswer.value='';if(t.choices){if(answerRow)answerRow.hidden=true;if(choices){choices.hidden=false;choices.innerHTML=t.choices.map((c:string,i:number)=>`<button type="button" data-game-choice="${i}">${c}</button>`).join('');choices.querySelectorAll<HTMLButtonElement>('[data-game-choice]').forEach(b=>b.addEventListener('click',()=>respond(Number(b.dataset.gameChoice)===t.a,t.e)));}}else{if(choices)choices.hidden=true;if(answerRow)answerRow.hidden=false;}};
  const respond=(ok:boolean,explain:string)=>{if(locked)return;if(ok){locked=true;if(feedback)feedback.innerHTML=`<strong>Correct.</strong> ${explain}`;if(next)next.disabled=false;if(choices)choices.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=true);if(checkNumber)checkNumber.disabled=true;}else if(feedback)feedback.innerHTML='<strong>Not yet.</strong> Recheck the algebra and try again.';};
  checkNumber?.addEventListener('click',()=>{const t=selected[round];if(numberAnswer?.value!=='')respond(Math.abs(Number(numberAnswer.value)-t.numeric)<.011,t.e);});next?.addEventListener('click',()=>{round++;if(checkNumber)checkNumber.disabled=false;render();});game.querySelector('[data-restart]')?.addEventListener('click',()=>{round=0;choose();if(complete)complete.hidden=true;game.querySelector<HTMLElement>('.round')!.hidden=false;if(checkNumber)checkNumber.disabled=false;render();});choose();render();
 });
</script>
<style>.game{border:1px solid #d9e2ec;border-radius:18px;background:#fff;padding:1rem}.game-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.game-head h3{margin:.2rem 0}.meter{min-width:170px;display:grid;gap:.35rem;font-size:.78rem;font-weight:900}.meter>span{height:9px;background:#e8edf3;border-radius:999px;overflow:hidden}.meter i{display:block;height:100%;background:var(--course);transition:width .25s}.round{margin-top:1rem;padding:1rem;border-radius:14px;background:#f8fafc}.round-tag{font-size:.72rem;font-weight:900;letter-spacing:.06em;color:#64748b}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.choices button,.answer-row button,.complete button,.next{border:0;border-radius:11px;padding:.75rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.answer-row{display:flex;gap:.6rem}.answer-row input{flex:1;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.feedback{min-height:26px;padding:.6rem 0}.next:disabled{opacity:.4;cursor:not-allowed}.complete{text-align:center;padding:1.4rem}.complete h3{font-size:1.5rem}@media(max-width:650px){.game-head,.choices,.answer-row{display:grid}}</style>