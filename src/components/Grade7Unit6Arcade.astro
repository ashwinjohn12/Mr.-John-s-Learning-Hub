---
const stages=[
 {title:'1 · Decode the admission rule',equation:'3x+6=30',solution:'8',lhs:'30',method:'systematic trial then substitution',unit:'dollars per activity'},
 {title:'2 · Rebalance the supply crates',equation:'4x+8=40',solution:'8',lhs:'40',method:'remove 8 from both pans, then share by 4',unit:'kilograms per crate'},
 {title:'3 · Repair the freezer reading',equation:'x+7=-4',solution:'-11',lhs:'-4',method:'add seven negative tiles to both sides',unit:'degrees Celsius'},
 {title:'4 · Plan the shuttle passes',equation:'6x+12=54',solution:'7',lhs:'54',method:'subtract 12, then divide by 6',unit:'dollars per trip'},
 {title:'5 · Compare rescue strategies',equation:'5x-5=30',solution:'7',lhs:'30',method:'algebra and inspection agree after substitution',unit:'minutes per checkpoint'}
];
---
<div class="arcade" data-unit6-arcade data-stages={JSON.stringify(stages)}><header><p class="eyebrow">EQUATION RESCUE CONTROL ROOM</p><h3>Five-stage Math Arcade</h3><p>Restore five systems by matching each situation, equation, model, solution, and verification. Later stages depend on earlier verified evidence.</p></header><div data-stage-list>{stages.map((s,i)=><section data-stage={i} class={i?'locked':''} aria-disabled={i?'true':'false'}><h4>{s.title}</h4><label>Equation<input data-equation disabled={i>0}/></label><label>Solution<input data-solution disabled={i>0}/></label><label>Substitution LHS<input data-lhs disabled={i>0}/></label><label>Substitution RHS<input data-rhs disabled={i>0}/></label><label>Model or method<select data-method disabled={i>0}><option value="">Choose</option><option>{s.method}</option><option>change only the variable side</option></select></label><label>Variable unit<input data-unit disabled={i>0}/></label><label>Evidence for review<textarea data-evidence rows="2" disabled={i>0}></textarea></label><button type="button" data-check disabled={i>0}>Verify stage</button><p data-status role="status">{i?'Complete the previous stage first.':'Ready.'}</p></section>)}</div><section class="final locked" data-final aria-disabled="true"><h4>Final synthesis · Issue the rescue plan</h4><label>List the five solutions in order<input data-final-value/></label><label>Verified model chain<select data-final-model><option value="">Choose</option><option>trial → balance → integer tiles → algebra → strategy comparison</option><option>five unrelated decorative equations</option></select></label><label>Final evidence and decision<textarea data-plan rows="4"></textarea></label><button type="button" data-final-check>Verify the complete rescue</button><p data-final-status role="status" tabindex="-1">Verify all five stages first.</p></section></div>
<script>document.querySelectorAll<HTMLElement>('[data-unit6-arcade]').forEach(root=>{const stages=JSON.parse(root.dataset.stages||'[]'),sections=[...root.querySelectorAll<HTMLElement>('[data-stage]')],verified=new Set<number>(),norm=(s:string)=>s.toLowerCase().trim().replace(/\\s/g,'').replace(/−/g,'-').replace(/\\*/g,''),unlock=(i:number)=>{const s=sections[i];if(!s)return;s.classList.remove('locked');s.setAttribute('aria-disabled','false');s.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|HTMLButtonElement>('input,select,textarea,button').forEach(x=>x.disabled=false);s.querySelector<HTMLElement>('[data-status]')!.textContent='Ready.'},invalidate=(i:number)=>{for(let j=i;j<sections.length;j++){verified.delete(j);if(j>i){sections[j].classList.add('locked');sections[j].setAttribute('aria-disabled','true');sections[j].querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|HTMLButtonElement>('input,select,textarea,button').forEach(x=>x.disabled=true)}sections[j].querySelector<HTMLElement>('[data-status]')!.textContent=j===i?'Evidence changed. Verify again.':'Earlier stage changed. Complete dependencies again.'}const f=root.querySelector<HTMLElement>('[data-final]')!;f.classList.add('locked');f.setAttribute('aria-disabled','true');root.querySelector<HTMLElement>('[data-final-status]')!.textContent='Verify all five stages first.'};
sections.forEach((s,i)=>{s.querySelectorAll('input,select,textarea').forEach(x=>{x.addEventListener('input',()=>{if([...verified].some(j=>j>=i))invalidate(i)});x.addEventListener('change',()=>{if([...verified].some(j=>j>=i))invalidate(i)})});s.querySelector('[data-check]')?.addEventListener('click',()=>{const d=stages[i],eq=norm(s.querySelector<HTMLInputElement>('[data-equation]')!.value),solution=norm(s.querySelector<HTMLInputElement>('[data-solution]')!.value),lhs=norm(s.querySelector<HTMLInputElement>('[data-lhs]')!.value),rhs=norm(s.querySelector<HTMLInputElement>('[data-rhs]')!.value),method=s.querySelector<HTMLSelectElement>('[data-method]')!.value,unit=s.querySelector<HTMLInputElement>('[data-unit]')!.value.trim(),evidence=s.querySelector<HTMLTextAreaElement>('[data-evidence]')!.value.trim(),status=s.querySelector<HTMLElement>('[data-status]')!,ok=eq===norm(d.equation)&&solution===norm(d.solution)&&lhs===d.lhs&&rhs===d.lhs&&method===d.method&&unit===d.unit&&!!evidence;if(!ok){status.textContent=!evidence?'Record evidence for review; wording is not graded.':'Equation, model, solution, both substitution sides, and unit must all match.';return}verified.add(i);status.textContent='Stage verified. Every representation agrees.';unlock(i+1);if(verified.size===stages.length){const f=root.querySelector<HTMLElement>('[data-final]')!;f.classList.remove('locked');f.setAttribute('aria-disabled','false');root.querySelector<HTMLElement>('[data-final-status]')!.textContent='All stages verified. Complete the synthesis.'}})});
root.querySelector('[data-final-check]')?.addEventListener('click',()=>{const out=root.querySelector<HTMLElement>('[data-final-status]')!,values=norm(root.querySelector<HTMLInputElement>('[data-final-value]')!.value),model=root.querySelector<HTMLSelectElement>('[data-final-model]')!.value,plan=root.querySelector<HTMLTextAreaElement>('[data-plan]')!.value.trim(),ok=verified.size===5&&values==='8,8,-11,7,7'&&model==='trial → balance → integer tiles → algebra → strategy comparison'&&!!plan;out.textContent=ok?'Five stages verified. Equation Rescue complete.':'Recheck the ordered solutions, dependent model chain, and recorded decision.';out.focus()})});</script>
<style>.arcade{overflow:hidden;border-radius:18px;background:#101d38;color:#fff}.arcade header{padding:1.2rem;background:#173867}.arcade [data-stage-list]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;padding:1rem}.arcade section{padding:1rem;border:1px solid #42638b;border-radius:12px;background:#172b4b}.arcade label{display:grid;gap:.25rem;margin:.45rem 0}.arcade input,.arcade select,.arcade textarea{box-sizing:border-box;width:100%;min-height:44px;padding:.6rem;font:inherit}.arcade button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#5de1bd;color:#0b2630;font-weight:850}.arcade .locked{opacity:.55}.final{margin:0 1rem 1rem}.arcade :focus-visible{outline:3px solid #ffd75e;outline-offset:2px}@media(max-width:700px){.arcade [data-stage-list]{grid-template-columns:1fr}}@media(max-width:390px){.arcade [data-stage-list],.final{padding:.7rem;margin:.7rem;overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){.arcade *{animation:none!important;transition:none!important}}</style>
