<div class="travel-widget transport-tradeoff" data-transport-tradeoff>
  <div class="travel-widget-heading">
    <div>
      <p class="mars-kicker">TRADE-OFF REVIEW</p>
      <h4>Change the priorities. Then make your own transport decision.</h4>
    </div>
    <span class="model-disclaimer">SIMPLIFIED CLASSROOM COMPARISON</span>
  </div>

  <div class="transport-priorities">
    <label>Travel time
      <select data-priority="Travel time"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
    <label>Payload
      <select data-priority="Payload"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
    <label>Propellant/resources
      <select data-priority="Propellant/resources"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
    <label>Technology readiness
      <select data-priority="Technology readiness"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
    <label>System complexity
      <select data-priority="System complexity"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
    <label>Crew safety
      <select data-priority="Crew safety"><option>Lower</option><option selected>Important</option><option>Critical</option></select>
    </label>
  </div>

  <div class="priority-summary" aria-live="polite" data-priority-summary>
    No single option wins automatically. Compare the evidence after you set your priorities.
  </div>

  <div class="transport-cards">
    <article>
      <p class="case-label">APPROACH A</p>
      <h5>All-chemical</h5>
      <dl>
        <div><dt>Strengths</dt><dd>High thrust; chemical propulsion has extensive demonstrated mission heritage and can handle major high-thrust manoeuvres.</dd></div>
        <div><dt>Trade-offs</dt><dd>Large propellant needs compete with useful payload mass. High thrust can support faster manoeuvres than low-thrust electric propulsion, but a human Mars trip would still be a long, complex crew-safety challenge.</dd></div>
        <div><dt>Technology evidence</dt><dd>Chemical propulsion is demonstrated in spaceflight, but an integrated human Mars transport architecture using it is not demonstrated.</dd></div>
      </dl>
    </article>
    <article>
      <p class="case-label">APPROACH B</p>
      <h5>Nuclear thermal</h5>
      <dl>
        <div><dt>Strengths</dt><dd>High thrust with potential Mars-transport performance benefits. Some proposed architectures could reduce transit time and/or propellant demands compared with all-chemical transport, which may leave more mass available for useful payload.</dd></div>
        <div><dt>Trade-offs</dt><dd>Nuclear engineering, ground/flight testing, system integration, and crew-safety requirements add major complexity.</dd></div>
        <div><dt>Technology evidence</dt><dd>Nuclear thermal propulsion remains in development and testing; it has not been demonstrated as a human Mars transport system.</dd></div>
      </dl>
    </article>
    <article>
      <p class="case-label">APPROACH C</p>
      <h5>Hybrid electric + chemical</h5>
      <dl>
        <div><dt>Strengths</dt><dd>Electric propulsion has demonstrated robotic-spaceflight heritage and can move cargo efficiently over long periods; chemical propulsion can handle higher-thrust phases. Lower propellant demand in some mission segments can help preserve mass for payload.</dd></div>
        <div><dt>Trade-offs</dt><dd>Low electric-propulsion thrust can mean longer trip times, and combining propulsion systems increases complexity. Cargo and crew missions may therefore value this approach differently.</dd></div>
        <div><dt>Technology evidence</dt><dd>This is a simplified classroom category. Electric propulsion is demonstrated on robotic missions, but NASA studies multiple electric/chemical hybrid concepts and a human-Mars hybrid architecture remains under study/development.</dd></div>
      </dl>
    </article>
  </div>

  <fieldset class="transport-choice">
    <legend>Your current choice</legend>
    <label><input type="radio" name="transport-choice" value="All-chemical" /> All-chemical</label>
    <label><input type="radio" name="transport-choice" value="Nuclear thermal" /> Nuclear thermal</label>
    <label><input type="radio" name="transport-choice" value="Hybrid electric + chemical" /> Hybrid electric + chemical</label>
  </fieldset>

  <div class="tradeoff-prompts">
    <label>Biggest strength
      <input type="text" maxlength="120" data-strength placeholder="What evidence supports your choice?" />
    </label>
    <label>Most important concern
      <input type="text" maxlength="120" data-concern placeholder="What could make you change your mind?" />
    </label>
  </div>

  <div class="widget-actions">
    <button type="button" class="mars-action" data-save-transport>Save transport review</button>
    <p class="widget-feedback" data-transport-feedback aria-live="polite">The tool will not choose for you. Your explanation is the decision.</p>
  </div>
</div>

<script>
  const TRANSPORT_KEY = 'mrjohn-mars-transport-tradeoff-v1';

  document.querySelectorAll('[data-transport-tradeoff]').forEach((root) => {
    const prioritySelects = Array.from(root.querySelectorAll('[data-priority]'));
    const summary = root.querySelector('[data-priority-summary]');
    const strength = root.querySelector('[data-strength]');
    const concern = root.querySelector('[data-concern]');
    const feedback = root.querySelector('[data-transport-feedback]');

    const renderSummary = () => {
      const critical = prioritySelects.filter((select) => select.value === 'Critical').map((select) => select.dataset.priority);
      const important = prioritySelects.filter((select) => select.value === 'Important').map((select) => select.dataset.priority);

      if (critical.length) {
        summary.textContent = 'Your critical priorities are: ' + critical.join(', ') + '. Use those priorities to compare the strengths and concerns below.';
      } else if (important.length) {
        summary.textContent = 'You marked no factor Critical. Your Important priorities are: ' + important.join(', ') + '. That can be defensible if you explain the balance.';
      } else {
        summary.textContent = 'All priorities are set to Lower. Raise at least one priority so your decision has a clear mission focus.';
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(TRANSPORT_KEY) || '{}');
      if (saved.priorities) {
        prioritySelects.forEach((select) => {
          if (saved.priorities[select.dataset.priority]) select.value = saved.priorities[select.dataset.priority];
        });
      }
      if (saved.choice) {
        const input = root.querySelector('input[name="transport-choice"][value="' + saved.choice + '"]');
        if (input) input.checked = true;
      }
      if (saved.strength) strength.value = saved.strength;
      if (saved.concern) concern.value = saved.concern;
    } catch {}

    prioritySelects.forEach((select) => select.addEventListener('change', renderSummary));

    root.querySelector('[data-save-transport]').addEventListener('click', () => {
      const choice = root.querySelector('input[name="transport-choice"]:checked')?.value || '';
      if (!choice || !strength.value.trim() || !concern.value.trim()) {
        feedback.textContent = 'Choose an approach and record one strength and one concern before saving.';
        return;
      }

      const priorities = {};
      prioritySelects.forEach((select) => priorities[select.dataset.priority] = select.value);
      localStorage.setItem(TRANSPORT_KEY, JSON.stringify({
        priorities,
        choice,
        strength: strength.value.trim(),
        concern: concern.value.trim()
      }));
      feedback.textContent = 'Transport review saved on this device. There is still no automatic winner—your evidence supports the choice.';
    });

    renderSummary();
  });
</script>
