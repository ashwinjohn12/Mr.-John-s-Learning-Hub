---
import type{Unit1CheckQuestion}from'../data/grade7Unit1Completion';
interface Props{bank:Unit1CheckQuestion[]}
const{bank}=Astro.props;
---
<section class="unit-check" data-unit1-completion-check data-bank={JSON.stringify(bank)} aria-labelledby="unit1-check-title">
 <header class="check-head"><div><p class="mini-label">INDEPENDENT UNIT CHECK</p><h2 id="unit1-check-title">Fresh 12-question Unit 1 attempt</h2><p>Every attempt includes all four lessons and exactly 3 foundational, 6 core, and 3 reasoning questions. Correctness stays hidden until the full attempt is submitted.</p></div><div class="bank-badge"><strong>{bank.length}</strong><span>question bank</span></div></header>
 <div class="attempt-meta" aria-label="Attempt structure"><span>Lesson 1.1 × 3</span><span>Lesson 1.2 × 3</span><span>Lesson 1.3 × 3</span><span>Lesson 1.4 × 3</span><span>3 / 6 / 3 difficulty</span></div>
 <div data-items></div>
 <div class="actions"><button type="button" data-submit>Submit all 12</button><button type="button" class="secondary" data-new>Generate fresh attempt</button></div>
 <p class="result" data-result role="status" tabindex="-1">Attempt ready. Complete all 12 questions before submitting.</p>
 <div class="lesson-scores" data-scores hidden></div><div class="repair-routes" data-routes hidden></div>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-unit1-completion-check]').forEach(root=>{const source=JSON.parse(root.dataset.bank||'[]'),box=root.querySelector<HTMLElement>('[data-items]')!,result=root.querySelector<HTMLElement>('[data-result]')!;let attempt:any[]=[],generation=0;
 const esc=(s:any)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#039;'}[c]||c));
 const shuffle=(arr:any[])=>{const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const lessons=['1.1','1.2','1.3','1.4'],levelRows=[[1,2,2,3],[2,1,3,2],[3,2,1,2]];
 const visual=(v:any)=>{if(!v)return'';const px=(n:number)=>150+n*11,py=(n:number)=>150-n*11,grid=Array.from({length:21},(_,i)=>40+i*11).map(p=>`<line x1="${p}" y1="40" x2="${p}" y2="260"/><line x1="40" y1="${p}" x2="260" y2="${p}"/>`).join(''),segments=(v.segments||[]).map((s:any)=>{const a=v.points[s[0]],b=v.points[s[1]];return`<line class="route" x1="${px(a.x)}" y1="${py(a.y)}" x2="${px(b.x)}" y2="${py(b.y)}"/>`}).join(''),points=v.points.map((p:any,i:number)=>`<g transform="translate(${px(p.x)} ${py(p.y)})"><circle r="7"/><text x="10" y="-9">${esc(p.label||String.fromCharCode(65+i))}</text></g>`).join(''),label=`Coordinate plane showing ${v.points.map((p:any)=>`${p.label} at (${p.x}, ${p.y})`).join('; ')}.`;return`<svg class="mini-grid" viewBox="0 0 300 300" role="img" aria-label="${esc(label)}"><rect x="36" y="36" width="228" height="228" rx="10"/><g class="grid">${grid}</g><line class="axis" x1="40" y1="150" x2="260" y2="150"/><line class="axis" x1="150" y1="40" x2="150" y2="260"/>${segments}<g class="points">${points}</g></svg>`};
 const sample=()=>{const picked:any[]=[],used=new Set<string>(),shift=generation%4;for(let r=0;r<3;r++)for(let c=0;c<4;c++){const lesson=lessons[c],level=levelRows[r][(c+shift)%4],pool=source.filter((q:any)=>q.lesson===lesson&&q.level===level&&!used.has(q.id));if(!pool.length)throw new Error(`No Unit 1 check question for ${lesson} level ${level}`);const q=pool[Math.floor(Math.random()*pool.length)];used.add(q.id);picked.push(q)}generation++;const positions=shuffle([0,0,0,1,1,1,2,2,2,3,3,3]);attempt=shuffle(picked).map((q:any,i:number)=>{const wrong=[...new Set(q.distractors)].filter((x:any)=>x!==q.correct);if(wrong.length!==3)throw new Error(`${q.id} must have exactly three unique distractors`);const choices=shuffle(wrong);choices.splice(positions[i],0,q.correct);return{...q,choices,answer:positions[i]}})};
 const render=(focus=false)=>{sample();box.innerHTML=attempt.map((q:any,i:number)=>`<fieldset data-item data-answer="${q.answer}" data-lesson="${q.lesson}" data-level="${q.level}"><legend tabindex="-1"><span>${i+1}</span><em>${esc(q.prompt)}</em><small>Lesson ${q.lesson} · ${q.level===1?'Foundational':q.level===2?'Core':'Reasoning'}</small></legend>${visual(q.visual)}<div class="choices">${q.choices.map((c:string,j:number)=>`<label><input type="radio" name="unit1-check-${generation}-${i}" value="${j}"><b>${'ABCD'[j]}</b><span>${esc(c)}</span></label>`).join('')}</div><p data-feedback hidden></p></fieldset>`).join('');result.textContent='Fresh attempt ready. Complete all 12 questions before submitting.';for(const el of[root.querySelector<HTMLElement>('[data-scores]')!,root.querySelector<HTMLElement>('[data-routes]')!]){el.hidden=true;el.innerHTML=''}if(focus)root.querySelector<HTMLElement>('legend')?.focus()};
 root.querySelector('[data-new]')?.addEventListener('click',()=>render(true));root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...box.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){result.textContent='Answer all 12 questions before submitting. No correctness has been revealed.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;const by:Record<string,{r:number;t:number}>=Object.fromEntries(lessons.map(x=>[x,{r:0,t:0}])),missed:any[]=[];items.forEach((item,i)=>{const selected=Number(item.querySelector<HTMLInputElement>('input:checked')!.value),q=attempt[i],ok=selected===Number(item.dataset.answer);by[q.lesson].t++;if(ok){score++;by[q.lesson].r++}else missed.push(q);item.classList.add(ok?'correct':'incorrect');item.querySelectorAll<HTMLInputElement>('input').forEach(x=>x.disabled=true);const feedback=item.querySelector<HTMLElement>('[data-feedback]')!;feedback.hidden=false;feedback.innerHTML=`<strong>${ok?'Correct.':'Review.'}</strong> ${esc(q.feedback)}${ok?'':` <span>Correct response: ${esc(q.choices[q.answer])}.</span>`}`});const pct=Math.round(score/items.length*100);result.innerHTML=`<strong>${pct}% · ${score}/12</strong> ${pct>=90?'Ready for transfer to the Math Arcade.':pct>=70?'Close: repair the weakest lesson, then generate a fresh attempt.':pct>=50?'Repair the lowest lesson score before retrying.':'Return to the Unit Review stations before another attempt.'}`;const scores=root.querySelector<HTMLElement>('[data-scores]')!;scores.hidden=false;scores.innerHTML=`<strong>Lesson evidence</strong><div>${lessons.map(l=>`<span><b>Lesson ${l}</b> ${Math.round(by[l].r/by[l].t*100)}% (${by[l].r}/${by[l].t})</span>`).join('')}</div>`;const routes=root.querySelector<HTMLElement>('[data-routes]')!;if(missed.length){const unique=[...new Map(missed.map(q=>[q.lesson,q])).values()].sort((a:any,b:any)=>by[a.lesson].r/by[a.lesson].t-by[b.lesson].r/by[b.lesson].t);routes.hidden=false;routes.innerHTML=`<strong>Repair routes, weakest lesson first:</strong>${unique.map((q:any)=>`<a href="${esc(q.route)}">Lesson ${q.lesson} · ${esc(q.family)}</a>`).join('')}`}result.focus({preventScroll:true});result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'})});render();
});
</script>
<style>
.unit-check{display:grid;gap:1rem}.check-head{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:start}.check-head h2{margin:.15rem 0}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.bank-badge{display:grid;place-items:center;min-width:96px;padding:.7rem;border-radius:14px;background:#eef6ff;color:#174ea6}.bank-badge strong{font-size:1.9rem}.bank-badge span{font-size:.75rem;font-weight:850}.attempt-meta{display:flex;gap:.45rem;flex-wrap:wrap}.attempt-meta span{padding:.4rem .55rem;border-radius:999px;background:#eef5ff;font-size:.82rem;font-weight:800;color:#344b68}.unit-check fieldset{min-width:0;margin:.8rem 0;padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}.unit-check fieldset.correct{border-left:6px solid #2b6e3f}.unit-check fieldset.incorrect{border-left:6px solid #a44820}.unit-check legend{display:grid;grid-template-columns:30px minmax(0,1fr);gap:.55rem;width:100%;font-weight:850;line-height:1.45}.unit-check legend>span{grid-row:1/3;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#2457c5;color:#fff}.unit-check legend em{font-style:normal;overflow-wrap:anywhere}.unit-check legend small{color:#66768a;font-weight:700}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:.75rem}.choices label{display:grid;grid-template-columns:auto auto minmax(0,1fr);gap:.5rem;align-items:center;min-height:48px;padding:.6rem;border:1px solid #d9e2ec;border-radius:10px}.choices label:focus-within{outline:3px solid #ffbf47;outline-offset:2px}.choices b{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#eef3fb;color:#2457c5}.mini-grid{display:block;width:min(300px,100%);margin:.75rem auto}.mini-grid rect{fill:#f8fbff;stroke:#b9c8da;stroke-width:2}.mini-grid .grid{stroke:#e0e8f2;stroke-width:1}.mini-grid .axis{stroke:#1d3557;stroke-width:3}.mini-grid .route{stroke:#b76e00;stroke-width:4;stroke-dasharray:7 5}.mini-grid .points circle{fill:#ffedb0;stroke:#b76e00;stroke-width:3}.mini-grid text{fill:#16365f;font:800 14px system-ui}.actions{display:flex;gap:.65rem;flex-wrap:wrap}.actions button{min-height:44px;border:0;border-radius:9px;padding:.65rem .9rem;background:#2457c5;color:#fff;font-weight:850}.actions .secondary{background:#fff;color:#2457c5;border:1px solid #2457c5}.result,[data-feedback],.lesson-scores,.repair-routes{padding:.75rem;border-radius:10px;background:#eef6ff}.lesson-scores div{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem}.lesson-scores span{padding:.45rem .55rem;background:#fff;border-radius:8px}.repair-routes a{display:block;margin:.4rem 0;padding:.45rem .55rem;border-radius:7px;background:#fff;color:#174ea6;font-weight:800}.unit-check :focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:650px){.check-head{grid-template-columns:1fr}.bank-badge{justify-self:start}.choices{grid-template-columns:1fr}}@media(max-width:390px){.unit-check fieldset{padding:.75rem}.choices label{overflow-wrap:anywhere}}@media(max-width:320px){.unit-check fieldset{padding:.6rem}.attempt-meta{gap:.3rem}}@media(prefers-reduced-motion:reduce){.unit-check *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
