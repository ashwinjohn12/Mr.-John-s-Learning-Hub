---
const stages=[
 {title:'1 · Lay out the circular pool',prompt:'The main pool has radius 8 m. Find diameter and circumference to the nearest tenth.',fields:[['Diameter','16'],['Circumference','50.3']],model:'compass circle and circumference wrap',modelValues:[['Radius','8'],['Diameter','16'],['Circumference','50.3']],estimate:[48,52],unit:'m'},
 {title:'2 · Plan the deck zones',prompt:'A parallelogram deck is 14 m by a perpendicular height of 6 m. A triangular shade zone uses base 10 m and height 6 m.',fields:[['Parallelogram area','84'],['Triangle area','30']],model:'cut-and-slide and triangle-pair model',modelValues:[['Parallelogram base and height','14, 6'],['Triangle base and height','10, 6'],['Combined area','114']],estimate:[110,118],unit:'m²'},
 {title:'3 · Surface the splash circle',prompt:'A circular splash zone has radius 5 m. Find its area and the remaining area from a 120 m² surface budget.',fields:[['Circle area','78.5'],['Remaining surface','41.5']],model:'sector rearrangement',modelValues:[['Radius','5'],['Circle area','78.5'],['Surface budget and remainder','120, 41.5']],estimate:[75,82],unit:'m²'},
 {title:'4 · Interpret visitor choices',prompt:'A survey of 200 visitors gives 35% to slides. Find the count and sector angle.',fields:[['Slide visitors','70'],['Slide angle','126']],model:'labelled proportional sector',modelValues:[['Percent and total','35, 200'],['Count','70'],['Central angle','126']],estimate:[65,75],unit:'visitors and degrees'},
 {title:'5 · Draw the allocation graph',prompt:'Space allocation is pool 40%, deck 30%, splash zone 20%, and paths 10%. Find the pool and path angles.',fields:[['Pool angle','144'],['Path angle','36']],model:'four-sector circle graph',modelValues:[['Percents','40, 30, 20, 10'],['Angles','144, 108, 72, 36'],['Whole totals','100, 360']],estimate:[175,185],unit:'degrees'}
];
---
<div class="arcade" data-unit4-arcade><header><p class="eyebrow">FIVE-STAGE MATH ARCADE</p><h3>Water Park Designer</h3><p>Build a connected water-park plan. Every calculation, model, unit, and decision is independently checked; written reasoning is saved as review evidence.</p></header><div class="arcade-progress" role="status" data-progress>Stage 1 of 5 ready.</div>{stages.map((s,i)=><section data-stage={i} data-model={s.model} data-estimate-min={s.estimate[0]} data-estimate-max={s.estimate[1]} hidden={i!==0}><h4 tabindex="-1">{s.title}</h4><p>{s.prompt}</p><label>Checkable estimate<input data-predict inputmode="decimal"/></label><label>Required unit<input data-unit data-answer={s.unit}/></label><div class="fields">{s.fields.map(f=><label>{f[0]}<input data-value data-answer={f[1]} inputmode="decimal"/></label>)}</div><fieldset><legend>Build {s.model}</legend>{s.modelValues.map((v,i)=><label>{v[0]}<input data-model-value={i} data-answer={v[1]} inputmode={v[1].includes(',')?'text':'decimal'}/></label>)}<button type="button" data-build>Build model</button><div data-display role="img" aria-label="Model not built."></div><p data-transcript>Model transcript: not built.</p></fieldset><label>Reasoning evidence<textarea data-evidence rows="3"></textarea></label><button type="button" data-verify>Verify and continue</button><p data-status role="status">Not verified.</p></section>)}
<div class="final" data-final hidden><h4 tabindex="-1">Final verified water-park plan</h4><p>Carry the verified measurements into one synthesis. Changing an earlier dependency invalidates this final state.</p><div class="final-grid">{[['Pool circumference','50.3'],['Combined deck-zone area','114'],['Splash-zone area','78.5'],['Remaining surface','41.5'],['Slide visitors','70'],['Pool sector angle','144']].map(f=><label>{f[0]}<input data-final-value data-answer={f[1]} inputmode="decimal"/></label>)}</div><label>Final model relationship<select data-final-model><option value="">Choose</option><option value="connected">Circle measures, area models, and circle graph all match the verified plan</option><option value="decorative">Use an unlabelled decorative sketch</option></select></label><label>Supported decision<select data-plan><option value="">Choose</option><option value="approve">Approve the plan with 41.5 m² remaining and a complete 360° allocation</option><option value="ignore">Ignore the remaining area and angle total</option></select></label><label>Final evidence and decision<textarea data-final-evidence rows="4"></textarea></label><button type="button" data-finish>Complete mission</button><p data-final-status role="status" tabindex="-1">Complete the verified synthesis.</p></div></div>
<script>
const expectedUnits=['m','m²','m²','visitors and degrees','degrees'];
document.querySelectorAll<HTMLElement>('[data-unit4-arcade]').forEach(root=>{const stages=[...root.querySelectorAll<HTMLElement>('[data-stage]')],done=new Set<number>(),modelBuilt=new Set<number>(),progress=root.querySelector<HTMLElement>('[data-progress]'),final=root.querySelector<HTMLElement>('[data-final]'),number=(x:string)=>Number(x.trim().replace(/[$,%]/g,'')),close=(a:string,b:string)=>Number.isFinite(number(a))&&Math.abs(number(a)-number(b))<.051,listEqual=(a:string,b:string)=>{const av=a.split(',').map(number),bv=b.split(',').map(number);return av.length===bv.length&&av.every((x,i)=>Number.isFinite(x)&&Math.abs(x-bv[i])<.051)};
 const invalidate=(i:number)=>{for(let j=i;j<stages.length;j++){done.delete(j);modelBuilt.delete(j);stages[j].hidden=j!==i;const s=stages[j].querySelector<HTMLElement>('[data-status]');if(s)s.textContent=j===i?'Earlier evidence changed. Rebuild and verify this stage.':'Locked until the earlier stage is verified again.'}if(final)final.hidden=true;root.dataset.complete='false';if(progress)progress.textContent=`Evidence changed. Stage ${i+1} must be verified again.`};
 stages.forEach((stage,i)=>{stage.querySelectorAll('input,select,textarea').forEach(c=>{c.addEventListener('input',()=>{if(done.has(i)||modelBuilt.has(i))invalidate(i)});c.addEventListener('change',()=>{if(done.has(i)||modelBuilt.has(i))invalidate(i)})});stage.querySelector('[data-build]')?.addEventListener('click',()=>{const fields=[...stage.querySelectorAll<HTMLInputElement>('[data-model-value]')],valid=fields.length>=3&&fields.every(f=>(f.dataset.answer||'').includes(',')?listEqual(f.value,f.dataset.answer||''):close(f.value,f.dataset.answer||'')),display=stage.querySelector<HTMLElement>('[data-display]'),transcript=stage.querySelector<HTMLElement>('[data-transcript]');if(!valid){stage.querySelector<HTMLElement>('[data-status]')!.textContent='Every labelled model quantity and relationship must match this stage.';return}modelBuilt.add(i);const values=fields.map(f=>`${f.closest('label')?.childNodes[0]?.textContent?.trim()}: ${f.value}`),text=`${stage.dataset.model} with ${values.join('; ')}.`;if(display){display.innerHTML=`<strong>${stage.dataset.model}</strong><span class="stage-${i+1}" aria-hidden="true"></span><b>${values.join(' · ')}</b>`;display.setAttribute('aria-label',text)}if(transcript)transcript.textContent=`Model transcript: ${text}`});stage.querySelector('[data-verify]')?.addEventListener('click',()=>{const values=[...stage.querySelectorAll<HTMLInputElement>('[data-value]')],prediction=Number(stage.querySelector<HTMLInputElement>('[data-predict]')?.value),evidence=stage.querySelector<HTMLTextAreaElement>('[data-evidence]')?.value.trim(),unit=stage.querySelector<HTMLInputElement>('[data-unit]')?.value.trim(),bad=values.find(x=>!close(x.value,x.dataset.answer||'')),estimateOk=Number.isFinite(prediction)&&prediction>=Number(stage.dataset.estimateMin)&&prediction<=Number(stage.dataset.estimateMax),status=stage.querySelector<HTMLElement>('[data-status]'),unitOk=unit.toLowerCase()===expectedUnits[i].toLowerCase(),ok=!bad&&estimateOk&&unitOk&&modelBuilt.has(i)&&!!evidence;if(!ok){if(status)status.innerHTML=bad?'<strong>Revise a calculation.</strong>':!estimateOk?'<strong>Revise the estimate.</strong>':!unitOk?'<strong>Use the exact required unit shown for this stage.</strong>':!modelBuilt.has(i)?'<strong>Build the required mathematical model.</strong>':'<strong>Record your reasoning evidence.</strong>';return}done.add(i);stage.hidden=true;if(i<4){stages[i+1].hidden=false;stages[i+1].querySelector<HTMLElement>('h4')?.focus();if(progress)progress.textContent=`Stage ${i+2} of 5 ready.`}else if(final){final.hidden=false;final.querySelector<HTMLElement>('h4')?.focus();if(progress)progress.textContent='All five stages verified. Complete the final synthesis.'}})});final?.querySelectorAll('input,select,textarea').forEach(c=>{c.addEventListener('input',()=>{root.dataset.complete='false';root.querySelector<HTMLElement>('[data-final-status]')!.textContent='Final evidence changed. Verify again.'});c.addEventListener('change',()=>{root.dataset.complete='false'})});root.querySelector('[data-finish]')?.addEventListener('click',()=>{const bad=[...root.querySelectorAll<HTMLInputElement>('[data-final-value]')].find(x=>!close(x.value,x.dataset.answer||'')),model=root.querySelector<HTMLSelectElement>('[data-final-model]')?.value,plan=root.querySelector<HTMLSelectElement>('[data-plan]')?.value,evidence=root.querySelector<HTMLTextAreaElement>('[data-final-evidence]')?.value.trim(),out=root.querySelector<HTMLElement>('[data-final-status]'),ok=done.size===5&&!bad&&model==='connected'&&plan==='approve'&&!!evidence;root.dataset.complete=String(ok);if(out)out.innerHTML=ok?'<strong>Mission complete.</strong> Every calculation, model, unit, total, and decision agrees.':'<strong>Not complete.</strong> Verify every carried value, connect the models, choose the supported plan, and record evidence.';out?.focus()})});
</script>
<style>.arcade{overflow:hidden;border-radius:17px;background:#12333d;color:#fff}.arcade header{padding:1.1rem;background:#15566a}.arcade section,.arcade .final{display:grid;gap:.7rem;padding:1rem}.arcade label{display:grid;gap:.35rem;font-weight:800}.arcade input,.arcade textarea,.arcade select{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #91abb5;font:inherit}.arcade button{min-height:44px;border:0;border-radius:8px;background:#f4c95d;color:#17243a;padding:.7rem;font-weight:900}.arcade-progress,.arcade [data-status],.arcade [data-final-status]{padding:.7rem 1rem;background:#ffffff12}.fields,.final-grid,.arcade fieldset{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.arcade fieldset{border:1px solid #ffffff55;border-radius:10px}.arcade fieldset [data-display],.arcade fieldset [data-transcript]{grid-column:1/-1}.arcade [data-display]{display:grid;gap:.35rem;padding:.65rem;background:#fff;color:#173142;border-radius:8px}.arcade [data-display] span{height:52px;border:2px solid #173142;background:repeating-linear-gradient(135deg,#2089a1 0 14px,#d8f1f6 14px 28px)}.arcade :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:620px){.fields,.final-grid,.arcade fieldset{grid-template-columns:1fr}.arcade fieldset [data-display],.arcade fieldset [data-transcript]{grid-column:1}}@media(max-width:390px){.arcade section,.arcade .final{padding:.75rem}}@media(prefers-reduced-motion:reduce){.arcade *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>
