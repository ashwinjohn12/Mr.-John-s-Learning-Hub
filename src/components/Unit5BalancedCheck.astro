---
import type { PracticeQuestion } from '../data/topicContent';
interface Group { label: string; questions: readonly PracticeQuestion[]; count: number }
interface Props { groups: Group[] }
const { groups } = Astro.props;
const total = groups.reduce((sum, group) => sum + group.count, 0);
---
<div class="check-widget" data-unit5-balanced-check data-count={total}>
  <div class="check-top">
    <div><p class="eyebrow">WHOLE-UNIT CHECK</p><h3>Balanced {total}-question check</h3><p>Every set includes the same number of questions from Lessons 5.1, 5.2, and 5.3.</p></div>
    <span data-check-score aria-live="polite">0 / {total}</span>
  </div>
  <div data-check-stage aria-live="polite"></div>
  <div class="check-actions"><button type="button" data-check-next disabled>Next</button><button type="button" data-check-restart>New balanced set</button></div>
  <script type="application/json" data-check-data set:html={JSON.stringify(groups)}></script>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-unit5-balanced-check]').forEach((widget) => {
    const groups = JSON.parse(widget.querySelector('[data-check-data]')?.textContent || '[]');
    const total = Number(widget.dataset.count || 9);
    const stage = widget.querySelector<HTMLElement>('[data-check-stage]');
    const scoreText = widget.querySelector('[data-check-score]');
    const nextBtn = widget.querySelector<HTMLButtonElement>('[data-check-next]');
    const restartBtn = widget.querySelector<HTMLButtonElement>('[data-check-restart]');
    let pool:any[] = []; let index = 0; let correct = 0; let answered = false;
    const shuffle = (items:any[]) => [...items].sort(() => Math.random() - .5);
    const buildPool = () => shuffle(groups.flatMap((group:any) => shuffle(group.questions).slice(0, Math.min(group.count, group.questions.length)).map((q:any) => ({...q, lessonLabel:group.label}))));
    const render = () => {
      if (index >= pool.length) {
        if (stage) stage.innerHTML = `<div class="check-finish"><p class="eyebrow">SET COMPLETE</p><h3>You scored ${correct} / ${pool.length}</h3><p>${correct === pool.length ? 'Excellent. You connected percent, equivalent ratios, and unit rates across the whole unit.' : correct >= Math.ceil(pool.length*.75) ? 'Strong work. Use the lesson label on anything you missed, review that idea, and try a new balanced set.' : 'Use the lesson map below the score to target the skills you missed, then try another balanced set.'}</p></div>`;
        if (nextBtn) nextBtn.disabled = true; return;
      }
      const q=pool[index]; answered=false; if(nextBtn) nextBtn.disabled=true;
      if(stage){stage.innerHTML=`<div class="question-meta"><span>Question ${index+1} of ${pool.length}</span><span>${q.lessonLabel}</span></div><h3>${q.prompt}</h3><div class="check-choices">${q.choices.map((c:string,i:number)=>`<button type="button" data-check-choice="${i}"><span>${String.fromCharCode(65+i)}</span>${c}</button>`).join('')}</div><div class="check-feedback" data-check-feedback></div>`;stage.querySelectorAll<HTMLButtonElement>('[data-check-choice]').forEach(b=>b.addEventListener('click',()=>answer(Number(b.dataset.checkChoice))));}
      if(scoreText)scoreText.textContent=`${correct} / ${pool.length}`;
    };
    const answer=(choice:number)=>{if(answered)return;answered=true;const q=pool[index];const ok=choice===q.answer;if(ok)correct++;stage?.querySelectorAll<HTMLButtonElement>('[data-check-choice]').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect')});const f=stage?.querySelector<HTMLElement>('[data-check-feedback]');if(f)f.innerHTML=`<strong>${ok?'Correct!':'Not quite.'}</strong> ${q.explain}`;if(scoreText)scoreText.textContent=`${correct} / ${pool.length}`;if(nextBtn)nextBtn.disabled=false;};
    const reset=()=>{pool=buildPool().slice(0,total);index=0;correct=0;render();};
    nextBtn?.addEventListener('click',()=>{index++;render();});restartBtn?.addEventListener('click',reset);reset();
  });
</script>
<style>.check-widget{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.15rem}.check-top{display:flex;justify-content:space-between;align-items:start;gap:1rem;border-bottom:1px solid #e8edf3;padding-bottom:.9rem}.check-top h3{margin:.2rem 0}.check-top p{margin:.25rem 0;color:#64748b}.check-top>span{font-size:1.15rem;font-weight:900;white-space:nowrap}.question-meta{display:flex;justify-content:space-between;gap:.8rem;margin:1rem 0 .2rem;color:#5f6f84;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.check-choices{display:grid;gap:.6rem;margin:1rem 0}.check-choices button{display:flex;gap:.7rem;align-items:center;text-align:left;border:1px solid #d9e1eb;border-radius:12px;background:#fff;padding:.75rem;cursor:pointer}.check-choices button span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#eef3f9;font-weight:800}.check-choices button.correct{border-color:#22c55e;background:#f0fdf4}.check-choices button.incorrect{border-color:#ef4444;background:#fef2f2}.check-feedback{min-height:28px;margin:.5rem 0}.check-actions{display:flex;gap:.7rem;margin-top:.8rem;flex-wrap:wrap}.check-actions button{border:0;border-radius:11px;padding:.7rem 1rem;font-weight:800;cursor:pointer;background:var(--course);color:#fff}.check-actions button:last-child{background:#eef3f9;color:#25364f}.check-actions button:disabled{opacity:.45;cursor:not-allowed}.check-finish{padding:1.2rem 0}@media(max-width:650px){.check-top,.question-meta{display:grid}.check-top>span{justify-self:start}}</style>