---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit4DecimalProductLab from './Unit4DecimalProductLab.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content } = Astro.props;
const base = import.meta.env.BASE_URL;
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const coreExamples = content.examples.slice(0,2);
const advancedExamples = content.examples.slice(2);
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} hookPrompt="Make a prediction first. You are not expected to know the exact answer yet." hookWidth="220px">

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{content.goals.map(goal=><li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <div class="student-path"><p class="mini-label">A GOOD WAY TO WORK THROUGH THIS LESSON</p><div class="path-steps"><div><strong>1 · Learn</strong><span>Big Ideas → Understand → Examples</span></div><div><strong>2 · Explore</strong><span>Vocabulary → Decimal Product Studio → area model</span></div><div><strong>3 · Show it</strong><span>Practise → Check Yourself → Apply → Review</span></div></div><p class="path-note"><strong>Working on your own?</strong> Stop after Explore if you need a break. Return to Practice when you are ready.</p></div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item=><li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
        <div class="three-step-rule"><div><span>1</span><strong>Estimate</strong><small>Give the exact answer a target range.</small></div><div><span>2</span><strong>Name the units</strong><small>Tenths? Hundredths? What does the decimal factor mean?</small></div><div><span>3</span><strong>Multiply & check</strong><small>Use partial products or the algorithm, then compare with the estimate.</small></div></div>
        <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,i)=><div><span class="concept-number">{String(i+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
        <article class="bridge-card"><p class="eyebrow">DECIMAL STANDARD CONNECTION</p><h3>4.4 matched place-value units. 4.5 multiplies those units.</h3><div class="bridge-grid"><div><strong>Lesson 4.4</strong><span>Add/subtract like units in aligned columns.</span><code>5.80 + 0.47</code></div><div><strong>Lesson 4.5</strong><span>Name the unit before multiplying.</span><code>4 × 21 tenths = 84 tenths</code></div></div><p class="model-note"><strong>Same habit:</strong> ask what each digit represents before using an algorithm.</p></article>
        <article class="meaning-card"><p class="eyebrow">VISUAL MODEL · PARTIAL PRODUCTS</p><h3>34 × 5.7 means every part multiplies every part</h3><div class="partial-visual"><span>30×5 = 150</span><span>30×0.7 = 21</span><span>4×5 = 20</span><span>4×0.7 = 2.8</span></div><p><strong>Add:</strong> 150 + 21 + 20 + 2.8 = 193.8.</p></article>
        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
        <p class="section-lead">Start with estimation and place-value units. Open the next examples when you are ready for area models, the standard algorithm, money, and multi-step reasoning.</p>
        <div class="example-stack">{coreExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
        {advancedExamples.length>0 && <details class="advanced-examples"><summary>Ready for the next level? Open Examples 3–6</summary><div class="example-stack advanced-stack">{advancedExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>}
      </LearningSection>

      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack"><div><h3>Decimal Product Studio</h3><p>Work from A to D: estimate, name units, build partial products, then explain the algorithm.</p><Unit4DecimalProductLab /></div></div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> Grid paper can help keep the four partial products organized. Estimate before you draw.</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={content.questions} /></LearningSection>
      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. There are no Practice hints here. Choose <strong>New set</strong> for another mix.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>
      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map(task=><li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map(item=><li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map(item=><label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>{content.next.status==='planned'?'Lesson 4.6 is coming soon. Use the checklist above to decide what you want to practise again first.':'Continue when you are ready.'}</small></div>{nextHref?<a class="button" href={nextHref}>Open →</a>:<span class="coming-next">Coming soon</span>}</div>
      </LearningSection>
 </Grade6LessonFrame>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft);line-height:1.55}.hook-card>div{display:grid;gap:.2rem}.hook-card small{display:block;max-width:220px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.student-path,.bridge-card,.meaning-card,.worked-example,.hands-on-card,.pat-card{margin-top:1rem;padding:1rem;border:1px solid #dfe5ee;border-radius:16px;background:#fff}.path-steps,.three-step-rule,.bridge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.bridge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.path-steps>div,.three-step-rule>div,.bridge-grid>div{display:grid;gap:.25rem;padding:.8rem;border-radius:12px;background:#f7f9fc}.three-step-rule{margin:1rem 0}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.path-note,.home-note{padding:.7rem;border-radius:10px;background:#fff8db}.remember,.model-note{padding:.65rem .75rem;border-radius:10px;background:#eef6ff}.bridge-grid code{margin-top:.35rem;padding:.5rem;border-radius:8px;background:#edf3fa;font:800 .95rem ui-monospace,monospace}.partial-visual{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:.8rem 0}.partial-visual span{padding:.7rem;border-radius:10px;background:#eef5ff;font-weight:850}.example-stack,.explore-stack{display:grid;gap:1rem}.worked-example ol,.hands-on-card ol,.lesson-challenge ol,.overview-grid ul,.wrap-grid ul{padding-left:1.2rem}.example-answer{margin-top:.8rem;padding:.7rem;border-radius:10px;background:var(--course-soft)}.advanced-examples{margin-top:1rem}.advanced-examples summary{cursor:pointer;font-weight:900}.advanced-stack{margin-top:1rem}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:1rem 0}.review-grid label{padding:.75rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.next-step{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:1rem;padding:1rem;border-radius:16px;background:#f5f7fa}.next-step>div{display:grid;gap:.2rem}.coming-next{font-weight:900;color:#64748b}.section-lead{color:#48576b;line-height:1.6}@media(max-width:760px){.overview-grid,.wrap-grid,.path-steps,.three-step-rule,.bridge-grid,.partial-visual,.review-grid{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.hook-card{grid-template-columns:1fr}.next-step{align-items:flex-start;flex-direction:column}}
</style>
