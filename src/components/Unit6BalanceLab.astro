<div class="lab" data-balance-lab>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART A · PRESERVE EQUALITY</p><h3>Choose a legal balance move</h3></div><button type="button" class="secondary" data-new-move>New equation</button></div><p class="challenge" data-move-prompt></p><div class="choices" data-move-choices></div><p class="feedback" data-move-feedback>Choose a move that happens to both sides.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART B · SEE THE BALANCE MOVE</p><h3>Move the tiles, then read the equation</h3></div><button type="button" class="secondary" data-new-model>New model</button></div><p class="challenge" data-model-prompt></p><div class="balance-stage"><div class="pan"><span class="pan-label">LEFT</span><div class="tiles" data-left-tiles></div></div><div class="balance-mark"><span>=</span><small>balanced</small></div><div class="pan"><span class="pan-label">RIGHT</span><div class="tiles" data-right-tiles></div></div></div><p class="symbol-line" data-symbol-line></p><div class="choices" data-model-actions></div><p class="feedback" data-model-feedback>Choose the move that keeps both sides equal.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART C · MODEL THE STORY</p><h3>Which equation matches?</h3></div><button type="button" class="secondary" data-new-story>New story</button></div><p class="challenge" data-story></p><div class="choices" data-story-choices></div><p class="feedback" data-story-feedback>Define the unknown, then translate the actions in order.</p></section>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-balance-lab]').forEach(lab=>{
  const moves=[{q:'x + 4 = 11',choices:['Subtract 4 from both sides','Subtract 4 only from the left','Add 4 only to the right'],a:0,e:'Subtracting 4 from both sides preserves equality and leaves x = 7.'},{q:'2x = 10',choices:['Divide both sides by 2','Divide only the left by 2','Subtract 2 from both sides'],a:0,e:'Equal sharing on both sides gives x = 5.'},{q:'n − 3 = 8',choices:['Add 3 to both sides','Add 3 only to the left','Subtract 3 from both sides'],a:0,e:'Adding 3 creates a zero pair on the left and gives n = 11.'}];let mi=0;const mp=lab.querySelector('[data-move-prompt]');const mc=lab.querySelector<HTMLElement>('[data-move-choices]');const mf=lab.querySelector<HTMLElement>('[data-move-feedback]');
  const renderMove=()=>{mi=Math.floor(Math.random()*moves.length);const t=moves[mi];if(mp)mp.textContent=`For ${t.q}, which move keeps the balance?`;if(mc){mc.innerHTML=t.choices.map((c,i)=>`<button type="button" data-choice="${i}">${c}</button>`).join('');mc.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{if(mf)mf.innerHTML=Number(b.dataset.choice)===t.a?`<strong>Correct.</strong> ${t.e}`:'<strong>Not yet.</strong> A legal move must preserve equality on both sides.';}));}if(mf)mf.textContent='Choose a move that happens to both sides.';};lab.querySelector('[data-new-move]')?.addEventListener('click',renderMove);renderMove();

  type TileSet={x?:number,pos?:number,neg?:number};
  type ModelState={left:TileSet,right:TileSet,line:string,choices:string[],answer:number,explain:string};
  const models:{q:string,states:ModelState[],solution:string}[]=[
    {q:'x + 4 = 9',states:[{left:{x:1,pos:4},right:{pos:9},line:'x + 4 = 9',choices:['Remove 4 from both sides','Remove 4 only from the left','Add 4 to both sides'],answer:0,explain:'Four +1 tiles disappear from each side. The balance stays level.'},{left:{x:1},right:{pos:5},line:'x = 5',choices:[],answer:0,explain:''}],solution:'One x-tile balances 5 unit tiles, so x = 5.'},
    {q:'2x + 2 = 10',states:[{left:{x:2,pos:2},right:{pos:10},line:'2x + 2 = 10',choices:['Remove 2 from both sides','Remove 2 only from the left','Divide only the right by 2'],answer:0,explain:'Remove two +1 tiles from each side to keep equality.'},{left:{x:2},right:{pos:8},line:'2x = 8',choices:['Share both sides into 2 equal groups','Remove one x-tile only','Subtract 2 from both sides'],answer:0,explain:'Two equal x-groups balance 8 units, so split both sides into 2 equal groups.'},{left:{x:1},right:{pos:4},line:'x = 4',choices:[],answer:0,explain:''}],solution:'Each x-group balances 4 units, so x = 4.'},
    {q:'n − 2 = 3',states:[{left:{x:1,neg:2},right:{pos:3},line:'n − 2 = 3',choices:['Add 2 to both sides','Add 2 only to the left','Subtract 2 from both sides'],answer:0,explain:'Add two +1 tiles to both sides. On the left, each +1 pairs with a −1 to make zero.'},{left:{x:1},right:{pos:5},line:'n = 5',choices:[],answer:0,explain:''}],solution:'The zero pairs disappear, leaving n balanced with 5 units.'},
    {q:'3p = 12',states:[{left:{x:3},right:{pos:12},line:'3p = 12',choices:['Share both sides into 3 equal groups','Subtract 3 from both sides','Remove two p-tiles only'],answer:0,explain:'Three equal p-groups balance 12 units, so divide both sides into 3 equal groups.'},{left:{x:1},right:{pos:4},line:'p = 4',choices:[],answer:0,explain:''}],solution:'Each p-group balances 4 units, so p = 4.'}
  ];
  let modelIndex=0,stateIndex=0;const modelPrompt=lab.querySelector('[data-model-prompt]');const leftTiles=lab.querySelector<HTMLElement>('[data-left-tiles]');const rightTiles=lab.querySelector<HTMLElement>('[data-right-tiles]');const symbolLine=lab.querySelector('[data-symbol-line]');const modelActions=lab.querySelector<HTMLElement>('[data-model-actions]');const modelFeedback=lab.querySelector<HTMLElement>('[data-model-feedback]');
  const tilesHtml=(set:TileSet)=>{const x=Array.from({length:set.x||0},()=>'<span class="tile x-tile">x</span>').join('');const pos=Array.from({length:set.pos||0},()=>'<span class="tile unit-tile">+1</span>').join('');const neg=Array.from({length:set.neg||0},()=>'<span class="tile neg-tile">−1</span>').join('');return x+pos+neg||'<span class="empty">nothing</span>';};
  const renderModel=()=>{const model=models[modelIndex],state=model.states[stateIndex];if(modelPrompt)modelPrompt.textContent=`Model ${model.q}. What should happen next?`;if(leftTiles)leftTiles.innerHTML=tilesHtml(state.left);if(rightTiles)rightTiles.innerHTML=tilesHtml(state.right);if(symbolLine)symbolLine.textContent=state.line;if(modelFeedback)modelFeedback.textContent=stateIndex===0?'Read the tiles first. Then choose a move that changes both sides equally.':'The model changed, but the balance stayed level.';if(modelActions){if(!state.choices.length){modelActions.innerHTML='<button type="button" class="complete-move" disabled>Balance solved ✓</button>';if(modelFeedback)modelFeedback.innerHTML=`<strong>Model complete.</strong> ${model.solution}`;return;}modelActions.innerHTML=state.choices.map((choice,i)=>`<button type="button" data-model-choice="${i}">${choice}</button>`).join('');modelActions.querySelectorAll<HTMLButtonElement>('[data-model-choice]').forEach(button=>button.addEventListener('click',()=>{if(Number(button.dataset.modelChoice)!==state.answer){if(modelFeedback)modelFeedback.innerHTML='<strong>Not yet.</strong> Try a move that acts on both sides and helps isolate the variable.';return;}if(modelFeedback)modelFeedback.innerHTML=`<strong>Correct.</strong> ${state.explain}`;stateIndex++;setTimeout(renderModel,350);}));}};
  const newModel=()=>{modelIndex=Math.floor(Math.random()*models.length);stateIndex=0;renderModel();};lab.querySelector('[data-new-model]')?.addEventListener('click',newModel);newModel();

  const stories=[{q:'A babysitter earns the same amount each hour. After 3 hours, the total is $36. Let w be the hourly wage.',choices:['w + 3 = 36','3w = 36','36w = 3'],a:1,e:'Three equal hourly wages total 36, so 3w = 36.'},{q:'A temperature rises 3°C and ends at −6°C. Let t be the starting temperature.',choices:['t + 3 = −6','t − 3 = −6','3t = −6'],a:0,e:'Starting temperature plus the 3-degree rise equals −6.'},{q:'Two equal boxes plus 5 loose items total 17. Let b be items in one box.',choices:['2b + 5 = 17','b + 7 = 17','5b + 2 = 17'],a:0,e:'Two b-groups plus 5 gives the total 17.'}];let ti=0;const st=lab.querySelector('[data-story]');const sc=lab.querySelector<HTMLElement>('[data-story-choices]');const stf=lab.querySelector<HTMLElement>('[data-story-feedback]');const renderStory=()=>{ti=Math.floor(Math.random()*stories.length);const t=stories[ti];if(st)st.textContent=t.q;if(sc){sc.innerHTML=t.choices.map((c,i)=>`<button type="button" data-story-choice="${i}">${c}</button>`).join('');sc.querySelectorAll<HTMLButtonElement>('[data-story-choice]').forEach(b=>b.addEventListener('click',()=>{if(stf)stf.innerHTML=Number(b.dataset.storyChoice)===t.a?`<strong>Correct.</strong> ${t.e}`:'<strong>Not yet.</strong> Follow the quantities and operations in the story.';}));}if(stf)stf.textContent='Define the unknown, then translate the actions in order.';};lab.querySelector('[data-new-story]')?.addEventListener('click',renderStory);renderStory();
 });
</script>
<style>.lab{display:grid;gap:1rem}.panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.head h3{margin:.2rem 0 .7rem}.secondary,.choices button{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.challenge{font-size:1.12rem;font-weight:900}.choices{display:grid;gap:.6rem}.choices button{text-align:left}.feedback{padding:.75rem .85rem;border-radius:12px;background:#f7f9fc}.balance-stage{display:grid;grid-template-columns:1fr auto 1fr;gap:.8rem;align-items:stretch;margin:.8rem 0}.pan{min-height:150px;border:2px solid #cbd5e1;border-bottom:6px solid #94a3b8;border-radius:16px 16px 8px 8px;padding:.75rem;background:#fbfdff}.pan-label{display:block;margin-bottom:.55rem;font-size:.72rem;font-weight:900;letter-spacing:.08em;color:#64748b}.tiles{display:flex;gap:.4rem;flex-wrap:wrap;align-content:flex-start}.tile{display:grid;place-items:center;min-width:38px;height:44px;padding:0 .35rem;border-radius:9px;font-weight:900;box-shadow:inset 0 -3px rgba(0,0,0,.08)}.x-tile{min-width:54px;background:#dbeafe;border:2px solid #60a5fa;color:#1e3a8a}.unit-tile{background:#fef3c7;border:2px solid #fbbf24;color:#78350f}.neg-tile{background:#fee2e2;border:2px solid #f87171;color:#7f1d1d}.empty{color:#94a3b8;font-style:italic}.balance-mark{display:grid;place-items:center;align-content:center;gap:.2rem}.balance-mark span{font-size:2rem;font-weight:900}.balance-mark small{color:#64748b;font-weight:800}.symbol-line{text-align:center;font-size:1.12rem;font-weight:900;padding:.6rem;border-radius:10px;background:var(--course-soft)}.complete-move{opacity:.75}.choices .complete-move{cursor:default}@media(max-width:650px){.head,.balance-stage{display:grid}.secondary{justify-self:start}.balance-mark{grid-auto-flow:column;justify-content:center}.pan{min-height:110px}}</style>