<div class="lab" data-balance-lab>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART A · PRESERVE EQUALITY</p><h3>Choose a legal balance move</h3></div><button type="button" class="secondary" data-new-move>New equation</button></div><p class="challenge" data-move-prompt></p><div class="choices" data-move-choices></div><p class="feedback" data-move-feedback>Choose a move that happens to both sides.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART B · SOLVE WITH THE BALANCE</p><h3>Undo, then share</h3></div><button type="button" class="secondary" data-new-solve>New challenge</button></div><p class="challenge" data-solve-prompt></p><div class="balance"><span data-left></span><b>=</b><span data-right></span></div><div class="answer-row"><input type="number" step="0.1" data-answer aria-label="Value of variable"><button type="button" data-check>Check solution</button></div><button type="button" class="hint" data-show-hint>Show model hint</button><p class="feedback" data-hint-text hidden></p><p class="feedback" data-feedback>Think about what you need to remove or share equally.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART C · MODEL THE STORY</p><h3>Which equation matches?</h3></div><button type="button" class="secondary" data-new-story>New story</button></div><p class="challenge" data-story></p><div class="choices" data-story-choices></div><p class="feedback" data-story-feedback>Define the unknown, then translate the actions in order.</p></section>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-balance-lab]').forEach(lab=>{
  const moves=[{q:'x + 4 = 11',choices:['Subtract 4 from both sides','Subtract 4 only from the left','Add 4 only to the right'],a:0,e:'Subtracting 4 from both sides preserves equality and leaves x = 7.'},{q:'2x = 10',choices:['Divide both sides by 2','Divide only the left by 2','Subtract 2 from both sides'],a:0,e:'Equal sharing on both sides gives x = 5.'},{q:'n − 3 = 8',choices:['Add 3 to both sides','Add 3 only to the left','Subtract 3 from both sides'],a:0,e:'Adding 3 creates a zero pair on the left and gives n = 11.'}];let mi=0;const mp=lab.querySelector('[data-move-prompt]');const mc=lab.querySelector<HTMLElement>('[data-move-choices]');const mf=lab.querySelector<HTMLElement>('[data-move-feedback]');
  const renderMove=()=>{mi=Math.floor(Math.random()*moves.length);const t=moves[mi];if(mp)mp.textContent=`For ${t.q}, which move keeps the balance?`;if(mc){mc.innerHTML=t.choices.map((c,i)=>`<button type="button" data-choice="${i}">${c}</button>`).join('');mc.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{if(mf)mf.innerHTML=Number(b.dataset.choice)===t.a?`<strong>Correct.</strong> ${t.e}`:'<strong>Not yet.</strong> A legal move must preserve equality on both sides.';}));}if(mf)mf.textContent='Choose a move that happens to both sides.';};lab.querySelector('[data-new-move]')?.addEventListener('click',renderMove);renderMove();
  const solves=[{q:'x + 6 = 14',l:'x + 6',r:'14',a:8,h:'Remove 6 from both sides.',e:'x + 6 − 6 = 14 − 6, so x = 8.'},{q:'2p + 3 = 11',l:'2p + 3',r:'11',a:4,h:'Remove 3 from both sides, then share the remaining 8 into 2 equal p-groups.',e:'2p = 8, so p = 4.'},{q:'3n − 2 = 10',l:'3n − 2',r:'10',a:4,h:'Add 2 to both sides, then share 12 among 3 n-groups.',e:'3n = 12, so n = 4.'},{q:'m − 5 = −2',l:'m − 5',r:'−2',a:3,h:'Add 5 to both sides to create a zero pair.',e:'m = −2 + 5 = 3.'}];let si=0;const sp=lab.querySelector('[data-solve-prompt]');const left=lab.querySelector('[data-left]');const right=lab.querySelector('[data-right]');const answer=lab.querySelector<HTMLInputElement>('[data-answer]');const sf=lab.querySelector<HTMLElement>('[data-feedback]');const ht=lab.querySelector<HTMLElement>('[data-hint-text]');
  const renderSolve=()=>{si=Math.floor(Math.random()*solves.length);const t=solves[si];if(sp)sp.textContent=`Solve ${t.q}.`;if(left)left.textContent=t.l;if(right)right.textContent=t.r;if(answer)answer.value='';if(sf)sf.textContent='Think about what you need to remove or share equally.';if(ht){ht.textContent=t.h;ht.hidden=true;}};lab.querySelector('[data-new-solve]')?.addEventListener('click',renderSolve);lab.querySelector('[data-check]')?.addEventListener('click',()=>{const t=solves[si];const ok=Math.abs(Number(answer?.value)-t.a)<.001;if(sf)sf.innerHTML=ok?`<strong>Correct.</strong> ${t.e}`:`<strong>Not yet.</strong> ${t.h}`;});lab.querySelector('[data-show-hint]')?.addEventListener('click',()=>{if(ht)ht.hidden=!ht.hidden;});renderSolve();
  const stories=[{q:'A babysitter earns the same amount each hour. After 3 hours, the total is $36. Let w be the hourly wage.',choices:['w + 3 = 36','3w = 36','36w = 3'],a:1,e:'Three equal hourly wages total 36, so 3w = 36.'},{q:'A temperature rises 3°C and ends at −6°C. Let t be the starting temperature.',choices:['t + 3 = −6','t − 3 = −6','3t = −6'],a:0,e:'Starting temperature plus the 3-degree rise equals −6.'},{q:'Two equal boxes plus 5 loose items total 17. Let b be items in one box.',choices:['2b + 5 = 17','b + 7 = 17','5b + 2 = 17'],a:0,e:'Two b-groups plus 5 gives the total 17.'}];let ti=0;const st=lab.querySelector('[data-story]');const sc=lab.querySelector<HTMLElement>('[data-story-choices]');const stf=lab.querySelector<HTMLElement>('[data-story-feedback]');const renderStory=()=>{ti=Math.floor(Math.random()*stories.length);const t=stories[ti];if(st)st.textContent=t.q;if(sc){sc.innerHTML=t.choices.map((c,i)=>`<button type="button" data-story-choice="${i}">${c}</button>`).join('');sc.querySelectorAll<HTMLButtonElement>('[data-story-choice]').forEach(b=>b.addEventListener('click',()=>{if(stf)stf.innerHTML=Number(b.dataset.storyChoice)===t.a?`<strong>Correct.</strong> ${t.e}`:'<strong>Not yet.</strong> Follow the quantities and operations in the story.';}));}if(stf)stf.textContent='Define the unknown, then translate the actions in order.';};lab.querySelector('[data-new-story]')?.addEventListener('click',renderStory);renderStory();
 });
</script>
<style>.lab{display:grid;gap:1rem}.panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.head h3{margin:.2rem 0 .7rem}.secondary,.choices button,.answer-row button{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.challenge{font-size:1.12rem;font-weight:900}.choices{display:grid;gap:.6rem}.choices button{text-align:left}.balance{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center;margin:.8rem 0}.balance span{padding:1rem;border-radius:12px;background:var(--course-soft);text-align:center;font-size:1.2rem;font-weight:900}.answer-row{display:flex;gap:.6rem}.answer-row input{flex:1;max-width:280px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.hint{margin-top:.65rem;border:0;background:transparent;color:var(--course);font-weight:900;cursor:pointer}.feedback{padding:.75rem .85rem;border-radius:12px;background:#f7f9fc}@media(max-width:650px){.head,.balance,.answer-row{display:grid}.secondary{justify-self:start}.answer-row input{max-width:none}}</style>