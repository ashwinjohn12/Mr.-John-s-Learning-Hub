---
import type{Unit5Lesson}from'../data/grade7Unit5';const{lesson}=Astro.props as{lesson:Unit5Lesson};
const configs:any={
 'models-add-fractions':{model:'linked fraction-strip model',quantities:[['First fraction','3/4'],['Second fraction','1/6'],['Renamed fractions','9/12, 2/12'],['Simplified sum','11/12']],estimate:.9,unit:'cups',comparison:'11/12 cup is less than one cup',decision:'use the one-cup container'},
 'other-models-add-fractions':{model:'scaled number-line and set model',quantities:[['First distance','3/4'],['Second distance','1/6'],['Common scale','12'],['Endpoint','11/12']],estimate:.9,unit:'km',comparison:'11/12 km is between 3/4 km and 1 km',decision:'the combined path fits within one kilometre'},
 'symbols-add-fractions':{model:'equivalence table',quantities:[['First fraction','3/4'],['Second fraction','1/6'],['Renamed numerators','9, 2'],['Simplified sum','11/12']],estimate:.9,unit:'cups',comparison:'11/12 cup is closer to one cup than one half',decision:'prepare one full measuring cup'},
 'models-subtract-fractions':{model:'take-away strip and difference line',quantities:[['Starting length','3/4'],['Removed length','1/4'],['Common denominator','4'],['Remainder','1/2']],estimate:.5,unit:'m',comparison:'one half metre remains',decision:'the half-metre piece is usable'},
 'symbols-subtract-fractions':{model:'renaming and inverse-check board',quantities:[['Starting length','3/4'],['Removed length','1/4'],['Difference','1/2'],['Inverse check','1/2, 1/4, 3/4']],estimate:.5,unit:'m',comparison:'the positive difference is smaller than the start',decision:'choose the lower-waste plan'},
 'adding-mixed-numbers':{model:'whole-and-fraction composition tray',quantities:[['First section','2 1/3'],['Second section','1/6'],['Renamed parts','2/6, 1/6'],['Total','2 1/2']],estimate:2.5,unit:'km',comparison:'2 1/2 km is less than 3 km',decision:'approve the route for one day'},
 'subtracting-mixed-numbers':{model:'mixed-number regrouping blocks',quantities:[['Starting supply','2 1/3'],['Used supply','1/4'],['Renamed parts','2 4/12, 3/12'],['Remainder','2 1/12']],estimate:2,unit:'m',comparison:'the remainder is just over two metres',decision:'the remaining supply covers the two-metre need'}
};const config=configs[lesson.slug];
---
<div class="apply" data-unit5-apply data-config={JSON.stringify(config)}><header><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></header>
 <fieldset><legend>Independently verified calculations</legend>{lesson.apply.values.map(v=><label>{v.label}{v.kind==='choice'?<select data-value data-answer={v.answer}><option value="">Choose</option>{v.options?.map(x=><option>{x}</option>)}</select>:<input data-value data-answer={v.answer} inputmode="decimal"/>}</label>)}</fieldset>
 <fieldset><legend>Estimate and required representation</legend><label>Reasonable estimate<input data-estimate inputmode="decimal"/></label><label>Required unit<input data-unit/></label><label>Model type<select data-model-type><option value="">Choose</option><option>{config.model}</option><option>mislabelled model with the wrong scale</option><option>model missing required quantities</option></select></label>{config.quantities.map((q:string[],i:number)=><label>{q[0]}<input data-model-quantity={i} data-answer={q[1]} inputmode={q[1].includes(',')?'text':'decimal'}/><small>Expected quantity or list shown in the task.</small></label>)}<button type="button" data-build>Build and verify model</button><div data-display role="img" aria-label="Application model not built."></div><p data-transcript>Model transcript: not built.</p></fieldset>
 <fieldset><legend>Comparison and decision</legend><label>Verified comparison<select data-comparison><option value="">Choose</option><option>{config.comparison}</option><option>the larger-looking shape is always correct</option></select></label><label>Supported decision<select data-decision><option value="">Choose</option><option>{config.decision}</option><option>ignore the units and model</option></select></label></fieldset>
 <ol>{lesson.apply.tasks.map((task,i)=><li><label><b>Task {i+1}: {task}</b><textarea data-evidence rows="3"></textarea></label></li>)}</ol><p class="note">Written explanations are evidence for student or teacher review. They are never graded by length, digits, keywords, or similarity to prepared wording.</p><button type="button" data-check>Verify the complete application</button><p data-status role="status" tabindex="-1">Complete every calculation, model, unit, comparison, reasonableness check, and decision.</p>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit5-apply]').forEach(root=>{const c=JSON.parse(root.dataset.config||'{}'),status=root.querySelector<HTMLElement>('[data-status]'),display=root.querySelector<HTMLElement>('[data-display]'),transcript=root.querySelector<HTMLElement>('[data-transcript]');let built=false;const norm=(v:string)=>v.trim().toLowerCase().replace(/[,$]/g,''),numeric=(v:string)=>{const x=v.trim().replace(/,/g,''),m=x.match(/^(?:(\d+)\s+)?(\d+)\/(\d+)$/);if(m)return Number(m[3])?Number(m[1]||0)+Number(m[2])/Number(m[3]):NaN;return /^[+]?((\d+(\.\d+)?)|(\.\d+))$/.test(x)?Number(x):NaN},equal=(v:string,e:string)=>norm(v)===norm(e)||(Number.isFinite(numeric(v))&&Number.isFinite(numeric(e))&&Math.abs(numeric(v)-numeric(e))<.001);
 const invalidate=()=>{root.dataset.verified='false';built=false;if(display){display.innerHTML='';display.setAttribute('aria-label','Application model not built.')}if(transcript)transcript.textContent='Model transcript: not built.';if(status)status.textContent='Evidence changed. Rebuild the model and verify the complete application again.'};root.querySelectorAll('input,select,textarea').forEach(x=>{x.addEventListener('input',invalidate);x.addEventListener('change',invalidate)});
 const listEqual=(actual:string,expected:string)=>{if(!expected.includes(','))return equal(actual,expected);const a=actual.split(',').map(x=>x.trim()),e=expected.split(',').map(x=>x.trim());return a.length===e.length&&a.every((x,i)=>equal(x,e[i]))};
 root.querySelector('[data-build]')?.addEventListener('click',()=>{const type=root.querySelector<HTMLSelectElement>('[data-model-type]')?.value,fields=[...root.querySelectorAll<HTMLInputElement>('[data-model-quantity]')];built=type===c.model&&fields.length===c.quantities.length&&fields.every((f,i)=>listEqual(f.value,c.quantities[i][1]));if(!built){if(status)status.textContent='The representation must use the required model and every exact labelled quantity or ordered list.';return}const values=fields.map((f,i)=>`${c.quantities[i][0]} ${f.value}`),text=`${c.model}: ${values.join('; ')}.`,kind=/number-line/.test(c.model)?'line':/equivalence|inverse/.test(c.model)?'table':/composition/.test(c.model)?'compose':/regrouping/.test(c.model)?'regroup':'strips';if(display){display.innerHTML=`<strong>${c.model}</strong><div class="apply-model ${kind}" aria-hidden="true">${Array.from({length:12},(_,i)=>`<i class="${i<7?'filled':''}"></i>`).join('')}</div><dl>${values.map(v=>`<div><dt>verified</dt><dd>${v}</dd></div>`).join('')}</dl>`;display.setAttribute('aria-label',text)}if(transcript)transcript.textContent=`Model transcript: ${text}`;if(status)status.textContent='Model verified. Complete the remaining evidence.'});
 root.querySelector('[data-check]')?.addEventListener('click',()=>{const bad=[...root.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-value]')].find(x=>!equal(x.value,x.dataset.answer||'')),estimate=root.querySelector<HTMLInputElement>('[data-estimate]')?.value||'',unit=root.querySelector<HTMLInputElement>('[data-unit]')?.value.trim(),comparison=root.querySelector<HTMLSelectElement>('[data-comparison]')?.value,decision=root.querySelector<HTMLSelectElement>('[data-decision]')?.value,missing=[...root.querySelectorAll<HTMLTextAreaElement>('[data-evidence]')].find(x=>!x.value.trim()),estimateOk=Number.isFinite(numeric(estimate))&&Math.abs(numeric(estimate)-c.estimate)<=Math.max(.1,Math.abs(c.estimate)*.08),ok=!bad&&estimateOk&&unit===c.unit&&built&&comparison===c.comparison&&decision===c.decision&&!missing;root.dataset.verified=String(ok);if(status)status.innerHTML=bad?'<strong>Revise a calculation.</strong> Each required value is checked independently.':!estimateOk?'<strong>Revise the estimate.</strong> It must give a reasonable magnitude.':unit!==c.unit?`<strong>Revise the unit.</strong> Use the quantity-appropriate unit shown in the task.`:!built?'<strong>Rebuild the mathematical representation.</strong> Both labelled quantities and model type are checked.':comparison!==c.comparison?'<strong>Revise the comparison.</strong> It must follow from the verified model.':decision!==c.decision?'<strong>Revise the decision.</strong> Use all verified evidence.':missing?'<strong>Record evidence for every task.</strong> The writing is stored for review, not automatically judged.':'<strong>Application complete.</strong> Calculations, representation, unit, comparison, estimate, and decision are verified.';status?.focus({preventScroll:true})});
});
</script>
<style>.apply{overflow:hidden;border-radius:16px;background:#251545;color:#fff}.apply header{padding:1rem;background:#493173}.apply fieldset,.apply ol,.apply .note,.apply>[data-status]{margin:1rem}.apply fieldset{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;border:1px solid #ffffff44;border-radius:10px}.apply label{display:grid;gap:.35rem}.apply input,.apply textarea,.apply select{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #b9acd0;font:inherit}.apply button{min-height:44px;padding:.7rem;border:0;border-radius:9px;background:#f4c95d;color:#251545;font-weight:900}.apply>[data-check]{margin:0 1rem}.apply [data-display],.apply [data-transcript]{grid-column:1/-1}.apply [data-display]{padding:.7rem;border-radius:9px;background:#fff;color:#251545}.model-bar{height:32px;border:2px solid #251545;margin:.5rem 0}.model-bar span{display:block;width:62%;height:100%;background:#7858a6}.apply li,.apply .note,.apply>[data-status]{padding:.75rem;border-radius:9px;background:#ffffff12}.apply :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:700px){.apply fieldset{grid-template-columns:1fr}.apply [data-display],.apply [data-transcript]{grid-column:1}.apply>[data-check]{width:calc(100% - 2rem)}}@media(max-width:390px){.apply fieldset,.apply ol,.apply .note,.apply>[data-status]{margin:.75rem}}@media(prefers-reduced-motion:reduce){.apply *{animation:none!important;transition:none!important}}</style>
<style>.apply-model{display:grid;grid-template-columns:repeat(12,minmax(8px,1fr));min-height:58px;margin:.55rem 0;border:2px solid #493173;background:#fff}.apply-model i{display:block;border-right:1px solid #493173;background:#ece7f7}.apply-model i.filled{background:#7858a6}.apply-model.line{border:0;border-bottom:4px solid #493173;min-height:35px}.apply-model.line i{border:0;border-right:2px solid #493173;background:transparent}.apply-model.table{grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(3,1fr)}.apply-model.compose,.apply-model.regroup{grid-template-columns:repeat(6,1fr);gap:.2rem;border:0}.apply-model.compose i,.apply-model.regroup i{border:2px solid #493173;border-radius:5px}</style>
