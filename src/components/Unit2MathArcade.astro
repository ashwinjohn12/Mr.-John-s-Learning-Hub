---
const base = import.meta.env.BASE_URL;
---
<div class="arcade" data-unit2-arcade data-base={base}>
  <div class="arcade-head"><div><p class="eyebrow">COORDINATE DESIGN STUDIO</p><h3>Transformation Mission Arcade</h3><p>Solve without answer choices. Enter a coordinate or number, build a streak, and earn points.</p></div><div class="score"><strong data-score>0</strong><span>points</span><small data-streak>Streak: 0</small></div></div>
  <div class="mission"><div class="meta"><span data-number></span><span data-skill></span></div><h3 data-prompt></h3><div class="answer" data-answer-box></div><button type="button" data-check>Check mission</button><div class="feedback" data-feedback aria-live="polite"></div><div class="actions"><button type="button" data-next hidden>Next mission →</button><button type="button" class="secondary" data-new>New quest</button></div></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-unit2-arcade]').forEach(widget=>{
    const base=widget.dataset.base||'/';
    const missions=[
      {skill:'2.1 · Coordinates',prompt:'A point is 6 left and 4 up from the origin. Enter its ordered pair.',answer:[-6,4],labels:['x','y'],explain:'Left gives x = −6 and up gives y = 4.',lesson:'describing-location-cartesian-plane'},
      {skill:'2.1 · Quadrants',prompt:'Enter the quadrant number containing (5, −8).',answer:[4],labels:['quadrant'],explain:'Positive x and negative y place the point in Quadrant IV.',lesson:'describing-location-cartesian-plane'},
      {skill:'2.2 · Translation',prompt:'Translate (−3, 5) by 7 right and 4 down. Enter the image point.',answer:[4,1],labels:['x′','y′'],explain:'Add 7 to x and subtract 4 from y.',lesson:'translating-shapes'},
      {skill:'2.2 · Translation',prompt:'P(2, −1) becomes P′(−4, 6). Enter the horizontal change, then vertical change. Use negative for left or down.',answer:[-6,7],labels:['horizontal','vertical'],explain:'x changes by −6 and y changes by +7.',lesson:'translating-shapes'},
      {skill:'2.3 · Reflection',prompt:'Reflect (−7, 3) across the y-axis. Enter the image point.',answer:[7,3],labels:['x′','y′'],explain:'Across the y-axis, x changes sign and y stays.',lesson:'reflecting-shapes'},
      {skill:'2.3 · Reflection',prompt:'Reflect (4, −6) across the x-axis. Enter the image point.',answer:[4,6],labels:['x′','y′'],explain:'Across the x-axis, y changes sign and x stays.',lesson:'reflecting-shapes'},
      {skill:'2.4 · Rotation about a vertex',prompt:'Triangle ABC has A(−3, −2) as the centre of rotation and B(1, −2). Rotate the whole triangle 90° counter-clockwise about vertex A. Enter B′.',answer:[-3,2],labels:['x′','y′'],explain:'A stays fixed. B is 4 units right of A, so after a quarter-turn counter-clockwise B′ is 4 units above A at (−3, 2).',lesson:'rotating-shapes'},
      {skill:'2.4 · Rotation',prompt:'Rotate (3, 1) 90° counter-clockwise about the origin. Enter the image point.',answer:[-1,3],labels:['x′','y′'],explain:'A quarter-turn counter-clockwise sends (x, y) to (−y, x).',lesson:'rotating-shapes'},
      {skill:'2.4 · Equivalent turns',prompt:'Enter the counter-clockwise angle equivalent to 90° clockwise.',answer:[270],labels:['degrees'],explain:'Opposite-direction equivalent angles add to 360°.',lesson:'rotating-shapes'},
      {skill:'2.5 · Symmetry',prompt:'Enter the number of lines of symmetry in a non-square rectangle.',answer:[2],labels:['lines'],explain:'Its horizontal and vertical middle lines are symmetry lines.',lesson:'congruence-symmetry'},
      {skill:'2.5 · Rotation',prompt:'Enter the smallest rotational symmetry angle of a square.',answer:[90],labels:['degrees'],explain:'Four equal matching positions divide 360° into 90° turns.',lesson:'congruence-symmetry'},
      {skill:'2.5 · Two transformations',prompt:'Start at P(2, 3). Reflect across the y-axis, then translate 5 units right. Enter the final image point.',answer:[3,3],labels:['x','y'],explain:'Reflection gives (−2, 3), then translating 5 right gives (3, 3). The order of the two transformations matters.',lesson:'congruence-symmetry'},
      {skill:'2.5 · Superimposing',prompt:'A 3-by-7 rectangle is turned until it lies exactly on a 7-by-3 rectangle. Enter the smallest rotation angle that can superimpose them.',answer:[90],labels:['degrees'],explain:'A 90° turn swaps the rectangle’s orientation without changing its size or shape, so it can superimpose exactly.',lesson:'congruence-symmetry'},
      {skill:'2.6 · Tessellations',prompt:'A repeated tile pattern has 3 gaps and 0 overlaps. Enter the total number of problems that prevent it from being a tessellation.',answer:[3],labels:['problems'],explain:'Every gap or overlap breaks the tessellation condition.',lesson:'tessellations'},
      {skill:'2.6 · Objects & architecture',prompt:'A brick-wall pattern repeats and covers the surface with 0 gaps and 0 overlaps. Enter 1 if it is a tessellation or 0 if it is not.',answer:[1],labels:['1 = yes, 0 = no'],explain:'The repeating bricks fully cover the surface, so the wall pattern is a tessellation.',lesson:'tessellations'},
      {skill:'2.6 · Non-example',prompt:'Equal circles repeat in rows but leave curved gaps between them. Enter 1 if the pattern is a tessellation or 0 if it is not.',answer:[0],labels:['1 = yes, 0 = no'],explain:'It repeats, but the gaps mean it does not tessellate the plane.',lesson:'tessellations'},
      {skill:'Mixed · Two moves',prompt:'Start at (2, 3), translate 4 left, then reflect across the x-axis. Enter the final point.',answer:[-2,-3],labels:['x','y'],explain:'The translation gives (−2, 3), then reflection changes y to −3.',lesson:'reflecting-shapes'}
    ];
    const $=(s:string)=>widget.querySelector<HTMLElement>(s)!; let pool:any[]=[],index=0,score=0,streak=0,attempts=0;
    const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);
    const update=()=>{$('[data-score]').textContent=String(score);$('[data-streak]').textContent=`Streak: ${streak}`};
    const render=()=>{const m=pool[index];attempts=0;$('[data-number]').textContent=`Mission ${index+1} of ${pool.length}`;$('[data-skill]').textContent=m.skill;$('[data-prompt]').textContent=m.prompt;$('[data-answer-box]').innerHTML=m.answer.map((_:number,i:number)=>`<label>${m.labels?.[i]||`Value ${i+1}`}<input type="number" data-value></label>`).join('');$('[data-feedback]').innerHTML='';(widget.querySelector('[data-check]') as HTMLButtonElement).disabled=false;(widget.querySelector('[data-next]') as HTMLButtonElement).hidden=true;(widget.querySelector('input') as HTMLInputElement)?.focus()};
    const check=()=>{const m=pool[index],values=[...widget.querySelectorAll<HTMLInputElement>('[data-value]')].map(i=>Number(i.value));if(values.some(v=>!Number.isFinite(v)))return;attempts++;if(values.length===m.answer.length&&values.every((v,i)=>v===m.answer[i])){const earned=attempts===1?100:50;score+=earned;streak=attempts===1?streak+1:0;update();$('[data-feedback]').innerHTML=`<strong>Mission cleared! +${earned} points.</strong> ${m.explain}`;(widget.querySelector('[data-check]') as HTMLButtonElement).disabled=true;(widget.querySelector('[data-next]') as HTMLButtonElement).hidden=false}else{streak=0;update();$('[data-feedback]').innerHTML=`<strong>Not yet.</strong> Sketch the move or identify the evidence and try again. <a href="${base}courses/grade-6-math/coordinates-design/${m.lesson}/">Review the matching lesson</a>.`}};
    widget.querySelector('[data-check]')!.addEventListener('click',check);widget.addEventListener('keydown',e=>{if((e as KeyboardEvent).key==='Enter'&&!(widget.querySelector('[data-check]') as HTMLButtonElement).disabled)check()});widget.querySelector('[data-next]')!.addEventListener('click',()=>{index++;if(index>=pool.length){$('[data-prompt]').textContent='Quest complete!';$('[data-skill]').textContent='UNIT 2 COMPLETE';$('[data-answer-box]').innerHTML='';$('[data-feedback]').innerHTML=`<strong>Final score: ${score} points.</strong> Start a new quest for a different order.`;(widget.querySelector('[data-next]') as HTMLButtonElement).hidden=true;(widget.querySelector('[data-check]') as HTMLButtonElement).disabled=true}else render()});widget.querySelector('[data-new]')!.addEventListener('click',()=>{pool=shuffle(missions);index=score=streak=0;update();render()});
    pool=shuffle(missions);update();render();
  });
</script>
<style>
.arcade{border:1px solid #d8e0ea;border-radius:18px;background:#fff;overflow:hidden}.arcade-head{display:grid;grid-template-columns:1fr auto;gap:1.5rem;padding:1.25rem;background:linear-gradient(135deg,#eef6ff,#fff4d6)}.arcade-head h3,.arcade-head p{margin:.2rem 0}.score{min-width:100px;text-align:center;display:grid;align-content:center;padding:.8rem;border-radius:15px;background:#fff}.score strong{font-size:1.8rem}.score span,.score small{color:#64748b}.mission{padding:1.25rem}.meta{display:flex;justify-content:space-between;gap:1rem;color:#64748b;font-size:.78rem;font-weight:800;text-transform:uppercase}.mission>h3{font-size:1.3rem;line-height:1.4}.answer{display:flex;gap:.65rem;flex-wrap:wrap}.answer label{display:grid;gap:.35rem;font-weight:800}.answer input{width:150px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.mission>button,.actions button{margin-top:.8rem;border:0;border-radius:10px;padding:.7rem 1rem;background:#174ea6;color:#fff;font-weight:800;cursor:pointer}.mission>button:disabled{opacity:.5}.feedback{min-height:3rem;margin-top:1rem;padding:.85rem;border-radius:12px;background:#f8fafc}.feedback:empty{display:none}.feedback a{color:#174ea6;font-weight:800}.actions{display:flex;gap:.6rem;flex-wrap:wrap}.actions .secondary{background:#eef3f9;color:#25364f}@media(max-width:650px){.arcade-head{grid-template-columns:1fr}.score{grid-template-columns:auto auto auto;gap:.4rem}.meta{display:grid}.answer{display:grid}.answer input{width:100%}}
</style>
