---
---
<div class="order-lab" data-order-lab>
  <section class="lab-stage">
    <div class="stage-head"><span>1</span><div><p class="eyebrow">EXPRESSION STEPPER</p><h3>Choose the next valid step</h3><p>Do one priority step at a time and watch the expression simplify without changing the untouched parts.</p></div></div>
    <div class="expression-card" data-step-expression></div>
    <div class="choice-grid" data-step-choices></div>
    <div class="lab-feedback" data-step-feedback aria-live="polite"></div>
    <div class="step-actions"><button type="button" data-step-next hidden>Next step →</button><button type="button" class="secondary" data-step-new>New expression</button></div>
  </section>

  <section class="lab-stage">
    <div class="stage-head"><span>2</span><div><p class="eyebrow">EQUAL-PRIORITY CHECK</p><h3>Which operation comes first from the left?</h3><p>Multiplication and division share a level. Addition and subtraction share a level.</p></div></div>
    <div class="expression-card" data-priority-expression></div>
    <div class="choice-grid" data-priority-choices></div>
    <div class="lab-feedback" data-priority-feedback aria-live="polite"></div>
    <button type="button" class="secondary" data-priority-new>New equal-priority example</button>
  </section>

  <section class="lab-stage">
    <div class="stage-head"><span>3</span><div><p class="eyebrow">ERROR DETECTIVE</p><h3>Find the first wrong step</h3><p>Good checking means finding where the reasoning first went off track, not only noticing the final answer is wrong.</p></div></div>
    <div class="student-work" data-error-work></div>
    <div class="choice-grid" data-error-choices></div>
    <div class="lab-feedback" data-error-feedback aria-live="polite"></div>
    <button type="button" class="secondary" data-error-new>New error to inspect</button>
  </section>

  <div class="priority-guide" aria-label="Order of operations priority guide">
    <div><strong>1</strong><span>Parentheses</span></div>
    <div><strong>2</strong><span>Powers</span></div>
    <div class="paired"><strong>3</strong><span>× and ÷ <small>same priority · left to right</small></span></div>
    <div class="paired"><strong>4</strong><span>+ and − <small>same priority · left to right</small></span></div>
  </div>
</div>

<script>
  const shuffle=<T,>(items:T[])=>[...items].sort(()=>Math.random()-.5);
  document.querySelectorAll<HTMLElement>('[data-order-lab]').forEach((widget)=>{
    type Step={expression:string;choices:string[];answer:number;explain:string};
    const stepSets:{steps:Step[];final:string}[]=[
      {steps:[
        {expression:'4 + 2 × (3² − 5)',choices:['4 + 2','3²','2 × 3²'],answer:1,explain:'Inside the parentheses, the power has priority.'},
        {expression:'4 + 2 × (9 − 5)',choices:['4 + 2','9 − 5','2 × 9'],answer:1,explain:'Finish the operation inside the parentheses.'},
        {expression:'4 + 2 × 4',choices:['4 + 2','2 × 4','4 + 4'],answer:1,explain:'Multiplication comes before addition.'},
        {expression:'4 + 8',choices:['4 + 8','Stop at 8'],answer:0,explain:'Addition is the remaining operation.'}
      ],final:'12'},
      {steps:[
        {expression:'6 + 2 × (5 − 2)²',choices:['6 + 2','5 − 2','2 × 5'],answer:1,explain:'Work inside the parentheses first.'},
        {expression:'6 + 2 × 3²',choices:['6 + 2','3²','2 × 3'],answer:1,explain:'Evaluate the power before multiplication.'},
        {expression:'6 + 2 × 9',choices:['6 + 2','2 × 9','6 + 9'],answer:1,explain:'Multiplication comes before addition.'},
        {expression:'6 + 18',choices:['6 + 18','Stop at 18'],answer:0,explain:'Complete the remaining addition.'}
      ],final:'24'},
      {steps:[
        {expression:'30 ÷ 5 × 2 + 1',choices:['5 × 2','30 ÷ 5','2 + 1'],answer:1,explain:'Multiplication and division share priority, so start with the leftmost one.'},
        {expression:'6 × 2 + 1',choices:['6 × 2','2 + 1'],answer:0,explain:'Multiplication comes before addition.'},
        {expression:'12 + 1',choices:['12 + 1','Stop at 12'],answer:0,explain:'Complete the remaining addition.'}
      ],final:'13'}
    ];
    const stepExpression=widget.querySelector<HTMLElement>('[data-step-expression]');
    const stepChoices=widget.querySelector<HTMLElement>('[data-step-choices]');
    const stepFeedback=widget.querySelector<HTMLElement>('[data-step-feedback]');
    const stepNext=widget.querySelector<HTMLButtonElement>('[data-step-next]');
    let activeSet=stepSets[0];let stepIndex=0;
    const renderStep=()=>{
      const step=activeSet.steps[stepIndex];
      if(stepExpression)stepExpression.textContent=step.expression;
      if(stepFeedback)stepFeedback.innerHTML='';
      if(stepNext)stepNext.hidden=true;
      if(stepChoices){
        stepChoices.innerHTML='';
        step.choices.forEach((choice,index)=>{
          const button=document.createElement('button');button.type='button';button.textContent=choice;
          button.addEventListener('click',()=>{
            if(index===step.answer){
              stepChoices.querySelectorAll('button').forEach((item)=>{(item as HTMLButtonElement).disabled=true;});
              if(stepIndex===activeSet.steps.length-1){
                if(stepExpression)stepExpression.textContent=activeSet.final;
                if(stepFeedback)stepFeedback.innerHTML=`<strong>Complete.</strong> ${step.explain} The value is ${activeSet.final}.`;
              } else {
                if(stepFeedback)stepFeedback.innerHTML=`<strong>Yes.</strong> ${step.explain} Read this explanation, then choose Next step when you are ready.`;
                if(stepNext)stepNext.hidden=false;
              }
            } else if(stepFeedback) stepFeedback.innerHTML=`<strong>Not yet.</strong> ${step.explain}`;
          });
          stepChoices.appendChild(button);
        });
      }
    };
    const newStepper=()=>{activeSet=shuffle(stepSets)[0];stepIndex=0;renderStep();};
    stepNext?.addEventListener('click',()=>{if(stepIndex<activeSet.steps.length-1){stepIndex++;renderStep();}});
    widget.querySelector('[data-step-new]')?.addEventListener('click',newStepper);

    const priorityItems=[
      {expression:'24 ÷ 6 × 2',choices:['24 ÷ 6','6 × 2'],answer:'24 ÷ 6',explain:'Division and multiplication share priority, so use the leftmost operation first.'},
      {expression:'36 ÷ 6 × 3',choices:['36 ÷ 6','6 × 3'],answer:'36 ÷ 6',explain:'Work left to right within the multiplication/division level.'},
      {expression:'15 − 8 + 3',choices:['15 − 8','8 + 3'],answer:'15 − 8',explain:'Subtraction and addition share priority, so use the leftmost operation first.'},
      {expression:'20 − 6 + 4',choices:['20 − 6','6 + 4'],answer:'20 − 6',explain:'Work left to right within the addition/subtraction level.'}
    ];
    const priorityExpression=widget.querySelector<HTMLElement>('[data-priority-expression]');const priorityChoices=widget.querySelector<HTMLElement>('[data-priority-choices]');const priorityFeedback=widget.querySelector<HTMLElement>('[data-priority-feedback]');let priority=priorityItems[0];
    const renderPriority=()=>{priority=shuffle(priorityItems)[0];if(priorityExpression)priorityExpression.textContent=priority.expression;if(priorityFeedback)priorityFeedback.innerHTML='';if(priorityChoices){priorityChoices.innerHTML='';shuffle(priority.choices).forEach((choice)=>{const button=document.createElement('button');button.type='button';button.textContent=choice;button.addEventListener('click',()=>{if(priorityFeedback)priorityFeedback.innerHTML=choice===priority.answer?`<strong>Correct.</strong> ${priority.explain}`:`<strong>Not quite.</strong> ${priority.explain}`;});priorityChoices.appendChild(button);});}};widget.querySelector('[data-priority-new]')?.addEventListener('click',renderPriority);

    const errors=[
      {work:['36 ÷ 6 × 3','36 ÷ 18','2'],choices:['36 ÷ 18','2','There is no error'],answer:'36 ÷ 18',explain:'The first error is multiplying 6 × 3 before completing the division to its left.'},
      {work:['15 − 8 + 3','15 − 11','4'],choices:['15 − 11','4','There is no error'],answer:'15 − 11',explain:'The first error is adding 8 + 3 before completing 15 − 8.'},
      {work:['5 + 2 × (3² − 4)','5 + 2 × (9 − 4)','7 × 5','35'],choices:['5 + 2 × (9 − 4)','7 × 5','35'],answer:'7 × 5',explain:'After the parentheses become 5, multiplication 2 × 5 must happen before adding 5.'}
    ];
    const errorWork=widget.querySelector<HTMLElement>('[data-error-work]');const errorChoices=widget.querySelector<HTMLElement>('[data-error-choices]');const errorFeedback=widget.querySelector<HTMLElement>('[data-error-feedback]');let error=errors[0];
    const renderError=()=>{error=shuffle(errors)[0];if(errorFeedback)errorFeedback.innerHTML='';if(errorWork)errorWork.innerHTML=error.work.map((line,index)=>`<div><small>Step ${index+1}</small><strong>${line}</strong></div>`).join('');if(errorChoices){errorChoices.innerHTML='';error.choices.forEach((choice)=>{const button=document.createElement('button');button.type='button';button.textContent=choice;button.addEventListener('click',()=>{if(errorFeedback)errorFeedback.innerHTML=choice===error.answer?`<strong>Exactly.</strong> ${error.explain}`:`<strong>Look earlier.</strong> Find the first line where the conventional order stopped being followed.`;});errorChoices.appendChild(button);});}};widget.querySelector('[data-error-new]')?.addEventListener('click',renderError);

    newStepper();renderPriority();renderError();
  });
</script>

<style>
.order-lab{display:grid;gap:1rem}.lab-stage{border:1px solid #d9e2ec;border-radius:18px;background:#fff;padding:1rem}.stage-head{display:grid;grid-template-columns:42px 1fr;gap:.8rem;align-items:start}.stage-head>span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#174ea6;color:#fff;font-weight:900}.stage-head h3{margin:.1rem 0 .25rem}.stage-head p{margin:.15rem 0}.expression-card{margin:1rem 0;padding:1.1rem;text-align:center;border-radius:14px;background:#f8fafc;font-size:1.45rem;font-weight:900}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.choice-grid button{border:0;border-radius:10px;padding:.7rem .9rem;background:#eef3f9;color:#25364f;font-weight:800;cursor:pointer}.choice-grid button:disabled{opacity:.55;cursor:default}.secondary,.step-actions>[data-step-next]{margin-top:.7rem;border:0;border-radius:10px;padding:.6rem .85rem;font-weight:800;cursor:pointer}.secondary{background:#eef3f9;color:#25364f}.step-actions>[data-step-next]{background:#174ea6;color:#fff}.step-actions{display:flex;gap:.55rem;flex-wrap:wrap}.lab-feedback{margin-top:.8rem;padding:.8rem .9rem;border-radius:12px;background:#f8fafc;min-height:1.25rem}.lab-feedback:empty{display:none}.student-work{display:grid;gap:.5rem;margin:1rem 0}.student-work>div{display:grid;grid-template-columns:70px 1fr;gap:.7rem;align-items:center;padding:.7rem;border-radius:12px;background:#f8fafc}.student-work small{color:#64748b;font-weight:800}.student-work strong{font-size:1.05rem}.priority-guide{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;padding:1rem;border-radius:16px;background:#fff8db}.priority-guide>div{display:grid;grid-template-columns:auto 1fr;gap:.55rem;align-items:center;padding:.7rem;border-radius:12px;background:#fff}.priority-guide strong{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#174ea6;color:#fff}.priority-guide span{font-weight:900}.priority-guide small{display:block;color:#64748b;font-weight:700;margin-top:.15rem}@media(max-width:700px){.choice-grid,.priority-guide{grid-template-columns:1fr}.stage-head{grid-template-columns:36px 1fr}}
</style>