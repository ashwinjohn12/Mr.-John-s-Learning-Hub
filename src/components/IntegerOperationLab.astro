---
interface Props { mode: 'add-strategy' | 'subtract-model' | 'subtract-line' | 'subtract-symbolic' }
const { mode } = Astro.props;
const titles = {
  'add-strategy': 'Symbolic Addition Strategy Coach',
  'subtract-model': 'Subtraction & Zero-Pair Coach',
  'subtract-line': 'Subtraction Direction Coach',
  'subtract-symbolic': 'Equivalent Statement Builder'
};
---
<div class="operation-lab" data-operation-lab data-mode={mode}>
  <div class="lab-title"><strong>{titles[mode]}</strong><span>Change both integers and explain the pattern.</span></div>
  <div class="controls">
    <label><span data-a-label>First integer</span><input type="range" min="-12" max="12" value={mode === 'add-strategy' ? '-8' : '-4'} data-a /><strong data-a-value></strong></label>
    <label><span data-b-label>Second integer</span><input type="range" min="-12" max="12" value={mode === 'add-strategy' ? '13' : mode === 'subtract-model' ? '3' : '-5'} data-b /><strong data-b-value></strong></label>
  </div>
  <div class="equation" data-equation></div>
  <div class="coach-grid">
    <section><p class="mini">WHAT TO NOTICE</p><strong data-notice></strong><p data-explain></p></section>
    <section><p class="mini">MODEL CONNECTION</p><div data-model></div></section>
  </div>
  <div class="result" data-result></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-operation-lab]').forEach((widget) => {
    const a = widget.querySelector<HTMLInputElement>('[data-a]');
    const b = widget.querySelector<HTMLInputElement>('[data-b]');
    const aValue = widget.querySelector('[data-a-value]');
    const bValue = widget.querySelector('[data-b-value]');
    const aLabel = widget.querySelector('[data-a-label]');
    const bLabel = widget.querySelector('[data-b-label]');
    const equation = widget.querySelector('[data-equation]');
    const notice = widget.querySelector('[data-notice]');
    const explain = widget.querySelector('[data-explain]');
    const model = widget.querySelector<HTMLElement>('[data-model]');
    const result = widget.querySelector('[data-result]');
    const mode = widget.dataset.mode;
    const signed = (n:number) => n > 0 ? `+${n}` : `${n}`;
    const chip = (kind:'positive'|'negative') => `<span class="chip ${kind}">${kind === 'positive' ? '+1' : '−1'}</span>`;
    const chips = (n:number, limit=12) => {
      if (n === 0) return '<span class="zero">0</span>';
      const kind = n > 0 ? 'positive' : 'negative';
      const shown = Math.min(Math.abs(n), limit);
      return Array.from({length:shown}, () => chip(kind)).join('') + (Math.abs(n) > limit ? `<span class="more">+${Math.abs(n)-limit} more</span>` : '');
    };
    const render = () => {
      const av = Number(a?.value ?? 0);
      const bv = Number(b?.value ?? 0);
      if (aValue) aValue.textContent = signed(av);
      if (bValue) bValue.textContent = signed(bv);

      if (mode === 'add-strategy') {
        if (aLabel) aLabel.textContent = 'Addend A'; if (bLabel) bLabel.textContent = 'Addend B';
        const sum = av + bv;
        const same = av === 0 || bv === 0 || Math.sign(av) === Math.sign(bv);
        if (equation) equation.textContent = `${signed(av)} + (${signed(bv)}) = ${signed(sum)}`;
        if (notice) notice.textContent = same ? 'Same direction / zero case' : 'Different signs → compare magnitudes';
        if (explain) explain.textContent = av === 0 || bv === 0 ? 'Adding zero leaves the other integer unchanged.' : same ? `The signs match, so add ${Math.abs(av)} + ${Math.abs(bv)} and keep the common sign.` : `The signs differ, so subtract ${Math.max(Math.abs(av),Math.abs(bv))} − ${Math.min(Math.abs(av),Math.abs(bv))}. The sign comes from the addend with greater magnitude.`;
        if (model) model.innerHTML = `<div class="chips">${chips(av)} ${chips(bv)}</div><p>${same ? 'The movements reinforce one another.' : 'Opposite chips form zero pairs until only the greater magnitude remains.'}</p>`;
        if (result) result.textContent = `Sum: ${signed(sum)}`;
      } else {
        if (aLabel) aLabel.textContent = 'Minuend'; if (bLabel) bLabel.textContent = 'Subtrahend';
        const diff = av - bv;
        if (mode === 'subtract-symbolic') {
          if (equation) equation.textContent = `${signed(av)} − (${signed(bv)}) = ${signed(av)} + (${signed(-bv)})`;
          if (notice) notice.textContent = 'Keep the minuend; add the additive inverse.';
          if (explain) explain.textContent = `The additive inverse of ${signed(bv)} is ${signed(-bv)}. Now use your addition strategy.`;
          if (model) model.innerHTML = `<p><strong>Equivalent addition:</strong> ${signed(av)} + (${signed(-bv)}) = ${signed(diff)}</p><p>Only the subtrahend changes to its opposite.</p>`;
          if (result) result.textContent = `Difference: ${signed(diff)}`;
        } else if (mode === 'subtract-line') {
          if (equation) equation.textContent = `${signed(av)} − (${signed(bv)}) = ${signed(diff)}`;
          const direction = bv >= 0 ? 'left' : 'right';
          if (notice) notice.textContent = `Subtract ${bv >= 0 ? 'positive' : 'negative'} → move ${direction}`;
          if (explain) explain.textContent = `Start at ${signed(av)}. Move ${Math.abs(bv)} unit${Math.abs(bv)===1?'':'s'} ${direction}. You land at ${signed(diff)}.`;
          const min=-15,max=15,pct=(n:number)=>Math.max(0,Math.min(100,((n-min)/(max-min))*100));
          if (model) model.innerHTML = `<div class="mini-line"><i></i><span class="start" style="left:${pct(av)}%">START<br>${signed(av)}</span><span class="end" style="left:${pct(diff)}%">END<br>${signed(diff)}</span></div>`;
          if (result) result.textContent = `Difference: ${signed(diff)}`;
        } else {
          if (equation) equation.textContent = `${signed(av)} − (${signed(bv)}) = ${signed(diff)}`;
          const needPositive = bv > 0 ? Math.max(0, bv - Math.max(av,0)) : 0;
          const needNegative = bv < 0 ? Math.max(0, Math.abs(bv) - Math.abs(Math.min(av,0))) : 0;
          const pairs = Math.max(needPositive, needNegative);
          if (notice) notice.textContent = pairs ? `Add ${pairs} zero pair${pairs===1?'':'s'} first` : 'You can remove the subtrahend immediately';
          if (explain) explain.textContent = pairs ? `The starting model does not contain enough ${bv > 0 ? 'positive' : 'negative'} chips to remove ${signed(bv)}. Each zero pair adds one of each sign without changing the value.` : `The starting model already contains enough ${bv > 0 ? 'positive' : 'negative'} chips to remove the subtrahend.`;
          if (model) model.innerHTML = `<div class="chips">${chips(av)}</div>${pairs ? `<p>Add ${pairs} × (${chip('positive')} ${chip('negative')}) before removing ${Math.abs(bv)} ${bv>0?'positive':'negative'} chip${Math.abs(bv)===1?'':'s'}.</p>` : `<p>Remove ${Math.abs(bv)} ${bv>=0?'positive':'negative'} chip${Math.abs(bv)===1?'':'s'}.</p>`}`;
          if (result) result.textContent = `After the removal, the model has value ${signed(diff)}.`;
        }
      }
    };
    a?.addEventListener('input',render); b?.addEventListener('input',render); render();
  });
</script>

<style>
  .operation-lab{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.15rem;box-shadow:0 8px 24px rgba(20,44,78,.06)}
  .lab-title{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:1rem}.lab-title span{color:#64748b;font-size:.9rem}
  .controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.controls label{display:grid;grid-template-columns:1fr auto;gap:.45rem;font-weight:700;align-items:center}.controls input{grid-column:1/-1;width:100%}
  .equation{text-align:center;font-size:1.4rem;font-weight:900;margin:1.1rem 0;padding:.8rem;border-radius:14px;background:#f5f8fc}
  .coach-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.coach-grid section{border:1px solid #e5e9ef;border-radius:14px;padding:.9rem;background:#fafbfd}.coach-grid p{line-height:1.5}.mini{font-size:.72rem;font-weight:900;letter-spacing:.08em;color:#64748b;margin:.1rem 0 .5rem}
  .chips{display:flex;gap:.32rem;flex-wrap:wrap;align-items:center}.chip{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;font-size:.72rem;font-weight:900}.positive{background:#dbeafe;color:#174ea6;border:2px solid #174ea6}.negative{background:#fce7f3;color:#9d174d;border:2px solid #9d174d}.more,.zero{font-weight:800;color:#64748b}
  .result{margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f0fdf4;font-weight:900}
  .mini-line{height:72px;position:relative;margin:1rem .4rem}.mini-line i{position:absolute;left:0;right:0;top:34px;height:4px;background:#334155;border-radius:999px}.mini-line span{position:absolute;top:4px;transform:translateX(-50%);font-size:.72rem;font-weight:900;text-align:center}.mini-line span:after{content:'';display:block;width:3px;height:30px;background:#174ea6;margin:.25rem auto 0}.mini-line .end{top:40px}.mini-line .end:after{display:none}
  @media(max-width:650px){.controls,.coach-grid{grid-template-columns:1fr}.lab-title{display:grid}}
</style>