<div class="chip-widget" data-chip-lab>
  <div class="chip-controls">
    <label><span>Addend A</span><input type="range" min="-8" max="8" value="5" data-chip-a /><strong data-chip-a-value>+5</strong></label>
    <label><span>Addend B</span><input type="range" min="-8" max="8" value="-7" data-chip-b /><strong data-chip-b-value>-7</strong></label>
  </div>

  <div class="equation" data-chip-equation></div>
  <div class="chip-groups">
    <section><h4>Build A</h4><div class="chip-row" data-group-a></div></section>
    <section><h4>Add B</h4><div class="chip-row" data-group-b></div></section>
  </div>

  <div class="zero-pair-panel">
    <div><span class="chip positive">+1</span><span class="plus">+</span><span class="chip negative">-1</span><span>= 0</span></div>
    <p data-pairs></p>
  </div>

  <section class="remaining">
    <h4>After zero pairs are removed</h4>
    <div class="chip-row" data-remaining></div>
    <strong data-chip-result></strong>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-chip-lab]').forEach((widget) => {
    const a = widget.querySelector<HTMLInputElement>('[data-chip-a]');
    const b = widget.querySelector<HTMLInputElement>('[data-chip-b]');
    const aValue = widget.querySelector('[data-chip-a-value]');
    const bValue = widget.querySelector('[data-chip-b-value]');
    const groupA = widget.querySelector<HTMLElement>('[data-group-a]');
    const groupB = widget.querySelector<HTMLElement>('[data-group-b]');
    const remaining = widget.querySelector<HTMLElement>('[data-remaining]');
    const pairs = widget.querySelector('[data-pairs]');
    const equation = widget.querySelector('[data-chip-equation]');
    const result = widget.querySelector('[data-chip-result]');
    const signed = (n:number) => n > 0 ? `+${n}` : `${n}`;
    const chips = (n:number) => {
      if (n === 0) return '<span class="empty-chip">0</span>';
      const cls = n > 0 ? 'positive' : 'negative';
      const label = n > 0 ? '+1' : '-1';
      return Array.from({length:Math.abs(n)}, () => `<span class="chip ${cls}">${label}</span>`).join('');
    };
    const render = () => {
      const av = Number(a?.value ?? 0);
      const bv = Number(b?.value ?? 0);
      const positives = Math.max(av,0) + Math.max(bv,0);
      const negatives = Math.abs(Math.min(av,0)) + Math.abs(Math.min(bv,0));
      const zeroPairs = Math.min(positives,negatives);
      const net = positives - negatives;
      if (aValue) aValue.textContent = signed(av);
      if (bValue) bValue.textContent = signed(bv);
      if (groupA) groupA.innerHTML = chips(av);
      if (groupB) groupB.innerHTML = chips(bv);
      if (remaining) remaining.innerHTML = chips(net);
      if (pairs) pairs.textContent = `${zeroPairs} zero pair${zeroPairs === 1 ? '' : 's'} can be removed.`;
      if (equation) equation.textContent = `${signed(av)} + (${signed(bv)})`;
      if (result) result.textContent = net === 0 ? 'Nothing remains, so the sum is 0.' : `${Math.abs(net)} ${net > 0 ? 'positive' : 'negative'} chip${Math.abs(net) === 1 ? '' : 's'} remain, so the sum is ${signed(net)}.`;
    };
    a?.addEventListener('input',render);
    b?.addEventListener('input',render);
    render();
  });
</script>

<style>
  .chip-widget{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.15rem;box-shadow:0 8px 24px rgba(20,44,78,.06)}
  .chip-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .chip-controls label{display:grid;grid-template-columns:1fr auto;gap:.45rem;font-weight:700;align-items:center}
  .chip-controls input{grid-column:1/-1;width:100%}
  .equation{text-align:center;font-size:1.45rem;font-weight:800;margin:1.1rem 0}
  .chip-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .chip-groups section,.remaining{border:1px solid #e5e9ef;border-radius:14px;padding:.9rem;background:#fafbfd}
  h4{margin:.1rem 0 .65rem}
  .chip-row{display:flex;gap:.4rem;flex-wrap:wrap;min-height:44px;align-items:center}
  .chip{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:50%;font-weight:800}
  .positive{background:#dbeafe;color:#174ea6;border:2px solid #174ea6}
  .negative{background:#fce7f3;color:#9d174d;border:2px solid #9d174d}
  .empty-chip{font-weight:800;color:#68758a}
  .zero-pair-panel{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:1rem 0;padding:.8rem 1rem;border-radius:14px;background:#f0fdf4}
  .zero-pair-panel>div{display:flex;align-items:center;gap:.4rem;font-weight:800}
  .zero-pair-panel p{margin:0}
  .remaining strong{display:block;margin-top:.75rem}
  @media(max-width:650px){.chip-controls,.chip-groups{grid-template-columns:1fr}.zero-pair-panel{align-items:flex-start;flex-direction:column}}
</style>
