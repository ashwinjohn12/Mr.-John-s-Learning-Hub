<div class="arcade" data-unit9-arcade>
 <div class="arcade-head"><div><p class="eyebrow">STATISTICS LAB ARCADE</p><h3>6 free-response missions · 2 from each lesson</h3><p>No answer choices. Use the experiment, proportion, or sample-size evidence and enter the number only.</p></div><div class="stats"><span data-score>0 pts</span><span data-streak>0 streak</span></div></div>
 <div class="progress"><span data-progress></span></div><div data-stage aria-live="polite"></div><div class="actions"><button type="button" data-check>Check mission</button><button type="button" data-next hidden>Next mission →</button><button type="button" class="soft" data-restart>New quest</button></div>
</div>
<script>
const banks:any[]=[
 {label:'9.1 · Conducting Experiments',missions:[
  {prompt:'A fair six-sided number cube is rolled. How many possible outcomes are there?',answer:6,explain:'The possible outcomes are 1,2,3,4,5,6.'},
  {prompt:'Results are H,T,H,H,T,H,T,H. What is the frequency of heads?',answer:5,explain:'Heads appears 5 times.'},
  {prompt:'A spinner has 12 equal sections: 6 red, 3 blue, and 3 green. To make the three colours equally likely, how many red sections must be reassigned to the other colours?',answer:2,explain:'Three colours sharing 12 equal sections need 4 sections each. Red has 6, so 2 red sections must be reassigned.'},
  {prompt:'A spinner has 8 equal sections: 4 red, 2 blue, 2 green. How many possible colour outcomes are listed?',answer:3,explain:'The colour outcomes are red, blue, and green.'}
 ]},
 {label:'9.2 · Relative Frequency',missions:[
  {prompt:'A category occurs 12 times in 30 trials. Enter its relative frequency as a percent number.',answer:40,explain:'12/30=0.40=40%.'},
  {prompt:'A category has relative frequency 25%. In 120 similar observations, about how many would you predict?',answer:30,explain:'25% of 120 = 30.'},
  {prompt:'Three categories are 35%, 25%, and 20%. Enter the missing percent needed to total 100%.',answer:20,explain:'35+25+20=80, leaving 20%.'},
  {prompt:'18 of 45 observations are in one category. Enter the relative frequency as a percent number.',answer:40,explain:'18/45=0.40=40%.'}
 ]},
 {label:'9.3 · Analyzing Relative Frequency',missions:[
  {prompt:'Sample A has 8 heads in 10 tosses. Sample B has 51 heads in 100 tosses. Enter the sample size that should usually guide the stronger estimate of a fair coin’s head likelihood.',answer:100,explain:'The 100-toss sample contains much more evidence and its 51% is close to the expected 50%.'},
  {prompt:'For samples of 40 and 80 rolls, how many total rolls are in the combined data?',answer:120,explain:'40+80=120 total rolls.'},
  {prompt:'A fair four-colour spinner is tested 400 times. About how many times would each colour be expected if results were perfectly even?',answer:100,explain:'25% of 400 = 100.'},
  {prompt:'A 200-trial sample reports 51 red results on a fair four-colour spinner. Enter the relative frequency as a percent number to the nearest tenth.',answer:25.5,explain:'51/200=0.255=25.5%, close to the expected 25%.'}
 ]}
];
document.querySelectorAll<HTMLElement>('[data-unit9-arcade]').forEach(widget=>{const stage=widget.querySelector<HTMLElement>('[data-stage]'),scoreEl=widget.querySelector('[data-score]'),streakEl=widget.querySelector('[data-streak]'),progress=widget.querySelector<HTMLElement>('[data-progress]'),check=widget.querySelector<HTMLButtonElement>('[data-check]'),next=widget.querySelector<HTMLButtonElement>('[data-next]'),restart=widget.querySelector<HTMLButtonElement>('[data-restart]');let pool:any[]=[],index=0,score=0,streak=0,locked=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(banks.flatMap(group=>shuffle(group.missions).slice(0,2).map((m:any)=>({...m,label:group.label}))));const norm=(v:string)=>Number(v.trim().replace(/[%,$]/g,'').replace(/,/g,''));const render=()=>{if(index>=pool.length){if(stage)stage.innerHTML=`<div class="finish"><div class="trophy">🏆</div><p class="eyebrow">QUEST COMPLETE</p><h3>${score>=550?'Statistics Specialist':'Data Explorer'}</h3><p>You earned ${score} points across all three lessons. Start a new quest for different missions.</p></div>`;if(check)check.hidden=true;if(next)next.hidden=true;if(progress)progress.style.width='100%';return;}const q=pool[index];locked=false;if(check){check.hidden=false;check.disabled=false;}if(next)next.hidden=true;if(stage)stage.innerHTML=`<div class="meta"><span>Mission ${index+1} of ${pool.length}</span><span>${q.label}</span></div><h3>${q.prompt}</h3><label class="answer-box">Your answer <input type="text" inputmode="decimal" data-answer autocomplete="off"/></label><div class="feedback" data-feedback hidden></div>`;if(progress)progress.style.width=`${index/pool.length*100}%`;};const submit=()=>{if(locked)return;const input=stage?.querySelector<HTMLInputElement>('[data-answer]');if(!input||input.value.trim()==='')return;locked=true;const q=pool[index],value=norm(input.value),ok=Math.abs(value-q.answer)<0.001;if(ok){streak++;score+=100+Math.max(0,streak-1)*10;}else streak=0;const f=stage?.querySelector<HTMLElement>('[data-feedback]');if(f){f.hidden=false;f.innerHTML=`<strong>${ok?'Mission solved!':'Not yet.'}</strong> ${q.explain}`;}input.disabled=true;if(scoreEl)scoreEl.textContent=`${score} pts`;if(streakEl)streakEl.textContent=`${streak} streak`;if(check)check.disabled=true;if(next){next.hidden=false;next.textContent=index===pool.length-1?'Finish quest':'Next mission →';}if(progress)progress.style.width=`${(index+1)/pool.length*100}%`;};const reset=()=>{pool=build();index=0;score=0;streak=0;if(scoreEl)scoreEl.textContent='0 pts';if(streakEl)streakEl.textContent='0 streak';if(check)check.hidden=false;render();};check?.addEventListener('click',submit);next?.addEventListener('click',()=>{index++;render();});restart?.addEventListener('click',reset);reset();});
</script>
<style>.arcade{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.1rem}.arcade-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.arcade-head h3{margin:.2rem 0}.arcade-head p{margin:.2rem 0;color:#64748b}.stats{display:flex;gap:.45rem;flex-wrap:wrap}.stats span{padding:.4rem .55rem;border-radius:9px;background:var(--course-soft);font-weight:900;white-space:nowrap}.progress{height:9px;border-radius:99px;background:#e9eef5;overflow:hidden;margin:.8rem 0}.progress span{display:block;height:100%;width:0;background:var(--course);transition:width .25s}.meta{display:flex;justify-content:space-between;gap:.8rem;margin:.8rem 0 .2rem;color:#64748b;font-size:.78rem;font-weight:900;text-transform:uppercase}.answer-box{display:grid;gap:.35rem;margin:1rem 0;font-weight:850}.answer-box input{max-width:260px;border:2px solid #ccd6e2;border-radius:11px;padding:.72rem;font:inherit}.feedback{padding:.75rem;border-radius:11px;background:#f7f9fc}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.actions button{border:0;border-radius:11px;padding:.7rem .95rem;background:var(--course);color:#fff;font-weight:850;cursor:pointer}.actions .soft{background:#eef3f9;color:#25364f}.actions button:disabled{opacity:.45}.finish{text-align:center;padding:1.2rem}.trophy{font-size:2.4rem}@media(max-width:650px){.arcade-head,.meta{display:grid}.stats{justify-content:start}}</style>
