---
import type{Unit6Lesson}from'../data/grade7Unit6';const{lesson}=Astro.props as{lesson:Unit6Lesson};const C:any={'solving-equations':['systematic trial and inspection','dollars per activity','the verified price produces the exact total','approve the $6 activity price'],'model-solving-equations':['balanced scale with three equal crate groups','kilograms per crate','both scale pans total 20 kg','label each crate as 5 kg'],'equations-involving-integers':['signed integer tiles and zero pairs','degrees Celsius','the starting temperature plus 6°C equals −1°C','record the starting temperature as −7°C'],'solving-equations-algebraically':['balanced inverse-operation steps','weeks','eight deposits plus the starting amount reach $136','schedule eight weekly deposits'],'different-methods-equations':['algebra compared with inspection','dollars per trip','both valid methods give the same $7 value','recommend algebra with substitution check']};const c=C[lesson.slug];
---
<div class="apply" data-unit6-apply data-config={JSON.stringify(c)}><header><h3>{lesson.apply.title}</h3><p>{lesson.apply.scenario}</p></header><fieldset><legend>Equation and solution</legend>{lesson.apply.values.map(v=><label>{v.label}<input data-value data-answer={v.answer}/></label>)}</fieldset><fieldset><legend>Independent model and interpretation checks</legend><label>Required method<select data-method><option value="">Choose</option><option>{c[0]}</option><option>a one-sided move that changes equality</option></select></label><label>Contextual unit<input data-unit/></label><label>Verified comparison<select data-comparison><option value="">Choose</option><option>{c[2]}</option><option>the answer looks reasonable without substitution</option></select></label><label>Supported decision<select data-decision><option value="">Choose</option><option>{c[3]}</option><option>accept any value with the correct unit</option></select></label><button type="button" data-build>Build verified representation</button><div data-display role="img" aria-label="Application model not built."></div><p data-transcript>Model transcript: not built.</p></fieldset><ol>{lesson.apply.tasks.map((task,i)=><li><label><b>Task {i+1}: {task}</b><textarea data-evidence rows="3"></textarea></label></li>)}</ol><p class="note">Written explanations are evidence for student or teacher review. They are never graded by length, digits, keywords, or similarity.</p><button type="button" data-check>Verify the complete application</button><p data-status role="status" tabindex="-1">Complete the equation, model, solution, verification, unit, comparison, and decision.</p></div>
<script>document.querySelectorAll<HTMLElement>('[data-unit6-apply]').forEach(root=>{const c=JSON.parse(root.dataset.config||'[]'),status=root.querySelector<HTMLElement>('[data-status]'),display=root.querySelector<HTMLElement>('[data-display]'),transcript=root.querySelector<HTMLElement>('[data-transcript]');let built=false;const norm=(s:string)=>s.toLowerCase().trim().replace(/\s/g,'').replace(/−/g,'-').replace(/\*/g,''),invalidate=()=>{built=false;root.dataset.verified='false';if(display){display.innerHTML='';display.setAttribute('aria-label','Application model not built.')}if(transcript)transcript.textContent='Model transcript: not built.';if(status)status.textContent='Evidence changed. Rebuild and verify again.'};root.querySelectorAll('input,select,textarea').forEach(x=>{x.addEventListener('input',invalidate);x.addEventListener('change',invalidate)});root.querySelector('[data-build]')?.addEventListener('click',()=>{const values=[...root.querySelectorAll<HTMLInputElement>('[data-value]')],method=root.querySelector<HTMLSelectElement>('[data-method]')?.value,ok=values.every(x=>norm(x.value)===norm(x.dataset.answer||''))&&method===c[0];if(!ok){if(status)status.textContent='The equation, solution, both substitution values, and method must agree.';return}built=true;const text=`${method}; ${values.map(x=>x.dataset.answer).join('; ')}.`;if(display){display.innerHTML=`<strong>${method}</strong><div class="balance"><span>LHS</span><i>=</i><span>RHS</span></div>`;display.setAttribute('aria-label',text)}if(transcript)transcript.textContent=`Model transcript: ${text}`;if(status)status.textContent='Representation verified. Complete the contextual evidence.'});root.querySelector('[data-check]')?.addEventListener('click',()=>{const bad=[...root.querySelectorAll<HTMLInputElement>('[data-value]')].find(x=>norm(x.value)!==norm(x.dataset.answer||'')),unit=root.querySelector<HTMLInputElement>('[data-unit]')?.value.trim(),comparison=root.querySelector<HTMLSelectElement>('[data-comparison]')?.value,decision=root.querySelector<HTMLSelectElement>('[data-decision]')?.value,missing=[...root.querySelectorAll<HTMLTextAreaElement>('[data-evidence]')].find(x=>!x.value.trim()),ok=!bad&&built&&unit===c[1]&&comparison===c[2]&&decision===c[3]&&!missing;root.dataset.verified=String(ok);if(status)status.innerHTML=bad?'<strong>Revise the equation or verification.</strong> Each value is checked independently.':!built?'<strong>Rebuild the model.</strong> A correct solution with an invalid method cannot pass.':unit!==c[1]?'<strong>Revise the unit.</strong> Interpret the variable in context.':comparison!==c[2]?'<strong>Revise the comparison.</strong> Use substitution evidence.':decision!==c[3]?'<strong>Revise the decision.</strong> It must follow from verified evidence.':missing?'<strong>Record evidence for every task.</strong> Wording is stored, not automatically judged.':'<strong>Application complete.</strong> Equation, method, model, solution, verification, unit, and decision agree.';status?.focus({preventScroll:true})})});</script>
<style>.apply{overflow:hidden;border-radius:16px;background:#251545;color:#fff}.apply header{padding:1rem;background:#493173}.apply fieldset,.apply ol,.apply .note,.apply>[data-status]{margin:1rem}.apply fieldset{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;border:1px solid #ffffff44;border-radius:10px}.apply label{display:grid;gap:.35rem}.apply input,.apply textarea,.apply select{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #b9acd0;font:inherit}.apply button{min-height:44px;padding:.65rem;border:0;border-radius:8px;background:#f4c95d;color:#241445;font-weight:850}.apply [data-display]{padding:.8rem;background:#fff;color:#17243a}.balance{display:grid;grid-template-columns:1fr 50px 1fr;text-align:center;padding:.6rem}.note{color:#e9defc}.apply :focus-visible{outline:3px solid #ffd75e;outline-offset:2px}@media(max-width:650px){.apply fieldset{grid-template-columns:1fr}}@media(max-width:390px){.apply fieldset,.apply ol{margin:.7rem;padding:.75rem;overflow-wrap:anywhere}}@media(prefers-reduced-motion:reduce){.apply *{animation:none!important;transition:none!important}}</style>
