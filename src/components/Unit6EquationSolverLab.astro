<div class="lab" data-solver-lab>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART A · CHOOSE THE INVERSE</p><h3>What should you undo first?</h3></div><button type="button" class="secondary" data-new-first>New equation</button></div><p class="challenge" data-first-prompt></p><div class="choices" data-first-choices></div><p class="feedback" data-first-feedback>Look at the operation closest to the variable term.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART B · SOLVE ALGEBRAICALLY</p><h3>Record the balanced steps</h3></div><button type="button" class="secondary" data-new-solve>New challenge</button></div><p class="challenge" data-solve-prompt></p><div class="steps" data-steps></div><div class="answer-row"><input type="number" step="0.1" data-answer aria-label="Solution"><button type="button" data-check>Check solution</button></div><button type="button" class="hint" data-show-step>Show next step</button><p class="feedback" data-feedback>Try to simplify and choose inverse operations before opening a step.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART C · VERIFY LHS = RHS</p><h3>Does the proposed solution work?</h3></div><button type="button" class="secondary" data-new-verify>New verification</button></div><p class="challenge" data-verify-prompt></p><div class="verify-grid"><span data-lhs></span><b data-sign>=?</b><span data-rhs></span></div><div class="choices"><button type="button" data-verify-choice="yes">It is a solution</button><button type="button" data-verify-choice="no">It is not a solution</button></div><p class="feedback" data-verify-feedback>Substitute the proposed value into the original equation.</p></section>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-solver-lab]').forEach(lab=>{
  const firsts=[{q:'3x − 4 = 11',choices:['Add 4 to both sides','Subtract 4 from both sides','Divide both sides by 3 first'],a:0,e:'Undo −4 by adding 4 to both sides.'},{q:'2x + 7 = 19',choices:['Subtract 7 from both sides','Add 7 to both sides','Divide both sides by 7'],a:0,e:'Undo +7 by subtracting 7 from both sides.'},{q:'5x = 35',choices:['Divide both sides by 5','Subtract 5 from both sides','Add 5 to both sides'],a:0,e:'Undo multiplication by 5 with division by 5.'},{q:'3(x + 2) = 15',choices:['You can divide both sides by 3','Subtract 2 from only the left','Add 3 to both sides'],a:0,e:'Dividing both sides by 3 preserves equality and leaves x + 2 = 5.'}];let fi=0;const fp=lab.querySelector('[data-first-prompt]');const fc=lab.querySelector<HTMLElement>('[data-first-choices]');const ff=lab.querySelector<HTMLElement>('[data-first-feedback]');const renderFirst=()=>{fi=Math.floor(Math.random()*firsts.length);const t=firsts[fi];if(fp)fp.textContent=t.q;if(fc){fc.innerHTML=t.choices.map((c,i)=>`<button type="button" data-first-choice="${i}">${c}</button>`).join('');fc.querySelectorAll<HTMLButtonElement>('[data-first-choice]').forEach(b=>b.addEventListener('click',()=>{if(ff)ff.innerHTML=Number(b.dataset.firstChoice)===t.a?`<strong>Correct.</strong> ${t.e}`:'<strong>Not yet.</strong> Choose an operation that undoes the equation while staying balanced.';}));}if(ff)ff.textContent='Look at the operation closest to the variable term.';};lab.querySelector('[data-new-first]')?.addEventListener('click',renderFirst);renderFirst();
  const solves=[{q:'3x − 4 = 11',a:5,steps:['Add 4 to both sides: 3x = 15.','Divide both sides by 3: x = 5.']},{q:'4x + 2x − 6 = 12',a:3,steps:['Combine like terms: 6x − 6 = 12.','Add 6 to both sides: 6x = 18.','Divide both sides by 6: x = 3.']},{q:'2(x + 5) = 18',a:4,steps:['Divide both sides by 2: x + 5 = 9.','Subtract 5 from both sides: x = 4.']},{q:'n − 1.8 = 2.6',a:4.4,steps:['Add 1.8 to both sides: n = 4.4.']}];let si=0;let stepIndex=0;const sp=lab.querySelector('[data-solve-prompt]');const steps=lab.querySelector<HTMLElement>('[data-steps]');const ans=lab.querySelector<HTMLInputElement>('[data-answer]');const sf=lab.querySelector<HTMLElement>('[data-feedback]');const renderSolve=()=>{si=Math.floor(Math.random()*solves.length);stepIndex=0;const t=solves[si];if(sp)sp.textContent=`Solve ${t.q}.`;if(steps)steps.innerHTML='';if(ans)ans.value='';if(sf)sf.textContent='Try to simplify and choose inverse operations before opening a step.';};lab.querySelector('[data-new-solve]')?.addEventListener('click',renderSolve);lab.querySelector('[data-show-step]')?.addEventListener('click',()=>{const t=solves[si];if(stepIndex<t.steps.length&&steps){steps.insertAdjacentHTML('beforeend',`<div><span>${stepIndex+1}</span>${t.steps[stepIndex]}</div>`);stepIndex++;}});lab.querySelector('[data-check]')?.addEventListener('click',()=>{const t=solves[si];const ok=Math.abs(Number(ans?.value)-t.a)<.001;if(sf)sf.innerHTML=ok?'<strong>Correct.</strong> Your solution keeps the equation balanced. Use Part C to practise verification.':'<strong>Not yet.</strong> Check your simplification and inverse operations.';});renderSolve();
  const verifies=[{q:'2x + 3 = 11 with x = 4',lhs:11,rhs:11,yes:true,e:'2(4)+3 = 11, which equals the RHS.'},{q:'2x + 5 = 12 with x = 3',lhs:11,rhs:12,yes:false,e:'2(3)+5 = 11, not 12.'},{q:'x − 1 = −5 with x = −4',lhs:-5,rhs:-5,yes:true,e:'−4 − 1 = −5, which matches the RHS.'},{q:'3(x + 1) = 15 with x = 5',lhs:18,rhs:15,yes:false,e:'3(5+1) = 18, not 15.'}];let vi=0;const vp=lab.querySelector('[data-verify-prompt]');const lhs=lab.querySelector('[data-lhs]');const rhs=lab.querySelector('[data-rhs]');const sign=lab.querySelector('[data-sign]');const vf=lab.querySelector<HTMLElement>('[data-verify-feedback]');const renderVerify=()=>{vi=Math.floor(Math.random()*verifies.length);const t=verifies[vi];if(vp)vp.textContent=`Verify ${t.q}.`;if(lhs)lhs.textContent=`LHS = ${t.lhs}`;if(rhs)rhs.textContent=`RHS = ${t.rhs}`;if(sign)sign.textContent='=?';if(vf)vf.textContent='Substitute the proposed value into the original equation.';};lab.querySelector('[data-new-verify]')?.addEventListener('click',renderVerify);lab.querySelectorAll<HTMLButtonElement>('[data-verify-choice]').forEach(b=>b.addEventListener('click',()=>{const t=verifies[vi];const choice=b.dataset.verifyChoice==='yes';if(sign)sign.textContent=t.lhs===t.rhs?'=':'≠';if(vf)vf.innerHTML=choice===t.yes?`<strong>Correct.</strong> ${t.e}`:`<strong>Not yet.</strong> ${t.e}`;}));renderVerify();
 });
</script>
<style>.lab{display:grid;gap:1rem}.panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.head h3{margin:.2rem 0 .7rem}.secondary,.choices button,.answer-row button{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.challenge{font-size:1.12rem;font-weight:900}.choices{display:grid;gap:.6rem}.choices button{text-align:left}.answer-row{display:flex;gap:.6rem;margin-top:.8rem}.answer-row input{flex:1;max-width:280px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.hint{margin-top:.65rem;border:0;background:transparent;color:var(--course);font-weight:900;cursor:pointer}.feedback{padding:.75rem .85rem;border-radius:12px;background:#f7f9fc}.steps{display:grid;gap:.5rem}.steps div{display:flex;gap:.6rem;align-items:start;padding:.65rem;border-radius:10px;background:#f7f9fc}.steps span{display:grid;place-items:center;min-width:26px;height:26px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.verify-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center;margin:.8rem 0}.verify-grid span{padding:.9rem;border-radius:12px;background:var(--course-soft);text-align:center;font-weight:900}@media(max-width:650px){.head,.answer-row,.verify-grid{display:grid}.secondary{justify-self:start}.answer-row input{max-width:none}}</style>