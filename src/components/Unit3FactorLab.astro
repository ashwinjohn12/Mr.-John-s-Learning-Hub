---
---
<div class="factor-lab" data-factor-lab>
  <section class="lab-stage">
    <div class="stage-head"><span>1</span><div><p class="eyebrow">PRIME DETECTIVE</p><h3>Prime or composite?</h3><p>Make a prediction before any factors are revealed.</p></div></div>
    <div class="detect-number" data-detect-number>37</div>
    <div class="choice-row"><button type="button" data-detect-choice="prime">Prime</button><button type="button" data-detect-choice="composite">Composite</button></div>
    <div class="lab-feedback" data-detect-feedback aria-live="polite"></div>
    <button type="button" class="secondary" data-detect-new>Try another number</button>
  </section>

  <section class="lab-stage">
    <div class="stage-head"><span>2</span><div><p class="eyebrow">FACTOR TREE BUILDER</p><h3>Build the prime factors</h3><p>Choose a factor pair for each composite branch. Keep going until every leaf is prime.</p></div></div>
    <div class="tree-controls"><strong>Start with:</strong>{[36,48,60,72,84,90].map((n)=><button type="button" data-tree-start={n}>{n}</button>)}</div>
    <div class="tree-workspace">
      <div class="tree-visual" data-tree-visual></div>
      <div class="tree-task"><p class="mini-label">CURRENT BRANCH</p><strong data-tree-current></strong><div class="tree-options" data-tree-options></div></div>
    </div>
    <div class="lab-feedback" data-tree-feedback aria-live="polite"></div>
  </section>

  <section class="lab-stage">
    <div class="stage-head"><span>3</span><div><p class="eyebrow">DIVISIBILITY INVESTIGATOR</p><h3>Do the needed prime factors fit?</h3><p>Decide first. Then compare the prime factors as evidence.</p></div></div>
    <div class="division-question"><strong data-div-whole>84</strong><span>÷</span><strong data-div-divisor>14</strong><span>— divides evenly?</span></div>
    <div class="choice-row"><button type="button" data-div-choice="yes">Yes</button><button type="button" data-div-choice="no">No</button></div>
    <div class="factor-compare" data-div-compare hidden></div>
    <div class="lab-feedback" data-div-feedback aria-live="polite"></div>
    <button type="button" class="secondary" data-div-new>New divisibility challenge</button>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-factor-lab]').forEach((widget) => {
    const factorize=(value:number)=>{const out:number[]=[];let n=value;for(let p=2;p*p<=n;p++){while(n%p===0){out.push(p);n/=p;}}if(n>1)out.push(n);return out;};
    const factors=(value:number)=>{const out:number[]=[];for(let i=1;i<=Math.sqrt(value);i++){if(value%i===0){out.push(i);if(i!==value/i)out.push(value/i);}}return out.sort((a,b)=>a-b);};
    const isPrime=(value:number)=>value>1&&factorize(value).length===1&&factorize(value)[0]===value;
    const shuffle=<T,>(items:T[])=>[...items].sort(()=>Math.random()-.5);

    const detectPool=[17,21,29,31,35,37,49,53,57,61,77,83,91,97];
    const detectNumber=widget.querySelector<HTMLElement>('[data-detect-number]');
    const detectFeedback=widget.querySelector<HTMLElement>('[data-detect-feedback]');
    let currentDetect=37;
    const newDetect=()=>{currentDetect=shuffle(detectPool)[0];if(detectNumber)detectNumber.textContent=String(currentDetect);if(detectFeedback)detectFeedback.innerHTML='';};
    widget.querySelectorAll<HTMLButtonElement>('[data-detect-choice]').forEach((button)=>button.addEventListener('click',()=>{
      const prime=isPrime(currentDetect);const guess=button.dataset.detectChoice==='prime';const list=factors(currentDetect).join(', ');
      if(detectFeedback)detectFeedback.innerHTML=guess===prime
        ? `<strong>Correct.</strong> ${currentDetect} is ${prime?'prime':'composite'}. Its factors are ${list}.`
        : `<strong>Check the factor evidence.</strong> ${currentDetect} is ${prime?'prime':'composite'} because its factors are ${list}.`;
    }));
    widget.querySelector('[data-detect-new]')?.addEventListener('click',newDetect);

    type TreeNode={value:number;children?:[TreeNode,TreeNode]};
    const treeVisual=widget.querySelector<HTMLElement>('[data-tree-visual]');
    const treeCurrent=widget.querySelector<HTMLElement>('[data-tree-current]');
    const treeOptions=widget.querySelector<HTMLElement>('[data-tree-options]');
    const treeFeedback=widget.querySelector<HTMLElement>('[data-tree-feedback]');
    let treeTarget=72;
    let treeRoot:TreeNode={value:72};
    const findOpen=(node:TreeNode):TreeNode|null=>{if(node.children){return findOpen(node.children[0])||findOpen(node.children[1]);}return isPrime(node.value)?null:node;};
    const pairs=(value:number)=>{const out:[number,number][]=[];for(let i=2;i<=Math.sqrt(value);i++){if(value%i===0)out.push([i,value/i]);}return out;};
    const renderNode=(node:TreeNode):HTMLElement=>{
      const wrap=document.createElement('div');wrap.className='tree-branch';
      const badge=document.createElement('span');badge.className=`tree-node ${isPrime(node.value)?'is-prime':''}`;badge.textContent=String(node.value);wrap.appendChild(badge);
      if(node.children){const kids=document.createElement('div');kids.className='tree-children';kids.appendChild(renderNode(node.children[0]));kids.appendChild(renderNode(node.children[1]));wrap.appendChild(kids);}return wrap;
    };
    const renderTree=()=>{
      if(treeVisual){treeVisual.innerHTML='';treeVisual.appendChild(renderNode(treeRoot));}
      const current=findOpen(treeRoot);
      if(!current){const pf=factorize(treeTarget);if(treeCurrent)treeCurrent.textContent='Complete!';if(treeOptions)treeOptions.innerHTML='';if(treeFeedback)treeFeedback.innerHTML=`<strong>Tree complete.</strong> ${treeTarget} = ${pf.join(' × ')}. Every final branch is prime.`;return;}
      if(treeCurrent)treeCurrent.textContent=String(current.value);
      if(treeFeedback)treeFeedback.innerHTML='';
      if(treeOptions){treeOptions.innerHTML='';pairs(current.value).forEach(([a,b])=>{const button=document.createElement('button');button.type='button';button.textContent=`${a} × ${b}`;button.addEventListener('click',()=>{current.children=[{value:a},{value:b}];renderTree();});treeOptions.appendChild(button);});}
    };
    const resetTree=(target:number)=>{treeTarget=target;treeRoot={value:target};renderTree();};
    widget.querySelectorAll<HTMLButtonElement>('[data-tree-start]').forEach((button)=>button.addEventListener('click',()=>resetTree(Number(button.dataset.treeStart||72))));

    const divChallenges=[
      {whole:84,divisor:14},{whole:90,divisor:15},{whole:72,divisor:18},{whole:84,divisor:18},
      {whole:98,divisor:21},{whole:105,divisor:15},{whole:96,divisor:20},{whole:126,divisor:14}
    ];
    const divWhole=widget.querySelector<HTMLElement>('[data-div-whole]');
    const divDivisor=widget.querySelector<HTMLElement>('[data-div-divisor]');
    const divCompare=widget.querySelector<HTMLElement>('[data-div-compare]');
    const divFeedback=widget.querySelector<HTMLElement>('[data-div-feedback]');
    let divCurrent=divChallenges[0];
    const countMap=(values:number[])=>values.reduce<Record<number,number>>((acc,n)=>{acc[n]=(acc[n]||0)+1;return acc;},{});
    const newDiv=()=>{divCurrent=shuffle(divChallenges)[0];if(divWhole)divWhole.textContent=String(divCurrent.whole);if(divDivisor)divDivisor.textContent=String(divCurrent.divisor);if(divCompare){divCompare.hidden=true;divCompare.innerHTML='';}if(divFeedback)divFeedback.innerHTML='';};
    const renderCompare=()=>{
      if(!divCompare)return;
      const wholePF=factorize(divCurrent.whole);const divisorPF=factorize(divCurrent.divisor);const available=countMap(wholePF);const needed=countMap(divisorPF);
      const used:Record<number,number>={};
      const wholeChips=wholePF.map((p)=>{used[p]=(used[p]||0)+1;const matched=used[p]<=(needed[p]||0);return `<span class="factor-chip ${matched?'is-match':''}">${p}</span>`;}).join('');
      const divisorChips=divisorPF.map((p,index)=>{const before=divisorPF.slice(0,index+1).filter(x=>x===p).length;const missing=before>(available[p]||0);return `<span class="factor-chip ${missing?'is-missing':'is-needed'}">${p}</span>`;}).join('');
      divCompare.innerHTML=`<div><small>${divCurrent.whole}</small>${wholeChips}</div><div><small>${divCurrent.divisor}</small>${divisorChips}</div>`;divCompare.hidden=false;
    };
    widget.querySelectorAll<HTMLButtonElement>('[data-div-choice]').forEach((button)=>button.addEventListener('click',()=>{
      const divisible=divCurrent.whole%divCurrent.divisor===0;const guess=button.dataset.divChoice==='yes';renderCompare();
      const wholePF=factorize(divCurrent.whole);const divisorPF=factorize(divCurrent.divisor);const available=countMap(wholePF);const needed=countMap(divisorPF);
      const missing=Object.keys(needed).flatMap((key)=>{const p=Number(key);const shortage=needed[p]-(available[p]||0);return shortage>0?Array(shortage).fill(p):[];});
      const reason=divisible
        ? `${divCurrent.divisor} needs ${divisorPF.join(' × ')}, and those prime factors are all available in ${divCurrent.whole}. The quotient is ${divCurrent.whole/divCurrent.divisor}.`
        : `${divCurrent.divisor} needs ${divisorPF.join(' × ')}, but ${divCurrent.whole} does not have enough ${missing.join(' and ')} factors.`;
      if(divFeedback)divFeedback.innerHTML=`<strong>${guess===divisible?'Correct.':'Not quite.'}</strong> ${reason}`;
    }));
    widget.querySelector('[data-div-new]')?.addEventListener('click',newDiv);

    newDetect();resetTree(72);newDiv();
  });
</script>

<style>
.factor-lab{display:grid;gap:1rem}.lab-stage{border:1px solid #d9e2ec;border-radius:18px;background:#fff;padding:1rem}.stage-head{display:grid;grid-template-columns:42px 1fr;gap:.8rem;align-items:start}.stage-head>span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#174ea6;color:#fff;font-weight:900}.stage-head h3{margin:.1rem 0 .25rem}.stage-head p{margin:.15rem 0}.detect-number{margin:1rem 0;text-align:center;font-size:2.2rem;font-weight:900}.choice-row,.tree-controls,.tree-options{display:flex;gap:.55rem;flex-wrap:wrap;align-items:center}.choice-row button,.tree-controls button,.tree-options button{border:0;border-radius:10px;padding:.65rem .9rem;background:#174ea6;color:#fff;font-weight:800;cursor:pointer}.secondary{margin-top:.7rem;border:0;border-radius:10px;padding:.6rem .85rem;background:#eef3f9;color:#25364f;font-weight:800;cursor:pointer}.lab-feedback{margin-top:.8rem;padding:.8rem .9rem;border-radius:12px;background:#f8fafc;min-height:1.25rem}.lab-feedback:empty{display:none}.tree-controls{margin:1rem 0}.tree-workspace{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(210px,.7fr);gap:1rem;align-items:start}.tree-visual{min-height:220px;padding:1rem;border-radius:14px;background:#f8fafc;overflow:auto}.tree-branch{display:grid;justify-items:center;position:relative;min-width:74px}.tree-node{display:grid;place-items:center;min-width:50px;height:42px;padding:0 .45rem;border:2px solid #94a3b8;border-radius:12px;background:#fff;font-weight:900}.tree-node.is-prime{border-style:dashed}.tree-children{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.3rem;position:relative}.tree-children:before{content:'';position:absolute;top:-.65rem;left:25%;right:25%;border-top:2px solid #cbd5e1}.tree-children>.tree-branch:before{content:'';position:absolute;top:-1.3rem;height:.65rem;border-left:2px solid #cbd5e1}.tree-task{padding:1rem;border:1px solid #e2e8f0;border-radius:14px}.tree-task>strong{display:block;font-size:1.6rem;margin:.3rem 0 .8rem}.division-question{display:flex;gap:.7rem;align-items:center;justify-content:center;flex-wrap:wrap;margin:1rem 0;padding:1rem;border-radius:14px;background:#f8fafc;font-size:1.25rem}.division-question strong{font-size:1.6rem}.factor-compare{display:grid;gap:.7rem;margin-top:.8rem}.factor-compare>div{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;padding:.7rem;border:1px solid #e2e8f0;border-radius:12px}.factor-compare small{min-width:42px;font-weight:900}.factor-chip{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:2px solid #94a3b8;background:#fff;font-weight:900}.factor-chip.is-match,.factor-chip.is-needed{border-style:solid}.factor-chip.is-missing{border-style:dashed}.mini-label{font-size:.72rem;font-weight:900;letter-spacing:.08em;color:#64748b;margin:0}@media(max-width:700px){.tree-workspace{grid-template-columns:1fr}.stage-head{grid-template-columns:36px 1fr}.tree-visual{min-height:180px}}
</style>
