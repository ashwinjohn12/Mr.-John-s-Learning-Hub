---
const stages=[
 {title:'1 · Convert the recipe',prompt:'A batch uses 3/4 kg oats. Convert it, then compare it with a 0.68 kg supplier bag.',fields:[['3/4 as a decimal','.75'],['Larger quantity','.75']],model:'fraction strip and division record',modelValues:['3','4'],estimate:[.7,.8]},
 {title:'2 · Build the stock order',prompt:'Buy 12.45 kg oats and 7.80 kg fruit, then use 3.25 kg for samples.',fields:[['Starting total','20.25'],['After samples','17']],model:'aligned place-value record',modelValues:['20.25','3.25'],estimate:[16,18]},
 {title:'3 · Price the packages',prompt:'Make 12 packages at $2.35 each. Divide the total equally across 3 tables.',fields:[['Package revenue','28.2'],['Revenue per table','9.4']],model:'area and equal-sharing model',modelValues:['12','2.35'],estimate:[27,30]},
 {title:'4 · Audit the expression',prompt:'Evaluate 48 − 3 × (6.40 + 2.10) for the amount remaining after grouped expenses.',fields:[['Grouped expense','25.5'],['Amount remaining','22.5']],model:'expression tree',modelValues:['6.4','2.1'],estimate:[20,25]},
 {title:'5 · Apply the market discount',prompt:'A $48 display receives a 25% discount. Find the discount and sale price.',fields:[['Discount','12'],['Sale price','36']],model:'percent bar and double number line',modelValues:['25','48'],estimate:[10,15]}
];
---
<div class="arcade" data-unit3-arcade><header><p class="eyebrow">FIVE-STAGE MATH ARCADE</p><h3>Market Day Mission</h3><p>Complete a connected market plan. Every calculation and model state is checked separately; your written reasoning is recorded for review.</p></header><div class="arcade-progress" role="status" data-progress>Stage 1 of 5 ready.</div>
{stages.map((s,i)=><section data-stage={i} data-model={s.model} data-estimate-min={s.estimate[0]} data-estimate-max={s.estimate[1]} hidden={i!==0}><h4 tabindex="-1">{s.title}</h4><p>{s.prompt}</p><label>Checkable estimate<input data-predict inputmode="decimal"/></label><div class="fields">{s.fields.map(f=><label>{f[0]}<input data-value data-answer={f[1]} inputmode="decimal"/></label>)}</div><fieldset><legend>Build {s.model}</legend><label>First required model quantity<input data-model-a data-answer={s.modelValues[0]} inputmode="decimal"/></label><label>Second required model quantity<input data-model-b data-answer={s.modelValues[1]} inputmode="decimal"/></label><button type="button" data-build>Build {s.model}</button><div data-display role="img" aria-label="Model not built."></div><p data-transcript>Model transcript: not built.</p></fieldset><label>Reasoning evidence<textarea data-evidence rows="3"></textarea></label><button type="button" data-verify>Verify and continue</button><p data-status role="status">Not verified.</p></section>)}
<div class="final" data-final hidden><h4 tabindex="-1">Final market recommendation</h4><p>Use all five verified stages. Report the recipe amount, stock after samples, revenue per table, grouped-expense remainder, discount, and sale price.</p><div class="final-grid">{[['Recipe decimal','.75'],['Stock after samples','17'],['Revenue per table','9.4'],['Expense remainder','22.5'],['Discount','12'],['Sale price','36']].map(f=><label>{f[0]}<input data-final-value data-answer={f[1]} inputmode="decimal"/></label>)}</div><label>Supported plan<select data-plan><option value="">Choose</option><option value="sell">Use the $36 sale price and the verified quantities</option><option value="discount">Charge only the $12 discount</option><option value="stock">Ignore the stock and table calculations</option></select></label><label>Final decision evidence<textarea data-final-evidence rows="4"></textarea></label><button type="button" data-finish>Complete mission</button><p data-final-status role="status" tabindex="-1">Complete the verified plan.</p></div></div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit3-arcade]').forEach(root=>{const stages=[...root.querySelectorAll<HTMLElement>('[data-stage]')],done=new Set<number>(),progress=root.querySelector<HTMLElement>('[data-progress]'),final=root.querySelector<HTMLElement>('[data-final]');const close=(a:string,b:string)=>Math.abs(Number(a.replace(/[$,%]/g,''))-Number(b))<.001;const modelBuilt=new Set<number>();
 const invalidate=(i:number)=>{for(let j=i;j<stages.length;j++){done.delete(j);modelBuilt.delete(j);stages[j].hidden=j!==i;const status=stages[j].querySelector<HTMLElement>('[data-status]');if(status)status.textContent=j===i?'Earlier evidence changed. Rebuild and verify this stage.':'Locked until the earlier stage is verified again.';}if(final)final.hidden=true;root.dataset.complete='false';if(progress)progress.textContent=`Evidence changed. Stage ${i+1} must be verified again.`;};
 stages.forEach((stage,i)=>{stage.querySelectorAll('input,select,textarea').forEach(c=>{c.addEventListener('input',()=>{if(done.has(i)||modelBuilt.has(i))invalidate(i)});c.addEventListener('change',()=>{if(done.has(i)||modelBuilt.has(i))invalidate(i)})});stage.querySelector('[data-build]')?.addEventListener('click',()=>{const aBox=stage.querySelector<HTMLInputElement>('[data-model-a]'),bBox=stage.querySelector<HTMLInputElement>('[data-model-b]'),a=aBox?.value.trim()||'',b=bBox?.value.trim()||'',display=stage.querySelector<HTMLElement>('[data-display]'),transcript=stage.querySelector<HTMLElement>('[data-transcript]'),valid=close(a,aBox?.dataset.answer||'')&&close(b,bBox?.dataset.answer||'');if(!valid){stage.querySelector<HTMLElement>('[data-status]')!.textContent='The model quantities must match the stage relationship.';return}modelBuilt.add(i);const type=stage.dataset.model||'mathematical',width=Math.max(10,Math.min(100,Number(a)/(Math.abs(Number(a))+Math.abs(Number(b))||1)*100));if(display){display.innerHTML=`<b>${type}</b><span class="stage-model stage-${i+1}" style="width:${width}%"></span><i>${a} · ${b}</i>`;display.setAttribute('aria-label',`${type} with verified quantities ${a} and ${b}.`)}if(transcript)transcript.textContent=`Model transcript: ${type} with verified quantities ${a} and ${b}.`;});
 stage.querySelector('[data-verify]')?.addEventListener('click',()=>{const values=[...stage.querySelectorAll<HTMLInputElement>('[data-value]')],prediction=Number(stage.querySelector<HTMLInputElement>('[data-predict]')?.value.trim()),evidence=stage.querySelector<HTMLTextAreaElement>('[data-evidence]')?.value.trim(),status=stage.querySelector<HTMLElement>('[data-status]'),bad=values.find(x=>!close(x.value,x.dataset.answer||'')),estimateOk=Number.isFinite(prediction)&&prediction>=Number(stage.dataset.estimateMin)&&prediction<=Number(stage.dataset.estimateMax),ok=estimateOk&&!bad&&modelBuilt.has(i)&&!!evidence;if(!ok){if(status)status.innerHTML=bad?'<strong>Revise a calculation.</strong> Each required value is checked independently.':!estimateOk?'<strong>Revise the estimate.</strong> It must be reasonable for this stage.':!modelBuilt.has(i)?'<strong>Build the required model.</strong> Its quantities must match the stage.':'<strong>Record your reasoning.</strong> Writing is stored, not keyword graded.';return}done.add(i);if(status)status.innerHTML='<strong>Verified.</strong>';stage.hidden=true;if(i<4){stages[i+1].hidden=false;stages[i+1].querySelector<HTMLElement>('h4')?.focus();if(progress)progress.textContent=`Stage ${i+2} of 5 ready.`;}else if(final){final.hidden=false;final.querySelector<HTMLElement>('h4')?.focus();if(progress)progress.textContent='All five stages verified. Complete the final synthesis.';}});
 });final?.querySelectorAll('input,select,textarea').forEach(c=>{c.addEventListener('input',()=>{root.dataset.complete='false';const out=root.querySelector<HTMLElement>('[data-final-status]');if(out)out.textContent='Final evidence changed. Verify the decision again.';});c.addEventListener('change',()=>{root.dataset.complete='false'})});root.querySelector('[data-finish]')?.addEventListener('click',()=>{const values=[...root.querySelectorAll<HTMLInputElement>('[data-final-value]')],bad=values.find(x=>!close(x.value,x.dataset.answer||'')),plan=root.querySelector<HTMLSelectElement>('[data-plan]')?.value,evidence=root.querySelector<HTMLTextAreaElement>('[data-final-evidence]')?.value.trim(),out=root.querySelector<HTMLElement>('[data-final-status]'),ok=done.size===5&&!bad&&plan==='sell'&&!!evidence;root.dataset.complete=String(ok);if(out)out.innerHTML=ok?'<strong>Mission complete.</strong> All conversions, operations, models, and the market decision agree.':'<strong>Not complete.</strong> Verify every final value, choose the supported plan, and record your reasoning.';out?.focus();});
});
</script>
<style>.arcade{overflow:hidden;border-radius:17px;background:#152b36;color:#fff}.arcade header{padding:1.1rem;background:#1e4b5e}.arcade section,.arcade .final{display:grid;gap:.7rem;padding:1rem}.arcade label{display:grid;gap:.35rem;font-weight:800}.arcade input,.arcade textarea,.arcade select{box-sizing:border-box;width:100%;min-height:44px;padding:.65rem;border-radius:8px;border:1px solid #91abb5;font:inherit}.arcade button{min-height:44px;border:0;border-radius:8px;background:#f4c95d;color:#17243a;padding:.7rem;font-weight:900}.arcade-progress{padding:.7rem 1rem;background:#ffffff12}.arcade [data-status],.arcade [data-final-status]{padding:.7rem;background:#ffffff12}.fields,.final-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.arcade fieldset{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;border:1px solid #ffffff55;border-radius:10px}.arcade fieldset [data-display],.arcade fieldset [data-transcript]{grid-column:1/-1}.arcade [data-display]{display:grid;gap:.35rem;padding:.65rem;background:#fff;color:#173142;border-radius:8px}.arcade [data-display] span{display:block;height:34px;background:#207c91;border:2px solid #173142}.arcade [data-display] .stage-1{background:repeating-linear-gradient(90deg,#207c91 0 24%,#fff 24% 25%)}.arcade [data-display] .stage-2{background:repeating-linear-gradient(90deg,#d8f1f6 0 24%,#207c91 24% 25%)}.arcade [data-display] .stage-3{height:70px;background:linear-gradient(90deg,#207c91 50%,#d8f1f6 50%)}.arcade [data-display] .stage-4{clip-path:polygon(45% 0,55% 0,55% 40%,90% 90%,78% 100%,50% 58%,22% 100%,10% 90%,45% 40%)}.arcade [data-display] .stage-5{background:linear-gradient(90deg,#207c91 25%,#fff 25%)}.arcade :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:620px){.fields,.final-grid,.arcade fieldset{grid-template-columns:1fr}.arcade fieldset [data-display],.arcade fieldset [data-transcript]{grid-column:1}}@media(max-width:390px){.arcade section,.arcade .final{padding:.75rem}}@media(prefers-reduced-motion:reduce){.arcade *{scroll-behavior:auto!important;transition:none!important}}
</style>
