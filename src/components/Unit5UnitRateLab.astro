<div class="rate-lab" data-rate-lab>
  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART A · MAKE IT “PER 1”</p><h3>Turn a rate into a unit rate</h3></div><button type="button" class="secondary" data-new-rate>New rate</button></div>
    <p class="challenge-line" data-rate-prompt></p>
    <div class="rate-flow"><span data-original-rate></span><b>÷</b><span data-divisor></span><b>→</b><span data-unit-rate></span></div>
    <button type="button" class="hint-button" data-reveal-unit>Reveal unit rate</button>
    <p class="lab-feedback" data-unit-feedback>Ask: what do I want to know for 1?</p>
  </section>

  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART B · BEST BUY</p><h3>Compare price per item</h3></div><button type="button" class="secondary" data-new-deal>New deals</button></div>
    <div class="deal-grid"><article><small>DEAL A</small><strong data-deal-a></strong><span data-unit-a hidden></span></article><article><small>DEAL B</small><strong data-deal-b></strong><span data-unit-b hidden></span></article></div>
    <div class="choice-row"><button type="button" data-deal-choice="a">Deal A is better</button><button type="button" data-deal-choice="b">Deal B is better</button></div>
    <button type="button" class="hint-button" data-show-units>Show unit prices</button>
    <p class="lab-feedback" data-deal-feedback>Lower price per item is the better deal.</p>
  </section>

  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART C · RATE EXTENDER</p><h3>Use “per 1” to predict a new amount</h3></div><button type="button" class="secondary" data-new-speed>New challenge</button></div>
    <p class="challenge-line" data-speed-prompt></p>
    <div class="answer-row"><input type="number" step="0.01" data-speed-answer aria-label="Your answer"><button type="button" data-check-speed>Check</button></div>
    <p class="lab-feedback" data-speed-feedback>Find the unit rate first, then scale to the new amount.</p>
  </section>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-rate-lab]').forEach(lab=>{
  const rates=[{a:20,b:5,u:'$4 per notebook',p:'$20 for 5 notebooks',d:5},{a:45,b:15,u:'$3 per litre',p:'$45 for 15 L of fuel',d:15},{a:60,b:4,u:'15 pages per day',p:'60 pages in 4 days',d:4},{a:180,b:3,u:'60 km/h',p:'180 km in 3 h',d:3}];let ri=0;const rp=lab.querySelector('[data-rate-prompt]');const or=lab.querySelector('[data-original-rate]');const dv=lab.querySelector('[data-divisor]');const ur=lab.querySelector<HTMLElement>('[data-unit-rate]');const uf=lab.querySelector<HTMLElement>('[data-unit-feedback]');const renderRate=()=>{ri=Math.floor(Math.random()*rates.length);const t=rates[ri];if(rp)rp.textContent=`Find the unit rate for ${t.p}.`;if(or)or.textContent=t.p;if(dv)dv.textContent=String(t.d);if(ur){ur.textContent='? per 1';ur.classList.remove('revealed')}if(uf)uf.textContent='Ask: what do I want to know for 1?';};lab.querySelector('[data-new-rate]')?.addEventListener('click',renderRate);lab.querySelector('[data-reveal-unit]')?.addEventListener('click',()=>{const t=rates[ri];if(ur){ur.textContent=t.u;ur.classList.add('revealed')}if(uf)uf.innerHTML=`<strong>Unit rate:</strong> ${t.u}. Both parts were divided by ${t.d}.`;});renderRate();
  const deals=[{a:'3 notebooks for $6.00',ua:2,b:'5 notebooks for $9.00',ub:1.8,best:'b'},{a:'2 bars for $2.50',ua:1.25,b:'3 bars for $3.00',ub:1,best:'b'},{a:'6 cans for $9.00',ua:1.5,b:'5 cans for $8.50',ub:1.7,best:'a'},{a:'10 pencils for $4.50',ua:.45,b:'6 pencils for $2.40',ub:.4,best:'b'}];let di=0;const da=lab.querySelector('[data-deal-a]');const db=lab.querySelector('[data-deal-b]');const ua=lab.querySelector<HTMLElement>('[data-unit-a]');const ub=lab.querySelector<HTMLElement>('[data-unit-b]');const df=lab.querySelector<HTMLElement>('[data-deal-feedback]');const renderDeal=()=>{di=Math.floor(Math.random()*deals.length);const t=deals[di];if(da)da.textContent=t.a;if(db)db.textContent=t.b;if(ua){ua.textContent=`$${t.ua.toFixed(2)} each`;ua.hidden=true}if(ub){ub.textContent=`$${t.ub.toFixed(2)} each`;ub.hidden=true}if(df)df.textContent='Lower price per item is the better deal.';};lab.querySelector('[data-new-deal]')?.addEventListener('click',renderDeal);lab.querySelector('[data-show-units]')?.addEventListener('click',()=>{if(ua)ua.hidden=false;if(ub)ub.hidden=false;});lab.querySelectorAll<HTMLButtonElement>('[data-deal-choice]').forEach(b=>b.addEventListener('click',()=>{const t=deals[di];if(df)df.innerHTML=b.dataset.dealChoice===t.best?`<strong>Correct.</strong> Deal ${t.best.toUpperCase()} has the lower unit price.`:`<strong>Not yet.</strong> Compare the price for exactly 1 item in each deal.`;}));renderDeal();
  const speeds=[{p:'A car travels 180 km in 2 h. How far in 3 h?',unit:90,target:3,a:270,e:'180 ÷ 2 = 90 km/h; 90 × 3 = 270 km.'},{p:'A printer makes 30 pages in 2 min. How many pages in 8 min?',unit:15,target:8,a:120,e:'30 ÷ 2 = 15 pages/min; 15 × 8 = 120.'},{p:'6 cups flour are used for 3 eggs. How much flour for 5 eggs?',unit:2,target:5,a:10,e:'6 ÷ 3 = 2 cups/egg; 2 × 5 = 10 cups.'}];let si=0;const sp=lab.querySelector('[data-speed-prompt]');const sa=lab.querySelector<HTMLInputElement>('[data-speed-answer]');const sf=lab.querySelector<HTMLElement>('[data-speed-feedback]');const renderSpeed=()=>{si=Math.floor(Math.random()*speeds.length);if(sp)sp.textContent=speeds[si].p;if(sa)sa.value='';if(sf)sf.textContent='Find the unit rate first, then scale to the new amount.';};lab.querySelector('[data-new-speed]')?.addEventListener('click',renderSpeed);lab.querySelector('[data-check-speed]')?.addEventListener('click',()=>{const t=speeds[si];if(!sa?.value){if(sf)sf.innerHTML='<strong>Add an answer first.</strong>';return;}if(sf)sf.innerHTML=Math.abs(Number(sa.value)-t.a)<.01?`<strong>Correct.</strong> ${t.e}`:`<strong>Not yet.</strong> First find the amount per 1.`;});renderSpeed();
 });
</script>
<style>.rate-lab{display:grid;gap:1rem}.lab-panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.lab-head h3{margin:.2rem 0 .8rem}.secondary,.choice-row button,.answer-row button{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.challenge-line{font-size:1.15rem;font-weight:900}.rate-flow{display:grid;grid-template-columns:1fr auto auto auto 1fr;gap:.5rem;align-items:center}.rate-flow span{padding:.8rem;border-radius:12px;background:var(--course-soft);text-align:center;font-weight:900}.rate-flow span.revealed{outline:2px solid var(--course)}.deal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.deal-grid article{display:grid;gap:.3rem;padding:1rem;border:1px solid #dce4ed;border-radius:14px}.deal-grid small{font-weight:900;color:#64748b}.deal-grid span{color:var(--course);font-weight:900}.choice-row,.answer-row{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.answer-row input{flex:1;max-width:280px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.hint-button{margin-top:.65rem;border:0;background:transparent;color:var(--course);font-weight:900;cursor:pointer}.lab-feedback{margin:.85rem 0 0;padding:.75rem .85rem;border-radius:12px;background:#f7f9fc}@media(max-width:650px){.lab-head,.deal-grid,.rate-flow{display:grid}.secondary{justify-self:start}.answer-row input{max-width:none}}</style>