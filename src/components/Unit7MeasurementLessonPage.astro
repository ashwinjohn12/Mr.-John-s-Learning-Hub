---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit7MeasurementLab from './Unit7MeasurementLabV2.astro';
import Unit7MeasurementGame from './Unit7MeasurementGameV2.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';
interface Props { course:Course; unit:Unit; topic:Topic; content:TopicContent; variant:'parallelogram'|'triangle'|'composite'|'volume' }
const { course,unit,topic,content,variant }=Astro.props;
const base=import.meta.env.BASE_URL;
const nextHref=content.next.slug&&content.next.status==='ready'?`${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/`:null;
const visiblePrerequisites=content.prerequisites.slice(0,3);const visibleGoals=content.goals.slice(0,4);const coreConcepts=content.concepts.slice(0,5);const appliedConcepts=content.concepts.slice(5);const coreExamples=content.examples.slice(0,2);const advancedExamples=content.examples.slice(2);
const heroTitle=variant==='parallelogram'?'Area of a Parallelogram':variant==='triangle'?'Area of a Triangle':variant==='composite'?'Area of Composite Shapes':'Understanding Volume';
const heroSubtitle=variant==='parallelogram'?'Rearrange a slanted shape into a rectangle, then use base and perpendicular height.':variant==='triangle'?'See why a triangle is half a matching parallelogram and use that relationship to find area.':variant==='composite'?'Break complicated regions into familiar shapes, calculate the pieces, and combine them.':'Build prisms from cube layers and connect base area, height, and three-dimensional space.';
const overviewTitle=variant==='volume'?'Get ready for volume':'Get ready for area';
const appliedLabel=variant==='parallelogram'?'Missing dimensions and algebra':variant==='triangle'?'Flexible ways to take half':variant==='composite'?'Alternate decompositions':'Equal-volume designs';
const gameTitle=variant==='parallelogram'?'Glass Wall Mission':variant==='triangle'?'Pennant Designer':variant==='composite'?'Park Planner Challenge':'Storage Stack Challenge';
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} {heroTitle} {heroSubtitle} compactMobileHero mobileHeroSize="clamp(1.9rem,9vw,2.9rem)">
 <LearningSection id="overview" eyebrow="GET READY" title={overviewTitle} icon="🎯" tone="idea">
  <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{visiblePrerequisites.map(item=><li>{item}</li>)}</ul></div><div><p class="mini-label">TODAY'S MISSION</p><ul>{visibleGoals.map(goal=><li>{goal}</li>)}</ul></div></div>
  <div class="lesson-meta"><span><strong>{variant==='volume'?'Suggested time:':'Time:'}</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
  {(variant==='parallelogram'||variant==='triangle')&&<p class="break-note"><strong>Suggested break point:</strong> Pause after Explore if you are working independently. Return for Practise, Check Yourself, and Play & Apply when you are ready.</p>}
  {variant==='volume'&&<p class="split-note"><strong>Take it in two parts:</strong> This lesson includes several investigations. You do not need to finish everything at once.</p>}
  <p class="start-note"><strong>Best place to begin:</strong> Read the Big Idea and visual model first. In Measurement, seeing why the relationship works matters more than memorizing a rule.</p>
  <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map(item=><li>{item}</li>)}</ul></details>
 </LearningSection>

 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
  <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p>
  <div class="three-step-rule">
   {variant==='parallelogram'?<><div><span>1</span><strong>Choose the base</strong><small>Pick a side as the reference.</small></div><div><span>2</span><strong>Find the 90° height</strong><small>Use perpendicular height, not slant.</small></div><div><span>3</span><strong>Multiply</strong><small>Base × perpendicular height.</small></div></>:variant==='triangle'?<><div><span>1</span><strong>Imagine the pair</strong><small>Two copies make a parallelogram.</small></div><div><span>2</span><strong>Find base and height</strong><small>They must be perpendicular.</small></div><div><span>3</span><strong>Take half</strong><small>Base × height ÷ 2.</small></div></>:variant==='composite'?<><div><span>1</span><strong>Split</strong><small>Find useful familiar pieces.</small></div><div><span>2</span><strong>Calculate</strong><small>Find each component area.</small></div><div><span>3</span><strong>Combine</strong><small>Add or subtract exactly once.</small></div></>:<><div><span>1</span><strong>Build the base layer</strong><small>Length × width gives cubes per layer.</small></div><div><span>2</span><strong>Stack layers</strong><small>Height tells how many repeats.</small></div><div><span>3</span><strong>Multiply</strong><small>Base area × height gives volume.</small></div></>}
  </div><div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
 </LearningSection>

 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
  <div class="concept-grid detailed">{coreConcepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
  {appliedConcepts.length>0&&<details class="applied-concepts"><summary>{appliedLabel}</summary><div class="applied-grid">{appliedConcepts.map(concept=><div><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember&&<p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div></details>}
  {variant==='parallelogram'?<article class="relationship-card"><p class="eyebrow">VISUAL RELATIONSHIP</p><h3>Same pieces → same area</h3><div class="shape-relation"><span>▱</span><b>rearrange →</b><span>▭</span></div><p>Both shapes use the same base and perpendicular height, so both cover the same amount of space.</p></article>:variant==='triangle'?<article class="relationship-card"><p class="eyebrow">VISUAL RELATIONSHIP</p><h3>Two matching triangles make the whole</h3><div class="shape-relation"><span>△</span><b>+</b><span>△</span><b>=</b><span>▱</span></div><p>One triangle is one-half of the matching parallelogram.</p></article>:variant==='composite'?<article class="relationship-card"><p class="eyebrow">VISUAL RELATIONSHIP</p><h3>Complicated outside, familiar inside</h3><div class="shape-relation"><span>⌂</span><b>→</b><span>▭ + △</span></div><p>Decomposition lines organize the region; they do not change its total area.</p></article>:<article class="relationship-card"><p class="eyebrow">VISUAL RELATIONSHIP</p><h3>Area becomes volume when layers repeat</h3><div class="shape-relation"><span>▦</span><b>× layers →</b><span>▰</span></div><p>One base layer is two-dimensional area. Repeating it through height builds three-dimensional volume.</p></article>}
  <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map(item=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
 </LearningSection>

 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
  <p class="section-lead">Start with the two core examples. Open Examples 3 and 4 when you are ready for missing dimensions or richer applications.</p>
  <div class="example-stack">{coreExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
  <details class="advanced-examples"><summary>Ready for more? Open Examples 3 and 4</summary><div class="example-stack advanced-stack">{advancedExamples.map(example=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map(step=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></details>
 </LearningSection>

 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary}/></LearningSection>

 <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore"><p class="section-lead">{content.explorePrompt}</p><Unit7MeasurementLab {variant}/><article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map(item=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p></article></LearningSection>

 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><p class="practice-goal-copy"><strong>Your goal:</strong> complete the set shown below. If you choose a difficulty with fewer available questions, the goal adjusts automatically.</p><PracticeEngine questions={content.questions} sessionCount={6}/></LearningSection>

 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>You will get five random questions each time. This bank is separate from supported practice and has no hints.</p><CheckYourself questions={content.checkQuestions} count={5}/></LearningSection>

 <LearningSection id="apply" eyebrow="PLAY & APPLY" title={gameTitle} icon="🎮" tone="play"><p class="section-lead">Rounds 1 and 2 build speed with fresh scenarios. Round 3 is a design decision: adjust dimensions or choose a strategy to make the mathematics work.</p><Unit7MeasurementGame {variant}/></LearningSection>

 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="summary-card"><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map(item=><li>{item}</li>)}</ul></div><div class="review-options"><details><summary>Need more help?</summary><ul>{content.support.map(item=><li>{item}</li>)}</ul></details><details><summary>Want an extra challenge?</summary><ul>{content.extension.map(item=><li>{item}</li>)}</ul></details></div><article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show a strong answer</summary><p>{content.pat.answer}</p></details></article><div class="review-grid">{content.review.map(item=><label><input type="checkbox"/> {item}</label>)}</div><div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong><small>Continue when you are ready.</small></div>{nextHref?<a class="button" href={nextHref}>Open →</a>:<span class="coming-next">Coming next</span>}</div></LearningSection>
</Grade6LessonFrame>
<style>
.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.summary-card{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.summary-card ul,.worked-example ol,.hands-on-card ol,.review-options ul{padding-left:1.2rem}.overview-grid li,.summary-card li,.worked-example li,.hands-on-card li,.review-options li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.start-note,.practice-goal-copy,.split-note,.break-note{margin:1rem 0 0;padding:.75rem .85rem;border-radius:11px;background:#fff8db}.split-note{background:#eef6ff}.break-note{background:#f0fdf4}.success-box{margin-top:1rem}.three-step-rule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1rem 0}.three-step-rule>div{display:grid;gap:.25rem;padding:.8rem;border:1px solid #dfe5ee;border-radius:12px;background:#fff}.three-step-rule>div>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--course);color:#fff;font-weight:900}.three-step-rule small{color:#526174}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.applied-concepts,.advanced-examples{margin-top:1rem;border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.applied-concepts>summary,.advanced-examples>summary,.review-options summary{cursor:pointer;padding:1rem;font-weight:900}.applied-grid,.advanced-stack{padding:0 1rem 1rem}.worked-example,.hands-on-card,.pat-card,.relationship-card{border:1px solid #dfe5ee;border-radius:16px;padding:1rem;background:#fff}.example-stack{display:grid;gap:1rem}.example-answer{margin-top:.8rem;padding:.75rem;border-radius:10px;background:var(--course-soft)}.relationship-card{margin-top:1rem;background:#fbfdff}.shape-relation{display:flex;align-items:center;justify-content:center;gap:1rem;margin:.8rem 0;font-size:2.2rem}.shape-relation b{font-size:1rem;color:#64748b}.mixups,.hands-on-card,.pat-card,.review-options{margin-top:1rem}.review-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.review-options details{border:1px solid #dfe5ee;border-radius:14px;background:#f8fafc}.pat-card{background:#f8fafc}.next-step small{display:block;margin-top:.2rem;color:#64748b}.coming-next{font-weight:900;color:#64748b}@media(max-width:760px){.overview-grid,.three-step-rule,.review-options{grid-template-columns:1fr}.shape-relation{flex-wrap:wrap}}
</style>