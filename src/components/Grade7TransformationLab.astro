---
interface Props { mode?: 'explore'|'apply'; title?: string; }
const {mode='explore',title=mode==='explore'?'Transformation Lab':'Animation Director'}=Astro.props;
const uid=`g7-transform-${mode}-${Math.random().toString(36).slice(2,8)}`;
const lines=Array.from({length:21},(_,i)=>40+i*22);
const ticks=[-10,-5,0,5,10];
---
<section class="transform-lab" data-transform-lab data-mode={mode} aria-labelledby={`${uid}-title`}>
  <div class="lab-head"><div><p class="mini-label">{mode==='explore'?'TRANSFORMATION LAB':'APPLY · ANIMATION DIRECTOR'}</p><h4 id={`${uid}-title`}>{title}</h4></div><span class="step-badge">{mode==='explore'?'Predict → Transform → Explain':'Build a 3-step sequence'}</span></div>
  {mode==='explore'?<p>Choose a transformation, set its information, predict where the image will land, then reveal the image coordinates. The original stays blue; its image is gold.</p>:<p>Create a three-step animation using at least one translation, one reflection, and one rotation. Each step becomes the starting figure for the next step.</p>}
  <div class="lab-layout">
    <div class="plane-wrap">
      <svg class="plane" data-plane viewBox="0 0 520 520" role="img" aria-label="Interactive Cartesian plane showing an original triangle and its transformation image.">
        <rect x="40" y="40" width="440" height="440" rx="12" fill="#f8fbff" stroke="#cbd8e8" stroke-width="2"/>
        <g aria-hidden="true">{lines.map(p=><><line x1={p} y1="40" x2={p} y2="480" stroke="#dce6f2" stroke-width="1"/><line x1="40" y1={p} x2="480" y2={p} stroke="#dce6f2" stroke-width="1"/></>)}</g>
        <g aria-hidden="true"><line x1="40" y1="260" x2="480" y2="260" stroke="#1d3557" stroke-width="3"/><line x1="260" y1="40" x2="260" y2="480" stroke="#1d3557" stroke-width="3"/></g>
        <g aria-hidden="true">{ticks.map(i=><text x={260+i*22} y="280" text-anchor="middle" fill="#465a73" font-size="13" font-weight="700">{i}</text>)}{ticks.filter(i=>i!==0).map(i=><text x="250" y={264-i*22} text-anchor="end" fill="#465a73" font-size="13" font-weight="700">{i}</text>)}<text x="486" y="252" fill="#465a73" font-weight="800">x</text><text x="270" y="34" fill="#465a73" font-weight="800">y</text></g>
        <g data-reflection-guide aria-hidden="true"></g>
        <g data-rotation-guide aria-hidden="true"></g>
        <polyline data-original points="" fill="rgba(36,87,197,.12)" stroke="#2457c5" stroke-width="4" stroke-linejoin="round"/>
        <g data-original-points></g>
        <polyline data-image points="" fill="rgba(255,183,3,.18)" stroke="#b76e00" stroke-width="4" stroke-linejoin="round"/>
        <g data-image-points></g>
      </svg>
      <div class="legend"><span><i class="original-key"></i>Original A, B, C</span><span><i class="image-key"></i>Image A′, B′, C′</span></div>
    </div>
    <div class="controls">
      <label>Transformation<select data-type><option value="translation">Translation</option><option value="reflection">Reflection</option><option value="rotation">Rotation</option></select></label>
      <div data-translation class="settings"><label>Horizontal move<select data-dx><option value="-6">6 left</option><option value="-4">4 left</option><option value="3" selected>3 right</option><option value="5">5 right</option></select></label><label>Vertical move<select data-dy><option value="-4">4 down</option><option value="-2" selected>2 down</option><option value="2">2 up</option><option value="4">4 up</option></select></label></div>
      <div data-reflection class="settings" hidden><label>Line direction<select data-ref-axis><option value="vertical">Vertical line x = k</option><option value="horizontal">Horizontal line y = k</option></select></label><label>k value<input data-ref-k type="number" min="-4" max="4" step="1" value="1" inputmode="numeric"/></label></div>
      <div data-rotation class="settings" hidden><label>Angle<select data-angle><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></label><label>Direction<select data-direction><option value="cw">clockwise</option><option value="ccw">counterclockwise</option></select></label><div class="centre-row"><label>Centre x<input data-cx type="number" min="-3" max="3" step="1" value="0" inputmode="numeric"/></label><label>Centre y<input data-cy type="number" min="-3" max="3" step="1" value="0" inputmode="numeric"/></label></div></div>
      <div class="prediction"><strong>Before you reveal:</strong><span data-prediction>Where should A′, B′, and C′ land?</span></div>
      <button type="button" class="primary" data-transform>Reveal the image</button>
      <p class="status" data-status role="status">Choose a transformation, make a prediction, then reveal.</p>
      <div class="description" data-description hidden><strong>Precise description</strong><p data-description-text></p></div>
      <div class="coord-table" data-table hidden><table><caption>Original and image coordinates</caption><thead><tr><th>Vertex</th><th>Original</th><th>Image</th></tr></thead><tbody data-rows></tbody></table></div>
      {mode==='apply'&&<><button type="button" class="secondary" data-add-step disabled>Add this step to my animation</button><div class="sequence"><strong>Transformation sequence</strong><ol data-log></ol><p data-sequence-status>Use all three transformation types in three steps.</p></div><button type="button" class="secondary" data-reset>Reset animation</button></>}
    </div>
  </div>
</section>
<script>
type P={x:number;y:number;label:string};
const prime=(label:string)=>`${label}′`;
document.querySelectorAll<HTMLElement>('[data-transform-lab]').forEach(root=>{
 const mode=root.dataset.mode||'explore',svg=root.querySelector<SVGSVGElement>('[data-plane]')!,type=root.querySelector<HTMLSelectElement>('[data-type]')!,image=root.querySelector<SVGPolylineElement>('[data-image]')!,original=root.querySelector<SVGPolylineElement>('[data-original]')!,origLayer=root.querySelector<SVGGElement>('[data-original-points]')!,imgLayer=root.querySelector<SVGGElement>('[data-image-points]')!,refGuide=root.querySelector<SVGGElement>('[data-reflection-guide]')!,rotGuide=root.querySelector<SVGGElement>('[data-rotation-guide]')!,status=root.querySelector<HTMLElement>('[data-status]')!,desc=root.querySelector<HTMLElement>('[data-description]')!,descText=root.querySelector<HTMLElement>('[data-description-text]')!,table=root.querySelector<HTMLElement>('[data-table]')!,rows=root.querySelector<HTMLTableSectionElement>('[data-rows]')!,addStep=root.querySelector<HTMLButtonElement>('[data-add-step]'),log=root.querySelector<HTMLOListElement>('[data-log]'),sequenceStatus=root.querySelector<HTMLElement>('[data-sequence-status]');
 let current:P[]=[{x:-4,y:1,label:'A'},{x:-1,y:4,label:'B'},{x:2,y:1,label:'C'}],result:P[]=[];let steps:string[]=[];let used=new Set<string>();
 const px=(v:number)=>260+v*22,py=(v:number)=>260-v*22,inside=(p:P)=>Math.abs(p.x)<=10&&Math.abs(p.y)<=10;
 const pointsString=(pts:P[])=>[...pts,pts[0]].map(p=>`${px(p.x)},${py(p.y)}`).join(' ');
 const drawPoints=(layer:SVGGElement,pts:P[],isImage=false)=>{layer.innerHTML=pts.map(p=>`<g transform="translate(${px(p.x)} ${py(p.y)})"><circle r="8" fill="${isImage?'#ffb703':'#dbeafe'}" stroke="${isImage?'#714500':'#174ea6'}" stroke-width="3"/><text x="12" y="-12" fill="#16365f" font-size="16" font-weight="900" font-family="system-ui, sans-serif">${isImage?prime(p.label):p.label}</text></g>`).join('')};
 const drawOriginal=()=>{original.setAttribute('points',pointsString(current));drawPoints(origLayer,current,false);image.setAttribute('points','');imgLayer.innerHTML='';desc.hidden=true;table.hidden=true;if(addStep)addStep.disabled=true;refGuide.innerHTML='';rotGuide.innerHTML=''};
 const settings=()=>{root.querySelector<HTMLElement>('[data-translation]')!.hidden=type.value!=='translation';root.querySelector<HTMLElement>('[data-reflection]')!.hidden=type.value!=='reflection';root.querySelector<HTMLElement>('[data-rotation]')!.hidden=type.value!=='rotation';drawOriginal();status.textContent='Settings changed. Predict the image, then reveal it.'};
 const rotatePoint=(p:P,cx:number,cy:number,quarterTurns:number):P=>{let x=p.x-cx,y=p.y-cy;for(let i=0;i<quarterTurns;i++){[x,y]=[y,-x]}return{x:x+cx,y:y+cy,label:p.label}};
 const transform=()=>{let description='';refGuide.innerHTML='';rotGuide.innerHTML='';
   if(type.value==='translation'){const dx=Number(root.querySelector<HTMLSelectElement>('[data-dx]')!.value),dy=Number(root.querySelector<HTMLSelectElement>('[data-dy]')!.value);result=current.map(p=>({...p,x:p.x+dx,y:p.y+dy}));description=`Translate ${Math.abs(dx)} ${Math.abs(dx)===1?'unit':'units'} ${dx<0?'left':'right'} and ${Math.abs(dy)} ${Math.abs(dy)===1?'unit':'units'} ${dy<0?'down':'up'}. Every vertex moves the same way.`}
   if(type.value==='reflection'){const axis=root.querySelector<HTMLSelectElement>('[data-ref-axis]')!.value,k=Number(root.querySelector<HTMLInputElement>('[data-ref-k]')!.value);result=current.map(p=>axis==='vertical'?({...p,x:2*k-p.x}):({...p,y:2*k-p.y}));if(axis==='vertical')refGuide.innerHTML=`<line x1="${px(k)}" y1="40" x2="${px(k)}" y2="480" stroke="#b42318" stroke-width="4" stroke-dasharray="9 7"/><text x="${px(k)+8}" y="58" fill="#b42318" font-weight="900">x = ${k}</text>`;else refGuide.innerHTML=`<line x1="40" y1="${py(k)}" x2="480" y2="${py(k)}" stroke="#b42318" stroke-width="4" stroke-dasharray="9 7"/><text x="50" y="${py(k)-8}" fill="#b42318" font-weight="900">y = ${k}</text>`;description=`Reflect across the ${axis} line ${axis==='vertical'?'x':'y'} = ${k}. Each image vertex is the same perpendicular distance from the line on the opposite side.`}
   if(type.value==='rotation'){const angle=Number(root.querySelector<HTMLSelectElement>('[data-angle]')!.value),direction=root.querySelector<HTMLSelectElement>('[data-direction]')!.value,cx=Number(root.querySelector<HTMLInputElement>('[data-cx]')!.value),cy=Number(root.querySelector<HTMLInputElement>('[data-cy]')!.value);let q=angle/90;if(direction==='ccw')q=(4-q)%4;result=current.map(p=>rotatePoint(p,cx,cy,q));rotGuide.innerHTML=`<circle cx="${px(cx)}" cy="${py(cy)}" r="9" fill="#fff" stroke="#7c3aed" stroke-width="4"/><text x="${px(cx)+13}" y="${py(cy)-12}" fill="#6d28d9" font-weight="900">centre (${cx}, ${cy})</text>`;description=`Rotate ${angle}° ${direction==='cw'?'clockwise':'counterclockwise'} about centre (${cx}, ${cy}). The centre stays fixed while every vertex turns through the same angle.`}
   if(!result.every(inside)){status.textContent='This setting moves part of the image outside the visible grid. Choose a smaller movement or a different centre.';image.setAttribute('points','');imgLayer.innerHTML='';desc.hidden=true;table.hidden=true;if(addStep)addStep.disabled=true;return}
   image.setAttribute('points',pointsString(result));drawPoints(imgLayer,result,true);desc.hidden=false;table.hidden=false;descText.textContent=description;rows.innerHTML=result.map((p,i)=>`<tr><th>${current[i].label} → ${prime(p.label)}</th><td>(${current[i].x}, ${current[i].y})</td><td>(${p.x}, ${p.y})</td></tr>`).join('');status.textContent='Image revealed. Check every corresponding vertex and explain why it fits the transformation.';if(addStep)addStep.disabled=false;
 };
 type.addEventListener('change',settings);root.querySelectorAll('select,input').forEach(el=>el.addEventListener('change',()=>{if(el!==type){drawOriginal();status.textContent='Settings changed. Predict the image, then reveal it.'}}));root.querySelector('[data-transform]')?.addEventListener('click',transform);
 addStep?.addEventListener('click',()=>{if(!result.length)return;steps.push(descText.textContent||'Transformation');used.add(type.value);current=result.map(p=>({...p}));result=[];log!.innerHTML=steps.map((s,i)=>`<li><strong>Step ${i+1}:</strong> ${s}</li>`).join('');sequenceStatus!.textContent=steps.length<3?`${steps.length}/3 steps saved. Types used: ${[...used].join(', ')}.`:used.size===3?'Mission complete: three steps and all three transformation types used.':'Three steps saved, but your sequence must include translation, reflection, and rotation.';drawOriginal();if(steps.length>=3){addStep.disabled=true;root.querySelector<HTMLButtonElement>('[data-transform]')!.disabled=true}});
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{current=[{x:-4,y:1,label:'A'},{x:-1,y:4,label:'B'},{x:2,y:1,label:'C'}];result=[];steps=[];used.clear();log!.innerHTML='';sequenceStatus!.textContent='Use all three transformation types in three steps.';root.querySelector<HTMLButtonElement>('[data-transform]')!.disabled=false;drawOriginal();status.textContent='Animation reset. Choose your first transformation.'});
 drawOriginal();settings();
});
</script>
<style>
.transform-lab{border:1px solid #d7e1ee;border-radius:18px;padding:1rem;background:#fff;box-shadow:0 12px 28px rgba(24,78,166,.08)}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.lab-head h4{margin:.15rem 0;font-size:1.18rem}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.step-badge{padding:.4rem .65rem;border-radius:999px;background:#eef6ff;color:#425a78;font-weight:800;white-space:nowrap}.lab-layout{display:grid;grid-template-columns:minmax(300px,1.25fr) minmax(260px,.75fr);gap:1rem;align-items:start}.plane{display:block;width:100%;max-width:640px;aspect-ratio:1;border-radius:14px}.legend{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;color:#526174;font-size:.88rem}.legend span{display:flex;gap:.35rem;align-items:center}.legend i{width:16px;height:16px;border-radius:4px;display:inline-block}.original-key{background:#dbeafe;border:2px solid #2457c5}.image-key{background:#ffedb0;border:2px solid #b76e00}.controls{display:grid;gap:.75rem}.controls>label,.settings label{display:grid;gap:.22rem;font-weight:800}.controls select,.controls input{min-width:0;min-height:44px;border:1px solid #aebed2;border-radius:9px;padding:.55rem;font:inherit;background:#fff}.settings{display:grid;gap:.55rem}.settings[hidden]{display:none!important}.centre-row{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.prediction,.status,.description,.sequence{padding:.8rem;border-radius:12px;background:#f5f7fa}.prediction{display:grid;gap:.2rem;background:#fff7d6}.description{background:#eef6ff}.description p,.status{margin:0}.primary,.secondary{min-height:44px;border-radius:9px;padding:.65rem .85rem;font-weight:850;cursor:pointer}.primary{border:0;background:#2457c5;color:#fff}.secondary{border:1px solid #2457c5;background:#fff;color:#2457c5}.primary:focus-visible,.secondary:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #ffbf47;outline-offset:2px}.coord-table{overflow-x:auto}.coord-table table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.coord-table caption{text-align:left;font-weight:900;padding:.3rem 0}.coord-table th,.coord-table td{border-bottom:1px solid #dde5ef;padding:.45rem;text-align:left}.sequence ol{padding-left:1.25rem}.sequence p{margin:.5rem 0 0;font-weight:750;color:#425a78}@media(max-width:760px){.lab-layout{grid-template-columns:1fr}.plane{max-width:none}.lab-head{display:grid}.step-badge{justify-self:start}}@media(max-width:390px){.transform-lab{padding:.72rem}.centre-row{grid-template-columns:1fr}.coord-table th,.coord-table td{padding:.35rem;font-size:.9rem}}@media(prefers-reduced-motion:reduce){.transform-lab *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>