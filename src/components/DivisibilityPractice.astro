---
const questions = [
  {round:'A · Focus the digits',prompt:'To test 74,316 for divisibility by 4, which part should you inspect?',choices:['The digit 6','The last two digits: 16','The last three digits: 316','All five digits'],answer:1,rule:'A rule for 4 uses the last two digits.',hint:'Place value makes every complete hundred divisible by 4.',nearby:'12, 16, and 20 are consecutive multiples of 4.',proof:'16 = 4 × 4, so 74,316 is divisible by 4.'},
  {round:'A · Focus the digits',prompt:'To test 28,624 for divisibility by 8, which part should you inspect?',choices:['The digit 4','The last two digits: 24','The last three digits: 624','The first three digits: 286'],answer:2,rule:'A rule for 8 uses the last three digits.',hint:'Every complete thousand is divisible by 8.',nearby:'624 sits between 616 and 632 in the multiples-of-8 sequence.',proof:'624 = 8 × 78, so 28,624 is divisible by 8.'},
  {round:'B · Select every rule',prompt:'Which list contains every rule that works for 6,432?',choices:['2 only','2 and 4','2, 4, and 8','2, 5, and 10'],answer:2,rule:'Test the ones digit, last two digits, and last three digits separately.',hint:'32 divides by 4 and 432 divides by 8.',nearby:'424, 432, and 440 are consecutive multiples of 8.',proof:'The ending is even, 32 = 4 × 8, and 432 = 8 × 54.'},
  {round:'B · Select every rule',prompt:'Which list contains every rule that works for 8,150?',choices:['2 and 5','2, 5, and 10','5 and 10','All five rules'],answer:1,rule:'An ending of 0 activates more than one rule.',hint:'A number ending in 0 is even and meets the rules for 5 and 10.',nearby:'48 and 52 are neighbouring multiples of 4; 50 lies between them.',proof:'8,150 is divisible by 2, 5, and 10, but 50 is not divisible by 4.'},
  {round:'C · Build a number',prompt:'Which digit makes 64□ divisible by 4?',choices:['1','2','5','8'],answer:3,rule:'Only the last two digits matter.',hint:'Test 41, 42, 45, and 48—not the whole three-digit number.',nearby:'44, 48, and 52 are consecutive multiples of 4.',proof:'48 = 4 × 12, so 648 is divisible by 4.'},
  {round:'C · Build a number',prompt:'Which four-digit number is divisible by 5 but not by 10?',choices:['2,340','4,125','6,780','9,000'],answer:1,rule:'Divisible by 5 ends in 0 or 5; divisible by 10 ends only in 0.',hint:'Choose the number ending in 5.',nearby:'4,120 and 4,130 are multiples of 10; 4,125 lies halfway between them.',proof:'4,125 ends in 5, so it is divisible by 5 but not by 10.'},
  {round:'D · Analyze an error',prompt:'Ari says 7,642 is divisible by 4 because 64 is divisible by 4. What fixes the reasoning?',choices:['Use the first two digits, 76','Use the last two digits, 42','Use the last three digits, 642','Use only the ones digit, 2'],answer:1,rule:'“Last two digits” means the number formed by the tens and ones places.',hint:'Read the number from the right.',nearby:'40 and 44 are neighbouring multiples of 4; 42 lies between them.',proof:'The last two digits form 42. Since 42 is not divisible by 4, neither is 7,642.'},
  {round:'D · Analyze an error',prompt:'Which statement is always true?',choices:['Every number divisible by 2 is divisible by 4','Every number divisible by 4 is divisible by 8','Every number divisible by 8 is divisible by 4','Every number ending in 5 is divisible by 10'],answer:2,rule:'Use the nested relationship 8 → 4 → 2.',hint:'Think about equal groups: two groups of 4 make 8.',nearby:'16 = 8 × 2 = 4 × 4 = 2 × 8, so one number can show all three nested rules.',proof:'If a number has groups of 8, each group can split into two groups of 4.'}
];
---

<div class="supported-practice" data-supported-practice>
  <div class="practice-top"><div><p class="eyebrow">QUESTION <span data-practice-count>1</span> OF {questions.length}</p><h3 data-practice-round>{questions[0].round}</h3></div><span data-practice-score>0 correct</span></div>
  <div class="practice-progress" aria-hidden="true"><span data-practice-progress></span></div>
  <div class="practice-stage" data-practice-stage aria-live="polite" tabindex="-1"></div>
  <div class="support-tools">
    <button type="button" data-support="digits">Highlight the digits</button>
    <button type="button" data-support="rule">Show the rule</button>
    <button type="button" data-support="multiple">Show a nearby multiple</button>
  </div>
  <div class="practice-actions"><button class="practice-next" type="button" data-practice-next disabled>Next question</button><button type="button" data-practice-restart>Start over</button></div>
  <script is:inline type="application/json" data-practice-data set:html={JSON.stringify(questions)}></script>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-supported-practice]').forEach(widget=>{
    const questions=JSON.parse(widget.querySelector('[data-practice-data]')?.textContent||'[]');
    const stage=widget.querySelector<HTMLElement>('[data-practice-stage]');
    const count=widget.querySelector('[data-practice-count]');
    const round=widget.querySelector('[data-practice-round]');
    const scoreNode=widget.querySelector('[data-practice-score]');
    const progress=widget.querySelector<HTMLElement>('[data-practice-progress]');
    const next=widget.querySelector<HTMLButtonElement>('[data-practice-next]');
    let index=0,score=0,answered=false;
    const render=()=>{
      if(index>=questions.length){if(stage)stage.innerHTML=`<div class="practice-finish"><p class="eyebrow">SUPPORTED PRACTICE COMPLETE</p><h3>${score} of ${questions.length} correct</h3><p>${score>=7?'Your rule choices are precise. Move to Check Yourself when you are ready.':score>=5?'Good progress. Revisit the explanations you needed, then continue.':'Use the rule table in Understand, then restart this practice with the support buttons.'}</p></div>`;if(progress)progress.style.width='100%';if(next)next.disabled=true;stage?.focus();return}
      const q=questions[index]; answered=false;if(count)count.textContent=String(index+1);if(round)round.textContent=q.round;if(scoreNode)scoreNode.textContent=`${score} correct`;if(progress)progress.style.width=`${index/questions.length*100}%`;if(next)next.disabled=true;
      if(stage)stage.innerHTML=`<h3>${q.prompt}</h3><div class="practice-choices">${q.choices.map((c:string,i:number)=>`<button type="button" data-choice="${i}"><span>${String.fromCharCode(65+i)}</span>${c}</button>`).join('')}</div><div class="practice-feedback" data-practice-feedback role="status"></div>`;
      stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>answer(Number(button.dataset.choice))));
    };
    const answer=(choice:number)=>{if(answered)return;answered=true;const q=questions[index];const correct=q.answer;const isCorrect=choice===correct;if(isCorrect)score++;stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button,i)=>{button.disabled=true;if(i===correct)button.classList.add('correct');else if(i===choice)button.classList.add('incorrect')});const feedback=stage?.querySelector<HTMLElement>('[data-practice-feedback]');if(feedback)feedback.innerHTML=`<strong>${isCorrect?'Yes—your evidence matches the rule.':'Not yet—use the relevant ending.'}</strong> ${q.proof}`;if(scoreNode)scoreNode.textContent=`${score} correct`;if(next)next.disabled=false};
    widget.querySelectorAll<HTMLButtonElement>('[data-support]').forEach(button=>button.addEventListener('click',()=>{const q=questions[index],feedback=stage?.querySelector<HTMLElement>('[data-practice-feedback]');if(!feedback)return;const type=button.dataset.support;feedback.innerHTML=`<strong>Support:</strong> ${type==='rule'?q.rule:type==='digits'?q.hint:q.nearby}`}));
    next?.addEventListener('click',()=>{index++;render();stage?.focus()});widget.querySelector('[data-practice-restart]')?.addEventListener('click',()=>{index=0;score=0;render();stage?.focus()});render();
  });
</script>

<style>
  .supported-practice{border:1px solid #ead6c8;border-radius:18px;background:#fffdfb;padding:1.15rem}.practice-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}.practice-top h3{margin:.15rem 0}.practice-top>span{font-weight:900;color:#9c4010}.practice-progress{height:7px;border-radius:9px;background:#f3e7df;overflow:hidden}.practice-progress span{display:block;height:100%;width:0;background:#b44d12;transition:width .2s}.practice-stage{min-height:285px;padding-top:1rem}.practice-stage:focus{outline:none}.practice-stage>h3{font-size:1.35rem;line-height:1.35}.practice-choices{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.practice-choices button{display:flex;gap:.65rem;align-items:center;text-align:left;border:1px solid #e1d7d0;border-radius:11px;background:#fff;padding:.75rem;cursor:pointer;font-weight:650}.practice-choices button span{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:#fff1e8;color:#9c4010;font-weight:900}.practice-choices button.correct{border-color:#22c55e;background:#f0fdf4}.practice-choices button.incorrect{border-color:#ef4444;background:#fef2f2}.practice-feedback{min-height:58px;margin-top:.8rem;padding:.8rem;border-radius:11px;background:#f8fafc}.support-tools,.practice-actions{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.7rem}.support-tools{padding-top:.8rem;border-top:1px solid #eaded5}.support-tools button,.practice-actions button{border:1px solid #d9c8bc;border-radius:9px;background:#fff;padding:.6rem .75rem;font-weight:750;cursor:pointer}.practice-actions{justify-content:flex-end}.practice-actions .practice-next{background:#b44d12;color:#fff;border-color:#b44d12}.practice-actions button:disabled{opacity:.45;cursor:not-allowed}.practice-choices button:focus-visible,.support-tools button:focus-visible,.practice-actions button:focus-visible{outline:3px solid #2457c5;outline-offset:2px}.practice-finish{padding:2rem .5rem}.practice-finish h3{font-size:1.8rem}
  @media(max-width:620px){.practice-choices{grid-template-columns:1fr}.practice-top{align-items:start}.practice-stage{min-height:390px}.support-tools button{flex:1 1 45%}}
</style>
