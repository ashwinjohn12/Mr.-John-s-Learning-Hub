---
interface Point { x:number; y:number; label?:string; }
interface Props {
  mode?: 'explore' | 'target' | 'static';
  scale?: 1 | 2 | 5 | 10;
  initialX?: number;
  initialY?: number;
  points?: Point[];
  title?: string;
}
const {mode='static',scale=1,initialX=3,initialY=4,points=[],title='Cartesian plane'}=Astro.props;
const uid=`g7-grid-${mode}-${Math.random().toString(36).slice(2,8)}`;
const linePositions=Array.from({length:21},(_,i)=>40+i*22);
const tickIndexes=[-10,-5,0,5,10];
const pointToPx=(n:number)=>260+(n/scale)*22;
---
<section class="g7-grid" data-g7-grid data-mode={mode} data-scale={scale} aria-labelledby={`${uid}-title`}>
  <div class="grid-heading"><div><p class="mini-label">{mode==='explore'?'COORDINATE EXPLORER':mode==='target'?'PLOT THE TARGET':'COORDINATE MODEL'}</p><h4 id={`${uid}-title`}>{title}</h4></div>{mode!=='static'&&<span class="scale-pill">Scale: <strong data-scale-output>{scale}</strong></span>}</div>
  {mode==='explore'&&<p class="grid-copy">Move point P. Read its ordered pair, quadrant or axis, and directions from the origin. Change the scale to see why you must read the axis labels before counting squares.</p>}
  {mode==='target'&&<p class="grid-copy">Read the ordered pair, then plot it. You can click, use the arrow keys and Enter, or type coordinates.</p>}
  <div class="grid-layout">
    <div class="plane-wrap">
      <svg class="plane" data-plane viewBox="0 0 520 520" role="img" tabindex={mode==='static'?undefined:'0'} aria-label={`${title}. Cartesian plane with four quadrants.`}>
        <rect x="40" y="40" width="440" height="440" rx="12" class="plot-bg"/>
        <g class="grid-lines" aria-hidden="true">{linePositions.map(p=><><line x1={p} y1="40" x2={p} y2="480"/><line x1="40" y1={p} x2="480" y2={p}/></>)}</g>
        <g class="axes" aria-hidden="true"><line x1="40" y1="260" x2="480" y2="260"/><line x1="260" y1="40" x2="260" y2="480"/></g>
        <g class="axis-names" aria-hidden="true"><text x="486" y="252">x</text><text x="270" y="34">y</text><text x="360" y="155">I</text><text x="154" y="155">II</text><text x="154" y="380">III</text><text x="360" y="380">IV</text></g>
        <g class="ticks" aria-hidden="true">
          {tickIndexes.map(i=><text x={260+i*22} y="279" text-anchor="middle" data-x-tick={i}>{i*scale}</text>)}
          {tickIndexes.filter(i=>i!==0).map(i=><text x="250" y={264-i*22} text-anchor="end" data-y-tick={i}>{i*scale}</text>)}
        </g>
        {points.map((p,i)=><g class="static-point" transform={`translate(${pointToPx(p.x)} ${260-(p.y/scale)*22})`}><circle r="8"/><text x="12" y="-12">{p.label??String.fromCharCode(65+i)}</text></g>)}
        <g data-guide class="guide" aria-hidden="true"><line data-guide-x/><line data-guide-y/></g>
        <g data-marker class="marker" aria-hidden="true" transform={`translate(${pointToPx(initialX)} ${260-(initialY/scale)*22})`}><circle r="10"/><circle r="3"/><text data-marker-label x="14" y="-14">P</text></g>
      </svg>
      <p class="plane-tip"><strong>x first</strong>: move left or right. <strong>y second</strong>: move down or up.</p>
    </div>
    {mode!=='static'&&<div class="control-panel">
      {mode==='target'&&<div class="mission" aria-live="polite">Plot <strong data-target-pair>(3, 4)</strong>.</div>}
      <div class="readout" aria-live="polite"><span>Current point</span><strong data-pair>({initialX}, {initialY})</strong><small data-location>Quadrant I</small></div>
      {mode==='explore'&&<label class="scale-control">Axis scale<select data-scale-select><option value="1" selected={scale===1}>1 per square</option><option value="2" selected={scale===2}>2 per square</option><option value="5" selected={scale===5}>5 per square</option><option value="10" selected={scale===10}>10 per square</option></select></label>}
      <div class="entry-row"><label>x-coordinate<input data-x type="number" value={initialX} inputmode="numeric"/></label><label>y-coordinate<input data-y type="number" value={initialY} inputmode="numeric"/></label></div>
      {mode==='explore'?<>
        <div class="direction-card"><strong>Travel from (0, 0)</strong><span data-directions></span></div>
        <button type="button" class="primary" data-random>Try a random point</button>
        <div class="sign-card"><strong>Notice the signs</strong><span data-signs></span></div>
      </>:<>
        <button type="button" class="primary" data-submit>Check my point</button>
        <p class="feedback" data-feedback role="status">Choose a point, then check it.</p>
        <button type="button" class="secondary" data-new>New target</button>
      </>}
    </div>}
  </div>
</section>
<script>
const locationName=(x:number,y:number)=>{if(x===0&&y===0)return'the origin';if(y===0)return'on the x-axis';if(x===0)return'on the y-axis';if(x>0&&y>0)return'Quadrant I';if(x<0&&y>0)return'Quadrant II';if(x<0&&y<0)return'Quadrant III';return'Quadrant IV'};
const directionText=(x:number,y:number)=>{const h=x===0?'stay on x = 0':`${Math.abs(x)} ${Math.abs(x)===1?'unit':'units'} ${x>0?'right':'left'}`;const v=y===0?'stay on y = 0':`${Math.abs(y)} ${Math.abs(y)===1?'unit':'units'} ${y>0?'up':'down'}`;return`${h}, then ${v}.`};
const signText=(x:number,y:number)=>{if(x===0||y===0)return'At least one coordinate is 0, so this point lies on an axis rather than inside a quadrant.';return`The signs are (${x>0?'+':'−'}, ${y>0?'+':'−'}), which matches ${locationName(x,y)}.`};
document.querySelectorAll<HTMLElement>('[data-g7-grid]').forEach(lab=>{
 const mode=lab.dataset.mode??'static';if(mode==='static')return;
 const svg=lab.querySelector<SVGSVGElement>('[data-plane]')!,marker=lab.querySelector<SVGGElement>('[data-marker]')!,gx=lab.querySelector<SVGLineElement>('[data-guide-x]')!,gy=lab.querySelector<SVGLineElement>('[data-guide-y]')!,xInput=lab.querySelector<HTMLInputElement>('[data-x]')!,yInput=lab.querySelector<HTMLInputElement>('[data-y]')!;
 let scale=Number(lab.dataset.scale||1),x=Number(xInput.value),y=Number(yInput.value),targetX=3,targetY=4;
 const clamp=(v:number)=>Math.max(-10*scale,Math.min(10*scale,Math.round(v/scale)*scale));
 const px=(v:number)=>260+(v/scale)*22,py=(v:number)=>260-(v/scale)*22;
 const updateTicks=()=>{lab.querySelectorAll<SVGTextElement>('[data-x-tick]').forEach(t=>{const i=Number(t.dataset.xTick);t.textContent=String(i*scale)});lab.querySelectorAll<SVGTextElement>('[data-y-tick]').forEach(t=>{const i=Number(t.dataset.yTick);t.textContent=String(i*scale)});const out=lab.querySelector<HTMLElement>('[data-scale-output]');if(out)out.textContent=String(scale)};
 const setPoint=(nx:number,ny:number)=>{x=clamp(nx);y=clamp(ny);xInput.value=String(x);yInput.value=String(y);marker.setAttribute('transform',`translate(${px(x)} ${py(y)})`);gx.setAttribute('x1','260');gx.setAttribute('y1',String(py(y)));gx.setAttribute('x2',String(px(x)));gx.setAttribute('y2',String(py(y)));gy.setAttribute('x1',String(px(x)));gy.setAttribute('y1','260');gy.setAttribute('x2',String(px(x)));gy.setAttribute('y2',String(py(y)));lab.querySelector<HTMLElement>('[data-pair]')!.textContent=`(${x}, ${y})`;lab.querySelector<HTMLElement>('[data-location]')!.textContent=locationName(x,y);const d=lab.querySelector<HTMLElement>('[data-directions]');if(d)d.textContent=directionText(x,y);const s=lab.querySelector<HTMLElement>('[data-signs]');if(s)s.textContent=signText(x,y)};
 const fromPointer=(event:PointerEvent)=>{const r=svg.getBoundingClientRect(),vx=(event.clientX-r.left)/r.width*520,vy=(event.clientY-r.top)/r.height*520;return{x:clamp(((vx-260)/22)*scale),y:clamp(((260-vy)/22)*scale)}};
 svg.addEventListener('pointerdown',e=>{const p=fromPointer(e);setPoint(p.x,p.y)});
 svg.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Enter',' '].includes(e.key))return;e.preventDefault();if(e.key==='ArrowLeft')setPoint(x-scale,y);if(e.key==='ArrowRight')setPoint(x+scale,y);if(e.key==='ArrowUp')setPoint(x,y+scale);if(e.key==='ArrowDown')setPoint(x,y-scale);if((e.key==='Enter'||e.key===' ')&&mode==='target')lab.querySelector<HTMLButtonElement>('[data-submit]')?.click()});
 xInput.addEventListener('change',()=>setPoint(Number(xInput.value),y));yInput.addEventListener('change',()=>setPoint(x,Number(yInput.value)));
 if(mode==='explore'){
  const select=lab.querySelector<HTMLSelectElement>('[data-scale-select]')!;select.addEventListener('change',()=>{scale=Number(select.value);lab.dataset.scale=String(scale);x=clamp(x);y=clamp(y);updateTicks();setPoint(x,y)});
  lab.querySelector('[data-random]')?.addEventListener('click',()=>{const rx=(Math.floor(Math.random()*21)-10)*scale,ry=(Math.floor(Math.random()*21)-10)*scale;setPoint(rx,ry)});
 } else {
  const feedback=lab.querySelector<HTMLElement>('[data-feedback]')!;
  const makeTarget=()=>{targetX=(Math.floor(Math.random()*21)-10)*scale;targetY=(Math.floor(Math.random()*21)-10)*scale;lab.querySelector<HTMLElement>('[data-target-pair]')!.textContent=`(${targetX}, ${targetY})`;feedback.textContent='Choose a point, then check it.'};
  lab.querySelector('[data-submit]')?.addEventListener('click',()=>{setPoint(Number(xInput.value),Number(yInput.value));feedback.textContent=x===targetX&&y===targetY?`Correct. (${x}, ${y}) is the target.`:`Not yet. You plotted (${x}, ${y}). Check x first, then y.`});
  lab.querySelector('[data-new]')?.addEventListener('click',makeTarget);makeTarget();
 }
 updateTicks();setPoint(x,y);
});
</script>
<style>
.g7-grid{border:1px solid #d7e1ee;border-radius:18px;padding:1rem;background:#fff;box-shadow:0 12px 28px rgba(24,78,166,.08)}.grid-heading{display:flex;justify-content:space-between;gap:1rem;align-items:start}.grid-heading h4{margin:.15rem 0;font-size:1.15rem}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.scale-pill{padding:.35rem .55rem;border-radius:999px;background:#eef6ff;color:#425a78}.grid-copy{color:#526174;max-width:72ch}.grid-layout{display:grid;grid-template-columns:minmax(280px,1.35fr) minmax(230px,.65fr);gap:1rem;align-items:start}.plane-wrap{min-width:0}.plane{display:block;width:100%;max-width:620px;aspect-ratio:1;border-radius:14px;touch-action:none;cursor:crosshair}.plane:focus-visible{outline:4px solid #ffbf47;outline-offset:3px}.plot-bg{fill:#f8fbff;stroke:#cbd8e8;stroke-width:2}.grid-lines line{stroke:#dce6f2;stroke-width:1}.axes line{stroke:#1d3557;stroke-width:3}.axis-names,.ticks{font:700 13px system-ui;fill:#465a73}.axis-names text:nth-child(n+3){font-size:24px;fill:#8fa2ba}.guide line{stroke:#2878d0;stroke-width:2;stroke-dasharray:7 6}.marker circle:first-child,.static-point circle{fill:#ffb703;stroke:#7a4900;stroke-width:3}.marker circle:nth-child(2){fill:#563200}.marker text,.static-point text{font:900 17px system-ui;fill:#16365f}.plane-tip{text-align:center;color:#526174;font-size:.9rem}.control-panel{display:grid;gap:.8rem}.readout{display:grid;gap:.15rem;padding:1rem;border-radius:14px;background:#eef6ff}.readout strong{font-size:1.8rem;color:#174ea6}.readout small{font-weight:800;color:#425a78}.entry-row{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.entry-row label,.scale-control{display:grid;gap:.25rem;font-weight:800}.entry-row input,.scale-control select{min-height:44px;border:1px solid #aebed2;border-radius:9px;padding:.55rem;font:inherit}.direction-card,.sign-card,.mission,.feedback{display:grid;gap:.25rem;padding:.8rem;border-radius:12px;background:#f5f7fa;color:#40536b}.mission{background:#fff7d6}.primary,.secondary{min-height:44px;border-radius:9px;padding:.65rem .85rem;font-weight:850;cursor:pointer}.primary{border:0;background:#2457c5;color:#fff}.secondary{border:1px solid #2457c5;background:#fff;color:#2457c5}@media(max-width:760px){.grid-layout{grid-template-columns:1fr}.plane{max-width:none}.control-panel{max-width:620px}.grid-heading{display:grid}}@media(max-width:390px){.g7-grid{padding:.72rem}.entry-row{grid-template-columns:1fr}.ticks{font-size:11px}.axis-names text:nth-child(n+3){font-size:20px}}@media(prefers-reduced-motion:reduce){.g7-grid *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
