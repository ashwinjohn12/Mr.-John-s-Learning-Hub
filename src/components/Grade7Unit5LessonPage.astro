---
import Grade7Unit3Frame from'./Grade7Unit3Frame.astro';import LearningSection from'./LearningSection.astro';import VocabularyExplorer from'./VocabularyExplorer.astro';import Grade7Unit3Practice from'./Grade7Unit3Practice.astro';import Grade7Unit5Check from'./Grade7Unit5Check.astro';import Grade7Unit5Explore from'./Grade7Unit5Explore.astro';import Grade7Unit5Apply from'./Grade7Unit5Apply.astro';import type{Course,Unit,Topic}from'../data/courses';import type{Unit5Lesson}from'../data/grade7Unit5';
const{course,unit,topic,lesson}=Astro.props as{course:Course;unit:Unit;topic:Topic;lesson:Unit5Lesson};const lessonIndex=Number(lesson.number.split('.')[1])-1;const previous=lessonIndex===0?{title:'Unit 5 · Operations with Fractions',href:'../'}:{title:`Lesson 5.${lessonIndex}`,href:`../${unit.topics[lessonIndex-1].slug}/`};
const repairTitle=(route:string)=>{if(route.startsWith('understand-')){const i=Number(route.split('-')[1])-1;return `Lesson ${lesson.number} — Understand: ${lesson.understand[i]?.title}`;}if(route==='examples')return`Lesson ${lesson.number} — Examples: Worked examples`;return`Lesson ${lesson.number} — ${route[0].toUpperCase()+route.slice(1)}`};
const displayedExit=lesson.exit.map((x,i)=>{const k=(i+lessonIndex+1)%x.choices.length;return k?{...x,choices:[...x.choices.slice(-k),...x.choices.slice(0,-k)],answer:(x.answer+k)%x.choices.length}:x});
---
<Grade7Unit3Frame {course} {unit} {topic}>
 <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea"><div class="two-grid"><article><p class="mini-label">BEFORE YOU START</p><ul>{lesson.prerequisites.map(x=><li>{x}</li>)}</ul></article><article><p class="mini-label">BY THE END, I CAN…</p><ul>{lesson.goals.map(x=><li>{x}</li>)}</ul></article></div><p><b>{lesson.duration}</b> · <b>{lesson.outcome}</b></p><details class="pacing"><summary>Suggested two-session pathway</summary><p><b>Session 1 · 35–40 minutes:</b> readiness, Big Ideas, Understand 1–2, Example 1, Explore Predict/Build, and practice 1–2. <b>Session 2 · 35–40 minutes:</b> Understand 3 as needed, Example 2, Explore Verify, practice 3–4, Check Yourself, and exit ticket. <b>Consolidation/extension:</b> practice 5–8, extra examples, Explore Repair/Create, and Apply.</p></details><div class="warm" data-warm data-answer={lesson.warmup.answer}><h3>{lesson.warmup.prompt}</h3>{lesson.warmup.choices.map((c,i)=><label><input type="radio" name={`${lesson.slug}-warm`} value={i}/>{c}</label>)}<button type="button" data-warm-check>Check readiness</button><p data-warm-status role="status">Choose an answer when ready.</p></div></LearningSection>
 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big ideas" icon="🌎" tone="idea"><p class="big-statement">{lesson.promise}</p><div class="two-grid">{lesson.bigIdeas.map(x=><article><h3>{x.title}</h3><p>{x.body}</p></article>)}</div></LearningSection>
 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn"><div class="cards">{lesson.understand.map((x,i)=><details id={`understand-${i+1}`} open={i===0}><summary>{i+1}. {x.title}</summary><p>{x.body}</p><p><b>Model:</b> {x.model}</p><p class="mistake"><b>Common mix-up:</b> {x.mistake}</p></details>)}</div></LearningSection>
 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn"><div class="cards">{lesson.examples.map((x,i)=><details open={i===0}><summary>{x.label} · {x.question}</summary><ol>{x.steps.map(s=><li>{s}</li>)}</ol><p><b>Conclusion:</b> {x.answer}</p></details>)}</div></LearningSection>
 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={lesson.vocabulary}/></LearningSection>
 <LearningSection id="explore" eyebrow="INVESTIGATE" title={lesson.explore.title} icon="🔬" tone="explore"><Grade7Unit5Explore {lesson}/></LearningSection>
 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><Grade7Unit3Practice questions={lesson.practice} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it independently?" icon="✅" tone="review"><p>Five questions are sampled from a mathematically separate 30-question bank. Results stay hidden until the complete set is submitted.</p><Grade7Unit5Check bank={lesson.check} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="apply" eyebrow="PLAY & APPLY" title={lesson.apply.title} icon="🎮" tone="play"><Grade7Unit5Apply {lesson}/></LearningSection>
 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="two-grid"><article><h3>Retrieve</h3><ul>{lesson.bigIdeas.map(x=><li>{x.title}</li>)}</ul></article><article><h3>Be ready to explain</h3><ul>{lesson.readiness.map(x=><li>{x}</li>)}</ul></article></div><div class="exit" data-exit>{displayedExit.map((x,i)=><fieldset data-item data-answer={x.answer} data-label={repairTitle(x.route)} data-feedback={x.feedback} data-route={x.route}><legend>{i+1}. {x.prompt}</legend>{x.choices.map((c,j)=><label><input type="radio" name={`${lesson.slug}-exit-${i}`} value={j}/>{c}</label>)}<p data-reveal hidden></p></fieldset>)}<button type="button" data-submit>Submit exit ticket</button><p data-result role="status" tabindex="-1">No answers submitted.</p></div><div class="nav"><a href={previous.href}>← {previous.title}</a><a href={lesson.next.href}>{lesson.next.title} →</a></div></LearningSection>
</Grade7Unit3Frame>
<script>document.querySelectorAll<HTMLElement>('[data-warm]').forEach(r=>{const s=r.querySelector<HTMLElement>('[data-warm-status]');r.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{if(s)s.textContent='Answer changed. Check readiness again.'}));r.querySelector('[data-warm-check]')?.addEventListener('click',()=>{const x=r.querySelector<HTMLInputElement>('input:checked');if(!x){if(s)s.textContent='Choose an answer first.';r.querySelector<HTMLInputElement>('input')?.focus();return}if(s)s.textContent=Number(x.value)===Number(r.dataset.answer)?'Ready. Your prerequisite reasoning is secure.':'Use the named prerequisite and first Understand card before continuing.'})});document.querySelectorAll<HTMLElement>('[data-exit]').forEach(r=>{r.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>{const out=r.querySelector<HTMLElement>('[data-result]');if(out)out.textContent='Answer changed. Submit all three when ready.'}));r.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...r.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked')),out=r.querySelector<HTMLElement>('[data-result]');if(missing){if(out)out.textContent='Answer all three first.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach(x=>{const chosen=Number(x.querySelector<HTMLInputElement>('input:checked')?.value),answer=Number(x.dataset.answer),ok=chosen===answer;if(ok)score++;x.querySelectorAll<HTMLInputElement>('input').forEach(i=>i.disabled=true);const p=x.querySelector<HTMLElement>('[data-reveal]'),correct=x.querySelectorAll('label')[answer]?.textContent?.trim();if(p){p.hidden=false;p.innerHTML=ok?`<strong>Correct.</strong> ${x.dataset.feedback}`:`<strong>Review.</strong> Correct answer: ${correct}. ${x.dataset.feedback} <a href="#${x.dataset.route}">Repair in ${x.dataset.label}</a>.`}});if(out){out.textContent=`${score}/3. ${score===3?'Ready to continue.':'Use the exact repair section, then retry with fresh practice.'}`;out.focus()}})});</script>
<style>.two-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.two-grid article,.cards details,.warm,.exit,.pacing{padding:1rem;border:1px solid #dce5ed;border-radius:13px;background:#fff}.cards{display:grid;gap:.7rem}.cards summary{font-weight:850;cursor:pointer}.mistake{padding:.65rem;background:#fff6df}.warm,.exit{display:grid;gap:.55rem;margin-top:1rem}.warm label,.exit label{display:flex;gap:.45rem;min-height:44px;align-items:center}.warm button,.exit button{justify-self:start;min-height:44px;border:0;border-radius:8px;background:#2457c5;color:#fff;padding:.65rem .85rem;font-weight:800}.nav{display:flex;justify-content:space-between;gap:.7rem;margin-top:1rem}.nav a{padding:.75rem;border-radius:9px;background:#2457c5;color:#fff;font-weight:800;text-decoration:none}@media(max-width:700px){.two-grid{grid-template-columns:1fr}.nav{display:grid}.nav a{text-align:center}}@media(max-width:390px){.warm,.exit{padding:.75rem;overflow-wrap:anywhere}}</style>
