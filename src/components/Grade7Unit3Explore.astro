---
import type{Unit3Lesson}from'../data/grade7Unit3';const{lesson}=Astro.props as{lesson:Unit3Lesson};
const labs:any={
'fractions-to-decimals':{kind:'fraction',labels:['Numerator','Denominator'],sets:[[3,4,.75],[7,8,.875],[9,20,.45],[5,8,.625],[6,10,.6]],pred:['0.75','0.875','0.45','0.625','0.6'],action:'Divide numerator by denominator',checkpoint:'Decimal value'},
'compare-order-rational':{kind:'line',labels:['Fraction numerator','Fraction denominator'],sets:[[5,8,.625],[3,5,.6],[7,12,7/12],[9,10,.9],[11,20,.55]],pred:['0.625','0.6','0.583','0.9','0.55'],action:'Place the fraction on the benchmark line',checkpoint:'Fraction as decimal'},
'decimal-add-subtract':{kind:'place',labels:['First decimal','Second decimal'],sets:[[12.45,3.8,16.25],[7.4,.36,7.76],[9,3.47,5.53],[5.75,2.8,8.55],[10,.625,10.625]],ops:['add','add','subtract','add','add'],pred:['16','8','5.5','8.5','10.5'],action:'Align places and operate',checkpoint:'Exact result'},
'multiplying-decimals':{kind:'area',labels:['Length','Width'],sets:[[3.6,2.5,9],[2.4,1.3,3.12],[.7,.6,.42],[1.25,.8,1],[4.2,1.5,6.3]],pred:['9','3','0.4','1','6'],action:'Partition the area and combine partial products',checkpoint:'Product'},
'dividing-decimals':{kind:'groups',labels:['Dividend','Divisor'],sets:[[8.4,.7,12],[7.2,6,1.2],[6.8,.4,17],[5,8,.625],[9.45,.35,27]],pred:['12','1.2','17','0.625','27'],action:'Build equal shares or equal groups',checkpoint:'Quotient'},
'decimal-order-operations':{kind:'tree',labels:['First value','Second value'],sets:[[2.5,1.2,6.1],[4.8,1.5,7.2],[12.6,3,8.4],[9.5,2.4,8.2],[6.2,2,10.2]],pred:['6','7','8','8','10'],action:'Choose the next operation in the expression tree',checkpoint:'Expression value'},
'relating-fractions-decimals-percents':{kind:'hundred',labels:['Numerator','Denominator'],sets:[[3,5,60],[7,8,87.5],[9,20,45],[1,4,25],[13,20,65]],pred:['60','87.5','45','25','65'],action:'Connect strip, grid, and double line',checkpoint:'Percent'},
'solving-percent-problems':{kind:'percent',labels:['Percent','Whole'],sets:[[35,80,28],[15,60,9],[42,150,63],[25,72,18],[18,1200,216]],pred:['28','9','63','18','216'],action:'Build a percent bar and double number line',checkpoint:'Part'}
};const lab=labs[lesson.slug];
---
<div class="lab" data-unit3-explore data-kind={lab.kind} data-config={JSON.stringify(lab)}>
 <header><p>{lesson.explore.launch}</p><strong>Core route: Predict, Build, Verify · Repair is consolidation · Create is extension</strong></header>
 <div class="tabs" role="tablist" aria-label={`${lesson.explore.title} phases`}>{lesson.explore.phases.map((p,i)=><button id={`${lesson.slug}-tab-${i}`} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${lesson.slug}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{i+1}. {p.title}</button>)}</div>
 {lesson.explore.phases.map((p,i)=><section id={`${lesson.slug}-panel-${i}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${i}`} data-phase={i} hidden={i!==0}>
  <h3 tabindex="-1">{p.title}</h3><p>{p.instruction}</p><p class="target"><b>Checkpoint:</b> {p.target}</p>
  <div class="prompt"><b>{i===3?'Repair the supplied incorrect state.':i===4?'Create an equivalent example.':`Task values: ${lab.sets[i][0]} and ${lab.sets[i][1]}`}</b><span>{lab.action}</span></div>
  {i===0?<label>Prediction for {lab.checkpoint}<input data-prediction inputmode="decimal" aria-describedby={`${lesson.slug}-prediction-help-${i}`}/><small id={`${lesson.slug}-prediction-help-${i}`}>Enter a number that can be checked.</small></label>:
  <div class="controls"><label>{lab.labels[0]}<input data-a inputmode="decimal" value={i===3?lab.sets[i][0]+1:''}/></label><label>{lab.labels[1]}<input data-b inputmode="decimal"/></label>{lab.ops&&<label>Operation<select data-operation><option value="">Choose</option><option value="add">Add</option><option value="subtract">Subtract</option></select></label>}<button type="button" data-build>Build model</button><button type="button" data-operate disabled>Operate model</button></div>}
  <div class={`math-model ${lab.kind}`} data-model role="img" aria-label="Model not built."><div class="model-surface" data-surface></div><p data-transcript>Model transcript: not built.</p></div>
  {i===3&&<label>Identify the first error<select data-repair><option value="">Choose</option><option value="quantities">A model quantity does not match the task.</option><option value="operation">The operation is wrong.</option><option value="label">Only a label is missing.</option></select></label>}{i>0&&<label>{lab.checkpoint}<input data-checkpoint inputmode="decimal"/></label>}
  <label>Recorded evidence for self or teacher review<textarea data-evidence rows="2"></textarea></label><button type="button" data-verify>Verify phase</button><p data-status role="status">Not verified.</p>
 </section>)}
 <p class="progress" data-progress role="status">0 of 3 core phases verified.</p>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit3-explore]').forEach(root=>{const cfg=JSON.parse(root.dataset.config||'{}'),tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-tab]')],panels=[...root.querySelectorAll<HTMLElement>('[data-phase]')],passed=new Set<number>(),built=new Set<number>(),operated=new Set<number>();
 const n=(v:string)=>Number(v.trim().replace(/%|\$/g,'')),close=(a:number,b:number,t=.001)=>Number.isFinite(a)&&Math.abs(a-b)<=t;
 const created=new Map<number,number>(),expected=(i:number)=>i===4&&created.has(i)?created.get(i)!:Number(cfg.sets[i][2]),calculate=(a:number,b:number,op:string)=>root.dataset.kind==='fraction'||root.dataset.kind==='line'?a/b:root.dataset.kind==='place'?(op==='subtract'?a-b:a+b):root.dataset.kind==='area'?a*b:root.dataset.kind==='groups'?a/b:root.dataset.kind==='tree'?a+2*b:root.dataset.kind==='hundred'?a/b*100:a/100*b,announce=()=>{const core=[0,1,2].filter(i=>passed.has(i)).length;const p=root.querySelector<HTMLElement>('[data-progress]');if(p)p.textContent=`${core} of 3 core phases verified.${core===3?' Core Explore complete.':''}`;};
 const invalidate=(i:number,message='Evidence changed. Rebuild and verify this phase again.')=>{passed.delete(i);built.delete(i);operated.delete(i);created.delete(i);const panel=panels[i];panel.dataset.verified='false';panel.querySelector<HTMLButtonElement>('[data-operate]')?.setAttribute('disabled','');panel.querySelector<HTMLElement>('[data-surface]')!.innerHTML='';panel.querySelector<HTMLElement>('[data-transcript]')!.textContent='Model transcript: not built.';panel.querySelector<HTMLElement>('[data-model]')?.setAttribute('aria-label','Model not built.');const status=panel.querySelector<HTMLElement>('[data-status]');if(status)status.textContent=message;announce();};
 const activate=(i:number,focus=true)=>{tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1});panels.forEach((p,j)=>p.hidden=i!==j);if(focus)panels[i].querySelector<HTMLElement>('h3')?.focus();};
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(i));tab.addEventListener('keydown',e=>{let j=i;if(e.key==='ArrowRight')j=(i+1)%tabs.length;else if(e.key==='ArrowLeft')j=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')j=0;else if(e.key==='End')j=tabs.length-1;else return;e.preventDefault();activate(j,false);tabs[j].focus();});});
 const draw=(panel:HTMLElement,i:number,a:number,b:number,result?:number)=>{const surface=panel.querySelector<HTMLElement>('[data-surface]'),transcript=panel.querySelector<HTMLElement>('[data-transcript]');if(!surface||!transcript)return;const kind=root.dataset.kind;let html='',text='';
  if(kind==='fraction'){const parts=Math.max(1,Math.round(b));html=`<div class="strip">${Array.from({length:parts},(_,x)=>`<i class="${x<a?'on':''}"></i>`).join('')}</div><div class="division">${a} ÷ ${b}${result!==undefined?` = ${result}`:''}</div>`;text=`Fraction strip: ${a} of ${b} equal parts selected. Division ${a} divided by ${b}${result!==undefined?` equals ${result}`:''}.`;}
  else if(kind==='line'){const pos=Math.max(0,Math.min(100,a/b*100));html=`<div class="sort-cards"><b>${a}/${b}</b><b>${fmt(a/b)}</b><b>1/2</b></div><div class="number-line"><span>0</span><i style="left:${pos}%"><b>${a}/${b}</b></i><span>1</span></div>`;text=`Mixed cards show ${a}/${b}, decimal ${fmt(a/b)}, and benchmark one half. The scaled line places the fraction at ${fmt(a/b)}.`;}
  else if(kind==='place'){html=`<table class="place-grid"><tr><th>ones</th><th>tenths</th><th>hundredths</th><th>thousandths</th></tr><tr><td colspan="4">${a.toFixed(3)}</td></tr><tr><td colspan="4">${b.toFixed(3)}</td></tr>${result!==undefined?`<tr><td colspan="4"><strong>${result}</strong></td></tr>`:''}</table>`;text=`Place-value columns align ${a.toFixed(3)} and ${b.toFixed(3)}. ${result!==undefined?`The operated result is ${result}.`:''}`;}
  else if(kind==='area'){const aw=Math.floor(a),ad=a-aw,bw=Math.floor(b),bd=b-bw,parts=[aw*bw,aw*bd,ad*bw,ad*bd];html=`<div class="area-box">${parts.map((x,i)=>`<span>Region ${i+1}: ${fmt(x)}</span>`).join('')}</div>${result!==undefined?`<b>Total ${result}</b>`:''}`;text=`Rectangle ${a} by ${b} has four partial products ${parts.map(fmt).join(', ')}.${result!==undefined?` Their sum is ${result}.`:''}`;}
  else if(kind==='groups'){const count=result!==undefined?Math.min(18,Math.max(1,Math.round(result))):Math.min(12,Math.round(a/b));html=`<div class="group-row">${Array.from({length:count},()=>'<i></i>').join('')}</div><b>${a} ÷ ${b}${result!==undefined?` = ${result}`:''}</b>`;text=`Grouping model uses dividend ${a} and divisor ${b}. ${result!==undefined?`There are ${result} equal groups or units per share.`:''}`;}
  else if(kind==='tree'){html=`<div class="tree"><b>${a} + 2 × ${b}</b><span>× first</span><strong>${result??'?'}</strong></div>`;text=`Expression tree for ${a} plus 2 times ${b}. Multiplication is the first operation.${result!==undefined?` Value ${result}.`:''}`;}
  else if(kind==='hundred'){const pct=result??a/b*100;html=`<div class="representation-strip">${a}/${b} = ${fmt(a/b)} = ${fmt(pct)}%</div><div class="hundred-grid">${Array.from({length:100},(_,x)=>`<i class="${x<pct?'on':''}"></i>`).join('')}</div><div class="double-line">0 — ${fmt(pct)}% — 100%</div>`;text=`Switchboard connects ${a}/${b}, decimal ${fmt(a/b)}, and ${fmt(pct)} percent; ${Math.round(pct)} of 100 cells are shaded.`;}
  else{const pct=a,whole=b,part=result??a/100*b;html=`<div class="percent-bar"><i style="width:${Math.min(100,pct)}%"></i></div><div class="double-line">0% — ${pct}% — 100%<br>0 — ${part} — ${whole}</div>`;text=`Percent bar and double number line align ${pct} percent with ${part} of whole ${whole}.`;}
  surface.innerHTML=html;transcript.textContent=`Model transcript: ${text}`;panel.querySelector<HTMLElement>('[data-model]')?.setAttribute('aria-label',text);
 };
 panels.forEach((panel,i)=>{panel.querySelectorAll('input,select,textarea').forEach(control=>{control.addEventListener('input',()=>{if(passed.has(i)||built.has(i)||operated.has(i))invalidate(i)});control.addEventListener('change',()=>{if(passed.has(i)||built.has(i)||operated.has(i))invalidate(i)});});
  panel.querySelector('[data-build]')?.addEventListener('click',()=>{const a=n(panel.querySelector<HTMLInputElement>('[data-a]')?.value||''),b=n(panel.querySelector<HTMLInputElement>('[data-b]')?.value||''),op=panel.querySelector<HTMLSelectElement>('[data-operation]')?.value||'',ea=Number(cfg.sets[i][0]),eb=Number(cfg.sets[i][1]),repair=panel.querySelector<HTMLSelectElement>('[data-repair]')?.value;let ok=close(a,ea)&&close(b,eb)&&(!cfg.ops||op===cfg.ops[i])&&(i!==3||repair==='quantities');if(i===4){const made=calculate(a,b,op);ok=Number.isFinite(a)&&Number.isFinite(b)&&b!==0&&(!cfg.ops||!!op)&&close(made,Number(cfg.sets[i][2]),.01);if(ok)created.set(i,made);}if(!ok){panel.querySelector<HTMLElement>('[data-status]')!.textContent=i===4?'Create values that meet the stated target exactly.':i===3?'Identify the first error and rebuild the supplied quantities.':'The quantities or operation do not yet match this phase.';return}built.add(i);draw(panel,i,a,b);const go=panel.querySelector<HTMLButtonElement>('[data-operate]');if(go)go.disabled=false;panel.querySelector<HTMLElement>('[data-status]')!.textContent=i===1?'Model built. Record its exact value as the checkpoint.':'Model built. Operate it, then complete the checkpoint.';});
  panel.querySelector('[data-operate]')?.addEventListener('click',()=>{if(!built.has(i))return;const a=n(panel.querySelector<HTMLInputElement>('[data-a]')?.value||''),b=n(panel.querySelector<HTMLInputElement>('[data-b]')?.value||''),op=panel.querySelector<HTMLSelectElement>('[data-operation]')?.value||'',result=i===4?calculate(a,b,op):expected(i);if(i===4)created.set(i,result);operated.add(i);draw(panel,i,a,b,result);panel.querySelector<HTMLElement>('[data-status]')!.textContent='Model operated. Complete and verify the checkpoint.';});
  panel.querySelector('[data-verify]')?.addEventListener('click',()=>{const evidence=panel.querySelector<HTMLTextAreaElement>('[data-evidence]')?.value.trim(),prediction=panel.querySelector<HTMLInputElement>('[data-prediction]'),checkpoint=panel.querySelector<HTMLInputElement>('[data-checkpoint]');let ok=!!evidence;if(i===0)ok=ok&&close(n(prediction?.value||''),Number(cfg.pred[i]),.02);else ok=ok&&built.has(i)&&(i===1||operated.has(i))&&close(n(checkpoint?.value||''),expected(i),.02);if(ok){passed.add(i);panel.dataset.verified='true';panel.querySelector<HTMLElement>('[data-status]')!.innerHTML='<strong>Verified.</strong> The model, calculation, checkpoint, and evidence agree.';}else panel.querySelector<HTMLElement>('[data-status]')!.innerHTML='<strong>Not yet.</strong> Complete the requested model and exact checkpoint; record evidence in your own words.';announce();});
 });announce();
 function fmt(x:number){return Number(x.toFixed(3)).toString()}
});
</script>
<style>
.lab{overflow:hidden;border-radius:16px;background:#102a43;color:#fff}.lab header{display:grid;gap:.35rem;padding:1rem;background:#173f5f}.lab header p{margin:0}.tabs{display:flex;gap:.4rem;padding:.7rem;overflow-x:auto}.tabs button,.lab button{min-height:44px;border:1px solid #ffffff66;border-radius:9px;background:#ffffff12;color:#fff;padding:.65rem;font-weight:800}.tabs [aria-selected=true]{background:#f4c95d;color:#17243a}.lab section{display:grid;gap:.7rem;padding:1rem}.lab label{display:grid;gap:.35rem;font-weight:800}.lab input,.lab textarea,.lab select{box-sizing:border-box;width:100%;min-height:44px;border:1px solid #8ca7bc;border-radius:8px;padding:.65rem;font:inherit}.target,.prompt,.progress{padding:.75rem;border-radius:9px;background:#ffffff12}.prompt{display:grid}.controls{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.controls button{align-self:end}.math-model{padding:.75rem;border-radius:10px;background:#fff;color:#15293a}.math-model p{margin:.55rem 0 0}.strip{display:flex}.strip i{height:42px;flex:1;border:1px solid #60758a}.strip i.on,.hundred-grid i.on{background:#2457c5}.number-line{position:relative;height:52px;border-bottom:3px solid #20344a;display:flex;justify-content:space-between;align-items:end}.number-line i{position:absolute;bottom:-8px;width:16px;height:16px;border-radius:50%;background:#b85c1e}.place-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.35rem;text-align:center}.place-grid>*{padding:.4rem;border:1px solid #b9c7d5}.area-box{min-height:120px;border:3px solid #2457c5;display:grid;grid-template-columns:1fr 1fr;place-items:center;background:linear-gradient(90deg,#dcecff 50%,#eef7ff 50%)}.group-row{display:flex;flex-wrap:wrap;gap:.35rem}.group-row i{width:28px;height:28px;border:2px solid #2457c5;border-radius:8px}.tree{display:grid;place-items:center;gap:.4rem}.tree span{padding:.35rem;border:1px solid #60758a;border-radius:7px}.hundred-grid{display:grid;grid-template-columns:repeat(10,1fr);max-width:280px}.hundred-grid i{aspect-ratio:1;border:1px solid #aab8c6}.percent-bar{height:34px;border:2px solid #20344a}.percent-bar i{display:block;height:100%;background:#2457c5}.lab :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:620px){.controls{grid-template-columns:1fr}.tabs button{min-width:150px;scroll-snap-align:start}.tabs{scroll-snap-type:x mandatory}}@media(max-width:390px){.lab section{padding:.75rem}.math-model{overflow-x:auto}.place-grid{min-width:280px}}@media(prefers-reduced-motion:reduce){.lab *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
