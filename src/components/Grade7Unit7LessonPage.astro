---
import Grade7Unit3Frame from'./Grade7Unit3Frame.astro';import LearningSection from'./LearningSection.astro';import VocabularyExplorer from'./VocabularyExplorer.astro';import Grade7Unit3Practice from'./Grade7Unit3Practice.astro';import Grade7Unit7Check from'./Grade7Unit7Check.astro';import Grade7Unit7Explore from'./Grade7Unit7Explore.astro';import Grade7Unit7Apply from'./Grade7Unit7Apply.astro';import type{Course,Unit,Topic}from'../data/courses';import type{Unit7Lesson}from'../data/grade7Unit7';import{grade7Unit7Topics}from'../data/grade7Unit7';
const{course,unit,topic,lesson}=Astro.props as{course:Course;unit:Unit;topic:Topic;lesson:Unit7Lesson};const i=grade7Unit7Topics.findIndex(x=>x.slug===lesson.slug),previous=i===0?{title:'Unit 7 · Data Analysis and Probability',href:'../'}:{title:`Lesson ${grade7Unit7Topics[i-1].number} · ${grade7Unit7Topics[i-1].title}`,href:`../${grade7Unit7Topics[i-1].slug}/`};
const exit=lesson.exit.map((x,j)=>{const k=(j+i+1)%x.choices.length;return k?{...x,choices:[...x.choices.slice(-k),...x.choices.slice(0,-k)],answer:(x.answer+k)%x.choices.length}:x});
---
<Grade7Unit3Frame {course} {unit} {topic}>
 <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea"><div class="two"><article><p class="mini">BEFORE YOU START</p><ul>{lesson.prerequisites.map(x=><li>{x}</li>)}</ul></article><article><p class="mini">BY THE END, I CAN…</p><ul>{lesson.goals.map(x=><li>{x}</li>)}</ul></article></div><p><b>{lesson.duration}</b> · <b>Alberta outcome(s): {lesson.outcome}</b></p><details class="path"><summary>Achievable two-session core pathway</summary><p><b>Session 1 · 35–40 min:</b> readiness, Big Ideas, Understand 1–2, Examples 1–2, Explore Predict/Build, practice 1–4. <b>Session 2 · 35–40 min:</b> Understand 3–4, Examples 3–4, Explore Verify, practice 5–8, Check Yourself, exit ticket. <b>Consolidation/extension:</b> Explore Repair/Create and Apply.</p></details><div class="warm" data-warm data-answer={lesson.warmup.answer}><h3>Readiness check</h3><p>{lesson.warmup.prompt}</p>{lesson.warmup.choices.map((c,j)=><label><input type="radio" name={`${lesson.slug}-warm`} value={j}/><span>{c}</span></label>)}<button type="button" data-warm-check>Check readiness</button><p data-warm-status role="status">Choose an answer when ready.</p></div></LearningSection>
 <LearningSection id="big-ideas" eyebrow="START HERE" title="The big ideas" icon="🌎" tone="idea"><p class="promise">{lesson.promise}</p><div class="two">{lesson.bigIdeas.map(x=><article><h3>{x.title}</h3><p>{x.body}</p></article>)}</div></LearningSection>
 <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn"><div class="cards">{lesson.understand.map((x,j)=><details id={`understand-${j+1}`} open={j===0}><summary>{j+1}. {x.title}</summary><p>{x.body}</p><p class="model"><b>Representation connection:</b> {x.model}</p><p class="mistake"><b>Common mix-up:</b> {x.mistake}</p></details>)}</div></LearningSection>
 <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn"><div class="cards">{lesson.examples.map((x,j)=><details open={j===0}><summary>{x.label} · {x.question}</summary><ol>{x.steps.map(s=><li>{s}</li>)}</ol><p><b>Conclusion:</b> {x.answer}</p></details>)}</div></LearningSection>
 <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={lesson.vocabulary}/></LearningSection>
 <LearningSection id="explore" eyebrow="INVESTIGATE" title={lesson.explore.title} icon="🔬" tone="explore"><Grade7Unit7Explore {lesson}/></LearningSection>
 <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Eight questions with a two-step hint ladder" icon="✏️" tone="practice"><Grade7Unit3Practice questions={lesson.practice} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it independently?" icon="✅" tone="review"><p>Five questions are drawn from a mathematically separate 30-question bank with varied response types and rendered models. Results stay hidden until the whole set is submitted; submission locks that attempt, and regeneration creates a fresh set.</p><Grade7Unit7Check bank={lesson.check} lesson={lesson.slug}/></LearningSection>
 <LearningSection id="apply" eyebrow="APPLY" title={lesson.apply.title} icon="🎮" tone="play"><Grade7Unit7Apply {lesson}/></LearningSection>
 <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review"><div class="two"><article><h3>Retrieve</h3><ul>{lesson.bigIdeas.map(x=><li>{x.title}</li>)}</ul></article><article><h3>Readiness guidance</h3><ul>{lesson.readiness.map(x=><li>{x}</li>)}</ul></article></div><p class="guardrail"><strong>Representation guardrail:</strong> a correct number is not enough. Your table, graph, scale, label, probability model, interpretation, prediction, and decision must communicate the same mathematics.</p><div class="exit" data-exit>{exit.map((x,j)=><fieldset data-item data-answer={x.answer} data-route={x.route}><legend>{j+1}. {x.prompt}</legend>{x.choices.map((c,k)=><label><input type="radio" name={`${lesson.slug}-exit-${j}`} value={k}/><span>{c}</span></label>)}<p data-reveal hidden></p></fieldset>)}<button type="button" data-submit>Submit all three exit questions</button><p data-result role="status" tabindex="-1">No answers submitted.</p></div><div class="nav"><a href={previous.href}>← {previous.title}</a><a href={lesson.next.href}>{lesson.next.title} →</a></div></LearningSection>
</Grade7Unit3Frame>
<script>document.querySelectorAll<HTMLElement>('[data-warm]').forEach(r=>{const out=r.querySelector<HTMLElement>('[data-warm-status]')!;r.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>out.textContent='Answer changed. Check readiness again.'));r.querySelector('[data-warm-check]')?.addEventListener('click',()=>{const x=r.querySelector<HTMLInputElement>('input:checked');if(!x){out.textContent='Choose an answer first.';r.querySelector<HTMLInputElement>('input')?.focus();return}out.textContent=Number(x.value)===Number(r.dataset.answer)?'Ready. Your prerequisite reasoning is secure.':'Use the named prerequisite and first Understand card before continuing.'})});document.querySelectorAll<HTMLElement>('[data-exit]').forEach(r=>{r.querySelectorAll('input').forEach(x=>x.addEventListener('change',()=>r.querySelector<HTMLElement>('[data-result]')!.textContent='Answer changed. Submit all three when ready.'));r.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...r.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked')),out=r.querySelector<HTMLElement>('[data-result]')!;if(missing){out.textContent='Answer all three before submitting.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach(x=>{const chosen=Number(x.querySelector<HTMLInputElement>('input:checked')?.value),answer=Number(x.dataset.answer),ok=chosen===answer;if(ok)score++;x.classList.add(ok?'correct':'incorrect');x.querySelectorAll<HTMLInputElement>('input').forEach(y=>y.disabled=true);const reveal=x.querySelector<HTMLElement>('[data-reveal]')!,correct=x.querySelectorAll('label')[answer]?.textContent?.trim();reveal.hidden=false;reveal.innerHTML=ok?'<strong>Correct.</strong>':'<strong>Repair needed.</strong> Correct response: '+correct+`. <a href="#${x.dataset.route}">Go to exact repair section</a>.`});out.textContent=`${score}/3. ${score===3?'Ready to continue.':'Repair the linked concepts, then use fresh supported or independent practice.'}`;out.focus()})})</script>
<style>.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.two article,.cards details,.warm,.exit,.path{padding:1rem;border:1px solid #dce5ed;border-radius:13px;background:#fff}.cards{display:grid;gap:.7rem}.cards summary{font-weight:850;cursor:pointer}.model{padding:.65rem;background:#eef5ff}.mistake{padding:.65rem;background:#fff5df}.promise{font-size:1.08rem;font-weight:750}.warm,.exit{display:grid;gap:.55rem;margin-top:1rem}.warm label,.exit label{display:flex;gap:.5rem;min-height:44px;align-items:center}.warm button,.exit button{justify-self:start;min-height:44px;border:0;border-radius:8px;background:#2457c5;color:#fff;padding:.65rem .85rem;font-weight:850}.exit fieldset.correct{border-left:6px solid #2b6e3f}.exit fieldset.incorrect{border-left:6px solid #a44820}.guardrail{padding:.8rem;border-left:5px solid #2457c5;background:#eef5ff}.nav{display:flex;justify-content:space-between;gap:.7rem;margin-top:1rem}.nav a{padding:.75rem;border-radius:9px;background:#2457c5;color:#fff;font-weight:800;text-decoration:none}.warm :focus-visible,.exit :focus-visible,.nav a:focus-visible{outline:3px solid #ea8c00;outline-offset:2px}@media(max-width:700px){.two{grid-template-columns:1fr}.nav{display:grid}.nav a{text-align:center}}@media(max-width:390px){.warm,.exit{padding:.75rem;overflow-wrap:anywhere}}@media(max-width:375px){.two article,.cards details{padding:.8rem}}@media(max-width:320px){.warm,.exit{padding:.6rem}.nav a{padding:.65rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style>