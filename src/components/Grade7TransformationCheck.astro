---
type Level=1|2|3; type P={x:number;y:number}; type Visual={original:P[];image:P[]}; type Q={id:string;level:Level;prompt:string;correct:string;distractors:string[];feedback:string;visual?:Visual};
const qs:Q[]=[]; const fmt=(p:P)=>`(${p.x}, ${p.y})`.replaceAll('-','−');
const unique=(correct:string,pool:string[])=>[...new Set(pool)].filter(x=>x!==correct).slice(0,3);
[
 ['A transformation is…','a movement of a geometric figure',['only a change in size','a new coordinate axis','a type of measurement']],
 ['A translation is…','a slide along a straight line',['a mirror image','a turn about a fixed point','a change in scale']],
 ['A reflection creates…','a mirror image across a line of reflection',['a slide with no turn','a larger copy','a turn around a centre']],
 ['A rotation is…','a turn about a fixed centre of rotation',['a slide left or right','a mirror image','a change in axis scale']],
 ['A′ is read…','A prime',['A one','A dash','A image only']],
 ['For a reflection, corresponding points are…','the same perpendicular distance from the line of reflection',['always on the same side of the line','always on the x-axis','different distances from the line']],
 ['To describe a rotation precisely, include…','centre, angle, and direction',['only the final quadrant','only the angle','only the centre']],
 ['In a translation, every vertex…','moves the same distance and direction',['moves toward the origin','changes its label','must cross an axis']]
].forEach((x,i)=>qs.push({id:`f-${i}`,level:1,prompt:x[0],correct:x[1],distractors:x[2] as string[],feedback:x[1][0].toUpperCase()+x[1].slice(1)+'.'}));
const transCases=[{p:{x:-4,y:2},dx:5,dy:-3},{p:{x:3,y:-5},dx:-4,dy:2},{p:{x:-2,y:-6},dx:6,dy:4},{p:{x:5,y:3},dx:-3,dy:-5}];
transCases.forEach((c,i)=>{const a={x:c.p.x+c.dx,y:c.p.y+c.dy},correct=fmt(a);qs.push({id:`c-t-${i}`,level:2,prompt:`Point A${fmt(c.p)} is translated ${Math.abs(c.dx)} units ${c.dx<0?'left':'right'} and ${Math.abs(c.dy)} units ${c.dy<0?'down':'up'}. Where is A′?`,correct,distractors:unique(correct,[fmt({x:c.p.x-c.dx,y:c.p.y+c.dy}),fmt({x:c.p.x+c.dx,y:c.p.y-c.dy}),fmt({x:c.p.y+c.dx,y:c.p.x+c.dy}),fmt({x:c.p.x-c.dx,y:c.p.y-c.dy})]),feedback:`Every point follows the same translation: A′ = ${correct}.`})});
const reflCases=[{p:{x:-5,y:3},axis:'x',k:0},{p:{x:4,y:-2},axis:'y',k:0},{p:{x:-3,y:5},axis:'v',k:1},{p:{x:2,y:-6},axis:'h',k:-1}];
reflCases.forEach((c,i)=>{let a:P,desc='';if(c.axis==='x'){a={x:c.p.x,y:-c.p.y};desc='the x-axis'}else if(c.axis==='y'){a={x:-c.p.x,y:c.p.y};desc='the y-axis'}else if(c.axis==='v'){a={x:2*c.k-c.p.x,y:c.p.y};desc=`x = ${c.k}`}else{a={x:c.p.x,y:2*c.k-c.p.y};desc=`y = ${c.k}`}const correct=fmt(a);qs.push({id:`c-rf-${i}`,level:2,prompt:`Point B${fmt(c.p)} is reflected across ${desc}. Where is B′?`,correct,distractors:unique(correct,[fmt({x:-a.x,y:a.y}),fmt({x:a.x,y:-a.y}),fmt({x:c.p.y,y:c.p.x}),fmt(c.p)]),feedback:`B′ is ${correct}; it lies the same perpendicular distance from the reflection line on the opposite side.`})});
const rot=(p:P,c:P,deg:number,dir:'cw'|'ccw')=>{let q=deg/90;if(dir==='ccw')q=(4-q)%4;let x=p.x-c.x,y=p.y-c.y;for(let i=0;i<q;i++) [x,y]=[y,-x];return{x:x+c.x,y:y+c.y}};
const rotCases=[{p:{x:4,y:1},c:{x:0,y:0},d:90,dir:'cw' as const},{p:{x:-2,y:5},c:{x:0,y:0},d:180,dir:'ccw' as const},{p:{x:3,y:-1},c:{x:1,y:1},d:90,dir:'ccw' as const},{p:{x:-1,y:4},c:{x:-2,y:1},d:270,dir:'cw' as const}];
rotCases.forEach((c,i)=>{const a=rot(c.p,c.c,c.d,c.dir),correct=fmt(a);qs.push({id:`c-rot-${i}`,level:2,prompt:`Point C${fmt(c.p)} is rotated ${c.d}° ${c.dir==='cw'?'clockwise':'counterclockwise'} about ${fmt(c.c)}. Where is C′?`,correct,distractors:unique(correct,[fmt({x:-a.x,y:a.y}),fmt({x:a.x,y:-a.y}),fmt({x:a.y,y:a.x}),fmt(c.p)]),feedback:`Rotate around the stated centre, not automatically around the origin. C′ = ${correct}.`})});
const shape=[{x:-4,y:1},{x:-1,y:4},{x:2,y:1}]; const make=(kind:string)=>{if(kind==='translate')return shape.map(p=>({x:p.x+3,y:p.y-2}));if(kind==='reflectY')return shape.map(p=>({x:-p.x,y:p.y}));if(kind==='reflectX')return shape.map(p=>({x:p.x,y:-p.y}));return shape.map(p=>rot(p,{x:0,y:0},90,'cw'))};
[
 ['translate','translation 3 units right and 2 units down',['reflection in the y-axis','90° clockwise rotation about (0, 0)','reflection in the x-axis']],
 ['reflectY','reflection in the y-axis',['translation 3 units right and 2 units down','reflection in the x-axis','90° clockwise rotation about (0, 0)']],
 ['reflectX','reflection in the x-axis',['reflection in the y-axis','180° rotation about (0, 0)','translation 2 units up']],
 ['rotate','90° clockwise rotation about (0, 0)',['90° counterclockwise rotation about (0, 0)','reflection in the x-axis','translation 3 units left']]
].forEach((x,i)=>qs.push({id:`c-id-${i}`,level:2,prompt:'Which transformation maps the blue original triangle to the gold image?',correct:x[1],distractors:x[2] as string[],feedback:`The image matches a ${x[1]}.`,visual:{original:shape,image:make(x[0])}}));
[
 ['A student translates A but moves B a different amount.','Move every vertex the same distance and direction.'],
 ['A reflection image is closer to the mirror line than its original point.','Place the image the same perpendicular distance from the line on the opposite side.'],
 ['A rotation answer gives the angle but not the centre.','State the centre of rotation as well as the angle and direction.'],
 ['A student rotates around the origin even though the centre is (2, −1).','Rotate around the stated centre (2, −1), not the origin.'],
 ['A student labels a transformed vertex A instead of A′.','Use prime notation so the image vertex is clearly matched to the original.'],
 ['A student says a reflection is “move to the other side.”','Describe the line of reflection and preserve equal perpendicular distance.'],
 ['A student says a rotation is “turn it.”','Give the centre, angle, and clockwise/counterclockwise direction.'],
 ['A student changes the side lengths while translating a triangle.','A translation moves the figure without changing its size or shape.']
].forEach((x,i)=>qs.push({id:`r-error-${i}`,level:3,prompt:`Which feedback best repairs this reasoning? ${x[0]}`,correct:x[1],distractors:['Change every coordinate sign.','Move only the first vertex and copy the picture by eye.','Use horizontal and vertical distance calculations instead.'],feedback:x[1]}));
[
 ['After a rigid transformation, what should remain unchanged?','side lengths and angle sizes',['the quadrant of every vertex','the signs of every coordinate','the centre of the plane']],
 ['Why can two different transformations sometimes make images that look similar?','The type of motion can differ even when the final orientation or placement looks similar.',['Every transformation has the same centre.','Coordinates do not matter.','Reflections and translations are identical motions.']],
 ['What is the best evidence that a plotted reflection is accurate?','Corresponding points are equal perpendicular distances from the reflection line.',['All image points are in Quadrant I.','The x-coordinates are all positive.','The image is larger than the original.']],
 ['What is the strongest way to verify a transformation image?','Check every corresponding vertex against the transformation description.',['Judge whether the picture looks close enough.','Check only one vertex.','Count how many quadrants are used.']]
].forEach((x,i)=>qs.push({id:`r-reason-${i}`,level:3,prompt:x[0],correct:x[1],distractors:x[2] as string[],feedback:x[1]}));
---
<div class="transform-check" data-transform-check>
 <div class="check-head"><div><p class="mini-label">8-QUESTION INDEPENDENT CHECK</p><h3>Transformations, coordinates, and reasoning</h3><p>Each attempt contains 2 foundational, 4 core, and 2 reasoning questions with balanced A–D answer positions.</p></div><div class="bank-badge"><strong>{qs.length}</strong><span>question bank</span></div></div>
 <div class="check-items" data-items></div><div class="actions"><button type="button" data-submit>Submit all 8</button><button type="button" class="secondary" data-new>New question set</button></div><p class="result" data-result role="status" tabindex="-1">A new set is ready.</p>
 <script type="application/json" data-bank set:html={JSON.stringify(qs)}></script>
</div>
<script>
type VP={x:number;y:number}; const shuffle=<T,>(a:T[])=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
const visual=(v:{original:VP[];image:VP[]})=>{const px=(n:number)=>130+n*9,py=(n:number)=>130-n*9;let grid='';for(let i=0;i<=20;i++){const p=40+i*9;grid+=`<line x1="${p}" y1="40" x2="${p}" y2="220" stroke="#e1e8f0"/><line x1="40" y1="${p}" x2="220" y2="${p}" stroke="#e1e8f0"/>`}const poly=(pts:VP[])=>[...pts,pts[0]].map(p=>`${px(p.x)},${py(p.y)}`).join(' ');return`<svg class="mini-transform" viewBox="0 0 260 260" role="img" aria-label="Coordinate grid showing a blue original triangle and gold image triangle."><rect x="40" y="40" width="180" height="180" rx="8" fill="#f8fbff" stroke="#b9c8da"/><g>${grid}</g><path d="M40 130H220M130 40V220" stroke="#1d3557" stroke-width="2" fill="none"/><polyline points="${poly(v.original)}" fill="rgba(36,87,197,.12)" stroke="#2457c5" stroke-width="3"/><polyline points="${poly(v.image)}" fill="rgba(255,183,3,.18)" stroke="#b76e00" stroke-width="3"/></svg>`};
document.querySelectorAll<HTMLElement>('[data-transform-check]').forEach(root=>{const bank=JSON.parse(root.querySelector<HTMLScriptElement>('[data-bank]')!.textContent||'[]'),box=root.querySelector<HTMLElement>('[data-items]')!,result=root.querySelector<HTMLElement>('[data-result]')!;let attempt:any[]=[];const build=()=>{const chosen=[...shuffle(bank.filter((q:any)=>q.level===1)).slice(0,2),...shuffle(bank.filter((q:any)=>q.level===2)).slice(0,4),...shuffle(bank.filter((q:any)=>q.level===3)).slice(0,2)],positions=shuffle([0,0,1,1,2,2,3,3]);attempt=shuffle(chosen).map((q:any,i:number)=>{const pos=positions[i],wrong=[...new Set<string>(q.distractors.filter((x:string)=>x!==q.correct))];if(wrong.length<3)throw new Error(`${q.id} needs three unique distractors`);const choices=shuffle(wrong).slice(0,3);choices.splice(pos,0,q.correct);return{...q,choices,answer:pos}});box.innerHTML=attempt.map((q:any,i:number)=>`<fieldset data-item data-answer="${q.answer}"><legend><span>${i+1}</span><em>${q.prompt}</em></legend>${q.visual?visual(q.visual):''}<div class="choices">${q.choices.map((c:string,j:number)=>`<label><input type="radio" name="transform-q-${i}" value="${j}"><b>${'ABCD'[j]}</b><span>${c}</span></label>`).join('')}</div><p data-feedback hidden></p></fieldset>`).join('');result.textContent='A new set is ready.';result.focus()};root.querySelector('[data-new]')?.addEventListener('click',build);root.querySelector('[data-submit]')?.addEventListener('click',()=>{const items=[...box.querySelectorAll<HTMLElement>('[data-item]')],missing=items.find(x=>!x.querySelector('input:checked'));if(missing){result.textContent='Answer all 8 questions before submitting.';missing.querySelector<HTMLInputElement>('input')?.focus();return}let score=0;items.forEach((item,i)=>{const chosen=Number(item.querySelector<HTMLInputElement>('input:checked')!.value),answer=Number(item.dataset.answer),ok=chosen===answer;if(ok)score++;item.querySelectorAll<HTMLInputElement>('input').forEach(x=>x.disabled=true);const p=item.querySelector<HTMLElement>('[data-feedback]')!;p.hidden=false;p.textContent=ok?`Correct. ${attempt[i].feedback}`:`Repair: ${attempt[i].feedback} Correct answer: ${attempt[i].choices[answer]}.`});result.textContent=`${score}/8. ${score>=7?'Ready for the lesson review.':score>=5?'Nearly there. Repair missed ideas, then try a fresh set.':'Return to Understand and the Transformation Lab before retrying.'}`;result.focus()});build()});
</script>
<style>
.transform-check{display:grid;gap:1rem}.check-head{display:grid;grid-template-columns:1fr auto;gap:1rem}.check-head h3{margin:.1rem 0}.mini-label{margin:0;font-size:.75rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.bank-badge{display:grid;place-items:center;min-width:88px;padding:.6rem;border-radius:14px;background:#eef6ff;color:#174ea6}.bank-badge strong{font-size:1.8rem}.bank-badge span{font-size:.75rem;font-weight:800}.check-items{display:grid;gap:.8rem;min-width:0}.check-items fieldset{min-width:0;margin:0;padding:1rem;border:1px solid #d7e1ee;border-radius:14px;background:#fff}.check-items legend{display:grid;grid-template-columns:28px minmax(0,1fr);gap:.55rem;width:100%;font-weight:850;line-height:1.45}.check-items legend>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#2457c5;color:#fff}.check-items legend em{font-style:normal;overflow-wrap:anywhere}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-top:.75rem}.choices label{display:grid;grid-template-columns:auto auto minmax(0,1fr);gap:.5rem;align-items:center;min-height:48px;padding:.55rem;border:1px solid #d9e2ec;border-radius:10px}.choices label:focus-within{outline:3px solid #ffbf47;outline-offset:2px}.choices b{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#eef3fb;color:#2457c5}.choices span{overflow-wrap:anywhere}.mini-transform{display:block;width:min(290px,100%);margin:.75rem auto;background:#f8fbff;border-radius:12px}.check-items [data-feedback],.result{padding:.65rem;border-radius:10px;background:#eef6ff}.actions{display:flex;gap:.6rem;flex-wrap:wrap}.actions button{min-height:44px;border-radius:9px;padding:.65rem .85rem;font-weight:850}.actions button:first-child{border:0;background:#2457c5;color:#fff}.actions .secondary{border:1px solid #2457c5;background:#fff;color:#2457c5}@media(max-width:620px){.choices{grid-template-columns:1fr}.check-head{grid-template-columns:1fr}.bank-badge{justify-self:start;grid-auto-flow:column;gap:.5rem}}@media(max-width:390px){.check-items fieldset{padding:.75rem}}@media(prefers-reduced-motion:reduce){.transform-check *{transition:none!important;animation:none!important}}
</style>
