---
interface Props {
  active?: number;
  compact?: boolean;
}

const { active = 1, compact = false } = Astro.props;
const missions = [
  { number: 1, short: 'Evidence', title: 'Read the Ground' },
  { number: 2, short: 'Rock History', title: 'Follow the Rock Story' },
  { number: 3, short: 'Surface Change', title: 'Track the Changing Surface' },
  { number: 4, short: 'Deep Past', title: 'Read the Deep Past' },
  { number: 5, short: 'Geological Handoff', title: 'Prepare the Final Evidence' }
];
---

<nav class:list={['phase5-progress', { compact }]} aria-label="Phase 5 mission progress">
  {missions.map((mission) => (
    <div class:list={['phase5-step', { current: mission.number === active, done: mission.number < active, future: mission.number > active }]} aria-current={mission.number === active ? 'step' : undefined}>
      <span class="mission-number">{mission.number}</span>
      <span class="mission-copy"><strong>{mission.short}</strong>{!compact && <small>{mission.title}</small>}</span>
    </div>
  ))}
</nav>

<style>
.phase5-progress{display:grid;grid-template-columns:repeat(5,1fr);gap:.45rem;margin:1rem 0 1.4rem}.phase5-step{position:relative;display:flex;gap:.5rem;align-items:center;min-width:0;padding:.65rem;border:1px solid #4b5260;border-radius:11px;background:#11171a;color:#99a6aa}.phase5-step:not(:last-child)::after{content:'→';position:absolute;right:-.39rem;z-index:2;color:#647175;font-weight:900}.mission-number{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#263136;color:#c5d0d2;font-size:.78rem;font-weight:900}.mission-copy{display:grid;min-width:0}.mission-copy strong{color:inherit;font-size:.8rem;white-space:nowrap}.mission-copy small{margin-top:.08rem;color:#7e8b8f;font-size:.65rem;line-height:1.25}.phase5-step.current{border-color:#d6a45b;background:#2a2116;color:#fff2dc}.phase5-step.current .mission-number{background:#e5b66f;color:#2b1b08}.phase5-step.current .mission-copy strong{color:#ffd89d}.phase5-step.done{border-color:#58766f;background:#172722;color:#d9ece6}.phase5-step.done .mission-number{background:#345c52;color:#f1fbf7}.phase5-step.done .mission-number::after{content:'✓';font-size:.72rem}.phase5-step.done .mission-number{font-size:0}.compact .mission-copy small{display:none}
@media(max-width:900px){.phase5-progress{grid-template-columns:repeat(5,minmax(112px,1fr));overflow-x:auto;padding-bottom:.3rem}.phase5-step{min-width:112px}.mission-copy small{display:none}}
@media(max-width:560px){.phase5-progress{grid-template-columns:repeat(5,98px)}.phase5-step{display:grid;justify-items:center;text-align:center;padding:.55rem .35rem}.mission-copy strong{font-size:.68rem;white-space:normal}.phase5-step:not(:last-child)::after{display:none}}
</style>
