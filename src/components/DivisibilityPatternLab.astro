<div class="pattern-lab" data-pattern-lab>
  <div class="lab-tabs" role="tablist" aria-label="Pattern Lab phases">
    <button type="button" role="tab" aria-selected="true" data-lab-tab="chart">1 · Map patterns</button>
    <button type="button" role="tab" aria-selected="false" data-lab-tab="tester">2 · Test endings</button>
    <button type="button" role="tab" aria-selected="false" data-lab-tab="builder">3 · Change what matters</button>
    <button type="button" role="tab" aria-selected="false" data-lab-tab="sort">4 · Sort and explain</button>
  </div>

  <section class="lab-panel" data-lab-panel="chart">
    <div class="lab-heading"><div><p class="eyebrow">PHASE 1</p><h3>Map the multiples from 201 to 300</h3></div><p>Turn rules on and look for nested patterns.</p></div>
    <div class="rule-toggles" aria-label="Show divisibility patterns">
      <label><input type="checkbox" value="2" checked /> <span class="key key-2">2</span> divisible by 2</label>
      <label><input type="checkbox" value="4" /> <span class="key key-4">4</span> divisible by 4</label>
      <label><input type="checkbox" value="8" /> <span class="key key-8">★</span> divisible by 8</label>
    </div>
    <div class="number-chart" aria-label="Numbers 201 through 300"></div>
    <p class="lab-feedback" data-chart-feedback role="status">Every second number is outlined: its ones digit is even.</p>
    <details class="hint-ladder"><summary>Need a thinking prompt?</summary><ol><li><strong>Notice:</strong> Which marks always appear inside other marks?</li><li><strong>Recall:</strong> 8 = 2 × 4.</li><li><strong>Connect:</strong> If 8 groups work evenly, then 4 groups and 2 groups work too.</li><li><strong>Explain:</strong> Write an “if … then … because …” statement.</li></ol></details>
  </section>

  <section class="lab-panel" data-lab-panel="tester" hidden>
    <div class="lab-heading"><div><p class="eyebrow">PHASE 2</p><h3>Test only the digits that matter</h3></div><p>Choose a rule, predict, and reveal the place-value proof.</p></div>
    <div class="tester-controls">
      <label>Number <input type="number" min="100" max="99999" value="46728" data-test-number /></label>
      <label>Rule <select data-test-divisor><option>2</option><option>4</option><option selected>8</option><option>5</option><option>10</option></select></label>
      <button class="lab-button" type="button" data-test-new>New number</button>
    </div>
    <div class="digit-stage" aria-live="polite"><span data-masked-digits></span><strong data-relevant-digits>728</strong></div>
    <fieldset class="predict"><legend>Will the whole number divide evenly?</legend><button type="button" data-predict="yes">Yes</button><button type="button" data-predict="no">No</button></fieldset>
    <div class="lab-feedback" data-test-feedback role="status">For 8, focus on the last three digits. Make a prediction.</div>
  </section>

  <section class="lab-panel" data-lab-panel="builder" hidden>
    <div class="lab-heading"><div><p class="eyebrow">PHASE 3</p><h3>Change only what matters</h3></div><p>The prefix is locked. Adjust the ending to meet the target.</p></div>
    <div class="build-card">
      <p class="challenge-label" data-build-prompt>Build a number divisible by 2 but not by 4.</p>
      <div class="build-number"><span data-build-prefix>73</span><input aria-label="Final digits" inputmode="numeric" maxlength="3" value="4" data-build-ending /></div>
      <div class="build-actions"><button class="lab-button" type="button" data-build-check>Check my number</button><button class="lab-button secondary" type="button" data-build-next>New challenge</button></div>
      <p class="lab-feedback" data-build-feedback role="status">Change the ending, then test it.</p>
    </div>
  </section>

  <section class="lab-panel" data-lab-panel="sort" hidden>
    <div class="lab-heading"><div><p class="eyebrow">PHASE 4</p><h3>Sort by the strongest rule</h3></div><p>A number divisible by 8 belongs with 8—even though it is also divisible by 4 and 2.</p></div>
    <div class="sort-stage">
      <div class="sort-number" data-sort-number>756</div>
      <div class="sort-choices"><button type="button" data-sort="2">2 only</button><button type="button" data-sort="4">4, not 8</button><button type="button" data-sort="8">8 (also 4 and 2)</button><button type="button" data-sort="5">5, not 10</button><button type="button" data-sort="10">10 (also 5 and 2)</button></div>
      <p class="lab-feedback" data-sort-feedback role="status">Choose the most specific category, then explain the ending you used.</p>
      <button class="lab-button secondary" type="button" data-sort-next disabled>Next number</button>
    </div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pattern-lab]').forEach((lab) => {
    const relevantLength = (d:number) => d === 4 ? 2 : d === 8 ? 3 : 1;
    const tabs = [...lab.querySelectorAll<HTMLButtonElement>('[data-lab-tab]')];
    const panels = [...lab.querySelectorAll<HTMLElement>('[data-lab-panel]')];
    tabs.forEach(tab => tab.addEventListener('click', () => {
      tabs.forEach(t => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach(p => p.hidden = p.dataset.labPanel !== tab.dataset.labTab);
    }));

    const chart = lab.querySelector<HTMLElement>('.number-chart');
    if (chart) chart.innerHTML = Array.from({length:100},(_,i)=>`<span data-number="${201+i}">${201+i}</span>`).join('');
    const updateChart = () => {
      const active = [...lab.querySelectorAll<HTMLInputElement>('.rule-toggles input:checked')].map(x=>Number(x.value));
      lab.querySelectorAll<HTMLElement>('[data-number]').forEach(cell => {
        const n=Number(cell.dataset.number); cell.className='';
        active.forEach(d=>{if(n%d===0)cell.classList.add(`by-${d}`)});
        cell.setAttribute('aria-label', `${n}${active.filter(d=>n%d===0).length ? `, divisible by ${active.filter(d=>n%d===0).join(', ')}`:''}`);
      });
      const feedback=lab.querySelector('[data-chart-feedback]');
      if(feedback) feedback.textContent = active.includes(8) && active.includes(4) && active.includes(2)
        ? 'Look closely: every gold star also has the purple and blue marks. Divisibility by 8 guarantees divisibility by 4 and 2.'
        : active.length ? `You are showing multiples of ${active.join(', ')}. Add another rule to compare overlaps.` : 'Turn on a rule to reveal its pattern.';
    };
    lab.querySelectorAll('.rule-toggles input').forEach(x=>x.addEventListener('change',updateChart)); updateChart();

    const numberInput=lab.querySelector<HTMLInputElement>('[data-test-number]');
    const divisorSelect=lab.querySelector<HTMLSelectElement>('[data-test-divisor]');
    const masked=lab.querySelector<HTMLElement>('[data-masked-digits]');
    const relevant=lab.querySelector<HTMLElement>('[data-relevant-digits]');
    const testFeedback=lab.querySelector<HTMLElement>('[data-test-feedback]');
    const updateDigits=()=>{
      const raw=String(Math.max(100,Math.min(99999,Number(numberInput?.value)||100)));
      const d=Number(divisorSelect?.value||2), len=Math.min(relevantLength(d),raw.length);
      if(masked)masked.textContent=raw.slice(0,-len).replace(/\d/g,'•');
      if(relevant)relevant.textContent=raw.slice(-len);
      if(testFeedback)testFeedback.textContent=`For ${d}, focus on the last ${len===1?'digit':len===2?'two digits':'three digits'}. Make a prediction.`;
    };
    numberInput?.addEventListener('input',updateDigits); divisorSelect?.addEventListener('change',updateDigits);
    lab.querySelector('[data-test-new]')?.addEventListener('click',()=>{if(numberInput)numberInput.value=String(100+Math.floor(Math.random()*99900));updateDigits()});
    lab.querySelectorAll<HTMLButtonElement>('[data-predict]').forEach(button=>button.addEventListener('click',()=>{
      const n=Number(numberInput?.value),d=Number(divisorSelect?.value),works=n%d===0,isYes=button.dataset.predict==='yes',tail=String(n).slice(-relevantLength(d));
      if(testFeedback)testFeedback.innerHTML=`<strong>${works===isYes?'Prediction confirmed.':'Revise your prediction.'}</strong> ${tail} ${works?'is':'is not'} divisible by ${d}, so ${n.toLocaleString()} ${works?'is':'is not'} divisible by ${d}.`;
    })); updateDigits();

    const challenges=[
      {prompt:'Build a number divisible by 2 but not by 4.',prefix:'73',seed:'4',test:(n:number)=>n%2===0&&n%4!==0,tip:'The ones digit must be even, but the last two digits cannot divide evenly by 4.'},
      {prompt:'Build a number divisible by 5 but not by 10.',prefix:'81',seed:'0',test:(n:number)=>n%5===0&&n%10!==0,tip:'Which ending works for 5 but not for 10?'},
      {prompt:'Build a number divisible by 8.',prefix:'12',seed:'0',test:(n:number)=>n%8===0,tip:'Test the final three digits as one number.'},
      {prompt:'Build a number divisible by both 2 and 5.',prefix:'46',seed:'5',test:(n:number)=>n%2===0&&n%5===0,tip:'One ending satisfies both rules.'}
    ]; let buildIndex=0;
    const showBuild=()=>{const c=challenges[buildIndex]; const p=lab.querySelector('[data-build-prompt]'),prefix=lab.querySelector('[data-build-prefix]'),ending=lab.querySelector<HTMLInputElement>('[data-build-ending]'),feedback=lab.querySelector('[data-build-feedback]');if(p)p.textContent=c.prompt;if(prefix)prefix.textContent=c.prefix;if(ending)ending.value=c.seed;if(feedback)feedback.textContent='Change the ending, then test it.'};
    lab.querySelector('[data-build-check]')?.addEventListener('click',()=>{const c=challenges[buildIndex],prefix=lab.querySelector('[data-build-prefix]')?.textContent||'',ending=lab.querySelector<HTMLInputElement>('[data-build-ending]')?.value||'',n=Number(prefix+ending),feedback=lab.querySelector('[data-build-feedback]');if(feedback)feedback.innerHTML=c.test(n)?`<strong>It works.</strong> ${n} meets every condition.`:`<strong>Not yet.</strong> ${c.tip}`});
    lab.querySelector('[data-build-next]')?.addEventListener('click',()=>{buildIndex=(buildIndex+1)%challenges.length;showBuild()}); showBuild();

    const sortNumbers=[756,314,520,1024,815,1290,2312,1278]; let sortIndex=0;
    const category=(n:number)=>n%8===0?'8':n%4===0?'4':n%10===0?'10':n%5===0?'5':n%2===0?'2':'';
    const showSort=()=>{const n=sortNumbers[sortIndex],node=lab.querySelector('[data-sort-number]'),feedback=lab.querySelector('[data-sort-feedback]'),next=lab.querySelector<HTMLButtonElement>('[data-sort-next]');if(node)node.textContent=String(n);if(feedback)feedback.textContent='Choose the most specific category, then explain the ending you used.';if(next)next.disabled=true};
    lab.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach(button=>button.addEventListener('click',()=>{const n=sortNumbers[sortIndex],correct=category(n),feedback=lab.querySelector('[data-sort-feedback]'),next=lab.querySelector<HTMLButtonElement>('[data-sort-next]');if(feedback)feedback.innerHTML=button.dataset.sort===correct?`<strong>Correct.</strong> The relevant ending places ${n} in the strongest category: ${button.textContent}.`:`<strong>Try a stronger or different rule.</strong> Check the last one, two, or three digits.`;if(next)next.disabled=button.dataset.sort!==correct}));
    lab.querySelector('[data-sort-next]')?.addEventListener('click',()=>{sortIndex=(sortIndex+1)%sortNumbers.length;showSort()});showSort();
  });
</script>

<style>
  .pattern-lab{border:1px solid #cfe0d8;border-radius:18px;background:#fbfffd;overflow:hidden}.lab-tabs{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #dbe8e1}.lab-tabs button{border:0;border-right:1px solid #dbe8e1;background:#eef9f3;padding:.8rem .5rem;font-weight:800;color:#315a47;cursor:pointer}.lab-tabs button[aria-selected="true"]{background:#087f5b;color:#fff}.lab-panel{padding:1.2rem}.lab-heading{display:flex;justify-content:space-between;gap:1rem;align-items:end}.lab-heading h3{margin:.15rem 0}.lab-heading>p{max-width:310px;color:#526174}.rule-toggles{display:flex;flex-wrap:wrap;gap:.6rem;margin:1rem 0}.rule-toggles label{display:flex;align-items:center;gap:.4rem;padding:.45rem .65rem;background:#fff;border:1px solid #d9e3df;border-radius:10px;font-weight:700}.key{display:inline-grid;place-items:center;width:25px;height:25px;border-radius:6px}.key-2{border:2px solid #2563eb}.key-4{border:3px double #7c3aed}.key-8{color:#a16207}.number-chart{display:grid;grid-template-columns:repeat(10,1fr);gap:.28rem}.number-chart span{display:grid;place-items:center;min-height:36px;border:1px solid #e5e7eb;border-radius:7px;background:#fff;font-size:.78rem;position:relative}.number-chart .by-2{outline:2px solid #2563eb;outline-offset:-3px}.number-chart .by-4{border:3px double #7c3aed}.number-chart .by-8:after{content:'★';position:absolute;right:1px;top:-5px;color:#b7791f;font-size:.75rem}.lab-feedback{padding:.8rem .9rem;border-radius:12px;background:#e9f8ee;color:#176235}.hint-ladder{margin-top:.8rem}.hint-ladder summary{cursor:pointer;font-weight:800}.tester-controls{display:flex;flex-wrap:wrap;gap:.7rem;align-items:end;margin:1rem 0}.tester-controls label{display:grid;gap:.25rem;font-weight:700}.tester-controls input,.tester-controls select,.build-number input{padding:.55rem;border:1px solid #cfd9d4;border-radius:9px;background:#fff}.digit-stage{display:flex;justify-content:center;align-items:center;min-height:120px;border-radius:15px;background:#102a43;color:#7f96ab;font:800 clamp(2.5rem,8vw,4.6rem) 'Manrope';letter-spacing:.08em}.digit-stage strong{color:#fff;text-decoration:underline;text-decoration-color:#55d6a5;text-underline-offset:.15em}.predict{border:0;display:flex;gap:.7rem;align-items:center;justify-content:center;margin:1rem}.predict legend{font-weight:800;text-align:center;margin-bottom:.5rem}.predict button,.sort-choices button{border:1px solid #cfd9d4;border-radius:10px;background:#fff;padding:.65rem .9rem;font-weight:800;cursor:pointer}.lab-button{border:0;border-radius:9px;background:#087f5b;color:#fff;padding:.65rem .9rem;font-weight:800;cursor:pointer}.lab-button.secondary{background:#fff;color:#234;border:1px solid #cfd9d4}.build-card{text-align:center;padding:1.2rem;border-radius:15px;background:#fff}.challenge-label{font-weight:800}.build-number{display:flex;justify-content:center;align-items:center;font:800 3rem 'Manrope';margin:1rem}.build-number input{width:120px;font:inherit;color:#087f5b}.build-actions{display:flex;justify-content:center;gap:.6rem;flex-wrap:wrap}.sort-stage{text-align:center}.sort-number{font:800 4rem 'Manrope';color:#087f5b;margin:1rem}.sort-choices{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem}.sort-choices button:last-child{grid-column:1/-1}.challenge-label{color:#315a47}.lab-button:focus-visible,.lab-tabs button:focus-visible,.predict button:focus-visible,.sort-choices button:focus-visible{outline:3px solid #f4b942;outline-offset:2px}
  @media(max-width:700px){.lab-tabs{grid-template-columns:1fr 1fr}.lab-heading{display:block}.number-chart{grid-template-columns:repeat(5,1fr)}.sort-choices{grid-template-columns:1fr}.sort-choices button:last-child{grid-column:auto}.digit-stage{min-height:90px}.lab-panel{padding:.85rem}}
</style>
