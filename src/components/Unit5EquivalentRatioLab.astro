<div class="ratio-lab" data-ratio-lab>
  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART A · BUILD A RATIO FAMILY</p><h3>Scale both terms together</h3></div><button type="button" class="secondary" data-new-base>New ratio</button></div>
    <div class="base-ratio" data-base-ratio>2 : 3</div>
    <label class="scale-control">Scale factor <input type="range" min="1" max="6" step="1" value="2" data-scale><strong data-scale-label>×2</strong></label>
    <div class="scale-visual"><div><small>FIRST TERM</small><strong data-first-flow>2 → 4</strong></div><span>SAME FACTOR</span><div><small>SECOND TERM</small><strong data-second-flow>3 → 6</strong></div></div>
    <div class="result-ratio" data-result-ratio>2 : 3 = 4 : 6</div>
    <p class="lab-feedback">Both terms change, but the relationship stays the same.</p>
  </section>

  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART B · EQUIVALENT OR NOT?</p><h3>Test the relationship</h3></div><button type="button" class="secondary" data-new-check>New pair</button></div>
    <p class="challenge-line" data-check-prompt></p>
    <div class="choice-row"><button type="button" data-equivalent="yes">Equivalent</button><button type="button" data-equivalent="no">Not equivalent</button></div>
    <div class="lab-feedback" data-check-feedback aria-live="polite">Look for one scale factor that works for both terms.</div>
  </section>

  <section class="lab-panel">
    <div class="lab-head"><div><p class="eyebrow">PART C · MISSING TERM</p><h3>Find the scale factor first</h3></div><button type="button" class="secondary" data-new-missing>New challenge</button></div>
    <p class="challenge-line" data-missing-prompt></p>
    <div class="answer-row"><input type="number" inputmode="decimal" data-missing-answer aria-label="Missing term"><button type="button" data-check-missing>Check</button></div>
    <button type="button" class="hint-button" data-show-hint>Show a hint</button>
    <p class="hint-text" data-hint hidden></p>
    <div class="lab-feedback" data-missing-feedback aria-live="polite">Compare the matching terms you already know.</div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ratio-lab]').forEach((lab) => {
    const bases = [[1,2],[2,3],[3,4],[2,5],[3,5],[4,7]];
    let base = [2,3];
    const scale = lab.querySelector<HTMLInputElement>('[data-scale]');
    const scaleLabel = lab.querySelector('[data-scale-label]');
    const baseRatio = lab.querySelector('[data-base-ratio]');
    const firstFlow = lab.querySelector('[data-first-flow]');
    const secondFlow = lab.querySelector('[data-second-flow]');
    const resultRatio = lab.querySelector('[data-result-ratio]');
    const renderScale = () => {
      const factor = Number(scale?.value || 2);
      if (scaleLabel) scaleLabel.textContent = `×${factor}`;
      if (baseRatio) baseRatio.textContent = `${base[0]} : ${base[1]}`;
      if (firstFlow) firstFlow.textContent = `${base[0]} → ${base[0] * factor}`;
      if (secondFlow) secondFlow.textContent = `${base[1]} → ${base[1] * factor}`;
      if (resultRatio) resultRatio.textContent = `${base[0]} : ${base[1]} = ${base[0] * factor} : ${base[1] * factor}`;
    };
    scale?.addEventListener('input', renderScale);
    lab.querySelector('[data-new-base]')?.addEventListener('click', () => { base = bases[Math.floor(Math.random()*bases.length)]; if(scale) scale.value=String(2+Math.floor(Math.random()*4)); renderScale(); });
    renderScale();

    const checks = [
      {a:[2,3],b:[8,12],yes:true,why:'Both terms were multiplied by 4.'},
      {a:[3,5],b:[6,8],yes:false,why:'3 doubled to 6, but 5 doubled would be 10, not 8.'},
      {a:[4,7],b:[12,21],yes:true,why:'Both terms were multiplied by 3.'},
      {a:[5,6],b:[15,18],yes:true,why:'Both terms were multiplied by 3.'},
      {a:[2,5],b:[6,20],yes:false,why:'2 was multiplied by 3 while 5 was multiplied by 4.'},
      {a:[6,9],b:[10,15],yes:true,why:'Both ratios simplify to 2 : 3.'}
    ];
    let checkIndex = 0;
    const checkPrompt = lab.querySelector('[data-check-prompt]');
    const checkFeedback = lab.querySelector<HTMLElement>('[data-check-feedback]');
    const renderCheck = () => { checkIndex = Math.floor(Math.random()*checks.length); const t=checks[checkIndex]; if(checkPrompt) checkPrompt.textContent=`Are ${t.a[0]} : ${t.a[1]} and ${t.b[0]} : ${t.b[1]} equivalent?`; if(checkFeedback) checkFeedback.textContent='Look for one scale factor that works for both terms.'; };
    lab.querySelector('[data-new-check]')?.addEventListener('click', renderCheck);
    lab.querySelectorAll<HTMLButtonElement>('[data-equivalent]').forEach((button) => button.addEventListener('click', () => { const t=checks[checkIndex]; const choice=button.dataset.equivalent==='yes'; if(checkFeedback) checkFeedback.innerHTML = choice===t.yes ? `<strong>Correct.</strong> ${t.why}` : `<strong>Not yet.</strong> ${t.why}`; }));
    renderCheck();

    const missing = [
      {q:'3 : 4 = 15 : ?',a:20,h:'3 became 15 by ×5. Apply ×5 to 4.',e:'4 × 5 = 20.'},
      {q:'2 : 5 = ? : 20',a:8,h:'5 became 20 by ×4. Apply ×4 to 2.',e:'2 × 4 = 8.'},
      {q:'6 : 9 = 2 : ?',a:3,h:'6 became 2 by ÷3. Apply ÷3 to 9.',e:'9 ÷ 3 = 3.'},
      {q:'4 : 7 = 12 : ?',a:21,h:'4 became 12 by ×3. Apply ×3 to 7.',e:'7 × 3 = 21.'},
      {q:'? : 8 = 15 : 20',a:6,h:'20 became 8 by ×0.4. Or simplify 15 : 20 to 3 : 4, then double.',e:'15 : 20 = 3 : 4 = 6 : 8.'}
    ];
    let missingIndex = 0;
    const missingPrompt = lab.querySelector('[data-missing-prompt]');
    const missingAnswer = lab.querySelector<HTMLInputElement>('[data-missing-answer]');
    const missingFeedback = lab.querySelector<HTMLElement>('[data-missing-feedback]');
    const hint = lab.querySelector<HTMLElement>('[data-hint]');
    const hintBtn = lab.querySelector<HTMLButtonElement>('[data-show-hint]');
    const renderMissing = () => { missingIndex=Math.floor(Math.random()*missing.length); const t=missing[missingIndex]; if(missingPrompt) missingPrompt.textContent=t.q; if(missingAnswer) missingAnswer.value=''; if(missingFeedback) missingFeedback.textContent='Compare the matching terms you already know.'; if(hint){hint.textContent=t.h;hint.hidden=true;} if(hintBtn) hintBtn.textContent='Show a hint'; };
    lab.querySelector('[data-new-missing]')?.addEventListener('click', renderMissing);
    lab.querySelector('[data-check-missing]')?.addEventListener('click', () => { const t=missing[missingIndex]; if(!missingAnswer?.value){if(missingFeedback)missingFeedback.innerHTML='<strong>Add an answer first.</strong>';return;} const ok=Math.abs(Number(missingAnswer.value)-t.a)<.001; if(missingFeedback) missingFeedback.innerHTML=ok?`<strong>Correct.</strong> ${t.e}`:`<strong>Not yet.</strong> ${t.h}`; });
    hintBtn?.addEventListener('click',()=>{if(!hint)return;hint.hidden=!hint.hidden;if(hintBtn)hintBtn.textContent=hint.hidden?'Show a hint':'Hide hint';});
    renderMissing();
  });
</script>

<style>
.ratio-lab{display:grid;gap:1rem}.lab-panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.lab-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.lab-head h3{margin:.2rem 0 .8rem}.secondary,.answer-row button,.choice-row button{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.base-ratio,.result-ratio{font-size:1.3rem;font-weight:900;padding:.8rem;border-radius:12px;background:var(--course-soft);text-align:center}.scale-control{display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;margin:1rem 0;padding:.8rem;border-radius:12px;background:#f7f9fc;font-weight:800}.scale-visual{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center}.scale-visual>div{display:grid;gap:.25rem;padding:.8rem;border:1px solid #dce4ed;border-radius:12px;text-align:center}.scale-visual small{font-size:.68rem;font-weight:900;letter-spacing:.06em;color:#64748b}.scale-visual>span{font-size:.7rem;font-weight:900;color:#64748b}.lab-feedback,.hint-text{margin:.85rem 0 0;padding:.75rem .85rem;border-radius:12px;background:#f7f9fc;line-height:1.5}.challenge-line{font-size:1.15rem;font-weight:900}.choice-row,.answer-row{display:flex;gap:.6rem;flex-wrap:wrap}.answer-row input{min-width:0;flex:1;max-width:260px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px;font:inherit}.hint-button{margin-top:.65rem;border:0;background:transparent;color:var(--course);font-weight:900;cursor:pointer}
@media(max-width:650px){.lab-head,.scale-visual{display:grid}.secondary{justify-self:start}.scale-control{grid-template-columns:1fr}.answer-row input{max-width:none}}
</style>
