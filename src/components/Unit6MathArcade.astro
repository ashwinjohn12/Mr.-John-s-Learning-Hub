<div class="arcade" data-unit6-arcade>
  <div class="arcade-head"><div><p class="eyebrow">ALGEBRA LAB ESCAPE</p><h3>Unit 6 Math Arcade</h3><p>Each quest gives six free-response missions: exactly two from each Algebra lesson. Simplify, balance, solve, and verify to escape the lab.</p></div><div class="arcade-score"><strong data-score>0</strong><span>points</span><small data-streak>Streak: 0</small></div></div>
  <div class="mission-card"><div class="mission-meta"><span data-number>Mission 1 of 6</span><span data-skill></span></div><h3 data-prompt></h3><p class="format" data-format></p><label class="answer-entry"><span>Your answer</span><input type="text" autocomplete="off" data-answer><button type="button" data-check>Check mission</button></label><div class="feedback" data-feedback></div><div class="actions"><button type="button" data-next hidden>Next mission →</button><button type="button" class="secondary" data-new>New quest</button></div></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-unit6-arcade]').forEach(widget=>{const missions=[
  {lesson:'6.1',skill:'6.1 · Like terms',prompt:'Term Sorter: simplify 8x − 3x.',answers:['5x'],format:'Enter the simplified term.',explain:'8x − 3x = 5x.'},
  {lesson:'6.1',skill:'6.1 · Two variable families',prompt:'Code Wall: simplify 7x − 8y + 5y − 2x.',answers:['5x-3y','5x−3y','-3y+5x','−3y+5x'],format:'Enter a simplified equivalent expression, such as 5x-3y.',explain:'7x − 2x = 5x and −8y + 5y = −3y. Reversing the order of the two terms is also equivalent.'},
  {lesson:'6.1',skill:'6.1 · Distribute',prompt:'Expression Gate: simplify 2(x + 4) + 3x.',answers:['5x+8','8+5x'],format:'Enter a simplified equivalent expression.',explain:'2x + 8 + 3x = 5x + 8. Writing 8 + 5x is equivalent too.'},
  {lesson:'6.1',skill:'6.1 · Evaluate',prompt:'Value Scanner: when x = 3, what is the value of 4x + 2x + 1?',numeric:19,format:'Enter the numerical value.',explain:'4x + 2x = 6x; 6(3)+1 = 19.'},
  {lesson:'6.2',skill:'6.2 · One-step balance',prompt:'Balance Bay: solve x + 7 = 12.',numeric:5,format:'Enter the value of x.',explain:'Subtract 7 from both sides: x = 5.'},
  {lesson:'6.2',skill:'6.2 · Equal sharing',prompt:'Tile Station: solve 3x = 24.',numeric:8,format:'Enter the value of x.',explain:'Divide both sides into 3 equal groups: x = 8.'},
  {lesson:'6.2',skill:'6.2 · Two operations',prompt:'Balance Rescue: solve 2n − 3 = 11.',numeric:7,format:'Enter the value of n.',explain:'Add 3 to both sides, then divide 14 by 2.'},
  {lesson:'6.2',skill:'6.2 · Story equation',prompt:'Temperature Deck: the temperature rose 4°C and ended at −3°C. What was the starting temperature?',numeric:-7,format:'Enter the starting temperature number.',explain:'t + 4 = −3, so t = −7.'},
  {lesson:'6.3',skill:'6.3 · Algebraic solve',prompt:'Inverse Door: solve 3x − 6 = 12.',numeric:6,format:'Enter the value of x.',explain:'Add 6 to both sides, then divide 18 by 3.'},
  {lesson:'6.3',skill:'6.3 · Parentheses',prompt:'Distribution Door: solve 3(x + 2) = 15.',numeric:3,format:'Enter the value of x.',explain:'x + 2 = 5, so x = 3.'},
  {lesson:'6.3',skill:'6.3 · Verification',prompt:'Security Check: does x = 3 solve 2x + 5 = 12?',answers:['no','n','false'],format:'Enter yes or no.',explain:'2(3)+5 = 11, not 12, so the proposed value is not a solution.'},
  {lesson:'6.3',skill:'6.3 · Word equation',prompt:'Final Door: five times the sum of a number and 7 is 60. What is the number?',numeric:5,format:'Enter the unknown number.',explain:'5(n+7)=60 → n+7=12 → n=5.'}
 ];const prompt=widget.querySelector('[data-prompt]');const skill=widget.querySelector('[data-skill]');const number=widget.querySelector('[data-number]');const format=widget.querySelector('[data-format]');const answer=widget.querySelector<HTMLInputElement>('[data-answer]');const feedback=widget.querySelector<HTMLElement>('[data-feedback]');const score=widget.querySelector('[data-score]');const streakText=widget.querySelector('[data-streak]');const check=widget.querySelector<HTMLButtonElement>('[data-check]');const next=widget.querySelector<HTMLButtonElement>('[data-next]');const newQuest=widget.querySelector<HTMLButtonElement>('[data-new]');let pool:any[]=[];let index=0;let points=0;let streak=0;let locked=false;const shuffle=(a:any[])=>[...a].sort(()=>Math.random()-.5);const build=()=>shuffle(['6.1','6.2','6.3'].flatMap(lesson=>shuffle(missions.filter(m=>m.lesson===lesson)).slice(0,2)));const norm=(s:string)=>s.toLowerCase().trim().replace(/\s/g,'').replace(/−/g,'-').replace(/\*/g,'').replace(/[.!?]$/g,'');const render=()=>{if(index>=pool.length){if(prompt)prompt.textContent=`Escape complete — ${points} points!`;if(skill)skill.textContent='UNIT 6 COMPLETE';if(number)number.textContent='6 missions cleared';if(format)format.textContent=points>=50?'🏆 Algebra Explorer — excellent connection-making across the unit.':'Review missed mission explanations, then try a fresh balanced quest.';if(answer)answer.hidden=true;if(check)check.hidden=true;if(next)next.hidden=true;if(feedback)feedback.innerHTML='<strong>Lab escaped.</strong> A new quest will choose a different balanced mix.';return;}const m=pool[index];locked=false;if(prompt)prompt.textContent=m.prompt;if(skill)skill.textContent=m.skill;if(number)number.textContent=`Mission ${index+1} of ${pool.length}`;if(format)format.textContent=m.format;if(answer){answer.hidden=false;answer.value='';answer.focus();}if(check){check.hidden=false;check.disabled=false;}if(next)next.hidden=true;if(feedback)feedback.textContent='';if(score)score.textContent=String(points);if(streakText)streakText.textContent=`Streak: ${streak}`;};const reset=()=>{pool=build();index=0;points=0;streak=0;if(score)score.textContent='0';if(streakText)streakText.textContent='Streak: 0';render();};check?.addEventListener('click',()=>{if(locked||!answer?.value)return;const m=pool[index];const raw=answer.value;let ok=false;if(typeof m.numeric==='number'){const entered=Number(raw.replace(/[$,%\s]/g,''));ok=Number.isFinite(entered)&&Math.abs(entered-m.numeric)<.011;}else ok=m.answers.some((a:string)=>norm(a)===norm(raw));locked=true;if(ok){streak++;points+=10+(streak>=3?5:0);if(feedback)feedback.innerHTML=`<strong>Mission cleared!</strong> ${m.explain}${streak>=3?' 🔥 Streak bonus!':''}`;}else{streak=0;if(feedback)feedback.innerHTML=`<strong>Not quite.</strong> ${m.explain}`;}if(score)score.textContent=String(points);if(streakText)streakText.textContent=`Streak: ${streak}`;if(check)check.disabled=true;if(next)next.hidden=false;});next?.addEventListener('click',()=>{index++;render();});newQuest?.addEventListener('click',reset);answer?.addEventListener('keydown',e=>{if(e.key==='Enter'&&!locked)check?.click();});reset();});
</script>
<style>.arcade{border:1px solid #d8e1eb;border-radius:20px;background:#fff;padding:1.1rem}.arcade-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.arcade-head h3{margin:.2rem 0}.arcade-head p{margin:.3rem 0;color:#526174}.arcade-score{display:grid;text-align:center;min-width:100px;padding:.75rem;border-radius:14px;background:var(--course-soft)}.arcade-score strong{font-size:1.5rem}.arcade-score span,.arcade-score small{font-weight:800}.mission-card{margin-top:1rem;padding:1rem;border-radius:16px;background:#f8fafc}.mission-meta{display:flex;justify-content:space-between;gap:.7rem;color:#64748b;font-size:.75rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.format{color:#64748b}.answer-entry{display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;margin-top:1rem}.answer-entry span{font-weight:900}.answer-entry input{min-width:0;padding:.72rem;border:1px solid #cbd5e1;border-radius:10px;font:inherit}.answer-entry button,.actions button{border:0;border-radius:11px;padding:.72rem .9rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.feedback{min-height:30px;padding-top:.7rem}.actions{display:flex;gap:.6rem;flex-wrap:wrap}.actions .secondary{background:#eef3f8;color:#25364f}@media(max-width:650px){.arcade-head,.answer-entry,.mission-meta{display:grid}.arcade-score{justify-self:start}}</style>