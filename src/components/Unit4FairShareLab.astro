<section class="u4-lab fair-share-lab" data-fair-share-lab>
  <div class="lab-head">
    <p class="eyebrow">FAIR SHARE STUDIO</p>
    <h3>Share, translate, and choose the best form</h3>
    <p>Work from A to D. The goal is to connect the story, fraction, division, and final representation.</p>
  </div>

  <article class="lab-part">
    <div class="part-tag">A · SHARE THE WHOLES</div>
    <h4>How much does each group receive?</h4>
    <p class="prompt" data-share-prompt></p>
    <div class="share-visual" data-share-visual aria-label="Equal sharing model"></div>
    <div class="choice-row" data-share-choices></div>
    <p class="feedback" data-share-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-share>New share</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">B · TWO METHODS, SAME SHARE</div>
    <h4>Compare two ways to share</h4>
    <p>Method 1 gives out whole items first, then partitions the leftover. Method 2 cuts every whole into equal pieces before sharing.</p>
    <div class="method-grid">
      <div><strong>Share wholes first</strong><p data-method-one></p></div>
      <div><strong>Cut every whole first</strong><p data-method-two></p></div>
    </div>
    <div class="choice-row">
      <button type="button" data-method-answer="same">They give the same amount</button>
      <button type="button" data-method-answer="different">They give different amounts</button>
    </div>
    <p class="feedback" data-method-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-method>New comparison</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">C · FRACTION ↔ DIVISION TRANSLATOR</div>
    <h4>Match the equal-sharing statement</h4>
    <p class="prompt" data-translate-prompt></p>
    <div class="choice-row" data-translate-choices></div>
    <p class="feedback" data-translate-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-translate>New translation</button>
  </article>

  <article class="lab-part">
    <div class="part-tag">D · BEST REPRESENTATION</div>
    <h4>Which form communicates the answer best?</h4>
    <p class="prompt" data-best-prompt></p>
    <div class="choice-row" data-best-choices></div>
    <p class="feedback" data-best-feedback aria-live="polite"></p>
    <button class="secondary" type="button" data-new-best>New context</button>
  </article>
</section>

<script>
  const root = document.querySelector('[data-fair-share-lab]');
  if (root) {
    const pick = (arr) => arr[Math.floor(Math.random()*arr.length)];
    const gcd=(a,b)=>b?gcd(b,a%b):a;
    const simplify=(n,d)=>{const g=gcd(n,d);return[n/g,d/g]};
    const mixed=(n,d)=>{const whole=Math.floor(n/d),rem=n%d;if(rem===0)return `${whole}`;const [sn,sd]=simplify(rem,d);return whole?`${whole} ${sn}/${sd}`:`${sn}/${sd}`};

    const shareBank=[
      {total:5,groups:4,item:'pizzas',who:'families'},
      {total:7,groups:3,item:'pies',who:'tables'},
      {total:3,groups:5,item:'trays',who:'groups'},
      {total:8,groups:6,item:'loaves',who:'families'}
    ];
    let shareQ;
    const renderShare=()=>{
      shareQ=pick(shareBank);root.querySelector('[data-share-prompt]').textContent=`${shareQ.total} ${shareQ.item} are shared equally among ${shareQ.groups} ${shareQ.who}.`;
      const visual=root.querySelector('[data-share-visual]');visual.innerHTML='';
      for(let i=0;i<shareQ.total;i++){const w=document.createElement('div');w.className='whole-card';w.textContent='1 whole';visual.appendChild(w)}
      const correct=`${shareQ.total}/${shareQ.groups}`;const opts=[correct,`${shareQ.groups}/${shareQ.total}`,mixed(shareQ.total,shareQ.groups)].filter((v,i,a)=>a.indexOf(v)===i);
      if(opts.length<3)opts.push(`${shareQ.total+shareQ.groups}/${shareQ.groups}`);
      opts.sort(()=>Math.random()-.5);const box=root.querySelector('[data-share-choices]');box.innerHTML='';
      opts.forEach(text=>{const b=document.createElement('button');b.type='button';b.textContent=text;b.onclick=()=>{const fb=root.querySelector('[data-share-feedback]');if(text===correct||text===mixed(shareQ.total,shareQ.groups)){fb.textContent=`✓ Yes. ${shareQ.total} ÷ ${shareQ.groups} = ${correct} = ${mixed(shareQ.total,shareQ.groups)} per ${shareQ.who.slice(0,-1)}.`;fb.className='feedback good'}else{fb.textContent='Try again. Put the total quantity in the numerator and the number of equal shares in the denominator.';fb.className='feedback try'}};box.appendChild(b)});root.querySelector('[data-share-feedback]').textContent='';
    };

    let methodQ;
    const renderMethod=()=>{
      methodQ=pick(shareBank.filter(q=>q.total>q.groups));const whole=Math.floor(methodQ.total/methodQ.groups),rem=methodQ.total%methodQ.groups;
      root.querySelector('[data-method-one]').textContent=`Give each ${methodQ.who.slice(0,-1)} ${whole} whole first. Then divide the ${rem} remaining ${methodQ.item} into ${methodQ.groups} equal shares.`;
      root.querySelector('[data-method-two]').textContent=`Cut all ${methodQ.total} ${methodQ.item} into ${methodQ.groups} equal pieces each, then distribute the pieces evenly.`;
      root.querySelector('[data-method-feedback]').textContent='';
    };
    root.querySelectorAll('[data-method-answer]').forEach(btn=>btn.addEventListener('click',()=>{const fb=root.querySelector('[data-method-feedback]');if(btn.dataset.methodAnswer==='same'){fb.textContent=`✓ Correct. Both methods produce ${methodQ.total}/${methodQ.groups} = ${mixed(methodQ.total,methodQ.groups)} for each share.`;fb.className='feedback good'}else{fb.textContent='Look again. The cutting order changes the model, but not the total amount or the number of equal shares.';fb.className='feedback try'}}));

    const translateBank=[
      {text:'9 metres of ribbon shared into 4 equal lengths',correct:'9 ÷ 4 = 9/4'},
      {text:'3 cakes shared among 5 people',correct:'3 ÷ 5 = 3/5'},
      {text:'7 litres shared among 2 jugs',correct:'7 ÷ 2 = 7/2'},
      {text:'8 pies shared among 3 families',correct:'8 ÷ 3 = 8/3'}
    ];
    let transQ;
    const renderTranslate=()=>{
      transQ=pick(translateBank);root.querySelector('[data-translate-prompt]').textContent=transQ.text;
      const [a,b]=transQ.correct.split(' = ');const nums=a.split(' ÷ ');const wrong1=`${nums[1]} ÷ ${nums[0]} = ${nums[1]}/${nums[0]}`;const wrong2=`${nums[0]} × ${nums[1]} = ${Number(nums[0])*Number(nums[1])}`;
      const choices=[transQ.correct,wrong1,wrong2].sort(()=>Math.random()-.5);const box=root.querySelector('[data-translate-choices]');box.innerHTML='';
      choices.forEach(text=>{const b=document.createElement('button');b.type='button';b.textContent=text;b.onclick=()=>{const fb=root.querySelector('[data-translate-feedback]');if(text===transQ.correct){fb.textContent='✓ Correct. The quantity being shared stays first: it is the dividend and numerator.';fb.className='feedback good'}else{fb.textContent='Try again. Ask: what total amount is being shared, and how many equal shares are needed?';fb.className='feedback try'}};box.appendChild(b)});root.querySelector('[data-translate-feedback]').textContent='';
    };

    const bestBank=[
      {prompt:'$19 is shared equally between 2 people.',correct:'Decimal: $9.50',why:'Money is normally communicated in dollars and cents, so $9.50 is the clearest practical form.'},
      {prompt:'5 identical bars are shared among 9 athletes.',correct:'Fraction: 5/9',why:'5/9 is exact, while a finite rounded decimal would only approximate the repeating decimal.'},
      {prompt:'5 pizzas are shared among 4 families.',correct:'Mixed number: 1 1/4 pizzas',why:'A mixed number clearly communicates that each family gets one whole pizza and one quarter more.'},
      {prompt:'10 metres of ribbon is cut into 4 equal lengths.',correct:'Decimal: 2.5 m',why:'A decimal is practical for metric measurement, though 5/2 m is equivalent.'}
    ];
    let bestQ;
    const renderBest=()=>{
      bestQ=pick(bestBank);root.querySelector('[data-best-prompt]').textContent=bestQ.prompt;const choices=['Fraction: 5/9','Mixed number: 1 1/4 pizzas','Decimal: $9.50','Decimal: 2.5 m'].filter((v,i,a)=>v===bestQ.correct||Math.random()>.45).slice(0,3);if(!choices.includes(bestQ.correct))choices[0]=bestQ.correct;while(choices.length<3){const alt=pick(['Fraction form','Mixed-number form','Decimal form']);if(!choices.includes(alt))choices.push(alt)}choices.sort(()=>Math.random()-.5);const box=root.querySelector('[data-best-choices]');box.innerHTML='';
      choices.forEach(text=>{const b=document.createElement('button');b.type='button';b.textContent=text;b.onclick=()=>{const fb=root.querySelector('[data-best-feedback]');if(text===bestQ.correct){fb.textContent=`✓ ${bestQ.why}`;fb.className='feedback good'}else{fb.textContent='That form may be mathematically equivalent, but choose the one that communicates the amount most naturally in this context.';fb.className='feedback try'}};box.appendChild(b)});root.querySelector('[data-best-feedback]').textContent='';
    };

    root.querySelector('[data-new-share]').addEventListener('click',renderShare);
    root.querySelector('[data-new-method]').addEventListener('click',renderMethod);
    root.querySelector('[data-new-translate]').addEventListener('click',renderTranslate);
    root.querySelector('[data-new-best]').addEventListener('click',renderBest);
    renderShare();renderMethod();renderTranslate();renderBest();
  }
</script>

<style>
.u4-lab{display:grid;gap:1rem}.lab-head,.lab-part{border:1px solid #dbe4ee;border-radius:16px;padding:1rem;background:#fff}.lab-head{background:#f5f9ff}.lab-head h3,.lab-part h4{margin:.25rem 0 .55rem}.part-tag,.eyebrow{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#31598b}.prompt{font-weight:750}.choice-row{display:flex;gap:.55rem;flex-wrap:wrap;margin:.7rem 0}.choice-row button,.secondary{border:1px solid #b9c9dc;border-radius:10px;padding:.6rem .8rem;background:#fff;font:inherit;font-weight:800;cursor:pointer}.choice-row button:hover{background:#eef5ff}.secondary{background:#f7f9fc;margin-top:.55rem}.share-visual{display:flex;gap:.45rem;flex-wrap:wrap;margin:.7rem 0}.whole-card{padding:.6rem .75rem;border:2px solid #8da8c7;border-radius:9px;background:#dbeafe;font-weight:800}.method-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.method-grid>div{padding:.8rem;border-radius:12px;background:#f7f9fc;border:1px solid #e2e8f0}.feedback{min-height:1.5rem;margin:.65rem 0 0;font-weight:750}.feedback.good{color:#17633b}.feedback.try{color:#8a4b08}@media(max-width:650px){.method-grid{grid-template-columns:1fr}.choice-row button{width:100%;text-align:left}}
</style>
