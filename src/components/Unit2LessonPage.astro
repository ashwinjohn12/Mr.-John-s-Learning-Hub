---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import CoordinatePlaneLab from './CoordinatePlaneLab.astro';
import GeometryTransformLab from './GeometryTransformLab.astro';
import SymmetryChallenge from './SymmetryChallenge.astro';
import TessellationBuilder from './TessellationBuilder.astro';
import Unit2OutcomeBoost from './Unit2OutcomeBoost.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionLinks = [['overview','🎯','Overview'],['big-ideas','🌎','Big Ideas'],['understand','📘','Understand'],['examples','🧩','Examples'],['vocabulary','🧠','Vocabulary'],['explore','🔬','Explore'],['practise','✏️','Practise'],['check','✅','Check Yourself'],['apply','🎮','Apply'],['review','🏁','Review']];
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const curriculumGoalBoosts: Record<string,string[]> = {
  'rotating-shapes': ['verify a polygon rotation about one of its own vertices, not only about the origin.'],
  'congruence-symmetry': ['visualize and describe a combination of two transformations that relates two shapes.','demonstrate congruence by superimposing one shape exactly on another.'],
  'tessellations': ['investigate tessellations found in objects, art, and architecture and describe the symmetry or transformations I notice.']
};
const curriculumSuccessBoosts: Record<string,string[]> = {
  'rotating-shapes': ['I can keep a chosen polygon vertex fixed and rotate every other vertex around it.'],
  'congruence-symmetry': ['I can apply two transformations in sequence and describe the result.','I can use an exact superimposed match as evidence of congruence.'],
  'tessellations': ['I can use evidence from a real object, artwork, or architectural pattern to decide whether it is a tessellation and describe its symmetry.']
};
const displayedGoals = [...content.goals, ...(curriculumGoalBoosts[topic.slug] ?? [])];
const displayedSuccessCriteria = [...content.successCriteria, ...(curriculumSuccessBoosts[topic.slug] ?? [])];
const homeNotes: Record<string,string> = {
  'describing-location-cartesian-plane': 'Cover your picture, keep only the coordinate list, and re-plot it later. If the same picture appears, your coordinates were precise.',
  'translating-shapes': 'Trace the shape twice on separate scraps of paper, then slide one copy across a hand-drawn grid.',
  'reflecting-shapes': 'Fold tracing paper along the chosen axis, or count equal spaces on both sides of the mirror line.',
  'rotating-shapes': 'Trace the figure, hold the centre down with a pencil tip, and turn the tracing paper.',
  'congruence-symmetry': 'Trace one figure and move the tracing over the other to test for an exact match.',
  'tessellations': 'Cut one paper tile and trace it repeatedly; the on-page builder also works without extra materials.'
};
---
<BaseLayout title={`${topic.title} | ${course.grade} ${course.shortSubject}`} description={topic.summary} themeColor={course.color}>
  <div class="topic-shell" style={`--course:${course.color};--course-soft:${course.accent}`}>
    <aside class="topic-sidebar">
      <a class="back-course" href={`${base}courses/${course.slug}/${unit.slug}/`}>← {unit.title}</a>
      <p class="eyebrow">ON THIS PAGE</p><p class="scroll-cue">Swipe sections →</p>
      <nav aria-label="Lesson sections">{sectionLinks.map(([id,icon,label]) => <a href={`#${id}`}><span>{icon}</span>{label}</a>)}</nav>
    </aside>
    <article class="topic-content">
      <Breadcrumbs items={[{label:'Home',href:base},{label:`${course.grade} ${course.shortSubject}`,href:`${base}courses/${course.slug}/`},{label:unit.title,href:`${base}courses/${course.slug}/${unit.slug}/`},{label:topic.title}]} />
      <header class="topic-hero">
        <p class="eyebrow">LESSON {topic.number} · {course.grade.toUpperCase()} {course.shortSubject.toUpperCase()}</p>
        <h1>{topic.title}</h1><p>{topic.summary}</p>
        <div class="hook-card"><div><strong>Start with this</strong><small>Make a prediction. You are not expected to know the answer yet.</small></div><span>{content.hook}</span></div>
      </header>

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{displayedGoals.map((goal)=><li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{displayedSuccessCriteria.map((item)=><li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p><p>{content.bigIdeaDetail}</p><div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
        {topic.slug === 'describing-location-cartesian-plane' && <div class="quadrant-key" aria-label="Quadrant sign patterns"><div><strong>I</strong><span>(+, +)</span><small>right, up</small></div><div><strong>II</strong><span>(−, +)</span><small>left, up</small></div><div><strong>III</strong><span>(−, −)</span><small>left, down</small></div><div><strong>IV</strong><span>(+, −)</span><small>right, down</small></div></div>}
        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map((item)=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn"><div class="example-stack">{content.examples.map((example)=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map((step)=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div></LearningSection>
      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack">
          {topic.slug === 'describing-location-cartesian-plane' && <><div><h3>Tool 1 · Four-Quadrant Explorer</h3><p>Click any point or use the sliders. Connect its ordered pair, directions, axis or quadrant, and distance from the axes.</p><CoordinatePlaneLab mode="explore" /></div><div><h3>Tool 2 · Coordinate Target</h3><p>Read each ordered pair and hit its exact location. A first-try answer builds your score and streak.</p><CoordinatePlaneLab mode="target" /></div></>}
          {topic.slug === 'translating-shapes' && <div><h3>Translation Lab</h3><p>Change both movement components, predict A′, and compare all three vertex pairs.</p><GeometryTransformLab mode="translate" /></div>}
          {topic.slug === 'reflecting-shapes' && <div><h3>Reflection Lab</h3><p>Switch the mirror axis, predict A′, and look for equal perpendicular distance.</p><GeometryTransformLab mode="reflect" /></div>}
          {topic.slug === 'rotating-shapes' && <div><h3>Rotation Lab</h3><p>Turn the triangle about vertex A, then compare equivalent angles and directions.</p><GeometryTransformLab mode="rotate" /></div>}
          {topic.slug === 'congruence-symmetry' && <div><h3>Congruence & Symmetry Detective</h3><p>Decide first, then use the explanation to test your evidence.</p><SymmetryChallenge /></div>}
          {topic.slug === 'tessellations' && <div><h3>Tessellation Builder</h3><p>Experiment with tile shape, spacing, colour, and the two requirements for a tessellation.</p><TessellationBuilder /></div>}
          <Unit2OutcomeBoost topic={topic.slug} />
        </div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map((item)=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> {homeNotes[topic.slug]}</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={content.questions} /></LearningSection>
      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>This bank is separate from the practice questions. Each new set randomly selects five questions from a larger bank, so a new set should feel genuinely different.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>
      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map((task)=><li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map((item)=><li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map((item)=><label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span>Coming next →</span>}</div>
      </LearningSection>
    </article>
  </div>
</BaseLayout>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft,#eef4ff);line-height:1.55}.hook-card>div{display:grid;align-content:start;gap:.2rem}.hook-card small{display:block;max-width:200px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.wrap-grid ul,.worked-example ol,.hands-on-card ol,.lesson-challenge ol{padding-left:1.2rem}.overview-grid li,.wrap-grid li,.worked-example li,.hands-on-card li,.lesson-challenge li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.success-box{margin-top:1rem}.concept-grid.detailed>div{position:relative}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.mixups{margin-top:1.2rem}.quadrant-key{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-top:1rem}.quadrant-key div{display:grid;gap:.15rem;text-align:center;padding:.75rem .4rem;border-radius:12px;background:#eef6ff}.quadrant-key strong{font-size:1.25rem;color:#174ea6}.quadrant-key span{font-weight:900}.quadrant-key small{color:#526174}.example-stack,.explore-stack{display:grid;gap:1rem}.worked-example,.hands-on-card,.pat-card{border:1px solid #dce4ed;border-radius:16px;padding:1rem 1.1rem;background:#fff}.worked-example h3{margin:.25rem 0 .7rem}.example-answer{margin-top:.8rem;padding:.75rem .85rem;border-radius:12px;background:#f0fdf4}.explore-stack>div{display:grid;gap:.55rem}.explore-stack h3{margin-bottom:0}.explore-stack p{margin-top:0}.hands-on-card{margin-top:1rem;background:#fffdf5}.home-note{margin-top:1rem;padding:.8rem .9rem;border-radius:12px;background:#f5f8fc}.section-lead{font-size:1.05rem}.lesson-challenge{display:grid;gap:.8rem}.pat-card{margin:1rem 0;background:#f8fafc}.pat-card h3{font-size:1rem;line-height:1.5}.next-step a{text-decoration:none}.scroll-cue{display:none}
@media(max-width:760px){.overview-grid,.wrap-grid{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.hook-card{grid-template-columns:1fr}.hook-card small{max-width:none}.quadrant-key{grid-template-columns:repeat(2,1fr)}.topic-hero{padding-top:2rem;padding-bottom:3rem}.topic-hero h1{font-size:clamp(2.2rem,11vw,3.25rem);line-height:1.04}.scroll-cue{display:block;margin:-.35rem 0 .45rem;color:#64748b;font-size:.76rem;font-weight:700}.topic-sidebar nav{scrollbar-width:thin}}
</style>
