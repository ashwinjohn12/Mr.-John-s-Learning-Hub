<div class="game" data-rate-game>
  <div class="game-head"><div><p class="eyebrow">RATE RACE</p><h3>Compare, decide, explain</h3><p>Use unit rates to clear three real-world missions.</p></div><div class="meter"><strong data-round-label>Round 1 of 3</strong><span><i data-progress></i></span></div></div>
  <section class="round" data-round="1"><p class="round-tag">ROUND 1 · BEST BUY</p><h3>Which is the better deal: 3 notebooks for $6.00 or 5 notebooks for $9.00?</h3><div class="choices"><button data-choice="a">3 for $6</button><button data-choice="b">5 for $9</button></div><p class="feedback" data-feedback></p></section>
  <section class="round" data-round="2" hidden><p class="round-tag">ROUND 2 · SPEED CHECK</p><h3>Runner A travels 10 km in 2 h. Runner B travels 18 km in 3 h. Who is faster?</h3><div class="choices"><button data-choice="a">Runner A</button><button data-choice="b">Runner B</button><button data-choice="same">Same speed</button></div><p class="feedback" data-feedback></p></section>
  <section class="round" data-round="3" hidden><p class="round-tag">ROUND 3 · EXTEND THE RATE</p><h3>A printer makes 30 pages in 2 min. How many pages can it make in 8 min?</h3><div class="answer-row"><input type="number" data-final-answer aria-label="Pages printed"><button data-final-check>Check answer</button></div><p class="feedback" data-feedback></p></section>
  <div class="complete" data-complete hidden><p class="eyebrow">MISSION COMPLETE</p><h3>🏆 Unit Rate Navigator</h3><p>You compared different totals fairly by converting them to the same “per 1” basis.</p><button type="button" data-restart>Play again</button></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-rate-game]').forEach(game=>{let round=1;const progress=game.querySelector<HTMLElement>('[data-progress]');const label=game.querySelector('[data-round-label]');const show=(n:number)=>{round=n;game.querySelectorAll<HTMLElement>('[data-round]').forEach(el=>el.hidden=Number(el.dataset.round)!==n);if(progress)progress.style.width=`${(n-1)/3*100}%`;if(label)label.textContent=`Round ${n} of 3`;};const success=(section:HTMLElement,text:string)=>{section.querySelector<HTMLElement>('[data-feedback]')!.innerHTML=`<strong>Correct.</strong> ${text}`;setTimeout(()=>show(round+1),450)};game.querySelector('[data-round="1"]')?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="1"]')!;if(b.dataset.choice==='b')success(s,'$6 ÷ 3 = $2.00 each, while $9 ÷ 5 = $1.80 each.');else s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> Compare the cost for exactly one notebook.';}));game.querySelector('[data-round="2"]')?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="2"]')!;if(b.dataset.choice==='b')success(s,'Runner A is 5 km/h and Runner B is 6 km/h.');else s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> Convert both distances to kilometres per 1 hour.';}));const final=game.querySelector<HTMLInputElement>('[data-final-answer]');game.querySelector('[data-final-check]')?.addEventListener('click',()=>{const s=game.querySelector<HTMLElement>('[data-round="3"]')!;if(Number(final?.value)===120){s.hidden=true;game.querySelector<HTMLElement>('[data-complete]')!.hidden=false;if(progress)progress.style.width='100%';if(label)label.textContent='3 rounds complete';}else s.querySelector<HTMLElement>('[data-feedback]')!.innerHTML='<strong>Not yet.</strong> Find pages per minute first.';});game.querySelector('[data-restart]')?.addEventListener('click',()=>{game.querySelector<HTMLElement>('[data-complete]')!.hidden=true;if(final)final.value='';game.querySelectorAll<HTMLElement>('[data-feedback]').forEach(f=>f.textContent='');show(1)});show(1);});
</script>
<style>.game{border:1px solid #d9e2ec;border-radius:18px;background:#fff;padding:1rem}.game-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.game-head h3{margin:.2rem 0}.meter{min-width:170px;display:grid;gap:.35rem;font-size:.78rem;font-weight:900}.meter>span{height:9px;background:#e8edf3;border-radius:999px;overflow:hidden}.meter i{display:block;height:100%;background:var(--course);transition:width .25s}.round{margin-top:1rem;padding:1rem;border-radius:14px;background:#f8fafc}.round-tag{font-size:.72rem;font-weight:900;letter-spacing:.06em;color:#64748b}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.choices button,.answer-row button,.complete button{border:0;border-radius:11px;padding:.75rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.answer-row{display:flex;gap:.6rem}.answer-row input{flex:1;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.feedback{min-height:26px;padding-top:.6rem}.complete{text-align:center;padding:1.4rem}.complete h3{font-size:1.5rem}@media(max-width:650px){.game-head,.choices,.answer-row{display:grid}}</style>