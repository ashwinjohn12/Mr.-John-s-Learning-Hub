---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  missionNumber:string;
  title:string;
  tagline:string;
  question:string;
  success:string;
  nextTitle?:string;
  nextHref?:string;
  try4Text?:string;
  stages?:string[];
  statusLabel?:string;
}
const {missionNumber,title,tagline,question,success,nextTitle,nextHref,try4Text='Check → Simulate → Download → Partner',stages=['Set Up','First Code','Make It React','Build It','Level It Up','Checkpoint'],statusLabel='ACTIVE'}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`Mission ${missionNumber}: ${title} | FutureTech Lab`} description={success} themeColor="#5b21b6">
  <div class="ft-mission">
    <Breadcrumbs items={[{label:'Home',href:base},{label:'FutureTech Lab',href:`${base}courses/futuretech-lab/`},{label:'Creator Foundations',href:`${base}courses/futuretech-lab/creator-foundations/`},{label:`Mission ${missionNumber}`}]} />
    <header class="mission-hero"><div><p class="mission-code">FUTURETECH // LEVEL 01 // MISSION {missionNumber.padStart(2,'0')}</p><h1><small>Mission {missionNumber}</small>{title}</h1><p class="mission-tagline">{tagline}</p></div><div class="mission-status"><span>STATUS</span><strong>● {statusLabel}</strong></div></header>
    <div class="mission-brief"><article><span>MISSION QUESTION</span><strong>{question}</strong></article><article><span>YOU ARE READY WHEN...</span><strong>{success}</strong></article></div>
    <nav class="stage-nav" aria-label="Mission stages">{stages.map((stage,i)=><a href={`#stage-${i+1}`}><b>{i+1}</b><span>{stage}</span></a>)}</nav>
    <aside class="mission-help" aria-label="What to do if you get stuck"><strong>Start at Stage 1 and work in order.</strong><span>Stuck anywhere? TRY 4: <b>{try4Text}.</b></span></aside>
    <main class="mission-body"><slot /></main>
    {nextTitle && nextHref && <aside class="next-mission"><div><span>NEXT MISSION</span><strong>{nextTitle}</strong></div><a href={nextHref}>Checkpoint complete? Continue →</a></aside>}
  </div>
</BaseLayout>
<style>
.ft-mission{--purple:#5b21b6;--violet:#7c3aed;--cyan:#0891b2;--green:#15803d;--orange:#c2410c;--ink:#172033;--muted:#667085;max-width:1080px;margin:auto;padding:1rem}.mission-hero{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin:1rem 0;padding:clamp(1.25rem,4vw,2.2rem);border-radius:24px;background:radial-gradient(circle at 88% 15%,rgba(103,232,249,.18),transparent 25%),linear-gradient(135deg,#111827,#4c1d95 65%,#155e75);color:#fff;box-shadow:0 16px 42px rgba(30,20,70,.2)}.mission-code{margin:0;color:#67e8f9;font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.mission-hero h1{margin:.35rem 0 .3rem;font-size:clamp(2.7rem,7vw,5rem);line-height:.92;letter-spacing:-.05em}.mission-hero h1 small{display:block;margin-bottom:.35rem;color:#c4b5fd;font-size:.9rem;letter-spacing:.04em;text-transform:uppercase}.mission-tagline{margin:.65rem 0 0;color:#e5e7eb;font-size:1.05rem;font-weight:750}.mission-status{display:grid;gap:.2rem;justify-items:end;padding:.75rem .85rem;border:1px solid rgba(255,255,255,.18);border-radius:14px;background:rgba(255,255,255,.06)}.mission-status span{font:800 .65rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;color:#cbd5e1}.mission-status strong{color:#67e8f9;font-size:.82rem}.mission-brief{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:1rem 0}.mission-brief article{display:grid;gap:.35rem;padding:1rem 1.05rem;border-radius:16px;background:#f8fafc;border:1px solid #e3e8f0}.mission-brief article:first-child{background:#eff6ff;border-color:#bfdbfe}.mission-brief article:last-child{background:#f0fdf4;border-color:#bbf7d0}.mission-brief span{font-size:.66rem;font-weight:900;letter-spacing:.09em;color:#64748b}.mission-brief strong{color:var(--ink);font-size:.98rem;line-height:1.45}.stage-nav{display:grid;grid-template-columns:repeat(6,1fr);gap:.35rem;margin:1rem 0 .65rem}.stage-nav a{display:grid;gap:.25rem;min-height:68px;padding:.55rem .6rem;border-radius:12px;background:#f5f3ff;color:var(--ink);text-decoration:none;border:1px solid #e9e4fb}.stage-nav b{color:var(--violet);font:900 .68rem ui-monospace,SFMono-Regular,Menlo,monospace}.stage-nav span{font-size:.78rem;font-weight:850;line-height:1.2}.stage-nav a:hover{background:#ede9fe}.mission-help{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:0 0 1.2rem;padding:.7rem .8rem;border:1px solid #fed7aa;border-radius:11px;background:#fff7ed;color:#7c2d12;font-size:.86rem}.mission-help strong{color:#9a3412}.mission-help span{text-align:right}.mission-body{display:grid;gap:.9rem}.mission-body :global(.stage){scroll-margin-top:96px;padding:1rem 1.05rem;border:1px solid #dde4ed;border-radius:18px;background:#fff;box-shadow:0 6px 20px rgba(15,23,42,.04)}.mission-body :global(.stage-head){display:flex;gap:.7rem;align-items:center;margin-bottom:.75rem}.mission-body :global(.stage-number){display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:#5b21b6;color:#fff;font:900 .8rem ui-monospace,SFMono-Regular,Menlo,monospace;flex:0 0 auto}.mission-body :global(.stage-title){margin:0;color:var(--ink);font-size:clamp(1.25rem,3vw,1.65rem)}.mission-body :global(.stage-kicker){margin:0 0 .1rem;color:#7c3aed;font-size:.65rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.mission-body :global(.intro){margin:.25rem 0 .85rem;color:var(--muted);line-height:1.55}.mission-body :global(.step-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.mission-body :global(.step-card){padding:.8rem .85rem;border-radius:13px;background:#f8fafc;border:1px solid #e6eaf0}.mission-body :global(.step-card strong){display:block;margin-bottom:.25rem;color:var(--ink)}.mission-body :global(.step-card p){margin:0;color:var(--muted);line-height:1.45;font-size:.9rem}.mission-body :global(.step-card code){font-weight:800;color:#5b21b6;background:#ede9fe;padding:.08rem .28rem;border-radius:5px}.mission-body :global(.check-list){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:.7rem 0 0}.mission-body :global(.check-list span){padding:.55rem .65rem;border-radius:10px;background:#f8fafc;border:1px solid #e5e9ef;font-size:.9rem}.mission-body :global(.concept){margin:.7rem 0;padding:.8rem .9rem;border-left:4px solid #7c3aed;border-radius:0 10px 10px 0;background:#f5f3ff;color:#37205f;font-weight:800}.mission-body :global(.success){margin:.6rem 0;padding:.7rem .8rem;border-radius:10px;background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;font-weight:750}.mission-body :global(.warning){margin:.6rem 0;padding:.7rem .8rem;border-radius:10px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;font-weight:750}.mission-body :global(.try4){padding:.85rem;border-radius:14px;background:#fff7ed;border:1px solid #fed7aa}.mission-body :global(.try4 strong){color:#9a3412}.mission-body :global(.try4 p){margin:.3rem 0 0;color:#7c2d12;line-height:1.5}.mission-body :global(.level-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.mission-body :global(.level-card){padding:.8rem;border-radius:12px;background:#ecfeff;border:1px solid #a5f3fc}.mission-body :global(.level-card strong){display:block;color:#155e75}.mission-body :global(.level-card p){margin:.25rem 0 0;color:#52717c;line-height:1.4;font-size:.9rem}.mission-body :global(.checkpoint){background:linear-gradient(135deg,#f0fdf4,#fff);border-color:#bbf7d0}.mission-body :global(.passport),.mission-body :global(.reset){background:#f8fafc}.mission-body :global(.mini-label){display:inline-block;margin:.25rem 0;color:#64748b;font-size:.68rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.mission-body :global(.partner-strip){display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.7rem 0}.mission-body :global(.partner-strip span){padding:.65rem;border-radius:10px;background:#eff6ff;border:1px solid #bfdbfe}.mission-body :global(.partner-strip strong){display:block;color:#1d4ed8;font-size:.78rem}.mission-body :global(.partner-strip small){color:#52647d}.mission-body :global(a.external){color:#5b21b6;font-weight:850}.mission-body :global(.route){display:flex;gap:.5rem;flex-wrap:wrap;margin:.55rem 0}.mission-body :global(.route span){padding:.4rem .55rem;border-radius:999px;background:#ede9fe;color:#5b21b6;font-size:.75rem;font-weight:900}.next-mission{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin:1.3rem 0 2rem;padding:1rem 1.1rem;border-radius:16px;background:#111827;color:#fff}.next-mission span{display:block;color:#67e8f9;font-size:.66rem;font-weight:900;letter-spacing:.08em}.next-mission strong{font-size:1.05rem}.next-mission a{padding:.7rem .85rem;border-radius:10px;background:#67e8f9;color:#083344;text-decoration:none;font-weight:900;white-space:nowrap;max-width:100%;box-sizing:border-box;text-align:center}.ft-mission :focus-visible{outline:3px solid #06b6d4;outline-offset:3px}@media(max-width:760px){.mission-hero,.mission-brief,.next-mission{grid-template-columns:1fr}.mission-status{justify-items:start;width:max-content}.stage-nav{grid-template-columns:repeat(3,1fr)}.mission-help{display:grid}.mission-help span{text-align:left}.mission-body :global(.step-grid),.mission-body :global(.check-list),.mission-body :global(.level-grid){grid-template-columns:1fr}.mission-body :global(.partner-strip){grid-template-columns:1fr}.next-mission a{width:100%;white-space:normal}}@media(max-width:430px){.ft-mission{padding:.65rem}.stage-nav{grid-template-columns:repeat(2,1fr)}}
</style>
