---
import type { Unit2Lesson } from '../data/grade7Unit2';
interface Props{lesson:Unit2Lesson}
type Lab={a:number;b:number;result:number;p?:number;n?:number;pairs?:number;orientation?:'horizontal'|'vertical';rule?:'exact'|'target';context?:string};
const {lesson}=Astro.props;
const labSets:Record<string,Lab[]>={
  'representing-integers':[
    {a:-7,b:0,result:-7,p:2,n:9,context:'below'},{a:5,b:0,result:5,p:8,n:3,context:'gain'},{a:0,b:0,result:0,p:6,n:6,context:'reference'},{a:-4,b:0,result:-4,p:3,n:7,context:'opposite'},{a:6,b:0,result:6,p:9,n:3,context:'gain'}
  ],
  'adding-integers-tiles':[
    {a:-7,b:12,result:5},{a:8,b:-11,result:-3},{a:-5,b:-4,result:-9},{a:6,b:-6,result:0},{a:9,b:-4,result:5,rule:'target'},{a:-10,b:3,result:-7,rule:'target'}
  ],
  'adding-integers-number-line':[
    {a:-4,b:9,result:5,orientation:'horizontal'},{a:7,b:-12,result:-5,orientation:'horizontal'},{a:-6,b:11,result:5,orientation:'vertical'},{a:3,b:-7,result:-4,orientation:'horizontal'},{a:-5,b:5,result:0,orientation:'horizontal'},{a:-8,b:14,result:6,orientation:'horizontal'},{a:4,b:-9,result:-5,orientation:'horizontal'}
  ],
  'subtracting-integers-tiles':[
    {a:7,b:3,result:4,pairs:0},{a:4,b:10,result:-6,pairs:6},{a:-3,b:-8,result:5,pairs:5},{a:2,b:-5,result:7,pairs:5},{a:-6,b:4,result:-10,pairs:4},{a:9,b:5,result:4,pairs:0},{a:-5,b:-9,result:4,pairs:4},{a:3,b:-7,result:10,pairs:7}
  ],
  'subtracting-integers-number-line':[
    {a:-7,b:-6,result:-1},{a:3,b:-10,result:13},{a:-2,b:-7,result:5},{a:-8,b:3,result:-11},{a:6,b:-4,result:10},{a:-5,b:8,result:-13},{a:-8,b:-11,result:3},{a:3,b:-8,result:11}
  ]
};
const signed=(n:number)=>n>0?`+${n}`:`${n}`;
const instructions:Record<string,string[]>={
 'representing-integers':['Match “7 below the reference” to −7, then construct it with exactly 2 positive and 9 negative chips.','Build +5 with exactly 8 positive and 3 negative chips, then match it to a gain of 5.','Use exactly 6 positive and 6 negative chips to model zero.','Build −4 with exactly 3 positive and 7 negative chips and match its context.','Match a gain of 6 to +6. Build the stated Model A, create a different Model B with the same value, and enter magnitude 6.'],
 'adding-integers-tiles':['Predict and load −7 and +12 in separate trays.','Combine +8 and −11 without simplifying first.','Cancel all unlike pairs in (−5)+(−4) and explain why none form.','Test the opposite-addend case (+6)+(−6).','Start with empty trays. Create and load any two nonzero unlike-sign addends whose sum is +5, then combine and cancel.','Start with empty trays. Create and load any two nonzero unlike-sign addends whose sum is −7, then combine and cancel.'],
 'adding-integers-number-line':['Set start −4 and jump +9 on a horizontal line.','Trace +7+(−12) across zero.','Use a vertical temperature line for −6+(+11).','Compare the jump +3+(−7) with a chip model and verify the shared endpoint.','Repair a diagram that incorrectly starts at zero instead of −5.','Repair a route label so +14 is the signed change and +6 is the endpoint.','Predict the final endpoint. Then program start +4 with changes −9, +7, and −4; record endpoints −5, +2, and −2.'],
 'subtracting-integers-tiles':['Build +7 first, then remove +3.','Identify +10 as the chip type and amount to remove from +4.','Decide whether −3 contains enough negatives to remove −8.','Add exactly five complete zero pairs to +2 before removing −5.','Remove +4 from −6 and record the remainder.','Model (+9)−(+5) and (+5)−(+9); verify that the differences are opposites.','Identify combining −5 and −9 as the first wrong step, then rebuild only the minuend before subtracting.','Replace unmatched chips with seven complete zero pairs; verify +3 is unchanged before removing −7.'],
 'subtracting-integers-number-line':['Predict (−7)−(−6), then rewrite it as addition of the opposite.','Run 3−(−10) as a rightward jump.','Verify (−2)−(−7) with chips and a line.','Compare removing +3 from −8 with moving left 3.','Repair a rewrite by changing only the subtrahend to its opposite.','Choose the number line as an efficient model for (−5)−(+8).','Repair a faulty rewrite and an off-by-one line for (−8)−(−11); count intervals, not tick marks.','For (+3)−(−8), choose chips for removal, a line for directed change, and symbols for the rewrite; keep distance separate.']
};
const rotate=<T,>(items:T[],shift:number)=>{const n=shift%items.length;return n?[...items.slice(-n),...items.slice(0,-n)]:[...items]};
const labs=labSets[lesson.slug].map((lab,index)=>{
  const routePhase=lesson.slug==='adding-integers-number-line'&&index===6;
  const correct=routePhase
    ? 'Start +4; jump −9 to −5, +7 to +2, then −4 to −2.'
    : lesson.slug==='representing-integers'?`${lab.p}P and ${lab.n}N represent ${signed(lab.result)}.`:lesson.slug.includes('subtracting')?`${signed(lab.a)} − (${signed(lab.b)}) = ${signed(lab.result)}`:`${signed(lab.a)} + (${signed(lab.b)}) = ${signed(lab.result)}`;
  const distractors=routePhase
    ? ['The endpoints are −5, −2, and −6.','Restart at zero for each jump and finish at −4.','The three changes are also the three endpoints.']
    : [`The result is ${signed(lab.result===0?1:-lab.result)}.`,`The result is ${signed(lab.result+(lab.result>=0?2:-2))}.`,`The sign cannot be determined.`];
  const choices=rotate([correct,...distractors],index);
  return {...lab,instruction:instructions[lesson.slug][index],choices,answer:choices.indexOf(correct),prediction:routePhase?-2:lab.result};
});
---
<div class="explore-lab" data-unit2-explore data-variant={lesson.slug}>
  <div class="lab-launch"><p class="eyebrow">YOUR MISSION</p><h3>{lesson.explore.title}</h3><p>{lesson.explore.launch}</p><p><strong>Core route:</strong> phases 1–3. <strong>Consolidation/extension:</strong> later phases.</p></div>
  <p class="mobile-cue">On a narrow screen, swipe the phase row or use the arrow keys.</p>
  <div class="lab-tabs" role="tablist" aria-label="Investigation phases">{lesson.explore.phases.map((phase,index)=><button id={`${lesson.slug}-tab-${index}`} type="button" role="tab" aria-selected={index===0?'true':'false'} aria-controls={`${lesson.slug}-phase-${index}`} tabindex={index===0?'0':'-1'}><span>{index+1}</span>{phase.title}<small>{index<3?'Core':'Extension'}</small></button>)}</div>
  <div class="lab-panels">{lesson.explore.phases.map((phase,index)=>{const lab=labs[index];return <section id={`${lesson.slug}-phase-${index}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${index}`} data-panel data-index={index} data-a={lab.a} data-b={lab.b} data-result={lab.result} data-p={lab.p} data-n={lab.n} data-pairs={lab.pairs} data-orientation={lab.orientation} data-rule={lab.rule} hidden={index!==0}>
    <p class="phase-instruction">{lab.instruction}</p>
    <div class="tool-surface">
      <label class="prediction">{lesson.slug==='adding-integers-number-line'&&index===6?'Predict the final endpoint':'Predict the signed result'}<input data-prediction data-expected={lab.prediction} class="signed-entry" inputmode="text" autocomplete="off" /></label>
      {lesson.slug==='representing-integers'&&<div class="composer" aria-label="Integer chip composer"><label>Context match<select data-context data-expected={lab.context}><option value="">Choose</option><option value="below">Below the reference</option><option value="gain">A gain</option><option value="reference">At the zero reference</option><option value="opposite">Opposite of +4</option></select></label><div class="counter"><span>Model A positive chips</span><button type="button" data-adjust="p" data-delta="-1" aria-label="Remove one positive chip from model A">−</button><output data-count="p">0</output><button type="button" data-adjust="p" data-delta="1" aria-label="Add one positive chip to model A">+</button></div><div class="counter"><span>Model A negative chips</span><button type="button" data-adjust="n" data-delta="-1" aria-label="Remove one negative chip from model A">−</button><output data-count="n">0</output><button type="button" data-adjust="n" data-delta="1" aria-label="Add one negative chip to model A">+</button></div>{index===4&&<div class="line-fields"><label>Model B positive chips<input data-second-p type="number" min="0" step="1" /></label><label>Model B negative chips<input data-second-n type="number" min="0" step="1" /></label><label>Magnitude<input data-magnitude type="number" min="0" step="1" /></label></div>}<button type="button" data-verify-composer>{index===4?'Compare and verify both models':'Verify this model'}</button></div>}
      {lesson.slug==='adding-integers-tiles'&&<div class="tile-add"><div class="tray"><label>Tray A addend<input data-addend="a" class="signed-entry" inputmode="text" value={lab.rule==='target'?'':lab.a}/></label><div data-tray="a">Not loaded.</div></div><div class="tray"><label>Tray B addend<input data-addend="b" class="signed-entry" inputmode="text" value={lab.rule==='target'?'':lab.b}/></label><div data-tray="b">Not loaded.</div></div><div class="tool-actions"><button type="button" data-load>1. Load trays</button><button type="button" data-combine disabled>2. Combine</button><button type="button" data-cancel disabled>3. Cancel pairs</button></div></div>}
      {lesson.slug==='adding-integers-number-line'&&<div class="line-builder"><div class="line-fields"><label>Start<input data-line-start class="signed-entry" inputmode="text" value={lab.a}/></label><label>Directed jump<input data-line-change class="signed-entry" inputmode="text" value={lab.b}/></label><label>Endpoint<input data-line-end class="signed-entry" inputmode="text" /></label><label>Orientation<select data-line-orientation><option value="horizontal" selected={lab.orientation==='horizontal'}>Horizontal</option><option value="vertical" selected={lab.orientation==='vertical'}>Vertical</option></select></label><label>Arrow direction<select data-line-direction><option value="">Choose</option><option value="positive">Right or up</option><option value="negative">Left or down</option></select></label><label>Diagram check<select data-line-repair><option value="">Choose</option><option value="none">No error in this diagram</option><option value="start">Move the start marker to the first addend</option><option value="label">Use the signed jump as the change label, not the endpoint</option><option value="endpoint">Use the jump as the endpoint</option><option value="zero">Restart at zero</option></select></label>{index===6&&<><label>Second change<input data-route-change-two class="signed-entry" inputmode="text" /></label><label>Second endpoint<input data-route-end-two class="signed-entry" inputmode="text" /></label><label>Third change<input data-route-change-three class="signed-entry" inputmode="text" /></label><label>Final endpoint<input data-route-end-three class="signed-entry" inputmode="text" /></label></>}</div><p class="constraint">Route constraint: every endpoint must lie from −15 through +15.</p><button type="button" data-draw>Draw and verify route</button></div>}
      {lesson.slug==='subtracting-integers-tiles'&&<div class="subtract-builder"><div class="line-fields"><label>Minuend<input data-minuend class="signed-entry" inputmode="text" value={lab.a}/></label><label>Subtrahend<input data-subtrahend class="signed-entry" inputmode="text" value={lab.b}/></label><label>Zero pairs to add<input data-pairs-input type="number" min="0" step="1" value="0"/></label>{index===5&&<><label>Reversed result<input data-reversed-result class="signed-entry" inputmode="text" /></label><label>Relationship<select data-order-relation><option value="">Choose</option><option value="opposites">The two differences are opposites</option><option value="equal">The two differences are equal</option></select></label></>}{index===6&&<label>First incorrect step<select data-combine-repair><option value="">Choose</option><option value="combine">Combining the minuend and subtrahend</option><option value="pairs">Adding complete zero pairs</option><option value="remove">Removing the named chips</option></select></label>}{index===7&&<><label>Replacement positive chips<input type="number" min="0" step="1" data-repair-pairs-p/></label><label>Replacement negative chips<input type="number" min="0" step="1" data-repair-pairs-n/></label><label>Starting value after replacement<input data-repair-start class="signed-entry" inputmode="text" /></label></>}</div><div class="tool-actions"><button type="button" data-build-start>1. Build minuend</button><button type="button" data-add-pairs disabled>2. Add zero pairs</button><button type="button" data-remove disabled>3. Remove subtrahend</button>{index===5&&<button type="button" data-build-reverse>4. Build reversed subtraction</button>}{index===6&&<button type="button" data-rebuild-minuend>Repair: rebuild only the minuend</button>}{index===7&&<button type="button" data-repair-unmatched>Repair with complete pairs</button>}</div></div>}
      {lesson.slug==='subtracting-integers-number-line'&&<div class="compare-builder"><div class="line-fields"><label>First integer<input data-first class="signed-entry" inputmode="text" value={lab.a}/></label><label>Subtrahend<input data-second class="signed-entry" inputmode="text" value={lab.b}/></label><label>Opposite of subtrahend<input data-opposite class="signed-entry" inputmode="text" /></label><label>Line endpoint<input data-sub-end class="signed-entry" inputmode="text" /></label><label>Directed change<input data-directed-change class="signed-entry" inputmode="text" /></label>{[5,6,7].includes(index)&&<label>Distance between start and end<input data-distance type="number" min="0" step="1" /></label>}{[1,2,3,4,5,6].includes(index)&&<label>Best model for this phase<select data-model-choice><option value="">Choose</option><option value="chips">Chips</option><option value="line">Number line</option><option value="symbols">Symbols</option><option value="both">Chips and number line comparison</option></select></label>}{index===6&&<><label>Repair the symbolic rewrite<select data-symbol-repair><option value="">Choose</option><option value="second">Keep −8 and replace subtraction of −11 with addition of +11</option><option value="both">Change both integer signs</option><option value="original">Keep adding −11</option></select></label><label>Repair the off-by-one line<select data-line-count-repair><option value="">Choose</option><option value="intervals">Count 11 intervals right from −8 to +3</option><option value="ticks">Count 11 tick marks and stop at +2</option><option value="restart">Restart at zero</option></select></label></>}{index===7&&<><label>Problem 1, chip-removal proof of (+3)−(−8)<select data-choice-one><option value="">Choose</option><option value="chips">Chips</option><option value="line">Number line</option><option value="symbols">Symbols</option></select></label><label>Problem 2, directed change from −8 to +3<select data-choice-two><option value="">Choose</option><option value="chips">Chips</option><option value="line">Number line</option><option value="symbols">Symbols</option></select></label><label>Problem 3, rewrite (+3)−(−8) as addition<select data-choice-three><option value="">Choose</option><option value="chips">Chips</option><option value="line">Number line</option><option value="symbols">Symbols</option></select></label></>}</div><button type="button" data-compare>{index===6?'Verify both repairs':index===7?'Verify three model choices':'Verify this phase model'}</button></div>}
      <div class="model" data-model aria-live="off"><p>No model built yet.</p></div><output data-output aria-live="polite">Enter a prediction and use the tool.</output>
    </div>
    <fieldset class="phase-check" data-phase-check data-answer={lab.answer} data-feedback="The correct statement matches the verified model and signed calculation."><legend>Which statement verifies this model?</legend>{lab.choices.map((choice,i)=><label><input type="radio" name={`${lesson.slug}-phase-check-${index}`} value={i}/><span>{choice}</span></label>)}<button type="button" data-check>Check checkpoint</button><p data-check-status role="status">Not checked yet.</p></fieldset>
    <p class="phase-target"><strong>Evidence target:</strong> {phase.target}</p><label class="lab-note">Record your model evidence<textarea rows="3" data-note placeholder="Write the values and model action you would show another student."></textarea></label><div class="phase-actions"><button class="phase-reset" type="button" data-reset>Reset phase</button><button class="phase-complete" type="button" data-complete>Complete phase</button></div><p data-complete-status role="status">A correct prediction, verified tool state, passed checkpoint, and recorded explanation are required.</p>
  </section>})}</div>
  <div class="lab-reflection"><strong>Investigation record</strong>{lesson.explore.reflection.map(x=><span>{x}</span>)}</div>
</div>
<script>
const signedValue=(n:number)=>n>0?`+${n}`:`${n}`;
const chipHtml=(value:number)=>{const count=Math.min(20,Math.abs(value)),sign=value>=0?'+':'−',cls=value>=0?'positive':'negative';return `<div class="chips" role="img" aria-label="${Math.abs(value)} ${value>=0?'positive':'negative'} chips">${Array.from({length:count},()=>`<i class="chip ${cls}" aria-hidden="true">${sign}</i>`).join('')}</div>`};
const integer=(input:HTMLInputElement|null)=>{const raw=(input?.value||'').trim().replace('−','-');return /^[+\-]?\d+$/.test(raw)?Number(raw):Number.NaN};
document.querySelectorAll<HTMLElement>('[data-unit2-explore]').forEach(root=>{
 const variant=root.dataset.variant||'',tabs=[...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')],panels=[...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
 const activate=(i:number,focus=true)=>{tabs.forEach((tab,j)=>{tab.setAttribute('aria-selected',String(i===j));tab.tabIndex=i===j?0:-1});panels.forEach((panel,j)=>panel.hidden=i!==j);if(focus)tabs[i]?.focus();};
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(i,false));tab.addEventListener('keydown',event=>{if(!['ArrowRight','ArrowLeft','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(i+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;activate(next);});});
 panels.forEach(panel=>{
  const expectedA=Number(panel.dataset.a),expectedB=Number(panel.dataset.b),result=Number(panel.dataset.result),model=panel.querySelector<HTMLElement>('[data-model]'),output=panel.querySelector<HTMLOutputElement>('[data-output]'),prediction=panel.querySelector<HTMLInputElement>('[data-prediction]');
  const invalidate=(message='Evidence changed. Verify the mathematical tool and checkpoint again.')=>{const hadState=panel.dataset.toolVerified==='true'||panel.dataset.checkpointPassed==='true'||panel.dataset.complete==='true';delete panel.dataset.toolVerified;delete panel.dataset.checkpointPassed;delete panel.dataset.complete;if(hadState){const check=panel.querySelector<HTMLElement>('[data-check-status]'),complete=panel.querySelector<HTMLElement>('[data-complete-status]');if(check)check.textContent='Evidence changed. Check this checkpoint again.';if(complete)complete.textContent=message;if(output)output.textContent=message;}};
  panel.addEventListener('input',event=>{const target=event.target as HTMLElement;if(target.closest('[data-phase-check]')){if(panel.dataset.checkpointPassed==='true'||panel.dataset.complete==='true')invalidate();}else if(target.matches('textarea')){if(panel.dataset.complete==='true')invalidate();}else if(target.matches('input,select'))invalidate();});
  panel.addEventListener('change',event=>{const target=event.target as HTMLElement;if(target.closest('[data-phase-check]')){if(panel.dataset.checkpointPassed==='true'||panel.dataset.complete==='true')invalidate();}else if(target.matches('textarea')){if(panel.dataset.complete==='true')invalidate();}else if(target.matches('input,select'))invalidate();});
  panel.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('button');if(button&&!button.matches('[data-check],[data-complete],[data-reset]'))invalidate('The model action changed. Verify the tool and checkpoint again.');},true);
  const predictionReady=()=>{const expected=Number(prediction?.dataset.expected??result),ok=prediction?.value!==''&&integer(prediction)===expected;if(!ok){if(output)output.innerHTML=`<strong>Revise the prediction.</strong> Enter ${panel.dataset.index==='6'&&variant==='adding-integers-number-line'?'the final endpoint after all three jumps':'the signed result'} before completing the model.`;prediction?.focus();}return ok;};
  const verified=(ok:boolean,message:string)=>{panel.dataset.toolVerified=String(ok);if(output)output.innerHTML=`<strong>${ok?'Tool verified.':'Revise the tool.'}</strong> ${message}`;};
  if(variant==='representing-integers'){
   const state={p:0,n:0};panel.querySelectorAll<HTMLButtonElement>('[data-adjust]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.adjust as 'p'|'n';state[key]=Math.max(0,state[key]+Number(button.dataset.delta));const count=panel.querySelector<HTMLOutputElement>(`[data-count="${key}"]`);if(count)count.value=String(state[key]);if(model)model.innerHTML=`${chipHtml(state.p)}${chipHtml(-state.n)}<p>${state.p}P − ${state.n}N = ${signedValue(state.p-state.n)}</p>`;panel.dataset.toolVerified='false';}));
   panel.addEventListener('unit2-reset',()=>{state.p=0;state.n=0;panel.querySelectorAll<HTMLOutputElement>('[data-count]').forEach(x=>x.value='0');});
   panel.querySelector('[data-verify-composer]')?.addEventListener('click',()=>{if(!predictionReady())return;const phase=Number(panel.dataset.index),context=panel.querySelector<HTMLSelectElement>('[data-context]'),firstExact=state.p===Number(panel.dataset.p)&&state.n===Number(panel.dataset.n),contextOk=context?.value===context?.dataset.expected;if(phase!==4){const ok=firstExact&&state.p-state.n===result&&contextOk;if(model)model.innerHTML=`<strong>Verified integer model</strong>${chipHtml(state.p)}${chipHtml(-state.n)}<p class="model-transcript">${state.p} positive chips and ${state.n} negative chips represent ${signedValue(result)} in the selected context.</p>`;verified(ok,ok?'The requested chip construction, value, and context agree.':'Match the stated context and build Model A with the exact positive and negative chip counts named in this phase.');return;}const secondP=Number(panel.querySelector<HTMLInputElement>('[data-second-p]')?.value),secondN=Number(panel.querySelector<HTMLInputElement>('[data-second-n]')?.value),magnitude=Number(panel.querySelector<HTMLInputElement>('[data-magnitude]')?.value),secondEquivalent=Number.isInteger(secondP)&&Number.isInteger(secondN)&&secondP>=0&&secondN>=0&&secondP-secondN===result&&(secondP!==state.p||secondN!==state.n),ok=firstExact&&state.p-state.n===result&&contextOk&&secondEquivalent&&magnitude===Math.abs(result);if(model)model.innerHTML=`<div class="compare-models"><div><strong>Model A</strong>${chipHtml(state.p)}${chipHtml(-state.n)}<p>${state.p}P and ${state.n}N represent ${signedValue(result)}.</p></div><div><strong>Model B</strong>${chipHtml(secondP)}${chipHtml(-secondN)}<p>${secondP}P and ${secondN}N represent ${signedValue(secondP-secondN)}.</p></div></div><p class="model-transcript">Both distinct models have value ${signedValue(result)} and magnitude ${Math.abs(result)}.</p>`;verified(ok,ok?'Both distinct chip constructions are equivalent, their magnitude is correct, and the context matches.':'Match Model A exactly, build a different nonnegative Model B with the same value, enter the unsigned magnitude, and match the context.');});
  }
  if(variant==='adding-integers-tiles'){
   const aInput=panel.querySelector<HTMLInputElement>('[data-addend="a"]'),bInput=panel.querySelector<HTMLInputElement>('[data-addend="b"]'),combine=panel.querySelector<HTMLButtonElement>('[data-combine]'),cancel=panel.querySelector<HTMLButtonElement>('[data-cancel]');
   const resetTraySequence=()=>{delete panel.dataset.traysLoaded;delete panel.dataset.traysCombined;if(combine)combine.disabled=true;if(cancel)cancel.disabled=true;};
   [aInput,bInput].forEach(input=>input?.addEventListener('input',resetTraySequence));
   panel.querySelector('[data-load]')?.addEventListener('click',()=>{const a=integer(aInput),b=integer(bInput);if(!Number.isInteger(a)||!Number.isInteger(b)){if(output)output.textContent='Enter two signed integers before loading the trays.';aInput?.focus();return;}const trayA=panel.querySelector<HTMLElement>('[data-tray="a"]'),trayB=panel.querySelector<HTMLElement>('[data-tray="b"]');if(trayA)trayA.innerHTML=chipHtml(a);if(trayB)trayB.innerHTML=chipHtml(b);panel.dataset.traysLoaded=`${a},${b}`;delete panel.dataset.traysCombined;if(combine)combine.disabled=false;if(cancel)cancel.disabled=true;panel.dataset.toolVerified='false';});
   combine?.addEventListener('click',()=>{const a=integer(aInput),b=integer(bInput);if(panel.dataset.traysLoaded!==`${a},${b}`){resetTraySequence();if(output)output.textContent='The addends changed. Load both trays again before combining.';return;}if(model)model.innerHTML=`<strong>Combined collection</strong>${chipHtml(a)}${chipHtml(b)}<p>${Math.sign(a)!==Math.sign(b)?Math.min(Math.abs(a),Math.abs(b)):0} zero pairs can cancel.</p>`;panel.dataset.traysCombined='true';if(cancel)cancel.disabled=false;});
