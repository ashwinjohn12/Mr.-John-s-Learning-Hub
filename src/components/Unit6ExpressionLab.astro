<div class="lab" data-expression-lab>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART A · LIKE OR UNLIKE?</p><h3>Sort the terms</h3></div><button type="button" class="secondary" data-new-pair>New pair</button></div><p class="challenge" data-pair></p><div class="choices"><button type="button" data-like="yes">Like terms</button><button type="button" data-like="no">Unlike terms</button></div><p class="feedback" data-pair-feedback>Match the variable part before looking at the coefficients.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART B · SIMPLIFY</p><h3>Combine only what matches</h3></div><button type="button" class="secondary" data-new-expression>New expression</button></div><p class="challenge" data-expression></p><div class="answer-row"><input type="text" data-answer aria-label="Simplified expression"><button type="button" data-check>Check</button></div><button type="button" class="hint" data-hint>Show a hint</button><p class="hint-text" data-hint-text hidden></p><p class="feedback" data-feedback>Carry signs with their terms and keep unlike terms separate.</p></section>
  <section class="panel"><div class="head"><div><p class="eyebrow">PART C · EQUIVALENCE CHECK</p><h3>Same value, different form?</h3></div><button type="button" class="secondary" data-new-equivalent>New check</button></div><p class="challenge" data-equivalent-prompt></p><label class="value-control">Choose x <input type="range" min="-4" max="6" step="1" value="2" data-x><strong data-x-label>x = 2</strong></label><div class="value-grid"><span data-left-value></span><b>=?</b><span data-right-value></span></div><p class="feedback" data-equivalent-feedback></p><button type="button" class="test-three" data-test-three>Test 3 values</button><div class="multi-test" data-multi-test hidden></div></section>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-expression-lab]').forEach(lab=>{
  const pairs=[{a:'6x',b:'−2x',yes:true,why:'Both terms use x.'},{a:'4m',b:'4n',yes:false,why:'m and n are different variables.'},{a:'x',b:'x²',yes:false,why:'x and x² have different variable parts.'},{a:'8',b:'−3',yes:true,why:'All constants are like terms.'},{a:'5ab',b:'−2ab',yes:true,why:'Both terms have the same variable part ab.'}]; let pi=0;
  const pair=lab.querySelector('[data-pair]'); const pf=lab.querySelector<HTMLElement>('[data-pair-feedback]');
  const renderPair=()=>{pi=Math.floor(Math.random()*pairs.length);const t=pairs[pi];if(pair)pair.textContent=`Are ${t.a} and ${t.b} like terms?`;if(pf)pf.textContent='Match the variable part before looking at the coefficients.';};
  lab.querySelector('[data-new-pair]')?.addEventListener('click',renderPair); lab.querySelectorAll<HTMLButtonElement>('[data-like]').forEach(b=>b.addEventListener('click',()=>{const t=pairs[pi];const choice=b.dataset.like==='yes';if(pf)pf.innerHTML=choice===t.yes?`<strong>Correct.</strong> ${t.why}`:`<strong>Not yet.</strong> ${t.why}`;})); renderPair();
  const exprs=[{q:'4x + 6x − 3',a:['10x-3','10x − 3','-3+10x','−3 + 10x'],h:'Combine 4x and 6x. Keep −3 separate.',e:'4x + 6x = 10x, so the result is 10x − 3. Writing −3 + 10x is equivalent too.'},{q:'7x − 8y + 5y − 2x',a:['5x-3y','5x − 3y','-3y+5x','−3y + 5x'],h:'Group x-terms and y-terms separately.',e:'7x − 2x = 5x and −8y + 5y = −3y. The term order may be reversed without changing the value.'},{q:'2(x + 4) + 3x',a:['5x+8','5x + 8','8+5x','8 + 5x'],h:'Distribute the 2 first.',e:'2x + 8 + 3x = 5x + 8. Writing 8 + 5x is equivalent.'},{q:'3a + 5 − a + 2',a:['2a+7','2a + 7','7+2a','7 + 2a'],h:'Combine a-terms and constants.',e:'3a − a = 2a and 5 + 2 = 7. Writing 7 + 2a is equivalent.'}];let ei=0;const eq=lab.querySelector('[data-expression]');const ans=lab.querySelector<HTMLInputElement>('[data-answer]');const fb=lab.querySelector<HTMLElement>('[data-feedback]');const ht=lab.querySelector<HTMLElement>('[data-hint-text]');
  const norm=(s:string)=>s.toLowerCase().replace(/\s/g,'').replace(/−/g,'-'); const renderExpr=()=>{ei=Math.floor(Math.random()*exprs.length);const t=exprs[ei];if(eq)eq.textContent=t.q;if(ans)ans.value='';if(fb)fb.textContent='Carry signs with their terms and keep unlike terms separate.';if(ht){ht.textContent=t.h;ht.hidden=true;}};
  lab.querySelector('[data-new-expression]')?.addEventListener('click',renderExpr);lab.querySelector('[data-check]')?.addEventListener('click',()=>{const t=exprs[ei];const ok=t.a.some(v=>norm(v)===norm(ans?.value||''));if(fb)fb.innerHTML=ok?`<strong>Correct.</strong> ${t.e}`:`<strong>Not yet.</strong> ${t.h}`;});lab.querySelector('[data-hint]')?.addEventListener('click',()=>{if(ht)ht.hidden=!ht.hidden;});renderExpr();
  const checks=[{l:(x:number)=>2*(x+3),r:(x:number)=>2*x+6,text:'2(x + 3) and 2x + 6',yes:true},{l:(x:number)=>3*x+2*x,r:(x:number)=>5*x,text:'3x + 2x and 5x',yes:true},{l:(x:number)=>4*(x+2),r:(x:number)=>4*x+2,text:'4(x + 2) and 4x + 2',yes:false}];let ci=0;const cp=lab.querySelector('[data-equivalent-prompt]');const slider=lab.querySelector<HTMLInputElement>('[data-x]');const xl=lab.querySelector('[data-x-label]');const lv=lab.querySelector('[data-left-value]');const rv=lab.querySelector('[data-right-value]');const ef=lab.querySelector<HTMLElement>('[data-equivalent-feedback]');const mt=lab.querySelector<HTMLElement>('[data-multi-test]');
  const renderValues=()=>{const t=checks[ci],x=Number(slider?.value||2);if(xl)xl.textContent=`x = ${x}`;if(lv)lv.textContent=`Left: ${t.l(x)}`;if(rv)rv.textContent=`Right: ${t.r(x)}`;if(ef){const match=t.l(x)===t.r(x);ef.innerHTML=match?'<strong>They match for this value.</strong> That is useful evidence, but one matching value does not prove two expressions are equivalent.':'<strong>They do not match for this value.</strong> One counterexample is enough to show the expressions are not equivalent.';}};
  const renderCheck=()=>{ci=Math.floor(Math.random()*checks.length);if(cp)cp.textContent=`Compare ${checks[ci].text}.`;if(mt){mt.hidden=true;mt.innerHTML='';}renderValues();};
  slider?.addEventListener('input',renderValues);lab.querySelector('[data-new-equivalent]')?.addEventListener('click',renderCheck);lab.querySelector('[data-test-three]')?.addEventListener('click',()=>{const t=checks[ci];const values=[-2,0,4];const rows=values.map(x=>{const left=t.l(x),right=t.r(x),match=left===right;return `<div><strong>x = ${x}</strong><span>${left} ${match?'=':'≠'} ${right}</span><b>${match?'✓':'✗'}</b></div>`;}).join('');if(mt){mt.hidden=false;mt.innerHTML=`${rows}<p><strong>${t.yes?'All three tests match.':'At least one test does not match.'}</strong> ${t.yes?'Testing several values gives stronger evidence, but algebraic properties are what explain why the expressions are equivalent for every value of x.':'Because a single value fails, these expressions cannot be equivalent for every value of x.'}</p>`;}});renderCheck();
 });
</script>
<style>.lab{display:grid;gap:1rem}.panel{border:1px solid #dce4ed;border-radius:18px;padding:1rem;background:#fff}.head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.head h3{margin:.2rem 0 .7rem}.secondary,.choices button,.answer-row button,.test-three{border:0;border-radius:10px;padding:.65rem .85rem;background:var(--course);color:#fff;font-weight:900;cursor:pointer}.secondary{background:#eef3f8;color:#24364d}.challenge{font-size:1.12rem;font-weight:900}.choices,.answer-row{display:flex;gap:.6rem;flex-wrap:wrap}.answer-row input{flex:1;min-width:180px;padding:.7rem;border:1px solid #cbd5e1;border-radius:10px}.hint{margin-top:.65rem;border:0;background:transparent;color:var(--course);font-weight:900;cursor:pointer}.feedback,.hint-text{padding:.75rem .85rem;border-radius:12px;background:#f7f9fc}.value-control{display:grid;grid-template-columns:auto 1fr auto;gap:.7rem;align-items:center;padding:.7rem;background:#f7f9fc;border-radius:12px}.value-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center;margin-top:.8rem}.value-grid span{padding:.8rem;border-radius:12px;background:var(--course-soft);text-align:center;font-weight:900}.test-three{margin-top:.7rem}.multi-test{display:grid;gap:.55rem;margin-top:.8rem;padding:.85rem;border-radius:12px;background:#f7f9fc}.multi-test>div{display:grid;grid-template-columns:auto 1fr auto;gap:.7rem;align-items:center;padding:.55rem .65rem;border-radius:10px;background:#fff}.multi-test>div span{text-align:center}.multi-test>div b{font-size:1.1rem}.multi-test p{margin:.2rem 0 0}@media(max-width:650px){.head,.value-control,.value-grid,.multi-test>div{display:grid}.secondary{justify-self:start}.multi-test>div span{text-align:left}}</style>