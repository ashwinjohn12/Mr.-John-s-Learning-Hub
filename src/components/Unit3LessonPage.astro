---
import Grade6LessonFrame from './Grade6LessonFrame.astro';
import LearningSection from './LearningSection.astro';
import VocabularyExplorer from './VocabularyExplorer.astro';
import PracticeEngine from './PracticeEngine.astro';
import CheckYourself from './CheckYourself.astro';
import Unit3FactorLab from './Unit3FactorLab.astro';
import Unit3PowerLab from './Unit3PowerLab.astro';
import Unit3OrderLab from './Unit3OrderLab.astro';
import type { Course, Unit, Topic } from '../data/courses';
import type { TopicContent } from '../data/topicContent';
import { applyUnit3Enhancements } from '../data/unit3Enhancements';

interface Props { course: Course; unit: Unit; topic: Topic; content: TopicContent }
const { course, unit, topic, content: rawContent } = Astro.props;
const content = applyUnit3Enhancements(`${course.slug}/${unit.slug}/${topic.slug}`, rawContent);
const base = import.meta.env.BASE_URL;
const nextHref = content.next.slug && content.next.status === 'ready' ? `${base}courses/${course.slug}/${unit.slug}/${content.next.slug}/` : null;
const toolCopy: Record<string,{title:string; text:string}> = {
  'prime-factorization-divisibility': { title:'Factor Lab', text:'Predict prime or composite, build a factor tree yourself, and then use prime factors as evidence for divisibility.' },
  'expressing-powers': { title:'Power Lab', text:'Identify the jobs of the base and exponent, translate repeated multiplication, and compress repeated prime factors.' },
  'operations-parentheses-powers': { title:'Order Lab', text:'Simplify expressions one step at a time, practise equal-priority operations, and become an error detective.' }
};
const homeNotes: Record<string,string> = {
  'prime-factorization-divisibility': 'Use small scraps of paper for factor branches. Keep splitting composite factors until every final card is prime.',
  'expressing-powers': 'Write the power on one card and its repeated multiplication on another, then mix and rematch the cards later.',
  'operations-parentheses-powers': 'Box the part you will calculate next, do one operation, and rewrite the full expression before choosing the next step.'
};
const tool = toolCopy[topic.slug];
const practiceQuestions = content.questions.map((question) => question.prompt === 'Which expression has a value of 18?'
  ? { ...question, choices: ['6 + 2 × 3','(6 + 2) × 3','6 + 2³','36 ÷ 6 × 3'], answer: 3, explain: 'Multiplication and division share priority, so 36 ÷ 6 × 3 = 6 × 3 = 18.' }
  : question);
---
<Grade6LessonFrame {course} {unit} {topic} hook={content.hook} compactMobileHero>

      <LearningSection id="overview" eyebrow="GET READY" title="What you need & where you are going" icon="🎯" tone="idea">
        <div class="overview-grid"><div><p class="mini-label">BEFORE YOU START</p><ul>{content.prerequisites.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">BY THE END, I CAN…</p><ul>{content.goals.map((goal)=><li>{goal}</li>)}</ul></div></div>
        <div class="lesson-meta"><span><strong>Time:</strong> {content.estimatedTime}</span><span><strong>Materials:</strong> {content.materials.join(' · ')}</span></div>
        <details class="success-box"><summary>How will I know I understand it?</summary><ul>{content.successCriteria.map((item)=><li>{item}</li>)}</ul></details>
      </LearningSection>

      <LearningSection id="big-ideas" eyebrow="START HERE" title="The big idea" icon="🌎" tone="idea">
        <p class="big-statement">{content.bigIdea}</p>
        <p>{content.bigIdeaDetail}</p>
        <div class="connection-strip"><strong>Think about it</strong><span>{content.connection}</span></div>
      </LearningSection>

      <LearningSection id="understand" eyebrow="LEARN" title="Build your understanding" icon="📘" tone="learn">
        <div class="concept-grid detailed">{content.concepts.map((concept,index)=><div><span class="concept-number">{String(index+1).padStart(2,'0')}</span><h3>{concept.title}</h3><p>{concept.text}</p>{concept.remember && <p class="remember"><strong>Remember:</strong> {concept.remember}</p>}</div>)}</div>
        {topic.slug === 'operations-parentheses-powers' && (
          <div class="order-ladder" aria-label="Order of operations in four priority levels">
            <div><strong>1</strong><span>Parentheses</span><small>finish the grouped work</small></div>
            <div><strong>2</strong><span>Powers</span><small>evaluate exponents</small></div>
            <div class="equal-level"><strong>3</strong><span>× and ÷</span><small>same priority · left to right</small></div>
            <div class="equal-level"><strong>4</strong><span>+ and −</span><small>same priority · left to right</small></div>
          </div>
        )}
        <div class="mixups"><p class="mini-label">COMMON MIX-UPS</p>{content.misconceptions.map((item)=><details class="misconception"><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
      </LearningSection>

      <LearningSection id="examples" eyebrow="WATCH THE THINKING" title="Worked examples" icon="🧩" tone="learn">
        <div class="example-stack">{content.examples.map((example)=><article class="worked-example"><p class="eyebrow">{example.title}</p><h3>{example.problem}</h3><ol>{example.steps.map((step)=><li>{step}</li>)}</ol><div class="example-answer"><strong>Answer:</strong> {example.answer}</div></article>)}</div>
        {topic.slug === 'prime-factorization-divisibility' && (
          <article class="factor-tree-example">
            <p class="eyebrow">VISUAL MODEL · EXAMPLE 2</p>
            <h3>One factor tree for 72</h3>
            <p>Composite branches keep splitting. Prime branches stop.</p>
            <div class="static-tree" aria-label="Factor tree showing 72 split into 8 and 9, 8 split into 2 and 4, 4 split into 2 and 2, and 9 split into 3 and 3">
              <div class="static-branch">
                <span class="static-node">72</span>
                <div class="static-children">
                  <div class="static-branch">
                    <span class="static-node">8</span>
                    <div class="static-children">
                      <div class="static-branch"><span class="static-node prime-leaf">2</span></div>
                      <div class="static-branch">
                        <span class="static-node">4</span>
                        <div class="static-children"><div class="static-branch"><span class="static-node prime-leaf">2</span></div><div class="static-branch"><span class="static-node prime-leaf">2</span></div></div>
                      </div>
                    </div>
                  </div>
                  <div class="static-branch">
                    <span class="static-node">9</span>
                    <div class="static-children"><div class="static-branch"><span class="static-node prime-leaf">3</span></div><div class="static-branch"><span class="static-node prime-leaf">3</span></div></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="tree-conclusion"><strong>Prime leaves:</strong> 2 × 2 × 2 × 3 × 3 = 72</div>
          </article>
        )}
        {topic.slug === 'expressing-powers' && (
          <article class="power-anatomy-example">
            <p class="eyebrow">VISUAL MODEL · READ A POWER</p>
            <h3>Every part has a different job</h3>
            <div class="power-anatomy">
              <div class="power-symbol"><span class="base-digit">6</span><span class="exp-digit">4</span></div>
              <div class="power-callouts"><p><strong>Base = 6</strong><span>The factor that repeats.</span></p><p><strong>Exponent = 4</strong><span>How many factors of 6 to write.</span></p></div>
            </div>
            <div class="power-equivalence">6⁴ = 6 × 6 × 6 × 6</div>
          </article>
        )}
      </LearningSection>

      <LearningSection id="vocabulary" eyebrow="LEARN THE LANGUAGE" title="Key vocabulary" icon="🧠" tone="vocab"><VocabularyExplorer words={content.vocabulary} /></LearningSection>

      <LearningSection id="explore" eyebrow="INVESTIGATE" title="Explore it for yourself" icon="🔬" tone="explore">
        <p class="section-lead">{content.explorePrompt}</p>
        <div class="explore-stack"><div><h3>{tool?.title}</h3><p>{tool?.text}</p>{topic.slug === 'prime-factorization-divisibility' ? <Unit3FactorLab /> : topic.slug === 'expressing-powers' ? <Unit3PowerLab /> : <Unit3OrderLab />}</div></div>
        <article class="hands-on-card"><p class="eyebrow">OFF-SCREEN ACTIVITY</p><h3>{content.handsOn.title}</h3><ol>{content.handsOn.instructions.map((item)=><li>{item}</li>)}</ol><p><strong>Reflect:</strong> {content.handsOn.reflect}</p><p class="home-note"><strong>Working on your own?</strong> {homeNotes[topic.slug]}</p></article>
      </LearningSection>

      <LearningSection id="practise" eyebrow="PRACTISE WITH SUPPORT" title="Build confidence with feedback" icon="✏️" tone="practice"><p>{content.practiceIntro}</p><PracticeEngine questions={practiceQuestions} /></LearningSection>

      <LearningSection id="check" eyebrow="CHECK YOURSELF" title="Can you do it on your own?" icon="✅" tone="review"><p>This bank is separate from the practice questions. Each new set randomly selects five questions from a larger bank, so a new set should feel genuinely different.</p><CheckYourself questions={content.checkQuestions} count={5} /></LearningSection>

      <LearningSection id="apply" eyebrow="PLAY & APPLY" title={content.application.title} icon="🎮" tone="play"><div class="challenge-card lesson-challenge"><div><p class="eyebrow">REAL-LIFE CHALLENGE</p><p>{content.application.scenario}</p></div><ol>{content.application.tasks.map((task)=><li>{task}</li>)}</ol><details><summary>Check the core ideas</summary><p>{content.application.reveal}</p></details></div></LearningSection>

      <LearningSection id="review" eyebrow="WRAP UP" title="Ready to move on?" icon="🏁" tone="review">
        <div class="wrap-grid"><div><p class="mini-label">LESSON SUMMARY</p><ul>{content.summary.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU NEED SUPPORT</p><ul>{content.support.map((item)=><li>{item}</li>)}</ul></div><div><p class="mini-label">IF YOU WANT A CHALLENGE</p><ul>{content.extension.map((item)=><li>{item}</li>)}</ul></div></div>
        <article class="pat-card"><p class="eyebrow">{content.pat.title}</p><h3>{content.pat.prompt}</h3><details><summary>Show answer</summary><p>{content.pat.answer}</p></details></article>
        <div class="review-grid">{content.review.map((item)=><label><input type="checkbox" /> {item}</label>)}</div>
        <div class="next-step"><div><p class="eyebrow">NEXT STEP</p><strong>{content.next.title}</strong></div>{nextHref ? <a class="button" href={nextHref}>Open →</a> : <span>Unit complete ✓</span>}</div>
      </LearningSection>
 </Grade6LessonFrame>

<style>
.hook-card{display:grid;grid-template-columns:auto 1fr;gap:1rem;margin-top:1.2rem;padding:1rem 1.1rem;border-radius:16px;background:var(--course-soft,#eef4ff);line-height:1.55}.hook-card>div{display:grid;align-content:start;gap:.2rem}.hook-card small{display:block;max-width:200px;color:#526174;font-weight:600}.overview-grid,.wrap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.overview-grid>div,.wrap-grid>div{border:1px solid #e3e9f0;border-radius:16px;padding:1rem;background:#fff}.wrap-grid>div:last-child{grid-column:1/-1}.mini-label{font-size:.76rem;font-weight:900;letter-spacing:.08em;color:#5a6a80}.overview-grid ul,.wrap-grid ul,.worked-example ol,.hands-on-card ol,.lesson-challenge ol{padding-left:1.2rem}.overview-grid li,.wrap-grid li,.worked-example li,.hands-on-card li,.lesson-challenge li{margin:.38rem 0}.lesson-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding:.85rem 1rem;border-radius:14px;background:#f5f7fa}.success-box{margin-top:1rem}.concept-grid.detailed>div{position:relative}.remember{padding:.65rem .75rem;border-radius:10px;background:#f5f8fc}.mixups{margin-top:1.2rem}.order-ladder{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem;margin-top:1rem}.order-ladder>div{display:grid;gap:.2rem;padding:.85rem;border:1px solid #dce4ed;border-radius:13px;background:#fff}.order-ladder strong{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#174ea6;color:#fff}.order-ladder span{font-weight:900}.order-ladder small{color:#64748b}.order-ladder .equal-level{border-width:2px;background:#fffdf5}.example-stack,.explore-stack{display:grid;gap:1rem}.worked-example,.hands-on-card,.pat-card,.factor-tree-example,.power-anatomy-example{border:1px solid #dce4ed;border-radius:16px;padding:1rem 1.1rem;background:#fff}.worked-example h3,.factor-tree-example h3,.power-anatomy-example h3{margin:.25rem 0 .7rem}.example-answer{margin-top:.8rem;padding:.75rem .85rem;border-radius:12px;background:#f0fdf4}.factor-tree-example,.power-anatomy-example{margin-top:1rem;background:#f8fafc}.static-tree{display:grid;justify-items:center;overflow:auto;padding:1rem .5rem}.static-branch{display:grid;justify-items:center;min-width:72px;position:relative}.static-node{display:grid;place-items:center;min-width:48px;height:40px;padding:0 .45rem;border:2px solid #94a3b8;border-radius:12px;background:#fff;font-weight:900}.static-node.prime-leaf{border-style:dashed}.static-children{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-top:1.35rem;position:relative}.static-children:before{content:'';position:absolute;top:-.7rem;left:25%;right:25%;border-top:2px solid #cbd5e1}.static-children>.static-branch:before{content:'';position:absolute;top:-1.35rem;height:.65rem;border-left:2px solid #cbd5e1}.tree-conclusion,.power-equivalence{text-align:center;padding:.75rem;border-radius:12px;background:#eef6ff}.power-anatomy{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:center;padding:1rem}.power-symbol{position:relative;display:inline-block;min-width:90px;font-weight:900}.base-digit{font-size:4rem}.exp-digit{position:absolute;top:.15rem;margin-left:.15rem;font-size:1.7rem}.power-callouts{display:grid;gap:.65rem}.power-callouts p{display:grid;gap:.12rem;margin:0;padding:.65rem .75rem;border-radius:12px;background:#fff}.power-callouts span{color:#526174}.explore-stack>div{display:grid;gap:.55rem}.explore-stack h3{margin-bottom:0}.explore-stack p{margin-top:0}.hands-on-card{margin-top:1rem;background:#fffdf5}.home-note{margin-top:1rem;padding:.8rem .9rem;border-radius:12px;background:#f5f8fc}.section-lead{font-size:1.05rem}.lesson-challenge{display:grid;gap:.8rem}.pat-card{margin:1rem 0;background:#f8fafc}.pat-card h3{font-size:1rem;line-height:1.5}.next-step a{text-decoration:none}.scroll-cue{display:none}
@media(max-width:760px){.overview-grid,.wrap-grid,.order-ladder{grid-template-columns:1fr}.wrap-grid>div:last-child{grid-column:auto}.hook-card{grid-template-columns:1fr}.hook-card small{max-width:none}.power-anatomy{grid-template-columns:1fr;text-align:center}.power-callouts{text-align:left}.topic-hero{padding-top:2rem;padding-bottom:3rem}.topic-hero h1{font-size:clamp(2.2rem,11vw,3.25rem);line-height:1.04}.scroll-cue{display:block;margin:-.35rem 0 .45rem;color:#64748b;font-size:.76rem;font-weight:700}.topic-sidebar nav{scrollbar-width:thin}}
</style>
