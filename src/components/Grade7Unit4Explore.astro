---
import type{Unit4Lesson}from'../data/grade7Unit4';
const{lesson}=Astro.props as{lesson:Unit4Lesson};
const labs:any={
 'investigating-circles':{kind:'circle',labels:['Radius','Central angle'],sets:[[6,90,12],[5,135,10],[7,150,14],[6,120,12],[8,45,16]],answers:[12,10,14,12,16],prediction:[12,10,14,12,16],action:'Construct the circle, diameter, chord, and central angle.',checkpoint:'Diameter',repair:'radius'},
 'circumference-circle':{kind:'circumference',labels:['Diameter','Measured circumference'],sets:[[10,31.4,3.14],[14,43.96,3.14],[8,25.12,3.14],[12,37.68,3.14],[20,62.8,3.14]],answers:[3.14,3.14,3.14,3.14,3.14],prediction:[3.1,3.1,3.1,3.1,3.1],action:'Wrap the string, measure across the centre, then calculate C ÷ d.',checkpoint:'C ÷ d',repair:'diameter'},
 'area-parallelogram':{kind:'parallelogram',labels:['Base','Perpendicular height'],sets:[[9,4,36],[12,5,60],[8,7,56],[10,6,60],[15,3,45]],answers:[36,60,56,60,45],prediction:[36,60,56,60,45],action:'Set base and perpendicular height, then slide the triangular end.',checkpoint:'Area',repair:'height'},
 'area-triangle':{kind:'triangle',labels:['Base','Perpendicular height'],sets:[[10,6,30],[9,8,36],[12,7,42],[15,4,30],[8,5,20]],answers:[30,36,42,30,20],prediction:[30,36,42,30,20],action:'Duplicate and rotate the triangle to form a related parallelogram.',checkpoint:'Triangle area',repair:'half'},
 'area-circle':{kind:'circle-area',labels:['Radius','Sector count'],sets:[[4,8,50.27],[6,12,113.1],[5,16,78.54],[7,20,153.94],[3,24,28.27]],answers:[50.27,113.1,78.54,153.94,28.27],prediction:[50,113,79,154,28],action:'Change the sector count, alternate sectors, and compare with πr by r.',checkpoint:'Area',repair:'square'},
 'interpreting-circle-graphs':{kind:'interpret',labels:['Sector percent','Total'],sets:[[35,240,84],[25,80,20],[40,150,60],[15,200,30],[30,90,27]],answers:[84,20,60,30,27],prediction:[84,20,60,30,27],action:'Set the percent and total, then reveal matching angle and count.',checkpoint:'Sector count',repair:'percent'},
 'drawing-circle-graphs':{kind:'graph',labels:['Category count','Data total'],sets:[[18,45,144],[12,30,144],[9,30,108],[6,24,90],[15,60,90]],answers:[144,144,108,90,90],prediction:[144,144,108,90,90],action:'Convert the category to a percent and set its central angle.',checkpoint:'Central angle',repair:'total'}
};
const lab=labs[lesson.slug];
---
<div class="lab" data-unit4-explore data-kind={lab.kind} data-config={JSON.stringify(lab)}>
 <header><p>{lesson.explore.launch}</p><strong>Core: Predict → Build → Verify · Consolidation: Repair · Extension: Create</strong></header>
 <div class="tabs" role="tablist" aria-label={`${lesson.explore.title} phases`}>{lesson.explore.phases.map((p,i)=><button id={`${lesson.slug}-tab-${i}`} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${lesson.slug}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{i+1}. {p.title}</button>)}</div>
 {lesson.explore.phases.map((p,i)=><section id={`${lesson.slug}-panel-${i}`} role="tabpanel" aria-labelledby={`${lesson.slug}-tab-${i}`} data-phase={i} hidden={i!==0}>
  <h3 tabindex="-1">{p.title}</h3><p>{p.instruction}</p><p class="target"><b>Checkpoint:</b> {p.target}</p>
  <div class="prompt"><b>{i===3?`Repair the supplied error, then restore ${lab.labels[0]} ${lab.sets[i][0]} and ${lab.labels[1]} ${lab.sets[i][1]}.`:i===4?`Create a different valid construction whose ${lab.checkpoint} is ${lab.answers[i]}.`:`Target: ${lab.labels[0]} ${lab.sets[i][0]}; ${lab.labels[1]} ${lab.sets[i][1]}`}</b><span>{lab.action}</span></div>
  {i===0?<label>Checkable prediction for {lab.checkpoint}<input data-prediction inputmode="decimal"/><small>Enter a specific estimate or value.</small></label>:<div class="controls"><label>{lab.labels[0]}<input data-a inputmode="decimal" value={i===3?lab.sets[i][0]+1:''}/></label><label>{lab.labels[1]}<input data-b inputmode="decimal"/></label><button type="button" data-build>Build model</button><button type="button" data-operate disabled>Operate model</button></div>}
  <div class={`math-model ${lab.kind}`} data-model role="img" aria-label="Model not built."><div data-surface></div><p data-transcript>Model transcript: not built.</p></div>
  {i===3&&<label>First mathematical error<select data-repair><option value="">Choose</option><option value={lab.repair}>The {lab.repair} relationship is incorrect.</option><option value="colour">Only the colour is wrong.</option><option value="title">Only the title is missing.</option></select></label>}
  {i>0&&<label>{lab.checkpoint}<input data-checkpoint inputmode="decimal"/></label>}
  <label>Recorded evidence for self or teacher review<textarea data-evidence rows="2"></textarea></label><button type="button" data-verify>Verify phase</button><p data-status role="status">Not verified.</p>
 </section>)}
 <p class="progress" data-progress role="status">0 of 3 core phases verified.</p>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-unit4-explore]').forEach(root=>{const cfg=JSON.parse(root.dataset.config||'{}'),tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-tab]')],panels=[...root.querySelectorAll<HTMLElement>('[data-phase]')],passed=new Set<number>(),built=new Set<number>(),operated=new Set<number>();
 const parse=(v:string)=>{if(!/^[+]?((\d+(\.\d+)?)|(\.\d+))$/.test(v.trim()))return NaN;return Number(v)},close=(a:number,b:number,t=.025)=>Number.isFinite(a)&&Math.abs(a-b)<=t;
 const calculate=(a:number,b:number)=>{switch(root.dataset.kind){case'circle':return 2*a;case'circumference':return b/a;case'parallelogram':return a*b;case'triangle':return a*b/2;case'circle-area':return Math.PI*a*a;case'interpret':return a/100*b;default:return a/b*360}};
 const expected=(i:number)=>Number(cfg.answers[i]),announce=()=>{const core=[0,1,2].filter(i=>passed.has(i)).length;root.querySelector<HTMLElement>('[data-progress]')!.textContent=`${core} of 3 core phases verified.${core===3?' Core Explore complete.':''}`};
 const activate=(i:number,focus=true)=>{tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1});panels.forEach((p,j)=>p.hidden=i!==j);if(focus)panels[i].querySelector<HTMLElement>('h3')?.focus()};
 tabs.forEach((t,i)=>{t.addEventListener('click',()=>activate(i));t.addEventListener('keydown',e=>{let j=i;if(e.key==='ArrowRight')j=(i+1)%tabs.length;else if(e.key==='ArrowLeft')j=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')j=0;else if(e.key==='End')j=tabs.length-1;else return;e.preventDefault();activate(j,false);tabs[j].focus()})});
 const resetPanel=(j:number,message:string)=>{passed.delete(j);built.delete(j);operated.delete(j);const p=panels[j];p.dataset.verified='false';p.querySelector<HTMLButtonElement>('[data-operate]')?.setAttribute('disabled','');p.querySelector<HTMLElement>('[data-surface]')!.innerHTML='';p.querySelector<HTMLElement>('[data-transcript]')!.textContent='Model transcript: not built.';p.querySelector<HTMLElement>('[data-model]')?.setAttribute('aria-label','Model not built.');p.querySelector<HTMLElement>('[data-status]')!.textContent=message};
 const clearFrom=(i:number)=>{for(let j=i;j<panels.length;j++)resetPanel(j,j===i?'Evidence changed. Rebuild and verify this phase.':'Earlier evidence changed. Rebuild this phase after the dependency is verified.');announce()};
 const validConstruction=(kind:string,a:number,b:number)=>{if(!Number.isFinite(a)||!Number.isFinite(b)||a<=0||b<=0)return false;if(kind==='circle')return b<=360;if(kind==='circle-area')return Number.isInteger(b)&&b>=8&&b<=48&&b%2===0;if(kind==='interpret')return a<=100&&Number.isInteger(b);if(kind==='graph')return a<=b&&Number.isInteger(a)&&Number.isInteger(b);return true};
 const draw=(panel:HTMLElement,a:number,b:number,result?:number)=>{const kind=root.dataset.kind,s=panel.querySelector<HTMLElement>('[data-surface]')!,t=panel.querySelector<HTMLElement>('[data-transcript]')!;let html='',text='';
  if(kind==='circle'){const angle=Math.max(0,Math.min(360,b));html=`<svg viewBox="0 0 260 180" aria-hidden="true"><circle cx="130" cy="90" r="65"/><line x1="130" y1="90" x2="195" y2="90"/><line x1="65" y1="90" x2="195" y2="90"/><line x1="130" y1="90" x2="${130+65*Math.cos(angle*Math.PI/180)}" y2="${90-65*Math.sin(angle*Math.PI/180)}"/><text x="134" y="84">r=${a}</text><text x="92" y="108">d=${2*a}</text></svg>`;text=`Circle centred at O with radius ${a}, diameter ${2*a}, and central angle ${b} degrees.`}
  else if(kind==='circumference'){html=`<div class="ratio"><span style="width:${Math.min(100,a*5)}%">diameter ${a}</span><span>unwrapped circumference ${b}</span><strong>C ÷ d = ${result?.toFixed(2)??'?'}</strong></div>`;text=`Diameter ruler ${a}; unwrapped circumference string ${b}; ratio ${result?.toFixed(2)??'not calculated'}.`}
  else if(kind==='parallelogram'){html=`<svg viewBox="0 0 300 170" aria-hidden="true"><polygon points="65,30 245,30 205,130 25,130"/><line class="dash" x1="65" y1="30" x2="65" y2="130"/><text x="115" y="150">base ${a}</text><text x="70" y="85">height ${b}</text></svg><strong>Related rectangle: ${a} × ${b}${result!==undefined?` = ${result}`:''}</strong>`;text=`Parallelogram with base ${a}, perpendicular height ${b}; cut-and-slide rectangle has the same area${result!==undefined?`, ${result} square units`:''}.`}
  else if(kind==='triangle'){html=`<svg viewBox="0 0 300 170" aria-hidden="true"><polygon points="30,130 250,130 90,30"/><polygon class="copy" points="250,30 30,30 190,130"/><line class="dash" x1="90" y1="30" x2="90" y2="130"/><text x="115" y="150">base ${a}</text><text x="95" y="85">height ${b}</text></svg><strong>One of two equal triangles${result!==undefined?`: ${result} square units`:''}</strong>`;text=`Two congruent triangles form a parallelogram with base ${a} and height ${b}; one triangle is half${result!==undefined?`, area ${result} square units`:''}.`}
  else if(kind==='circle-area'){const sectors=Math.max(4,Math.round(b));html=`<div class="sectors" style="--wedges:${sectors}"><span>circle r=${a}</span><span>rearranged base ≈ πr; height r</span></div><strong>${result!==undefined?`A=π×${a}²≈${result.toFixed(2)}`:`${sectors} sectors ready`}</strong>`;text=`Circle of radius ${a} split into ${sectors} sectors and alternated into a near-parallelogram with base pi times radius and height radius${result!==undefined?`; area ${result.toFixed(2)} square units`:''}.`}
  else {const percent=kind==='interpret'?a:a/b*100,angle=percent/100*360,count=kind==='interpret'?a/100*b:a;html=`<div class="pie" style="--angle:${angle}deg"><span>${percent.toFixed(1)}%</span></div><dl><div><dt>count</dt><dd>${count}</dd></div><div><dt>total</dt><dd>${b}</dd></div><div><dt>angle</dt><dd>${angle.toFixed(1)}°</dd></div></dl>`;text=`Circle sector represents count ${count} of total ${b}, ${percent.toFixed(1)} percent, and ${angle.toFixed(1)} degrees.`}
  s.innerHTML=html;t.textContent=`Model transcript: ${text}`;panel.querySelector<HTMLElement>('[data-model]')?.setAttribute('aria-label',text)};
 panels.forEach((panel,i)=>{panel.querySelectorAll('input,select,textarea').forEach(c=>{c.addEventListener('input',()=>{if([...passed,...built,...operated].some(j=>j>=i))clearFrom(i)});c.addEventListener('change',()=>{if([...passed,...built,...operated].some(j=>j>=i))clearFrom(i)})});panel.querySelector('[data-build]')?.addEventListener('click',()=>{const a=parse(panel.querySelector<HTMLInputElement>('[data-a]')?.value||''),b=parse(panel.querySelector<HTMLInputElement>('[data-b]')?.value||''),targetA=Number(cfg.sets[i][0]),targetB=Number(cfg.sets[i][1]),repair=panel.querySelector<HTMLSelectElement>('[data-repair]')?.value;let valid=validConstruction(root.dataset.kind||'',a,b)&&close(a,targetA)&&close(b,targetB)&&(i!==3||repair===cfg.repair);if(i===4)valid=validConstruction(root.dataset.kind||'',a,b)&&close(calculate(a,b),expected(i),.06);if(!valid){panel.querySelector<HTMLElement>('[data-status]')!.textContent=i===4?'Create a mathematically valid state that meets every displayed constraint and target.':i===3?'Identify the first mathematical error and restore the required values.':'The model controls do not match the stated target.';return}built.add(i);draw(panel,a,b);const op=panel.querySelector<HTMLButtonElement>('[data-operate]');if(op)op.disabled=false;panel.querySelector<HTMLElement>('[data-status]')!.textContent='Model built. Operate it and verify the checkpoint.'});panel.querySelector('[data-operate]')?.addEventListener('click',()=>{if(!built.has(i))return;const a=parse(panel.querySelector<HTMLInputElement>('[data-a]')!.value),b=parse(panel.querySelector<HTMLInputElement>('[data-b]')!.value),result=calculate(a,b);operated.add(i);draw(panel,a,b,result);panel.querySelector<HTMLElement>('[data-status]')!.textContent='Model operated. Complete the checkpoint and evidence.'});panel.querySelector('[data-verify]')?.addEventListener('click',()=>{const evidence=panel.querySelector<HTMLTextAreaElement>('[data-evidence]')?.value.trim();let valid=!!evidence;if(i===0)valid=valid&&close(parse(panel.querySelector<HTMLInputElement>('[data-prediction]')?.value||''),Number(cfg.prediction[i]),.6);else valid=valid&&built.has(i)&&operated.has(i)&&close(parse(panel.querySelector<HTMLInputElement>('[data-checkpoint]')?.value||''),expected(i),.06);if(valid){passed.add(i);panel.dataset.verified='true';panel.querySelector<HTMLElement>('[data-status]')!.innerHTML='<strong>Verified.</strong> Prediction or controls, model, checkpoint, and evidence agree.'}else panel.querySelector<HTMLElement>('[data-status]')!.innerHTML='<strong>Not yet.</strong> Complete the exact model and checkpoint, then record your own evidence.';announce()})});announce();
});
</script>
<style>
.lab{overflow:hidden;border-radius:16px;background:#102a43;color:#fff}.lab header{padding:1rem;background:#173f5f}.tabs{display:flex;gap:.4rem;padding:.7rem;overflow-x:auto}.tabs button,.lab button{min-height:44px;border:1px solid #ffffff66;border-radius:9px;background:#ffffff12;color:#fff;padding:.65rem;font-weight:800}.tabs [aria-selected=true]{background:#f4c95d;color:#17243a}.lab section{display:grid;gap:.7rem;padding:1rem}.lab label{display:grid;gap:.35rem;font-weight:800}.lab input,.lab textarea,.lab select{box-sizing:border-box;width:100%;min-height:44px;border:1px solid #8ca7bc;border-radius:8px;padding:.65rem;font:inherit}.target,.prompt,.progress{padding:.75rem;border-radius:9px;background:#ffffff12}.prompt{display:grid}.controls{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.math-model{padding:.75rem;border-radius:10px;background:#fff;color:#15293a;overflow:auto}.math-model svg{display:block;width:min(100%,420px);margin:auto}.math-model svg circle,.math-model svg polygon{fill:#dbeafe;stroke:#2457c5;stroke-width:3}.math-model svg .copy{fill:#fef3c7}.math-model svg line{stroke:#263b50;stroke-width:2}.math-model svg .dash{stroke-dasharray:6}.ratio{display:grid;gap:.45rem}.ratio span{padding:.5rem;border:2px solid #2457c5}.sectors{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}.sectors span{min-height:90px;display:grid;place-items:center;padding:.5rem;background:repeating-linear-gradient(135deg,#dbeafe 0 12px,#fff 12px 24px);border:2px solid #2457c5}.pie{width:150px;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#2457c5 0 var(--angle),#e2e8f0 var(--angle) 360deg);border:2px solid #263b50}.pie span{padding:.25rem;background:#fff}.math-model dl{display:flex;gap:.5rem;flex-wrap:wrap}.math-model dl div{padding:.4rem;background:#edf4ff}.lab :focus-visible{outline:3px solid #f4c95d;outline-offset:2px}@media(max-width:620px){.controls{grid-template-columns:1fr}.tabs button{min-width:150px}.sectors{grid-template-columns:1fr}}@media(max-width:390px){.lab section{padding:.75rem}.math-model svg{min-width:260px}}@media(prefers-reduced-motion:reduce){.lab *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
