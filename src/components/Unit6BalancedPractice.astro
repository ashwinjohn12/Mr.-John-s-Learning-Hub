---
import type { PracticeQuestion } from '../data/topicContent';
interface Group { label: string; questions: readonly PracticeQuestion[]; count: number }
interface Props { groups: Group[] }
const { groups } = Astro.props;
const total = groups.reduce((sum, group) => sum + group.count, 0);
---
<div class="practice-widget" data-unit6-balanced-practice data-count={total}>
  <div class="practice-top">
    <div><p class="eyebrow">SUPPORTED WHOLE-UNIT PRACTICE</p><h3>Balanced {total}-question practice set</h3><p>Every set includes exactly 3 questions from each lesson. Use hints when you need them—the goal here is to learn from mistakes.</p></div>
    <span data-practice-score>0 / 0</span>
  </div>
  <div data-practice-stage aria-live="polite"></div>
  <div class="practice-actions">
    <button type="button" class="hint" data-practice-hint>Show hint</button>
    <button type="button" data-practice-next disabled>Next question</button>
  </div>
  <script type="application/json" data-practice-data set:html={JSON.stringify(groups)}></script>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-unit6-balanced-practice]').forEach(widget=>{
  const groups=JSON.parse(widget.querySelector('[data-practice-data]')?.textContent||'[]');
  const total=Number(widget.dataset.count||9);
  const stage=widget.querySelector<HTMLElement>('[data-practice-stage]');
  const score=widget.querySelector('[data-practice-score]');
  const hint=widget.querySelector<HTMLButtonElement>('[data-practice-hint]');
  const next=widget.querySelector<HTMLButtonElement>('[data-practice-next]');
  let pool:any[]=[];let index=0;let correct=0;let answered=0;let locked=false;
  const shuffle=(items:any[])=>[...items].sort(()=>Math.random()-.5);
  const build=()=>shuffle(groups.flatMap((group:any)=>shuffle(group.questions).slice(0,Math.min(group.count,group.questions.length)).map((q:any)=>({...q,lessonLabel:group.label}))));
  const updateScore=()=>{if(score)score.textContent=`${correct} / ${answered}`;};
  const render=()=>{
    if(index>=pool.length){
      if(stage)stage.innerHTML=`<div class="practice-finish"><p class="eyebrow">PRACTICE SET COMPLETE</p><h3>You scored ${correct} / ${pool.length}</h3><p>${correct===pool.length?'Excellent. You are ready for the Unit Check.':correct>=Math.ceil(pool.length*.67)?'Good progress. Review the explanations on anything you missed, then try the Unit Check or choose More Practice.':'Use the lesson labels on missed questions and return to the lesson map above for a targeted review.'}</p></div>`;
      if(hint)hint.hidden=true;
      if(next){next.disabled=false;next.textContent='More Practice';}
      if(score)score.textContent=`${correct} / ${pool.length}`;
      return;
    }
    const q=pool[index];locked=false;
    if(stage)stage.innerHTML=`<div class="question-meta"><span>Question ${index+1} of ${pool.length}</span><span>${q.lessonLabel}</span></div><h3>${q.prompt}</h3><div class="practice-choices">${q.choices.map((choice:string,i:number)=>`<button type="button" data-choice="${i}"><span>${String.fromCharCode(65+i)}</span>${choice}</button>`).join('')}</div><div class="practice-feedback" data-feedback hidden></div>`;
    stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>answer(Number(button.dataset.choice))));
    if(hint){hint.hidden=false;hint.disabled=false;hint.textContent='Show hint';}
    if(next){next.disabled=true;next.textContent=index===pool.length-1?'Finish practice':'Next question';}
    updateScore();
  };
  const answer=(choice:number)=>{
    if(locked)return;locked=true;answered++;
    const q=pool[index];const ok=choice===q.answer;if(ok)correct++;
    stage?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button,i)=>{button.disabled=true;if(i===q.answer)button.classList.add('correct');else if(i===choice)button.classList.add('incorrect');});
    const feedback=stage?.querySelector<HTMLElement>('[data-feedback]');if(feedback){feedback.hidden=false;feedback.innerHTML=`<strong>${ok?'Correct!':'Not quite yet.'}</strong> ${q.explain}`;}
    if(hint)hint.disabled=true;if(next)next.disabled=false;updateScore();
  };
  hint?.addEventListener('click',()=>{if(index>=pool.length||locked)return;const q=pool[index];const feedback=stage?.querySelector<HTMLElement>('[data-feedback]');if(feedback){feedback.hidden=false;feedback.innerHTML=`<strong>Hint:</strong> ${q.hint||'Use the lesson strategy and work one step at a time.'}`;}hint.textContent='Hint shown';});
  next?.addEventListener('click',()=>{if(index>=pool.length){reset();return;}index++;render();});
  const reset=()=>{pool=build().slice(0,total);index=0;correct=0;answered=0;if(next)next.textContent='Next question';render();};
  reset();
 });
</script>
<style>.practice-widget{border:1px solid #d8e0ea;border-radius:18px;background:#fff;padding:1.15rem}.practice-top{display:flex;justify-content:space-between;align-items:start;gap:1rem;border-bottom:1px solid #e8edf3;padding-bottom:.9rem}.practice-top h3{margin:.2rem 0}.practice-top p{margin:.25rem 0;color:#64748b}.practice-top>span{font-size:1.05rem;font-weight:900;white-space:nowrap}.question-meta{display:flex;justify-content:space-between;gap:.8rem;margin:1rem 0 .2rem;color:#5f6f84;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.practice-choices{display:grid;gap:.6rem;margin:1rem 0}.practice-choices button{display:flex;gap:.7rem;align-items:center;text-align:left;border:1px solid #d9e1eb;border-radius:12px;background:#fff;padding:.75rem;cursor:pointer}.practice-choices button span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#eef3f9;font-weight:800}.practice-choices button.correct{border-color:#22c55e;background:#f0fdf4}.practice-choices button.incorrect{border-color:#ef4444;background:#fef2f2}.practice-feedback{margin:.6rem 0;padding:.75rem .85rem;border-radius:11px;background:#f7f9fc}.practice-actions{display:flex;gap:.7rem;margin-top:.8rem;flex-wrap:wrap}.practice-actions button{border:0;border-radius:11px;padding:.7rem 1rem;font-weight:850;cursor:pointer;background:var(--course);color:#fff}.practice-actions .hint{background:#eef3f9;color:#25364f}.practice-actions button:disabled{opacity:.45;cursor:not-allowed}.practice-finish{padding:1.2rem 0}@media(max-width:650px){.practice-top,.question-meta{display:grid}.practice-top>span{justify-self:start}}</style>